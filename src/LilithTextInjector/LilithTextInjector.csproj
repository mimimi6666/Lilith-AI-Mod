<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LilithTextInjector</AssemblyName>
    <GameInterop>$(LILITH_INTEROP_DIR)</GameInterop>
    <BepInExCoreDir>$(LILITH_BEPINEX_CORE_DIR)</BepInExCoreDir>
    <OldMaidDrawPcm>Assets\Audio\card-slide-1.pcm</OldMaidDrawPcm>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gera.Chess" Version="1.1.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)\BepInEx.Core.dll" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameInterop)\Assembly-CSharp.dll" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GameInterop)\Il2Cppmscorlib.dll" />
    <Reference Include="UnityEngine" HintPath="$(GameInterop)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameInterop)\UnityEngine.CoreModule.dll" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(GameInterop)\Unity.RenderPipelines.Core.Runtime.dll" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(GameInterop)\Unity.RenderPipelines.Universal.Runtime.dll" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GameInterop)\UnityEngine.Physics2DModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameInterop)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameInterop)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameInterop)\UnityEngine.ImageConversionModule.dll" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameInterop)\UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameInterop)\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameInterop)\UnityEngine.UI.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameInterop)\Unity.TextMeshPro.dll" />
    <Reference Include="Unity.Localization" HintPath="$(GameInterop)\Unity.Localization.dll" />
    <Reference Include="spine-csharp" HintPath="$(GameInterop)\spine-csharp.dll" />
    <Reference Include="spine-unity" HintPath="$(GameInterop)\spine-unity.dll" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(OldMaidDrawPcm)" LogicalName="LilithTextInjector.Audio.card-slide-1.pcm" />
    <EmbeddedResource Include="Assets\MiniGameDialogue\catalog.json" LogicalName="LilithTextInjector.MiniGameDialogue.catalog.json" />
    <EmbeddedResource Include="Assets\MiniGameDialogue\Subtitles\*.json" LogicalName="LilithTextInjector.MiniGameDialogue.Subtitles.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Audio\chess-move.pcm" LogicalName="LilithTextInjector.Audio.chess-move.pcm" />
    <EmbeddedResource Include="Assets\Audio\chess-capture.pcm" LogicalName="LilithTextInjector.Audio.chess-capture.pcm" />
    <EmbeddedResource Include="Assets\Audio\CHESS_AUDIO_NOTICE.txt" LogicalName="LilithTextInjector.Audio.CHESS_AUDIO_NOTICE.txt" />
    <EmbeddedResource Include="Assets\Audio\KENNEY_CASINO_LICENSE.txt" LogicalName="LilithTextInjector.Audio.KENNEY_CASINO_LICENSE.txt" />
    <EmbeddedResource Include="Assets\lilith-desktop-artifact-icon.png"
                      LogicalName="LilithTextInjector.Assets.lilith-desktop-artifact-icon.png" />
    <Compile Include="..\LilithProviderControlPlane\DeepSeekControlPlane.cs"
