<Window x:Class="LilithControlCenter.SettingsSurfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LilithControlCenter"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1000" Height="760" MinWidth="700" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/lilith-control-center-icon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="7"
                            CornerRadius="14" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="Assets/lilith-control-center-icon.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Heading" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="DismissButton" Grid.Column="2" Content="×"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            ToolTip="{local:UiText common.close}" AutomationProperties.Name="{local:UiText common.close}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Dismiss_Click"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="16" CanContentScroll="False">
                <ContentControl x:Name="EditorHost" VerticalContentAlignment="Top"/>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource PanelBrush}" Padding="20,12">
                <TextBlock x:Name="FooterText" Text="{local:UiText settings.dialog.closeHint}"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
