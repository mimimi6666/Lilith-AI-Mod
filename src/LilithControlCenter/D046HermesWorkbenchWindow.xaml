<Window x:Class="LilithControlCenter.D046HermesWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LilithControlCenter"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:UiText ui.lilith.workbench}"
        Width="1240" Height="800" MinWidth="980" MinHeight="640"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Icon="Assets/lilith-control-center-icon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="7"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:D046HermesImagePreviewConverter x:Key="HermesImagePreviewConverter"/>

        <Style x:Key="ComposerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ComposerSendButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <ContextMenu x:Key="HermesTaskContextMenu"
                     x:Shared="False"
                     Style="{StaticResource DarkContextMenuStyle}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Header="{Binding PinLabel}"
                      Click="PinTaskMenuItem_Click"/>
            <Separator Style="{StaticResource DarkMenuSeparatorStyle}"/>
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Header="{local:UiText ui.rename}"
                      IsEnabled="{Binding CanManage}"
                      Click="RenameTaskMenuItem_Click"/>
            <Separator Style="{StaticResource DarkMenuSeparatorStyle}"/>
            <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                      Header="{local:UiText ui.delete.chat}"
                      Foreground="{DynamicResource DangerBrush}"
                      IsEnabled="{Binding CanManage}"
                      Click="DeleteTaskMenuItem_Click"/>
        </ContextMenu>

        <Style x:Key="HermesListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource RailBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="ListSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ListSurface" Property="Background" Value="{DynamicResource RailBrush}"/>
                                <Setter TargetName="ListSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HermesTaskItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TaskItem_PreviewMouseRightButtonDown"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContextMenu" Value="{StaticResource HermesTaskContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TaskSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                <Setter TargetName="TaskSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter TargetName="TaskSurface" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Image Source="Assets/lilith-control-center-icon.png"
                           Width="32" Height="32" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{local:UiText ui.lilith.workbench}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:UiText ui.lilith.sessions.projected.by.lilith.runtime}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButtonStyle}" ToolTip="{local:UiText common.minimize}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click">
                        <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" ToolTip="{local:UiText common.close}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="HermesConnectionRecoveryPanel"
                    AutomationProperties.AutomationId="HermesConnectionRecoveryPanel"
                    AutomationProperties.LiveSetting="Polite"
                    Grid.Row="1" Margin="16,8,16,0" Padding="12,9"
                    Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:UiText chat.reconnect.title}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HermesConnectionRecoveryStatusText"
                                   AutomationProperties.AutomationId="HermesConnectionRecoveryStatusText"
                                   TextWrapping="Wrap" Margin="0,4,12,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding ConnectionRecoveryBlockText}"
                                   TextWrapping="Wrap" Margin="0,3,12,0"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                    <Button x:Name="HermesConnectionRecoveryButton"
                            AutomationProperties.AutomationId="HermesConnectionRecoveryButton"
                            Grid.Column="1" VerticalAlignment="Center"
                            Content="{local:UiText chat.reconnect.button}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ConnectionRecoveryButton_Click"/>
                </Grid>
            </Border>

            <Grid x:Name="HermesConnectedContent" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27*" MinWidth="230"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="68*" MinWidth="450"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="28*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource RailBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="HermesNewSessionButton"
                                AutomationProperties.AutomationId="HermesNewSessionButton"
                                Content="{local:UiText chat.new}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanCreateTask}"
                                HorizontalContentAlignment="Center"
                                Click="NewSessionButton_Click"/>
                        <TextBlock Grid.Row="1"
                                   Text="{local:UiText ui.tasks.and.sessions}"
                                   FontWeight="SemiBold"
                                   Margin="2,16,0,7"/>
                        <ListBox x:Name="HermesTaskList"
                                 Grid.Row="2"
                                 AutomationProperties.AutomationId="HermesTaskList"
                                 Style="{StaticResource HermesListStyle}"
                                 ItemContainerStyle="{StaticResource HermesTaskItemStyle}"
                                 ItemsSource="{Binding Tasks}"
                                 IsEnabled="{Binding CanOpenTaskMenu}"
                                 ToolTip="{local:UiText chat.navigationHint}"
                                 ToolTipService.ShowOnDisabled="True"
                                 SelectedItem="{Binding SelectedTask, Mode=OneWay}"
                                 PreviewMouseWheel="BoundedPixelScroll_PreviewMouseWheel"
                                 SelectionChanged="TaskList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PinMark}"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentStrongBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SessionDisplay}"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StateText}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <Grid Grid.Column="2" Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="16,13"
                            CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTaskTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="HermesModelDisplay"
                                           AutomationProperties.AutomationId="HermesModelDisplay"
                                           Text="{Binding ModelDisplayName}"
                                           Foreground="{DynamicResource AccentStrongBrush}"
                                           Margin="0,4,0,0"/>
                                <ComboBox x:Name="HermesModelSelector"
                                          AutomationProperties.AutomationId="HermesModelSelector"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding ModelOptions}"
                                          SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding CanSelectModel}"
                                          SelectionChanged="ModelSelector_SelectionChanged"
                                          Width="320"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1"
                                    Style="{StaticResource PillStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource GoodBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Margin="0,12"
                            Padding="0">
                        <Grid>
                            <TextBlock Text="{Binding TimelinePlaceholderText}"
                                       Visibility="{Binding IsTimelinePlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ListBox x:Name="HermesTimeline"
                                     AutomationProperties.AutomationId="HermesTimeline"
                                     Style="{StaticResource HermesListStyle}"
                                     ItemsSource="{Binding Turns}"
                                     Visibility="{Binding IsTimelineScopeCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     PreviewMouseWheel="BoundedPixelScroll_PreviewMouseWheel"
                                     ScrollViewer.ScrollChanged="Timeline_ScrollChanged"
                                     Padding="16,12">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5">
                                            <!-- A turn always renders in semantic order. Late
                                                 activity mutates this middle layer instead of
                                                 appending below the assistant answer. -->
                                            <ItemsControl ItemsSource="{Binding UserMessages}"
                                                          Visibility="{Binding HasUserMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MaxWidth="640"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,0,0,5"
                                                                Padding="14,11"
                                                                Background="{DynamicResource SelectedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="15,15,4,15">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Heading}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextBrush}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding TimeText}"
                                                                               Margin="10,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                                </Grid>
                                                                <TextBlock Text="{local:UiText workbench.clarification.answerLabel}"
                                                                           Visibility="{Binding IsClarificationAnswer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                                                <ItemsControl ItemsSource="{Binding Images}"
                                                                              Visibility="{Binding HasImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Click="SentImagePreview_Click" ToolTip="{local:UiText chat.image.view}"
                                                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="6" Margin="0,8,0,0"
                                                                                    HorizontalAlignment="Right" AutomationProperties.AutomationId="HermesSentImagePreview">
                                                                                <StackPanel Width="220">
                                                                                    <Grid Height="160">
                                                                                        <Border Background="{DynamicResource InputBrush}">
                                                                                            <Image x:Name="HistoryImageThumbnail" Source="{Binding Converter={StaticResource HermesImagePreviewConverter}}" Stretch="Uniform"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{local:UiText chat.image.unavailable}" TextWrapping="Wrap"
                                                                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                                                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=HistoryImageThumbnail}" Value="{x:Null}">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger></Style.Triggers>
                                                                                            </Style></TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" FontSize="11"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding ImageDisplayText}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Expander Style="{StaticResource DarkDisclosureExpanderStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      IsExpanded="{Binding IsActivityExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding HasActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Grid MinHeight="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ActivitySummary}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentStrongBrush}"/>
                                                            <TextBlock Text="{local:UiText ui.streaming}"
                                                                       Visibility="{Binding IsActivityStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource AccentStrongBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ActivityTimeText}"
                                                                   Margin="10,0,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding ActivityRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Heading}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentStrongBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding TimeText}"
                                                                           Margin="10,0,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.ColumnSpan="2"
                                                                           Text="{Binding Text}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,4,0,0"/>
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.ColumnSpan="2"
                                                                           Text="{Binding Detail}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,4,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <ItemsControl ItemsSource="{Binding AssistantMessages}"
                                                          Visibility="{Binding HasAssistantMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MaxWidth="640"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,5,0,0"
                                                                Padding="14,11"
                                                                Background="{DynamicResource PanelRaisedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="15,15,15,4"
                                                                Visibility="{Binding HasGeneratedImageDisplayContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Heading}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentStrongBrush}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding TimeText}"
                                                                               Margin="10,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding GeneratedImageDisplayText}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0"/>
                                                                <TextBlock Text="{local:UiText ui.streaming.137}"
                                                                           Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource AccentStrongBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding GeneratedImages}"
                                                          Visibility="{Binding HasGeneratedImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                            <Button Click="GeneratedImagePreview_Click" Unloaded="GeneratedImagePreview_Unloaded" ToolTip="{local:UiText chat.image.view}"
                                                                    Padding="6" HorizontalAlignment="Left" IsEnabled="{Binding IsDelivered}"
                                                                    AutomationProperties.AutomationId="HermesGeneratedImagePreview">
                                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger></Style.Triggers>
                                                                </Style></Button.Style>
                                                                <Grid Width="256" Height="190">
                                                                    <Border Background="{DynamicResource InputBrush}">
                                                                        <Image x:Name="GeneratedImageThumbnail" Loaded="GeneratedImage_Loaded"
                                                                               Unloaded="GeneratedImage_Unloaded" Stretch="Uniform"/>
                                                                    </Border>
                                                                    <TextBlock Text="{local:UiText chat.image.generated.loading}" TextWrapping="Wrap"
                                                                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                            <Border Padding="12" CornerRadius="10" Background="{DynamicResource PanelRaisedBrush}"
                                                                    Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding FallbackPath}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                               AutomationProperties.AutomationId="HermesGeneratedImageFallbackPath"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding AudioAttachments}"
                                                          Visibility="{Binding HasAudioAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MaxWidth="640"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,7,0,0"
