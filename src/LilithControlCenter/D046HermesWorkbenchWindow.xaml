                                                         </Grid.ColumnDefinitions>
                                                         <Button AutomationProperties.AutomationId="HermesSubagentSteerButton"
                                                                 Content="{local:UiText ui.add.guidance}"
                                                                 Style="{StaticResource SecondaryButtonStyle}"
                                                                 IsEnabled="{Binding CanSteer}"
                                                                 Click="SubagentSteerButton_Click"/>
                                                         <Button Grid.Column="2"
                                                                 AutomationProperties.AutomationId="HermesSubagentInterruptButton"
                                                                 Content="{local:UiText ui.stop}"
                                                                 Style="{StaticResource SecondaryButtonStyle}"
                                                                 IsEnabled="{Binding CanInterrupt}"
                                                                 Click="SubagentInterruptButton_Click"/>
                                                     </Grid>
                                                 </StackPanel>
                                             </Border>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </StackPanel>
                         </Border>

                         <Border x:Name="HermesCompressionStatus"
                                 AutomationProperties.AutomationId="HermesCompressionStatus"
                                 Margin="0,10,0,0"
                                 Padding="12"
                                 Background="{DynamicResource PanelBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="12">
                             <StackPanel>
                                 <TextBlock Text="{local:UiText ui.native.context.compression}"
                                            FontSize="11"
                                            Foreground="{DynamicResource MutedBrush}"/>
                                 <TextBlock Text="{Binding CompressionStatusText}"
                                            TextWrapping="Wrap"
                                            Margin="0,5,0,0"/>
                                 <TextBlock Text="{local:UiText ui.message.token.counts.come.only.from.session.compress.responses}"
                                            TextWrapping="Wrap"
                                            FontSize="11"
                                            Foreground="{DynamicResource MutedBrush}"
                                            Margin="0,8,0,0"/>
                              </StackPanel>
                          </Border>

                          <Expander x:Name="HermesRollbackPanel"
                                    Style="{StaticResource DarkDisclosureExpanderStyle}"
                                    AutomationProperties.AutomationId="HermesRollbackPanel"
                                    Header="{local:UiText ui.workspace.checkpoints}"
                                    IsExpanded="False"
                                    Margin="0,10,0,0">
                              <Border Padding="12"
                                      Background="{DynamicResource PanelBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="12">
                                  <StackPanel>
                                      <Button x:Name="HermesRollbackRefreshButton"
                                              AutomationProperties.AutomationId="HermesRollbackRefreshButton"
                                              Content="{local:UiText ui.load.checkpoints}"
                                              Style="{StaticResource SecondaryButtonStyle}"
                                              IsEnabled="{Binding CanRefreshRollback}"
                                              HorizontalAlignment="Stretch"
                                              Click="RollbackRefreshButton_Click"/>
                                      <TextBlock x:Name="HermesRollbackStatus"
                                                 AutomationProperties.AutomationId="HermesRollbackStatus"
                                                 Text="{Binding RollbackStatusText}"
                                                 TextWrapping="Wrap"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource MutedBrush}"
                                                 Margin="0,8,0,0"/>
                                      <ComboBox x:Name="HermesRollbackCheckpointSelector"
                                                AutomationProperties.AutomationId="HermesRollbackCheckpointSelector"
                                      ItemsSource="{Binding RollbackCheckpoints}"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                                SelectedItem="{Binding SelectedRollbackCheckpoint, Mode=TwoWay}"
                                                DisplayMemberPath="DisplayText"
                                                IsEnabled="{Binding CanSelectRollbackCheckpoint}"
                                                Margin="0,10,0,0"/>
                                      <Button x:Name="HermesRollbackDiffButton"
                                              AutomationProperties.AutomationId="HermesRollbackDiffButton"
                                              Content="{local:UiText ui.preview.full.workspace.changes}"
                                              Style="{StaticResource SecondaryButtonStyle}"
                                              IsEnabled="{Binding CanGetRollbackDiff}"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,8,0,0"
                                              Click="RollbackDiffButton_Click"/>
                                      <TextBox x:Name="HermesRollbackDiffText"
                                               AutomationProperties.AutomationId="HermesRollbackDiffText"
                                               Text="{Binding RollbackDiffText, Mode=OneWay}"
                                               IsReadOnly="True"
                                               AcceptsReturn="True"
                                               TextWrapping="NoWrap"
                                               MinHeight="72"
                                               MaxHeight="240"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Auto"
                                               Padding="8,6"
                                               Foreground="{DynamicResource TextBrush}"
                                               Background="{DynamicResource DisabledBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               Margin="0,8,0,0"/>
                                      <Button x:Name="HermesRollbackRestoreButton"
                                              AutomationProperties.AutomationId="HermesRollbackRestoreButton"
                                              Content="{local:UiText ui.restore.entire.workspace}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              IsEnabled="{Binding CanRestoreRollback}"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,8,0,0"
                                              Click="RollbackRestoreButton_Click"/>
                                  </StackPanel>
                              </Border>
                          </Expander>

                          <Border Margin="0,10,0,0"
                                 Padding="12"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="{local:UiText ui.current.model}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding ModelDisplayName}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="HermesNativeObservability"
                                AutomationProperties.AutomationId="HermesNativeObservability"
                                Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{local:UiText ui.native.runtime.observations}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="HermesObservabilityRefreshButton"
                                            AutomationProperties.AutomationId="HermesObservabilityRefreshButton"
                                            Content="{local:UiText ui.refresh}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding CanRefreshObservability}"
                                            Padding="8,4"
                                            Click="ObservabilityRefreshButton_Click"/>
                                </Grid>
                                <TextBlock AutomationProperties.AutomationId="HermesObservabilityStatus"
                                           Text="{Binding ObservabilityStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                                <TextBlock AutomationProperties.AutomationId="HermesUsageStatus"
                                           Text="{Binding UsageStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                                <TextBlock AutomationProperties.AutomationId="HermesContextStatus"
                                           Text="{Binding ContextStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                                <TextBlock AutomationProperties.AutomationId="HermesCompressionCountStatus"
                                           Text="{Binding CompressionCountStatusText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                                <Expander x:Name="HermesLearningPanel"
                                          Style="{StaticResource DarkDisclosureExpanderStyle}"
                                          AutomationProperties.AutomationId="HermesLearningPanel"
                                          Header="{local:UiText ui.learning.records}"
                                          IsExpanded="False"
                                          Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LearningStatusText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <ItemsControl ItemsSource="{Binding LearningItems}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               TextWrapping="Wrap"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="{local:UiText ui.native.events}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding EventCountText}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="HermesRenameTaskOverlay"
                  AutomationProperties.AutomationId="HermesRenameTaskOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="100"
                  FocusManager.IsFocusScope="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  PreviewKeyDown="RenameTaskOverlay_PreviewKeyDown"
                  Visibility="Collapsed"
                  Background="{DynamicResource OverlayBrush}">
                <Border Width="480"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{local:UiText ui.rename.chat}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:UiText ui.only.the.title.changes.conversation.content.is.preserved}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBox x:Name="HermesRenameTaskInput"
                                 AutomationProperties.AutomationId="HermesRenameTaskInput"
                                 MaxLength="160"
                                 Padding="12,10"
                                 Margin="0,18,0,0"
                                 Background="{DynamicResource DisabledBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 KeyDown="RenameTaskInput_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="{local:UiText ui.cancel}" Style="{StaticResource SecondaryButtonStyle}"
                                    IsCancel="True"
                                    Click="CancelRenameTaskButton_Click"/>
                            <Button x:Name="HermesRenameTaskConfirmButton"
                                    AutomationProperties.AutomationId="HermesRenameTaskConfirmButton"
                                    Content="{local:UiText ui.save.name}" Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="ConfirmRenameTaskButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="HermesDeleteTaskOverlay"
                  AutomationProperties.AutomationId="HermesDeleteTaskOverlay"
                  AutomationProperties.LiveSetting="Assertive"
                  Grid.RowSpan="3"
                  Panel.ZIndex="110"
                  FocusManager.IsFocusScope="True"
                  KeyboardNavigation.TabNavigation="Cycle"
                  PreviewKeyDown="DeleteTaskOverlay_PreviewKeyDown"
                  Visibility="Collapsed"
                  Background="{DynamicResource OverlayBrush}">
                <Border Width="500"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="{local:UiText ui.permanently.delete.chat}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock x:Name="HermesDeleteTaskTargetText"
                                   AutomationProperties.AutomationId="HermesDeleteTaskTargetText"
                                   Margin="0,9,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{local:UiText ui.hermes.permanently.deletes.the.conversation.it.cannot.be.restored}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="HermesDeleteTaskBusyText"
                                   AutomationProperties.AutomationId="HermesDeleteTaskBusyText"
                                   Text="{local:UiText ui.safely.closing.voice.and.deleting.chat}"
                                   Foreground="{DynamicResource AccentStrongBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="HermesDeleteTaskResultText"
                                   AutomationProperties.AutomationId="HermesDeleteTaskResultText"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button x:Name="HermesDeleteTaskCancelButton"
                                    AutomationProperties.AutomationId="HermesDeleteTaskCancelButton"
                                    Content="{local:UiText ui.cancel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsDefault="True"
                                    IsCancel="True"
                                    Click="CancelDeleteTaskButton_Click"/>
                            <Button x:Name="HermesDeleteTaskConfirmButton"
                                    AutomationProperties.AutomationId="HermesDeleteTaskConfirmButton"
                                    Content="{local:UiText ui.delete.permanently}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="ConfirmDeleteTaskButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
