<UserControl x:Class="LilithControlCenter.LatestTurnUsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LilithControlCenter"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="UsageBooleanVisibility"/></UserControl.Resources>
    <Border x:Name="LatestUsageContent" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="18" AutomationProperties.AutomationId="HomeLatestTurnUsage">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="{local:UiText usage.latest.title}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
            <Grid Grid.Row="1" Width="120" Height="120" Margin="0,12,18,0">
                <Ellipse Width="106" Height="106" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/>
                <Canvas Width="120" Height="120" Visibility="{Binding HasChart, Converter={StaticResource UsageBooleanVisibility}}">
                    <Path Data="{Binding CachedArc}" Fill="{DynamicResource GoodBrush}"/>
                    <Path Data="{Binding UncachedArc}" Fill="{DynamicResource AccentBrush}"/>
                    <Path Data="{Binding OutputArc}" Fill="{DynamicResource WarningBrush}"/>
                </Canvas>
                <TextBlock Text="{Binding ChartNote}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="17" FontSize="11">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding HasChart}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,12,20,0">
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{local:UiText usage.latest.cached}" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding CachedText}" FontSize="13" Margin="12,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{local:UiText usage.latest.uncached}" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding UncachedText}" FontSize="13" Margin="12,0,0,0"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{local:UiText usage.latest.output}" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding OutputText}" FontSize="13" Margin="12,0,0,0"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="12,12,0,0">
                <TextBlock Text="{local:UiText usage.latest.input}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding InputText}" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,8"/>
                <StackPanel Orientation="Horizontal"><TextBlock Text="{local:UiText usage.latest.hitRate}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HitRateText}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding RequestsText}" FontSize="11" Margin="0,10,0,0"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip="{local:UiText usage.latest.help}"/>
        </Grid>
    </Border>
</UserControl>
