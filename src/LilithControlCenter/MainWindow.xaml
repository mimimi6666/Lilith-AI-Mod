<Window x:Class="LilithControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LilithControlCenter"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lilith Control Center"
        Width="1240" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Icon="Assets/lilith-control-center-icon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="7"
                            CornerRadius="14" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Shared navigation templates own icons and selection state. -->
            <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" CornerRadius="13,0,0,13" Padding="14,22,14,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/lilith-control-center-icon.png"
                               Width="60" Height="54" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LILITH" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="CONTROL CENTER" FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{local:UiText nav.functions}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,7"/>
                        <Button x:Name="HomeNav" Style="{StaticResource NavButtonStyle}"
                                Content="{local:UiText nav.home}" Tag="Home" Click="NavigationButton_Click"/>
                        <Button x:Name="ProvidersNav" Style="{StaticResource NavButtonStyle}"
                                Content="{local:UiText nav.providers}" Tag="Providers" Click="NavigationButton_Click"/>
                        <Button x:Name="LilithNav" Style="{StaticResource NavButtonStyle}"
                                Content="{local:UiText nav.lilith}" Tag="Lilith" Click="NavigationButton_Click"/>
                        <Button x:Name="InteractionNav" Style="{StaticResource NavButtonStyle}"
                                Content="{local:UiText nav.interaction}" Tag="Interaction" Click="NavigationButton_Click"/>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}"
                                Content="{local:UiText nav.settings}" Tag="Settings" Click="NavigationButton_Click"/>
                    </StackPanel>

                    <Button Grid.Row="3" x:Name="StatusNav" Tag="Settings"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource InputBrush}" Click="StatusButton_Click"
                            Padding="13,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GoodBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{local:OwnedUiLabel ConnectionText}" FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{local:UiText common.diagnostics}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Soft daylight diagonals remain behind the opaque form surfaces. -->
                <Viewbox Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False" Focusable="False">
                    <Canvas Width="1000" Height="820" ClipToBounds="True">
                        <Path Data="M 345,0 L 1000,0 L 1000,315 Z" Fill="{DynamicResource DecorativeBrush}" Opacity="0.42"/>
                        <Path Data="M 0,535 L 0,650 L 338,820 L 555,820 Z" Fill="{DynamicResource DecorativeBrush}" Opacity="0.55"/>
                        <Path Data="M 680,365 L 700,374 L 700,820 L 680,820 Z M 865,470 L 883,478 L 883,820 L 865,820 Z"
                              Fill="{DynamicResource DecorativeBrush}" Opacity="0.3"/>
                    </Canvas>
                </Viewbox>

                <Border Background="{DynamicResource TitleBarBrush}" CornerRadius="0,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                        <TextBlock x:Name="HeaderBreadcrumb" Text="{local:UiText nav.home}" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}" ToolTip="{local:UiText common.minimize}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.AutomationId="MainMinimize" Click="MinimizeButton_Click">
                            <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" ToolTip="{local:UiText settings.closeHelp}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.AutomationId="MainHideToTray" Click="CloseButton_Click">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>
                    </StackPanel>
                </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="34,32,34,28">
                    <Grid x:Name="HomePage">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{local:UiText ui.welcome.back}" Style="{StaticResource PageTitleStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{local:UiText common.refresh}" Margin="18,2,0,0"
                                            VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshButton_Click"/>
                                </Grid>

                                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource HeroBrush}"
                                        BorderBrush="{DynamicResource WindowBorderBrush}" ClipToBounds="True"
                                        Padding="28,30" Margin="0,26,0,0" MinHeight="252">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="192"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.ColumnSpan="2" Stretch="Fill" Margin="-28,-30" IsHitTestVisible="False">
                                            <Canvas Width="900" Height="260" ClipToBounds="True">
                                                <Canvas.Clip>
                                                    <RectangleGeometry Rect="0,0,900,260" RadiusX="15" RadiusY="15"/>
                                                </Canvas.Clip>
                                                <Path Data="M 760,0 L 900,0 L 900,118 Z" Fill="{DynamicResource HeroAccentBrush}"/>
                                                <Path Data="M 800,260 L 900,260 L 900,202 L 846,161 L 825,178 L 900,239 L 900,254 L 813,185 L 793,204 L 860,260 Z"
                                                      Fill="{DynamicResource HeroAccentBrush}"/>
                                                <Path Data="M 120,0 L 170,0 L 515,260 L 465,260 Z" Fill="{DynamicResource DecorativeBrush}" Opacity="0.24"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Left"
                                                    Background="{DynamicResource PanelRaisedBrush}">
                                                <TextBlock Text="{local:UiText ui.game.connection}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <TextBlock Text="{local:OwnedUiLabel ConnectionText}" FontSize="27"
                                                       FontWeight="SemiBold" Margin="0,14,0,0"/>
                                            <WrapPanel Margin="0,20,0,0">
                                                <Button Content="{local:UiText ui.talk.to.lilith}" Style="{StaticResource PrimaryButtonStyle}"
                                                        Tag="Interaction" Click="QuickNavigate_Click" Margin="0,0,10,0"/>
                                                <Button Content="{local:UiText ui.quick.check}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="OpenDiagnostics_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Ellipse Width="174" Height="174" Fill="{DynamicResource PanelBrush}"
                                                     Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                                            <Ellipse Width="156" Height="156" Stroke="{DynamicResource DecorativeBrush}" StrokeThickness="1"/>
                                            <Image Source="Assets/lilith-control-center-icon.png"
                                                   Width="154" Height="154" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <local:HomeResourceMonitor Margin="0,32,0,0"/>
                                <local:LatestTurnUsagePanel x:Name="HomeLatestUsagePanel" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ProvidersPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,18">
                                <TextBlock Text="{local:UiText nav.providers}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{local:UiText ui.manage.model.providers.tools.and.approvals.saved.settings.readiness}"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0"/>

                                <Border x:Name="HermesCredentialCard"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,24,0,0"
                                        Padding="22"
                                        Background="{DynamicResource PanelBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="API Key" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{local:UiText ui.managed.directly.by.hermes.with.one.key.per.provider}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,18,0"/>
                                            </StackPanel>
                                            <Button x:Name="HermesCredentialRefreshButton"
                                                    AutomationProperties.AutomationId="HermesCredentialRefreshButton"
                                                    Grid.Column="1"
                                                    Content="{local:UiText common.refresh}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    VerticalAlignment="Top"
                                                    Click="HermesCredentialRefresh_Click"/>
                                        </Grid>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="310"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ListBox x:Name="HermesCredentialProviderList"
                                                     AutomationProperties.AutomationId="HermesCredentialProviderList"
                                                     VerticalAlignment="Top"
                                                     MinHeight="152"
                                                     MaxHeight="250"
                                                     Padding="5"
                                                     Background="{DynamicResource InputBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"
                                                     SelectionChanged="HermesCredentialProviderList_SelectionChanged"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="12,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       TextWrapping="Wrap" ToolTip="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                       Text="{Binding StatusText}" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock x:Name="HermesCredentialEmptyText"
                                                       Text="{local:UiText management.providersNotLoaded}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock x:Name="HermesCredentialSelectedProviderText"
                                                           Text="{local:UiText ui.choose.a.provider.first}"
                                                           TextWrapping="Wrap"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel x:Name="HermesCredentialRegionPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="{local:UiText credential.region.label}" Foreground="{DynamicResource MutedBrush}"/>
                                                    <ComboBox x:Name="HermesCredentialRegionSelector" Margin="0,6,0,0"
                                                              DisplayMemberPath="VariantLabel" IsEnabled="False"
                                                              AutomationProperties.AutomationId="HermesCredentialRegionSelector"
                                                              SelectionChanged="HermesCredentialRegionSelector_SelectionChanged"/>
                                                    <TextBlock Text="{local:UiText credential.region.selectionOnly}" FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel x:Name="HermesCredentialEndpointPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="{local:UiText credential.region.endpoint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                    <TextBlock x:Name="HermesCredentialEndpointText" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="HermesCredentialRegionStateText" Margin="0,8,0,0" FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{local:UiText ui.enter.a.new.api.key}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,13,0,7"/>
                                                <PasswordBox x:Name="HermesCredentialApiKeyInput"
                                                             AutomationProperties.AutomationId="HermesCredentialApiKeyInput"
                                                             PasswordChar="●"
                                                             MaxLength="16384"
                                                             Padding="14,11"
                                                             Background="{DynamicResource InputBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}"
                                                             BorderThickness="1"
                                                             IsEnabled="False"
                                                             PasswordChanged="HermesCredentialApiKeyInput_PasswordChanged"/>
                                                <TextBlock Text="{local:UiText ui.leaving.this.blank.preserves.the.current.setting.the.input}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,6,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="HermesCredentialSaveButton"
                                                            AutomationProperties.AutomationId="HermesCredentialSaveButton"
                                                            Content="{local:UiText ui.save.replace}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            IsEnabled="False"
                                                            Click="HermesCredentialSave_Click"/>
                                                    <Button x:Name="HermesCredentialDeleteButton"
                                                            AutomationProperties.AutomationId="HermesCredentialDeleteButton"
                                                            Content="{local:UiText ui.delete}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Margin="10,0,0,0"
                                                            IsEnabled="False"
                                                            Click="HermesCredentialDelete_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="HermesCredentialStatusText"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="{local:UiText ui.repair.33}"
                                                   Text="{local:UiText ui.hermes.api.key.status.is.loaded.when.this.page}"
                                                   Foreground="{DynamicResource AccentStrongBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Margin="0,14,0,0"/>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                Margin="0,18,0,0" Padding="0,14,0,0">
                                            <StackPanel>
                                                <Button x:Name="OpenCustomProviderSettingsButton"
                                                        AutomationProperties.AutomationId="OpenCustomProviderSettingsButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalContentAlignment="Stretch" Padding="14,12"
                                                        Click="OpenCustomProviderSettings_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="24"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentStrongBrush}"/>
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{local:UiText provider.setup.title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{local:UiText settings.dialog.custom.summary}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="OpenTelegramSettingsButton"
                                                        AutomationProperties.AutomationId="OpenTelegramSettingsButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalContentAlignment="Stretch" Padding="14,12" Margin="0,8,0,0"
                                                        Click="OpenTelegramSettings_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentStrongBrush}"/>
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="Telegram" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{local:UiText settings.dialog.telegram.summary}"
                                                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Text, ElementName=TelegramConnectionStateText}"
                                                                       Foreground="{Binding Foreground, ElementName=TelegramConnectionStateText}"
                                                                       FontSize="12"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- One editor instance per settings surface. These are reparented
                                     into owned windows; no duplicate draft or mutation authority. -->
                                <StackPanel x:Name="SettingsDialogParkingPanel" Visibility="Collapsed">
                                <local:ProviderSetupPanel x:Name="ProviderSetupSettingsPanel"
                                    RefreshRequested="ProviderSetupRefresh_Click" SaveRequested="ProviderSetupSave_Click"
                                    RemoveRequested="ProviderSetupRemove_Click" ModelsRequested="ProviderSetupModels_Click"/>

                                <Border x:Name="TelegramMessagingCard"
                                        Style="{StaticResource CardStyle}"
                                        Padding="22"
                                        Background="{DynamicResource PanelBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Telegram" Style="{StaticResource SectionTitleStyle}"/>
                                                    <Border Margin="10,0,0,0"
                                                            Padding="9,4"
                                                            CornerRadius="12"
                                                            Background="{DynamicResource PanelRaisedBrush}">
                                                        <TextBlock x:Name="TelegramConnectionStateText"
                                                                   AutomationProperties.AutomationId="TelegramConnectionStateText"
                                                                   Text="{local:UiText ui.not.loaded.yet}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{local:UiText ui.chat.with.lilith.in.telegram.it.shares.memory.with}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,7,18,0"/>
                                            </StackPanel>
                                            <Button x:Name="TelegramRefreshButton"
                                                    AutomationProperties.AutomationId="TelegramRefreshButton"
                                                    Grid.Column="1"
                                                    Content="{local:UiText common.refresh}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    VerticalAlignment="Top"
                                                    Click="TelegramRefresh_Click"/>
                                        </Grid>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{local:UiText ui.connect.a.bot}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{local:UiText ui.create.a.bot.with.botfather.in.telegram.then.paste}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,7,0,0"/>
                                                <PasswordBox x:Name="TelegramBotTokenInput"
                                                             AutomationProperties.AutomationId="TelegramBotTokenInput"
                                                             PasswordChar="●"
                                                             MaxLength="512"
                                                             Padding="14,11"
                                                             Margin="0,12,0,0"
                                                             Background="{DynamicResource InputBrush}"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}"
                                                             BorderThickness="1"
                                                             IsEnabled="False"
                                                             PasswordChanged="TelegramBotTokenInput_PasswordChanged"/>
                                                <TextBlock Text="{local:UiText ui.the.input.is.cleared.immediately.after.every.operation}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="TelegramSaveButton"
                                                            AutomationProperties.AutomationId="TelegramSaveButton"
                                                            Content="{local:UiText ui.save.change}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            IsEnabled="False"
                                                            Click="TelegramSave_Click"/>
                                                    <Button x:Name="TelegramRemoveButton"
                                                            AutomationProperties.AutomationId="TelegramRemoveButton"
                                                            Content="{local:UiText ui.disconnect}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Margin="10,0,0,0"
                                                            IsEnabled="False"
                                                            Click="TelegramRemove_Click"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{local:UiText ui.who.can.use.it}" FontSize="16" FontWeight="SemiBold"/>
