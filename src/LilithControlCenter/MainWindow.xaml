                                                <TextBlock x:Name="ProviderRuntimeLayerText" Text="{local:UiText ui.runtime.not.verified}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                            </UniformGrid>
                                            <TextBlock Text="{local:UiText ui.green.successful.observation.at.that.layer.amber.unchecked.timed}"
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{local:UiText ui.default.text.model.for.this.provider.exact.model.id}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
                                            <ComboBox x:Name="ProviderModelSelector"
                                                      MinWidth="320"
                                                      Style="{StaticResource DarkComboBoxStyle}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      IsEnabled="False"/>
                                            <TextBlock Text="{local:UiText ui.if.the.provider.has.no.catalog.enter.the.exact}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="ProviderApplyModelButton" Grid.Column="1" Content="{local:UiText ui.apply.text.model}" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Margin="10,23,0,0" Click="ProviderApplyModelButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                        <Button x:Name="ProviderPrepareValidationButton" Content="{local:UiText ui.verify.and.save.securely}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Visibility="Collapsed" Click="ProviderPrepareValidationButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ProviderOperationStatusText" Text="{local:UiText ui.d.033.source.preview.live.validation.credential.entry.and}" Foreground="{DynamicResource AccentStrongBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,11,0,0"/>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="LilithPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{local:UiText nav.lilith}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{local:UiText ui.view.correct.or.forget.memories.saved.by.lilith}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0"/>
                                <local:D048ExpressionPanel x:Name="LilithExpressionPanel" Margin="0,18,0,0"/>
                                <local:D057MemoryManagementPanel
                                    x:Name="LilithMemoryManagementPanel"
                                    Margin="0,18,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="InteractionPage" Visibility="Collapsed" IsVisibleChanged="LettersPage_IsVisibleChanged">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{local:UiText nav.interaction}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{local:UiText ui.choose.how.lilith.interacts.with.you.full.tool.settings}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="LettersEnabled" Content="{local:UiText manual.notes.auto.title}" FontSize="18" IsEnabled="False" Click="LettersSave_Click"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{local:UiText ui.daily.maximum}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="LettersDailyLimit" Text="1" Width="64" Padding="8,6" TextAlignment="Center" Margin="8,0"/>
                                            <TextBlock Text="{local:UiText ui.letters}" VerticalAlignment="Center"/>
                                            <Button x:Name="LettersSave" Content="{local:UiText ui.save.limit}" Margin="16,0,8,0" Click="LettersSave_Click"/>
                                            <Button Content="{local:UiText ui.reload}" Click="LettersRefresh_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{local:UiText ui.letters.follow.real.conversations.and.are.left.while.you}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="LettersStatusText" Text="{local:UiText ui.settings.not.loaded.yet}" TextWrapping="Wrap" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Loaded="ManualNotes_Loaded">
                                    <StackPanel>
                                        <CheckBox x:Name="ManualNotesEnabled" Content="{local:UiText manual.notes.title}"
                                                  AutomationProperties.AutomationId="ManualNotesEnabled" FontSize="18"
                                                  IsEnabled="False" Click="ManualNotes_Click"/>
                                        <TextBlock Text="{local:UiText manual.notes.description}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="ManualNotesStatusText" Text="{local:UiText ui.settings.not.loaded.yet}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Background="{DynamicResource HeroBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{local:UiText ui.lilith.workbench}" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{local:UiText ui.chat.review.history.or.work.together}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="OpenWorkbenchButton"
                                                Content="{local:UiText ui.open.lilith.workbench}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                VerticalAlignment="Center" Margin="22,0,0,0"
                                                Click="OpenWorkbench_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{local:UiText settings.title}" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="{local:UiText settings.subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0"/>
                                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:UiText settings.language}" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="InterfaceLanguageSelector" AutomationProperties.AutomationId="InterfaceLanguageSelector"
                                                  SelectedValuePath="Code" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="220"
                                                  Margin="0,8,0,0" SelectionChanged="InterfaceLanguage_SelectionChanged"/>
                                        <TextBlock Text="{local:UiText settings.languageHelp}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,18"/>
                                        <TextBlock Text="{local:UiText settings.theme}" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="ThemeModeSelector" AutomationProperties.AutomationId="ThemeModeSelector"
                                                  AutomationProperties.Name="{local:UiText settings.theme}"
                                                  SelectedValuePath="Tag" HorizontalAlignment="Left" MinWidth="220"
                                                  Margin="0,8,0,0" SelectionChanged="ThemeMode_SelectionChanged">
                                            <ComboBoxItem Tag="system" Content="{local:UiText settings.themeSystem}"/>
                                            <ComboBoxItem Tag="light" Content="{local:UiText settings.themeLight}"/>
                                            <ComboBoxItem Tag="dark" Content="{local:UiText settings.darkMode}"/>
                                        </ComboBox>
                                        <TextBlock Text="{local:UiText settings.themeHelp}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,18"/>
                                        <CheckBox x:Name="ChatSendSoundCheckBox" AutomationProperties.AutomationId="ChatSendSoundCheckBox"
                                                  Content="{local:UiText settings.sound}" Click="ChatSendSound_Click"/>
                                        <TextBlock Text="{local:UiText settings.soundHelp}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="56,6,0,18"/>
                                        <CheckBox x:Name="StartupCheckBox" AutomationProperties.AutomationId="StartupCheckBox"
                                                  Content="{local:UiText settings.startup}" Click="Startup_Click"/>
                                        <TextBlock Text="{local:UiText settings.startupHelp}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="56,6,0,18"/>
                                        <TextBlock x:Name="DesktopSettingsStatus" AutomationProperties.AutomationId="DesktopSettingsStatus"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <local:UsageBudgetPanel x:Name="UsageBudgetSettingsPanel" Margin="0,18,0,0"/>
                                <Border x:Name="PlayerSaveDataCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{local:UiText playerSave.title}" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{local:UiText playerSave.help}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{local:UiText playerSave.privacy}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,14"/>
                                        <WrapPanel>
                                            <Button x:Name="PlayerSaveExportButton" AutomationProperties.AutomationId="PlayerSaveExportButton"
                                                    Content="{local:UiText playerSave.export}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8" Click="PlayerSaveExport_Click"/>
                                            <Button x:Name="PlayerSaveImportButton" AutomationProperties.AutomationId="PlayerSaveImportButton"
                                                    Content="{local:UiText playerSave.import}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,0,8" Click="PlayerSaveImport_Click"/>
                                        </WrapPanel>
                                        <ProgressBar x:Name="PlayerSaveProgress" AutomationProperties.AutomationId="PlayerSaveProgress"
                                                     IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,4,0,8"/>
                                        <TextBlock x:Name="PlayerSaveStatusText" AutomationProperties.AutomationId="PlayerSaveStatusText"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PlayerSaveRestartText" Text="{local:UiText playerSave.restart}"
                                                   Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <local:D046GameControlsPanel Margin="0,18,0,0"/>
                                <Expander x:Name="AdvancedDiagnosticsPanel" Header="{local:UiText common.diagnostics}" IsExpanded="False" Style="{StaticResource SectionExpanderStyle}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="{local:UiText ui.game.observations}" Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{local:UiText ui.activity.reported.by.the.game.only.this.does.not}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                                <TextBlock Text="{Binding TelemetryObservedAt}" Foreground="{DynamicResource MutedBrush}"/>
                                                <ItemsControl ItemsSource="{Binding DiagnosticTelemetryRows}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="{local:UiText ui.game.runtime.generation}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding RuntimeGeneration}"/>
                                                <TextBlock Grid.Row="1" Text="{local:UiText ui.configuration.generation}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigurationGeneration}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="2" Text="{local:UiText ui.game.runtime.identity}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeIdentity}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="3" Text="{local:UiText ui.session.identity}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SessionIdentity}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="4" Text="{local:UiText ui.schema.fingerprint}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SchemaFingerprint}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="5" Text="{local:UiText ui.configuration.fingerprint}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SemanticFingerprint}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="6" Text="{local:UiText ui.observation.fingerprint}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ObservationFingerprint}" Margin="0,10,0,0"/>
                                                <TextBlock Grid.Row="7" Text="{local:UiText ui.last.updated}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ObservedAt}" Margin="0,10,0,0"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Grid>
            <Border x:Name="DailyNoteApprovalCard" Grid.ColumnSpan="2" Panel.ZIndex="100"
                    Style="{StaticResource CardStyle}" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="660" Margin="24">
                <StackPanel>
                    <TextBlock Text="{local:UiText ui.daily.image.note.native.hermes.approval}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:UiText ui.an.independent.background.note.request.no.new.chat.or}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DailyNoteApprovalDescription" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DailyNoteApprovalCommand" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="DailyNoteApprovalStatus" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource AccentStrongBrush}"/>
                    <WrapPanel Margin="0,13,0,0">
                        <Button x:Name="DailyNoteAllowOnce" Tag="once" Content="{local:UiText ui.allow.once}" Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}" Click="DailyNoteApprovalChoice_Click"/>
                        <Button x:Name="DailyNoteAllowSession" Tag="session" Content="{local:UiText ui.allow.this.background.job}" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}" Click="DailyNoteApprovalChoice_Click"/>
                        <Button x:Name="DailyNoteAllowAlways" Tag="always" Content="{local:UiText ui.always.allow}" Margin="0,0,8,8"
                                ToolTip="{local:UiText ui.updates.native.hermes.approval.rules}" Style="{StaticResource SecondaryButtonStyle}" Click="DailyNoteApprovalChoice_Click"/>
                        <Button x:Name="DailyNoteDeny" Tag="deny" Content="{local:UiText ui.deny}" Margin="0,0,0,8"
                                Style="{StaticResource SecondaryButtonStyle}" Click="DailyNoteApprovalChoice_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
