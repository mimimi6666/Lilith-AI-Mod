<UserControl x:Class="LilithControlCenter.UsageBudgetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LilithControlCenter">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BudgetVisible"/>
        <Style x:Key="BudgetTickStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="16"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform X="-8"/></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource CardStyle}" Padding="28,22">
        <StackPanel x:Name="BudgetContent">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{local:UiText budget.title}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BudgetRefreshButton" Width="28" Height="28" Padding="5"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource MutedBrush}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"
                        ToolTip="{local:UiText common.refresh}" AutomationProperties.Name="{local:UiText common.refresh}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RefreshSurface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RefreshSurface" Property="Background" Value="{DynamicResource PanelHoverBrush}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RefreshSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="RefreshSurface" Property="BorderThickness" Value="1"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 11.6,4.5 A 5,5 0 1 0 12,8 M 11.6,1 L 11.6,4.5 L 8,4.5"/>
                </Button>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="BudgetLevelText" Text="{Binding ModeName}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap">
                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{Binding ModeSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Text="{Binding PreviewCaption}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ModeIndex}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,0" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>

            <Slider x:Name="BudgetSlider" AutomationProperties.AutomationId="UsageBudgetSlider"
                    AutomationProperties.Name="{local:UiText budget.title}" AutomationProperties.HelpText="{local:UiText budget.help}"
                    Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                    Value="{Binding PreviewLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding CanPreview}" IsMoveToPointEnabled="True" Height="42" Margin="-12,14,-12,0"
                    SizeChanged="Slider_SizeChanged" ValueChanged="Slider_ValueChanged"
                    PreviewMouseLeftButtonUp="Slider_Released" LostKeyboardFocus="Slider_LostKeyboardFocus">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="BudgetRail" Background="Transparent">
                            <Border Height="4" Margin="16,0" CornerRadius="2" Background="{DynamicResource PanelHoverBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="BudgetProgress" Width="0" Height="4" Margin="16,0,0,0" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                   Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="32" Height="32">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="Transparent"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                            <!-- The native thumb owns input/automation; decoration only eases. -->
                            <Canvas IsHitTestVisible="False" Height="32" VerticalAlignment="Center">
                                <Grid x:Name="BudgetVisualThumb" Width="32" Height="32" Canvas.Left="0">
                                    <Ellipse Width="20" Height="20" Fill="{DynamicResource SwitchThumbBrush}"
                                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                                        <Ellipse.Effect><DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.14"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Canvas>
                            <Border x:Name="BudgetFocusRing" Height="32" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource FocusBrush}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="BudgetFocusRing" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
            <Grid Margin="4,0,4,20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="BudgetTick1" Text="1" Style="{StaticResource BudgetTickStyle}"/><TextBlock x:Name="BudgetTick2" Grid.Column="1" Text="2" Style="{StaticResource BudgetTickStyle}"/>
                <TextBlock x:Name="BudgetTick3" Grid.Column="2" Text="3" Style="{StaticResource BudgetTickStyle}"/><TextBlock x:Name="BudgetTick4" Grid.Column="3" Text="4" Style="{StaticResource BudgetTickStyle}"/>
                <TextBlock x:Name="BudgetTick5" Grid.Column="4" Text="5" Style="{StaticResource BudgetTickStyle}"/>
                <TextBlock x:Name="BudgetTick6" Grid.Column="4" Text="6" Style="{StaticResource BudgetTickStyle}" HorizontalAlignment="Right">
                    <TextBlock.RenderTransform><TranslateTransform X="8"/></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="0,0,0,18"
                    Visibility="{Binding ShowCostWarning, Converter={StaticResource BudgetVisible}}">
                <TextBlock x:Name="BudgetCostWarning" Text="{local:UiText budget.costWarning}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
            </Border>
            <TextBlock x:Name="BudgetEstimateNote" Text="{local:UiText budget.estimateCompact}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,18"
                       Foreground="{DynamicResource MutedBrush}" Visibility="{Binding ShowEstimateNote, Converter={StaticResource BudgetVisible}}"/>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.18"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BudgetSavedText" Text="{Binding CompactSavedText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Visibility="{Binding ShowSavedSummary, Converter={StaticResource BudgetVisible}}"/>
                    <TextBlock x:Name="BudgetStatusText" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentStrongBrush}" Visibility="{Binding ShowStatusNotice, Converter={StaticResource BudgetVisible}}"/>
                </StackPanel>
                <Expander x:Name="BudgetDetails" Grid.Column="1" Header="{local:UiText budget.details}" FontSize="11"
                          Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" IsExpanded="False"
                          AutomationProperties.Name="{local:UiText budget.details}">
                    <Expander.Template>
                        <ControlTemplate TargetType="Expander">
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Header}" Cursor="Hand" Background="Transparent"
                                          AutomationProperties.Name="{local:UiText budget.details}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DetailsSurface" Padding="2" Background="Transparent" CornerRadius="3">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                                <Path x:Name="DetailsChevron" Data="M 0,0 L 3,3 L 6,0" Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1" Margin="7,0,1,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="DetailsChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DetailsSurface" Property="Background" Value="{DynamicResource PanelHoverBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DetailsSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/><Setter TargetName="DetailsSurface" Property="BorderThickness" Value="1"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </ControlTemplate>
                    </Expander.Template>
                </Expander>
            </Grid>
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsExpanded, ElementName=BudgetDetails, Converter={StaticResource BudgetVisible}}">
                <TextBlock x:Name="BudgetPreviewSource" Text="{Binding PreviewSourceText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ItemsControl x:Name="BudgetLimits" ItemsSource="{Binding LimitRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="BudgetLevelHelp" Text="{Binding LimitsNote}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding SavedText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="BudgetActivationText" Text="{Binding ActivationText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
