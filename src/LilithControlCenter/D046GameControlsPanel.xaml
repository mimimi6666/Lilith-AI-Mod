<UserControl x:Class="LilithControlCenter.D046GameControlsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LilithControlCenter"
             Loaded="D046GameControlsPanel_Loaded"
             Unloaded="D046GameControlsPanel_Unloaded"
             PreviewKeyDown="CaptureButton_PreviewKeyDown"
             PreviewKeyUp="CaptureButton_PreviewKeyUp"
             MinWidth="620">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:UiText ui.game.and.hotkeys}"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{local:UiText ui.manage.the.four.game.hotkeys.voice.and.proactive.conversations}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,7,18,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,19,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,7,0">
                    <TextBlock Text="{local:UiText ui.push.to.talk}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="PushToTalkKeySelector"
                            AutomationProperties.AutomationId="PushToTalkKeySelector"
                            AutomationProperties.Name="{local:UiText ui.repair.37}"
                            AutomationProperties.HelpText="{local:UiText ui.repair.38}"
                            Content="{Binding PushToTalkKeyText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            MinHeight="36"
                            Margin="0,7,0,0"
                            Click="PushToTalkKeySelector_Click"
                            LostKeyboardFocus="CaptureButton_LostKeyboardFocus"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="7,0">
                    <TextBlock Text="{local:UiText ui.text.input}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="TextChatKeySelector"
                            AutomationProperties.AutomationId="TextChatKeySelector"
                            AutomationProperties.Name="{local:UiText ui.repair.39}"
                            AutomationProperties.HelpText="{local:UiText ui.repair.38}"
                            Content="{Binding TextChatKeyText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            MinHeight="36"
                            Margin="0,7,0,0"
                            Click="TextChatKeySelector_Click"
                            LostKeyboardFocus="CaptureButton_LostKeyboardFocus"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="7,0">
                    <TextBlock Text="{local:UiText ui.conversation.history}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="ConversationHistoryKeySelector"
                            AutomationProperties.AutomationId="ConversationHistoryKeySelector"
                            AutomationProperties.Name="{local:UiText ui.repair.40}"
                            AutomationProperties.HelpText="{local:UiText ui.repair.38}"
                            Content="{Binding ConversationHistoryKeyText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            MinHeight="36"
                            Margin="0,7,0,0"
                            Click="ConversationHistoryKeySelector_Click"
                            LostKeyboardFocus="CaptureButton_LostKeyboardFocus"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="7,0,0,0">
                    <TextBlock Text="{local:UiText ui.stop}" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="StopKeySelector"
                            AutomationProperties.AutomationId="StopKeySelector"
                            AutomationProperties.Name="{local:UiText ui.repair.41}"
                            AutomationProperties.HelpText="{local:UiText ui.repair.38}"
                            Content="{Binding StopKeyText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Center"
                            MinHeight="36"
                            Margin="0,7,0,0"
                            Click="StopKeySelector_Click"
                            LostKeyboardFocus="CaptureButton_LostKeyboardFocus"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,7,0">
                    <TextBlock Text="{local:UiText ui.game.voice}" Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="VoiceLanguageSelector"
                              ToolTip="{local:UiText ui.game.voice.help}"
                              AutomationProperties.HelpText="{local:UiText ui.game.voice.help}"
                              ItemsSource="{Binding VoiceChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding VoiceLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <TextBlock Text="{local:UiText ui.f6.voice.input}"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="SpeechInputLanguageSelector"
                              ItemsSource="{Binding SpeechInputChoices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SpeechInputLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{local:UiText ui.game.voice.help}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>

            <Border Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="13,11"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{local:UiText ui.proactive.conversations}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{local:UiText ui.when.enabled.hermes.extends.eligible.game.observations.and.native}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="ProactiveDialogueToggle"
                              Grid.Column="1"
                              Content="{local:UiText ui.on}"
                              IsChecked="{Binding ProactiveDialogueEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="ProactiveDialogueToggle"
                              AutomationProperties.Name="{local:UiText ui.repair.42}"
                              AutomationProperties.HelpText="{local:UiText ui.repair.43}"
                              Foreground="{DynamicResource TextBrush}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="13,10"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding CaptureFeedbackText}"
                               Foreground="{local:ThemeBrush CaptureFeedbackColor}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ValidationText}"
                               Foreground="{local:ThemeBrush ValidationColor}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Content="{local:UiText ui.cancel}"
                            IsEnabled="{Binding CanCancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ApplyButton"
                            Content="{local:UiText ui.apply}"
                            IsEnabled="{Binding CanApply}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="9,0,0,0"
                            Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
