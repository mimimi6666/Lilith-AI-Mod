<UserControl x:Class="LilithControlCenter.D057MemoryManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LilithControlCenter"
             Unloaded="D057MemoryManagementPanel_Unloaded"
             MinWidth="720">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="D057BooleanToVisibilityConverter"/>
        <Style x:Key="D057CategoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="13,11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="D057EntryActionStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="D057ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{local:UiText ui.memory.management}"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{local:UiText ui.review.and.correct.what.lilith.remembers.changes.are.not}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button x:Name="D057MemoryRefreshButton"
                                    AutomationProperties.AutomationId="D057MemoryRefreshButton"
                                    Content="{local:UiText ui.refresh}"
                                    IsEnabled="{Binding CanRefresh}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RefreshButton_Click"/>
                            <Button x:Name="D057MemoryAddButton"
                                    AutomationProperties.AutomationId="D057MemoryAddButton"
                                    Content="{local:UiText ui.add.memory}"
                                    IsEnabled="{Binding CanManage}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="AddButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13,11"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="{local:UiText ui.automatic.memory}" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:UiText ui.clear.stable.information.can.enter.long.term.memory.inferences}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="D057AutoMemoryToggle"
                                      Grid.Column="1"
                                      Content="{local:UiText ui.on}"
                                      IsChecked="{Binding AutoMemoryEnabled, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggleAutoMemory}"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextBrush}"
                                      Click="AutoMemoryToggle_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13,10"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{local:ThemeBrush StatusBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,14,0"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Categories}"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource D057CategoryButtonStyle}"
                                        Click="CategoryButton_Click">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Count}"
                                                       Foreground="{DynamicResource AccentStrongBrush}"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:UiText ui.saved.memories}"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{local:UiText ui.forgetting.hides.a.memory.reversibly.only.forgotten.rejected.expired}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,20,0"/>
                        </StackPanel>
                        <TextBox x:Name="D057MemorySearchInput"
                                 Grid.Column="1"
                                 AutomationProperties.AutomationId="D057MemorySearchInput"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="13,9"
                                 Background="{DynamicResource InputBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 ToolTip="{local:UiText ui.search.this.category.s.content.or.source.excerpts}"/>
                    </Grid>

                    <Border Background="{DynamicResource PanelRaisedBrush}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasNoEntries, Converter={StaticResource D057BooleanToVisibilityConverter}}">
                        <TextBlock Text="{local:UiText ui.no.matching.memories.in.this.category}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="D057MemoryEntryList"
                             AutomationProperties.AutomationId="D057MemoryEntryList"
                             ItemsSource="{Binding Entries}"
                             ItemContainerStyle="{StaticResource D057ListBoxItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="540"
                             Margin="0,15,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="15">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource PillStyle}"
                                                        Padding="9,4"
                                                        Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding CategoryText}"
                                                               Foreground="{DynamicResource AccentStrongBrush}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Style="{StaticResource PillStyle}"
                                                        Padding="9,4">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Foreground="{local:ThemeBrush StateBrush}"
                                                               FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{local:UiText ui.pinned}"
                                                           Foreground="{DynamicResource GoodBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="10,5,0,0"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource D057BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SourceText}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Margin="0,12,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ObservedTimeText}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding UpdatedTimeText}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding ExpiryText}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="11"
                                                       Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource WindowBrush}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,9,0,0"
                                                Visibility="{Binding HasEvidence, Converter={StaticResource D057BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{local:UiText ui.source.excerpt}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding EvidenceExcerpt}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel Margin="0,12,0,-7">
                                            <Button Content="{local:UiText ui.accept}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsCandidate, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="AcceptButton_Click"/>
                                            <Button Content="{local:UiText ui.deny}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsCandidate, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="RejectButton_Click"/>
                                            <Button Content="{local:UiText ui.make.long.term}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsTemporary, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="PromoteTemporaryButton_Click"/>
                                            <Button Content="{Binding PinActionText}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanPin, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="PinButton_Click"/>
                                            <Button Content="{local:UiText ui.correct}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanCorrect, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="CorrectButton_Click"/>
                                            <Button Content="{Binding VisibilityActionText}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanForget, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="VisibilityButton_Click"/>
                                            <Button Content="{local:UiText ui.delete.permanently}"
                                                    Style="{StaticResource D057EntryActionStyle}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanPermanentlyDelete, Converter={StaticResource D057BooleanToVisibilityConverter}}"
                                                    Click="PermanentDeleteButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid x:Name="D057MemoryEditorOverlay"
              Panel.ZIndex="10"
              Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource D057BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"
                    Background="{DynamicResource PanelBrush}"
                    Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EditorTitle}"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                Click="CancelEditorButton_Click"/>
                    </Grid>
                    <StackPanel Margin="0,15,0,0"
                                Visibility="{Binding IsAddEditor, Converter={StaticResource D057BooleanToVisibilityConverter}}">
                        <TextBlock Text="{local:UiText ui.category}" Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox ItemsSource="{Binding EditorCategoryChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Category"
                                  SelectedValue="{Binding EditorCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Margin="0,7,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{local:UiText ui.content}"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,15,0,7"/>
                    <TextBox x:Name="D057MemoryEditorInput"
                             AutomationProperties.AutomationId="D057MemoryEditorInput"
                             Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="16384"
                             MinHeight="130"
                             MaxHeight="260"
                             VerticalScrollBarVisibility="Auto"
                             Padding="13,11"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"/>
                    <CheckBox Content="{local:UiText ui.pin.as.a.core.relationship.memory}"
                              IsChecked="{Binding EditorPinned, Mode=TwoWay}"
                              IsEnabled="{Binding CanPinEditorEntry}"
                              Foreground="{DynamicResource TextBrush}"
                              Margin="0,12,0,0"
                              Visibility="{Binding IsAddEditor, Converter={StaticResource D057BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{local:UiText ui.corrections.preserve.earlier.versions.and.sources.without.silent.overwrites}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Content="{local:UiText ui.cancel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelEditorButton_Click"/>
                        <Button Content="{Binding EditorSubmitText}"
                                IsEnabled="{Binding CanSubmitEditor}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="9,0,0,0"
                                Click="CommitEditorButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="D057PermanentDeleteOverlay"
              Panel.ZIndex="11"
              Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding IsPermanentDeleteOpen, Converter={StaticResource D057BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"
                    Background="{DynamicResource PanelBrush}"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{local:UiText ui.confirm.permanent.deletion}"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{local:UiText ui.this.is.not.ordinary.forgetting.permanent.deletion.cannot.be}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding PermanentDeleteSummary}"
                               TextWrapping="Wrap"
                               Margin="0,13,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="{local:UiText ui.keep}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelPermanentDeleteButton_Click"/>
                        <Button x:Name="D057ConfirmPermanentDeleteButton"
                                AutomationProperties.AutomationId="D057ConfirmPermanentDeleteButton"
                                Content="{local:UiText ui.confirm.permanent.deletion}"
                                Background="{DynamicResource DangerBrush}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="9,0,0,0"
                                Click="ConfirmPermanentDeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
