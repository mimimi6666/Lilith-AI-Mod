<UserControl x:Class="LilithControlCenter.D048ExpressionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LilithControlCenter">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="{local:UiText expression.title}" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="{local:UiText expression.help}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,10"/>
            <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="{local:UiText expression.draft}" Margin="0,0,0,6"/>
            <TextBox x:Name="DraftInput" AutomationProperties.AutomationId="ExpressionDraft" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="160" MaxHeight="380" MaxLength="32768"
                     Padding="12" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" TextChanged="DraftChanged"/>
            <TextBlock Text="{local:UiText expression.reason}" Margin="0,12,0,6"/>
            <TextBox x:Name="ReasonInput" AutomationProperties.AutomationId="ExpressionReason" MaxLength="1024" Padding="10,8"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     TextChanged="DraftChanged"/>
            <WrapPanel Margin="0,12,0,8">
                <Button x:Name="SaveButton" Content="{local:UiText expression.save}" AutomationProperties.AutomationId="ExpressionSave"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Margin="0,0,8,6"/>
                <Button x:Name="RefreshButton" Content="{local:UiText expression.refresh}" Click="Refresh_Click" Margin="0,0,8,6"/>
                <Button x:Name="DiscardButton" Content="{local:UiText expression.discard}" Click="Discard_Click" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,0,0,10"/>
            <Border x:Name="ExitConfirmation" Visibility="Collapsed" Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{local:UiText expression.exitDraft}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="ExitKeepButton" Content="{local:UiText expression.keepEditing}" Click="CancelExit_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ExitDiscardButton" Content="{local:UiText expression.discardAndExit}" Click="ConfirmExit_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander Header="{local:UiText expression.history}">
                <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="HistorySelector" DisplayMemberPath="Label" SelectedValuePath="Revision"
                              AutomationProperties.AutomationId="ExpressionHistory" SelectionChanged="History_SelectionChanged"/>
                    <TextBox x:Name="PreviewInput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="280" Padding="12" Margin="0,10,0,0"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="{local:UiText expression.restoreHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8"/>
                    <Button x:Name="RestoreButton" Content="{local:UiText expression.restore}" AutomationProperties.AutomationId="ExpressionRestore"
                            HorizontalAlignment="Left" Click="Restore_Click"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
