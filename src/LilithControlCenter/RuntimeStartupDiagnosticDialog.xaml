<Window x:Class="LilithControlCenter.RuntimeStartupDiagnosticDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LilithControlCenter"
        Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{local:UiText startup.failureTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ReasonText" Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock x:Name="StageText" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ActionText" Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock Text="{local:UiText startup.diagnostic.copyScope}" Margin="0,16,0,8"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="1" Padding="10"
                         AutomationProperties.Name="{local:UiText startup.diagnostic.details}"
                         VerticalScrollBarVisibility="Auto" MaxHeight="160"/>
                <TextBlock x:Name="CopyStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{local:UiText startup.diagnostic.copy}" Click="Copy_Click"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" Margin="0,0,12,0"/>
            <Button Content="{local:UiText startup.diagnostic.close}" Click="Close_Click" IsCancel="True" IsDefault="True"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="92"/>
        </StackPanel>
    </Grid>
</Window>
