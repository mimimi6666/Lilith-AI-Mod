+def _inherited_process_sources_present(descriptor) -> bool:
+    """Return whether a mutable slot is inherited outside Hermes' .env.
+
+    Hermes can durably suppress such a source for its own resolver, but it
+    cannot delete the parent process, service, shell profile, or launcher
+    setting that will re-inject it on a future start.  Receipts must therefore
+    not describe that external source itself as cleared.
+    """
+    from hermes_cli.config import load_env
+
+    disk_env = load_env()
+    owned_slots, _borrowed_slots = _descriptor_slot_ownership(descriptor)
+    if any(
+        bool(os.environ.get(env_var))
+        and disk_env.get(env_var) != os.environ.get(env_var)
+        for env_var in owned_slots
+    ):
+        return True
+
+    # A provider-scoped key_env/api_key_env can name an arbitrary launcher or
+    # shared .env variable. The transaction removes the provider's reference,
+    # not that external/shared source itself, so the receipt must not claim all
+    # legacy sources were cleared while the referenced credential still exists.
+    mutable_slots = set(descriptor.api_key_env_vars)
+    return any(
+        env_var not in mutable_slots
+        and bool(disk_env.get(env_var) or os.environ.get(env_var))
+        for env_var in _provider_inline_config_env_vars(descriptor.slug)
+    )
+
