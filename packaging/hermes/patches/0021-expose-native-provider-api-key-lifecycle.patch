+def canonical_api_key_provider_slug(provider: str) -> str:
+    """Return the canonical D054 identity for one runtime provider spelling.
+
+    Alias normalization is shared with Hermes' model/runtime resolver rather
+    than duplicated by each credential-bearing cache. Unknown, custom,
+    virtual, and account-backed providers return an empty identity. Import or
+    catalog failures deliberately propagate so a possibly managed route cannot
+    reuse a cached key with an unknowable lifecycle generation.
+    """
+    raw = str(provider or "").strip().lower()
+    if not raw or raw.startswith("custom:"):
+        return ""
+    from hermes_cli.models import normalize_provider
+
+    normalized = normalize_provider(raw)
+    descriptor = provider_catalog_by_slug().get(normalized)
+    if descriptor is None or descriptor.auth_type != "api_key":
+        return ""
+    return descriptor.slug
