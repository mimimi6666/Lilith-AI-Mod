+    # local rows for the provider. The global store is read-only from this
+    # lifecycle: report its API keys as legacy forever, and use a profile-local
+    # tombstone to stop them from becoming active without hiding OAuth/device
+    # rows from the same provider slice.
+    global_api_keys_suppressed = _provider_source_is_suppressed(
+        slug,
+        GLOBAL_POOL_API_KEY_SUPPRESSION_SOURCE,
+        strict=strict,
+    )
+    for provider_key in provider_keys:
+        local_entries = pool.get(provider_key)
+        if isinstance(local_entries, list) and local_entries:
+            continue
+        global_entries = global_pool.get(provider_key)
+        if not isinstance(global_entries, list):
