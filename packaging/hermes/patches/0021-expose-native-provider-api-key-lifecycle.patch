+@pytest.mark.parametrize(
+    ("action", "expected_configured"),
+    (("remove", False), ("replace", True)),
+)
+def test_mutation_converges_while_external_legacy_source_still_exists(
+    credential_home,
+    monkeypatch,
+    action,
+    expected_configured,
+):
+    """A truthful legacy flag must not make a successful mutation roll back.
+
+    A launcher may re-inject its read-only environment value while Hermes is
+    completing the request.  Removal remains effective through suppression;
+    replacement remains effective because the persisted canonical value wins.
+    In both cases the receipt must admit that the external source was not
+    deleted instead of treating its continued existence as a convergence
+    failure.
+    """
+    inherited = _fake_secret("racing-inherited-", "q")
+    replacement = _fake_secret("racing-replacement-", "r")
+    monkeypatch.setenv("GOOGLE_API_KEY", inherited)
+
+    original_clear = lifecycle._clear_provider_api_key_sources
+
+    def _clear_then_external_reinjects(descriptor, **kwargs):
+        result = original_clear(descriptor, **kwargs)
+        monkeypatch.setenv("GOOGLE_API_KEY", inherited)
+        return result
+
+    monkeypatch.setattr(
+        lifecycle,
+        "_clear_provider_api_key_sources",
+        _clear_then_external_reinjects,
+    )
+    if action == "remove":
+        receipt = lifecycle.remove_provider_api_key("gemini", "external-race-remove")
+    else:
+        receipt = lifecycle.replace_provider_api_key(
+            "gemini",
+            replacement,
+            "external-race-replace",
+        )
+
+    assert receipt["configured"] is expected_configured
+    assert receipt["legacy_sources_cleared"] is False
+    configured, legacy = lifecycle._provider_source_state(_gemini_descriptor())
+    assert configured is expected_configured
+    assert legacy is True
+
+    from hermes_cli.auth import resolve_api_key_provider_credentials
+
+    resolved = resolve_api_key_provider_credentials("gemini")["api_key"]
+    assert resolved == (replacement if action == "replace" else "")
+    serialized = json.dumps(receipt)
+    assert inherited not in serialized
+    assert replacement not in serialized
+
