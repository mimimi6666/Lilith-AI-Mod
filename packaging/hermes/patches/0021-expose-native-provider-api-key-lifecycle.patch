+def test_stale_auto_main_runtime_remove_fails_before_client_creation(monkeypatch):
+    stale_runtime = {
+        "provider": "deepseek",
+        "model": "deepseek-model",
+        "base_url": "https://provider.example.invalid/v1",
+        "api_key": "old-main-key",
