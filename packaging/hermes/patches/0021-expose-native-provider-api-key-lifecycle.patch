+def _provider_source_state(
+    descriptor,
+    *,
+    strict: bool = False,
+) -> tuple[bool, bool]:
+    """Return (configured, legacy_sources_present) for one descriptor."""
+    from hermes_cli.config import load_env
+
+    env_vars = tuple(descriptor.api_key_env_vars)
+    if not env_vars:
+        return _pool_source_state(descriptor.slug, env_vars, strict=strict)
+    owned_slots, borrowed_slots = _descriptor_slot_ownership(descriptor)
+    borrowed = set(borrowed_slots)
+    disk_env = load_env()
+    canonical = env_vars[0]
+    canonical_source = f"env:{canonical}"
+    canonical_suppressed = _provider_source_is_suppressed(
+        descriptor.slug,
+        canonical_source,
+        strict=strict,
+    )
+    configured = bool(disk_env.get(canonical)) and not canonical_suppressed
+    legacy = bool(disk_env.get(canonical)) and canonical_suppressed
+    for alias in env_vars[1:]:
+        if disk_env.get(alias):
+            if alias not in borrowed:
+                legacy = True
+            if not _provider_source_is_suppressed(
+                descriptor.slug,
+                f"env:{alias}",
+                strict=strict,
+            ):
+                configured = True
+
+    # An inherited process value is usable by Hermes but is outside the
+    # canonical .env store.  Mark it legacy unless it exactly mirrors the
+    # corresponding persisted value written by this lifecycle.
+    for env_var in env_vars:
+        process_value = os.environ.get(env_var)
+        if process_value:
+            suppressed = _provider_source_is_suppressed(
+                descriptor.slug,
+                f"env:{env_var}",
+                strict=strict,
+            )
+            if not suppressed:
+                configured = True
+            if env_var in owned_slots and (
+                disk_env.get(env_var) != process_value or suppressed
+            ):
+                legacy = True
+
+    pool_configured, pool_legacy = _pool_source_state(
+        descriptor.slug,
+        env_vars,
+        strict=strict,
+    )
+    inline_configured, inline_legacy = _provider_inline_config_source_state(
+        descriptor.slug,
+        strict=strict,
+    )
+    return (
+        configured or pool_configured or inline_configured,
+        legacy or pool_legacy or inline_legacy,
+    )
