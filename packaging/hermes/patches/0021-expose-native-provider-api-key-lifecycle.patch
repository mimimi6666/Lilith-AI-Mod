+def provider_api_key_status() -> List[Dict[str, Any]]:
+    """Return redaction-safe status for every catalog API-key provider."""
+    from hermes_cli.provider_catalog import provider_catalog
+
+    providers: List[Dict[str, Any]] = []
+    for descriptor in provider_catalog():
+        if descriptor.auth_type != "api_key" or not descriptor.api_key_env_vars:
+            continue
+        configured, legacy = _provider_source_state(descriptor, strict=True)
+        providers.append(
+            {
+                "slug": descriptor.slug,
+                "name": descriptor.label,
+                "configured": configured,
+                "legacy_sources_present": legacy,
+            }
+        )
+    return providers
