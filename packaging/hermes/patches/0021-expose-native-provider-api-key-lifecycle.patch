+                )
+            if not pool_entry_is_api_key(provider_key, entry):
+                continue
+            legacy = True
+            if not global_api_keys_suppressed and bool(
+                entry.get("access_token") if isinstance(entry, dict) else None
+            ):
+                configured = True
+    return configured, legacy
