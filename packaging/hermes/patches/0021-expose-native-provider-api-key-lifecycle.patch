+"""JSON-RPC contract tests for native provider API-key management."""
+
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+from tui_gateway import server
+
+
+def test_model_credential_status_has_one_strict_result_envelope(monkeypatch):
+    providers = [
+        {
+            "slug": "example",
+            "name": "Example",
+            "configured": False,
+            "legacy_sources_present": False,
+        }
+    ]
+    monkeypatch.setattr(
+        "hermes_cli.credential_lifecycle.provider_api_key_status",
+        lambda: providers,
+    )
+
+    response = server._methods["model.credential_status"]("status-1", {})
+
+    assert response == {
+        "jsonrpc": "2.0",
+        "id": "status-1",
+        "result": {"providers": providers},
+    }
+
+
+def test_model_credential_status_reports_unavailable_without_false_catalog(
+    monkeypatch,
+):
+    marker = "status-backend-detail-must-not-leak"
+    monkeypatch.setattr(
+        "hermes_cli.credential_lifecycle.provider_api_key_status",
+        Mock(side_effect=RuntimeError(marker)),
+    )
+
+    response = server._methods["model.credential_status"]("status-error", {})
+
+    assert response["error"] == {
+        "code": 5036,
+        "message": "credential status is unavailable",
+    }
+    assert "result" not in response
+    assert marker not in str(response)
+
+
+def test_model_replace_key_returns_only_redaction_safe_receipt(monkeypatch):
+    fake_secret = "test-" + "x" * 24
+    receipt = {
+        "slug": "example",
+        "name": "Example",
+        "configured": True,
+        "changed": True,
+        "legacy_sources_cleared": True,
+    }
+    replace = Mock(return_value=receipt)
+    monkeypatch.setattr(
+        "hermes_cli.credential_lifecycle.replace_provider_api_key",
+        replace,
+    )
+    monkeypatch.setattr("hermes_cli.config.is_managed", lambda: False)
+
+    response = server._methods["model.replace_key"](
+        "replace-1",
+        {
+            "slug": "example",
+            "api_key": fake_secret,
+            "operation_id": "operation-1",
+        },
+    )
+
+    assert response == {
+        "jsonrpc": "2.0",
+        "id": "replace-1",
+        "result": receipt,
+    }
+    assert fake_secret not in str(response)
+    replace.assert_called_once_with("example", fake_secret, "operation-1")
+
+
+def test_model_remove_key_returns_only_redaction_safe_receipt(monkeypatch):
+    receipt = {
+        "slug": "example",
+        "name": "Example",
+        "configured": False,
+        "changed": True,
+        "legacy_sources_cleared": False,
+    }
+    remove = Mock(return_value=receipt)
+    monkeypatch.setattr(
+        "hermes_cli.credential_lifecycle.remove_provider_api_key",
+        remove,
+    )
+    monkeypatch.setattr("hermes_cli.config.is_managed", lambda: False)
+
+    response = server._methods["model.remove_key"](
+        "remove-1",
+        {"slug": "example", "operation_id": "operation-2"},
+    )
+
+    assert response == {
+        "jsonrpc": "2.0",
+        "id": "remove-1",
+        "result": receipt,
+    }
+    remove.assert_called_once_with("example", "operation-2")
+
+
+def test_rpc_masks_unexpected_backend_exception_details(monkeypatch):
+    fake_secret = "sensitive-" + "z" * 24
+    monkeypatch.setattr(
+        "hermes_cli.credential_lifecycle.replace_provider_api_key",
+        Mock(side_effect=RuntimeError(fake_secret)),
+    )
+    monkeypatch.setattr("hermes_cli.config.is_managed", lambda: False)
+
+    response = server._methods["model.replace_key"](
+        "replace-error",
+        {
+            "slug": "example",
+            "api_key": fake_secret,
+            "operation_id": "operation-error",
+        },
+    )
+
+    assert response["error"]["message"] == "credential replacement failed"
+    assert fake_secret not in str(response)
