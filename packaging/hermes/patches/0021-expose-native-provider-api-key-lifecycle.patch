+    from hermes_cli.auth import (
+        is_source_suppressed,
+        suppress_credential_source,
+        unsuppress_credential_source,
+    )
+
+    env_vars = tuple(descriptor.api_key_env_vars)
+    if not env_vars:
+        raise ValueError("provider has no mutable API-key credential slot")
