+++ b/tests/hermes_cli/test_native_api_key_control.py
@@ -0,0 +1,2149 @@
+"""Focused coverage for the redaction-safe native API-key control surface."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+import yaml
+
+from hermes_cli import credential_lifecycle as lifecycle
+
+
+def _fake_secret(prefix: str, fill: str) -> str:
+    return prefix + fill * 24
+
+
+@pytest.fixture()
+def credential_home(tmp_path, monkeypatch):
+    home = tmp_path / "credentials"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for env_var in (
+        "GOOGLE_API_KEY",
+        "GEMINI_API_KEY",
+        "DASHSCOPE_API_KEY",
+        "ALIBABA_CODING_PLAN_API_KEY",
+        "MINIMAX_API_KEY",
+        "ANTHROPIC_API_KEY",
+        "AZURE_ANTHROPIC_KEY",
+        "ANTHROPIC_TOKEN",
+        "CLAUDE_CODE_OAUTH_TOKEN",
+        "COPILOT_GITHUB_TOKEN",
+        "GH_TOKEN",
+        "GITHUB_TOKEN",
+        "AZURE_FOUNDRY_API_KEY",
+        "AZURE_FOUNDRY_BASE_URL",
+        "DEEPINFRA_API_KEY",
+        "LM_API_KEY",
+        "OPENAI_API_KEY",
+        "OPENROUTER_API_KEY",
+        "NOVITA_API_KEY",
+        "AI_GATEWAY_API_KEY",
+        "OLLAMA_API_KEY",
+        "XAI_API_KEY",
+    ):
+        monkeypatch.delenv(env_var, raising=False)
+    from hermes_cli.config import invalidate_env_cache
+
+    invalidate_env_cache()
+    with lifecycle._operation_receipts_lock:
+        lifecycle._operation_receipts.clear()
+    return home
+
+
+def _write_env(home, **values):
+    home.joinpath(".env").write_text(
+        "".join(f"{key}={value}\n" for key, value in values.items()),
+        encoding="utf-8",
+    )
+    for key, value in values.items():
+        os.environ[key] = value
+    from hermes_cli.config import invalidate_env_cache
+
+    invalidate_env_cache()
+
+
+def _write_auth(home, payload):
+    home.joinpath("auth.json").write_text(json.dumps(payload), encoding="utf-8")
+
+
+def _read_auth(home):
+    return json.loads(home.joinpath("auth.json").read_text(encoding="utf-8"))
+
+
+def _gemini_descriptor():
+    from hermes_cli.provider_catalog import provider_catalog_by_slug
+
+    return provider_catalog_by_slug()["gemini"]
+
+
+def _remove_inherited_deepseek_key(credential_home, monkeypatch):
+    old_key = _fake_secret("old-ds-", "z")
+    _write_env(credential_home, DEEPSEEK_API_KEY=old_key)
+    lifecycle.remove_provider_api_key("deepseek", "remove-inherited-deepseek")
+    # Model the launcher re-injecting its immutable inherited value into a
+    # fresh Hermes process after the managed .env value was removed.
+    monkeypatch.setenv("DEEPSEEK_API_KEY", old_key)
+    from hermes_cli.config import invalidate_env_cache
+
+    invalidate_env_cache()
+    return old_key
+
+
+def test_status_is_catalog_complete_and_strictly_redaction_safe(credential_home):
+    canonical_secret = _fake_secret("gc-", "a")
+    alias_secret = _fake_secret("ga-", "b")
+    manual_secret = _fake_secret("gm-", "c")
+    _write_env(
+        credential_home,
+        GOOGLE_API_KEY=canonical_secret,
+        GEMINI_API_KEY=alias_secret,
+    )
+    _write_auth(
+        credential_home,
+        {
+            "credential_pool": {
+                "gemini": [
+                    {
+                        "id": "manual-key",
+                        "label": "legacy",
+                        "auth_type": "api_key",
+                        "priority": 0,
+                        "source": "manual:workbench",
+                        "access_token": manual_secret,
+                    }
+                ]
+            }
+        },
+    )
+
+    providers = lifecycle.provider_api_key_status()
+    descriptor = _gemini_descriptor()
+    gemini = next(row for row in providers if row["slug"] == "gemini")
+
+    assert gemini == {
+        "slug": "gemini",
+        "name": descriptor.label,
+        "configured": True,
+        "legacy_sources_present": True,
+    }
+    assert all(set(row) == {
+        "slug", "name", "configured", "legacy_sources_present"
+    } for row in providers)
+    serialized = json.dumps({"providers": providers})
+    for forbidden in (
+        canonical_secret,
+        alias_secret,
+        manual_secret,
+        "GOOGLE_API_KEY",
+        "GEMINI_API_KEY",
+        "secret_fingerprint",
+    ):
+        assert forbidden not in serialized
+
+
+def test_status_treats_pool_only_env_metadata_as_stale_legacy(credential_home):
+    _write_auth(
+        credential_home,
+        {
+            "credential_pool": {
+                "gemini": [
+                    {
+                        "id": "stale-env",
+                        "label": "env",
+                        "auth_type": "api_key",
+                        "priority": 0,
+                        "source": "env:GOOGLE_API_KEY",
+                        "secret_fingerprint": "sha256:" + "9" * 16,
+                        "last_status": "exhausted",
+                        "last_status_at": time.time(),
+                        "last_error_code": 402,
+                    }
+                ]
+            }
+        },
+    )
+
+    status = next(
+        row for row in lifecycle.provider_api_key_status() if row["slug"] == "gemini"
+    )
+
+    assert status["configured"] is False
+    assert status["legacy_sources_present"] is True
+
+
+def test_replace_collapses_aliases_and_manual_keys_but_preserves_oauth(
+    credential_home,
+):
+    old_canonical = _fake_secret("old-c-", "d")
+    old_alias = _fake_secret("old-a-", "e")
+    old_manual = _fake_secret("old-m-", "f")
+    replacement = _fake_secret("new-c-", "g")
+    oauth_access = _fake_secret("oauth-a-", "h")
+    oauth_refresh = _fake_secret("oauth-r-", "i")
+    _write_env(
+        credential_home,
+        GOOGLE_API_KEY=old_canonical,
+        GEMINI_API_KEY=old_alias,
+    )
+    oauth_state = {
+        "tokens": {
+            "access_token": oauth_access,
+            "refresh_token": oauth_refresh,
+        }
+    }
+    _write_auth(
+        credential_home,
+        {
+            "providers": {"gemini": oauth_state},
+            "credential_pool": {
+                "gemini": [
+                    {
+                        "id": "env-canonical",
+                        "label": "canonical",
+                        "auth_type": "api_key",
+                        "priority": 0,
+                        "source": "env:GOOGLE_API_KEY",
+                        "secret_fingerprint": "sha256:" + "1" * 16,
+                        "last_status": "exhausted",
+                        "last_status_at": time.time(),
+                        "last_error_code": 402,
+                    },
+                    {
+                        "id": "env-alias",
+                        "label": "alias",
+                        "auth_type": "api_key",
+                        "priority": 0,
+                        "source": "env:GEMINI_API_KEY",
+                        "secret_fingerprint": "sha256:" + "2" * 16,
+                        "last_status": "exhausted",
+                        "last_status_at": time.time(),
+                        "last_error_code": 429,
+                    },
+                    {
+                        "id": "manual-api-key",
+                        "label": "manual",
+                        "auth_type": "api_key",
+                        "priority": 1,
+                        "source": "manual:workbench",
+                        "access_token": old_manual,
+                        "last_status": "exhausted",
+                        "last_status_at": time.time(),
+                        "last_error_code": 401,
+                    },
+                    {
+                        "id": "manual-oauth",
+                        "label": "oauth",
+                        "auth_type": "oauth",
+                        "priority": 2,
+                        "source": "manual:oauth",
+                        "access_token": oauth_access,
+                        "refresh_token": oauth_refresh,
+                    },
+                    {
+                        "id": "device-oauth",
+                        "label": "device",
+                        "auth_type": "oauth",
+                        "priority": 3,
+                        "source": "device_code",
+                        "access_token": oauth_access,
+                        "refresh_token": oauth_refresh,
+                    },
+                ]
+            },
+        },
+    )
+    credential_home.joinpath("provider_models_cache.json").write_text(
+        json.dumps({"gemini": {"models": ["example"], "at": 1, "fp": "old"}}),
+        encoding="utf-8",
+    )
+
+    receipt = lifecycle.replace_provider_api_key(
+        "gemini", replacement, "replace-operation"
+    )
+    descriptor = _gemini_descriptor()
+    assert receipt == {
+        "slug": "gemini",
+        "name": descriptor.label,
+        "configured": True,
+        "changed": True,
+        "legacy_sources_cleared": True,
+    }
+    assert replacement not in json.dumps(receipt)
+
+    from hermes_cli.config import load_env
+
+    assert load_env() == {"GOOGLE_API_KEY": replacement}
+    assert os.environ["GOOGLE_API_KEY"] == replacement
+    assert "GEMINI_API_KEY" not in os.environ
+
+    auth = _read_auth(credential_home)
+    assert auth["providers"]["gemini"] == oauth_state
+    remaining = auth["credential_pool"]["gemini"]
+    assert {entry["id"] for entry in remaining} == {"manual-oauth", "device-oauth"}
+    assert all(entry["auth_type"] == "oauth" for entry in remaining)
+    cache = json.loads(
+        credential_home.joinpath("provider_models_cache.json").read_text(encoding="utf-8")
+    )
+    assert "gemini" not in cache
+
+    status = next(
+        row for row in lifecycle.provider_api_key_status() if row["slug"] == "gemini"
+    )
+    assert status["configured"] is True
+    assert status["legacy_sources_present"] is False
+
+    # A transport retry with the same operation id returns the original
+    # receipt and cannot overwrite the first submitted credential.
+    ignored_retry_secret = _fake_secret("retry-", "j")
+    retry = lifecycle.replace_provider_api_key(
+        "gemini", ignored_retry_secret, "replace-operation"
+    )
+    assert retry == receipt
+    assert load_env()["GOOGLE_API_KEY"] == replacement
+
+
+def test_remove_is_idempotent_and_preserves_oauth_state(credential_home):
+    key = _fake_secret("remove-", "k")
+    oauth_access = _fake_secret("oauth-a-", "l")
+    _write_env(credential_home, GOOGLE_API_KEY=key)
+    oauth_state = {"tokens": {"access_token": oauth_access}}
+    _write_auth(
+        credential_home,
+        {
+            "providers": {"gemini": oauth_state},
+            "credential_pool": {
+                "gemini": [
+                    {
+                        "id": "oauth",
+                        "label": "oauth",
+                        "auth_type": "oauth",
+                        "priority": 0,
+                        "source": "device_code",
