+    credential_home.joinpath("provider_models_cache.json").write_text(
+        json.dumps({"gemini": {"models": ["example"], "at": 1}}),
+        encoding="utf-8",
+    )
+    before = _credential_store_bytes(credential_home)
+    process_before = {
+        key: os.environ.get(key)
+        for key in ("GOOGLE_API_KEY", "GEMINI_API_KEY")
+    }
+    original_clear = lifecycle._clear_provider_models_cache_strict
+
+    def _fail_after_persist(_providers):
+        raise OSError("synthetic cache write failure")
