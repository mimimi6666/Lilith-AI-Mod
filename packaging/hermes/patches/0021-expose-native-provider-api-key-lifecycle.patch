+@pytest.mark.parametrize("action", ["replace", "remove"])
+def test_missing_main_runtime_baseline_never_adopts_delayed_k1_after_mutation(
+    tmp_path,
+    monkeypatch,
+    action,
+):
+    old_key = "deepseek-delayed-main-old-key"
+    new_key = "deepseek-delayed-main-new-key"
+    _configure_managed_deepseek_home(tmp_path, monkeypatch, old_key)
+    stale_runtime = {
+        "provider": "deep-seek",
+        "model": "deepseek-model",
+        "base_url": "https://captured-route.example.invalid/v1",
+        "api_key": old_key,
+        "api_mode": "chat_completions",
+        # Deliberately no api_key_mutation_generation: this is the legacy
+        # delayed snapshot that previously stamped current while retaining K1.
+    }
+    from hermes_cli import credential_lifecycle as lifecycle
+
+    if action == "replace":
+        lifecycle.replace_provider_api_key(
+            "deepseek", new_key, "delayed-main-replace"
+        )
+    else:
+        lifecycle.remove_provider_api_key("deepseek", "delayed-main-remove")
+        monkeypatch.setenv("DEEPSEEK_API_KEY", old_key)
+        from hermes_cli.config import invalidate_env_cache
+
+        invalidate_env_cache()
+
+    def _runtime(**_kwargs):
+        key = _actual_deepseek_key()
+        return {
+            "provider": "deepseek",
+            "model": "deepseek-model",
+            "base_url": "https://catalog-route.example.invalid/v1",
+            "api_key": key,
+            "api_mode": "chat_completions",
+        }
+
+    monkeypatch.setattr(
+        "hermes_cli.runtime_provider.resolve_runtime_provider",
+        _runtime,
+    )
+    observed = []
+
+    def _resolve(_provider, model, *_args, **kwargs):
+        runtime = kwargs["main_runtime"]
+        observed.append(runtime["api_key"])
+        return _client(runtime["api_key"]), model
+
+    resolver = MagicMock(side_effect=_resolve)
+    monkeypatch.setattr(aux, "resolve_provider_client", resolver)
+
+    if action == "replace":
+        client, _ = aux._get_cached_client(
+            "auto",
+            "deepseek-model",
+            main_runtime=stale_runtime,
+            task="compression",
+        )
+        assert client.api_key == new_key
+        assert observed == [new_key]
+    else:
+        with pytest.raises(RuntimeError, match="unavailable after mutation"):
+            aux._get_cached_client(
+                "auto",
+                "deepseek-model",
+                main_runtime=stale_runtime,
+                task="compression",
+            )
+        resolver.assert_not_called()
+        assert observed == []
