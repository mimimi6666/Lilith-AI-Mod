+def _slot_api_key_mutation_generation(provider: str) -> int:
+    """Return the provider's durable API-key lifecycle generation.
+
+    The profile/session fingerprint above captures the ambient runtime and
+    secret scope, but a Workbench replace/remove can mutate Hermes' native
+    credential stores without changing either context.  Folding this
+    redaction-safe counter into the slot identity makes that mutation an
+    immediate cache miss instead of leaving MoA on the old wire credential
+    until the TTL expires.
+    """
+
+    from hermes_cli.auth import get_api_key_mutation_generation
+    from hermes_cli.provider_catalog import canonical_api_key_provider_slug
+
+    provider_id = canonical_api_key_provider_slug(provider)
+    if not provider_id:
+        return 0
+    generation = get_api_key_mutation_generation(provider_id)
+    if isinstance(generation, bool):
+        raise RuntimeError("invalid API-key mutation generation")
+    try:
+        normalized = int(generation)
+    except (TypeError, ValueError) as exc:
+        raise RuntimeError("invalid API-key mutation generation") from exc
+    if normalized < 0:
+        raise RuntimeError("invalid API-key mutation generation")
+    return normalized
+
