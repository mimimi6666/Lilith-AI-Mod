+    from hermes_cli.auth import _auth_store_lock, _load_auth_store, _save_auth_store
+
+    removed_values: List[str] = []
+    removed = 0
+    provider_keys = _provider_pool_keys(slug)
+    with _auth_store_lock():
+        auth_store = _load_auth_store()
+        pool = auth_store.get("credential_pool")
+        if not isinstance(pool, dict):
+            return 0, []
+        changed = False
+        for provider_key in provider_keys:
+            entries = pool.get(provider_key)
+            if not isinstance(entries, list):
+                continue
+            kept = []
+            for entry in entries:
+                if _is_manual_api_key_entry(slug, entry):
+                    changed = True
+                    removed += 1
+                    value = entry.get("access_token") if isinstance(entry, dict) else None
+                    if isinstance(value, str) and value:
+                        removed_values.append(value)
+                    continue
+                kept.append(entry)
+            if kept:
+                pool[provider_key] = kept
+            else:
+                pool.pop(provider_key, None)
+        if changed:
+            _save_auth_store(auth_store)
+            persisted_pool = _load_auth_store().get("credential_pool")
+            if not isinstance(persisted_pool, dict):
+                persisted_pool = {}
+            for provider_key in provider_keys:
+                entries = persisted_pool.get(provider_key)
+                if not isinstance(entries, list):
+                    continue
+                if any(
+                    _is_manual_api_key_entry(slug, entry)
+                    for entry in entries
+                ):
+                    raise RuntimeError(
+                        "manual credential-pool cleanup did not persist"
+                    )
+    return removed, removed_values
