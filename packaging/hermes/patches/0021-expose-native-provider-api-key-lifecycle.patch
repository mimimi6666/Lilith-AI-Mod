+def _pool_source_state(
+    slug: str,
+    env_vars: tuple[str, ...],
+    *,
+    strict: bool = False,
+) -> tuple[bool, bool]:
+    """Return (configured, legacy) without exposing pool credential material."""
+    try:
+        from hermes_cli.auth import (
+            GLOBAL_POOL_API_KEY_SUPPRESSION_SOURCE,
+            _load_auth_store,
+            _load_global_auth_store,
