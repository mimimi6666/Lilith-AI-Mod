+    # A failed operation id is not cached as success; retrying the same id can
+    # complete after the persistence fault is gone.
+    monkeypatch.setattr(
+        lifecycle,
+        "_clear_provider_models_cache_strict",
+        original_clear,
+    )
+    receipt = lifecycle.replace_provider_api_key(
+        "gemini",
+        replacement,
+        "rollback-replace",
+    )
+    assert receipt["configured"] is True
+    assert replacement not in json.dumps(receipt)
