+def _configure_managed_deepseek_home(tmp_path, monkeypatch, key: str):
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    home.joinpath(".env").write_text(
+        f"DEEPSEEK_API_KEY={key}\n",
+        encoding="utf-8",
+    )
+    home.joinpath("auth.json").write_text(
+        json.dumps({"version": 1, "providers": {}}),
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("DEEPSEEK_API_KEY", key)
+    from hermes_cli.config import invalidate_env_cache
+
+    invalidate_env_cache()
+    return home
+
+
+def _actual_deepseek_key():
+    from hermes_cli.auth import get_provider_effective_credential_env
+
+    return get_provider_effective_credential_env(
+        "deepseek", "DEEPSEEK_API_KEY"
+    ).strip()
+
+
+def test_sync_cache_misses_immediately_after_provider_generation_change(monkeypatch):
+    state = {"generation": 0, "key": "old-key"}
+    builds = []
+
+    monkeypatch.setattr(
+        aux,
+        "_managed_api_key_mutation_generation",
+        lambda _provider: state["generation"],
+    )
+
+    def _resolve(_provider, model, *_args, **_kwargs):
+        built = _client(state["key"])
+        builds.append(built)
+        return built, model
+
+    monkeypatch.setattr(aux, "resolve_provider_client", _resolve)
+
+    first, _ = aux._get_cached_client("deepseek", "deepseek-model")
+    cached, _ = aux._get_cached_client("deepseek", "deepseek-model")
+    assert cached is first
+
+    state.update(generation=1, key="new-key")
+    rotated, _ = aux._get_cached_client("deepseek", "deepseek-model")
+    assert rotated is not first
+    assert rotated.api_key == "new-key"
+    assert len(builds) == 2
+
+
+@pytest.mark.asyncio
+async def test_async_cache_misses_immediately_after_provider_generation_change(
+    monkeypatch,
+):
+    state = {"generation": 0, "key": "old-async-key"}
+    builds = []
+
+    monkeypatch.setattr(
+        aux,
+        "_managed_api_key_mutation_generation",
+        lambda _provider: state["generation"],
+    )
+
+    def _resolve(_provider, model, *_args, **_kwargs):
+        built = _client(state["key"])
+        builds.append(built)
+        return built, model
+
+    monkeypatch.setattr(aux, "resolve_provider_client", _resolve)
+
+    first, _ = aux._get_cached_client(
+        "deepseek", "deepseek-model", async_mode=True
+    )
+    cached, _ = aux._get_cached_client(
+        "deepseek", "deepseek-model", async_mode=True
+    )
+    assert cached is first
+
+    state.update(generation=1, key="new-async-key")
+    rotated, _ = aux._get_cached_client(
+        "deepseek", "deepseek-model", async_mode=True
+    )
+    assert rotated is not first
+    assert rotated.api_key == "new-async-key"
+    assert len(builds) == 2
+
