+def test_stale_auto_main_runtime_rebinds_key_and_preserves_endpoint(
+    monkeypatch,
+):
+    explicit_base = "https://custom-route.example.invalid/v1"
+    stale_runtime = {
+        "provider": "xai",
+        "model": "xai-model",
+        "base_url": explicit_base,
+        "api_key": "old-main-key",
+        "api_mode": "codex_responses",
+        "api_key_mutation_generation": 0,
+    }
+    monkeypatch.setattr(
+        aux,
+        "_managed_api_key_mutation_generation",
+        lambda _provider: 1,
+    )
+    monkeypatch.setattr(
+        "hermes_cli.runtime_provider.resolve_runtime_provider",
+        lambda **_kwargs: {
+            "provider": "xai",
+            "base_url": "https://catalog-route.example.invalid/v1",
+            "api_key": "new-main-key",
+            "api_mode": "codex_responses",
+        },
+    )
+    observed = {}
+
+    def _resolve(_provider, model, *_args, **kwargs):
+        observed.update(kwargs["main_runtime"])
+        return _client(observed["api_key"]), model
+
+    monkeypatch.setattr(aux, "resolve_provider_client", _resolve)
+
+    client, _ = aux._get_cached_client(
+        "auto",
+        "xai-model",
+        main_runtime=stale_runtime,
+        task="compression",
+    )
+    assert client.api_key == "new-main-key"
+    assert observed["base_url"] == explicit_base
+    assert observed["api_key_mutation_generation"] == 1
