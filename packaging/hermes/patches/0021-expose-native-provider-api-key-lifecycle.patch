+                raise RuntimeError("auth store credential pool entries are invalid")
+            continue
+        for entry in entries:
+            if not isinstance(entry, dict):
+                if strict:
+                    raise RuntimeError("auth store credential pool entry is invalid")
+                continue
+            source = str(entry.get("source") or "")
+            if source in env_sources:
