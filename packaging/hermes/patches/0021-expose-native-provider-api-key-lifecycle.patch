+def test_inherited_env_is_durably_suppressed_but_never_reported_as_deleted(
+    credential_home,
+    monkeypatch,
+):
+    inherited = _fake_secret("inherited-", "o")
+    replacement = _fake_secret("replacement-", "p")
+    monkeypatch.setenv("GOOGLE_API_KEY", inherited)
+    from hermes_cli.config import invalidate_env_cache, load_env
+
+    invalidate_env_cache()
+    before = next(
+        row for row in lifecycle.provider_api_key_status() if row["slug"] == "gemini"
+    )
+    assert before["configured"] is True
+    assert before["legacy_sources_present"] is True
+
+    removed = lifecycle.remove_provider_api_key("gemini", "inherited-remove")
+    assert removed == {
+        "slug": "gemini",
+        "name": _gemini_descriptor().label,
+        "configured": False,
+        "changed": True,
+        "legacy_sources_cleared": False,
+    }
+    assert "GOOGLE_API_KEY" not in os.environ
+    assert "GOOGLE_API_KEY" not in load_env()
+
+    # Simulate the same parent/service injecting the immutable value on the
+    # next Hermes start. Native suppression prevents it from becoming active,
+    # while status still reports the external legacy source truthfully.
+    monkeypatch.setenv("GOOGLE_API_KEY", inherited)
+    invalidate_env_cache()
+    restarted = next(
+        row for row in lifecycle.provider_api_key_status() if row["slug"] == "gemini"
+    )
+    assert restarted["configured"] is False
+    assert restarted["legacy_sources_present"] is True
+    from hermes_cli.auth import resolve_api_key_provider_credentials
+
+    resolved = resolve_api_key_provider_credentials("gemini")
+    assert resolved["api_key"] == ""
+
+    replaced = lifecycle.replace_provider_api_key(
+        "gemini",
+        replacement,
+        "inherited-replace",
+    )
+    assert replaced["configured"] is True
+    assert replaced["legacy_sources_cleared"] is False
+    assert load_env()["GOOGLE_API_KEY"] == replacement
+    # The persisted Hermes key wins after another restart, but the external
+    # parent value remains visible as an uncleared legacy source.
+    monkeypatch.setenv("GOOGLE_API_KEY", inherited)
+    invalidate_env_cache()
+    assert resolve_api_key_provider_credentials("gemini")["api_key"] == replacement
+    restarted_after_replace = next(
+        row for row in lifecycle.provider_api_key_status() if row["slug"] == "gemini"
+    )
+    assert restarted_after_replace["configured"] is True
+    assert restarted_after_replace["legacy_sources_present"] is True
+    for receipt in (removed, replaced):
+        assert inherited not in json.dumps(receipt)
+        assert replacement not in json.dumps(receipt)
