+def _selectable_root_default(
+    rows: list[dict],
+    ctx: ConfigContext,
+) -> tuple[str, str]:
+    """Return a catalog-backed provider/model default or an empty pair.
+
+    A merged/default config may carry a model after its provider was removed
+    (including a fresh profile whose host supplied a default model only).
+    Publishing that orphan as the root selection makes strict consumers reject
+    the otherwise valid catalog.  The root default is therefore a claim about
+    the payload we actually emit: both values must be present, the provider row
+    must be selectable, and the exact model must belong to that row.
+
+    Provider matching is case-insensitive only to recover the canonical slug
+    already present in the catalog.  Model IDs remain exact because callers
+    select and attest the emitted IDs verbatim; no vendor/model inference is
+    performed here.
+    """
+    provider = str(ctx.current_provider or "").strip()
+    model = str(ctx.current_model or "").strip()
+    if not provider or not model:
+        return "", ""
+
+    provider_key = provider.casefold()
+    for row in rows:
+        slug = str(row.get("slug") or "").strip()
+        if not slug or slug.casefold() != provider_key:
+            continue
+        if row.get("authenticated") is False:
+            return "", ""
+        models = row.get("models")
+        if not isinstance(models, (list, tuple)):
+            return "", ""
+        if any(isinstance(item, str) and item == model for item in models):
+            return slug, model
+        return "", ""
+    return "", ""
+
