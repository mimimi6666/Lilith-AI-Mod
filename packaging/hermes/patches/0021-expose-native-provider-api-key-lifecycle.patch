+                    slug,
+                    source,
+                    strict=strict,
+                )
+                if source in available_env_sources and not suppressed:
+                    configured = True
+                if (
+                    (source != canonical_source and source not in borrowed_sources)
+                    or source not in available_env_sources
+                    or (suppressed and source not in borrowed_sources)
+                ):
