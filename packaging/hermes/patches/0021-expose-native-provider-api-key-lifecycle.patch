+                        f"{pool_name} credential pool entry is invalid"
+                    )
+
+    configured = False
+    legacy = False
+    canonical_source = f"env:{env_vars[0]}" if env_vars else ""
+    env_sources = {f"env:{env_var}" for env_var in env_vars}
+    borrowed_sources: set[str] = set()
+    try:
+        descriptor = _api_key_provider(slug)
+        _owned_slots, borrowed_slots = _descriptor_slot_ownership(descriptor)
+        borrowed_sources = {f"env:{env_var}" for env_var in borrowed_slots}
+    except Exception:
+        if strict:
+            raise
+    try:
+        from hermes_cli.config import load_env
+
+        disk_env = load_env()
+    except Exception:
