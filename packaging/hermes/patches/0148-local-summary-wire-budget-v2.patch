+def _shape_economic_request(client, request, binding, policy):
+    """Pure SDK shaping shared by admission and local summary planning.
+
+    No reservation, counting callback, dispatch permit, or usage event occurs
+    here. The actual leaf still independently validates its final request.
+    """
+    from agent.usage_budget_official_routes import (
+        normalize_official_economy_request, split_final_sdk_body,
+        lower_reviewed_thinking_budget,
+    )
+    request = normalize_official_economy_request(client, request, binding.capability.wire_format)
+    if binding.output_control != "verified" and policy.strict:
+        raise BudgetError("strict_output_cap_unverified")
+    body, restore = split_final_sdk_body(client, request, binding.capability.wire_format)
+    body = lower_reviewed_thinking_budget(client, body, binding.capability.wire_format, policy)
+    if binding.output_control == "unavailable":
+        guarded, cap = prepare_uncontrolled_estimated_request(
+            body, policy.output_tokens, binding.capability, binding.capability.route)
+    else:
+        guarded, cap = prepare_wire_request(body, output_limit=policy.output_tokens,
+            capability=binding.capability, route=binding.capability.route,
+            estimated_output=binding.output_control == "requested")
+    return restore(guarded), cap
+
+
+def local_summary_wire_shaper(client, request):
+    """Freeze a read-only local shaping closure; never acquire admission."""
+    from agent.local_compatibility import current_policy
+    if current_policy() is None:
+        raise BudgetError("local_compatibility_summary_policy_missing")
+    ledger = _active_ledger()
+    if ledger is None:
+        from copy import deepcopy
+        return deepcopy
+    binding = require_native_dispatch_route(client, request, _chat_wire_format(client, request))
+    policy = ledger.policy
+    return lambda candidate: _shape_economic_request(client, candidate, binding, policy)[0]
+
