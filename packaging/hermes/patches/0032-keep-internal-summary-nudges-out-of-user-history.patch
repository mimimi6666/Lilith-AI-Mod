+def test_history_hides_only_unattested_duplicate_user_in_canonical_turn():
+    synthetic_message = "7" * 32
+    malformed_message = "8" * 32
+    other_turn = "9" * 32
+    other_legacy_message = "a" * 32
+    history = [
+        {
+            "role": "user",
+            "content": "real user",
+            "display_metadata": _metadata(
+                TURN_1,
+                USER_MESSAGE,
+                user=True,
+                kind="user",
+            ),
+        },
+        {
+            "role": "user",
+            "content": "internal provider nudge",
+            "display_metadata": {
+                "hermes_turn_id": TURN_1,
+                "hermes_message_id": synthetic_message,
+            },
+        },
+        # A partially claimed newer row must remain visible so strict
+        # downstream validation can reject it instead of silently repairing it.
+        {
+            "role": "user",
+            "content": "malformed claimed user",
+            "display_metadata": {
+                "hermes_turn_id": TURN_1,
+                "hermes_message_id": malformed_message,
+                "hermes_message_kind": "user",
+            },
+        },
+        # A standalone legacy-correlated user in another turn is still a real
+        # visible history row; compatibility filtering is duplicate-scoped.
+        {
+            "role": "user",
+            "content": "other legacy user",
+            "display_metadata": {
+                "hermes_turn_id": other_turn,
+                "hermes_message_id": other_legacy_message,
+            },
+        },
+    ]
+
+    projected = server._history_to_messages(history)
+
+    assert [item["text"] for item in projected] == [
+        "real user",
+        "malformed claimed user",
+        "other legacy user",
+    ]
+    assert all(item["text"] != "internal provider nudge" for item in projected)
+
+
