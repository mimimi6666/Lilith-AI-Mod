+            runtime.get("requested_provider") or "")
+
+
+def _native_caller(*names):
+    """Match actual native code/globals, not a caller-provided module label."""
+    from agent import auxiliary_client
+    frame = sys._getframe(2)
+    if frame.f_code is contextlib._GeneratorContextManager.__enter__.__code__:
+        frame = frame.f_back
+    return frame.f_globals is vars(auxiliary_client) and any(
+        frame.f_code is getattr(getattr(auxiliary_client, name), "__wrapped__",
+                               getattr(auxiliary_client, name)).__code__ for name in names)
+
+
+def capture_local_usage_sink(runtime, task, policy, origin):
+    """Mint only from a real local turn's matching host-owned accounting DB."""
+    if not _native_caller("capture_auxiliary_runtime_context"):
+        raise TypeError("local usage capture requires its native owner")
+    from agent.local_compatibility import matches
+    from agent.usage_budget_runtime import capture_origin
+    from hermes_state import SessionDB
+    ctx = _accounting.get()
+    if (ctx is None or origin is None or capture_origin() is not origin
+            or type(task) is not str or not task or task in _EXCLUDED_TASKS
+            or not matches(policy, provider=runtime.get("provider"), model=runtime.get("model"),
+                base_url=runtime.get("base_url"), api_mode=runtime.get("api_mode"),
+                requested_provider=runtime.get("requested_provider") or "")):
+        return None
+    db, session_id = ctx
+    if (type(db) is not SessionDB or not session_id or runtime.get("session_id") != session_id
+            or Path(db.db_path).absolute() != (origin._owner.store.profile_root / "state.db").absolute()):
+        return None
+    sink = _LocalUsageSink(_SINK_ISSUER)
+    with _SINK_LOCK:
+        _SINKS[sink] = _SinkState(db.record_auxiliary_usage, session_id, task, origin, policy, _route(runtime))
+    return sink
+
+
+def _sink_state(sink):
+    if type(sink) is not _LocalUsageSink:
+        raise TypeError("expected an opaque local usage sink")
+    with _SINK_LOCK:
+        state = _SINKS.get(sink)
+    if state is None:
+        raise ValueError("local usage sink is unavailable")
+    from agent.auxiliary_client import _RUNTIME_MAIN_CONTEXT, _AUXILIARY_TASK_CONFIG_CONTEXT
+    from agent.local_compatibility import current_policy
+    from agent.usage_budget import current_turn_budget
+    from agent.usage_budget_runtime import current_origin
+    runtime = _RUNTIME_MAIN_CONTEXT.get() or {}
+    task_binding = _AUXILIARY_TASK_CONFIG_CONTEXT.get()
+    if (current_origin() is not state.origin or current_turn_budget() is not state.origin.ledger
+            or current_policy() is not state.policy or _route(runtime) != state.route
+            or runtime.get("session_id") != state.session_id
+            or not task_binding or task_binding[0] != state.task):
+        raise ValueError("local usage sink ownership differs")
+    return state
+
+
+@contextmanager
+def bind_local_usage_sink(sink):
+    if not _native_caller("_scoped_auxiliary_runtime_context"):
+        raise TypeError("local usage binding requires its native owner")
+    _sink_state(sink)
+    token = _LOCAL_SINK.set(sink)
+    try:
+        yield
+    finally:
+        _LOCAL_SINK.reset(token)
+
