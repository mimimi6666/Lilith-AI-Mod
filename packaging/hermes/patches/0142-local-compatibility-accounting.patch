+# Unlike the legacy ambient (DB, session) pair, this capability has no public
+# fields and carries no arbitrary database or callback authority into plugins.
+# Its private registry grants only one fixed session/task usage writer. This is
+# an in-process host boundary, not a Python-reflection sandbox.
+_SINK_ISSUER = object()
+_LOCAL_SINK = ContextVar("local_captured_aux_usage", default=None)
+_SINKS = WeakKeyDictionary()
+_SINK_LOCK = RLock()
