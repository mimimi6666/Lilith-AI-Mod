+def record_local_physical_usage(response, client, request):
+    """Called once after the guarded SDK leaf, not on validator re-entry.
+
+    Recording known usage remains valid when a completed request races Stop.
+    No response/unknown usage creates no fabricated zero-valued DB row. The
+    existing budget ledger independently retains uncertain physical attempts.
+    """
+    sink = _LOCAL_SINK.get()
+    if sink is None:
+        return
+    if not _native_caller("_budget_aux_sync_create", "_budget_aux_async_create"):
+        raise TypeError("local usage recording requires its physical native leaf")
+    try:
+        from agent.local_compatibility import _endpoint
+        from agent.usage_budget_usage import read_usage
+        from agent.usage_pricing import normalize_usage
+        from agent.auxiliary_client import _RELAY_AUX_CALL_CONTEXT
+        state = _sink_state(sink)
+        call = _RELAY_AUX_CALL_CONTEXT.get() or {}
+        if (call.get("task") != state.task or request.get("model") != state.route[1]
+                or _endpoint(str(getattr(client, "base_url", ""))) != state.route[2]):
+            raise ValueError("local usage response route differs")
+        counts = read_usage(response, "chat_completions")
+        if counts.input_tokens is None or counts.output_tokens is None:
+            return
+        raw_usage = getattr(response, "usage", None)
+        if raw_usage is None:
+            return
+        usage = normalize_usage(raw_usage, provider=state.route[0])
+        # Local-only inference has no provider price here. Keep cost unknown.
+        state.writer(state.session_id, state.task,
+            model=str(getattr(response, "model", "") or state.route[1]),
+            billing_provider=state.route[0], billing_base_url=str(getattr(client, "base_url", "")),
+            input_tokens=counts.input_tokens, output_tokens=counts.output_tokens,
+            cache_read_tokens=usage.cache_read_tokens, cache_write_tokens=usage.cache_write_tokens,
+            reasoning_tokens=usage.reasoning_tokens, estimated_cost_usd=None)
+    except Exception:
+        # Never expose endpoint, DB paths, response bodies or exception text.
+        logger.debug("Local auxiliary usage recording unavailable (non-fatal)")
