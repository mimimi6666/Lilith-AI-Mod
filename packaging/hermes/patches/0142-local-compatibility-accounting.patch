+class _LocalUsageSink:
+    __slots__ = ("__weakref__",)
+
+    def __new__(cls, issuer):
+        if issuer is not _SINK_ISSUER:
+            raise TypeError("auxiliary usage sinks are host-created")
+        return super().__new__(cls)
+
+    def __repr__(self):
+        return "<LocalAuxiliaryUsageSink>"
