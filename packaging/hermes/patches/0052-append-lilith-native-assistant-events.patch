+@method("session.append_assistant_event")
+def _(rid, params: dict) -> dict:
+    """Commit one official Lilith line as an assistant-authored event.
+
+    This endpoint is intentionally narrower than prompt submission: it never
+    invokes a model, accepts only the hidden durable ``lilith-game`` session,
+    and refuses to race a running or queued turn.  The native event is an
+    appended context fact, so the existing prompt-cache prefix is preserved.
+    """
+    expected_fields = {
+        "session_id",
+        "event_id",
+        "text",
+        "occurred_at_unix_ms",
+        "node_id",
+        "line_id",
+        "trigger",
+        "locale",
+        "source",
+        "require_durable_lineage",
+    }
+
+    raw_event_id = params.get("event_id")
+    event_id = raw_event_id if isinstance(raw_event_id, str) else ""
+    raw_session_id = params.get("session_id")
+    sid = raw_session_id if isinstance(raw_session_id, str) else ""
+
+    def reject(
+        rpc_code: int,
+        message: str,
+        code: str,
+        *,
+        retryable: bool,
+    ) -> dict:
+        return _err(
+            rid,
+            rpc_code,
+            message,
+            {
+                "accepted": False,
+                "already_committed": False,
+                "retryable": retryable,
+                "code": code,
+                "session_id": sid,
+                "event_id": event_id,
+            },
+        )
+
+    if set(params) != expected_fields:
+        return reject(
+            4004,
+            "native assistant event parameters were non-canonical",
+            "native_assistant_event_invalid",
+            retryable=False,
+        )
+
+    from agent.turn_identity import canonical_id
+
+    text = params.get("text")
+    occurred_at_unix_ms = params.get("occurred_at_unix_ms")
+    node_id = params.get("node_id")
+    line_id = params.get("line_id")
+    trigger = params.get("trigger")
+    locale = params.get("locale")
+
+    def bounded_utf8(value, limit: int, *, nonblank: bool = False) -> bool:
+        if not isinstance(value, str) or len(value) > limit:
+            return False
+        if nonblank and not value.strip():
+            return False
+        try:
+            value.encode("utf-8")
+        except UnicodeEncodeError:
+            return False
+        return True
+
+    if (
+        not bounded_utf8(sid, 128, nonblank=True)
+        or canonical_id(event_id) != event_id
+        or not bounded_utf8(text, 8192, nonblank=True)
+        or type(occurred_at_unix_ms) is not int
+        or not 0 < occurred_at_unix_ms <= 253402300799999
+        or not bounded_utf8(node_id, 256)
+        or not bounded_utf8(line_id, 256)
+        or not bounded_utf8(trigger, 256)
+        or not bounded_utf8(locale, 64)
+        or params.get("source") != "lilith-native"
+        or params.get("require_durable_lineage") is not True
+    ):
+        return reject(
+            4004,
+            "native assistant event parameters were rejected",
+            "native_assistant_event_invalid",
+            retryable=False,
+        )
+
+    session = _sessions.get(sid)
+    if session is None:
+        return reject(
+            4001,
+            "session not found",
+            "native_assistant_event_session_not_found",
+            retryable=True,
+        )
+
+    from hermes_state import (
+        CompressionSessionClosedError,
+        NativeAssistantEventConflictError,
+        SessionCompressionInProgressError,
+        build_native_assistant_event_message,
+    )
+
+    try:
+        with _session_resume_lock:
+            if _sessions.get(sid) is not session or session.get("_finalized"):
+                return reject(
+                    4001,
+                    "session not found",
+                    "native_assistant_event_session_not_found",
+                    retryable=True,
+                )
+            with session["history_lock"]:
+                lineage_root = session.get("_durable_lineage_root")
+                session_key = session.get("session_key")
+                if (
+                    session.get("source") != "lilith-game"
+                    or session.get("archived") is not True
+                    or not isinstance(lineage_root, str)
+                    or not lineage_root
+                    or not isinstance(session_key, str)
+                    or not session_key
+                    or _session_uses_compute_host(session)
+                ):
+                    return reject(
+                        4030,
+                        "native assistant events require a local durable hidden game session",
+                        "native_assistant_event_scope_rejected",
+                        retryable=False,
+                    )
+                if (
+                    session.get("running")
+                    or isinstance(session.get("inflight_turn"), dict)
+                    or isinstance(session.get("queued_prompt"), dict)
+                    or bool(session.get("queued_prompts"))
+                    or session.get("_queued_prompt_drain_scheduled") is True
+                    or session.get("_turn_cancel_requested") is True
+                ):
+                    return reject(
+                        4009,
+                        "native assistant events require an idle session",
+                        "native_assistant_event_session_busy",
+                        retryable=True,
+                    )
+
+                expected_live_message = build_native_assistant_event_message(
+                    event_id=event_id,
+                    text=text,
+                    occurred_at_unix_ms=occurred_at_unix_ms,
+                    node_id=node_id,
+                    line_id=line_id,
+                    trigger=trigger,
+                    locale=locale,
+                    source="lilith-native",
+                )
+                matching = []
+                for item in session.setdefault("history", []):
+                    metadata = (
+                        item.get("display_metadata")
+                        if isinstance(item, dict)
+                        else None
+                    )
+                    if (
+                        isinstance(metadata, dict)
+                        and metadata.get("lilith_native_event_id") == event_id
+                    ):
+                        matching.append(item)
+                if len(matching) > 1 or (
+                    matching
+                    and (
+                        matching[0].get("role")
+                        != expected_live_message["role"]
+                        or matching[0].get("content")
+                        != expected_live_message["content"]
+                        or matching[0].get("message_id")
+                        != expected_live_message["message_id"]
+                        or matching[0].get("display_kind")
+                        != expected_live_message["display_kind"]
+                        or matching[0].get("display_metadata")
+                        != expected_live_message["display_metadata"]
+                        or not isinstance(
+                            matching[0].get("timestamp"), (int, float)
+                        )
+                        or isinstance(matching[0].get("timestamp"), bool)
+                        or abs(
+                            float(matching[0]["timestamp"])
+                            - float(expected_live_message["timestamp"])
+                        )
+                        > 1e-6
+                    )
+                ):
+                    raise NativeAssistantEventConflictError(
+                        "live native assistant event identity conflicted"
+                    )
+
+                with _session_db(session) as db:
+                    if db is None:
+                        raise RuntimeError("durable session database is unavailable")
+                    proof = db.attest_resume_session_lineage(
+                        lineage_root,
+                        session_key,
+                        expected_source="lilith-game",
+                        expected_archived=True,
+                    )
+                    _bind_durable_lineage_session(session, proof)
+                    receipt = db.append_native_assistant_event(
+                        session_key,
+                        lineage_session_ids=list(proof["session_ids"]),
+                        event_id=event_id,
+                        text=text,
+                        occurred_at_unix_ms=occurred_at_unix_ms,
+                        node_id=node_id,
+                        line_id=line_id,
+                        trigger=trigger,
+                        locale=locale,
+                        source="lilith-native",
+                    )
+                    post_proof = db.attest_resume_session_lineage(
+                        lineage_root,
+                        session_key,
+                        expected_source="lilith-game",
+                        expected_archived=True,
+                    )
+                    if post_proof != proof:
+                        raise RuntimeError(
+                            "durable lineage changed while appending native event"
+                        )
+                    _bind_durable_lineage_session(session, post_proof)
+
+                durable = {
+                    "source": "state.db",
+                    "row_id": int(receipt["row_id"]),
+                    "session_id": str(receipt["session_id"]),
+                    "timestamp": float(receipt["timestamp"]),
+                    "conversation_activity": bool(
+                        receipt["conversation_activity"]
+                    ),
+                }
+                persisted_metadata = dict(
+                    receipt["message"]["display_metadata"]
+                )
+                public_metadata_keys = (
+                    "lilith_native_event_id",
+                    "lilith_native_source",
+                    "lilith_native_occurred_at_unix_ms",
+                    "lilith_native_node_id",
+                    "lilith_native_line_id",
+                    "lilith_native_trigger",
+                    "lilith_native_locale",
+                )
+                display_metadata = {
+                    key: persisted_metadata[key] for key in public_metadata_keys
+                }
+                public_message = {
+                    "message_id": event_id,
+                    "role": "assistant",
+                    "text": text,
+                    "timestamp": durable["timestamp"],
+                    "display_kind": "native_assistant_event",
+                    "display_metadata": display_metadata,
+                }
+
+                # A retry after compression finds the event in an ancestor.
+                # That row remains visible in the durable display lineage, but
+                # re-appending it to the compressed model history would undo
+                # compression and duplicate context.  Only the current-tip row
+                # belongs in the live model history.
+                if durable["session_id"] == session_key:
+                    if not matching:
+                        session["history"].append(dict(receipt["message"]))
+                        session["history_version"] = int(
+                            session.get("history_version", 0)
+                        ) + 1
+                    agent = session.get("agent")
+                    if agent is not None and isinstance(
+                        getattr(agent, "_session_messages", None), list
+                    ):
+                        agent._session_messages = list(session["history"])
+
+                result = {
+                    "accepted": True,
+                    "already_committed": bool(receipt["already_committed"]),
+                    "retryable": False,
+                    "code": (
+                        "native_assistant_event_duplicate"
+                        if receipt["already_committed"]
+                        else "native_assistant_event_committed"
+                    ),
+                    "session_id": sid,
+                    "event_id": event_id,
+                    "message_id": event_id,
+                    "content_sha256": hashlib.sha256(
+                        text.encode("utf-8")
+                    ).hexdigest(),
+                    "stored_session_id": str(post_proof["resolved_session_id"]),
+                    "durable_lineage": post_proof,
+                    "durable": durable,
+                    "message": public_message,
+                }
+    except NativeAssistantEventConflictError:
+        return reject(
+            4092,
+            "native assistant event id was already committed differently",
+            "native_assistant_event_idempotency_conflict",
+            retryable=False,
+        )
+    except (CompressionSessionClosedError, SessionCompressionInProgressError):
+        return reject(
+            4009,
+            "native assistant event collided with session compression",
+            "native_assistant_event_session_busy",
+            retryable=True,
+        )
+    except ValueError:
+        return reject(
+            4094,
+            "durable session lineage was rejected",
+            "native_assistant_event_lineage_rejected",
+            retryable=False,
+        )
+    except Exception:
+        logger.warning("native assistant event persistence failed", exc_info=True)
+        return reject(
+            5006,
+            "native assistant event persistence is unavailable",
+            "native_assistant_event_persistence_unavailable",
+            retryable=True,
+        )
+
+    try:
+        _emit("session.assistant_event", sid, result)
+    except Exception:
+        # The durable receipt is authoritative.  A disconnected renderer can
+        # rehydrate the exact row from session.history and retry by event id.
+        logger.debug("native assistant event live emit failed", exc_info=True)
+    return _ok(rid, result)
+
+
 @method("session.undo")
 def _(rid, params: dict) -> dict:
     session, err = _sess(params, rid)
