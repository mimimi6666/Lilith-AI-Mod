@@ -0,0 +1,378 @@
+"""Contracts for appending official Lilith lines to the hidden Hermes chat."""
+
+from __future__ import annotations
+
+import threading
+import types
+
+import pytest
+
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+EVENT_ID = "0123456789abcdef0123456789abcdef"
+METADATA_KEYS = {
+    "lilith_native_event_id",
+    "lilith_native_source",
+    "lilith_native_occurred_at_unix_ms",
+    "lilith_native_node_id",
+    "lilith_native_line_id",
+    "lilith_native_trigger",
+    "lilith_native_locale",
+}
+
+
+def _params(**overrides):
+    params = {
+        "session_id": "game-live",
+        "event_id": EVENT_ID,
+        "text": "莉莉絲整理了一下裙襬。",
+        "occurred_at_unix_ms": 1787932800123,
+        "node_id": "wardrobe-idle",
+        "line_id": "wardrobe-idle-03",
+        "trigger": "wardrobe.changed",
+        "locale": "zh-Hant",
+        "source": "lilith-native",
+        "require_durable_lineage": True,
+    }
+    params.update(overrides)
+    return params
+
+
+@pytest.fixture
+def native_session(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("game-root", source="lilith-game", archived=True)
+    agent = types.SimpleNamespace(_session_messages=[])
+    session = {
+        "agent": agent,
+        "archived": True,
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "inflight_turn": None,
+        "profile_home": None,
+        "queued_prompt": None,
+        "running": False,
+        "session_key": "game-root",
+        "source": "lilith-game",
+        "_durable_lineage_root": "game-root",
+    }
+    emitted = []
+    existing = set(server._sessions)
+    server._sessions["game-live"] = session
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda *_args: False)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: emitted.append((event, sid, payload)),
+    )
+    try:
+        yield db, session, emitted
+    finally:
+        for sid in set(server._sessions) - existing:
+            server._sessions.pop(sid, None)
+        db.close()
+
+
+def _append(params=None):
+    return server._methods["session.append_assistant_event"](
+        "append-native",
+        params or _params(),
+    )
+
+
+def test_commits_canonical_receipt_and_synchronizes_live_and_durable_history(
+    native_session,
+):
+    db, session, emitted = native_session
+
+    response = _append()
+
+    assert "error" not in response
+    result = response["result"]
+    assert set(result) == {
+        "accepted",
+        "already_committed",
+        "retryable",
+        "code",
+        "session_id",
+        "event_id",
+        "message_id",
+        "content_sha256",
+        "stored_session_id",
+        "durable_lineage",
+        "durable",
+        "message",
+    }
+    assert result["accepted"] is True
+    assert result["already_committed"] is False
+    assert result["retryable"] is False
+    assert result["code"] == "native_assistant_event_committed"
+    assert result["event_id"] == EVENT_ID
+    assert result["message_id"] == EVENT_ID
+    assert len(result["content_sha256"]) == 64
+    assert result["stored_session_id"] == "game-root"
+    assert result["durable"] == {
+        "source": "state.db",
+        "row_id": result["durable"]["row_id"],
+        "session_id": "game-root",
+        "timestamp": 1787932800.123,
+        "conversation_activity": True,
+    }
+    assert result["durable"]["row_id"] > 0
+    assert set(result["message"]["display_metadata"]) == METADATA_KEYS
+    assert result["message"]["display_metadata"] == {
+        "lilith_native_event_id": EVENT_ID,
+        "lilith_native_source": "lilith-native",
+        "lilith_native_occurred_at_unix_ms": 1787932800123,
+        "lilith_native_node_id": "wardrobe-idle",
+        "lilith_native_line_id": "wardrobe-idle-03",
+        "lilith_native_trigger": "wardrobe.changed",
+        "lilith_native_locale": "zh-Hant",
+    }
+
+    assert len(session["history"]) == 1
+    assert session["history"][0]["content"] == _params()["text"]
+    assert session["history"][0]["_db_persisted"] is True
+    assert session["agent"]._session_messages == session["history"]
+    assert db.message_count("game-root") == 1
+    assert db.get_session("game-root")["message_count"] == 1
+
+    history = server._methods["session.history"](
+        "history",
+        {"session_id": "game-live"},
+    )
+    assert [message["text"] for message in history["result"]["messages"]] == [
+        _params()["text"]
+    ]
+    durable_message = history["result"]["messages"][0]
+    assert durable_message["role"] == "assistant"
+    assert durable_message["display_kind"] == "native_assistant_event"
+    assert durable_message["message_id"] == EVENT_ID
+    assert durable_message["message_kind"] == "primary"
+    assert len(durable_message["turn_id"]) == 32
+    assert durable_message["turn_id"] != EVENT_ID
+    for key, value in result["message"]["display_metadata"].items():
+        assert durable_message["display_metadata"][key] == value
+    assert durable_message["display_metadata"] | {
+        "hermes_turn_id": durable_message["turn_id"],
+        "hermes_message_id": EVENT_ID,
+        "hermes_message_kind": "primary",
+        "hermes_turn_origin": "synthetic",
+        "hermes_turn_origin_kind": "lilith-native",
+    } == durable_message["display_metadata"]
+    assert emitted == [("session.assistant_event", "game-live", result)]
+
+
+def test_same_event_retry_is_idempotent_in_db_live_history_and_receipt(native_session):
+    db, session, emitted = native_session
+
+    first = _append()["result"]
+    second = _append()["result"]
+
+    assert first["already_committed"] is False
+    assert second["already_committed"] is True
+    assert second["code"] == "native_assistant_event_duplicate"
+    assert second["durable"] == first["durable"]
+    assert second["message"] == first["message"]
+    assert db.message_count("game-root") == 1
+    assert db.get_session("game-root")["message_count"] == 1
+    assert len(session["history"]) == 1
+    assert len(emitted) == 2
+
+
+def test_same_event_id_with_different_live_or_durable_content_is_terminal(
+    native_session,
+):
+    db, session, _ = native_session
+    session["history"].append(
+        {
+            "role": "assistant",
+            "content": "stale live content",
+            "message_id": EVENT_ID,
+            "timestamp": 1787932800.123,
+            "display_kind": "native_assistant_event",
+            "display_metadata": {"lilith_native_event_id": EVENT_ID},
+        }
+    )
+
+    live_conflict = _append()
+
+    assert live_conflict["error"]["code"] == 4092
+    assert live_conflict["error"]["data"]["code"] == (
+        "native_assistant_event_idempotency_conflict"
+    )
+    assert db.message_count("game-root") == 0
+    session["history"].clear()
+    assert "error" not in _append()
+
+    response = _append(_params(text="這不是同一件事。"))
+
+    assert response["error"]["code"] == 4092
+    assert response["error"]["data"] == {
+        "accepted": False,
+        "already_committed": False,
+        "retryable": False,
+        "code": "native_assistant_event_idempotency_conflict",
+        "session_id": "game-live",
+        "event_id": EVENT_ID,
+    }
+    assert db.message_count("game-root") == 1
+    assert len(session["history"]) == 1
+
+
+@pytest.mark.parametrize(
+    "busy_state",
+    [
+        {"running": True},
+        {"inflight_turn": {"status": "error"}},
+        {"queued_prompt": {"text": "next"}},
+        {"queued_prompts": [{"text": "later"}]},
+        {"_queued_prompt_drain_scheduled": True},
+        {"_turn_cancel_requested": True},
+    ],
+)
+def test_refuses_every_non_idle_turn_state(native_session, busy_state):
+    db, session, _ = native_session
+    session.update(busy_state)
+
+    response = _append()
+
+    assert response["error"]["code"] == 4009
+    assert response["error"]["data"]["retryable"] is True
+    assert response["error"]["data"]["code"] == (
+        "native_assistant_event_session_busy"
+    )
+    assert db.message_count("game-root") == 0
+
+
+@pytest.mark.parametrize(
+    "mutation",
+    [
+        lambda params: params.pop("locale"),
+        lambda params: params.update({"extra": True}),
+        lambda params: params.update({"event_id": EVENT_ID.upper()}),
+        lambda params: params.update({"source": "desktop"}),
+        lambda params: params.update({"require_durable_lineage": False}),
+        lambda params: params.update({"node_id": "x" * 257}),
+        lambda params: params.update({"text": " "}),
+        lambda params: params.update({"occurred_at_unix_ms": True}),
+    ],
+)
+def test_rejects_noncanonical_or_out_of_bounds_input(native_session, mutation):
+    db, _, _ = native_session
+    params = _params()
+    mutation(params)
+
+    response = _append(params)
+
+    assert response["error"]["code"] == 4004
+    assert response["error"]["data"]["retryable"] is False
+    assert response["error"]["data"]["code"] == "native_assistant_event_invalid"
+    assert db.message_count("game-root") == 0
+
+
+@pytest.mark.parametrize(
+    "surface_state",
+    [
+        {"source": "desktop"},
+        {"archived": False},
+        {"_durable_lineage_root": None},
+    ],
+)
+def test_refuses_any_non_hidden_or_non_durable_surface(
+    native_session,
+    surface_state,
+):
+    db, session, _ = native_session
+    session.update(surface_state)
+
+    response = _append()
+
+    assert response["error"]["code"] == 4030
+    assert response["error"]["data"]["retryable"] is False
+    assert response["error"]["data"]["code"] == (
+        "native_assistant_event_scope_rejected"
+    )
+    assert db.message_count("game-root") == 0
+
+
+def test_duplicate_in_compressed_ancestor_is_not_reinserted_into_tip_history(
+    native_session,
+):
+    db, session, _ = native_session
+    first = _append()["result"]
+    assert first["durable"]["session_id"] == "game-root"
+
+    db.end_session("game-root", end_reason="compression")
+    db.create_session(
+        "game-tip",
+        source="lilith-game",
+        parent_session_id="game-root",
+        archived=True,
+    )
+    session["session_key"] = "game-tip"
+    session["history"] = []
+    session["agent"]._session_messages = []
+
+    duplicate = _append()["result"]
+
+    assert duplicate["already_committed"] is True
+    assert duplicate["stored_session_id"] == "game-tip"
+    assert duplicate["durable"]["session_id"] == "game-root"
+    assert duplicate["durable_lineage"]["session_ids"] == [
+        "game-root",
+        "game-tip",
+    ]
+    assert db.message_count() == 1
+    assert session["history"] == []
+    history = server._methods["session.history"](
+        "history-compressed",
+        {"session_id": "game-live"},
+    )
+    assert [message["text"] for message in history["result"]["messages"]] == [
+        _params()["text"]
+    ]
+
+
+def test_model_replay_repairs_adjacent_assistant_rows_without_hiding_native_event(
+    native_session,
+):
+    db, _, _ = native_session
+    db.append_message("game-root", role="user", content="你好")
+    db.append_message("game-root", role="assistant", content="早安。")
+
+    assert "error" not in _append()
+    model_history, display_history = db.get_resume_conversations("game-root")
+
+    assert all(
+        left["role"] != right["role"]
+        for left, right in zip(model_history, model_history[1:])
+    )
+    assert _params()["text"] in model_history[-1]["content"]
+    native_rows = [
+        message
+        for message in display_history
+        if message.get("display_kind") == "native_assistant_event"
+    ]
+    assert len(native_rows) == 1
+    assert native_rows[0]["content"] == _params()["text"]
+
+
+def test_missing_live_session_is_retryable_and_does_not_touch_db(
+    native_session,
+):
+    db, _, _ = native_session
+    server._sessions.pop("game-live")
+
+    response = _append()
+
+    assert response["error"]["code"] == 4001
+    assert response["error"]["data"]["retryable"] is True
+    assert response["error"]["data"]["code"] == (
+        "native_assistant_event_session_not_found"
+    )
+    assert db.message_count("game-root") == 0
