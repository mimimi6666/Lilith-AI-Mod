+def test_rollback_restore_is_durable_idempotent_and_emits_lossless_event(
+    monkeypatch, tmp_path,
+):
+    manager_calls = []
+    db_calls = []
+    memory_calls = []
+    invalidations = []
+    events = []
+
+    class _Mgr:
+        enabled = True
+
+        def list_checkpoints(self, _cwd):
+            return []
+
+        def restore(self, cwd, target, file_path=None):
+            manager_calls.append((cwd, target, file_path))
+            return {
+                "success": True,
+                "restored_to": target[:8],
+                "reason": "before edit",
+                "directory": cwd,
+                "pre_snapshot": "f" * 40,
+            }
+
+    class _Db:
+        def replace_messages(self, key, messages, **kwargs):
+            db_calls.append((key, list(messages), kwargs))
+
+    class _Memory:
+        def on_session_switch(self, *args, **kwargs):
+            memory_calls.append((args, kwargs))
+
+    cwd = tmp_path / "workspace"
+    cwd.mkdir()
+    agent = types.SimpleNamespace(
+        _checkpoint_mgr=_Mgr(),
+        _last_flushed_db_idx=99,
+        _memory_manager=_Memory(),
+        _invalidate_system_prompt=lambda: invalidations.append(True),
+    )
+    history = [
+        {"role": "user", "content": "first"},
+        {"role": "assistant", "content": "first reply"},
+        {"role": "user", "content": "second"},
+        {"role": "assistant", "content": "second reply"},
+    ]
+    server._sessions["rollback-idempotent"] = _session(
+        agent=agent, cwd=str(cwd), history=list(history)
+    )
+    monkeypatch.setattr(server, "_get_db", lambda: _Db())
+    monkeypatch.setattr(
+        server, "_emit", lambda event, sid, payload: events.append((event, sid, payload))
+    )
+    params = {
+        "session_id": "rollback-idempotent",
+        "hash": "abc12345",
+        "expected_cwd": str(cwd),
+        "confirm": True,
+        "operation_id": "restore-op-1",
+    }
+    try:
+        first = server.handle_request(
+            {"id": "restore-1", "method": "rollback.restore", "params": params}
+        )
+        assert set(first["result"]) == {
+            "success",
+            "restored_to",
+            "pre_snapshot",
+            "reason",
+            "error",
+            "operation_id",
+            "replayed",
+            "workspace_restored",
+            "history_rewound",
+            "history_removed",
+            "partial",
+        }
+        assert first["result"]["success"] is True
+        assert first["result"]["workspace_restored"] is True
+        assert first["result"]["history_rewound"] is True
+        assert first["result"]["history_removed"] == 2
+        assert first["result"]["partial"] is False
+        assert first["result"]["error"] == ""
+        assert server._sessions["rollback-idempotent"]["history"] == history[:2]
+        assert db_calls == [
+            (
+                "session-key",
+                history[:2],
+                {"active_only": True, "archive_dropped": True},
+            )
+        ]
+        assert agent._last_flushed_db_idx == 2
+        assert len(memory_calls) == 1
+        assert invalidations == [True]
+        assert len(events) == 1
+        assert events[0][0:2] == ("rollback.restored", "rollback-idempotent")
+        assert events[0][2]["pre_snapshot"] == "f" * 40
+        assert "directory" not in events[0][2]
+
+        replay = server.handle_request(
+            {"id": "restore-2", "method": "rollback.restore", "params": dict(params)}
+        )
+        assert replay["result"]["replayed"] is True
+        assert len(manager_calls) == 1
+        assert len(db_calls) == 1
+        assert len(events) == 1
+
+        conflict_params = dict(params, hash="def67890")
+        conflict = server.handle_request(
+            {
+                "id": "restore-conflict",
+                "method": "rollback.restore",
+                "params": conflict_params,
+            }
+        )
+        assert conflict["error"]["code"] == 4004
+        assert len(manager_calls) == 1
+    finally:
+        server._sessions.pop("rollback-idempotent", None)
+
