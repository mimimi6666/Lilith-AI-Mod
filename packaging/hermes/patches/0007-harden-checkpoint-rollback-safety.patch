+                "restored_to": target[:8],
+                "reason": "target",
+                "directory": cwd,
+                "pre_snapshot": "e" * 40,
+            }
+
+    class _FailDb:
+        def replace_messages(self, *_args, **_kwargs):
+            raise OSError("disk full")
+
+    cwd = tmp_path / "workspace"
+    cwd.mkdir()
+    history = [
+        {"role": "user", "content": "question"},
+        {"role": "assistant", "content": "answer"},
+    ]
+    server._sessions["rollback-partial"] = _session(
+        agent=types.SimpleNamespace(_checkpoint_mgr=_Mgr()),
+        cwd=str(cwd),
+        history=list(history),
+    )
+    monkeypatch.setattr(server, "_get_db", lambda: _FailDb())
+    monkeypatch.setattr(
+        server, "_emit", lambda event, sid, payload: events.append((event, sid, payload))
+    )
+    params = {
+        "session_id": "rollback-partial",
+        "hash": "abc12345",
+        "expected_cwd": str(cwd),
+        "confirm": True,
+        "operation_id": "partial-op-1",
+    }
+    try:
+        first = server.handle_request(
+            {"id": "partial-1", "method": "rollback.restore", "params": params}
+        )
+        receipt = first["result"]
+        assert set(receipt) == {
+            "success",
+            "restored_to",
+            "pre_snapshot",
+            "reason",
+            "error",
+            "operation_id",
+            "replayed",
+            "workspace_restored",
+            "history_rewound",
+            "history_removed",
+            "partial",
+        }
+        assert receipt["success"] is False
+        assert receipt["partial"] is True
+        assert receipt["workspace_restored"] is True
+        assert receipt["history_rewound"] is False
+        assert receipt["history_removed"] == 0
+        assert receipt["pre_snapshot"] == "e" * 40
+        assert "disk full" in receipt["error"]
+        assert server._sessions["rollback-partial"]["history"] == history
+        assert events[0][2]["partial"] is True
+        assert events[0][2]["restored_to"] == "abc12345"
+        assert events[0][2]["pre_snapshot"] == "e" * 40
+
+        replay = server.handle_request(
+            {"id": "partial-2", "method": "rollback.restore", "params": dict(params)}
+        )
+        assert replay["result"]["replayed"] is True
+        assert replay["result"]["partial"] is True
+        assert len(manager_calls) == 1
+        assert len(events) == 1
+    finally:
+        server._sessions.pop("rollback-partial", None)
