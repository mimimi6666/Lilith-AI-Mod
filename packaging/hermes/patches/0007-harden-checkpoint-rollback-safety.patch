+def _lock_checkpoint_file_windows(fd: int):
+    """Take a blocking one-byte lock without extending an empty file."""
+    import ctypes
+    import msvcrt
+
+    class _Overlapped(ctypes.Structure):
+        _fields_ = [
+            ("internal", ctypes.c_size_t),
+            ("internal_high", ctypes.c_size_t),
+            ("offset", ctypes.c_uint32),
+            ("offset_high", ctypes.c_uint32),
+            ("event", ctypes.c_void_p),
+        ]
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    lock_file = kernel32.LockFileEx
+    lock_file.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_uint32,
+        ctypes.c_uint32,
+        ctypes.c_uint32,
+        ctypes.c_uint32,
+        ctypes.c_void_p,
+    ]
+    lock_file.restype = ctypes.c_int
+    overlapped = _Overlapped()
+    if not lock_file(
+        msvcrt.get_osfhandle(fd),
+        0x00000002,  # LOCKFILE_EXCLUSIVE_LOCK; waits without FAIL_IMMEDIATELY
+        0,
+        1,
+        0,
+        ctypes.byref(overlapped),
+    ):
+        raise ctypes.WinError(ctypes.get_last_error())
+    return overlapped
+
+
+def _unlock_checkpoint_file_windows(fd: int, overlapped) -> None:
+    import ctypes
+    import msvcrt
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    unlock_file = kernel32.UnlockFileEx
+    unlock_file.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_uint32,
+        ctypes.c_uint32,
+        ctypes.c_uint32,
+        ctypes.c_void_p,
+    ]
+    unlock_file.restype = ctypes.c_int
+    if not unlock_file(
+        msvcrt.get_osfhandle(fd),
+        0,
+        1,
+        0,
+        ctypes.byref(overlapped),
+    ):
+        raise ctypes.WinError(ctypes.get_last_error())
+
