+                    "reason": "before patch",
+                }
+            ]
+
+    cwd = tmp_path / "workspace"
+    cwd.mkdir()
+    server._sessions["rollback-list"] = _session(
+        agent=types.SimpleNamespace(_checkpoint_mgr=_Mgr()), cwd=str(cwd)
