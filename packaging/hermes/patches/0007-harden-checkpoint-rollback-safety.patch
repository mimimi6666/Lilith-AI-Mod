+class _CheckpointFileLock:
+    """Small blocking cross-process lock used for checkpoint store mutations."""
+
+    def __init__(self, path: Path, before_open=None, before_parent_provision=None):
+        self.path = path
+        self._fh = None
+        self._before_open = before_open
+        self._before_parent_provision = before_parent_provision
+        self._windows_overlapped = None
+
+    def __enter__(self):
+        safe_parent, parent_error = _validate_existing_path_components(
+            self.path.parent,
+            "Checkpoint lock parent",
+        )
+        if parent_error or safe_parent is None:
+            raise RuntimeError(parent_error or "checkpoint lock parent is unsafe")
+        if self._before_parent_provision is not None:
+            self._before_parent_provision(safe_parent)
+        _ensure_directory_tree_no_follow(safe_parent)
+        safe_parent, parent_error = _validate_existing_path_components(
+            safe_parent,
+            "Checkpoint lock parent",
+        )
+        if parent_error or safe_parent is None:
+            raise RuntimeError(parent_error or "checkpoint lock parent is unsafe")
+        safe_path, path_error = _validate_existing_path_components(
+            safe_parent / self.path.name,
+            "Checkpoint lock",
+        )
+        if path_error or safe_path is None:
+            raise RuntimeError(path_error or "checkpoint lock path is unsafe")
+        self.path = safe_path
+        if self._before_open is not None:
+            self._before_open(self.path)
+
+        fd = _open_checkpoint_lock_no_follow(self.path)
+        try:
+            path_stat = os.lstat(self.path)
+            handle_stat = os.fstat(fd)
+            same_identity = (
+                not path_stat.st_dev
+                or not path_stat.st_ino
+                or (path_stat.st_dev, path_stat.st_ino)
+                == (handle_stat.st_dev, handle_stat.st_ino)
+            )
+            if (
+                _is_symlink_or_reparse(path_stat)
+                or not stat.S_ISREG(handle_stat.st_mode)
+                or not same_identity
+                or getattr(path_stat, "st_nlink", 1) != 1
+                or _checkpoint_lock_link_count(fd) != 1
+            ):
+                raise RuntimeError(
+                    "checkpoint lock path changed or is not a single-link regular file"
+                )
+            self._fh = os.fdopen(fd, "r+b")
+            fd = -1
+        finally:
+            if fd >= 0:
+                os.close(fd)
+        try:
+            if os.name == "nt":
+                # LockFileEx permits a range beyond EOF, so an empty lock file
+                # never needs a sentinel write that could mutate a hard-link.
+                self._windows_overlapped = _lock_checkpoint_file_windows(
+                    self._fh.fileno()
+                )
+            else:
+                import fcntl
+
+                fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX)
+        except Exception as exc:
+            self._fh.close()
+            self._fh = None
+            raise RuntimeError(f"checkpoint lock unavailable: {self.path.name}") from exc
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        if self._fh is None:
+            return
+        try:
+            if os.name == "nt":
+                if self._windows_overlapped is not None:
+                    _unlock_checkpoint_file_windows(
+                        self._fh.fileno(), self._windows_overlapped
+                    )
+            else:
+                import fcntl
+
+                fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
+        except Exception:
+            pass
+        finally:
+            self._fh.close()
+            self._fh = None
+            self._windows_overlapped = None
+
+
+@contextlib.contextmanager
+def _checkpoint_file_lock(path: Path):
+    safe_path, path_error = _validate_existing_path_components(
+        path,
+        "Checkpoint lock",
+    )
+    if path_error or safe_path is None:
+        raise RuntimeError(path_error or "checkpoint lock path is unsafe")
+    key = os.path.normcase(str(safe_path))
+    with _PROCESS_LOCKS_GUARD:
+        process_lock = _PROCESS_LOCKS.setdefault(key, threading.RLock())
+    with process_lock:
+        with _CheckpointFileLock(safe_path):
+            yield
+
+
+@contextlib.contextmanager
+def _checkpoint_operation_locks(checkpoint_base: Path, working_dir: str):
+    """Take locks in a canonical order: profile store, then workspace."""
+    safe_base, base_error = _validate_checkpoint_base(checkpoint_base)
+    if base_error or safe_base is None:
+        raise RuntimeError(base_error or "Checkpoint storage is unsafe")
+    locks_dir = safe_base / _LOCKS_DIRNAME
+    with _checkpoint_file_lock(locks_dir / "store.lock"):
+        with _checkpoint_file_lock(
+            locks_dir / f"workspace-{_project_hash(working_dir)}.lock"
+        ):
+            _, base_error = _validate_checkpoint_base(safe_base)
+            if base_error:
+                raise RuntimeError(base_error)
+            yield
