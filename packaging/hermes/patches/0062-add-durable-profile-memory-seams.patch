+@method("memory.provider.manage")
+def _(rid, params: dict) -> dict:
+    """Route one authenticated control-plane call to the active provider.
+
+    This is deliberately not a model tool.  The provider owns its typed
+    actions, revision/idempotency checks, data schema and player-data path;
+    the generic gateway only resolves the exact active provider and supplies
+    the active profile home.  A fresh management-context instance avoids
+    borrowing a conversation agent or starting provider review workers.
+    """
+    if not isinstance(params, dict) or set(params) != {"action", "request"}:
+        return _err(rid, 4001, "memory management parameters are invalid")
+    action = params.get("action")
+    request = params.get("request")
+    if (
+        not isinstance(action, str)
+        or not action
+        or action != action.strip()
+        or len(action) > 80
+        or not all(
+            ch in "abcdefghijklmnopqrstuvwxyz0123456789._-" for ch in action
+        )
+        or not isinstance(request, dict)
+    ):
+        return _err(rid, 4001, "memory management request is invalid")
+
+    provider = None
+    initialized = False
+    try:
+        from agent.memory_provider import MemoryProvider
+        from hermes_constants import get_hermes_home
+        from plugins.memory import _get_active_memory_provider, load_memory_provider
+
+        provider_name = str(_get_active_memory_provider() or "").strip()
+        if not provider_name or provider_name == "built-in":
+            return _err(rid, 4045, "no external memory provider is active")
+        provider = load_memory_provider(provider_name, register_skills=False)
+        if provider is None or not provider.is_available():
+            return _err(rid, 4045, "the active memory provider is unavailable")
+        if type(provider).handle_management_request is MemoryProvider.handle_management_request:
+            return _err(rid, 4045, "the active memory provider has no management surface")
+
+        provider.initialize(
+            session_id="runtime-memory-management",
+            hermes_home=str(get_hermes_home()),
+            platform="runtime-control",
+            agent_context="management",
+        )
+        initialized = True
+        result = provider.handle_management_request(action, dict(request))
+        if not isinstance(result, dict):
+            return _err(rid, 5000, "memory provider returned an invalid management result")
+        return _ok(rid, result)
+    except (TypeError, ValueError):
+        # Provider exceptions may contain player data, absolute paths, or
+        # credential-bearing values.  The provider's normal typed response is
+        # the only channel allowed to carry detailed management errors.
+        return _err(rid, 4001, "memory provider rejected the management request")
+    except Exception:  # noqa: BLE001
+        return _err(rid, 5000, "memory provider management failed")
+    finally:
+        if initialized and provider is not None:
+            try:
+                provider.shutdown()
+            except Exception:
+                pass
+
+
 @method("skills.manage")
 def _(rid, params: dict) -> dict:
     action, query = params.get("action", "list"), params.get("query", "")
