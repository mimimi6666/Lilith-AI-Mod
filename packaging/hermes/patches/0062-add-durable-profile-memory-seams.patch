@@ -0,0 +1,158 @@
+"""Generic, profile-scoped memory-provider management RPC contract."""
+
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+from tui_gateway import server
+
+
+class _ManagedProvider(MemoryProvider):
+    def __init__(self, *, failure: Exception | None = None) -> None:
+        self.initialized: dict | None = None
+        self.calls: list[tuple[str, dict]] = []
+        self.shutdown_called = False
+        self.failure = failure
+
+    @property
+    def name(self) -> str:
+        return "managed-test"
+
+    def is_available(self) -> bool:
+        return True
+
+    def initialize(self, session_id: str, **kwargs) -> None:
+        self.initialized = {"session_id": session_id, **kwargs}
+
+    def get_tool_schemas(self) -> list[dict]:
+        return []
+
+    def handle_management_request(self, action: str, request: dict) -> dict:
+        self.calls.append((action, request))
+        if self.failure is not None:
+            raise self.failure
+        return {"schema_version": 1, "action": action, "request": request}
+
+    def shutdown(self) -> None:
+        self.shutdown_called = True
+
+
+def _call(params: dict) -> dict:
+    return server.handle_request(
+        {
+            "jsonrpc": "2.0",
+            "id": "memory-1",
+            "method": "memory.provider.manage",
+            "params": params,
+        }
+    )
+
+
+def test_management_rpc_uses_active_provider_in_non_review_context(monkeypatch, tmp_path):
+    provider = _ManagedProvider()
+    monkeypatch.setattr("plugins.memory._get_active_memory_provider", lambda: provider.name)
+    monkeypatch.setattr(
+        "plugins.memory.load_memory_provider",
+        lambda name, register_skills=False: provider,
+    )
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: Path(tmp_path))
+
+    response = _call(
+        {
+            "action": "catalog",
+            "request": {"limit": 20},
+        }
+    )
+
+    assert response["result"] == {
+        "schema_version": 1,
+        "action": "catalog",
+        "request": {"limit": 20},
+    }
+    assert provider.initialized == {
+        "session_id": "runtime-memory-management",
+        "hermes_home": str(tmp_path),
+        "platform": "runtime-control",
+        "agent_context": "management",
+    }
+    assert provider.calls == [("catalog", {"limit": 20})]
+    assert provider.shutdown_called is True
+
+
+def test_management_rpc_rejects_unshaped_request_before_loading_provider(monkeypatch):
+    loaded = []
+    monkeypatch.setattr(
+        "plugins.memory.load_memory_provider",
+        lambda *args, **kwargs: loaded.append((args, kwargs)),
+    )
+
+    response = _call({"action": "catalog", "request": {}, "extra": True})
+
+    assert response["error"]["code"] == 4001
+    assert loaded == []
+
+
+def test_management_rpc_rejects_non_ascii_action_before_loading_provider(monkeypatch):
+    loaded = []
+    monkeypatch.setattr(
+        "plugins.memory.load_memory_provider",
+        lambda *args, **kwargs: loaded.append((args, kwargs)),
+    )
+
+    for action in ("catalóg", "catalog١", "сatalog"):
+        response = _call({"action": action, "request": {}})
+        assert response["error"] == {
+            "code": 4001,
+            "message": "memory management request is invalid",
+        }
+
+    assert loaded == []
+
+
+def test_management_rpc_reports_missing_external_provider(monkeypatch):
+    monkeypatch.setattr("plugins.memory._get_active_memory_provider", lambda: "")
+
+    response = _call({"action": "catalog", "request": {}})
+
+    assert response["error"]["code"] == 4045
+
+
+def test_management_rpc_shuts_provider_down_after_failure(monkeypatch, tmp_path):
+    provider = _ManagedProvider(
+        failure=RuntimeError(
+            r"provider-fault at C:\Users\player\private-memory secret-token"
+        )
+    )
+    monkeypatch.setattr("plugins.memory._get_active_memory_provider", lambda: provider.name)
+    monkeypatch.setattr(
+        "plugins.memory.load_memory_provider",
+        lambda name, register_skills=False: provider,
+    )
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: Path(tmp_path))
+
+    response = _call({"action": "catalog", "request": {}})
+
+    assert response["error"]["code"] == 5000
+    assert response["error"]["message"] == "memory provider management failed"
+    assert "private-memory" not in response["error"]["message"]
+    assert "secret-token" not in response["error"]["message"]
+    assert provider.shutdown_called is True
+
+
+def test_management_rpc_sanitizes_provider_validation_exception(monkeypatch, tmp_path):
+    provider = _ManagedProvider(
+        failure=ValueError(r"invalid C:\Users\player\profile-memory.sqlite3")
+    )
+    monkeypatch.setattr("plugins.memory._get_active_memory_provider", lambda: provider.name)
+    monkeypatch.setattr(
+        "plugins.memory.load_memory_provider",
+        lambda name, register_skills=False: provider,
+    )
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: Path(tmp_path))
+
+    response = _call({"action": "entry.add", "request": {}})
+
+    assert response["error"] == {
+        "code": 4001,
+        "message": "memory provider rejected the management request",
+    }
+    assert provider.shutdown_called is True
