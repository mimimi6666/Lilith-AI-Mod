+# A separate, host-issued provenance proof for the small set of human input
+# surfaces that may update Lilith's durable relationship/profile memory.  The
+# generic ``TURN_ORIGIN_USER`` bit is intentionally not sufficient: cron,
+# proactive continuations, delegation completions, and other internal work can
+# all be represented by a user-shaped row while driving the normal agent loop.
+PROFILE_MEMORY_HUMAN_ORIGIN_METADATA_KEY = (
+    "hermes_profile_memory_human_origin"
+)
+PROFILE_MEMORY_SUBJECT_ID_METADATA_KEY = "hermes_profile_memory_subject_id"
+PROFILE_MEMORY_LOCAL_OWNER_SUBJECT_ID = "local-owner"
+PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME = "lilith-game"
+PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_RUNTIME = "lilith-runtime"
+PROFILE_MEMORY_HUMAN_ORIGIN_TELEGRAM_PAIRED = "telegram-paired"
+PROFILE_MEMORY_HUMAN_ORIGINS = frozenset(
+    {
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME,
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_RUNTIME,
+        PROFILE_MEMORY_HUMAN_ORIGIN_TELEGRAM_PAIRED,
+    }
+)
+
+
+def canonical_profile_memory_human_origin(value: Any) -> str:
+    """Return an exact host-issued profile-memory input origin or ``""``.
+
+    No normalization is performed.  This value is an internal attestation,
+    not user input, so accepting case/whitespace aliases would only widen the
+    boundary and make accidental synthetic stamping harder to detect.
+    """
+
+    return (
+        value
+        if isinstance(value, str) and value in PROFILE_MEMORY_HUMAN_ORIGINS
+        else ""
+    )
+
+
+def canonical_profile_memory_subject_id(origin: Any, value: Any) -> str:
+    """Return an exact bounded subject for a trusted human origin.
+
+    Local Lilith surfaces share one fixed owner identity.  Telegram subjects
+    are opaque transport identifiers issued by the paired adapter: retain the
+    exact bytes, but reject empty, non-ASCII, whitespace/control, or unbounded
+    values so they remain safe persisted metadata and routing keys.
+    """
+
+    canonical_origin = canonical_profile_memory_human_origin(origin)
+    if canonical_origin in {
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME,
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_RUNTIME,
+    }:
+        return value if value == PROFILE_MEMORY_LOCAL_OWNER_SUBJECT_ID else ""
+    if canonical_origin != PROFILE_MEMORY_HUMAN_ORIGIN_TELEGRAM_PAIRED:
+        return ""
+    if not isinstance(value, str) or not 1 <= len(value) <= 128:
+        return ""
+    if any(ord(char) < 0x21 or ord(char) > 0x7E for char in value):
+        return ""
+    return value
+
+
+def profile_memory_origin_matches_platform(origin: Any, platform: Any) -> bool:
+    """Validate the persisted attestation against the owning agent surface."""
+
+    canonical_origin = canonical_profile_memory_human_origin(origin)
+    if not canonical_origin or not isinstance(platform, str):
+        return False
+    expected_platform = {
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME: "lilith-game",
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_RUNTIME: "lilith-runtime",
+        PROFILE_MEMORY_HUMAN_ORIGIN_TELEGRAM_PAIRED: "telegram",
+    }[canonical_origin]
+    return platform == expected_platform
+
 MESSAGE_KINDS = frozenset({"interim", "primary", "tool", "tool_call", "user"})
 
 _CANONICAL_ID_RE = re.compile(r"^[0-9a-f]{32}$")
