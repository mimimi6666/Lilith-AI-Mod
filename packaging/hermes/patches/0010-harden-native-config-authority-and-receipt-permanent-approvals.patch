+        or value["schema_version"] != 1
+        or type(value.get("sequence")) is not int
+        or value["sequence"] <= 0
+        or value["sequence"] > _NATIVE_RECEIPT_SEQUENCE_MAX
+    ):
+        raise IdentityPolicyError("native config receipt metadata was invalid")
+    for label in (
+        "canonical_base_sha256",
+        "previous_config_sha256",
+        "config_sha256",
+        "identity_fingerprint_sha256",
+        "soul_sha256",
+        "personality_sha256",
+    ):
+        _native_receipt_digest(value.get(label), label)
+    if source == _NATIVE_RECEIPT_SOURCE_APPROVAL_ALWAYS:
+        _native_receipt_digest(value.get("operation_nonce"), "operation_nonce")
+    if value.get("approval_mode") not in {"manual", "smart", "off"}:
+        raise IdentityPolicyError("native config receipt approval mode was invalid")
+    _validated_native_receipt_toolsets(
+        value.get("enabled_toolsets"),
+        require_list=True,
+    )
+    return value
+
+
+def capture_native_config_receipt_base(
+    expected_config_sha256: str,
+    *,
+    approval_mode: str,
+    enabled_toolsets: Sequence[str],
+) -> NativeConfigReceiptBase:
+    """Capture the Runtime receipt state that an Always transition must extend."""
+
+    require_native_runtime_parent_authority()
+    expected = _native_receipt_digest(
+        expected_config_sha256, "expected config digest"
+    )
+    if approval_mode not in {"manual", "smart", "off"}:
+        raise IdentityPolicyError("native approval mode snapshot was invalid")
+    try:
+        canonical_toolsets = _validated_native_receipt_toolsets(
+            enabled_toolsets,
+            require_list=False,
+        )
+    except IdentityPolicyError as exc:
+        raise IdentityPolicyError(
+            "native toolset snapshot was not canonical"
+        ) from exc
+    snapshot = capture_strict_authority_snapshot()
+    if snapshot is None or not hmac.compare_digest(snapshot.config_sha256, expected):
+        raise IdentityPolicyError(
+            "native approval receipt base did not match strict config"
+        )
+    preflight = preflight_aia_agent_identity(request_overrides={})
+    receipt = next(
+        item
+        for item in snapshot.files
+        if item.label == "runtime/native-config-receipt.v1.json"
+    )
+    if not receipt.existed:
+        return NativeConfigReceiptBase(
+            sequence=0,
+            canonical_base_sha256=expected,
+            config_sha256=expected,
+            identity_fingerprint_sha256=preflight.policy.fingerprint,
+            soul_sha256=snapshot.soul_sha256,
+            personality_sha256=snapshot.personality_sha256,
+            approval_mode=approval_mode,
+            enabled_toolsets=canonical_toolsets,
+        )
+    if receipt.raw is None:
+        raise IdentityPolicyError("native config receipt bytes were unavailable")
+    value = _decode_native_config_receipt(receipt.raw)
+    expected_pins = {
+        "config_sha256": expected,
+        "identity_fingerprint_sha256": preflight.policy.fingerprint,
+        "soul_sha256": snapshot.soul_sha256,
+        "personality_sha256": snapshot.personality_sha256,
+    }
+    for key, wanted in expected_pins.items():
+        if not hmac.compare_digest(str(value.get(key) or ""), wanted):
+            raise IdentityPolicyError(
+                f"native config receipt did not match strict {key}"
+            )
+    if (
+        value.get("approval_mode") != approval_mode
+        or tuple(value.get("enabled_toolsets") or ()) != canonical_toolsets
+    ):
+        raise IdentityPolicyError(
+            "native config receipt did not match the live native policy"
+        )
+    return NativeConfigReceiptBase(
+        sequence=int(value["sequence"]),
+        canonical_base_sha256=str(value["canonical_base_sha256"]),
+        config_sha256=str(value["config_sha256"]),
+        identity_fingerprint_sha256=str(value["identity_fingerprint_sha256"]),
+        soul_sha256=str(value["soul_sha256"]),
+        personality_sha256=str(value["personality_sha256"]),
+        approval_mode=str(value["approval_mode"]),
+        enabled_toolsets=tuple(value["enabled_toolsets"]),
+    )
+
+
+def verify_native_approval_commit_receipt(
+    base: NativeConfigReceiptBase,
+    *,
+    previous_config_sha256: str,
+    config_sha256: str,
+    commit_nonce: str,
+    receipt_sha256: str,
+) -> None:
+    """Verify Runtime's exact durable approval receipt before releasing a tool."""
+
+    require_native_runtime_parent_authority()
+    previous = _native_receipt_digest(
+        previous_config_sha256, "previous config digest"
+    )
+    current = _native_receipt_digest(config_sha256, "config digest")
+    nonce = _native_receipt_digest(commit_nonce, "operation_nonce")
+    raw_digest = _native_receipt_digest(receipt_sha256, "raw receipt digest")
+    if not hmac.compare_digest(base.config_sha256, previous):
+        raise IdentityPolicyError("native approval receipt base digest changed")
+
+    snapshot = capture_strict_authority_snapshot()
+    if snapshot is None or not hmac.compare_digest(snapshot.config_sha256, current):
+        raise IdentityPolicyError("native approval receipt live config changed")
+    receipt = next(
+        item
+        for item in snapshot.files
+        if item.label == "runtime/native-config-receipt.v1.json"
+    )
+    if not receipt.existed or receipt.raw is None:
+        raise IdentityPolicyError("native approval durable receipt was missing")
+    if not hmac.compare_digest(hashlib.sha256(receipt.raw).hexdigest(), raw_digest):
+        raise IdentityPolicyError("native approval durable receipt hash mismatched")
+    value = _decode_native_config_receipt(receipt.raw)
+    expected: Dict[str, Any] = {
+        "schema_version": 1,
+        "source": _NATIVE_RECEIPT_SOURCE_APPROVAL_ALWAYS,
+        "sequence": base.sequence + 1,
+        "canonical_base_sha256": base.canonical_base_sha256,
+        "previous_config_sha256": previous,
+        "config_sha256": current,
+        "operation_nonce": nonce,
+        "identity_fingerprint_sha256": base.identity_fingerprint_sha256,
+        "soul_sha256": base.soul_sha256,
+        "personality_sha256": base.personality_sha256,
+        "approval_mode": base.approval_mode,
+        "enabled_toolsets": list(base.enabled_toolsets),
+    }
+    if value != expected:
+        raise IdentityPolicyError(
+            "native approval durable receipt did not match the prepared transition"
+        )
+    preflight = preflight_aia_agent_identity(request_overrides={})
+    if (
+        not hmac.compare_digest(preflight.policy.fingerprint, base.identity_fingerprint_sha256)
+        or not hmac.compare_digest(preflight.soul_sha256, base.soul_sha256)
+        or not hmac.compare_digest(preflight.personality_sha256, base.personality_sha256)
+    ):
+        raise IdentityPolicyError(
+            "native approval durable receipt no longer matched live identity pins"
+        )
+
+
+def _authority_parent_matches(snapshot: StrictAuthorityFileSnapshot) -> bool:
+    try:
+        realpath, device, inode = _strict_authority_parent_identity(
+            snapshot.path, snapshot.label
+        )
+    except IdentityPolicyError:
+        return False
+    if realpath != snapshot.parent_realpath:
+        return False
+    if snapshot.parent_dev and device and snapshot.parent_dev != device:
+        return False
+    if snapshot.parent_ino and inode and snapshot.parent_ino != inode:
+        return False
+    return True
+
+
+def _authority_leaf_matches(snapshot: StrictAuthorityFileSnapshot) -> bool:
+    if not _authority_parent_matches(snapshot):
+        return False
+    try:
+        existed, raw, sha256, _ = _read_strict_authority_leaf(
+            snapshot.path, snapshot.label
+        )
+    except IdentityPolicyError:
+        return False
+    if existed != snapshot.existed:
+        return False
+    if not existed:
+        return True
+    return bool(
+        raw is not None
+        and snapshot.raw is not None
+        and hmac.compare_digest(raw, snapshot.raw)
+        and hmac.compare_digest(sha256, snapshot.sha256)
+    )
+
+
+def _fsync_directory(path: Path) -> None:
+    if os.name != "posix":
+        return
+    flags = os.O_RDONLY | int(getattr(os, "O_DIRECTORY", 0) or 0)
+    descriptor = os.open(str(path), flags)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def _atomic_restore_strict_authority_leaf(
+    snapshot: StrictAuthorityFileSnapshot,
+) -> None:
+    if not _authority_parent_matches(snapshot):
+        raise IdentityPolicyError(
+            f"strict authority parent identity changed before rollback: {snapshot.label}"
+        )
+    try:
+        current = snapshot.path.lstat()
+    except FileNotFoundError:
+        current = None
+    except Exception as exc:
+        raise IdentityPolicyError(
+            f"strict authority target could not be inspected for rollback: {snapshot.label}"
+        ) from exc
+    if current is not None and (
+        _is_reparse_stat(current) or not stat.S_ISREG(current.st_mode)
+    ):
+        raise IdentityPolicyError(
+            f"strict authority rollback refuses a reparse/non-file target: {snapshot.label}"
+        )
+
+    if not snapshot.existed:
+        if current is not None:
+            snapshot.path.unlink()
+            _fsync_directory(snapshot.path.parent)
+        return
+    if snapshot.raw is None:
+        raise IdentityPolicyError(
+            f"strict authority rollback is missing captured bytes: {snapshot.label}"
+        )
+
+    descriptor, temporary = tempfile.mkstemp(
+        dir=str(snapshot.path.parent),
+        prefix=f".{snapshot.path.name}.authority-rollback-",
+        suffix=".tmp",
+    )
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            if hasattr(os, "fchmod"):
+                os.fchmod(handle.fileno(), snapshot.mode)
+            handle.write(snapshot.raw)
+            handle.flush()
+            os.fsync(handle.fileno())
+        if not _authority_parent_matches(snapshot):
+            raise IdentityPolicyError(
+                f"strict authority parent changed during rollback: {snapshot.label}"
+            )
+        from utils import atomic_replace
+
+        restored_path = Path(atomic_replace(temporary, snapshot.path))
+        temporary = ""
+        try:
+            os.chmod(restored_path, snapshot.mode)
+        except OSError:
+            pass
+        _fsync_directory(snapshot.path.parent)
+    finally:
+        if temporary:
+            try:
+                os.unlink(temporary)
+            except OSError:
+                pass
+
+
+def _invalidate_native_config_caches(config_path: Path) -> None:
+    try:
+        from hermes_cli import config as config_module
+
+        config_module._RAW_CONFIG_CACHE.pop(str(config_path), None)
+        config_module._LAST_EXPANDED_CONFIG_BY_PATH.pop(str(config_path), None)
+    except Exception:
+        # Re-attestation below still fails closed if any stale cache could
+        # affect strict identity; these caches are an optimization only.
+        pass
+
+
+def verify_and_recover_strict_authority_snapshot(
+    snapshot: Optional[StrictAuthoritySnapshot],
+    *,
+    on_drift=None,
+) -> Optional[StrictAuthorityRecovery]:
+    """Postflight exact-byte verification, compensation, and sticky latch.
+
+    ``None`` means no drift.  Any returned result means authority changed (or
+    could not be re-attested), so the process remains quarantined even when an
+    exact rollback succeeds.  This prevents a transient encoded/interpreter
+    bypass from making a newly written config effective on a later dispatch.
+    """
+
+    if snapshot is None:
+        return None
+    drifted = [item.label for item in snapshot.files if not _authority_leaf_matches(item)]
+    if not drifted:
+        try:
+            postflight = preflight_aia_agent_identity(request_overrides={})
+            if (
+                not hmac.compare_digest(postflight.config_sha256, snapshot.config_sha256)
+                or not hmac.compare_digest(postflight.soul_sha256, snapshot.soul_sha256)
+                or not hmac.compare_digest(
+                    postflight.personality_sha256,
+                    snapshot.personality_sha256,
+                )
+            ):
+                drifted.append("identity-preflight")
+        except Exception:
+            drifted.append("identity-preflight")
+    if not drifted:
+        return None
+
+    latch_native_authority_quarantine(
+        "terminal postflight detected native identity authority drift",
+        drifted_labels=drifted,
+    )
+    try:
+        if on_drift is not None:
+            on_drift(tuple(sorted(set(drifted))))
+        for item in snapshot.files:
+            if not _authority_leaf_matches(item):
+                _atomic_restore_strict_authority_leaf(item)
+        config_item = next(
+            item for item in snapshot.files if item.label == "config.yaml"
+        )
+        _invalidate_native_config_caches(config_item.path)
+
+        for item in snapshot.files:
+            if not _authority_leaf_matches(item):
+                raise IdentityPolicyError(
+                    f"strict authority rollback did not restore exact bytes: {item.label}"
+                )
+        postflight = preflight_aia_agent_identity(request_overrides={})
+        if (
+            not hmac.compare_digest(postflight.config_sha256, snapshot.config_sha256)
+            or not hmac.compare_digest(postflight.soul_sha256, snapshot.soul_sha256)
+            or not hmac.compare_digest(
+                postflight.personality_sha256,
+                snapshot.personality_sha256,
+            )
+        ):
+            raise IdentityPolicyError(
+                "strict authority rollback did not restore identity preflight hashes"
+            )
+        latch_native_authority_quarantine(
+            "terminal authority drift was exactly rolled back; restart still required",
+            drifted_labels=drifted,
+            recovery_verified=True,
+        )
+        return StrictAuthorityRecovery(
+            drifted_labels=tuple(sorted(set(drifted))),
+            restored=True,
+        )
+    except BaseException as exc:
+        latch_native_authority_quarantine(
+            "terminal authority drift rollback could not be verified",
+            drifted_labels=drifted,
+        )
+        return StrictAuthorityRecovery(
+            drifted_labels=tuple(sorted(set(drifted))),
+            restored=False,
+            recovery_error=f"{type(exc).__name__}: {exc}",
+        )
+
+
 def prepare_host_config_digest_rotation() -> Optional[str]:
     """Attest the current strict config before an authorized native rewrite.
 
