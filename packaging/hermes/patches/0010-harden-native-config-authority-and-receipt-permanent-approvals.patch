+def test_parallel_gateway_notifications_publish_in_queue_fifo(monkeypatch):
+    import agent.identity_policy as identity
+    import tools.approval as approval
+
+    session_key = "publication-fifo"
+    identity._reset_native_authority_quarantine_for_tests()
+    monkeypatch.delenv("HERMES_IDENTITY_REQUIRED", raising=False)
+    monkeypatch.setattr(approval, "_get_approval_timeout", lambda: 2.0)
+    monkeypatch.setattr(approval, "is_interrupted", lambda: False)
+    with approval._lock:
+        approval._gateway_queues.pop(session_key, None)
+
+    original_publish = approval._publish_gateway_approval_queue
+    first_appended = threading.Event()
+    release_first = threading.Event()
+
+    def delayed_publish(key):
+        if threading.current_thread().name == "approval-A":
+            with approval._lock:
+                queue = approval._gateway_queues.get(key, ())
+                assert queue and queue[0].data["command"] == "A"
+            first_appended.set()
+            assert release_first.wait(2)
+        return original_publish(key)
+
+    monkeypatch.setattr(
+        approval, "_publish_gateway_approval_queue", delayed_publish
+    )
+    notifications = []
+    results = {}
+
+    def run(label):
+        results[label] = approval._await_gateway_decision(
+            session_key,
+            lambda payload, owner=label: notifications.append(
+                (owner, payload["command"])
+            ),
+            {
+                "command": label,
+                "description": label,
+                "pattern_key": f"dangerous:{label}",
+                "pattern_keys": [f"dangerous:{label}"],
+            },
+        )
+
+    first = threading.Thread(target=lambda: run("A"), name="approval-A")
+    second = threading.Thread(target=lambda: run("B"), name="approval-B")
+    try:
+        first.start()
+        assert first_appended.wait(1)
+        second.start()
+        deadline = time.monotonic() + 1
+        while len(notifications) < 2:
+            assert time.monotonic() < deadline
+            time.sleep(0.005)
+
+        assert notifications == [("A", "A"), ("B", "B")]
+        assert approval.resolve_gateway_approval(session_key, "once") == 1
+        release_first.set()
+        first.join(1)
+        assert results["A"]["choice"] == "once"
+        assert second.is_alive()
+        assert "B" not in results
+        assert approval.resolve_gateway_approval(session_key, "deny") == 1
+        second.join(1)
+        assert results["B"]["choice"] == "deny"
+    finally:
+        release_first.set()
+        approval.resolve_gateway_approval(
+            session_key, "deny", resolve_all=True
+        )
+        first.join(1)
+        second.join(1)
+        with approval._lock:
+            approval._gateway_queues.pop(session_key, None)
+        identity._reset_native_authority_quarantine_for_tests()
+
