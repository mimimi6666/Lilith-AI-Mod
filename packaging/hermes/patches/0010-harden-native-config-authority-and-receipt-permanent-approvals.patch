+            f"not be verified: {type(exc).__name__}: {exc}"
+        )
+    if not label:
+        return None
+    return (
+        f"Refusing to modify strict identity authority file {label}: {filepath}\n"
+        "This host-owned file cannot be written, patched, moved, deleted, or "
