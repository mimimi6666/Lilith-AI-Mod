+    if not identity_lock_required_by_host():
+        return None
+    preflight = preflight_aia_agent_identity(request_overrides={})
+    raw_home = str(os.environ.get("HERMES_HOME") or "").strip()
+    profile_home = Path(raw_home)
+    if not raw_home or not profile_home.is_absolute():
+        raise IdentityPolicyError(
+            "HERMES_HOME must be absolute for strict authority capture"
+        )
+
+    files = tuple(
+        _capture_strict_authority_file(profile_home / relative, label)
+        for relative, label in _STRICT_AUTHORITY_RELATIVE_PATHS
+    )
