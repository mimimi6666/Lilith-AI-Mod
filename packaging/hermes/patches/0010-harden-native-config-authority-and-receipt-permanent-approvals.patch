+def _is_reparse_stat(metadata: os.stat_result) -> bool:
+    attributes = int(getattr(metadata, "st_file_attributes", 0) or 0)
+    reparse_flag = int(getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0) or 0)
+    return stat.S_ISLNK(metadata.st_mode) or bool(
+        reparse_flag and attributes & reparse_flag
+    )
+
+
+def _strict_authority_parent_identity(path: Path, label: str) -> tuple[str, int, int]:
+    parent = path.parent
+    try:
+        metadata = parent.lstat()
+    except Exception as exc:
+        raise IdentityPolicyError(
+            f"strict authority parent is unavailable for {label}"
+        ) from exc
+    if _is_reparse_stat(metadata) or not stat.S_ISDIR(metadata.st_mode):
+        raise IdentityPolicyError(
+            f"strict authority parent must be a non-reparse directory for {label}"
+        )
+    return (
+        os.path.normcase(os.path.realpath(str(parent))),
+        int(getattr(metadata, "st_dev", 0) or 0),
+        int(getattr(metadata, "st_ino", 0) or 0),
+    )
+
+
+def _read_strict_authority_leaf(
+    path: Path,
+    label: str,
+) -> tuple[bool, Optional[bytes], str, int]:
+    """Read one exact regular leaf without accepting a symlink/reparse hop."""
+
+    try:
+        before = path.lstat()
+    except FileNotFoundError:
+        return False, None, "", 0
+    except Exception as exc:
+        raise IdentityPolicyError(
+            f"strict authority target could not be inspected: {label}"
+        ) from exc
+    if _is_reparse_stat(before) or not stat.S_ISREG(before.st_mode):
+        raise IdentityPolicyError(
+            f"strict authority target must be a non-reparse regular file: {label}"
+        )
+    try:
+        raw = path.read_bytes()
+        after = path.lstat()
+    except Exception as exc:
+        raise IdentityPolicyError(
+            f"strict authority target could not be read: {label}"
+        ) from exc
+    if _is_reparse_stat(after) or not stat.S_ISREG(after.st_mode):
+        raise IdentityPolicyError(
+            f"strict authority target changed topology while read: {label}"
+        )
+    before_identity = (
+        int(getattr(before, "st_dev", 0) or 0),
+        int(getattr(before, "st_ino", 0) or 0),
+    )
+    after_identity = (
+        int(getattr(after, "st_dev", 0) or 0),
+        int(getattr(after, "st_ino", 0) or 0),
+    )
+    if before_identity != after_identity:
+        raise IdentityPolicyError(
+            f"strict authority target changed identity while read: {label}"
+        )
+    return (
+        True,
+        raw,
+        hashlib.sha256(raw).hexdigest(),
+        stat.S_IMODE(before.st_mode),
+    )
