+def _strict_authority_targets() -> tuple[tuple[str, str, str], ...]:
+    """Return ``(lexical, real, label)`` triples for the four authority files."""
+    home = _strict_authority_home()
+    if home is None:
+        return ()
+    rows = []
+    for relative, label in _STRICT_AUTHORITY_RELATIVE_PATHS:
+        lexical = os.path.abspath(os.path.join(home, relative))
+        rows.append((lexical, os.path.realpath(lexical), label))
+    return tuple(rows)
+
+
+def _strict_path_key(path: str) -> str:
+    """Host-native comparison key (case-folding only where the OS does)."""
+    return os.path.normcase(os.path.normpath(os.path.abspath(path)))
+
+
+def strict_identity_authority_path_label(
+    path: str,
+    *,
+    cwd: Optional[str] = None,
+    include_ancestor: bool = False,
+) -> Optional[str]:
+    """Identify an exact strict authority target reached by *path*.
+
+    Both the lexical location and realpath are checked, so relative paths,
+    ``..`` traversal, symlink aliases, and native Windows case variants all
+    resolve to the same host authority.  ``include_ancestor`` is reserved for
+    delete/move source operands: removing ``HERMES_HOME/runtime`` also removes
+    the receipt even though the operand names its parent rather than the leaf.
+    """
+    targets = _strict_authority_targets()
+    if not targets:
+        return None
+    raw = str(path or "").strip().strip("\"'")
+    if not raw:
+        return None
+    if not os.path.isabs(raw):
+        base = str(cwd or os.getcwd())
+        if not os.path.isabs(base):
+            base = os.path.abspath(base)
+        raw = os.path.join(base, raw)
+    lexical = os.path.abspath(os.path.normpath(raw))
+    real = os.path.realpath(lexical)
+    lexical_key = _strict_path_key(lexical)
+    real_key = _strict_path_key(real)
+
+    for target_lexical, target_real, label in targets:
+        target_keys = {
+            _strict_path_key(target_lexical),
+            _strict_path_key(target_real),
+        }
+        if lexical_key in target_keys or real_key in target_keys:
+            return label
+        try:
+            if os.path.exists(lexical) and os.path.exists(target_lexical):
+                if os.path.samefile(lexical, target_lexical):
+                    return label
+        except OSError:
+            pass
+        if include_ancestor:
+            for candidate_key in (lexical_key, real_key):
+                for target_key in target_keys:
+                    try:
