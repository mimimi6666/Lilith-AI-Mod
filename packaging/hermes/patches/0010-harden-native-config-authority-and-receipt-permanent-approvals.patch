+def _strict_authority_home() -> Optional[str]:
+    """Return the explicit host authority root, or ``None`` for generic Hermes.
+
+    The trusted parent marker is intentionally the only feature gate.  A
+    profile-level setting cannot opt into this host boundary and a malformed
+    marker/path fails closed instead of silently restoring generic behavior.
+    """
+    from agent.identity_policy import (
+        IdentityPolicyError,
+        identity_lock_required_by_host,
+    )
+
+    if not identity_lock_required_by_host():
+        return None
+    raw_home = str(os.environ.get("HERMES_HOME") or "").strip()
+    if not raw_home or not os.path.isabs(raw_home):
+        raise IdentityPolicyError(
+            "HERMES_HOME must be absolute when the host requires an identity"
+        )
+    return os.path.normpath(raw_home)
