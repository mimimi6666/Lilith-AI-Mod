+def _check_strict_identity_authority_path(
+    filepath: str,
+    task_id: str = "default",
+) -> str | None:
+    """Hard-deny exact host-owned identity authority files in strict mode.
+
+    This is intentionally separate from the generic sensitive/protected-file
+    gates: it is enabled only by the trusted host marker and never enters an
+    approval flow.  Resolve through the file tool's task cwd first, then let
+    the shared authority matcher compare lexical and real paths so aliases,
+    symlinks, relative traversal, and native Windows case variants converge.
+    """
+    if _uses_container_paths(task_id):
+        return None
+    try:
+        from tools.approval import strict_identity_authority_path_label
+
+        resolved = str(_resolve_path_for_task(filepath, task_id))
+        label = strict_identity_authority_path_label(resolved)
+    except Exception as exc:
+        # A malformed required-host policy must not silently downgrade into the
+        # generic approval path.  Generic hosts return None without raising.
+        if os.environ.get("HERMES_IDENTITY_REQUIRED") is None:
+            return None
+        return (
