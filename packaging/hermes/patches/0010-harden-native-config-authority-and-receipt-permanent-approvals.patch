+    # profile.  Expand them as ordinary paths, then exact matching below
+    # decides whether they really equal the strict HERMES_HOME.
+    user_home = str(os.environ.get("HOME") or os.path.expanduser("~"))
+    expanded = re.sub(
+        r"(?i)(?:\$env:HOME|\$\{HOME\}|\$HOME|%HOME%)",
