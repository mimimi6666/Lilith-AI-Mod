+def capture_strict_authority_snapshot() -> Optional[StrictAuthoritySnapshot]:
+    """Attest and capture all strict authority bytes before host execution.
+
+    Generic profiles return ``None``.  Strict capture reuses the canonical
+    identity preflight so config, SOUL, and composed personality must match
+    their trusted pins before a terminal child can be launched.
+    """
