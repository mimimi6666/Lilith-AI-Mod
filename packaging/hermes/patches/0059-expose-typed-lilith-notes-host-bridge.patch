+
+
+@pytest.mark.parametrize(
+    "arguments",
+    [
+        {"action": "execute", "command": "anything"},
+        {"action": "list", "path": "C:/"},
+        {"action": "list", "include_archived": False},
+        {"action": "get", "memo_id": True},
+        {"action": "create_todo", "text": "x", "date": "2026-02-31"},
