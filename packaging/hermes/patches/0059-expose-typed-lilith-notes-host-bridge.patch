+
+def test_update_leaves_reminder_countdown_compatibility_to_game_state():
+    arguments = {
+        "action": "update",
+        "memo_id": 1,
+        "expected_updated_time": "2026-09-01T08:01:00+08:00",
+        "remind": True,
+        "countdown": True,
+    }
+    assert bridge.normalize_notes_arguments(arguments) == arguments
+
+
+def test_request_event_requires_a_canonical_turn(monkeypatch):
+    transport = CaptureTransport()
+    session = {
+        "transport": transport,
+        "running": True,
+        "inflight_turn": {"turn_id": TURN_ID},
+    }
+    server._sessions[SESSION_ID] = session
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda name, default="": SESSION_ID,
+    )
+    transport_token = bind_transport(transport)
+    session_token = server._current_runtime_session_record.set(session)
+    try:
+        with pytest.raises(bridge.LilithHostProtocolError):
+            bridge.request_notes({"action": "list"}, timeout_seconds=0.01)
+    finally:
+        server._current_runtime_session_record.reset(session_token)
+        reset_transport(transport_token)
+    assert transport.frames == []
+
+
+def test_lilith_host_request_is_declared_turn_required():
+    assert "lilith.host.request" in server._TURN_REQUIRED_EVENT_TYPES
+    assert "lilith.host.complete" not in server._LONG_HANDLERS
