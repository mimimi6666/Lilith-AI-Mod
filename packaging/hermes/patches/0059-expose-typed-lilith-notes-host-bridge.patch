@@ -0,0 +1,504 @@
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from tui_gateway import lilith_host_bridge as bridge
+from tui_gateway import server
+from tui_gateway.transport import bind_transport, reset_transport
+
+
+SESSION_ID = "lilith-notes-session"
+TURN_ID = "1" * 32
+
+
+class CaptureTransport:
+    def __init__(self) -> None:
+        self.frames: list[dict] = []
+        self.written = threading.Event()
+
+    def write(self, obj: dict) -> bool:
+        self.frames.append(obj)
+        self.written.set()
+        return True
+
+    def close(self) -> None:
+        return None
+
+
+def _result(operation_id: str, *, text: str = "buy milk") -> dict:
+    return {
+        "version": 1,
+        "kind": "memo.result",
+        "operation_id": operation_id,
+        "succeeded": True,
+        "code": "ok",
+        "items": [
+            {
+                "memo_id": 7,
+                "text": text,
+                "memo_kind": "todo",
+                "date": "2026-09-01",
+                "created_time": "2026-09-01T08:00:00+08:00",
+                "updated_time": "2026-09-01T08:01:00+08:00",
+                "remind": True,
+                "remind_hour": 9,
+                "remind_minute": 30,
+                "repeat": "none",
+                "done": False,
+                "done_date": "",
+                "pinned": False,
+                "last_reminded_date": "",
+                "scratch_tier": "none",
+                "countdown": False,
+            }
+        ],
+    }
+
+
+@pytest.fixture(autouse=True)
+def _isolate_bridge_state():
+    previous_sessions = dict(server._sessions)
+    bridge._reset_pending_for_tests()
+    try:
+        yield
+    finally:
+        bridge._reset_pending_for_tests()
+        server._sessions.clear()
+        server._sessions.update(previous_sessions)
+
+
+def _start_request(monkeypatch, arguments: dict, *, timeout: float = 1.0):
+    transport = CaptureTransport()
+    session = {
+        "transport": transport,
+        "running": True,
+        "inflight_turn": {"turn_id": TURN_ID},
+    }
+    server._sessions[SESSION_ID] = session
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda name, default="": SESSION_ID
+        if name == "HERMES_UI_SESSION_ID"
+        else default,
+    )
+    outcome: dict = {}
+
+    def run() -> None:
+        transport_token = bind_transport(transport)
+        session_token = server._current_runtime_session_record.set(session)
+        turn_token = server._current_turn_event_id.set(TURN_ID)
+        try:
+            outcome["result"] = bridge.request_notes(
+                arguments,
+                timeout_seconds=timeout,
+            )
+        except BaseException as exc:  # captured for assertions in the test thread
+            outcome["error"] = exc
+        finally:
+            server._current_turn_event_id.reset(turn_token)
+            server._current_runtime_session_record.reset(session_token)
+            reset_transport(transport_token)
+
+    worker = threading.Thread(target=run)
+    worker.start()
+    assert transport.written.wait(1.0)
+    return worker, transport, session, outcome
+
+
+def _complete(transport: CaptureTransport, event: dict, result: dict) -> dict:
+    params = event["params"]
+    return server.dispatch(
+        {
+            "jsonrpc": "2.0",
+            "id": "complete-1",
+            "method": "lilith.host.complete",
+            "params": {
+                "session_id": params["session_id"],
+                "turn_id": params["turn_id"],
+                "result": result,
+            },
+        },
+        transport=transport,
+    )
+
+
+def test_request_event_is_exact_turn_scoped_and_completion_round_trips(monkeypatch):
+    arguments = {
+        "action": "list",
+        "memo_kind": "todo",
+        "filter": "pending",
+        "limit": 25,
+    }
+    worker, transport, _session, outcome = _start_request(monkeypatch, arguments)
+
+    assert len(transport.frames) == 1
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    assert event == {
+        "jsonrpc": "2.0",
+        "method": "event",
+        "params": {
+            "type": "lilith.host.request",
+            "session_id": SESSION_ID,
+            "turn_id": TURN_ID,
+            "payload": {
+                "version": 1,
+                "kind": "lilith.notes.host-request",
+                "operation_id": operation_id,
+                "arguments": arguments,
+            },
+        },
+    }
+    assert len(operation_id) == 32 and operation_id == operation_id.lower()
+
+    completion_result = _result(operation_id)
+    response = _complete(transport, event, completion_result)
+    assert response == {
+        "jsonrpc": "2.0",
+        "id": "complete-1",
+        "result": {"accepted": True, "operation_id": operation_id},
+    }
+    worker.join(1.0)
+    assert not worker.is_alive()
+    assert outcome == {"result": completion_result}
+    assert bridge._pending_count() == 0
+    assert bridge._completion_receipt_count() == 1
+
+
+def test_exact_completion_retry_is_idempotently_accepted(monkeypatch):
+    worker, transport, _session, outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    result = _result(operation_id)
+
+    assert _complete(transport, event, result)["result"]["accepted"] is True
+    worker.join(1.0)
+    assert outcome == {"result": result}
+
+    duplicate = _complete(transport, event, result)
+    assert duplicate["result"] == {
+        "accepted": True,
+        "operation_id": operation_id,
+    }
+    assert bridge._completion_receipt_count() == 1
+
+
+def test_completion_receipt_rejects_any_authority_or_result_difference(monkeypatch):
+    worker, transport, _session, _outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    result = _result(operation_id)
+    assert _complete(transport, event, result)["result"]["accepted"] is True
+    worker.join(1.0)
+
+    wrong_transport = _complete(CaptureTransport(), event, result)
+    assert wrong_transport["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+
+    wrong_session_event = {
+        "params": {**event["params"], "session_id": "other-session"}
+    }
+    wrong_session = _complete(transport, wrong_session_event, result)
+    assert wrong_session["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+
+    wrong_turn_event = {"params": {**event["params"], "turn_id": "2" * 32}}
+    wrong_turn = _complete(transport, wrong_turn_event, result)
+    assert wrong_turn["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+
+    conflicting_result = _complete(
+        transport,
+        event,
+        _result(operation_id, text="different terminal result"),
+    )
+    assert (
+        conflicting_result["error"]["code"]
+        == bridge.LilithHostAuthorityError.rpc_code
+    )
+
+    assert _complete(transport, event, result)["result"]["accepted"] is True
+    assert bridge._completion_receipt_count() == 1
+
+
+def test_completion_receipts_are_capacity_bounded(monkeypatch):
+    operation_ids: list[str] = []
+    for memo_id in range(1, bridge.MAX_COMPLETION_RECEIPTS + 2):
+        worker, transport, _session, _outcome = _start_request(
+            monkeypatch,
+            {"action": "get", "memo_id": memo_id},
+        )
+        event = transport.frames[0]
+        operation_id = event["params"]["payload"]["operation_id"]
+        operation_ids.append(operation_id)
+        assert (
+            _complete(transport, event, _result(operation_id))["result"]["accepted"]
+            is True
+        )
+        worker.join(1.0)
+
+    assert bridge._completion_receipt_count() == bridge.MAX_COMPLETION_RECEIPTS
+    assert operation_ids[0] not in bridge._completion_receipts
+    assert operation_ids[-1] in bridge._completion_receipts
+
+
+def test_completion_receipt_expires_and_reset_clears_it(monkeypatch):
+    now = [100.0]
+    monkeypatch.setattr(bridge.time, "monotonic", lambda: now[0])
+    worker, transport, _session, _outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    result = _result(operation_id)
+    assert _complete(transport, event, result)["result"]["accepted"] is True
+    worker.join(1.0)
+    assert bridge._completion_receipt_count() == 1
+
+    bridge._reset_pending_for_tests()
+    assert bridge._completion_receipt_count() == 0
+
+    worker, transport, _session, _outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 8},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    result = _result(operation_id)
+    assert _complete(transport, event, result)["result"]["accepted"] is True
+    worker.join(1.0)
+    now[0] += bridge.COMPLETION_RECEIPT_TTL_SECONDS + 0.001
+
+    expired = _complete(transport, event, result)
+    assert expired["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+    assert bridge._completion_receipt_count() == 0
+
+
+def test_wrong_transport_cannot_complete_but_owner_still_can(monkeypatch):
+    worker, transport, _session, outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    wrong = CaptureTransport()
+
+    denied = _complete(wrong, event, _result(operation_id))
+    assert denied["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+    assert bridge._pending_count() == 1
+
+    accepted = _complete(transport, event, _result(operation_id))
+    assert accepted["result"]["accepted"] is True
+    worker.join(1.0)
+    assert outcome["result"]["operation_id"] == operation_id
+
+
+def test_malformed_result_does_not_consume_pending_request(monkeypatch):
+    worker, transport, _session, outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    malformed = _result(operation_id)
+    malformed["arbitrary_host_output"] = "forbidden"
+
+    denied = _complete(transport, event, malformed)
+    assert denied["error"]["code"] == bridge.LilithHostProtocolError.rpc_code
+    assert bridge._pending_count() == 1
+
+    _complete(transport, event, _result(operation_id))
+    worker.join(1.0)
+    assert outcome["result"]["succeeded"] is True
+
+
+@pytest.mark.parametrize(
+    ("succeeded", "code"),
+    [(True, "runtime.memo_failed"), (False, "ok")],
+)
+def test_result_success_flag_and_code_must_agree(
+    monkeypatch,
+    succeeded,
+    code,
+):
+    worker, transport, _session, outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    malformed = _result(operation_id)
+    malformed["succeeded"] = succeeded
+    malformed["code"] = code
+
+    denied = _complete(transport, event, malformed)
+    assert denied["error"]["code"] == bridge.LilithHostProtocolError.rpc_code
+    assert bridge._pending_count() == 1
+
+    accepted = _complete(transport, event, _result(operation_id))
+    assert accepted["result"]["accepted"] is True
+    worker.join(1.0)
+    assert outcome["result"]["succeeded"] is True
+
+
+def test_session_transport_rebind_invalidates_pending_completion(monkeypatch):
+    worker, transport, session, outcome = _start_request(
+        monkeypatch,
+        {"action": "get", "memo_id": 7},
+        timeout=0.2,
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    session["transport"] = CaptureTransport()
+
+    denied = _complete(transport, event, _result(operation_id))
+    assert denied["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+    worker.join(1.0)
+    assert isinstance(outcome.get("error"), bridge.LilithHostUnavailableError)
+    assert bridge._pending_count() == 0
+
+
+def test_timeout_clears_correlation_and_rejects_late_completion(monkeypatch):
+    worker, transport, _session, outcome = _start_request(
+        monkeypatch,
+        {"action": "list", "limit": 1},
+        timeout=0.02,
+    )
+    event = transport.frames[0]
+    operation_id = event["params"]["payload"]["operation_id"]
+    worker.join(1.0)
+    assert isinstance(outcome.get("error"), bridge.LilithHostUnavailableError)
+    assert bridge._pending_count() == 0
+
+    late = _complete(transport, event, _result(operation_id))
+    assert late["error"]["code"] == bridge.LilithHostAuthorityError.rpc_code
+
+
+@pytest.mark.parametrize(
+    "arguments",
+    [
+        {"action": "list", "query": "milk", "limit": 50},
+        {"action": "get", "memo_id": 1},
+        {"action": "create_scratch", "text": "idea", "scratch_tier": "important"},
+        {
+            "action": "create_todo",
+            "text": "buy milk",
