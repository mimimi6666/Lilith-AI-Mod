diff --git a/tests/agent/test_plugin_llm.py b/tests/agent/test_plugin_llm.py
index 3801694..73ce8b4 100644
--- a/tests/agent/test_plugin_llm.py
+++ b/tests/agent/test_plugin_llm.py
@@ -352,6 +352,68 @@ class TestPluginLlmFacade:
         }
         assert result.content_type == "json"
 
+    def test_complete_structured_prompt_only_omits_wire_format_but_validates(self):
+        pytest.importorskip("jsonschema")
+        captured: dict = {}
+        schema = {
+            "type": "object",
+            "properties": {"event": {"type": "string"}},
+            "required": ["event"],
+            "additionalProperties": False,
+        }
+
+        def fake_caller(**kwargs):
+            captured.update(kwargs)
+            return "provider", "model", _fake_response('{"event": "repair"}')
+
+        llm = make_plugin_llm_for_test(
+            plugin_id="my-plugin",
+            policy=_TrustPolicy(plugin_id="my-plugin"),
+            sync_caller=fake_caller,
+        )
+        result = llm.complete_structured(
+            instructions="Return exactly one event",
+            input=[PluginLlmTextInput(text="witness")],
+            json_schema=schema,
+            json_mode=True,
+            send_response_format=False,
+        )
+
+        assert captured["extra_body"] is None
+        prompt = captured["messages"][-1]["content"][0]["text"]
+        assert "Return exactly one event" in prompt
+        assert "JSON schema:" in prompt
+        assert '"additionalProperties": false' in prompt
+        assert result.parsed == {"event": "repair"}
+
+    def test_complete_structured_sends_wire_format_by_default(self):
+        captured: dict = {}
+        schema = {
+            "type": "object",
+            "properties": {"event": {"type": "string"}},
+        }
+
+        def fake_caller(**kwargs):
+            captured.update(kwargs)
+            return "provider", "model", _fake_response('{"event": "repair"}')
+
+        llm = make_plugin_llm_for_test(
+            plugin_id="my-plugin",
+            policy=_TrustPolicy(plugin_id="my-plugin"),
+            sync_caller=fake_caller,
+        )
+        llm.complete_structured(
+            instructions="Return one event",
+            input=[PluginLlmTextInput(text="witness")],
+            json_schema=schema,
+        )
+
+        assert captured["extra_body"]["response_format"]["type"] == "json_schema"
+        assert (
+            captured["extra_body"]["response_format"]["json_schema"]["schema"]
+            == schema
+        )
+
 
 
 
