+"""Direct DeepSeek catalog/selection regression, with real native pipelines.
+
+Transport, credentials and external metadata are synthetic. Normalization,
+validation, switch_model, inventory and config.set run their actual code.
+"""
+from copy import deepcopy
+from pathlib import Path
+import socket
+import subprocess
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import model_tools  # noqa: F401 -- register actual provider profiles
+import providers
+import agent.identity_policy as identity
+import agent.models_dev as metadata
+import hermes_cli.auth as auth
+import hermes_cli.config as config
+import hermes_cli.inventory as inventory
+import hermes_cli.model_normalize as normalize
+import hermes_cli.model_switch as switching
+import hermes_cli.models as models
+import hermes_cli.providers as provider_defs
+import hermes_cli.runtime_provider as runtime
+import tui_gateway.server as server
+
+
+@pytest.fixture
+def fixture(monkeypatch, tmp_path):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Synthetic regression must not use network or subprocess")
+
+    monkeypatch.setattr(socket.socket, "connect", forbidden)
+    monkeypatch.setattr(socket.socket, "connect_ex", forbidden)
+    monkeypatch.setattr(subprocess, "run", forbidden)
+    monkeypatch.setattr(Path, "home", classmethod(lambda cls: tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    state = SimpleNamespace(
+        live=["deepseek-flash", "deepseek-v4-pro"], cache={},
+        config={"model": {"provider": "deepseek", "default": "deepseek-v4-pro"}},
+        persist=Mock(), desire=Mock(return_value=(1, None)),
+    )
+    monkeypatch.setattr(config, "load_config", lambda: deepcopy(state.config))
+    monkeypatch.setattr(switching, "_load_direct_aliases", lambda: {})
+    monkeypatch.setattr(switching, "DIRECT_ALIASES", {})
+    monkeypatch.setattr(runtime, "resolve_runtime_provider", lambda **kwargs: {
+        "provider": kwargs.get("requested") or "deepseek", "api_key": "synthetic-not-a-credential",
+        "base_url": "https://api.deepseek.com/v1", "api_mode": "chat_completions"})
+    monkeypatch.setattr(auth, "resolve_api_key_provider_credentials", lambda *args, **kwargs: {
+        "api_key": "synthetic-not-a-credential", "base_url": "https://api.deepseek.com/v1"})
+    monkeypatch.setattr(auth, "get_provider_effective_credential_env", lambda provider, key:
+        "synthetic-not-a-credential" if provider == "deepseek" else "")
+    monkeypatch.setattr(auth, "_load_auth_store", lambda: {})
+    monkeypatch.setattr(models, "fetch_api_models", lambda *args, **kwargs: state.live)
+    profile = providers.get_provider_profile("deepseek")
+    assert profile is not None
+    state.profile = profile
+    monkeypatch.setattr(profile, "fetch_models", lambda **kwargs: state.live)
+    monkeypatch.setattr(models, "_load_provider_models_cache", lambda: deepcopy(state.cache))
+    monkeypatch.setattr(models, "_save_provider_models_cache", lambda value: state.cache.update(value))
+    monkeypatch.setattr(models, "get_curated_nous_model_ids", lambda: [])
+    monkeypatch.setattr(models, "fetch_ollama_cloud_models", lambda *args, **kwargs: [])
+    monkeypatch.setattr(switching, "get_model_capabilities", lambda *args, **kwargs: None)
+    monkeypatch.setattr(switching, "get_model_info", lambda *args, **kwargs: None)
+    monkeypatch.setattr(metadata, "PROVIDER_TO_MODELS_DEV", {"deepseek": "deepseek"})
+    monkeypatch.setattr(metadata, "fetch_models_dev", lambda: {"deepseek": {
+        "name": "DeepSeek", "env": ["DEEPSEEK_API_KEY"], "models": {}}})
+    monkeypatch.setattr(metadata, "get_provider_info", lambda name, **kwargs:
+        metadata.ProviderInfo("deepseek", "DeepSeek", ("DEEPSEEK_API_KEY",), "https://api.deepseek.com/v1")
+        if name == "deepseek" else None)
+    monkeypatch.setattr(provider_defs, "HERMES_OVERLAYS", {
+        key: value for key, value in provider_defs.HERMES_OVERLAYS.items() if key == "deepseek"})
+    monkeypatch.setattr(models, "CANONICAL_PROVIDERS", [p for p in models.CANONICAL_PROVIDERS if p.slug == "deepseek"])
+    monkeypatch.setattr(identity, "identity_lock_required_by_host", lambda: True)
+    monkeypatch.setattr(server, "_resolve_model", lambda: state.config["model"]["default"])
+    monkeypatch.setattr(server, "_persist_model_switch", state.persist)
+    monkeypatch.setattr(server, "_commit_runtime_desire", state.desire)
+    return state
+
+
+def select(model, provider="deepseek"):
+    return switching.switch_model(raw_input=model, current_provider=provider,
+        current_model="deepseek-v4-pro", explicit_provider=provider, is_global=True)
+
+
+@pytest.mark.parametrize("model", [
+    "deepseek-flash", "deepseek-v4-pro", "deepseek-v4-flash",
+    "deepseek-v4-flash-vision-exp", "deepseek-reasoner", "DeepSeek.Future.Exact",
+])
+def test_normalization_never_migrates_a_stored_literal(fixture, model):
+    assert normalize.normalize_model_for_provider(model, "deepseek") == model
+
+
+@pytest.mark.parametrize("live", [["deepseek-flash", "deepseek-v4-pro"], None])
+def test_new_exact_flash_survives_the_full_global_selection(fixture, live):
+    fixture.live = live
+    before = deepcopy(fixture.config)
+    result = server._apply_model_switch("", {"agent": None},
+        "deepseek-flash --provider deepseek --global", confirm_expensive_model=True)
+    assert result["value"] == "deepseek-flash"
+    fixture.persist.assert_called_once()
+    assert fixture.persist.call_args.args[0].new_model == "deepseek-flash"
+    assert fixture.config == before
+
+
+@pytest.mark.parametrize("model", ["deepseek-v4-flash", "deepseek-v4-flash-vision-exp"])
+@pytest.mark.parametrize("live", [["deepseek-flash", "deepseek-v4-pro"], None])
+def test_compatibility_literal_remains_exact_not_silently_upgraded(fixture, model, live):
+    fixture.live = live
+    result = select(model)
+    assert result.success and result.new_model == model
+    assert "compatibility" in result.warning_message
+    assert "corrected_model" not in models.validate_requested_model(model, "deepseek")
+
+
+def test_typo_is_not_fuzzily_saved_as_a_different_model(fixture):
+    result = select("deepseek-flahs")
+    assert not result.success
+    assert "Exact DeepSeek model" in result.error_message
+    fixture.persist.assert_not_called()
+
+
+@pytest.mark.parametrize("live", [["deepseek-flash", "deepseek-v4-pro"], None])
+def test_existing_compatibility_selection_can_still_pass_exact_global_guard(fixture, live):
+    fixture.live = live
+    result = server._apply_model_switch("", {"agent": None},
+        "deepseek-v4-flash --provider deepseek --global", confirm_expensive_model=True)
+    assert result["value"] == "deepseek-v4-flash"
+    fixture.persist.assert_called_once()
+    assert fixture.persist.call_args.args[0].new_model == "deepseek-v4-flash"
+
+
+def test_live_direct_catalog_is_exact_without_stale_curated_merge(fixture):
