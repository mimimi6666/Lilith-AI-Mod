+
+
+def claim(session, session_id, turn_id, text):
+    """One exact terminal reply, once. A public ID alone is not authority."""
+    with session["history_lock"]:
+        grant = session.get(_KEY)
+        if (not _current_locked(session, grant) or grant.claimed
+                or grant.session_id != session_id or grant.turn_id != turn_id
+                or grant.text_digest != _digest(text)):
+            raise ValueError("completed speech origin unavailable")
+        grant.claimed = True
+        return grant
+
+
+def is_current(session, grant):
+    with session["history_lock"]:
+        return _current_locked(session, grant)
+
+
+def finish(session, grant):
+    with session["history_lock"]:
+        if session.get(_KEY) is grant:
