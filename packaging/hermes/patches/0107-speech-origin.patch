+            or session.get(_KEY) is not grant or session.get("agent") is not grant.agent
+            or session.get("source") != "lilith-game" or session.get("archived") is not True
+            or session.get("session_key") != grant.session_key
+            or session.get("_durable_lineage_root") != grant.lineage_root
+            or session.get("_finalized") or session.get("_turn_cancel_requested")
+            or session.get("running") or isinstance(session.get("inflight_turn"), dict)):
