+"""Pure lifecycle tests. Model/runtime imports are explicit synthetic doubles."""
+import contextlib
+import sys
+import threading
+import types
+import unittest
+from unittest.mock import patch
+
+from tui_gateway import speech_origin as subject
+
+
+class CompletedOriginTests(unittest.TestCase):
+    def setUp(self):
+        self.state = types.SimpleNamespace(stopped=False)
+        self.origin = types.SimpleNamespace(origin_id="a" * 32,
+            ledger=types.SimpleNamespace(snapshot=lambda: self.state),
+            _owner=types.SimpleNamespace(_validate=lambda handle: None))
+        self.agent = object()
+        self.snapshot = object()
+        self.session = dict(agent=self.agent, history_lock=threading.Lock(),
+            source="lilith-game", archived=True, session_key="tip",
+            _durable_lineage_root="root", running=False, inflight_turn=None)
+        self.modules = patch.dict(sys.modules, {
+            "agent.usage_budget_runtime": types.SimpleNamespace(capture_origin=lambda: self.origin),
+            "agent.speech_projection": types.SimpleNamespace(capture_speech_projection=lambda *a, **kw: self.snapshot),
+            "agent.turn_identity": types.SimpleNamespace(require_canonical_id=lambda value, _: value),
+        })
+        self.modules.start()
+        self.addCleanup(self.modules.stop)
+
+    def retain(self):
+        subject.retain_completed(self.session, "live", "a" * 32, "早安。", self.origin)
+
+    def claim(self, **changes):
+        args = dict(session=self.session, session_id="live", turn_id="a" * 32, text="早安。")
+        args.update(changes)
+        return subject.claim(**args)
+
+    def test_exact_reply_once(self):
+        self.retain()
+        grant = self.claim()
+        self.assertIs(self.origin, grant.origin)
+        self.assertIs(self.snapshot, grant.snapshot)
+        self.assertTrue(subject.is_current(self.session, grant))
+        with self.assertRaises(ValueError): self.claim()
+        subject.finish(self.session, grant)
+        self.assertFalse(subject.is_current(self.session, grant))
+        with self.assertRaises(ValueError): self.claim()
+
+    def test_missing_or_restarted_session(self):
+        with self.assertRaises(ValueError): self.claim()
+
+    def test_mismatch_does_not_consume_valid_reply(self):
+        self.retain()
+        for change in ({"session_id": "other"}, {"turn_id": "b" * 32}, {"text": "早安。 "}):
+            with self.subTest(change=change), self.assertRaises(ValueError): self.claim(**change)
+        self.claim()
+
+    def test_cross_session_even_if_slot_copied(self):
+        self.retain()
+        with self.assertRaises(ValueError): self.claim(session=dict(self.session))
+
+    def test_state_changes_invalidate_before_and_after_claim(self):
+        for field, value in (("agent", object()), ("source", "other"), ("archived", False),
+                             ("session_key", "other"), ("_durable_lineage_root", "other"),
+                             ("running", True), ("inflight_turn", {}), ("_finalized", True),
+                             ("_turn_cancel_requested", True)):
+            with self.subTest(field=field):
+                self.retain()
+                grant = self.claim()
+                old = self.session.get(field)
+                self.session[field] = value
+                self.assertFalse(subject.is_current(self.session, grant))
+                with self.assertRaises(ValueError): self.claim()
+                self.session[field] = old
+
+    def test_stop_ledger_remains_effective_without_quota(self):
+        self.retain()
+        grant = self.claim()
+        self.state.stopped = True
+        self.assertFalse(subject.is_current(self.session, grant))
+        with self.assertRaises(ValueError): self.retain()
+
+    def test_next_turn_invalidates_and_old_cleanup_cannot_erase_new(self):
+        self.retain()
+        old = self.claim()
+        with self.session["history_lock"]: subject.invalidate_locked(self.session)
+        self.assertFalse(subject.is_current(self.session, old))
+        self.retain()
+        subject.finish(self.session, old)
+        self.claim()
+
+    def test_foreign_or_missing_origin_never_mints(self):
+        for handle in (None, object()):
+            with self.assertRaises(ValueError):
+                subject.retain_completed(self.session, "live", "a" * 32, "早安。", handle)
+
+    def test_capture_failure_leaves_no_grant(self):
+        self.retain()
+        with patch.object(sys.modules["agent.speech_projection"], "capture_speech_projection", side_effect=ValueError):
+            with self.assertRaises(ValueError): self.retain()
+        with self.assertRaises(ValueError): self.claim()
+
+    def test_invalid_text_cannot_be_admitted(self):
+        for text in (None, "", " ", "a" * 32769):
+            with self.assertRaises(ValueError):
+                subject.retain_completed(self.session, "live", "a" * 32, text, self.origin)
+
+    def test_no_history_or_credentials_in_diagnostics(self):
+        self.retain()
+        grant = self.claim()
+        self.assertNotIn("早安", repr(grant))
+        self.assertNotIn("snapshot=", repr(grant))
+
+    def test_concurrent_duplicate_only_one_claims(self):
+        self.retain()
+        accepted = []
+        def attempt():
+            try: accepted.append(self.claim())
+            except ValueError: pass
+        threads = [threading.Thread(target=attempt) for _ in range(8)]
+        for thread in threads: thread.start()
+        for thread in threads: thread.join()
+        self.assertEqual(1, len(accepted))
+
+
+if __name__ == "__main__":
+    unittest.main()
