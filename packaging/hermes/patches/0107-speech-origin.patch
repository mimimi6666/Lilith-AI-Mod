@@ -0,0 +1,97 @@
+"""Ephemeral completed-reply provenance, never a new allowance or tool authority."""
+from dataclasses import dataclass, field
+import hashlib
+
+
+_KEY = "_completed_speech_origin"
+
+
+@dataclass(eq=False)
+class CompletedSpeechOrigin:
+    session: object = field(repr=False)
+    agent: object = field(repr=False)
+    session_id: str
+    session_key: str
+    lineage_root: str
+    turn_id: str
+    text_digest: str = field(repr=False)
+    origin: object = field(repr=False)
+    snapshot: object = field(repr=False)
+    claimed: bool = False
+
+
+def _digest(text):
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def invalidate_locked(session):
+    """Caller owns history_lock. In-flight projections check this same slot."""
+    session.pop(_KEY, None)
+
+
+def retain_completed(session, session_id, turn_id, text, origin):
+    """Called before terminal publication, inside the original economic scope.
+
+    Capture failures are auxiliary failures: the caller must keep the primary
+    reply. Nothing is serialized, read back from history, or minted on resume.
+    """
+    from agent.usage_budget_runtime import capture_origin
+    from agent.speech_projection import capture_speech_projection
+    from agent.turn_identity import require_canonical_id
+
+    require_canonical_id(turn_id, "turn_id")
+    if origin is None or capture_origin() is not origin or origin.origin_id != turn_id:
+        raise ValueError("speech origin does not own the completed turn")
+    if type(text) is not str or not text.strip() or len(text) > 32768:
+        raise ValueError("speech source is unavailable")
+    with session["history_lock"]:
+        invalidate_locked(session)
+        if (session.get("source") != "lilith-game" or session.get("archived") is not True
+                or session.get("_finalized") or session.get("_turn_cancel_requested")
