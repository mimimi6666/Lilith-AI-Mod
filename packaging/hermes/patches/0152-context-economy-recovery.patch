+def _retained_host_event(row):
+    """Recognize only completed host-authored assistant row shapes.
+
+    The durable native-event and extension builders use these exact synthetic
+    provenance bindings. This is a segmentation hint, not permission to omit
+    the event, infer an action succeeded, or trust a model's matching prose.
+    Unknown notifications/continuations stay in their original segment.
+    """
+    bindings = {
+        "native_assistant_event": ("lilith-native", "lilith_native_event_id"),
+        "native_assistant_extension": ("lilith-native-extension", "lilith_native_extension_event_id"),
+        "foreground_proactive_reply": ("lilith-foreground-proactive", "lilith_foreground_proactive_operation_id"),
+    }
+    kind = row.get("display_kind")
+    if type(kind) is not str or kind not in bindings:
+        return False
+    calls = row.get("tool_calls")
+    if (row.get("role") != "assistant" or type(row.get("content")) is not str
+            or not row["content"].strip()
+            or (calls is not None and (not isinstance(calls, list) or calls))
+            or any(row.get(name) is not None for name in ("tool_call_id", "function_call", "api_content"))
+            or any(row.get(name) for name in (
+                "_thinking_prefill", "_length_continuation_fragment", "_length_continuation_nudge"))
+            or row.get("finish_reason") not in (None, "stop", "end_turn")):
+        return False
+    metadata = row.get("display_metadata")
+    if not isinstance(metadata, dict):
+        return False
+    origin_kind, event_key = bindings[kind]
+    message_id = metadata.get("hermes_message_id")
+    if (metadata.get("hermes_turn_origin") != "synthetic"
+            or metadata.get("hermes_turn_origin_kind") != origin_kind
+            or metadata.get("hermes_message_kind") != "primary"
+            or not all(_native_message_id(metadata.get(key))
+                       for key in (event_key, "hermes_turn_id", "hermes_message_id"))
+            or (row.get("message_id") is not None and row["message_id"] != message_id)):
+        return False
+    if kind == "native_assistant_event":
+        native_turn = hashlib.sha256(
+            f"lilith-native-turn-v1:{message_id}".encode("ascii")).hexdigest()[:32]
+        if native_turn == message_id:
+            native_turn = hashlib.sha256(
+                f"lilith-native-turn-v2:{message_id}".encode("ascii")).hexdigest()[:32]
+        if (message_id != metadata[event_key]
+                or metadata["hermes_turn_id"] != native_turn
+                or metadata.get("lilith_native_source") != "lilith-native"
+                or type(metadata.get("lilith_native_occurred_at_unix_ms")) is not int
+                or metadata["lilith_native_occurred_at_unix_ms"] <= 0
+                or not all(type(metadata.get(key)) is str for key in (
+                    "lilith_native_node_id", "lilith_native_line_id",
+                    "lilith_native_trigger", "lilith_native_locale"))):
+            return False
+    return True
+
+
+def _retained_boundary_unchanged(unit, source, positions, projected, offset):
+    boundary = unit[0].boundary
+    if boundary is None:
+        return True
+    index = positions.get(id(boundary.message))
+    last = positions.get(id(unit[-1].message))
+    if (index is None or last is None or index != last + 1
+            or source[index] is not boundary.message
+            or _digest(source[index]) != boundary.digest):
+        return False
+    actual = projected[offset + index]
+    # The owned assembly removes display bookkeeping; semantic event content
+    # and tool linkage must still be exactly the captured, retained row.
+    fields = ("role", "content", "tool_calls", "tool_call_id", "function_call")
+    return (isinstance(actual, dict)
+            and all(source[index].get(key) == actual.get(key) for key in fields))
+
+
