diff --git a/agent/history_checkpoint_cache.py b/agent/history_checkpoint_cache.py
new file mode 100644
--- /dev/null
+++ b/agent/history_checkpoint_cache.py
@@ -0,0 +1,172 @@
+"""Bounded disposable summary cache, never history, identity or budget authority.
+
+Only the authenticated origin supplies the profile. Reads/writes are optional;
+an absent, corrupt, unsafe or unavailable cache is a miss. Every reuse still
+requires exact current certified-unit semantic keys and a matching scope.
+Fixed slots bound retention. Payload digests detect corruption, not establish
+authority; cached prose remains subordinate model-generated summary data.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import time
+
+VERSION = "lilith-context-checkpoint-v1"
+MAX_BYTES = 320 * 1024
+MAX_SUMMARY_CHARS = 48000
+MAX_UNITS = 2048
+SLOTS = 32
+MAX_AGE = 30 * 86400
+_HEX = re.compile(r"[a-f0-9]{64}\Z")
+
+
+def reuse_scope(agent):
+    from agent.identity_policy import policy_for_agent
+    from agent.usage_strategy import STRATEGY_VERSION
+    policy = policy_for_agent(agent)
+    return (VERSION, STRATEGY_VERSION, str(agent.session_id),
+            tuple(str(getattr(agent, key, "")) for key in
+                  ("model", "provider", "api_mode", "base_url")),
+            policy.enabled, policy.fingerprint)
+
+
+def _json(value):
+    return json.dumps(value, sort_keys=True, ensure_ascii=True,
+                      separators=(",", ":"), allow_nan=False).encode("ascii")
+
+
+def _scope_key(scope):
+    return hashlib.sha256(_json(scope)).hexdigest()
+
+
+def _slot(key):
+    return ".lilith-context-checkpoint-%02d.json" % (int(key[:8], 16) % SLOTS)
+
+
+def _root(agent, origin):
+    from agent.identity_policy import policy_for_agent
+    from agent.usage_budget_runtime import OriginBudgetHandle
+    if (type(origin) is not OriginBudgetHandle or not policy_for_agent(agent).enabled
+            or getattr(agent, "_background_context_readonly", False)
+            or origin.ledger.snapshot().stopped):
+        return None
+    origin._owner._validate(origin)
+    root = Path(origin._owner.store.profile_root)
+    return root if root.is_absolute() else None
+
+
+def _pairs(items):
+    result = {}
+    for key, value in items:
+        if key in result:
+            raise ValueError("duplicate_cache_field")
+        result[key] = value
+    return result
+
+
+def _valid_state(covered, summary):
+    return (type(covered) in (list, tuple) and 0 < len(covered) <= MAX_UNITS
+            and all(type(key) is str and _HEX.fullmatch(key) for key in covered)
+            and type(summary) is str and bool(summary.strip())
+            and len(summary) <= MAX_SUMMARY_CHARS)
+
+
+def _decode(data, key, keys):
+    if not 0 < len(data) <= MAX_BYTES:
+        return None
+    value = json.loads(data.decode("utf-8"), object_pairs_hook=_pairs)
+    if (type(value) is not dict or set(value) != {"payload", "sha256"}
+            or type(value["sha256"]) is not str
+            or hashlib.sha256(_json(value["payload"])).hexdigest() != value["sha256"]):
+        return None
+    payload = value["payload"]
+    if (type(payload) is not dict
+            or set(payload) != {"version", "scope", "created", "covered", "summary"}
+            or payload["version"] != VERSION or payload["scope"] != key
+            or type(payload["created"]) not in (int, float)
+            or not 0 <= time.time() - payload["created"] <= MAX_AGE
+            or not _valid_state(payload["covered"], payload["summary"])):
+        return None
+    covered = tuple(payload["covered"])
+    if tuple(keys[:len(covered)]) != covered:
+        return None
+    return {"covered": covered, "summary": payload["summary"]}
+
+
+def _load(root, scope, keys):
+    from agent.usage_budget_store import _Directory
+    key = _scope_key(scope)
+    with _Directory(root) as directory:
+        with os.fdopen(directory.open(_slot(key)), "rb") as stream:
+            return _decode(stream.read(MAX_BYTES + 1), key, keys)
+
+
+def load(agent, origin, scope, keys):
+    try:
+        root = _root(agent, origin)
+        result = _load(root, scope, keys) if root is not None else None
+        return result if root is not None and _root(agent, origin) == root else None
+    except Exception:
+        # No private path/body in diagnostics; optional cache cannot block chat.
+        return None
+
+
+def _save(root, scope, covered, summary, *, can_commit=lambda: True):
+    from agent.usage_budget_store import _Directory, _windows
+    if not _valid_state(covered, summary):
+        return False
+    key = _scope_key(scope)
+    payload = {"version": VERSION, "scope": key, "created": time.time(),
+               "covered": list(covered), "summary": summary}
+    data = _json({"payload": payload, "sha256": hashlib.sha256(_json(payload)).hexdigest()})
+    if len(data) > MAX_BYTES:
+        return False
+    name = _slot(key)
+    # One exclusive temporary per fixed slot: a process crash cannot leave an
+    # unbounded collection of private summaries. A stale temp makes this slot
+    # read-only/unavailable, not permission to remove an unknown file.
+    temporary = name + ".tmp"
+    with _Directory(root) as directory:
+        # Reject aliases/hardlinks for an existing target without modifying it.
+        try:
+            descriptor = directory.open(name, allow_delete=True)
+        except FileNotFoundError:
+            descriptor = None
+        temporary_exists = False
+        try:
+            with os.fdopen(directory.open(temporary, writable=True, exclusive=True, create=True), "wb") as stream:
+                temporary_exists = True
+                stream.write(data)
+                stream.flush()
+                os.fsync(stream.fileno())
+            # Last cancellation/ownership check at the optional publication
+            # boundary. A stop observed before commit cannot publish a cache.
+            if not can_commit():
+                return False
+            if os.name == "nt":
+                ctypes, kernel = _windows()
+                if not kernel.MoveFileExW(str(root / temporary), str(root / name), 1 | 8):
+                    raise OSError(ctypes.get_last_error(), "checkpoint_replace_failed")
+            else:
+                os.replace(temporary, name, src_dir_fd=directory.fd, dst_dir_fd=directory.fd)
+                os.fsync(directory.fd)
+            temporary_exists = False
+            return True
+        finally:
+            if descriptor is not None:
+                os.close(descriptor)
+            if temporary_exists:
+                directory.remove(temporary)
+
+
+def save(agent, origin, scope, state):
+    try:
+        root = _root(agent, origin)
+        if root is None:
+            return False
+        return _save(root, scope, state["covered"], state["summary"],
+                     can_commit=lambda: _root(agent, origin) == root)
+    except Exception:
+        return False
