+def test_native_question_keeps_lilith_as_speaker_and_player_as_addressee():
+    class _Agent:
+        _cached_system_prompt = "You are Lilith."
+        ephemeral_system_prompt = ""
+
+        @staticmethod
+        def _sanitize_api_messages(messages):
+            return messages
+
+        @staticmethod
+        def _drop_thinking_only_and_merge_users(messages):
+            return messages
+
+        @staticmethod
+        def _copy_reasoning_content_for_api(_source, _projected):
+            return None
+
+    perception = _extend_params()["perception"] | {
+        "trigger": "GamePlayRest",
+        "text": "玩得累了嗎？",
+    }
+    messages = server._native_assistant_extension_model_messages(
+        _Agent(),
+        [
+            {
+                "role": "assistant",
+                "content": perception["text"],
+                "display_kind": "native_assistant_event",
+            }
+        ],
+        perception,
+    )
+
+    system = messages[0]["content"]
+    assert "only the player can answer it" in system
+    assert "do not answer for the player" in system
+    assert "Continue Lilith's own concern, invitation, or observation" in system
+    assert messages[-1] == {
+        "role": "user",
+        "content": (
+            "Host control: Lilith remains the speaker addressing the player, "
+            "and the player has not replied. Write the required native "
+            "continuation now and return exactly one required JSON object with "
+            "non-empty text."
+        ),
+    }
+
