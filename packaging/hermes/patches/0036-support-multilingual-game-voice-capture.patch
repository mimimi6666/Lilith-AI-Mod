+            return {
+                "success": False,
+                "transcript": "",
+                "error": "language detection failed",
+                "provider": "pinned_local",
+            }
+
+        monkeypatch.setattr(voice, "transcribe_recording", _transcribe)
+        statuses = []
+        transcripts = []
+        voice.start_continuous(
+            on_transcript=transcripts.append,
+            on_status=statuses.append,
+            auto_restart=False,
+            language=None,
+            pinned_local_model_path="/runtime/voice/model",
+        )
+
+        fake_recorder.last_callback()
+
+        assert calls == [
+            {"pinned_local_model_path": "/runtime/voice/model"}
+        ]
+        assert statuses == ["listening", "transcribing", "idle"]
+        assert transcripts == []
+        assert fake_recorder.is_recording is False
+        assert voice.is_continuous_active() is False
+        assert voice._continuous_language is None
