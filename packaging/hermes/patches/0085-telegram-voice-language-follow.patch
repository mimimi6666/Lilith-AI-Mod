index 0000000..7f6f175
--- /dev/null
+++ b/agent/speech_projection.py
@@ -0,0 +1,150 @@
+"""Memory-isolated speech formatting on a frozen native main model route."""
+from dataclasses import dataclass, field
+
+
+@dataclass(frozen=True)
+class SpeechProjectionSnapshot:
+    # Neither credentials nor personality text belong in diagnostics/results.
+    _runtime: object = field(repr=False)
+    _system_prompt: str = field(repr=False)
+    _requested_provider: str = field(default="", repr=False)
+    _auth_mode: str = field(default="", repr=False)
+    _session_id: str = field(default="", repr=False)
+
+
+def capture_speech_projection(agent, *, session_id=None):
+    """Freeze the actual agent, including a completed turn's changed wire route."""
+    from agent.auxiliary_client import scoped_runtime_main
+    from agent.identity_policy import assert_scoped_identity_prompt
+    from agent.plugin_llm import PluginLlm
+
+    prompt = getattr(agent, "_cached_system_prompt", None)
+    if not isinstance(prompt, str) or not prompt:
+        raise ValueError("speech system authority is unavailable")
+    assert_scoped_identity_prompt(agent, prompt, label="speech projection system prompt")
+    runtime = {}
+    for name in ("provider", "requested_provider", "model", "base_url", "api_key", "api_mode", "auth_mode"):
+        value = getattr(agent, name, None)
+        if isinstance(value, str) and value.strip():
+            runtime[name] = value.strip()
+        elif name == "api_key" and callable(value):
+            runtime[name] = value
+    current_session = session_id if session_id is not None else getattr(agent, "session_id", None)
+    if not isinstance(current_session, str) or not current_session:
+        raise ValueError("speech session route is unavailable")
+    runtime["session_id"] = current_session
+    # This native scope never writes the process compatibility mirrors. The
+    # opaque snapshot resolves MoA here and cannot be serialized or pickled.
+    with scoped_runtime_main(runtime) as bound_runtime:
+        # scoped_runtime_main normalizes routing fields; its current native
+        # whitelist omits this explicit cache-scope metadata. Add it to only
+        # this private binding before the opaque capture freezes it.
+        bound_runtime["session_id"] = current_session
+        frozen = PluginLlm(plugin_id="lilith-runtime-speech-projection").capture_runtime_context(task=None)
+    return SpeechProjectionSnapshot(frozen, prompt, runtime.get("requested_provider", ""), runtime.get("auth_mode", ""), current_session)
+
+
+def speech_prompt_is_current(prompt):
+    from agent.identity_policy import bind_host_required_auxiliary_messages
+    try:
+        authority = [{"role": "system", "content": prompt}]
+        return type(prompt) is str and bool(prompt) and bind_host_required_auxiliary_messages(authority) == authority
+    except Exception:
+        return False
+
+
+def speech_authority_is_current(snapshot):
+    return type(snapshot) is SpeechProjectionSnapshot and speech_prompt_is_current(snapshot._system_prompt)
+
+
+def project_speech(snapshot, text, *, speech_locale, display_locale="auto"):
+    """Return speech-only text; an invalid/unavailable projection never echoes input."""
+    if type(snapshot) is not SpeechProjectionSnapshot:
+        raise ValueError("speech authority snapshot is unavailable")
+    if (type(text) is not str or not text.strip() or len(text) > 32768
+            or speech_locale not in {"zh", "ja"}
+            or display_locale not in {"auto", "zh-Hant", "zh-Hans", "ja", "en"}):
+        raise ValueError("invalid speech projection input")
+
+    from agent.auxiliary_client import call_llm, _freeze_auxiliary_main_runtime
+    from agent.identity_policy import bind_host_required_auxiliary_messages
+    from agent.plugin_llm import PluginLlm, PluginLlmTextInput
+
+    def invoke():
+        authority = [{"role": "system", "content": snapshot._system_prompt}]
+        # A changed host identity must not prepend a new personality to a
+        # captured one and silently bless it as the same completed turn.
+        if bind_host_required_auxiliary_messages(authority) != authority:
+            raise ValueError("speech system authority changed")
+
+        def call_active_route(**kwargs):
+            route_info = {}
+            main_runtime = _freeze_auxiliary_main_runtime(None)
+            main_runtime["session_id"] = snapshot._session_id
+            if snapshot._requested_provider:
+                main_runtime["requested_provider"] = snapshot._requested_provider
+            if snapshot._auth_mode:
+                main_runtime["auth_mode"] = snapshot._auth_mode
+            response = call_llm(
+                task=None,
+                provider=kwargs.get("provider_override"),
+                model=kwargs.get("model_override"),
+                main_runtime=dict(main_runtime),
+                messages=kwargs["messages"],
+                temperature=kwargs.get("temperature"),
+                max_tokens=kwargs.get("max_tokens"),
+                timeout=kwargs.get("timeout"),
+                extra_body=kwargs.get("extra_body"),
+                reasoning_config={"enabled": False},
+                tools=None,
+                stream=False,
+                route_info=route_info,
+            )
+            return str(route_info.get("provider") or ""), str(route_info.get("model") or ""), response
+
+        instructions = (
+            "Convert the supplied assistant reply into natural text for spoken TTS. "
+            f"Its display locale is {display_locale}; the requested speech locale is {speech_locale}. "
+            "When display locale is auto, infer the source language from the supplied reply. "
+            "Speech locale ja requires natural Japanese. Speech locale zh requires natural "
+            "Chinese: retain Traditional Chinese for zh-Hant, retain Simplified Chinese for "
+            "zh-Hans, and otherwise use Traditional Chinese (Taiwan). Translate faithfully "
+            "when display and speech languages differ; otherwise preserve the wording except "
+            "for minimal speech readability. Preserve meaning, persona, relationship tone, "
