new file mode 100644
index 0000000..ddb6bf5
--- /dev/null
+++ b/agent/lilith_telegram_voice_profile.py
@@ -0,0 +1,222 @@
+"""Read the existing Control Center voice choice; never persist preferences.
+
+The Runtime supplies two validated installed voices and the fixed D046 store
+path. Only this bounded store selects a voice, immediately before each reply.
+An old v1 startup snapshot is deliberately not a current language authority.
+"""
+import base64
+import datetime
+import json
+import os
+from pathlib import Path, PureWindowsPath
+import re
+import stat
+import string
+import unicodedata
+
+
+ENVIRONMENT = "LILITH_TELEGRAM_VOICE_PROFILE"
+MAX_PREFERENCES = 16 * 1024
+MAX_REFERENCE = 32 * 1024 * 1024
+PROFILE_FIELDS = frozenset({"version", "locale", "endpoint", "reference_path",
+                            "aux_reference_paths", "prompt_text", "config_fingerprint"})
+_BASE_FIELDS = frozenset({"schemaVersion", "revision", "pushToTalkKey",
+                          "textChatKey", "conversationHistoryKey", "updatedUtc"})
+_KEYS = frozenset(
+    list(string.ascii_uppercase)
+    + ["F" + str(i) for i in range(1, 16)]
+    + ["Digit" + str(i) for i in range(10)]
+    + ["NumPad" + str(i) for i in range(10)]
+    + ["NumPadDivide", "NumPadMultiply", "NumPadSubtract", "NumPadAdd", "NumPadDecimal",
+       "LeftArrow", "RightArrow", "UpArrow", "DownArrow", "Home", "End", "PageUp", "PageDown",
+       "Insert", "Delete", "Space", "Tab", "Enter", "Backspace", "OemSemicolon", "OemPlus",
+       "OemComma", "OemMinus", "OemPeriod", "OemQuestion", "OemTilde", "OemOpenBrackets",
+       "OemPipe", "OemCloseBrackets", "OemQuotes"])
+_VOICE = {"Japanese": "ja", "TraditionalChinese": "zh"}
+_INPUT = frozenset({"Japanese", "TraditionalChinese", "Automatic", "English"})
+_TIMESTAMP = re.compile(
+    r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
+    r"(?:\.[0-9]{1,16})?(?:Z|[+-][0-9]{2}:[0-9]{2})\Z")
+
+
+def _object(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError()
+        value[key] = item
+    return value
+
+
+def _invalid_constant(_value):
+    raise ValueError()
+
+
+def _json(raw):
+    return json.loads(raw, object_pairs_hook=_object, parse_constant=_invalid_constant)
+
+
+def _path_shape(raw):
+    if (type(raw) is not str or not raw or len(raw.encode("utf-8")) > 4096
+            or any(unicodedata.category(c) == "Cc" for c in raw)
+            or raw.startswith(("\\\\", "//"))):
+        raise ValueError()
+    path = Path(raw)
+    windows = PureWindowsPath(raw)
+    if (not path.is_absolute() or ".." in path.parts or "." in raw.replace("\\", "/").split("/")
+            or ":" in raw[len(windows.drive):]):
+        raise ValueError()
+    if os.name == "nt" and any(
+            part.endswith((" ", ".")) or PureWindowsPath(part).is_reserved()
+            for part in path.parts[1:]):
+        raise ValueError()
+    return path
+
+
+def _not_reparse(info):
+    if stat.S_ISLNK(info.st_mode) or int(getattr(info, "st_file_attributes", 0)) & 0x400:
+        raise ValueError()
+
+
+def _safe_file(path, maximum):
+    for parent in reversed(path.parents):
+        info = parent.lstat()
+        _not_reparse(info)
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError()
+    info = path.lstat()
+    _not_reparse(info)
+    if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= maximum:
+        raise ValueError()
+    return info
+
+
+def _identity(info):
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns
+
+
+def _read_preferences(path):
+    before = _safe_file(path, MAX_PREFERENCES)
+    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0))
+    with os.fdopen(descriptor, "rb") as stream:
+        opened = os.fstat(stream.fileno())
+        _not_reparse(opened)
+        if _identity(opened) != _identity(before):
+            raise ValueError()
+        raw = stream.read(MAX_PREFERENCES + 1)
+        if len(raw) != opened.st_size or _identity(os.fstat(stream.fileno())) != _identity(opened):
+            raise ValueError()
+        after = _safe_file(path, MAX_PREFERENCES)
+        if _identity(after) != _identity(opened):
+            raise ValueError()
+    return _json(raw.decode("utf-8"))
+
+
+def _selected_locale(document):
+    """Mirror D046 schemas 1..5 without writing their in-memory migrations.
+
+The C# store owns the schema. Contract tests bind the key catalog and serialized
+current fields to that source. Input-language culture migration cannot change
+voice output; schema 1 deterministically selects TraditionalChinese.
+"""
+    if type(document) is not dict:
+        raise ValueError()
+    schema = document.get("schemaVersion")
+    if type(schema) is not int or not 1 <= schema <= 5:
+        raise ValueError()
+    expected = set(_BASE_FIELDS)
+    if schema >= 2:
+        expected.add("voiceLanguage")
+    if schema >= 3:
+        expected.add("speechInputLanguage")
+    if schema >= 4:
+        expected.add("stopKey")
+    if schema >= 5:
+        expected.add("proactiveDialogueEnabled")
+    if set(document) != expected:
+        raise ValueError()
+    revision = document["revision"]
+    if type(revision) is not int or not 1 <= revision <= 9223372036854775807:
+        raise ValueError()
+    keys = [document[name] for name in ("pushToTalkKey", "textChatKey", "conversationHistoryKey")]
+    if any(type(key) is not str or key not in _KEYS for key in keys) or len(set(keys)) != 3:
+        raise ValueError()
+    stop = document["stopKey"] if schema >= 4 else next(
+        key for key in ("F8", "F9", "F11", "F12") if key not in keys)
+    if type(stop) is not str or stop not in _KEYS or stop in keys:
+        raise ValueError()
+    if schema >= 3 and (type(document["speechInputLanguage"]) is not str
+                        or document["speechInputLanguage"] not in _INPUT):
+        raise ValueError()
+    if schema >= 5 and type(document["proactiveDialogueEnabled"]) is not bool:
+        raise ValueError()
+    stamp = document["updatedUtc"]
+    if type(stamp) is not str or not _TIMESTAMP.fullmatch(stamp):
+        raise ValueError()
+    if not stamp.endswith("Z") and (int(stamp[-2:]) >= 60
+                                     or int(stamp[-5:-3]) > 14
+                                     or int(stamp[-5:-3]) == 14 and int(stamp[-2:]) != 0):
+        raise ValueError()
+    timestamp = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
+    offset = timestamp.utcoffset()
+    if offset is None or abs(offset) > datetime.timedelta(hours=14):
+        raise ValueError()
+    utc = timestamp.astimezone(datetime.timezone.utc)
+    if utc == datetime.datetime.min.replace(tzinfo=datetime.timezone.utc):
+        raise ValueError()
+    voice = document["voiceLanguage"] if schema >= 2 else "TraditionalChinese"
+    if type(voice) is not str or voice not in _VOICE:
+        raise ValueError()
+    return _VOICE[voice]
+
+
+def _profile(value, locale):
+    if type(value) is not dict or frozenset(value) != PROFILE_FIELDS:
+        raise ValueError()
+    if type(value["version"]) is not int or value["version"] != 1 or value["locale"] != locale:
+        raise ValueError()
+    if value["endpoint"] != "http://127.0.0.1:%s/tts" % (9880 if locale == "zh" else 9881):
+        raise ValueError()
+    auxiliary = value["aux_reference_paths"]
+    if type(auxiliary) is not list or len(auxiliary) > 8:
+        raise ValueError()
+    for raw_path in [value["reference_path"], *auxiliary]:
+        path = _path_shape(raw_path)
+        if path.suffix.lower() != ".wav":
+            raise ValueError()
+    prompt = value["prompt_text"]
+    if (type(prompt) is not str or not prompt.strip() or len(prompt.encode("utf-8")) > 16384
+            or "\x00" in prompt):
+        raise ValueError()
+    fingerprint = value["config_fingerprint"]
+    if type(fingerprint) is not str or not re.fullmatch(r"[0-9a-fA-F]{64}", fingerprint):
+        raise ValueError()
+
+
+def read_selected_snapshot():
+    """Return the exact seven existing voice fields, or one redacted failure."""
+    try:
+        raw = os.environ.get(ENVIRONMENT, "")
+        if type(raw) is not str or not raw or len(raw) > 65536:
+            raise ValueError()
+        catalog = _json(base64.b64decode(raw, validate=True).decode("utf-8"))
+        if (type(catalog) is not dict or set(catalog) != {"version", "preferences_path", "profiles"}
+                or type(catalog["version"]) is not int or catalog["version"] != 2):
+            raise ValueError()
+        preferences = _path_shape(catalog["preferences_path"])
+        if preferences.name != "current-v1.json":
+            raise ValueError()
+        profiles = catalog["profiles"]
+        if type(profiles) is not dict or set(profiles) != {"zh", "ja"}:
+            raise ValueError()
+        for locale, profile in profiles.items():
+            if profile is not None:
+                _profile(profile, locale)
+        selected = profiles[_selected_locale(_read_preferences(preferences))]
+        if selected is None:
+            raise ValueError()
+        for reference in [selected["reference_path"], *selected["aux_reference_paths"]]:
+            _safe_file(_path_shape(reference), MAX_REFERENCE)
+        return selected
+    except (ValueError, TypeError, KeyError, UnicodeError, OSError, OverflowError, RecursionError):
+        raise ValueError("Lilith voice profile is unavailable") from None
