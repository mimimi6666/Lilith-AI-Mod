+@pytest.mark.asyncio
+async def test_cancel_during_projection_never_starts_native_synthesis(profile, tmp_path):
+    started, release, finished = threading.Event(), threading.Event(), threading.Event()
+    @voice.project_speech_operation
+    def native(_text, output_path):
+        pytest.fail("cancelled projection reached synthesis")
+    def project(text, selected):
+        started.set()
+        assert release.wait(5)
+        return "中文投影。"
+    def worker(**kwargs):
+        try:
+            return native(**kwargs)
+        finally:
+            finished.set()
+    with voice.voice_scope(projector=project):
+        task = asyncio.create_task(voice.synthesize_cancellable(worker, text="原文。", output_path=str(tmp_path / "cancel.ogg")))
+        try:
+            assert await asyncio.to_thread(started.wait, 2)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        finally:
+            release.set()
+        assert await asyncio.to_thread(finished.wait, 2)
+    assert not list(tmp_path.glob("cancel*"))
