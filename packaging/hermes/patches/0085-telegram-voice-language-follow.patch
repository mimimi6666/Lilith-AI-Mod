+@pytest.mark.parametrize("boundary", ["preferences", "preferences-parent", "reference", "reference-parent"])
+def test_reparse_at_each_read_boundary_is_rejected(catalog, monkeypatch, boundary):
+    preferences = Path(catalog["preferences_path"])
+    reference = Path(catalog["profiles"]["ja"]["reference_path"])
+    target = {"preferences": preferences, "preferences-parent": preferences.parent,
+              "reference": reference, "reference-parent": reference.parent}[boundary]
+    original = Path.lstat
+
+    def lstat(path, *args, **kwargs):
+        value = original(path, *args, **kwargs)
+        if path != target:
+            return value
+        return SimpleNamespace(st_mode=value.st_mode, st_file_attributes=0x400)
+
+    monkeypatch.setattr(Path, "lstat", lstat)
+    rejects()
+
+
+def test_preferences_replaced_during_read_are_rejected(catalog, monkeypatch):
+    original = selector._safe_file
+    preferences = Path(catalog["preferences_path"])
+    reads = 0
+
+    def safe_file(path, maximum):
+        nonlocal reads
+        if path == preferences:
+            reads += 1
+            if reads == 2:
+                # Windows can refuse a concurrent replacement; either outcome
+                # rejects this read instead of admitting a mixed document.
+                document = json.loads(CANONICAL_CURRENT_JSON)
+                document.update(revision=8, voiceLanguage="TraditionalChinese")
+                save(path, document)
+        return original(path, maximum)
+
+    monkeypatch.setattr(selector, "_safe_file", safe_file)
+    rejects()
+
