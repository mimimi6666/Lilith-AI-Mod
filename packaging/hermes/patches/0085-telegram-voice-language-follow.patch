+def test_no_read_mutates_env_settings_or_assets(catalog):
+    paths = [Path(catalog["preferences_path"])] + [Path(profile["reference_path"])
+                                                 for profile in catalog["profiles"].values()]
+    before = {path: path.read_bytes() for path in paths}
+    environment = os.environ[selector.ENVIRONMENT]
+    selector.read_selected_snapshot()
+    assert os.environ[selector.ENVIRONMENT] == environment
+    assert {path: path.read_bytes() for path in paths} == before
