@@ -0,0 +1,145 @@
+"""Private event-owned speech authority; never part of agent result/history data."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_EVENT = ContextVar("lilith_telegram_speech_event", default=None)
+
+
+class _EventSpeech:
+    def __init__(self, source, session_key, generation, message_id, external):
+        self.source = (source.platform, source.chat_type, source.chat_id, source.user_id)
+        self.session_key = session_key
+        self.generation = generation
+        self.message_id = message_id
+        self.external = external is True
+        self.snapshot = None
+        self.artifacts = {}
+        self.artifact_overflow = False
+
+    def matches(self, ctx):
+        source = ctx.source
+        return (self.external and self.source == (source.platform, source.chat_type, source.chat_id, source.user_id)
+                and self.session_key == ctx.session_key and self.generation == ctx.run_generation
+                and self.message_id == ctx.event_message_id and bool(self.session_key)
+                and type(self.generation) is int)
+
+
+@contextmanager
+def event_speech_scope(event, *, session_key, generation, message_id):
+    capture = _EventSpeech(event.source, session_key, generation, message_id,
+                          not bool(getattr(event, "internal", False)))
+    token = _EVENT.set(capture)
+    try:
+        yield capture
+    finally:
+        _EVENT.reset(token)
+
+
+def capture_final_speech(runner, ctx, result):
+    from gateway.lilith_telegram_voice import scope_allowed
+    from agent.speech_projection import capture_speech_projection
+
+    capture = _EVENT.get()
+    if capture is None:
+        return
+    # A queued recursive follow-up cannot donate its model/personality to the
+    # original event whose text will be acknowledged by the base adapter.
+    capture.snapshot = None
+    if (not capture.matches(ctx) or not scope_allowed(runner, ctx)
+            or type(result) is not dict or not result.get("final_response")
+            or any(result.get(name) for name in ("failed", "interrupted", "partial", "error"))
+            or result.get("completed") is False):
+        return
+    try:
+        capture.snapshot = capture_speech_projection(ctx.agent_holder[0])
+    except Exception:
+        # A formatting failure cannot change the normal text result.
+        return
+
+
+def tool_speech_projector(runner, ctx):
+    capture = _EVENT.get()
+    def project(text, profile):
+        from gateway.lilith_telegram_voice import scope_allowed, mode_allows_speech
+        from agent.speech_projection import capture_speech_projection, project_speech
+
+        if (type(capture) is not _EventSpeech or not capture.matches(ctx)
+                or not scope_allowed(runner, ctx) or not mode_allows_speech(runner, ctx.source)):
+            raise ValueError("speech turn is no longer current")
+        frozen = capture_speech_projection(ctx.agent_holder[0])
+        return project_speech(frozen, text, speech_locale=profile["locale"])
+    return project
+
+
+def tool_audio_receipt(runner, ctx):
+    # Read the ContextVar while wiring the worker, before tool workers copy
+    # context. Only metadata for this invocation's actual new files is kept.
+    capture = _EVENT.get()
+    def record(raw, profile):
+        if type(capture) is not _EventSpeech or not capture.matches(ctx):
+            return
+        import json
+        from pathlib import Path
+        from gateway.lilith_telegram_voice import scope_allowed, mode_allows_speech
+        from agent.speech_projection import speech_prompt_is_current
+        try:
+            result = json.loads(raw)
+            if result.get("success") is not True:
+                return
+            paths = result.get("file_paths") or [result.get("file_path")]
+            if len(paths) > 64:
+                capture.artifact_overflow = True
+            source = ctx.source
+            owner = (source.platform, source.chat_type, source.chat_id, source.user_id)
+            prompt = getattr(ctx.agent_holder[0], "_cached_system_prompt", None)
+            for path in paths[:64]:
+                if len(capture.artifacts) >= 256:
+                    capture.artifact_overflow = True
+                    break
+                if type(path) is str and len(capture.artifacts) < 256:
+                    capture.artifacts[str(Path(path).resolve())] = (
+                        owner, dict(profile),
+                        lambda: (scope_allowed(runner, ctx) and mode_allows_speech(runner, ctx.source)
+                                 and getattr(runner, "_running", True) and speech_prompt_is_current(prompt)),
+                    )
+        except (ValueError, TypeError, AttributeError):
+            return
+    return record
+
+
+def speech_artifact_allowed(event, path):
+    capture = getattr(event, "_lilith_speech_capture", None) or _EVENT.get()
+    if type(capture) is not _EventSpeech:
+        return True
+    from pathlib import Path
+    from agent.lilith_telegram_tts import selected_profile_is_current
+    try:
+        receipt = capture.artifacts.get(str(Path(path).resolve()))
+        if receipt is None:
+            return not capture.artifact_overflow
+        owner, profile, allowed = receipt
+        source = event.source
+        return (owner == (source.platform, source.chat_type, source.chat_id, source.user_id)
+                and allowed() is True and selected_profile_is_current(profile))
+    except Exception:
+        return False
+
+
+def final_speech_projector(event):
+    capture = getattr(event, "_lilith_speech_capture", None)
+    snapshot = getattr(capture, "snapshot", None)
+    generation = getattr(event, "_lilith_voice_generation", None)
+    if (type(capture) is not _EventSpeech or snapshot is None
+            or generation != (capture.session_key, capture.generation)):
+        return None
+
+    def project(text, profile):
+        from agent.speech_projection import project_speech
+        return project_speech(snapshot, text, speech_locale=profile["locale"])
+    return project
+
+
+def final_speech_authority_current(event):
+    from agent.speech_projection import speech_authority_is_current
+    capture = getattr(event, "_lilith_speech_capture", None)
+    return type(capture) is _EventSpeech and speech_authority_is_current(capture.snapshot)
