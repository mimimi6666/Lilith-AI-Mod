+    document["schemaVersion"] = schema
+    for introduction, field in ((5, "proactiveDialogueEnabled"), (4, "stopKey"),
+                                (3, "speechInputLanguage"), (2, "voiceLanguage")):
+        if schema < introduction:
+            document.pop(field)
+    # Older schemas must choose F12 as their first unoccupied migrated Stop.
+    if schema < 4:
+        document.update(pushToTalkKey="F8", textChatKey="F9", conversationHistoryKey="F11")
+    save(path, document)
+    original = path.read_bytes()
+    assert selector.read_selected_snapshot()["locale"] == ("zh" if schema == 1 else "ja")
+    assert path.read_bytes() == original
