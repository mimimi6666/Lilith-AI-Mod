+def _question_actors(text):
+    """Question perspective: you=Lilith, I=player; target pronouns are excluded by callers."""
+    own = re.search(r"你|妳|莉莉絲|莉莉丝|\byou\b|\byour\b|\blilith\b|あなた|リリス|君", text, re.I)
+    player = re.search(r"我|玩家|\bi\b|\bmy\b|\bme\b|\bplayer\b|私|僕|プレイヤー", text, re.I)
+    if re.search(r"我們|我们|雙方|双方|彼此|both|either|お互い|両方", text, re.I):
+        return ("player", "lilith")
+    return tuple(actor for actor, found in (("player", player), ("lilith", own)) if found)
