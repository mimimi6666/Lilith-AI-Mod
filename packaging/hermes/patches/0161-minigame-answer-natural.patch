+def _requested_check_actors(question, current):
+    actors = []
+    for clause in re.split(r"[。.!！?？;；\n]", question):
+        marker = re.search(r"被將軍|被将军|將軍了|将军了|in check|チェックされ|王手され|王手です", clause, re.I)
+        if marker:
+            for actor in _question_actors(clause[:marker.start()]) or (current,):
+                if actor not in actors:
