+def _visible_conversation_text(content: Any) -> str:
+    """Return only user-visible text carried by a durable message.
+
+    Structured provider payloads are accepted only through their explicit text
+    parts.  Images, reasoning blocks, tool payloads, and arbitrary objects are
+    not conversation text and therefore cannot move the durable recency
+    watermark by themselves.
+    """
+    if isinstance(content, str):
+        return content.strip()
+    if isinstance(content, dict):
+        if content.get("type") not in {"text", "input_text", "output_text"}:
+            return ""
+        value = content.get("text", content.get("content"))
+        return value.strip() if isinstance(value, str) else ""
+    if isinstance(content, list):
+        text_parts: list[str] = []
+        for part in content:
+            if not isinstance(part, dict) or part.get("type") not in {
+                "text",
+                "input_text",
+                "output_text",
+            }:
+                continue
+            value = part.get("text", part.get("content"))
+            if isinstance(value, str) and value.strip():
+                text_parts.append(value.strip())
+        return "\n".join(text_parts)
+    return ""
+
+
+def is_conversation_activity_message(message: Any) -> bool:
+    """Whether one durable row is genuine visible conversation activity.
+
+    This is the sole semantic predicate used by append, batch/rewrite, schema
+    migration, and live durable receipts.  It deliberately remains separate
+    from :func:`is_user_originated_turn`, whose callers need user-only turn
+    boundaries for retry/undo/compression.
+    """
+    if not isinstance(message, dict) or message.get("display_kind"):
+        return False
+
+    role = message.get("role")
+    if role == "user":
+        return is_user_originated_turn(message)
+    if role != "assistant":
+        return False
+    if is_compaction_summary_message(message):
+        return False
+    if message.get("tool_calls") or message.get("tool_call_id"):
+        return False
+
+    metadata = message.get("display_metadata")
+    metadata = metadata if isinstance(metadata, dict) else {}
+    # New turns carry an explicit origin.  Missing provenance is accepted only
+    # for legacy final rows written before the field existed; an explicit
+    # synthetic/internal origin is never guessed back into a user turn.
+    origin = metadata.get("hermes_turn_origin")
+    if origin not in {None, "", "user"}:
+        return False
+    kind = metadata.get("hermes_message_kind")
+    if kind not in {None, "", "primary"}:
+        return False
+    if metadata.get("terminal_error_turn_id"):
+        return False
+
+    finish_reason = message.get("finish_reason")
+    if isinstance(finish_reason, str) and finish_reason.strip().lower() in {
+        "error",
+        "failed",
+        "cancelled",
+        "canceled",
+        "timeout",
+        "aborted",
+    }:
+        return False
+    return bool(_visible_conversation_text(message.get("content")))
