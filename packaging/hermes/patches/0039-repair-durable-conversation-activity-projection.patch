+        or not isinstance(value.get("turn_origin_kind"), str)
+    ):
+        raise RuntimeError("durable message receipt was malformed")
+    return {
+        "source": "state.db",
+        "row_id": row_id,
+        "timestamp": float(timestamp),
+        "conversation_activity": value["conversation_activity"],
+        "turn_origin": value["turn_origin"],
