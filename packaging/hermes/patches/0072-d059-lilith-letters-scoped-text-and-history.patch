+"""Real isolated SessionDB contract; no player files, credentials or model calls."""
+import contextlib
+import json
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+from hermes_state import SessionDB
+from tui_gateway.letters_history import read_material, recall_safe, valid_params
+
+
+@pytest.fixture
+def fixture(tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session("game", "lilith-game")
+    turn = "a" * 32
+    key = "b" * 32
+    owner = SimpleNamespace(name="lilith_relationship", owns_user_profile_writes=lambda: True,
+                            filter_session_search_result=lambda args, raw: raw)
+    session = dict(agent=SimpleNamespace(_memory_manager=SimpleNamespace(_providers=[owner])),
+                   history_lock=threading.Lock(), history_version=1, source="lilith-game", archived=True,
+                   session_key="game", _durable_lineage_root="game")
+    params = dict(session_id="live", expected_stored_session_id="game", expected_lineage_root="game",
+                  references=[dict(key=key, stored_session_id="game", turn_id=turn)])
+    stamp = time.time() - 60
+    for role, identity, text in (("user", "c" * 32, "出差到下週，有點累"), ("assistant", "d" * 32, "先歇一下吧")):
+        meta = dict(hermes_turn_id=turn, hermes_message_id=identity,
+                    hermes_message_kind="user" if role == "user" else "primary", hermes_user_message_id="c" * 32)
+        db.append_message("game", role, text, timestamp=stamp, display_metadata=meta)
+        stamp += 1
+    proof = dict(stored_session_id="game", durable_lineage=dict(session_ids=["game"]))
+    def read(**kwargs):
+        return read_material(params, session, attest=kwargs.get("attest", lambda _: proof),
+                             database=lambda _: contextlib.nullcontext(db), authority_ok=kwargs.get("authority_ok", lambda: True))
+    yield SimpleNamespace(db=db, params=params, session=session, owner=owner, read=read)
+    db.close()
+
+
+def test_real_database_pair_is_read_without_modification(fixture):
+    before = fixture.db.get_messages("game")
+    result = fixture.read()
+    assert result["status"] == "ready"
+    assert [r["text"] for r in result["rows"]] == ["出差到下週，有點累", "先歇一下吧"]
+    assert fixture.db.get_messages("game") == before
+
+
+@pytest.mark.parametrize("field,value", [("source", "cli"), ("archived", False), ("running", True),
+    ("inflight_turn", "other"), ("_turn_cancel_requested", True), ("_finalized", True),
+    ("session_key", "foreign"), ("_durable_lineage_root", "foreign")])
+def test_non_game_or_busy_binding_fails_closed(fixture, field, value):
+    fixture.session[field] = value
+    assert fixture.read()["status"] == "unavailable"
+
+
+def test_forget_filter_removes_pair_without_erasing_transcript(fixture):
+    fixture.owner.filter_session_search_result = lambda _, raw: '{"success":true,"results":[]}'
+    assert fixture.read()["rows"] == []
+    assert len(fixture.db.get_messages("game")) == 2
+
+
+def test_missing_memory_owner_never_falls_back_to_raw_chat(fixture):
+    fixture.session["agent"]._memory_manager._providers = []
+    assert fixture.read()["status"] == "unavailable"
+
+
+def test_source_withdrawal_is_rechecked_on_every_read(fixture):
+    assert len(fixture.read()["rows"]) == 2
+    fixture.owner.filter_session_search_result = lambda _, raw: '{"success":false,"results":[]}'
+    assert fixture.read()["rows"] == []
+
+
+def test_unknown_lineage_reference_and_duplicate_pair_rejected(fixture):
+    fixture.params["references"][0]["stored_session_id"] = "foreign"
+    assert fixture.read()["status"] == "unavailable"
+    fixture.params["references"][0]["stored_session_id"] = "game"
+    row = fixture.db.get_messages("game")[0]
+    fixture.db.append_message("game", "user", row["content"], timestamp=time.time()-10, display_metadata=row["display_metadata"])
+    assert fixture.read()["rows"] == []
+
+
+def test_expired_rewound_and_hidden_material_not_recalled(fixture):
+    # All writes are confined to the pytest-owned synthetic database.
+    fixture.db._conn.execute("UPDATE messages SET active=0")
+    fixture.db._conn.commit()
+    assert fixture.read()["rows"] == []
+
+
+def test_history_lock_and_authority_revocation(fixture):
+    with fixture.session["history_lock"]:
+        assert fixture.read()["status"] == "unavailable"
+    assert fixture.read(authority_ok=lambda: False)["status"] == "unavailable"
+
+
+def test_exact_schema_and_reference_bound(fixture):
+    assert valid_params(fixture.params)
+    assert not valid_params(dict(fixture.params, injected="instructions"))
+    fixture.params["references"] *= 33
+    assert not valid_params(fixture.params)
