+        if len(_claims) < _CLAIM_CAPACITY:
+            _claims.add(operation)
+        if len(_event_claims) < _CLAIM_CAPACITY:
+            _event_claims.add(event)
+        if duplicate or full:
+            return _result(params)
+        if _active:
+            return _result(params, "busy")
