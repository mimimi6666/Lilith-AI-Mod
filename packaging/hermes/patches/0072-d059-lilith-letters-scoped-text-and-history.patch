+"""Bounded, read-only letter material from one attested game lineage."""
+import json
+import math
+import re
+import time
+
+_ID = re.compile(r"[0-9a-f]{32}\Z")
+_FIELDS = {"session_id", "expected_stored_session_id", "expected_lineage_root", "references"}
+
+
+def recall_safe(agent, payload):
+    """Reuse the authoritative provider's forgotten/corrected transcript filter.
+
+    A missing provider is NOT permission to expose raw transcripts. This does
+    not perform recall, model work, memory writes or return private memory.
+    """
+    manager = getattr(agent, "_memory_manager", None)
+    providers = getattr(manager, "_providers", ())
+    owners = [p for p in providers if p.name != "builtin" and p.owns_user_profile_writes()]
+    if len(owners) != 1 or owners[0].name != "lilith_relationship":
+        raise ValueError("letter memory authority unavailable")
+    encoded = json.dumps({"success": True, "results": [payload]}, ensure_ascii=False, sort_keys=True)
+    filtered = json.loads(owners[0].filter_session_search_result({}, encoded))
+    return filtered.get("success") is True and filtered.get("results") == [payload]
+
+
+def valid_params(params):
+    if not isinstance(params, dict) or set(params) != _FIELDS:
+        return False
+    if not all(isinstance(params[k], str) and 0 < len(params[k]) <= 256
+               for k in _FIELDS - {"references"}):
+        return False
+    refs = params["references"]
+    if not isinstance(refs, list) or not 1 <= len(refs) <= 32:
+        return False
+    seen = set()
+    for ref in refs:
+        if not isinstance(ref, dict) or set(ref) != {"key", "stored_session_id", "turn_id"}:
+            return False
+        if (not all(isinstance(ref[k], str) and _ID.fullmatch(ref[k]) for k in ("key", "turn_id"))
+                or not isinstance(ref["stored_session_id"], str) or not 0 < len(ref["stored_session_id"]) <= 256
+                or ref["key"] in seen):
+            return False
+        seen.add(ref["key"])
+    return True
+
+
+def read_material(params, session, *, attest, database, authority_ok):
+    if not valid_params(params):
+        raise ValueError("letter history request invalid")
+    empty = {"stored_session_id": params["expected_stored_session_id"], "status": "unavailable", "rows": []}
+    lock = session.get("history_lock")
+    if lock is None or not lock.acquire(blocking=False):
+        return empty
+    try:
+        agent = session.get("agent")
+        version = session.get("history_version")
+        if (not authority_ok() or session.get("source") != "lilith-game" or session.get("archived") is not True
+                or session.get("running") or session.get("inflight_turn") is not None
+                or session.get("_turn_cancel_requested") or session.get("_finalized")
+                or session.get("session_key") != params["expected_stored_session_id"]
+                or session.get("_durable_lineage_root") != params["expected_lineage_root"]):
+            return empty
+        proof = attest(session)
+        ids = proof["durable_lineage"]["session_ids"]
+        if (not isinstance(ids, list) or not 1 <= len(ids) <= 64 or len(set(ids)) != len(ids)
+                or ids[0] != params["expected_lineage_root"] or ids[-1] != params["expected_stored_session_id"]
+                or any(r["stored_session_id"] not in ids for r in params["references"])):
+            return empty
+        turn_ids = list(dict.fromkeys(r["turn_id"] for r in params["references"]))
+        # Only exact indexed turns and visible user/primary rows. SQL parameters
+        # carry all identifiers. No all-session projection, resume or repair.
+        sql = ("SELECT id, session_id, role, content, timestamp, display_metadata FROM messages "
+               "WHERE active=1 AND session_id IN (" + ",".join("?" for _ in ids) + ") "
+               "AND role IN ('user','assistant') AND COALESCE(display_kind,'') != 'hidden' "
+               "AND length(content)<=128000 AND length(display_metadata)<=16384 "
+               "AND json_valid(display_metadata) "
+               "AND json_extract(display_metadata,'$.hermes_turn_id') IN (" + ",".join("?" for _ in turn_ids) + ") "
+               "AND json_extract(display_metadata,'$.hermes_message_kind') IN ('user','primary') "
+               "ORDER BY id LIMIT 129")
+        now = time.time()
+        with database(session) as db:
+            if db is None:
+                return empty
+            with db._read_ctx() as connection:
+                raw = connection.execute(sql, (*ids, *turn_ids)).fetchall()
+        if len(raw) > 128:
+            return empty
+        rows = []
+        budget = 24000
+        for ref in params["references"]:
+            matched = []
+            for value in raw:
+                row = dict(value)
+                meta = json.loads(row["display_metadata"])
+                if meta.get("hermes_turn_id") != ref["turn_id"]:
+                    continue
+                stamp = row["timestamp"]
+                if (not isinstance(stamp, (float, int)) or isinstance(stamp, bool)
+                        or not math.isfinite(stamp) or not now - 86400 <= stamp <= now):
+                    continue
+                text = db._decode_content(row["content"])
+                if not isinstance(text, str) or not text.strip():
+                    continue
+                message_id = meta.get("hermes_message_id")
+                if not isinstance(message_id, str) or not _ID.fullmatch(message_id):
+                    continue
+                kind = meta.get("hermes_message_kind")
+                if row["role"] == "user" and (kind != "user" or meta.get("hermes_user_message_id") != message_id):
+                    continue
+                if row["role"] == "assistant" and kind != "primary":
+                    continue
+                matched.append({"role": row["role"], "text": text, "message_id": message_id,
+                                "turn_id": ref["turn_id"], "message_kind": kind,
+                                "timestamp_ms": int(stamp * 1000)})
+            if len(matched) != 2 or {m["role"] for m in matched} != {"user", "assistant"}:
+                continue
+            size = sum(len(m["text"]) for m in matched)
+            if size > budget or not recall_safe(agent, matched):
+                continue
+            budget -= size
+            rows.extend(matched)
+        if (not authority_ok() or session.get("agent") is not agent or session.get("history_version") != version
+                or attest(session) != proof):
+            return empty
+        return {"stored_session_id": params["expected_stored_session_id"], "status": "ready", "rows": rows}
+    except Exception:
+        return empty
+    finally:
+        lock.release()
