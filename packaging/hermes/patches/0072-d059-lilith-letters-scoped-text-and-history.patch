+"""Candidate tests: synthetic sessions/providers only; no player data or network."""
+import json
+import threading
+import time
+import uuid
+from types import SimpleNamespace
+
+import pytest
+
+from tui_gateway import letters_text, server
+from test_note_draft import isolated, setup as old_setup
+
+
+@pytest.mark.parametrize("field", ["expected_stored_session_id", "expected_lineage_root"])
+def test_host_expected_lineage_must_match_before_dispatch(monkeypatch, field):
+    agent, _, params = setup(monkeypatch)
+    params[field] = "wrong"
+    assert invoke(params)["result"]["status"] == "failed" and not agent.calls
+
+
+def test_first_stage_cannot_be_skipped(monkeypatch):
+    agent, _, params = setup(monkeypatch)
+    params.update(stage="draft", system_prompt=letters_text._PROMPTS["draft"])
+    assert invoke(params)["result"]["status"] == "failed" and not agent.calls
+
+
+def test_identity_guard_failure_is_not_bypassed(monkeypatch):
+    from agent import identity_policy
+    agent, _, params = setup(monkeypatch)
+    def reject(*args, **kwargs):
+        raise identity_policy.IdentityPolicyError("PRIVATE_FAILURE")
+    monkeypatch.setattr(identity_policy, "assert_scoped_identity_prompt", reject)
+    result = invoke(params)["result"]
+    assert result["status"] == "failed" and not agent.calls
+    assert "PRIVATE" not in json.dumps(result)
+
+
+def test_full_ledger_cannot_evict_or_retry(monkeypatch):
+    agent, _, params = setup(monkeypatch)
+    monkeypatch.setattr(letters_text, "_CLAIM_CAPACITY", 1)
+    assert invoke(params)["result"]["status"] == "ready"
+    params.update(operation_id=uuid.uuid4().hex, stage="draft", system_prompt=letters_text._PROMPTS["draft"])
+    assert invoke(params)["result"]["status"] == "failed" and len(agent.calls) == 1
+
+
+@pytest.fixture(autouse=True)
+def reset_candidate(monkeypatch, isolated):
+    monkeypatch.setattr(letters_text, "_claims", set())
+    monkeypatch.setattr(letters_text, "_event_claims", set())
+    monkeypatch.setattr(letters_text, "_packets", {})
+    monkeypatch.setattr(letters_text, "_active", False)
+
+
+def setup(monkeypatch, provider="deepseek"):
+    agent, session, _ = old_setup(monkeypatch, provider)
+    owner = SimpleNamespace(name="lilith_relationship", owns_user_profile_writes=lambda: True,
+                            filter_session_search_result=lambda args, result: result)
+    agent._memory_manager = SimpleNamespace(_providers=[owner])
+    monkeypatch.setattr(server, "_sess_nowait", lambda *args: (session, None))
+    params = dict(session_id="game-session", expected_stored_session_id="tip",
+                  expected_lineage_root="root", operation_id=uuid.uuid4().hex,
+                  packet_id=uuid.uuid4().hex, stage="classify",
+                  system_prompt=letters_text._PROMPTS["classify"], maximum_reply_characters=20000)
+    params["data_json"] = json.dumps({"packet_id": params["packet_id"], "PlayerText": "最近好累"})
+    agent.payload = {"packet_id": params["packet_id"], "decisions": []}
+    return agent, session, params
+
+
+def invoke(params):
+    return server._methods["prompt.letters_text"]("letters-fixture", params)
+
+
+@pytest.mark.parametrize("provider", ["gemini", "deepseek"])
+def test_three_stages_no_history_tools_or_primary_mutation(monkeypatch, provider):
+    agent, session, params = setup(monkeypatch, provider)
+    for stage in ("classify", "draft", "review"):
+        params.update(operation_id=uuid.uuid4().hex, stage=stage, system_prompt=letters_text._PROMPTS[stage])
+        result = invoke(params)["result"]
+        assert result["status"] == "ready" and result["stage"] == stage
+        assert json.loads(result["text"]) == agent.payload
+    assert len(agent.calls) == 3 and agent.closed == agent.clients
+    for wire in agent.calls:
+        assert not wire.get("tools") and not wire.get("tool_choice")
+        assert wire["model"] == agent.model and wire["stream"] is False
+        assert "HISTORY_MUST_NOT_ENTER_DRAFT" not in json.dumps(wire)
+        assert "MEMORY_MUST_NOT_ENTER_DRAFT" not in json.dumps(wire)
+        assert wire["messages"][0]["content"].startswith("SOUL\n\nPERSONA\n\n")
+        assert json.loads(wire["messages"][1]["content"])["PlayerText"] == "最近好累"
+    assert not agent.run_conversation.called and session["history_version"] == 2
+    assert agent.reasoning_config == {"enabled": True, "effort": "high"}
+    assert agent._ephemeral_max_output_tokens == 8000 and agent.max_tokens == 9000
+
+
+@pytest.mark.parametrize("fault", ["prompt", "packet", "duplicate", "maximum", "bool", "extra", "stage", "data_bound"])
+def test_bad_inputs_never_dispatch(monkeypatch, fault):
+    agent, _, params = setup(monkeypatch)
+    if fault == "prompt": params["system_prompt"] = "override"
+    if fault == "packet": params["data_json"] = '{"packet_id":"wrong"}'
+    if fault == "duplicate": params["data_json"] = params["data_json"].replace('"packet_id":', '"packet_id":"wrong","packet_id":')
+    if fault == "maximum": params["maximum_reply_characters"] = 20001
+    if fault == "bool": params["maximum_reply_characters"] = True
+    if fault == "extra": params["tools"] = []
+    if fault == "stage": params["stage"] = "send"
+    if fault == "data_bound": params["data_json"] = "x" * 200001
+    assert "error" in invoke(params) and not agent.calls
+
+
+@pytest.mark.parametrize("change", ["model", "provider", "identity", "key", "tip", "root", "history", "running", "quarantine"])
+@pytest.mark.parametrize("when", ["before_client", "during", "between_stages"])
+def test_authority_drift_never_accepts_or_falls_back(monkeypatch, change, when):
+    agent, session, params = setup(monkeypatch)
+    def mutate():
+        if change in {"model", "provider"}: setattr(agent, change, "changed")
+        if change == "identity": agent._identity_soul_content = "changed"
+        if change == "key": agent.api_key = "changed"
+        if change == "tip": session["session_key"] = "changed"
+        if change == "root": session["_durable_lineage_root"] = "changed"
+        if change == "history": session["history_version"] += 1
+        if change == "running": session["running"] = True
+        if change == "quarantine": monkeypatch.setattr(server, "_native_authority_quarantine_rpc_error", lambda _: {"error": {}})
+    if when == "between_stages":
+        assert invoke(params)["result"]["status"] == "ready"
+        mutate()
+        params.update(operation_id=uuid.uuid4().hex, stage="draft", system_prompt=letters_text._PROMPTS["draft"])
+    elif when == "before_client": agent.on_create = mutate
+    else: agent.on_request = mutate
+    assert invoke(params)["result"]["status"] in {"failed", "busy"}
+    assert len(agent.calls) == (0 if when == "before_client" else 1)
+    assert agent.closed == agent.clients
+
+
+@pytest.mark.parametrize("mode", ["anthropic_messages", "codex_responses", "bedrock_converse", "acp"])
+def test_unsupported_transport_has_no_fallback(monkeypatch, mode):
+    agent, _, params = setup(monkeypatch)
+    agent.api_mode = mode
+    assert invoke(params)["result"]["status"] == "failed" and not agent.calls
+
+
+def test_timeout_quarantines_worker_and_burns_packet(monkeypatch):
+    agent, _, params = setup(monkeypatch)
+    release = threading.Event()
+    monkeypatch.setattr(letters_text, "_DEADLINE_SECONDS", 0.15)
+    agent.on_request = lambda: release.wait(4)
+    try:
+        before = time.monotonic()
+        assert invoke(params)["result"]["status"] == "failed"
+        assert time.monotonic() - before < 2
+        assert invoke(params)["result"]["status"] == "failed"
+        other = dict(params, operation_id=uuid.uuid4().hex, packet_id=uuid.uuid4().hex)
+        other["data_json"] = json.dumps({"packet_id": other["packet_id"]})
+        assert invoke(other)["result"]["status"] == "busy"
+        assert len(agent.calls) == 1
+    finally:
+        release.set()
+        deadline = time.monotonic() + 3
+        while letters_text._active and time.monotonic() < deadline:
+            threading.Event().wait(0.01)
+    assert not letters_text._active and agent.closed == agent.clients
+
+
+def test_failed_stage_cannot_be_retried_or_skipped(monkeypatch):
+    agent, _, params = setup(monkeypatch)
+    agent.payload = "x" * 20001
+    assert invoke(params)["result"]["status"] == "failed"
+    params["operation_id"] = uuid.uuid4().hex
+    assert invoke(params)["result"]["status"] == "failed"
+    params.update(operation_id=uuid.uuid4().hex, stage="review", system_prompt=letters_text._PROMPTS["review"])
+    assert invoke(params)["result"]["status"] == "failed" and len(agent.calls) == 1
+
+@pytest.mark.parametrize("provider", ["gemini", "deepseek"])
+@pytest.mark.parametrize("status_code", [200, 429, 500])
+def test_candidate_real_native_adapters_with_fake_http_one_attempt(monkeypatch, provider, status_code):
+    import httpx
+    from agent.gemini_native_adapter import GeminiNativeClient
+    from openai import OpenAI
+
+    agent, _, params = setup(monkeypatch, provider)
+    physical = []
+
+    def wire(request):
+        physical.append(request)
+        if status_code != 200:
+            return httpx.Response(status_code, json={"error": {"message": "fake unavailable"}})
+        content = json.dumps(agent.payload, ensure_ascii=False)
+        if provider == "gemini":
+            payload = {"candidates": [{"content": {"role": "model", "parts": [{"text": content}]},
+                                      "finishReason": "STOP"}]}
+        else:
+            payload = {"id": "fake", "object": "chat.completion", "created": 1,
+                       "model": agent.model, "choices": [{"index": 0, "finish_reason": "stop",
+                       "message": {"role": "assistant", "content": content}}]}
+        return httpx.Response(200, json=payload)
+
+    http = httpx.Client(transport=httpx.MockTransport(wire))
+    if provider == "gemini":
+        client = GeminiNativeClient(api_key=agent.api_key, base_url=agent.base_url, http_client=http)
+    else:
+        client = OpenAI(api_key=agent.api_key, base_url=agent.base_url, http_client=http, max_retries=0)
+    monkeypatch.setattr(agent, "_create_request_openai_client", lambda **kwargs: client)
+    try:
+        result = invoke(params)["result"]
+        assert result["status"] == ("ready" if status_code == 200 else "failed")
+        assert len(physical) == 1
+        body = json.loads(physical[0].content)
+        assert not body.get("tools")
+        assert "HISTORY_MUST_NOT_ENTER_DRAFT" not in physical[0].content.decode()
+        assert "MEMORY_MUST_NOT_ENTER_DRAFT" not in physical[0].content.decode()
+        if provider == "gemini":
+            assert physical[0].url.path.endswith(":generateContent")
+            assert body["systemInstruction"]["parts"][0]["text"].startswith("SOUL\n\nPERSONA\n\n")
+        else:
+            assert physical[0].url.path.endswith("/chat/completions")
+            assert body["messages"][0]["content"].startswith("SOUL\n\nPERSONA\n\n")
+    finally:
+        client.close()
