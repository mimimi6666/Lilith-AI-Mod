+_PARAMS = {"session_id", "expected_stored_session_id", "expected_lineage_root",
+           "operation_id", "packet_id", "stage", "system_prompt", "data_json",
+           "maximum_reply_characters"}
+_GUID_N = re.compile(r"[0-9a-f]{32}\Z")
+_DEADLINE_SECONDS = 15.0
+_CLAIM_CAPACITY = 256
+_claims: set[str] = set()
+_event_claims: set[str] = set()
+_packets = {}
