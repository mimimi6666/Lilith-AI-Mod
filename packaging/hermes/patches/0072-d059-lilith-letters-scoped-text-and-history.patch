+        return False
+    try:
+        data = json.loads(params["data_json"], object_pairs_hook=_unique,
+                          parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
+        return isinstance(data, dict) and data.get("packet_id") == params["packet_id"]
+    except (ValueError, RecursionError):
+        return False
+
+
+def _result(params, status="failed", text=""):
+    return {"operation_id": params["operation_id"], "packet_id": params["packet_id"],
+            "stage": params["stage"], "status": status, "text": text}
+
+
+def _snapshot(agent):
+    # Private, in-memory only. Never log/serialize this credential-bearing proof.
+    keys = ("provider", "requested_provider", "model", "base_url", "api_mode",
+            "api_key", "auth_mode", "_client_kwargs", "request_overrides",
+            "_cached_system_prompt")
+    values = {key: getattr(agent, key, None) for key in keys}
+    values.update({key: value for key, value in vars(agent).items()
+                   if key.startswith("_identity_")})
+    return copy.deepcopy(values)
+
+
+def complete_text(params, session, *, attest, authority_ok):
+    """Return an exact typed result by the deadline, even if a worker wedges.
+
+    Claims never expire/evict within the process: a failed, busy or timed-out
+    operation cannot regenerate. Capacity exhaustion fails closed. A timed-out
+    worker retains the one note slot until it actually exits; its late result
+    has no route back to the game. Only its request-local socket may be aborted.
+    """
+    global _active
+    if not valid_params(params):
