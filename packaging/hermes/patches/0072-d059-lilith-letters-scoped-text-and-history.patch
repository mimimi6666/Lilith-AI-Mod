+
+def _unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate letter field")
+        result[key] = value
+    return result
+
+
+def valid_params(params):
+    if not isinstance(params, dict) or set(params) != _PARAMS:
+        return False
+    if not all(isinstance(params[key], str) for key in _PARAMS - {"maximum_reply_characters"}):
+        return False
+    if (type(params["maximum_reply_characters"]) is not int
+            or not 1 <= params["maximum_reply_characters"] <= 20000
+            or params["stage"] not in _PROMPTS
+            or params["system_prompt"] != _PROMPTS[params["stage"]]
+            or not all(0 < len(params[k]) <= 256 and not any(ord(c) < 32 for c in params[k])
