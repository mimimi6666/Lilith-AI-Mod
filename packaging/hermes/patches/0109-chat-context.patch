+"""Pure request-side history helpers. No storage, recall, model call or authority.
+
+Only identical host-appended plugin envelopes may be deduplicated. Unknown or
+changed sidecars stay intact; literal player text is never parsed as a sidecar.
+"""
+from copy import deepcopy
+import hashlib
+import json
+
+_START = "[Subordinate operational context: pre_llm_call plugin context]\n"
+_END = "[End subordinate operational context: pre_llm_call plugin context]"
+_REMOVED = "\n\n[Identical historical host context omitted; retained on a later message.]"
+_CONTENT_FIELDS = ("role", "content", "tool_calls", "tool_call_id", "function_call")
+
+
+def semantic_key(rows):
+    """Transport bookkeeping/reasoning echo is not a new conversation exchange.
+
+    The caller separately checks immutable full source digests and exact native
+    send transformations. Every visible argument, result and multimodal block
+    remains in this coverage key; it is not a fuzzy-text similarity test.
+    """
+    data = [{k: row[k] for k in _CONTENT_FIELDS if k in row} for row in rows]
+    return hashlib.sha256(json.dumps(data, sort_keys=True, ensure_ascii=True,
+                                    separators=(",", ":"), allow_nan=False).encode()).hexdigest()
+
+
+def summary_scope(agent, origin, spec):
+    from agent.identity_policy import policy_for_agent
+    policy = policy_for_agent(agent)
+    route = tuple(str(getattr(agent, key, ""))
+                  for key in ("model", "provider", "api_mode", "base_url"))
+    return (agent.session_id, origin.ledger.policy.level, origin.ledger.policy.version,
+            route, policy.enabled, policy.fingerprint, repr(spec))
+
+
+def _plugin_suffix(source, actual):
+    if (not isinstance(source, dict) or not isinstance(actual, dict)
+            or source.get("role") != "user" or actual.get("role") != "user"
+            or source.get("display_kind") not in (None, "", "user")):
+        return None
+    clean, sidecar, content = source.get("content"), source.get("api_content"), actual.get("content")
+    if (not all(isinstance(text, str) for text in (clean, sidecar, content))
+            or not clean or not sidecar.startswith(clean + "\n\n")
+            or not content.startswith(clean + "\n\n")):
+        return None
+    suffix = sidecar[len(clean) + 2:]
+    if (not suffix.startswith(_START) or not suffix.endswith(_END)
+            or suffix.count(_START) != 1 or suffix.count(_END) != 1
+            or not content.endswith("\n\n" + suffix)):
+        return None
+    return suffix
+
+
+def dedupe_sidecars(projected, source, offset, allowed, visible=None):
+    """Return replacements only; the latest surviving copy always stays full.
+
+    `allowed` consists exclusively of verified historical projection units.
+    Fresh current memory may precede the current plugin block, but that row is
+    never eligible for replacement. The scan is restricted to surviving rows,
+    so we cannot point at a later copy that was itself removed by a summary.
+    """
+    if source is None or len(projected) != len(source) + offset:
+        return {}, 0
+    visible = range(len(projected)) if visible is None else visible
+    replacements, seen, saved = {}, set(), 0
+    for index in sorted(visible, reverse=True):
+        original_index = index - offset
+        if not 0 <= original_index < len(source):
+            continue
+        suffix = _plugin_suffix(source[original_index], projected[index])
+        if suffix is None:
+            continue
+        key = hashlib.sha256(suffix.encode("utf-8")).digest()
+        # Exact equality is retained as a second check, not hash-only deletion.
+        identity = (key, suffix)
+        if identity in seen and index in allowed and len(suffix) > len(_REMOVED):
+            row = deepcopy(projected[index])
+            row["content"] = row["content"][:-(len(suffix) + 2)] + _REMOVED
+            replacements[index] = row
+            saved += len(projected[index]["content"]) - len(row["content"])
+        seen.add(identity)
+    return replacements, saved
+
+
+def content_counts(rows):
+    """Character counts only; deliberately not labelled provider token usage."""
+    counts = {"chat_chars": 0, "tool_chars": 0, "system_chars": 0}
+    for row in rows:
+        content = row.get("content")
+        if not isinstance(content, str):
+            continue  # images/structured payloads are not estimated as text
+        role = row.get("role")
+        key = "tool_chars" if role == "tool" else "system_chars" if role in ("system", "developer") else "chat_chars"
+        counts[key] += len(content)
+    return counts
