--- /dev/null
+++ b/tests/test_chat_context.py
@@ -0,0 +1,267 @@
+from copy import deepcopy
+import json
+from types import SimpleNamespace
+import unittest
+
+from agent.usage_budget import NormalBudget, VerifiedModelLimits, resolve_policy, TurnBudgetLedger
+from agent.usage_budget_context import capture_completed_history, _strategy_projection_units
+from agent.usage_strategy import strategy_for_level
+from agent.usage_strategy_context import project_context, compact_results
+from agent.history_context import semantic_key, dedupe_sidecars
+
+
+SUFFIX = ("[Subordinate operational context: pre_llm_call plugin context]\n"
+          + "Fixture operational context; not identity or permission. " * 16
+          + "\n[End subordinate operational context: pre_llm_call plugin context]")
+
+
+def origin(key="one", level=4, revision=1):
+    policy = resolve_policy(level, NormalBudget(max_iterations=90), VerifiedModelLimits(), version=revision)
+    return SimpleNamespace(origin_id=key, ledger=TurnBudgetLedger(key, policy))
+
+
+def transcript(turns=36, tools=True, sidecar=False):
+    source = []
+    for i in range(turns):
+        user = {"role": "user", "content": f"question {i}"}
+        if sidecar:
+            user["api_content"] = user["content"] + "\n\n" + SUFFIX
+        source.append(user)
+        if tools:
+            source.extend([
+                {"role": "assistant", "content": "", "tool_calls": [{"id": f"call-{i}", "type": "function",
+                 "call_id": f"call-{i}", "response_item_id": f"response-{i}",
+                 "extra_content": {"signature": "fixture"},
+                 "function": {"name": "fixture_read", "arguments": json.dumps({"number": i})}}]},
+                {"role": "tool", "tool_call_id": f"call-{i}", "content": f"result {i}"}])
+        source.append({"role": "assistant", "content": f"answer {i}", "reasoning_content": "fixture echo"})
+    source.append({"role": "user", "content": "current request"})
+    return source
+
+
+def normalize(row, keep_signature=False):
+    if isinstance(row.get("tool_calls"), list):
+        row["tool_calls"] = [{k: v for k, v in call.items()
+                              if k not in {"call_id", "response_item_id"}
+                              and (keep_signature or k != "extra_content")} for call in row["tool_calls"]]
+
+
+def project(source, normalizer=normalize):
+    rows = [{"role": "system", "content": "protected identity"}] + deepcopy(source)
+    from agent.turn_context import substitute_api_content
+    for row in rows[1:]:
+        substitute_api_content(row)
+        normalizer(row)
+    return rows
+
+
+def units(agent, source, rows, normalizer=normalize):
+    history = capture_completed_history(source, len(source)-1)
+    return _strategy_projection_units(agent, history, source, rows, 1, normalize_tool_calls=normalizer)
+
+
+class Compressor:
+    def __init__(self):
+        self.calls = []
+        self._previous_summary = "native compressor state must not change"
+
+    def _generate_summary(self, rows):
+        self.calls.append((deepcopy(rows), self._previous_summary))
+        return "Historical context: fixture facts and unfinished work retained."
+
+
+class ChatContextTests(unittest.TestCase):
+    def setUp(self):
+        self.agent = SimpleNamespace(session_id="fixture", model="model", provider="provider",
+                                     api_mode="chat_completions", context_compressor=Compressor())
+
+    def run_projection(self, source, handle=None):
+        rows = project(source)
+        handle = handle or origin()
+        return project_context(self.agent, rows, units(self.agent, source, rows),
+                               strategy_for_level(handle.ledger.policy.level), handle,
+                               source=source, history_offset=1)
+
+    def test_actual_sanitizer_parity_recovers_completed_tool_exchanges(self):
+        source = transcript(52)
+        rows = project(source)
+        history = capture_completed_history(source, len(source)-1)
+        self.assertEqual(_strategy_projection_units(self.agent, history, source, rows, 1), ())
+        self.assertEqual(len(units(self.agent, source, rows)), 51)
+
+    def test_changed_arguments_results_ids_and_unknown_metadata_are_not_accepted(self):
+        for location, field, value in [(2, "content", "not original"), (3, "content", "changed result"),
+                                        (3, "tool_call_id", "wrong")]:
+            source = transcript(3)
+            rows = project(source)
+            rows[location][field] = value
+            self.assertNotIn(tuple(range(1, 5)), units(self.agent, source, rows))
+        for field, value in [("id", "wrong"), ("unknown", "new"),
+                             ("function", {"name": "fixture_read", "arguments": "{\"number\":9}"})]:
+            source = transcript(3)
+            rows = project(source)
+            rows[2]["tool_calls"][0][field] = value
+            self.assertEqual(len(units(self.agent, source, rows)), 1)
+
+    def test_retained_signature_must_match_the_resolved_route(self):
+        normalizer = lambda row: normalize(row, keep_signature=True)
+        source = transcript(3)
+        rows = project(source, normalizer)
+        self.assertEqual(len(units(self.agent, source, rows, normalizer)), 2)
+        rows[2]["tool_calls"][0]["extra_content"] = {"signature": "wrong"}
+        self.assertEqual(len(units(self.agent, source, rows, normalizer)), 1)
+
+    def test_source_mutation_after_capture_fails_closed(self):
+        source = transcript(3)
+        history = capture_completed_history(source, len(source)-1)
+        source[0]["content"] = "modified after capture"
+        self.assertEqual(len(_strategy_projection_units(self.agent, history, source, project(source), 1,
+                                                       normalize_tool_calls=normalize)), 1)
+
+    def test_incomplete_tool_chain_is_never_captured(self):
+        source = transcript(4)
+        source[2]["tool_call_id"] = "unmatched"
+        source[5]["tool_calls"].append({"id": "missing", "function": {"name": "x", "arguments": "{}"}})
+        self.assertEqual(len(units(self.agent, source, project(source))), 1)
+
+    def test_source_and_current_input_remain_unchanged_and_recent_24_retained(self):
+        source = transcript(60)
+        before = deepcopy(source)
+        output = self.run_projection(source)
+        self.assertEqual(source, before)
+        self.assertEqual(output[-1], before[-1])
+        self.assertEqual(output[0]["content"], "protected identity")
+        users = [r["content"] for r in output if r["role"] == "user" and r["content"].startswith("question ")]
+        self.assertEqual(users, [f"question {i}" for i in range(36, 60)])
+        for row in output:
+            if row["role"] == "tool":
+                self.assertIn(row["tool_call_id"], {c["id"] for r in output for c in r.get("tool_calls", [])})
+
+    def test_incremental_updates_receive_only_new_exchanges_and_previous_summary(self):
+        self.run_projection(transcript(36, tools=False))
+        self.run_projection(transcript(37, tools=False), origin("two"))
+        self.run_projection(transcript(38, tools=False), origin("three"))
+        calls = self.agent.context_compressor.calls
+        self.assertEqual([len(c[0]) for c in calls], [24, 4])
+        self.assertIsNone(calls[0][1])
+        self.assertEqual(calls[1][1], "Historical context: fixture facts and unfinished work retained.")
+        self.assertEqual(self.agent.context_compressor._previous_summary, "native compressor state must not change")
+
+    def test_transport_only_metadata_and_reasoning_echo_do_not_rebuild_summary(self):
+        source = transcript(36, tools=False)
+        self.run_projection(source)
+        for row in source:
+            row["_db_persisted"] = True
+            row["reasoning_content"] = "changed transport echo"
+        self.run_projection(source, origin("two"))
+        self.assertEqual(len(self.agent.context_compressor.calls), 1)
+
+    def test_real_old_text_edit_invalidates_coverage(self):
+        source = transcript(36, tools=False)
+        self.run_projection(source)
+        source[0]["content"] = "corrected prior question"
+        self.run_projection(source, origin("two"))
+        self.assertEqual(len(self.agent.context_compressor.calls), 2)
+        self.assertIsNone(self.agent.context_compressor.calls[-1][1])
+
+    def test_model_session_identity_and_strategy_revision_invalidate_summary(self):
+        for attribute in ("model", "provider", "api_mode", "base_url", "session_id", "fingerprint"):
+            with self.subTest(attribute=attribute):
+                self.setUp()
+                source = transcript(36, tools=False)
+                self.run_projection(source)
+                setattr(self.agent, attribute, "new")
+                self.run_projection(source, origin("two"))
+                self.assertEqual(len(self.agent.context_compressor.calls), 2)
+        self.setUp()
+        self.run_projection(transcript())
+        self.run_projection(transcript(), origin("two", revision=2))
+        self.assertEqual(len(self.agent.context_compressor.calls), 2)
+
+    def test_tool_passes_do_not_repeat_summary(self):
+        handle, source = origin(), transcript()
+        for _ in range(10):
+            self.run_projection(source, handle)
+        self.assertEqual(len(self.agent.context_compressor.calls), 1)
+
+    def test_failure_keeps_uncovered_originals(self):
+        def fail(_rows):
+            raise RuntimeError("fixture failure")
+        self.agent.context_compressor._generate_summary = fail
+        source = transcript()
+        self.assertEqual(self.run_projection(source), project(source))
+
+    def test_stop_during_summary_never_accepts_coverage(self):
+        handle, source = origin(), transcript()
+        def stopped(_rows):
+            handle.ledger.stop()
+            return "must not become coverage"
+        self.agent.context_compressor._generate_summary = stopped
+        self.assertEqual(self.run_projection(source, handle), project(source))
+        self.assertEqual(self.agent._information_summary["covered"], ())
+
+    def test_only_identical_proven_historical_sidecar_suffix_is_deduped(self):
+        source = transcript(4, tools=False, sidecar=True)
+        rows = project(source)
+        before = deepcopy(rows)
+        changes, saved = dedupe_sidecars(rows, source, 1, {1, 3, 5})
+        self.assertEqual(set(changes), {1, 3, 5})
+        self.assertGreater(saved, 0)
+        self.assertEqual(rows, before)
+        self.assertTrue(rows[7]["content"].endswith(SUFFIX))
+        self.assertTrue(changes[1]["content"].startswith("question 0\n\n"))
+
+    def test_sidecar_different_unknown_memory_multimodal_and_literal_text_are_preserved(self):
+        for change in ("different", "unknown", "memory", "multimodal", "literal", "mismatch"):
+            source = transcript(3, tools=False, sidecar=True)
+            if change == "different": source[0]["api_content"] += " changed"
+            if change == "unknown": source[0]["api_content"] = "question 0\n\nunknown context"
+            if change == "memory": source[0]["api_content"] = "question 0\n\n<memory-context>\nold value"
+            if change == "multimodal": source[0]["content"] = [{"type": "text", "text": "question 0"}]
+            if change == "literal": source[0]["content"] += "\n\n" + SUFFIX
+            rows = project(source)
+            if change == "mismatch": rows[1]["content"] = "transformed message"
+            changes, _ = dedupe_sidecars(rows, source, 1, {1})
+            self.assertNotIn(1, changes, change)
+
+    def test_dedupe_only_points_at_surviving_later_copy(self):
+        source = transcript(3, tools=False, sidecar=True)
+        rows = project(source)
+        changes, _ = dedupe_sidecars(rows, source, 1, {1, 3}, visible={0, 1, 2, 3, 4, 7})
+        self.assertEqual(set(changes), {1})
+
+    def test_current_ephemeral_memory_is_not_deduped_or_persisted(self):
