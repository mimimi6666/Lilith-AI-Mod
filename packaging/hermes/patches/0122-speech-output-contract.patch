+def with_paired_delivery_guidance(agent, system_prompt):
+    """Append a fixed format suffix only for the exact active host-owned pair.
+
+    Call in the effective-system composer before identity checks, budget and
+    cache planning, including failover rebuilds. Do not mutate cached identity
+    bytes, historical rows, provider kwargs or the paired acceptance rules.
+    """
+    if state_for(agent) is None or type(system_prompt) is not str:
+        return system_prompt
+    if system_prompt.endswith(SYSTEM_OUTPUT_CONTRACT):
+        return system_prompt
+    return (system_prompt + "\n\n" if system_prompt else "") + SYSTEM_OUTPUT_CONTRACT
+
+
