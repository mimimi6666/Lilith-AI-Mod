+# Exact host-generated templates from native108 and native118-123. The nonce
+# alone is normalized. Unknown wording is not ours to remove from a sidecar.
+_LEGACY_CONTRACT_HASHES = frozenset({
+    "301cbda82c0bd5f024767c1cad43f47635e62e7906adce9ded77d6f7f860adcd",
+    "de5ebb4157a6b96a89cd78cedf9a76d36c4f29a3322c6c102aa71cb4b786e94d",
+})
+_HOST_OPEN = re.compile(r'<lilith_speech id="([a-f0-9]{32})" locale="ja">')
+
+
+def _host_contract_digest(block):
+    if (type(block) is not str or len(block) > 4096
+            or not block.startswith("Host presentation contract for THIS turn only:")):
+        return None, None
+    matches = list(_HOST_OPEN.finditer(block))
+    if len(matches) != 1:
+        return None, None
+    match = matches[0]
+    normalized = block[:match.start(1)] + "0" * 32 + block[match.end(1):]
+    return hashlib.sha256(normalized.encode("utf-8")).hexdigest(), match[1]
+
+
+def project_historical_speech(agent, source, actual):
+    """Remove only an exact old host format from a historical USER send copy.
+
+    Caller owns the historical-index decision. Sidecar provenance and exact
+    clean-text suffix are required; no parsing of player text, multimodal rows,
+    assistant reasoning, generic plugin envelopes or unknown sidecar versions.
+    Original rows and every other host note remain byte-for-byte untouched.
+    """
+    state = state_for(agent)
+    if (state is None or type(source) is not dict or type(actual) is not dict
+            or source.get("role") != "user" or actual.get("role") != "user"
+            or source.get("display_kind") not in (None, "", "user")):
+        return actual
+    clean, sidecar = source.get("content"), source.get("api_content")
+    if (type(clean) is not str or not clean or type(sidecar) is not str
+            or type(actual.get("content")) is not str or actual["content"] != sidecar
+            or not sidecar.endswith("\n\n" + clean)):
+        return actual
+    prefix = sidecar[:-(len(clean) + 2)]
+    if len(prefix) > 65536:
+        return actual
+    blocks = prefix.split("\n\n")
+    if len(blocks) > 64:
+        return actual
+    known = _LEGACY_CONTRACT_HASHES | {_host_contract_digest(state.instruction())[0]}
+    recognized = []
+    for index, block in enumerate(blocks):
+        digest, nonce = _host_contract_digest(block)
+        if block.startswith("Host presentation contract for THIS turn only:") and digest not in known:
+            return actual  # A different/ambiguous host-format version is not certified.
+        if digest is not None and digest in known:
+            if nonce == state.nonce:
+                return actual  # Never erase the current host id, even in a misrouted row.
+            recognized.append(index)
+    if len(recognized) != 1:
+        return actual  # Ambiguous duplicates and unknown templates stay intact.
+    remaining = blocks[:recognized[0]] + blocks[recognized[0] + 1:]
+    result = dict(actual)
+    result["content"] = "\n\n".join(remaining + [clean])
+    return result
+
