+            source["role"] = actual["role"] = role
+            source["reasoning_content"] = "leave reasoning unchanged"
+            self.assertIs(project_historical_speech(self.agent, source, actual), actual)
+
+    def test_stale_off_and_lookalike_pairs_do_not_modify_history(self):
