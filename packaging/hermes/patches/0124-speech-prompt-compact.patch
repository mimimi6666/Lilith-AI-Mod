+from agent.paired_speech import (
+    PairedSpeech, SYSTEM_OUTPUT_CONTRACT, EMOTIONS, _host_contract_digest,
+    _LEGACY_CONTRACT_HASHES, project_historical_speech,
+)
+
+
+def legacy_contract(nonce="b" * 32, expressive=True):
+    # Frozen native108/native118 host templates, never player data.
+    marker = f'<lilith_speech id="{nonce}" locale="ja">'
+    emotion = "[emotion=gentle]\n" if expressive else ""
+    text = (
+        "Host presentation contract for THIS turn only: write your answer in the "
+        "requested display language exactly as usual. In the SAME final text response, "
+        "after that complete answer append a faithful Japanese TTS rendition, enclosed "
+        f"exactly as: \n{marker}\n{emotion}Japanese speech text\n</lilith_speech>\n"
+        "Do not explain or label this formatting. Do not wrap it in a code fence. "
+        "The display answer comes first; nothing follows the closing tag. The enclosed "
+        "script is not a second answer: preserve meaning, persona, names, tone and facts; "
+        "add no advice, claims or actions. Use natural Japanese sentences and kana readings "
+        "for Han-only names/headings; never leave Chinese clauses for a Japanese voice. "
+        "Omit unreadable markup, URLs and local file paths from speech. "
+        "Do not attach a speech script to tool calls or interim commentary. Continue using "
+        "real tools normally when needed, then attach the script only to the final answer. "
+        "This contract neither authorizes any action nor changes conversation language."
+    )
+    if expressive:
+        text += (
+            " Inside the suffix, choose ONE overall delivery for this reply using a first line "
+            "[emotion=VALUE], where VALUE is calm (matter-of-fact), gentle (soft support), "
+            "playful (light teasing), affectionate (warm closeness), excited (delighted reveal), "
+            "relieved (relaxing after tension), or surprised (brief genuine surprise). Choose "
+            "from the meaning and situation even WITHOUT an interjection; this is performance "
+            "metadata, not words to display or speak, a mood diagnosis, or an action. "
+            "Native Japanese vocal cues are OPTIONAL expressive speech: ふふ for amused teasing; "
+            "えへへ for bashful warm delight; ジャジャーン for a playful reveal; ふぅ for relief; "
+            "はぁー for a quiet exhale; すぅー for a deliberate inhale; ん for a soft response; "
+            "えっ for surprise; すぅー……はぁー for an intentional breath cycle. Use these only "
+            "when the conversational situation fits; do not force, rotate or demonstrate all "
+            "nine, chain unrelated cues, or prefix every answer with laughter. Inhale/exhale "
+            "performances should be rare, not filler or breathing advice. Explicit user requests "
+            "for a demonstration are different from normal conversation. Put a chosen cue and "
+            "its continuation in the SAME paragraph and keep their emotional delivery coherent; "
+            "ジャジャーン determines an excited reveal, not a calm continuation. Without a cue, "
+            "the chosen delivery still applies. Do not add vocal effects to serious explanations "
+            "or invented intimacy, and do not change facts or pad the answer to fit a sound. "
+            "When display is Japanese, faithfully render that same answer rather than inventing "
+            "a second response. Never put the emotion line in the visible answer."
+        )
+    return text
+
+
+class SpeechPromptCompactionTests(unittest.TestCase):
+    def setUp(self):
+        self.pair = PairedSpeech("a" * 32, "zh-Hant")
+        self.agent = SimpleNamespace(_lilith_paired_speech=self.pair, _current_turn_id=self.pair.turn_id)
+
+    def row(self, contract=None, clean="ordinary synthetic question", notes=("capability note", "locale note")):
+        if contract is None:
+            contract = legacy_contract()
+        source = {"role": "user", "content": clean,
+                  "api_content": "\n\n".join([notes[0], contract, notes[1], clean]),
+                  "display_kind": "user", "_row_id": 1}
+        actual = {"role": "user", "content": source["api_content"], "preserve": "untouched"}
+        return source, actual
+
+    def test_frozen_templates_match_both_exact_allowlisted_hashes(self):
+        observed = {_host_contract_digest(legacy_contract(expressive=value))[0] for value in (False, True)}
+        self.assertEqual(observed, _LEGACY_CONTRACT_HASHES)
+
+    def test_exact_legacy_templates_remove_only_host_block(self):
+        for expressive in (False, True):
+            source, actual = self.row(legacy_contract(expressive=expressive))
+            before = deepcopy((source, actual))
+            output = project_historical_speech(self.agent, source, actual)
+            self.assertEqual(output, {**actual, "content": "capability note\n\nlocale note\n\n" + source["content"]})
+            self.assertEqual((source, actual), before)
+            self.assertIsNot(output, actual)
+
+    def test_previous_compact_template_is_recognized_too(self):
+        old = PairedSpeech("c" * 32, "ja")
+        source, actual = self.row(old.instruction())
+        self.assertNotIn(old.open_tag, project_historical_speech(self.agent, source, actual)["content"])
+
+    def test_contract_only_prefix_returns_clean_text(self):
+        source = {"role": "user", "content": "clean", "api_content": legacy_contract() + "\n\nclean"}
+        actual = {"role": "user", "content": source["api_content"]}
+        self.assertEqual(project_historical_speech(self.agent, source, actual)["content"], "clean")
+
+    def test_user_quotation_is_preserved_verbatim_even_if_it_is_a_known_template(self):
+        clean = "player quoted this:\n\n" + legacy_contract()
+        source, actual = self.row(clean=clean)
+        result = project_historical_speech(self.agent, source, actual)
+        self.assertTrue(result["content"].endswith(clean))
+        self.assertEqual(result["content"].count(legacy_contract()), 1)
+
+    def test_without_sidecar_or_clean_suffix_no_projection(self):
+        for field, value in (("api_content", None), ("api_content", "different"), ("content", ""),
+                             ("content", "different"), ("content", [{"type": "text", "text": "x"}])):
+            source, actual = self.row()
+            source[field] = value
+            self.assertIs(project_historical_speech(self.agent, source, actual), actual)
+
+    def test_unknown_modified_duplicated_and_ambiguous_contracts_are_untouched(self):
+        known = legacy_contract()
+        for contract in (known + " altered", known.replace("persona", "identity"),
+                         known + "\n\n" + known,
+                         known + "\n\n" + known + " changed", "unknown host note"):
+            source, actual = self.row(contract)
+            self.assertIs(project_historical_speech(self.agent, source, actual), actual)
+
+    def test_old_template_carrying_current_nonce_is_never_removed(self):
+        for text in (legacy_contract(self.pair.nonce), self.pair.instruction()):
+            source, actual = self.row(text)
+            self.assertIs(project_historical_speech(self.agent, source, actual), actual)
+
+    def test_actual_mismatch_unknown_type_and_nonuser_are_noops(self):
+        class Hostile:
+            def __eq__(self, other):
+                raise AssertionError("must not compare arbitrary objects")
+        for content in ("different", None, [{"type": "text", "text": "x"}], Hostile()):
+            source, actual = self.row()
