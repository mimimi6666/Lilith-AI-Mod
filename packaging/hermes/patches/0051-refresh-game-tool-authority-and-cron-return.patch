diff --git a/tui_gateway/server.py b/tui_gateway/server.py
index f5bc859241bcba8e337e1c40346cefe1b229e6ca..fb8443897a97ccbdca428a841d8ab643ee1848a2 100644
--- a/tui_gateway/server.py
