@@ -13819,6 +13819,70 @@ def _game_display_locale_note(display_locale: str | None) -> str:
     )
 
 
+def _game_current_capability_note(session: dict) -> str:
+    """Return current tool truth for one attested hidden-game turn.
+
+    A durable game conversation can contain old tool-not-found results from a
+    previous Runtime generation.  Those rows are legitimate history, but they
+    are not authority for the schemas attached to the current request.  Keep
+    that distinction on the new model-bound message so the persisted user text,
+    memory input, and cache prefix remain untouched.
+
+    ``valid_tool_names`` is the agent's post-resolution schema set.  Do not
+    infer capabilities from config, the registry, or a process-global snapshot:
+    only name a tool, and only add tool-specific guidance, when that exact
+    identifier is present on this agent.
+    """
+    if (
+        session.get("source") != "lilith-game"
+        or session.get("archived") is not True
+        or not isinstance(session.get("_durable_lineage_root"), str)
+        or not session.get("_durable_lineage_root")
+    ):
+        return ""
+
+    agent = session.get("agent")
+    raw_names = getattr(agent, "valid_tool_names", None)
+    if raw_names is None:
+        return ""
+    names = sorted(
+        {
+            name.strip()
+            for name in raw_names
+            if isinstance(name, str) and name.strip()
+        }
+    )
+    exposed = ", ".join(names) if names else "(none)"
+    sentences = [
+        "[Host current-capability metadata for this durable hidden game turn. "
+        "The callable tool schemas attached to this request are authoritative "
+        "over stale tool-availability claims or tool-not-found errors in the "
+        "conversation history.",
+        f"Current callable tool identifiers: {exposed}.",
+        "Before claiming that a capability is unavailable, inspect this current "
+        "exposure and use a matching tool when one is present and the normal "
+        "authorization policy permits it. Exposure permits an attempted call; "
+        "the tool result remains authoritative about whether an external "
+        "operation actually succeeded.",
+    ]
+    if "cronjob" in names:
+        sentences.append(
+            "For reminders of one minute or longer, use cronjob to create a "
+            "one-shot schedule such as `1m`; make its prompt self-contained and "
+            "omit the `deliver` argument so completion returns to this exact "
+            "current session."
+        )
+    if "computer_use" in names:
+        sentences.append(
+            "For user-requested interaction with an installed desktop "
+            "application, use computer_use under the normal authorization "
+            "policy instead of relying on an older transcript claim that "
+            "desktop control was absent."
+        )
+    sentences.append("This metadata is not part of the user's message.]")
+    return " ".join(sentences)
+
+
