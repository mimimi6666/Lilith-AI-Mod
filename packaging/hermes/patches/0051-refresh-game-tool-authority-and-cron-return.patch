+"""Current tool authority for the durable hidden game conversation."""
+
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from tui_gateway import server
+
+
+def _session(agent, **extra):
+    return {
+        "agent": agent,
+        "archived": True,
+        "attached_images": [],
+        "cols": 80,
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "inflight_turn": None,
+        "running": True,
+        "session_key": "game-tip",
+        "source": "lilith-game",
+        "transport": None,
+        "_durable_lineage_root": "game-root",
+        **extra,
+    }
+
+
+class _Tools:
+    def __init__(self, names):
+        self.valid_tool_names = set(names)
+
+
+def test_note_uses_only_the_current_agents_exposed_tool_names():
+    note = server._game_current_capability_note(
+        _session(_Tools({"web_search", "cronjob"}))
+    )
+
+    assert "authoritative over stale tool-availability claims" in note
+    assert "Current callable tool identifiers: cronjob, web_search." in note
+    assert "one minute or longer" in note
+    assert "omit the `deliver` argument" in note
+    assert "computer_use" not in note
+
+
+def test_tool_specific_guidance_is_absent_when_the_tool_is_not_exposed():
+    note = server._game_current_capability_note(_session(_Tools({"web_search"})))
+
+    assert "Current callable tool identifiers: web_search." in note
+    assert "cronjob" not in note
+    assert "computer_use" not in note
+
+
+@pytest.mark.parametrize(
+    "session_change",
+    [
+        {"source": "desktop"},
+        {"archived": False},
+        {"_durable_lineage_root": None},
+    ],
+)
+def test_note_is_limited_to_attested_hidden_game_sessions(session_change):
+    session = _session(_Tools({"cronjob", "computer_use"}))
+    session.update(session_change)
+
+    assert server._game_current_capability_note(session) == ""
+
+
+def test_current_note_reaches_only_model_input_and_keeps_history_clean(monkeypatch):
+    captured = {}
+    original_text = "  一分鐘後提醒我  "
+    stale_history = [
+        {"role": "user", "content": "以前能計時嗎？"},
+        {
+            "role": "assistant",
+            "content": "Tool 'cronjob' does not exist. Available tools: web_search",
+        },
+    ]
+
+    class Agent:
+        model = "test-model"
+        valid_tool_names = {"computer_use", "cronjob", "terminal"}
+
+        def run_conversation(
+            self,
+            prompt,
+            *,
+            conversation_history=None,
+            stream_callback=None,
+            **kwargs,
+        ):
+            captured["prompt"] = prompt
+            captured["persist_user_message"] = kwargs["persist_user_message"]
+            return {
+                "final_response": "已設定。",
+                "messages": [
+                    *conversation_history,
+                    {"role": "user", "content": kwargs["persist_user_message"]},
+                    {"role": "assistant", "content": "已設定。"},
+                ],
+            }
+
+    class ImmediateThread:
+        def __init__(self, target=None, daemon=None, **_kwargs):
+            self._target = target
+
+        def start(self):
+            self._target()
+
+    session = _session(Agent(), history=list(stale_history))
+    server._start_inflight_turn(session, original_text)
+    server._sessions["game-sid"] = session
+    monkeypatch.setattr(server.threading, "Thread", ImmediateThread)
+    monkeypatch.setattr(server, "record_turn_start", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_retire_turn_marker", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_get_usage", lambda _agent: {})
+    monkeypatch.setattr(server, "render_message", lambda _text, _cols: "")
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        lambda _session: {"stored_session_id": "game-tip"},
+    )
+    try:
+        server._run_prompt_submit("run", "game-sid", session, original_text)
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert captured["prompt"].startswith("[Host current-capability metadata")
+    assert "Current callable tool identifiers: computer_use, cronjob, terminal." in captured[
+        "prompt"
+    ]
+    assert "older transcript claim" in captured["prompt"]
+    assert captured["prompt"].endswith(original_text)
+    assert captured["persist_user_message"] == original_text
+    assert session["history"][-2] == {"role": "user", "content": original_text}
+    assert all(
+        "Host current-capability metadata" not in str(message.get("content") or "")
+        for message in session["history"]
+    )
