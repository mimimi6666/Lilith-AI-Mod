+logger = logging.getLogger(__name__)
+_HEADINGS = ("Active Task", "Completed Actions", "Active State", "Blocked",
+             "Key Decisions", "Resolved Questions", "Relevant Files", "Critical Context")
+_ABSENT = frozenset({"none", "n/a", "not applicable", "no items", "not provided",
+                     "not specified", "無", "沒有", "不適用", "未提供"})
+_NON_SUMMARY = re.compile(
+    r"(?:r\d+|ok(?:ay)?|ack(?:nowledged)?|received|understood|done|好的?|收到|明白|了解|嗯|"
+    r"hello|hi|你好|嗨|晚安)[.!。！\s]*", re.IGNORECASE)
+_REFUSAL = re.compile(
+    r"(?:i\s+(?:cannot|can't|will not|won't)\s+(?:summarize|provide|comply|help)|"
+    r"(?:sorry|i'm sorry)[,，:： ]|(?:抱歉|對不起|对不起)[,，:： ]|"
+    r"(?:我)?(?:無法|无法|不能)(?:提供|完成|協助|协助|摘要|總結|总结))", re.IGNORECASE)
+
+
+def _validate_checkpoint_text(text):
+    """Validate raw model output BEFORE grounding can make it look complete.
+
+    This is a structural quality gate, not a semantic coverage certificate.
+    Failure never manufactures a replacement or spends a correction request.
+    """
+    def reject(reason):
+        logger.warning("[local_summary_validation] status=rejected reason=%s", reason)
+        raise LocalCompatibilityError("local_compatibility_summary_failed")
+
+    if not isinstance(text, str) or not text.strip():
+        reject("empty")
+    text = text.replace("\r\n", "\n").strip()
+    if "```" in text or "~~~" in text:
+        reject("fenced")
+    matches = list(re.finditer(r"(?m)^## ([^\r\n]+?)[ \t]*$", text))
+    if (tuple(match.group(1) for match in matches) != _HEADINGS
+            or not matches or text[:matches[0].start()].strip()):
+        reject("section_order_or_count")
+    substantive = False
+    for index, match in enumerate(matches):
+        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
+        body = text[match.end():end].strip()
+        if not body or re.search(r"(?m)^#{1,6}(?:\s|$)", body):
+            reject("empty_or_extra_section")
+        value = re.sub(r"^[\s*\-]+", "", body).strip().rstrip(".。")
+        if _NON_SUMMARY.fullmatch(value) or _REFUSAL.match(value):
+            reject("non_summary_response")
+        if value.casefold() not in _ABSENT:
+            substantive = True
+    if not substantive:
+        reject("no_factual_content")
+    logger.info("[local_summary_validation] status=validated sections=8 chars=%d", len(text))
+    return text
 
 
