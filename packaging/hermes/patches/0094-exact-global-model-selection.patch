+"""A picker selection must not persist an automatically substituted pair."""
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import tui_gateway.server as server
+import hermes_cli.model_switch as model_switch
+import agent.identity_policy as identity
+
+
+@pytest.mark.parametrize("selected,resolved", [
+    ("catalog-model-old", "catalog-model-new"),
+    ("deepseek-v4-flash", "deepseek-flash"),
+    ("Exact.Case", "exact.case"),
+])
+def test_strict_global_substitution_is_rejected_before_any_mutation(monkeypatch, selected, resolved):
+    monkeypatch.setattr(identity, "identity_lock_required_by_host", lambda: True)
+    monkeypatch.setattr(model_switch, "switch_model", lambda **kwargs: SimpleNamespace(
+        success=True, new_model=resolved, target_provider="provider-a",
+        base_url=None, api_key="fixture", api_mode="chat_completions", warning_message=""))
+    persist = Mock()
+    desire = Mock(return_value=(1, None))
+    monkeypatch.setattr(server, "_persist_model_switch", persist)
+    monkeypatch.setattr(server, "_commit_runtime_desire", desire)
+    result = server.handle_request({"id": "exact-selection", "method": "config.set", "params": {
+        "key": "model", "value": f"{selected} --provider provider-a --global",
+        "confirm_expensive_model": True}})
+    assert result.get("error", {}).get("code") == 4094, result
+    persist.assert_not_called()
+    desire.assert_not_called()
+
+
+@pytest.mark.parametrize("strict,global_switch,provider", [
+    (True, True, "provider-a"),
+    (False, True, "provider-a"),
+    (True, False, "provider-a"),
+])
+def test_exact_pair_and_unmanaged_alias_behavior_remain_supported(monkeypatch, strict, global_switch, provider):
+    monkeypatch.setattr(identity, "identity_lock_required_by_host", lambda: strict)
+    selected = "model-a"
+    resolved = selected if strict and global_switch else "alias-resolved"
+    monkeypatch.setattr(model_switch, "switch_model", lambda **kwargs: SimpleNamespace(
+        success=True, new_model=resolved, target_provider=provider,
+        base_url=None, api_key="fixture", api_mode="chat_completions", warning_message=""))
+    persist = Mock()
+    monkeypatch.setattr(server, "_persist_model_switch", persist)
+    result = server._apply_model_switch("", {"agent": None},
+        f"{selected} --provider {provider} --{'global' if global_switch else 'session'}",
+        confirm_expensive_model=True)
+    assert result["value"] == resolved
+    assert persist.call_count == int(global_switch)
+
+
+def test_strict_global_provider_substitution_is_also_rejected(monkeypatch):
+    monkeypatch.setattr(identity, "identity_lock_required_by_host", lambda: True)
+    monkeypatch.setattr(model_switch, "switch_model", lambda **kwargs: SimpleNamespace(
+        success=True, new_model="model-a", target_provider="provider-b",
+        base_url=None, api_key="fixture", api_mode="chat_completions", warning_message=""))
+    persist = Mock()
+    monkeypatch.setattr(server, "_persist_model_switch", persist)
+    result = server.handle_request({"id": "provider", "method": "config.set", "params": {
+        "key": "model", "value": "model-a --provider provider-a --global",
+        "confirm_expensive_model": True}})
+    assert result.get("error", {}).get("code") == 4094, result
+    persist.assert_not_called()
