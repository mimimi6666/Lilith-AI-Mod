+def write_commit_receipt(persistence, soul, persona):
+    value = {"schema_version": 1, "source": "hermes.approval.respond.always", "sequence": 1,
+        "canonical_base_sha256": persistence["previous_config_sha256"],
+        "previous_config_sha256": persistence["previous_config_sha256"],
+        "config_sha256": persistence["config_sha256"], "operation_nonce": persistence["commit_nonce"],
+        "identity_fingerprint_sha256": "a" * 64, "soul_sha256": hashlib.sha256(soul.encode()).hexdigest(),
+        "personality_sha256": hashlib.sha256(persona.encode()).hexdigest(),
+        "approval_mode": persistence["approval_mode"], "enabled_toolsets": persistence["enabled_toolsets"]}
+    raw = json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()
+    (_home() / "runtime" / "native-config-receipt.v1.json").write_bytes(raw)
+    return hashlib.sha256(raw).hexdigest()
