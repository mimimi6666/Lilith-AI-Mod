diff --git a/tui_gateway/daily_note_approval.py b/tui_gateway/daily_note_approval.py
new file mode 100644
index 0000000..de64c4f
--- /dev/null
+++ b/tui_gateway/daily_note_approval.py
@@ -0,0 +1,188 @@
+"""Daily owner routing into the existing native approval queue and commit.
+
+This module presents no permission policy. Native choices and the native
+Always two-phase transaction remain authoritative; no conversation is minted.
+"""
+from __future__ import annotations
+
+import copy
+import threading
+import time
+import uuid
+
+from tui_gateway import daily_note as daily
+from tui_gateway.lilith_host_bridge import LilithHostAuthorityError, LilithHostProtocolError
+
+CHOICES = ("once", "session", "always", "deny")
+
+
+def _offer(data):
+    from agent.redact import redact_sensitive_text
+    from tools.approval import gateway_approval_choices
+    if not isinstance(data, dict):
+        raise LilithHostProtocolError("daily native approval offer unavailable")
+    choices = gateway_approval_choices(data)
+    supplied = data.get("choices")
+    if isinstance(supplied, (list, tuple)) and any(c not in supplied for c in choices):
+        raise LilithHostProtocolError("daily native producer choices were inconsistent")
+    if not choices:
+        raise LilithHostProtocolError("daily native producer offered no choices")
+    return {"pattern_key": str(data.get("pattern_key") or "")[:512],
+        "command": redact_sensitive_text(str(data.get("command") or ""), force=True)[:2048],
+        "description": redact_sensitive_text(str(data.get("description") or ""), force=True)[:2048],
+        "choices": choices, "allow_session": "session" in choices,
+        "allow_permanent": "always" in choices, "smart_denied": data.get("smart_denied") is True}
+
+
+def install(task):
+    from tools.approval import register_gateway_notify
+    task.approval_lock = threading.Lock()
+    task.approval_choices = ()
+    task.approval_response_started = False
+    def notify(data):
+        task.current()
+        if task.ui_lease_id is None:
+            raise LilithHostAuthorityError("daily approval UI is unavailable")
+        payload = _offer(data)
+        with daily._lock:
+            task.current()
+            if task.approval_id is not None:
+                raise LilithHostAuthorityError("daily approval was already published")
+            task.approval_id = uuid.uuid4().hex
+            task.approval_choices = tuple(payload["choices"])
+            payload.update(scope=copy.deepcopy(task.scope), approval_id=task.approval_id,
+                ui_lease_id=task.ui_lease_id, expires_at_utc=task.scope["expires_at_utc"])
+        from tui_gateway import server
+        if server._emit("lilith.daily_note.approval.request", task.scope["attempt_id"], payload) is False:
+            raise LilithHostAuthorityError("daily approval request was not emitted")
+    register_gateway_notify(task.scope["attempt_id"], notify)
+
+
+def finish(task, code="daily.approval_closed"):
+    from tools.approval import unregister_gateway_notify
+    unregister_gateway_notify(task.scope["attempt_id"])
+    with daily._lock:
+        approval_id, task.approval_id = task.approval_id, None
+    if approval_id is not None:
+        from tui_gateway import server
+        try:
+            server._emit("lilith.daily_note.approval.closed", task.scope["attempt_id"], {
+                "scope": copy.deepcopy(task.scope), "approval_id": approval_id,
+                "ui_lease_id": task.ui_lease_id, "code": code})
+        except Exception:
+            pass
+
+
+def waiting_on_own_transition(task):
+    """Keep only this paused waiter alive; never authorize any dispatch."""
+    from agent.identity_policy import (identity_lock_required_by_host,
+        native_authority_pending_transition_state, native_authority_quarantine_state)
+    if not task.approval_pending or not identity_lock_required_by_host() or native_authority_quarantine_state() is not None:
+        return False
+    pending = native_authority_pending_transition_state()
+    return bool(pending is not None and pending.get("session_key") == task.scope["attempt_id"]
+        and pending.get("source") in (None, "hermes.approval.respond.always"))
+
+
+def _lookup(params, transport, extra):
+    required = {"scope", "approval_id", "ui_lease_id"} | set(extra)
+    if not isinstance(params, dict) or set(params) != required:
+        raise LilithHostProtocolError("daily approval response shape rejected")
+    scope = daily.normalize_scope(params["scope"])
+    daily._require_transport(transport)
+    with daily._lock:
+        task = daily._active
+        if (task is None or task.scope != scope or task.transport is not transport
+                or task.approval_id is None or params["approval_id"] != task.approval_id
+                or params["ui_lease_id"] != task.ui_lease_id
+                or task.cancelled.is_set() or task.finished.is_set() or time.monotonic() >= task.deadline):
+            raise LilithHostAuthorityError("daily approval owner expired or changed")
+        return task
+
+
+def respond(params, transport):
+    from tools.approval import resolve_gateway_approval_with_persistence
+    task = _lookup(params, transport, {"choice"})
+    choice = params["choice"]
+    if choice not in task.approval_choices:
+        raise LilithHostProtocolError("daily native choice was not offered")
+    with task.approval_lock:
+        _lookup(params, transport, {"choice"})
+        task.current()
+        if task.approval_response_started:
+            raise LilithHostAuthorityError("daily approval response was already consumed")
+        task.approval_response_started = True
+        task.approval_pending = choice == "always"
+        def adopt(previous_sha256, config_sha256):
+            from agent.identity_policy import adopt_verified_native_config_digest
+            _lookup(params, transport, {"choice"})
+            adopt_verified_native_config_digest(task.agent,
+                previous_config_sha256=previous_sha256, config_sha256=config_sha256)
+            # This runs only inside native phase two after Runtime's exact
+            # durable receipt was verified. Unrelated changes cannot use it.
+            task.config_proof = daily._config_proof()
+            task.proof = daily._agent_proof(task.agent)
+        resolved, persistence = resolve_gateway_approval_with_persistence(task.scope["attempt_id"], choice,
+            resolve_all=False, on_verified_config_commit=adopt)
+        if resolved != 1:
+            raise LilithHostAuthorityError("daily approval did not resolve exactly one waiter")
+        if persistence is not None and "commit_nonce" in persistence:
+            return {"prepared": resolved, "persistence": persistence}
+        task.approval_pending = False
+        result = {"resolved": resolved}
+        if persistence is not None:
+            result["persistence"] = persistence
+        return result
+
+
+def commit(params, transport):
+    from tools.approval import commit_gateway_approval
+    task = _lookup(params, transport, {"authority", "commit_nonce", "receipt_sha256"})
+    with task.approval_lock:
+        _lookup(params, transport, {"authority", "commit_nonce", "receipt_sha256"})
+        if not task.approval_pending:
+            raise LilithHostAuthorityError("daily approval commit was not pending")
+        count = commit_gateway_approval(task.scope["attempt_id"], authority=params["authority"],
+            commit_nonce=params["commit_nonce"], receipt_sha256=params["receipt_sha256"])
+        task.approval_pending = False
+        if count != 1:
+            raise LilithHostAuthorityError("daily approval commit did not resolve exactly one")
+        return {"resolved": 1}
+
+
+def abort(params, transport):
+    from tools.approval import abort_gateway_approval
+    task = _lookup(params, transport, {"authority", "commit_nonce", "reason"})
+    with task.approval_lock:
+        _lookup(params, transport, {"authority", "commit_nonce", "reason"})
+        count = abort_gateway_approval(task.scope["attempt_id"], authority=params["authority"],
+            commit_nonce=params["commit_nonce"], reason=params["reason"])
+        task.approval_pending = False
+        if count != 1:
+            raise RuntimeError("daily approval abort did not abort exactly one")
+        return {"aborted": 1, "quarantined": True}
+
+
+def register(server):
+    for name, callback in (("respond", respond), ("commit", commit), ("abort", abort)):
+        def handler(rid, params, callback=callback, name=name):
+            from tui_gateway.lilith_host_bridge import LilithHostBridgeError
+            from agent.identity_policy import (NativeAuthorityTransitionBusyError,
+                native_authority_quarantine_state, latch_native_authority_quarantine)
+            try:
+                return server._ok(rid, callback(params, server.current_transport()))
+            except NativeAuthorityTransitionBusyError:
+                return server._err(rid, 4090, "daily native authority transaction busy")
+            except LilithHostBridgeError as exc:
+                if name != "respond" or native_authority_quarantine_state() is not None:
+                    latch_native_authority_quarantine("daily native approval phase two owner was unavailable",
+                        drifted_labels=("config.yaml", "runtime/native-config-receipt.v1.json"))
+                    return server._err(rid, 5035, "daily native approval authority quarantined")
+                return server._err(rid, exc.rpc_code, str(exc))
+            except Exception:
+                # Unknown persistence cannot be called a definite pre-effect
+                # error (5034). Native owns quarantine and no tool is released.
+                latch_native_authority_quarantine("daily native approval transaction failed without verified completion",
+                    drifted_labels=("config.yaml", "runtime/native-config-receipt.v1.json"))
+                return server._err(rid, 5035, "daily native approval transaction uncertain")
+        server.method("lilith.daily_note.approval." + name)(handler)
diff --git a/tui_gateway/daily_note_readiness.py b/tui_gateway/daily_note_readiness.py
new file mode 100644
index 0000000..f9a79b6
--- /dev/null
+++ b/tui_gateway/daily_note_readiness.py
@@ -0,0 +1,292 @@
+"""Explicit native startup and one-use daily readiness; no model execution.
+
+The ON-only Runtime caller owns admission. First preparation performs normal
+native module/configured-plugin registration and its discovery-cache/env init,
+not a chat-session build. Those startup effects are once per native process and
+profile, never an implicit model, MCP discovery, conversation or note request.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import threading
+import time
+import uuid
+from dataclasses import dataclass, field
+from datetime import timedelta
+
+from tui_gateway import daily_note as daily
+from tui_gateway.lilith_host_bridge import LilithHostAuthorityError, LilithHostProtocolError
+
+PREPARE_SECONDS = 30.0
+TOKEN_SECONDS = 5.0
+CLAIM_SECONDS = 60.0
+FIELDS = frozenset({"profile_id", "runtime_generation", "game_epoch", "preparation_id", "locale", "ui_lease_id"})
+PATTERN = "plugin_rule:lilith_leave_note:deliver"
+_holder = None
+_claims = {}
+_bootstrap_home = None
+
+
+def _claim_preparation(identifier):
+    # Readiness has no model/write effect. Retain only a short replay window;
+    # abandoned/unready attempts must not brick a long-running native process.
+    now = time.monotonic()
+    for key, expiry in tuple(_claims.items()):
+        if expiry <= now:
+            del _claims[key]
+    if identifier in _claims or len(_claims) >= daily.MAX_CLAIMS:
+        return False
+    _claims[identifier] = now + CLAIM_SECONDS
+    return True
+
+
+def _id(value):
+    return isinstance(value, str) and daily._ID.fullmatch(value) and value != "0" * 32
+
+
+def _normalize(params):
+    if (not isinstance(params, dict) or set(params) != FIELDS or params["profile_id"] != "local"
+            or any(not _id(params[k]) for k in ("runtime_generation", "game_epoch", "preparation_id"))
+            or not isinstance(params["locale"], str) or params["locale"] not in daily._LOCALES
+            or (params["ui_lease_id"] is not None and not _id(params["ui_lease_id"]))):
+        raise LilithHostProtocolError("daily preparation shape was rejected")
+    return dict(params)
+
+
+def _utc_text(value):
+    return value.strftime("%Y-%m-%dT%H:%M:%S.") + f"{value.microsecond:06d}0+00:00"
+
+
+def _bootstrap():
+    global _bootstrap_home
+    from hermes_constants import hermes_home_key
+    home = hermes_home_key()
+    if _bootstrap_home is not None:
+        if _bootstrap_home != home:
+            raise LilithHostAuthorityError("daily bootstrap profile changed")
+        return
+    # Python's module import lock and PluginManager's native discovery lock own
+    # concurrent normal startup. Do not invoke server._start_agent_build, an
+    # entry-point main(), SessionDB, MCP discovery, or an agent conversation.
+    import run_agent
+    import model_tools
+    from hermes_cli.plugins import discover_plugins
+    from tools.approval import load_permanent_allowlist
+    discover_plugins()
+    load_permanent_allowlist()
+    if not callable(run_agent.AIAgent) or not callable(model_tools.handle_function_call):
+        raise LilithHostAuthorityError("daily native startup incomplete")
+    _bootstrap_home = home
+
+
+def _schema_proof():
+    from model_tools import get_tool_definitions
+    from tools.registry import registry
+    definitions = get_tool_definitions(enabled_toolsets=["lilith_leave_note"], disabled_toolsets=[],
+        quiet_mode=True, skip_tool_search_assembly=True)
+    selected = [copy.deepcopy(x) for x in definitions if x.get("function", {}).get("name") == "lilith_leave_note"]
+    entry = registry.get_entry("lilith_leave_note")
+    if len(selected) != 1 or entry is None:
+        raise LilithHostAuthorityError("daily native note registry unavailable")
+    return (registry._generation, id(entry), hashlib.sha256(json.dumps(
+        selected, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest())
+
+
+@dataclass
+class _Preparation:
+    params: dict
+    transport: object
+    deadline: float
+    scope: dict = field(default_factory=dict)
+    agent: object = None
+    proof: object = None
+    config_proof: object = None
+    schema_proof: object = None
+    code: str = "daily.preparation_failed"
+    token: str | None = None
+    expiry_text: str | None = None
+    expires: float = 0.0
+    requires_ui: bool = True
+    ready: threading.Event = field(default_factory=threading.Event)
+    cancelled: threading.Event = field(default_factory=threading.Event)
+    released: threading.Event = field(default_factory=threading.Event)
+    finished: threading.Event = field(default_factory=threading.Event)
+    consumed: bool = False
+
+    @property
+    def locale(self):
+        return self.params["locale"]
+
+    def current(self):
+        daily._require_transport(self.transport)
+        if (self.cancelled.is_set() or time.monotonic() >= self.deadline
+                or not daily._native_authority()):
+            raise LilithHostAuthorityError("daily preparation authority revoked")
+        if self.config_proof is not None and daily._config_proof() != self.config_proof:
+            raise LilithHostAuthorityError("daily preparation configuration changed")
+
+
+def _response(item, *, available=False, code=None):
+    p = item.params
+    agent = item.agent
+    return {**{k: p[k] for k in ("profile_id", "runtime_generation", "game_epoch", "preparation_id")},
+        "ready": bool(available), "code": code or item.code,
+        "token": item.token if available else None,
+        "expires_at_utc": item.expiry_text if available else None,
+        "provider": str(getattr(agent, "provider", "") or ""),
+        "model": str(getattr(agent, "model", "") or ""),
+        "requires_ui": item.requires_ui, "ui_lease_id": p["ui_lease_id"]}
+
+
+def _close(item):
+    if item.agent is not None:
+        daily._close_agent(item)
+        item.agent = None
+    item.proof = item.config_proof = item.schema_proof = None
+    item.token = None
+
+
+def prepare(params, transport):
+    global _holder
+    p = _normalize(params)
+    daily._require_transport(transport)
+    if not daily._native_authority():
+        raise LilithHostAuthorityError("daily preparation requires native authority")
+    item = _Preparation(p, transport, time.monotonic() + PREPARE_SECONDS,
+        scope={"attempt_id": p["preparation_id"]})
+    with daily._lock:
+        if not _claim_preparation(p["preparation_id"]):
+            return _response(item, code="daily.preparation_duplicate_or_capacity")
+        if _holder is not None or daily._active is not None:
+            return _response(item, code="daily.preparation_busy")
+        _holder = item
+
+    def worker():
+        global _holder
+        from tui_gateway.transport import bind_transport, reset_transport
+        binding = bind_transport(transport)
+        try:
+            item.current()
+            _bootstrap()
+            item.current()
+            item.agent = daily._make_agent(item)
+            item.current()
+            from agent.identity_policy import enforce_scoped_turn_identity, policy_for_agent, assert_scoped_identity_prompt
+            from tools.approval import tool_approval_requires_human
+            enforce_scoped_turn_identity(item.agent)
+            if not policy_for_agent(item.agent).enabled:
+                raise LilithHostAuthorityError("daily persona unavailable")
+            soul, persona = item.agent._identity_soul_content, item.agent._identity_personality_prompt
+            if not isinstance(soul, str) or not soul.strip() or not isinstance(persona, str) or not persona.strip():
+                raise LilithHostAuthorityError("daily persona unavailable")
+            assert_scoped_identity_prompt(item.agent, soul.strip() + "\n\n" + persona.strip(), label="daily preparation identity")
+            item.schema_proof = _schema_proof()
+            item.proof = daily._agent_proof(item.agent)
+            item.requires_ui = tool_approval_requires_human(p["preparation_id"], PATTERN)
+            if item.requires_ui and p["ui_lease_id"] is None:
+                item.code = "daily.approval_ui_unavailable"
+                return
+            item.current()
+            with daily._lock:
+                item.current()
+                item.token = uuid.uuid4().hex
+                item.expires = time.monotonic() + TOKEN_SECONDS
+                item.deadline = item.expires
+                item.expiry_text = _utc_text(daily._utc_now() + timedelta(seconds=TOKEN_SECONDS))
+                item.code = "daily.ready"
+                item.ready.set()
+            while not item.released.wait(min(0.05, max(0.0, item.expires - time.monotonic()))):
+                if item.cancelled.is_set() or time.monotonic() >= item.expires:
+                    break
+        except Exception:
+            # Factory may supply an exact safe unsupported code; never expose
+            # secrets or let an exception string become model-budget evidence.
+            pass
+        finally:
+            try:
+                with daily._lock:
+                    consumed = item.consumed
+                    if not consumed:
+                        item.cancelled.set()
+                if not consumed:
+                    _close(item)
+            finally:
+                reset_transport(binding)
+                with daily._lock:
+                    item.finished.set()
+                    if _holder is item:
+                        _holder = None
+    threading.Thread(target=worker, daemon=True, name="lilith-daily-prepare").start()
+    while True:
+        with daily._lock:
+            if item.ready.is_set() and not item.cancelled.is_set() and not item.consumed and time.monotonic() < item.expires:
+                return _response(item, available=True)
+            if item.finished.is_set():
+                return _response(item)
+        if item.cancelled.is_set() or time.monotonic() >= item.deadline or getattr(transport, "_closed", False):
+            item.cancelled.set()
+            item.released.set()
+            return _response(item, code="daily.preparation_cancelled_or_timeout")
+        item.ready.wait(0.02)
+
+
+def consume(token, scope, locale, transport):
+    """Called under the same native task lock before publishing its owner."""
+    global _holder
+    if not _id(token):
+        raise LilithHostProtocolError("daily preparation token was rejected")
+    with daily._lock:
+        item = _holder
+        if item is None or item.token != token or item.transport is not transport:
+            raise LilithHostAuthorityError("daily preparation token unavailable")
+        # Any matched token is burned, including wrong-scope and expired uses.
+        item.token = None
+        try:
+            item.current()
+            if (not item.ready.is_set() or item.consumed or time.monotonic() >= item.expires
+                    or locale != item.locale or any(scope[k] != item.params[k]
+                        for k in ("profile_id", "runtime_generation", "game_epoch"))):
+                raise LilithHostAuthorityError("daily preparation scope expired or changed")
+            from agent.identity_policy import enforce_scoped_turn_identity
+            from tools.approval import tool_approval_requires_human
+            enforce_scoped_turn_identity(item.agent)
+            if (daily._agent_proof(item.agent) != item.proof or _schema_proof() != item.schema_proof
+                    or tool_approval_requires_human(scope["attempt_id"], PATTERN) != item.requires_ui):
+                raise LilithHostAuthorityError("daily preparation authority changed")
+            item.consumed = True
+            _holder = None
+            return item
+        finally:
+            if not item.consumed:
+                item.cancelled.set()
+            item.released.set()
+
+
+def cancel(params, transport):
+    if (not isinstance(params, dict) or set(params) != {"profile_id", "runtime_generation", "preparation_id"}
+            or params["profile_id"] != "local" or not _id(params["runtime_generation"])
+            or not _id(params["preparation_id"])):
+        raise LilithHostProtocolError("daily preparation cancellation rejected")
+    daily._require_transport(transport)
+    with daily._lock:
+        item = _holder
+        accepted = bool(item is not None and item.transport is transport
+            and all(item.params[k] == v for k, v in params.items()))
+        _claim_preparation(params["preparation_id"])
+        if accepted:
+            item.cancelled.set()
+            item.released.set()
+    return {**params, "accepted": accepted}
+
+
+def register(server):
+    for name, callback in (("prepare", prepare), ("prepare.cancel", cancel)):
+        def handler(rid, params, callback=callback):
+            from tui_gateway.lilith_host_bridge import LilithHostBridgeError
+            try:
+                return server._ok(rid, callback(params, server.current_transport()))
+            except LilithHostBridgeError as exc:
+                return server._err(rid, exc.rpc_code, str(exc))
+        server.method("lilith.daily_note." + name)(handler)
