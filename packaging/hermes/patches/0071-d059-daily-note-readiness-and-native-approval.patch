+"""Real native queue and two-phase approval, isolated transport and filesystem."""
+import copy
+import hashlib
+import json
+import os
+import threading
+import time
+import uuid
+
+import pytest
+import yaml
+
+from tests.tui_gateway.test_daily_note_readiness import isolated, request
+from tests.tui_gateway.test_daily_note import scope, receipt
+from tests.tui_gateway.test_tools_policy_rpc import (
+    _clean_gateway_sessions, _strict_config, _write_config, _attest_strict_host, _home)
+from tui_gateway import daily_note as daily, daily_note_readiness as ready, daily_note_approval as lane, server
+from tools import approval
+from agent import identity_policy as identity
+
+NATIVE_PREDICATE = approval.tool_approval_requires_human
+
+
+@pytest.fixture
+def real_queue(isolated, _clean_gateway_sessions, monkeypatch):
+    agent, transport, _ = isolated
+    monkeypatch.setattr(approval, "tool_approval_requires_human", NATIVE_PREDICATE)
+    monkeypatch.setattr(approval, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setattr(approval, "_get_approval_timeout", lambda: 300)
+    monkeypatch.setattr(approval, "is_interrupted", lambda: False)
+    monkeypatch.setattr(identity, "identity_lock_required_by_host", lambda *a, **k: True)
+    monkeypatch.setattr(daily, "_native_authority", lambda: identity.native_authority_dispatch_block_state() is None)
+    old_permanent, old_sessions = set(approval._permanent_approved), dict(approval._session_approved)
+    approval._permanent_approved.clear()
+    approval._session_approved.clear()
+    def actual_gate(name, args, **kwargs):
+        consent = approval.request_tool_approval(name, "Create one game image note", rule_key="lilith_leave_note:deliver")
+        return daily.request_note(args) if consent["approved"] else consent
+    monkeypatch.setattr("model_tools.handle_function_call", actual_gate)
+    yield agent, transport
+    if daily._active is not None:
+        daily._abort(daily._active)
+        assert daily._active.finished.wait(3)
+    approval._permanent_approved.clear()
+    approval._permanent_approved.update(old_permanent)
+    approval._session_approved.clear()
+    approval._session_approved.update(old_sessions)
+
+
+def start(real_queue):
+    agent, transport = real_queue
+    value = scope()
+    prepared = ready.prepare(request(value), transport)
+    assert prepared["ready"] and prepared["requires_ui"]
+    published = threading.Event()
+    offers, results = [], []
+    def frame(frame):
+        name, body = frame["params"]["type"], frame["params"]["payload"]
+        if name == "lilith.daily_note.approval.request":
+            assert frame["params"]["session_id"] == value["attempt_id"]
+            offers.append(body)
+            published.set()
+        elif name == "lilith.daily_note.tool":
+            daily.complete({"scope": value, "result": receipt(value)}, transport)
+    transport.on_frame = frame
+    thread = threading.Thread(target=lambda: results.append(daily.evaluate({"scope": value,
+        "locale": "zh-TW", "preparation_token": prepared["token"]}, transport)))
+    thread.start()
+    assert published.wait(3), results
+    # Native publication marks notified after the callback returns.
+    until = time.monotonic() + 2
+    while not approval._gateway_queues[value["attempt_id"]][0].notified:
+        assert time.monotonic() < until
+        time.sleep(.002)
+    body = offers[0]
+    assert body["choices"] == ["once", "session", "always", "deny"]
+    params = {k: copy.deepcopy(body[k]) for k in ("scope", "approval_id", "ui_lease_id")}
+    return thread, results, params
