+    assert lane.waiting_on_own_transition(task) and not daily._native_authority()
+    assert (_home() / "config.yaml").read_bytes() != old
+    assert yaml.safe_load((_home() / "config.yaml").read_text())["approvals"]["mode"] == "manual"
+    time.sleep(.12)  # At least two native monitor polls during its own pending phase.
+    assert thread.is_alive() and not task.cancelled.is_set()
+    digest = write_commit_receipt(persistence, soul, persona)
+    assert lane.commit({**params, "authority": "lilith-runtime-native-config.v1",
+        "commit_nonce": persistence["commit_nonce"], "receipt_sha256": digest}, transport) == {"resolved": 1}
+    thread.join(3)
+    assert not thread.is_alive() and results[0]["status"] == "completed"
+    assert tool_count(transport) == len(agent.calls) == 1
+    assert agent._identity_config_sha256 == persistence["config_sha256"]
