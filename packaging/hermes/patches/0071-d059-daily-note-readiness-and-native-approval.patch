diff --git a/tests/tools/test_process_registry_deferred_restore.py b/tests/tools/test_process_registry_deferred_restore.py
new file mode 100644
index 0000000..6a61ba9
--- /dev/null
+++ b/tests/tools/test_process_registry_deferred_restore.py
@@ -0,0 +1,200 @@
+"""Import-only discovery must not recover durable background completions."""
+
+import json
+import os
+from pathlib import Path
+import queue
+import subprocess
+import sys
+import threading
+import time
+
+from tools import async_delegation as delegation
+from tools.process_registry import ProcessRegistry
+
+
+def test_explicit_constructor_preserves_eager_restore(monkeypatch):
+    calls = []
+
+    def restore(target):
+        calls.append(target)
+        target.put({"delegation_id": "eager-fixture"})
+
+    monkeypatch.setattr(delegation, "restore_undelivered_completions", restore)
+    registry = ProcessRegistry()
+    assert len(calls) == 1
+    assert registry.completion_queue is calls[0]
+    assert registry.completion_queue.get_nowait() == {"delegation_id": "eager-fixture"}
+    assert registry.completion_queue.empty()
+    assert len(calls) == 1
+
+
+def test_deferred_first_access_restores_once_into_the_same_queue(monkeypatch):
+    calls = []
+    event = {"delegation_id": "deferred-fixture", "restored": True}
+
+    def restore(target):
+        calls.append(target)
+        target.put(event)
+
+    monkeypatch.setattr(delegation, "restore_undelivered_completions", restore)
+    registry = ProcessRegistry(defer_completion_restore=True)
+    assert calls == []
+    target = registry.completion_queue
+    assert calls == [target]
+    assert target.get_nowait() == event
+    for _ in range(5):
+        assert registry.completion_queue is target
+        assert registry.completion_queue.empty()
+    assert calls == [target]
+
+
+def test_cold_module_singleton_import_defers_until_first_real_queue_access(tmp_path):
+    # A fresh interpreter proves import behaviour without replacing the
+    # process-wide singleton used by other tests. No real delegation DB opens.
+    home = tmp_path / "cold-home"
+    home.mkdir()
+    code = r'''
+import importlib, json, os, sys, types
+from pathlib import Path
+calls = []
+fake = types.ModuleType("tools.async_delegation")
+def restore(target):
+    calls.append(target)
+    target.put({"delegation_id": "cold-fixture"})
+fake.restore_undelivered_completions = restore
+sys.modules["tools.async_delegation"] = fake
+module = importlib.import_module("tools.process_registry")
+assert calls == []
+assert not (Path(os.environ["HERMES_HOME"]) / "state.db").exists()
+target = module.process_registry.completion_queue
+assert calls == [target]
+assert target.get_nowait() == {"delegation_id": "cold-fixture"}
+assert module.process_registry.completion_queue is target
+assert target.empty() and len(calls) == 1
+print(json.dumps({"cold_import_restores": 0, "first_queue_restores": len(calls)}))
+'''
+    env = dict(os.environ, HERMES_HOME=str(home), PYTHONDONTWRITEBYTECODE="1")
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", code],
+        cwd=Path(__file__).resolve().parents[2],
+        env=env, capture_output=True, text=True, timeout=30,
+    )
+    assert completed.returncode == 0, completed.stderr
+    assert json.loads(completed.stdout.strip().splitlines()[-1]) == {
+        "cold_import_restores": 0, "first_queue_restores": 1,
+    }
+    assert not (home / "state.db").exists()
+
+
+def test_concurrent_first_readers_wait_for_one_completed_restore(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+    second_started = threading.Event()
+    second_returned = threading.Event()
+    calls = []
+    results = []
+    errors = []
+
+    def restore(target):
+        calls.append(target)
+        entered.set()
+        if not release.wait(3):
+            raise RuntimeError("synthetic restore barrier timed out")
+        target.put({"delegation_id": "concurrent-fixture"})
+
+    monkeypatch.setattr(delegation, "restore_undelivered_completions", restore)
+    registry = ProcessRegistry(defer_completion_restore=True)
+
+    def read(second=False):
+        try:
+            if second:
+                second_started.set()
+            target = registry.completion_queue
+            results.append((target, target.qsize()))
+        except BaseException as error:
+            errors.append(error)
+        finally:
+            if second:
+                second_returned.set()
+
+    first = threading.Thread(target=read)
+    second = threading.Thread(target=read, kwargs={"second": True})
+    first.start()
+    try:
+        assert entered.wait(2)
+        second.start()
+        assert second_started.wait(2)
+        returned_before_restore_finished = second_returned.wait(0.2)
+    finally:
+        release.set()
+        first.join(3)
+        if second.ident is not None:
+            second.join(3)
+    assert not first.is_alive() and not second.is_alive()
+    assert not errors
+    assert not returned_before_restore_finished
+    assert len(calls) == 1 and len(results) == 2
+    assert all(target is calls[0] and count == 1 for target, count in results)
+
+
+def test_restore_failure_is_logged_once_without_retries_or_invented_events(monkeypatch, caplog):
+    calls = []
+
+    def fail(target):
+        calls.append(target)
+        raise OSError("synthetic restore unavailable")
+
+    monkeypatch.setattr(delegation, "restore_undelivered_completions", fail)
+    registry = ProcessRegistry(defer_completion_restore=True)
+    with caplog.at_level("WARNING", logger="tools.process_registry"):
+        target = registry.completion_queue
+        for _ in range(5):
+            assert registry.completion_queue is target
+            assert target.empty()
+    assert calls == [target]
+    matching = [record for record in caplog.records
+                if "Could not restore async delegation completions" in record.getMessage()]
+    assert len(matching) == 1
+    assert "synthetic restore unavailable" in matching[0].getMessage()
+
+
+def test_explicit_queue_replacement_preserves_embedder_ownership(monkeypatch):
+    calls = []
+    monkeypatch.setattr(delegation, "restore_undelivered_completions", lambda target: calls.append(target))
+    registry = ProcessRegistry(defer_completion_restore=True)
+    replacement = queue.Queue()
+    replacement.put({"delegation_id": "embedder-fixture"})
+    registry.completion_queue = replacement
+    assert registry.completion_queue is replacement
+    assert replacement.get_nowait() == {"delegation_id": "embedder-fixture"}
+    assert calls == []
+
+
+def test_existing_durable_pending_completion_rehydrates_once_without_acknowledging_it(monkeypatch, tmp_path):
+    db_path = tmp_path / "existing-state.db"
+    monkeypatch.setattr(delegation, "_db_path", lambda: db_path)
+    now = time.time()
+    expected = {"type": "async_delegation", "delegation_id": "pending-fixture", "session_key": "owner-fixture"}
+    with delegation._transaction() as conn:
+        for identity, delivery in (("pending-fixture", "pending"), ("delivered-fixture", "delivered")):
+            payload = dict(expected, delegation_id=identity)
+            conn.execute(
+                "INSERT INTO async_delegations "
+                "(delegation_id, origin_session, state, dispatched_at, completed_at, updated_at, event_json, delivery_state) "
+                "VALUES (?, ?, 'completed', ?, ?, ?, ?, ?)",
+                (identity, "owner-fixture", now, now, now, json.dumps(payload), delivery),
+            )
+    registry = ProcessRegistry(defer_completion_restore=True)
+    target = registry.completion_queue
+    assert target.get_nowait() == dict(expected, restored=True)
+    assert target.empty()
+    assert registry.completion_queue is target and target.empty()
+    with delegation._transaction() as conn:
+        rows = conn.execute(
+            "SELECT delegation_id, delivery_state, event_json FROM async_delegations ORDER BY delegation_id"
+        ).fetchall()
+    assert [(row[0], row[1]) for row in rows] == [
+        ("delivered-fixture", "delivered"), ("pending-fixture", "pending"),
+    ]
+    assert all("restored" not in json.loads(row[2]) for row in rows)
