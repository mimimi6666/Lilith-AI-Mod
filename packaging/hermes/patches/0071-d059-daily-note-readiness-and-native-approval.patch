+    thread, results, params = start(real_queue)
+    task = daily._active
+    phase1 = lane.respond({**params, "choice": "always"}, transport)["persistence"]
+    observed_false, resume_monitor = threading.Event(), threading.Event()
+    real_authority = daily._native_authority
+    def authority():
+        current = real_authority()
+        if threading.get_ident() == thread.ident and not current and not observed_false.is_set():
+            observed_false.set()
+            assert resume_monitor.wait(3)
+        return current
+    monkeypatch.setattr(daily, "_native_authority", authority)
+    assert observed_false.wait(2)
+    digest = write_commit_receipt(phase1, soul, persona)
+    try:
+        assert lane.commit({**params, "authority": "lilith-runtime-native-config.v1",
+            "commit_nonce": phase1["commit_nonce"], "receipt_sha256": digest}, transport) == {"resolved": 1}
+        assert identity.native_authority_pending_transition_state() is None
+    finally:
+        resume_monitor.set()
+    thread.join(3)
+    assert not thread.is_alive() and results[0]["status"] == "completed"
+    assert not task.cancelled.is_set() and len(agent.calls) == tool_count(transport) == 1
