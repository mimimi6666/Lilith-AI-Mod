+    assert prepared["ready"] and prepared["code"] == "daily.ready" and len(prepared["token"]) == 32
+    assert not agent.calls and not transport.frames and all(not x for x in daily._claims.values())
+    result = daily.evaluate({"scope": value, "locale": "zh-TW", "preparation_token": prepared["token"]}, transport)
+    assert result["status"] == "completed" and result["result"]["status"] == "delivered"
+    assert len(agent.calls) == 1 and agent.closed
+    assert daily.evaluate({"scope": value, "locale": "zh-TW", "preparation_token": prepared["token"]}, transport)["status"] == "unknown"
+    assert len(agent.calls) == 1
