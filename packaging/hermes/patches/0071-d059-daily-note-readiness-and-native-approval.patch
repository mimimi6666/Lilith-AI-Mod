+@pytest.fixture
+def isolated(monkeypatch):
+    assert daily._active is None and ready._holder is None
+    monkeypatch.setattr(daily, "_native_authority", lambda: True)
+    monkeypatch.setattr(daily, "_claims", {key: set() for key in daily._claims})
+    monkeypatch.setattr(ready, "_claims", {})
+    monkeypatch.setattr(ready, "_schema_proof", lambda: (1, "native-note", "A" * 64))
+    starts = []
+    monkeypatch.setattr(ready, "_bootstrap", lambda: starts.append(True))
+    agent, transport = FakeAgent(), Transport()
+    monkeypatch.setattr(daily, "_make_agent", lambda task: agent)
+    for name in ("enforce_scoped_turn_identity", "assert_scoped_identity_prompt",
+                 "assert_scoped_identity_provider_request", "assert_scoped_identity_request_messages"):
+        monkeypatch.setattr("agent.identity_policy." + name, lambda *a, **k: None)
+    monkeypatch.setattr("agent.identity_policy.policy_for_agent", lambda a: a._identity_policy)
+    monkeypatch.setattr("tools.approval.tool_approval_requires_human", lambda *a: True)
+    monkeypatch.setattr("model_tools.get_tool_definitions", lambda **k: [SCHEMA])
+    monkeypatch.setattr("model_tools.handle_function_call", lambda name, args, **kw: daily.request_note(args))
+    transport.on_frame = lambda frame: (daily.complete({"scope": frame["params"]["payload"]["scope"],
+        "result": receipt(frame["params"]["payload"]["scope"])}, transport)
+        if frame["params"]["type"] == "lilith.daily_note.tool" else None)
+    yield agent, transport, starts
+    if daily._active is not None:
+        daily._abort(daily._active)
+        assert daily._active.finished.wait(3)
+    item = ready._holder
+    if item is not None:
+        item.cancelled.set()
+        item.released.set()
+        assert item.finished.wait(3)
