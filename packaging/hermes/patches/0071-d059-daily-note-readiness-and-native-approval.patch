+def request(value=None, *, ui=True):
+    value = value or scope()
+    return {"profile_id": value["profile_id"], "runtime_generation": value["runtime_generation"],
+        "game_epoch": value["game_epoch"], "preparation_id": uuid.uuid4().hex, "locale": "zh-TW",
+        "ui_lease_id": uuid.uuid4().hex if ui else None}
+
