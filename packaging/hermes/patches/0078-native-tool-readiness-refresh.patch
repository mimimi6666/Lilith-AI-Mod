+def _refresh_native_tools_between_turns(agent: Any) -> bool:
+    """Refresh Lilith's bound profile only, before assembling the API prefix.
+
+    Reuse the native atomic rebuild so enabled/disabled selections, external
+    memory and context-engine injectors survive. Never enable toolsets here.
+    No background thread or setup callback mutates an active turn's tools.
+    """
+    from tools.native_tool_setup_tool import bound_setup_available
+    if not bound_setup_available() or getattr(agent, "_skip_mcp_refresh", False):
+        return False
+    from tools.registry import tool_availability_revision
+    revision = tool_availability_revision()
+    now = time.monotonic()
+    if (revision is not None and
+            revision == getattr(agent, "_native_tools_revision", None) and
+            now - getattr(agent, "_native_tools_checked_at", float("-inf")) < 30.0):
+        return False
+    from tools.mcp_tool import refresh_agent_mcp_tools
+    refresh_agent_mcp_tools(agent, quiet_mode=True)
+    # If setup raced with the rebuild, do not mark the stale attempt fresh.
+    if tool_availability_revision() == revision:
+        agent._native_tools_revision = revision
+        agent._native_tools_checked_at = now
+    return True
+
