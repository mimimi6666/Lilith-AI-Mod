+class _ProfileSecretScope(dict):
+    """A normal secret mapping with a non-secret source revision sidecar."""
+
+    def __init__(self, values, revision):
+        super().__init__(values)
+        self.cache_revision = revision
+
+
+def secret_scope_cache_revision() -> Optional[tuple]:
+    """Identify the loaded snapshot, not just the current on-disk .env.
+
+    Setup can update disk while the active turn still uses an older snapshot.
+    Keep that turn's verdict out of the next turn's cache. Unknown caller-made
+    mappings opt out; no secret values (or mappings) enter cache keys.
+    """
+    scope = current_secret_scope()
+    if scope is None:
+        return ()
+    return scope.cache_revision if isinstance(scope, _ProfileSecretScope) else None
+
+
+def _env_snapshot_revision(home: Path) -> Optional[tuple]:
+    try:
+        path = (home / ".env").resolve()
+        try:
+            stat = path.stat()
+            return (str(path), stat.st_mtime_ns, stat.st_ctime_ns,
+                    stat.st_size, stat.st_ino)
+        except FileNotFoundError:
+            return (str(path), None)
+    except (OSError, RuntimeError):
+        return None
+
+
