+def tool_availability_revision() -> Optional[tuple]:
+    """Non-secret revision of the active profile's availability inputs.
+
+    Do not read credential contents or cache their values. File identity and
+    timestamps detect native setup, CLI auth, atomic replacements and removal.
+    The global auth file is included because native auth permits a read-only
+    root fallback. Its metadata never supplies another profile's probe result.
+    Unresolved identity / inaccessible metadata bypasses caching.
+    """
+    if check_fn_cache_scope() == CHECK_FN_CACHE_BYPASS:
+        return None
+    try:
+        from hermes_constants import get_hermes_home, get_default_hermes_root
+        from agent.secret_scope import secret_scope_cache_revision
+
+        secret_revision = secret_scope_cache_revision()
+        if secret_revision is None:
+            return None
+
+        profile = get_hermes_home().resolve()
+        root = get_default_hermes_root().resolve()
+        paths = [profile / name for name in ("auth.json", ".env", "config.yaml")]
+        if root != profile:
+            paths.append(root / "auth.json")
+        metadata = []
+        for path in paths:
+            try:
+                stat = path.stat()
+                fingerprint = (stat.st_mtime_ns, stat.st_ctime_ns,
+                               stat.st_size, stat.st_ino)
+            except FileNotFoundError:
+                fingerprint = None
+            metadata.append((str(path), fingerprint))
+        return (str(profile), tuple(metadata), secret_revision, _tool_availability_epoch)
+    except (OSError, RuntimeError):
+        return None
 
 
