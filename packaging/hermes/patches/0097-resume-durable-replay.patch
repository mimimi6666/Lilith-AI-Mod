+@pytest.mark.parametrize("mode", ["lazy", "deferred", "deferred-omit", "eager", "eager-omit"])
+def test_real_resume_handler_opts_in_for_each_db_acquisition(stored, monkeypatch, tmp_path, mode):
+    known = set(server._sessions)
+    monkeypatch.setattr(server, "_get_db", lambda: stored)
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(server, "_find_live_session_by_key", lambda _key: None)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_maybe_schedule_auto_continue", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_default_session_cwd", lambda *a, **k: str(tmp_path))
+    monkeypatch.setattr(server, "_make_agent", lambda *a, **k: types.SimpleNamespace(model="fake"))
+    monkeypatch.setattr(server, "_session_info", lambda *a, **k: {"model": "fake"})
+    monkeypatch.setattr(server, "_stored_session_runtime_overrides", lambda *a: {})
+    captured = []
+    def capture_init(sid, key, agent, history, **kwargs):
+        captured.extend(history)
+    monkeypatch.setattr(server, "_init_session", capture_init)
+    params = {"session_id": "game-root", "lazy": mode == "lazy",
+              "eager_build": mode.startswith("eager"), "omit_messages": mode.endswith("omit")}
+    try:
+        response = server.handle_request({"id": "resume-test", "method": "session.resume", "params": params})
+        assert "error" not in response, response
+        if not mode.startswith("eager"):
+            captured.extend(server._sessions[response["result"]["session_id"]]["history"])
+        assert captured
+        assert all(row.get("_db_persisted") is True for row in captured)
+        assert "_db_persisted" not in json.dumps(response["result"].get("messages", []))
+        before = _rows(stored)
+        agent = _persistence_agent(stored, captured)
+        assert agent._flush_messages_to_session_db(captured) is True
+        assert _rows(stored) == before
+    finally:
+        for sid in set(server._sessions) - known:
+            server._sessions.pop(sid, None)
+
