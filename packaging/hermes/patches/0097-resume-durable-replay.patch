+@pytest.mark.parametrize("invoke", [_extend, _foreground], ids=["native", "foreground"])
+def test_cold_loaded_history_extension_handoff_and_real_finalizer_are_idempotent(
+    extension_session, invoke, monkeypatch,
+):
+    db, session, model, _emitted = extension_session
+    db.append_messages_batch("game-root", [
+        {"role": "user", "content": "A stored user message."},
+        {"role": "assistant", "content": "A stored assistant message."},
+        {"role": "assistant", "content": "A second stored assistant message."},
+    ])
+    session["history"] = _loaded(db, "combined")
+    assert all(row.get("_db_persisted") is True for row in session["history"])
+    assert "error" not in invoke()
+    _join(session)
+    before = _rows(db)
+    receipts = [dict(row) for row in db._conn.execute("SELECT * FROM native_assistant_extensions")]
+    assert model._session_messages == session["history"]
+    pending = {"role": "user", "content": "Still pending at shutdown."}
+    agent = _persistence_agent(db, list(model._session_messages) + [pending])
+    agent._save_session_log = lambda _messages: None
+    agent.commit_memory_session = lambda _messages: None
+    session["agent"] = agent
+    import hermes_cli.lifecycle
+    monkeypatch.setattr(hermes_cli.lifecycle, "invoke_hook", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_notify_session_boundary", lambda *a, **k: None)
+    server._finalize_session(session, "test_shutdown")
+    after = _rows(db)
+    assert after[:-1] == before
+    assert after[-1]["content"] == pending["content"]
+    assert pending.get("_db_persisted") is True
+    server._finalize_session(session, "test_shutdown")
+    assert agent._flush_messages_to_session_db(agent._session_messages) is True
+    assert _rows(db) == after
+    assert [dict(row) for row in db._conn.execute("SELECT * FROM native_assistant_extensions")] == receipts
+
+
+def test_cold_loaded_history_official_event_handoff_does_not_replay_prefix(extension_session):
+    db, session, model, _emitted = extension_session
+    db.append_message("game-root", "user", "Old user message.")
+    db.append_message("game-root", "assistant", "Old assistant message.")
+    session["history"] = _loaded(db, "combined")
+    response = server._methods["session.append_assistant_event"](
+        "append-again", _append_params(event_id="9" * 32, line_id="2200002")
+    )
+    assert "error" not in response
+    before = _rows(db)
+    assert model._session_messages == session["history"]
+    agent = _persistence_agent(db, list(model._session_messages))
+    assert agent._flush_messages_to_session_db(agent._session_messages) is True
+    assert _rows(db) == before
+
