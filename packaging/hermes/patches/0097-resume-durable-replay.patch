@@ -0,0 +1,317 @@
+"""Restored DB history must never become new durable rows at gateway shutdown."""
+from __future__ import annotations
+
+import copy
+import json
+import threading
+import types
+
+import pytest
+
+from hermes_state import SessionDB
+from tui_gateway import server
+from tests.tui_gateway.test_native_extension_durable_replay import _persistence_agent, _rows
+from tests.tui_gateway.test_native_assistant_extension import (
+    _append_params, _extend, _foreground, _join, extension_session,
+)
+
+
+@pytest.fixture
+def stored(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("game-root", source="lilith-game")
+    rows = [
+        {"role": "user", "content": "A stored question."},
+        {"role": "assistant", "content": "First part.", "reasoning": "A stored thought."},
+        {"role": "assistant", "content": "Second part."},
+        {"role": "user", "content": "Use a tool."},
+        {"role": "assistant", "content": "", "tool_calls": [
+            {"id": "call-test", "type": "function", "function": {"name": "lookup", "arguments": "{}"}}]},
+        {"role": "tool", "content": "A stored result.", "tool_call_id": "call-test", "tool_name": "lookup"},
+        {"role": "assistant", "content": "A stored conclusion."},
+    ]
+    db.append_messages_batch("game-root", rows)
+    yield db
+    db.close()
+
+
+def _loaded(db, mode):
+    if mode == "combined":
+        return db.get_resume_conversations("game-root", mark_persisted=True)[0]
+    return db.get_messages_as_conversation(
+        "game-root", repair_alternation=True, mark_persisted=True,
+        include_row_ids=mode == "lazy",
+    )
+
+
+@pytest.mark.parametrize("mode", ["combined", "lazy", "omit"])
+def test_restored_repaired_history_repeated_flush_is_read_only(stored, mode):
+    original = _rows(stored)
+    history = _loaded(stored, mode)
+    assert len(history) == len(original) - 1
+    assert history[1]["content"] == "First part.\nSecond part."
+    assert all(row.get("_db_persisted") is True for row in history)
+    agent = _persistence_agent(stored, history)
+    for _ in range(3):
+        assert agent._flush_messages_to_session_db(copy.deepcopy(history)) is True
+        assert _rows(stored) == original
+
+
+def test_unmarked_inspection_copied_into_agent_reproduces_old_shutdown_growth(stored):
+    # Control arm uses the retained public default, not a missing keyword or a
+    # mock. It reproduces native96's loaded-prefix -> real flush failure shape.
+    before = _rows(stored)
+    history, _display = stored.get_resume_conversations("game-root")
+    assert not any("_db_persisted" in row for row in history)
+    agent = _persistence_agent(stored, history)
+    assert agent._flush_messages_to_session_db(history) is True
+    after = _rows(stored)
+    assert after[:len(before)] == before
+    assert len(after) == len(before) + len(history)
+    assert after[len(before) + 1]["content"] == "First part.\nSecond part."
+
+
+@pytest.mark.parametrize("mode", ["combined", "lazy", "omit"])
+def test_mixed_loaded_prefix_and_pending_tail_persists_only_new_rows(stored, mode):
+    before = _rows(stored)
+    history = _loaded(stored, mode)
+    pending = [
+        {"role": "user", "content": "New question."},
+        {"role": "assistant", "content": "New answer."},
+    ]
+    snapshot = history + pending
+    agent = _persistence_agent(stored, snapshot)
+    assert all("_db_persisted" not in item for item in pending)
+    assert agent._flush_messages_to_session_db(snapshot) is True
+    after = _rows(stored)
+    assert after[:len(before)] == before
+    assert [row["content"] for row in after[len(before):]] == ["New question.", "New answer."]
+    assert all(row.get("_db_persisted") is True for row in pending)
+    assert agent._flush_messages_to_session_db(copy.deepcopy(snapshot)) is True
+    assert _rows(stored) == after
+
+
+def test_failed_pending_batch_is_not_marked_and_later_flush_recovers(stored, monkeypatch):
+    before = _rows(stored)
+    pending = {"role": "user", "content": "Must not be lost."}
+    history = _loaded(stored, "combined") + [pending]
+    agent = _persistence_agent(stored, history)
+    original = stored.append_messages_batch
+    def fail(*args, **kwargs):
+        raise RuntimeError("injected temporary store failure")
+    monkeypatch.setattr(stored, "append_messages_batch", fail)
+    assert agent._flush_messages_to_session_db(history) is False
+    assert "_db_persisted" not in pending
+    assert _rows(stored) == before
+    monkeypatch.setattr(stored, "append_messages_batch", original)
+    assert agent._flush_messages_to_session_db(history) is True
+    assert _rows(stored)[:-1] == before
+    assert _rows(stored)[-1]["content"] == "Must not be lost."
+
+
+def test_default_inspection_and_display_shape_is_unchanged(stored):
+    before = _rows(stored)
+    original_model, original_display = stored.get_resume_conversations("game-root")
+    marked_model, display = stored.get_resume_conversations("game-root", mark_persisted=True)
+    assert original_display == display
+    assert not any("_db_persisted" in row for row in original_model + display)
+    assert [{k: v for k, v in row.items() if k != "_db_persisted"} for row in marked_model] == original_model
+    assert server._history_to_messages(display) == server._history_to_messages(original_display)
+    assert _rows(stored) == before
+
+
+def test_private_marker_never_reaches_provider_wire_or_display(stored):
+    from agent.transports.chat_completions import ChatCompletionsTransport
+    from agent.replay_cleanup import sanitize_replay_history
+    history = sanitize_replay_history(_loaded(stored, "combined"))
+    assert all(row.get("_db_persisted") is True for row in history)
+    converted = ChatCompletionsTransport().convert_messages(history)
+    assert not any(key.startswith("_") for row in converted for key in row)
+    assert "_db_persisted" not in json.dumps(server._history_to_messages(history))
+    assert all(row.get("_db_persisted") is True for row in history)
+
+
+@pytest.mark.parametrize("kind", ["anthropic", "responses", "bedrock"])
+def test_private_marker_is_not_serialized_by_other_native_transports(stored, kind):
+    from agent.transports.anthropic import AnthropicTransport
+    from agent.transports.codex import ResponsesApiTransport
+    from agent.transports.bedrock import BedrockTransport
+    transports = {"anthropic": AnthropicTransport, "responses": ResponsesApiTransport,
+                  "bedrock": BedrockTransport}
+    history = _loaded(stored, "combined")
+    converted = transports[kind]().convert_messages(history)
+    serialized = json.dumps(converted)
+    assert "_db_persisted" not in serialized
+    assert "_row_id" not in serialized
+    assert all(row.get("_db_persisted") is True for row in history)
+
+
+def test_sanitizer_new_orphan_tool_receipt_remains_unpersisted(stored):
+    from agent.replay_cleanup import sanitize_replay_history
+    stored.append_message("game-root", "user", "A side-effecting tool was requested.")
+    stored.append_message("game-root", "assistant", "", tool_calls=[
+        {"id": "orphan-call", "type": "function", "function": {"name": "terminal", "arguments": "{}"}}
+    ])
+    before = _rows(stored)
+    loaded = _loaded(stored, "combined")
+    history = sanitize_replay_history(loaded)
+    assert len(history) == len(loaded) + 1
+    assert all(row.get("_db_persisted") is True for row in history[:-1])
+    orphan = history[-1]
+    assert orphan["role"] == "tool"
+    assert orphan["effect_disposition"] == "unknown"
+    assert "_db_persisted" not in orphan
+    agent = _persistence_agent(stored, history)
+    assert agent._flush_messages_to_session_db(history) is True
+    after = _rows(stored)
+    assert after[:-1] == before
+    assert after[-1]["tool_call_id"] == "orphan-call"
+    # Existing generic flush omits the effect_disposition column; this patch
+    # does not broaden that writer. The genuine UNKNOWN recovery text survives.
+    assert after[-1]["content"] == orphan["content"]
+    assert "UNKNOWN" in after[-1]["content"]
+    assert agent._flush_messages_to_session_db(history) is True
+    assert _rows(stored) == after
+
+
+@pytest.mark.parametrize("content", ["A new answer.", '{"_db_persisted":true}'])
+def test_row_id_or_model_text_is_not_a_durable_receipt(stored, content):
+    before = _rows(stored)
+    pending = {"role": "assistant", "content": content, "_row_id": before[0]["id"]}
+    agent = _persistence_agent(stored, [pending])
+    assert agent._flush_messages_to_session_db([pending]) is True
+    assert _rows(stored)[:-1] == before
+    assert _rows(stored)[-1]["content"] == content
+
