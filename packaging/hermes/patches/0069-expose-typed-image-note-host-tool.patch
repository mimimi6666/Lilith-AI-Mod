@@ -0,0 +1,411 @@
+from __future__ import annotations
+
+import contextvars
+import gc
+import hashlib
+import threading
+import weakref
+import pytest
+
+from tui_gateway import lilith_noteinbox_bridge as bridge, server
+from tui_gateway.transport import bind_transport, reset_transport
+
+SID, TID = "note-tool-fixture", "1" * 32
+ARGS = {"action": "deliver", "locale": "zh-TW", "text": "今天也辛苦了。 —莉莉絲"}
+
+
+def receipt(payload, status="delivered"):
+    return {
+        "version": 1,
+        "kind": bridge.RESULT_KIND,
+        "operation_id": payload["operation_id"],
+        "delivery_id": payload["delivery_id"],
+        "status": status,
+        "code": "ok" if status == "delivered" else "runtime.note_owner_unavailable",
+        "artifact": {
+            "artifact_id": payload["delivery_id"],
+            "sha256": "A" * 64,
+            "byte_length": 123,
+            "completed_at_utc": "2026-09-07T00:00:00.0000000+00:00",
+        }
+        if status == "delivered"
+        else None,
+    }
+
+
+@pytest.fixture
+def owner(monkeypatch):
+    old = dict(server._sessions)
+    bridge._reset_for_tests()
+    frames = []
+
+    class Transport:
+        def write(self, frame):
+            frames.append(frame)
+            return True
+
+    transport = Transport()
+    session = {
+        "transport": transport,
+        "running": True,
+        "inflight_turn": {"turn_id": TID},
+    }
+    server._sessions[SID] = session
+    monkeypatch.setattr(
+        "gateway.session_context.get_session_env",
+        lambda key, default="": SID if key == "HERMES_UI_SESSION_ID" else default,
+    )
+    tokens = (
+        bind_transport(transport),
+        server._current_runtime_session_record.set(session),
+        server._current_turn_event_id.set(TID),
+    )
+    emit = server._emit
+    control = {"reply": True, "status": "delivered"}
+
+    def complete(payload, result=None, via=None):
+        return server.dispatch(
+            {
+                "jsonrpc": "2.0",
+                "id": "ack",
+                "method": "lilith.host.complete",
+                "params": {
+                    "session_id": SID,
+                    "turn_id": TID,
+                    "result": result or receipt(payload, control["status"]),
+                },
+            },
+            transport=via or transport,
+        )
+
+    def wrapped(kind, sid, payload):
+        outcome = emit(kind, sid, payload)
+        if control["reply"]:
+            control["ack"] = complete(payload)
+        return outcome
+
+    monkeypatch.setattr(server, "_emit", wrapped)
+    yield frames, session, control, complete
+    server._current_turn_event_id.reset(tokens[2])
+    server._current_runtime_session_record.reset(tokens[1])
+    reset_transport(tokens[0])
+    bridge._reset_for_tests()
+    server._sessions.clear()
+    server._sessions.update(old)
+
+
+def test_real_current_authority_event_and_exact_three_field_ack(owner):
+    frames, _, control, _ = owner
+    result = bridge.request_note(ARGS)
+    frame = frames[0]["params"]
+    payload = frame["payload"]
+    assert (
+        frame["type"] == "lilith.host.request"
+        and frame["session_id"] == SID
+        and frame["turn_id"] == TID
+    )
+    assert set(payload) == {
+        "version",
+        "kind",
+        "operation_id",
+        "delivery_id",
+        "arguments",
+    }
+    assert (
+        payload["kind"] == "lilith.noteinbox.host-request"
+        and payload["arguments"] == ARGS
+    )
+    assert result == receipt(payload)
+    assert control["ack"]["result"] == {
+        "accepted": True,
+        "operation_id": payload["operation_id"],
+        "delivery_id": payload["delivery_id"],
+    }
+
+
+def test_delivery_identity_exact_cross_language_vector():
+    expected = hashlib.sha256(
+        ("lilith.noteinbox.delivery.v1\0" + SID + "\0" + TID).encode()
+    ).hexdigest()[:32]
+    assert bridge.delivery_id_for_turn(SID, TID) == expected
+    assert bridge.delivery_id_for_turn(SID, "2" * 32) != expected
+    assert bridge.delivery_id_for_turn(SID + "x", TID) != expected
+
+
+@pytest.mark.parametrize(
+    "status", ["delivered", "deferred", "rejected", "failed", "unknown", "not_found"]
+)
+def test_same_turn_retry_queries_same_delivery_and_never_emits_another_deliver(
+    owner, status
+):
+    frames, _, control, _ = owner
+    control["status"] = status
+    bridge.request_note(ARGS)
+    bridge.request_note(ARGS)
+    a, b = [frame["params"]["payload"] for frame in frames]
+    assert (
+        a["delivery_id"] == b["delivery_id"] and a["operation_id"] != b["operation_id"]
+    )
+    assert b["arguments"] == {"action": "status", "locale": "zh-TW"}
+
+
+@pytest.mark.parametrize("changed", [{"text": "different"}, {"locale": "en"}])
+def test_same_turn_different_payload_rejected_before_emit(owner, changed):
+    frames, _, _, _ = owner
+    bridge.request_note(ARGS)
+    with pytest.raises(bridge.LilithHostAuthorityError):
+        bridge.request_note({**ARGS, **changed})
+    assert len(frames) == 1
+
+
+def test_status_does_not_mint_write_seal(owner):
+    frames, _, control, _ = owner
+    control["status"] = "not_found"
+    bridge.request_note({"action": "status", "locale": "en"})
+    assert not bridge._seals
+    bridge.request_note(ARGS)
+    assert [frame["params"]["payload"]["arguments"]["action"] for frame in frames] == [
+        "status",
+        "deliver",
+    ]
+
+
+def test_timeout_retains_seal_late_completion_rejected_retry_status_only(owner):
+    frames, _, control, complete = owner
+    control["reply"] = False
+    with pytest.raises(bridge.LilithHostUnavailableError):
+        bridge.request_note(ARGS, timeout_seconds=0.005)
+    assert not bridge._pending and len(bridge._seals) == 1
+    assert "error" in complete(frames[0]["params"]["payload"])
+    control["reply"] = True
+    bridge.request_note(ARGS)
+    assert frames[-1]["params"]["payload"]["arguments"]["action"] == "status"
+
+
+def test_exact_completion_replay_and_conflict(owner):
+    frames, _, _, complete = owner
+    bridge.request_note(ARGS)
+    payload = frames[0]["params"]["payload"]
+    assert complete(payload)["result"]["accepted"] is True
+    altered = receipt(payload)
+    altered["artifact"]["byte_length"] += 1
+    assert "error" in complete(payload, altered)
+    assert "error" in complete(payload, via=object())
+
+
+@pytest.mark.parametrize("change", ["running", "turn", "transport", "session"])
+def test_stale_owner_is_rejected_before_dispatch(owner, change):
+    frames, session, _, _ = owner
+    if change == "running":
+        session["running"] = False
+    if change == "turn":
+        session["inflight_turn"]["turn_id"] = "2" * 32
+    if change == "transport":
+        session["transport"] = object()
+    if change == "session":
+        server._sessions[SID] = dict(session)
+    with pytest.raises(bridge.LilithHostAuthorityError):
+        bridge.request_note(ARGS)
+    assert not frames
+
+
+def test_delivery_capacity_fails_closed_without_eviction(owner, monkeypatch):
+    frames, _, _, _ = owner
+    monkeypatch.setattr(bridge, "MAX_DELIVERY_SEALS", 0)
+    with pytest.raises(bridge.LilithHostUnavailableError):
+        bridge.request_note(ARGS)
+    assert not frames
+
+
+@pytest.mark.parametrize("change", ["running", "turn", "transport", "session"])
+def test_inflight_owner_change_rejects_completion_and_result(
+    owner, monkeypatch, change
+):
+    frames, session, control, complete = owner
+    control["reply"] = False
+    emit = server._emit
+
+    def changed(kind, sid, payload):
+        emitted = emit(kind, sid, payload)
+        if change == "running":
+            session["running"] = False
+        if change == "turn":
+            session["inflight_turn"]["turn_id"] = "2" * 32
+        if change == "transport":
+            session["transport"] = object()
+        if change == "session":
+            server._sessions[SID] = dict(session)
+        assert "error" in complete(payload)
+        return emitted
+
+    monkeypatch.setattr(server, "_emit", changed)
+    with pytest.raises(bridge.LilithHostAuthorityError):
+        bridge.request_note(ARGS, timeout_seconds=0.005)
+    assert len(frames) == 1 and not bridge._pending and len(bridge._seals) == 1
+
+
+def test_concurrent_same_turn_delivery_has_only_one_write_request(owner, monkeypatch):
+    frames, _, control, _ = owner
+    control["reply"] = False
+    emitted = threading.Event()
+    original = server._emit
+
+    def capture(kind, sid, payload):
+        result = original(kind, sid, payload)
+        emitted.set()
+        return result
+
+    monkeypatch.setattr(server, "_emit", capture)
+    outcome = []
+
+    def first():
+        try:
+            bridge.request_note(ARGS, timeout_seconds=0.15)
+        except bridge.LilithHostUnavailableError:
+            outcome.append("unknown")
+
+    context = contextvars.copy_context()
+    worker = threading.Thread(target=context.run, args=(first,))
+    worker.start()
+    assert emitted.wait(1)
+    control["reply"] = True
+    bridge.request_note(ARGS)
+    worker.join(1)
+    assert not worker.is_alive() and outcome == ["unknown"]
+    payloads = [frame["params"]["payload"] for frame in frames]
+    assert [payload["arguments"]["action"] for payload in payloads] == [
+        "deliver",
+        "status",
+    ]
+    assert len({payload["delivery_id"] for payload in payloads}) == 1
+
+
+def test_pending_capacity_does_not_emit_or_mint_delivery(owner, monkeypatch):
+    frames, _, _, _ = owner
+    monkeypatch.setattr(bridge, "MAX_PENDING_REQUESTS", 0)
+    with pytest.raises(bridge.LilithHostUnavailableError):
+        bridge.request_note(ARGS)
+    assert not frames and not bridge._seals
+
+
+def test_permanent_seal_does_not_keep_closed_session_container_alive():
+    bridge._reset_for_tests()
+
+    def closed_session():
+        session = {"fixture_conversation": ["private fake history"]}
+        epoch = bridge._authority_epoch_locked(session, object())
+        reference = weakref.ref(epoch)
+        bridge._seals["1" * 32] = (reference, b"fixture digest")
+        return reference
+
+    reference = closed_session()
+    gc.collect()
+    assert reference() is None
+    assert len(bridge._seals) == 1  # Tombstone survives GC; no new grant.
+    bridge._reset_for_tests()
+
+
+def test_same_session_id_with_new_current_container_cannot_reuse_old_seal(owner):
+    frames, session, _, _ = owner
+    bridge.request_note(ARGS)
+    replacement = dict(session)  # Even copying the private epoch is not authority.
+    server._sessions[SID] = replacement
+    token = server._current_runtime_session_record.set(replacement)
+    try:
+        with pytest.raises(bridge.LilithHostAuthorityError):
+            bridge.request_note(ARGS)
+    finally:
+        server._current_runtime_session_record.reset(token)
+    assert len(frames) == 1
+
+
+def test_same_current_container_rebound_transport_cannot_reuse_old_seal(owner):
+    frames, session, _, _ = owner
+    bridge.request_note(ARGS)
+    transport = object()
+    session["transport"] = transport
+    token = bind_transport(transport)
+    try:
+        with pytest.raises(bridge.LilithHostAuthorityError):
+            bridge.request_note(ARGS)
+    finally:
+        reset_transport(token)
+    assert len(frames) == 1
+
+
+@pytest.mark.parametrize(
+    "arguments",
+    [
+        None,
+        {},
+        {**ARGS, "path": "x"},
+        {**ARGS, "delivery_id": "a" * 32},
+        {**ARGS, "text": " "},
+        {**ARGS, "text": "a" * 1201},
+        {**ARGS, "text": "😀" * 601},
+        {**ARGS, "text": "\ud800"},
+        {**ARGS, "text": "a\0b"},
+        {**ARGS, "locale": "zh-Hant"},
+        {"action": "status", "locale": "en", "text": "x"},
+        {"action": "deliver", "locale": "en"},
+    ],
+)
+def test_closed_arguments_reject_model_identity_path_and_bounds(arguments):
+    with pytest.raises(bridge.LilithHostProtocolError):
+        bridge.normalize_note_arguments(arguments)
+
+
+@pytest.mark.parametrize("locale", ["zh-TW", "zh-CN", "ja", "en"])
+def test_supported_locales_and_utf16_boundary(locale):
+    value = {**ARGS, "locale": locale, "text": "😀" * 600}
+    assert bridge.normalize_note_arguments(value) == value
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        "extra",
+        "id",
+        "sha",
+        "size",
+        "time",
+        "offset",
+        "artifact_extra",
+        "missing_time",
+        "code",
+        "status",
+        "nonready_artifact",
+    ],
+)
+def test_receipts_reject_forged_or_unverified_artifacts(change):
+    result = receipt({"operation_id": "3" * 32, "delivery_id": "4" * 32})
+    if change == "extra":
+        result["path"] = "x"
+    if change == "id":
+        result["artifact"]["artifact_id"] = "5" * 32
+    if change == "sha":
+        result["artifact"]["sha256"] = "a" * 64
+    if change == "size":
+        result["artifact"]["byte_length"] = True
+    if change == "time":
+        result["artifact"]["completed_at_utc"] = "2026-09-07"
+    if change == "offset":
+        result["artifact"]["completed_at_utc"] = "2026-09-07T00:00:00.0000000+08:00"
+    if change == "artifact_extra":
+        result["artifact"]["path"] = "x"
+    if change == "missing_time":
+        result["artifact"].pop("completed_at_utc")
+    if change == "code":
+        result["code"] = "queued"
+    if change == "status":
+        result["status"] = "ready"
+    if change == "nonready_artifact":
+        result.update(status="unknown", code="unknown")
+    with pytest.raises(bridge.LilithHostProtocolError):
+        bridge.normalize_note_result(result, "3" * 32, "4" * 32)
+
+
+@pytest.mark.parametrize("timeout", [0, -1, True, 21, float("inf"), float("nan")])
+def test_timeout_must_be_finite_and_bounded(timeout):
+    with pytest.raises(bridge.LilithHostProtocolError):
+        bridge.request_note(ARGS, timeout_seconds=timeout)
