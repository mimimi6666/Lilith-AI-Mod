         with self.assertRaisesRegex(setup.SetupError, "entry_in_use"):
             self.remove(in_use={ID})
 
+    def assert_saved_reference_protected(self):
+        from hermes_cli import credential_lifecycle
+        paths = credential_lifecycle._provider_mutation_paths()
+        before = {path: path.read_bytes() if path.exists() else None for path in paths}
+        finalized = list(self.finalized)
+        changes = ({"label": "Changed label"}, {"model_id": "different-model"},
+                   {"base_url": "http://127.0.0.1:8001/v1", "auth_mode": "api_key",
+                    "key_action": "replace", "api_key": "synthetic-rotated"},
+                   {"auth_mode": "api_key", "key_action": "replace", "api_key": "synthetic-rotated"})
+        # A refusal must occur before starting the multi-store mutation, not
+        # by writing and then trying to repair a dependent task afterwards.
+        with patch.object(credential_lifecycle, "_run_provider_mutation_transaction",
+                          side_effect=AssertionError("referenced provider reached writer")):
+            with self.assertRaisesRegex(setup.SetupError, "^setup.entry_in_use$"):
+                self.remove()
+            for change in changes:
+                with self.subTest(change=tuple(change)), self.assertRaisesRegex(setup.SetupError, "^setup.entry_in_use$"):
+                    self.save(**change)
+        self.assertEqual(before, {path: path.read_bytes() if path.exists() else None for path in paths})
+        self.assertEqual(finalized, self.finalized)
+        entry = setup.owned_entry(config.read_raw_config(), ID)
+        noop = self.save(auth_mode=entry["auth_mode"],
+                         key_action="keep" if entry["auth_mode"] == "api_key" else "clear")
+        self.assertFalse(noop["changed"])
+        self.assertEqual(before, {path: path.read_bytes() if path.exists() else None for path in paths})
+        self.assertEqual(finalized, self.finalized)
+
