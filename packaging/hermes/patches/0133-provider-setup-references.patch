+                        _save_aux_choice(task, provider=spelling, model="synthetic-model", base_url=base_url)
+                        saved = config.read_raw_config()["auxiliary"][task]
+                        self.assertEqual(spelling, saved["provider"])
+                        self.assertEqual(base_url, saved["base_url"])
