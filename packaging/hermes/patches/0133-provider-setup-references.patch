     return ""
 
 
+def _has_saved_provider_reference(config, provider_id):
+    """Read only known config.yaml route slots; never repair or infer a route.
+
+    A stored dependency matters even while idle or disabled. Arbitrary text,
+    model names, provider declarations and historical session data are not
+    references. Canonical and native bare-name spellings name the same entry.
+    """
+    def matches(slot):
+        return (type(slot) is dict
+                and normalize_setup_identity(slot.get("provider")) == provider_id)
+
+    auxiliary = config.get("auxiliary")
+    if type(auxiliary) is dict and any(matches(slot) for slot in auxiliary.values()):
+        return True
+    platforms = config.get("platforms")
+    if type(platforms) is dict:
+        for platform in platforms.values():
+            overrides = platform.get("channel_overrides") if type(platform) is dict else None
+            if type(overrides) is dict and any(matches(slot) for slot in overrides.values()):
+                return True
+
+    def preset_matches(preset):
+        if type(preset) is not dict:
+            return False
+        if matches(preset.get("aggregator")):
+            return True
+        refs = preset.get("reference_models")
+        # These are the same finite legacy representations accepted by native
+        # MoA. Do not call its normalizer: that would synthesize default routes.
+        if type(refs) is str:
+            try:
+                refs = json.loads(refs)
+            except (ValueError, RecursionError):
+                return False
+        if type(refs) is dict:
+            return matches(refs)
+        return type(refs) is list and any(matches(slot) for slot in refs)
+
+    moa = config.get("moa")
+    if preset_matches(moa):
+        return True
+    presets = moa.get("presets") if type(moa) is dict else None
+    return type(presets) is dict and any(preset_matches(preset) for preset in presets.values())
+
