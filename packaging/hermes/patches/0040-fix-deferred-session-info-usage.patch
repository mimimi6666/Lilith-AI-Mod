+@pytest.mark.parametrize("record_kind", ["create", "resume"])
+def test_deferred_build_session_info_uses_candidate_usage_for_create_and_resume(
+    monkeypatch, tmp_path, record_kind
+):
+    """Both deferred entry points publish the built candidate's usage shape."""
+
+    class CandidateAgent:
+        model = "test-model"
+        provider = "test-provider"
+        session_id = "stored-session"
+        service_tier = None
+        reasoning_config = None
+        request_overrides = {}
+        session_input_tokens = 11
+        session_output_tokens = 7
+        session_reasoning_tokens = 0
+        session_prompt_tokens = 11
+        session_completion_tokens = 7
+        session_total_tokens = 18
+        session_api_calls = 2
+        context_compressor = None
+        tools = []
+        api_key = "configured"
+        _cached_system_prompt = ""
+
+    events = []
+    override = {"model": "test-model", "provider": "test-provider"}
+
+    monkeypatch.setattr(server, "_set_session_context", lambda _target: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", lambda *_args, **_kwargs: CandidateAgent())
+    monkeypatch.setattr(server, "_wire_callbacks", lambda _sid: None)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: events.append((event, sid, payload)),
+    )
+    monkeypatch.setattr(
+        server, "_start_notification_poller", lambda *_args, **_kwargs: threading.Event()
+    )
+    monkeypatch.setattr(server, "_notify_session_boundary", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_schedule_mcp_late_refresh", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_probe_config_health", lambda *_args: None)
+    monkeypatch.setattr(server, "_config_model_target", lambda: ("", ""))
+    monkeypatch.setattr(server, "_load_memory_notifications", lambda: [])
+    monkeypatch.setattr(server, "_load_cfg", lambda: {})
+    monkeypatch.setattr(server, "_load_approval_mode", lambda: "manual")
+    monkeypatch.setattr(server, "_git_branch_for_cwd", lambda _cwd: "")
+    monkeypatch.setattr(server, "_project_info_for_cwd", lambda _cwd: None)
+    monkeypatch.setattr(server, "_effective_terminal_backend", lambda: "local")
+    monkeypatch.setattr(server, "_session_live_title", lambda *_args, **_kwargs: "")
+    monkeypatch.setattr(server, "_current_profile_name", lambda: "default")
+    monkeypatch.setattr(server, "_probe_credentials", lambda _agent: "")
+    monkeypatch.setattr(
+        server,
+        "_resolve_session_create_model_pair",
+        lambda **_kwargs: ("test-model", "test-provider"),
+    )
+    monkeypatch.setattr(server, "_completion_cwd", lambda _params=None: str(tmp_path))
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(server, "_register_session_cwd", lambda _session: None)
+    monkeypatch.setattr("tui_gateway.entry.ensure_mcp_discovery_started", lambda: None)
+    monkeypatch.setattr("tools.approval.register_gateway_notify", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr("tools.approval.load_permanent_allowlist", lambda: None)
+    monkeypatch.setattr("agent.credits_tracker.seed_credits_at_session_start", lambda _agent: None)
+    monkeypatch.setattr("hermes_cli.banner.get_available_skills", lambda: {})
+    monkeypatch.setattr("hermes_cli.banner.get_update_result", lambda timeout=0.5: None)
+    monkeypatch.setattr("hermes_cli.config.recommended_update_command", lambda: "")
+    monkeypatch.setattr("tools.mcp_tool.get_mcp_status", lambda: [])
+
+    sid = ""
+    try:
+        if record_kind == "create":
+            response = server._methods["session.create"]("create", {"cols": 80})
+            assert "error" not in response
+            sid = response["result"]["session_id"]
+            session = server._sessions[sid]
+        else:
+            sid = "resume-deferred"
