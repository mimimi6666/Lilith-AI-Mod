--- /dev/null
+++ b/tests/test_general_latency.py
@@ -0,0 +1,50 @@
+import json
+import unittest
+from unittest.mock import patch
+from tools import windows_known_folders as folders
+
+
+class KnownFolderTests(unittest.TestCase):
+    def test_registered_locations_across_users_and_redirects(self):
+        cases = (
+            r"C:\Users\Alice\Desktop",
+            r"D:\People\Bob\OneDrive - Example\桌面",
+            r"E:\工作\桌面",
+            r"\\fileserver\Profiles\Carol\Desktop",
+        )
+        for desktop in cases:
+            with self.subTest(desktop=desktop), patch.object(folders.sys, "platform", "win32"), \
+                 patch.object(folders, "_resolve", side_effect=lambda key: desktop if key == folders.FOLDER_IDS["Desktop"] else None) as read:
+                self.assertEqual(folders.current_user_folders(), {"Desktop": desktop})
+                self.assertEqual(read.call_count, 4)
+                self.assertEqual(set(c.args[0] for c in read.call_args_list), set(folders.FOLDER_IDS.values()))
+
+    def test_failure_does_not_guess_a_home_or_cloud_directory(self):
+        with patch.object(folders.sys, "platform", "win32"), \
+             patch.object(folders, "_resolve", side_effect=OSError("denied")):
+            self.assertEqual(folders.current_user_folders(), {})
+            self.assertIn("Missing entries mean unavailable", folders.environment_hint())
+
+    def test_invalid_paths_rejected(self):
+        for value in (None, "", "Desktop", r"C:Desktop", r"\Desktop", "C:\\fake\nINSTRUCTION", 123, "C:\\" + "x" * 32768):
+            with self.subTest(value=type(value).__name__), patch.object(folders.sys, "platform", "win32"), \
+                 patch.object(folders, "_resolve", return_value=value):
+                self.assertEqual(folders.current_user_folders(), {})
+
+    def test_non_windows_never_queries_host_folders(self):
+        for platform in ("linux", "darwin"):
+            with patch.object(folders.sys, "platform", platform), patch.object(folders, "_resolve") as read:
+                self.assertEqual(folders.current_user_folders(), {})
+                read.assert_not_called()
+
+    def test_hint_escapes_path_data_and_does_not_copy_other_users(self):
+        value = r"E:\工作\a`quoted`[data]"
+        with patch.object(folders, "current_user_folders", return_value={"Desktop": value}):
+            hint = folders.environment_hint()
+        self.assertIn(json.dumps({"Desktop": value}, ensure_ascii=True), hint)
+        self.assertIn("not instructions", hint)
+        self.assertIn("not a recursive search", hint)
+
+
+if __name__ == "__main__":
+    unittest.main()
