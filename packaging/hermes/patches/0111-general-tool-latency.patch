@@ -0,0 +1,166 @@
+"""Native modules, synthetic driver/OS data. No real app or player access."""
+import base64
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+import pytest
+from tools.computer_use.cua_backend import CuaDriverBackend, _CuaDriverSession
+from tools.computer_use import tool as cu
+
+
+def backend(properties=(), capabilities=()):
+    session = _CuaDriverSession.__new__(_CuaDriverSession)
+    session._capabilities = {"click": set(capabilities), "get_window_state": set()}
+    session._tool_schemas = {"click": {"properties": dict.fromkeys(properties, {})}}
+    calls = []
+    session.call_tool = lambda name, args: calls.append((name, dict(args))) or {
+        "isError": False, "data": "ok", "structuredContent": {"status": "accepted"}}
+    instance = CuaDriverBackend.__new__(CuaDriverBackend)
+    instance._session = session
+    instance._session_id = "synthetic"
+    instance._active_pid = 12
+    instance._active_window_id = 34
+    instance._last_target = {"pid": 12, "window_id": 34}
+    instance._last_app = "Fixture App"
+    instance._snapshot_tokens = {5: "opaque-snapshot:5"}
+    instance._snapshot_id = "opaque-snapshot"
+    instance._snapshot_indices = {5}
+    return instance, calls
+
+
+@pytest.mark.parametrize("properties,capabilities", [
+    (("element_token",), ()), ((), ("accessibility.element_tokens",)),
+    (("element_token", "snapshot_id"), ("accessibility.element_tokens",)),
+])
+def test_exact_token_from_live_schema_or_capability(properties, capabilities):
+    instance, calls = backend(properties, capabilities)
+    instance.click(element=5)
+    assert len(calls) == 1
+    assert calls[0][1]["element_token"] == "opaque-snapshot:5"
+    assert calls[0][1]["pid"] == 12
+
+
+def test_snapshot_pair_when_driver_does_not_publish_per_element_tokens():
+    instance, calls = backend(("snapshot_id",))
+    instance._snapshot_tokens = {}
+    instance.click(element=5)
+    assert calls[0][1]["snapshot_id"] == "opaque-snapshot"
+    assert calls[0][1]["element_index"] == 5
+
+
+@pytest.mark.parametrize("properties", [("element_token",), ("snapshot_id",)])
+def test_unknown_index_rejected_locally_without_retarget_or_retry(properties):
+    instance, calls = backend(properties)
+    result = instance.click(element=99)
+    assert result.ok is False and result.code == "fresh_element_capture_required"
+    assert not calls
+
+
+def test_true_legacy_schema_still_accepts_index_without_invented_fields():
+    instance, calls = backend(("element_index",))
+    instance._snapshot_tokens = {}
+    instance.click(element=5)
+    assert calls[0][1]["element_index"] == 5
+    assert "element_token" not in calls[0][1] and "snapshot_id" not in calls[0][1]
+
+
+def test_capture_and_vision_never_rebind_a_prior_index():
+    instance, calls = backend(("element_token", "snapshot_id"))
+    pixel = base64.b64encode(b"\x89PNG\r\n\x1a\n" + b"\0" * 8 + (20).to_bytes(4, "big") * 2).decode()
+    def driver(name, args):
+        calls.append((name, dict(args)))
+        sc = ({"windows": [{"app_name": "Fixture App", "pid": 12, "window_id": 34,
+                           "is_on_screen": True, "title": "Fixture", "z_index": 1}]}
+              if name == "list_windows" else
+              {"snapshot_id": "new-snapshot", "elements": [{"element_index": 7, "role": "button",
+               "label": "Fixture", "element_token": "new-snapshot:7"}], "screenshot_png_b64": pixel})
+        return {"data": "", "images": [], "isError": False, "structuredContent": sc}
+    instance._session.call_tool = driver
+    instance.capture(mode="som", pid=12, window_id=34)
+    assert instance._snapshot_tokens == {7: "new-snapshot:7"}
+    instance.click(element=7)
+    assert calls[-1][1]["element_token"] == "new-snapshot:7"
+    instance.capture(mode="vision", pid=12, window_id=34)
+    count = len(calls)
+    assert instance.click(element=7).code == "fresh_element_capture_required"
+    assert len(calls) == count
+
+
+def test_failed_capture_and_focus_clear_all_bindings():
+    instance, calls = backend(("snapshot_id",))
+    instance._load_windows = lambda: [{"pid": 56, "window_id": 78, "app_name": "Other Fixture"}]
+    instance._match_windows_for_app = lambda windows, app: windows
+    instance.focus_app("Other Fixture")
+    assert not instance._snapshot_tokens and instance._snapshot_id is None
+    assert not instance._snapshot_indices
+    assert instance.click(element=5).code == "fresh_element_capture_required"
+    instance._failed_capture("som")
+    assert instance._active_pid is None and not instance._snapshot_indices
+
+
+def test_driver_stale_error_not_automatically_retried_or_downgraded():
+    instance, calls = backend(("element_token",))
+    def stale(name, args):
+        calls.append((name, dict(args)))
+        return {"isError": True, "data": "stale snapshot", "structuredContent": {"code": "stale"}}
+    instance._session.call_tool = stale
+    assert not instance.click(element=5).ok
+    assert len(calls) == 1 and "element_token" in calls[0][1]
+
+
+def test_timing_is_numeric_only_even_on_failure():
+    with patch.object(cu.time, "perf_counter", side_effect=[1.0, 1.025]), \
+         patch.object(cu.logger, "info") as log:
+        with pytest.raises(ValueError):
+            with cu._timed_phase("launch_driver"):
+                raise ValueError("private path must not be logged")
+    args = log.call_args.args
+    assert args[1] == "launch_driver" and args[2] == pytest.approx(25)
+    assert "private" not in str(args)
+
+
+@pytest.mark.parametrize("hresult", [0, -2147024891])
+def test_native_known_folder_call_is_current_user_noncreating_and_freed(hresult):
+    import ctypes
+    from tools import windows_known_folders as folders
+    path = ctypes.create_unicode_buffer("E:\\Fixture\\Desktop")
+    calls, freed = [], []
+    class Function:
+        def __init__(self, fn): self.fn = fn
+        def __call__(self, *args): return self.fn(*args)
+    def resolve(guid, flags, token, result):
+        calls.append((ctypes.string_at(guid, 16), flags, token))
+        ctypes.cast(result, ctypes.POINTER(ctypes.c_void_p))[0] = ctypes.addressof(path)
+        return hresult
+    shell = SimpleNamespace(SHGetKnownFolderPath=Function(resolve))
+    ole = SimpleNamespace(CoTaskMemFree=Function(lambda pointer: freed.append(pointer.value)))
+    with patch.object(ctypes, "WinDLL", side_effect=lambda name, **kw: {"shell32": shell, "ole32": ole}[name]):
+        assert folders._resolve(folders.FOLDER_IDS["Desktop"]) == (path.value if hresult == 0 else None)
+    assert calls[0][1:] == (0x4000, None) and freed == [ctypes.addressof(path)]
+
+
+def test_remote_terminal_does_not_leak_local_known_folders():
+    import agent.prompt_builder as prompt
+    from tools import windows_known_folders as folders
+    with patch.dict(prompt.os.environ, {"TERMINAL_ENV": "ssh", "HERMES_ENVIRONMENT_HINT": "synthetic"}), \
+         patch.object(prompt, "_probe_remote_backend", return_value="remote fixture"), \
+         patch.object(prompt, "is_wsl", return_value=False), \
+         patch.object(folders, "environment_hint") as read:
+        text = prompt.build_environment_hints()
+    read.assert_not_called()
+    assert "remote fixture" in text and "Known Folders" not in text
+
+
+def test_local_guidance_covers_lifecycle_without_brand_or_fixed_waits():
+    import agent.prompt_builder as prompt
+    from tools import windows_known_folders as folders
+    with patch.dict(prompt.os.environ, {"TERMINAL_ENV": "local", "HERMES_ENVIRONMENT_HINT": "synthetic"}), \
+         patch.object(prompt, "is_wsl", return_value=False), \
+         patch.object(folders, "environment_hint", return_value="Known Folders synthetic") as read:
+        text = prompt.build_environment_hints()
+    read.assert_called_once()
+    assert "Known Folders synthetic" in text and "Start-Process -Wait" in text
+    assert "HasExited" in text and "unsaved-work" in text
+    assert "not `cmd //c`" in text
+    for brand in ("Spotify", "QQ", "Photoshop"):
+        assert brand not in prompt._WINDOWS_BASH_SHELL_HINT
