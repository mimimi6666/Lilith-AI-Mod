diff --git a/tui_gateway/native_media_setup.py b/tui_gateway/native_media_setup.py
new file mode 100644
index 0000000..e62cd5e
--- /dev/null
+++ b/tui_gateway/native_media_setup.py
@@ -0,0 +1,110 @@
+"""Model metadata and transaction-owned mappings for native media tools.
+
+Uses the same auxiliary inventory and generation-plugin catalogs as Hermes'
+interactive pickers. No credentials, URLs, subprocesses or config writer.
+"""
+import re
+
+
+def _model_id(value):
+    return (isinstance(value, str) and bool(value) and value == value.strip()
+            and len(value.encode("utf-8")) <= 1024
+            and not any(ord(c) < 32 or ord(c) == 127 for c in value))
+
+
+def _auxiliary_config(config, task):
+    auxiliary = config.get("auxiliary", {})
+    if not isinstance(auxiliary, dict):
+        raise ValueError("native auxiliary configuration is not a mapping")
+    current = auxiliary.get(task, {})
+    if not isinstance(current, dict):
+        raise ValueError("native auxiliary task configuration is not a mapping")
+    return current
+
+
+def auxiliary_providers(toolset, config):
+    from hermes_cli.inventory import build_aux_picker_rows
+    from agent.models_dev import get_model_info
+
+    _auxiliary_config(config, toolset)
+    rows = [{"name": "auto", "auxiliary_task": toolset, "media_models": ["auto"]}]
+    modality = "video" if toolset == "video" else "image"
+    # Do not probe a custom URL through this UI. Use the existing configured
+    # inventory and cached modality metadata, never a model-name heuristic.
+    inventory = build_aux_picker_rows(max_models=256)
+    for row in inventory:
+        slug = row.get("slug")
+        if not isinstance(slug, str) or not re.fullmatch(r"[a-zA-Z0-9_.:-]{1,256}", slug) or slug == "auto":
+            continue
+        unavailable = set(row.get("unavailable_models") or [])
+        models = []
+        for model in row.get("models", []):
+            if not _model_id(model) or model in unavailable or model in models:
+                continue
+            info = get_model_info(slug, model, allow_network=False)
+            if info is not None and modality in {str(m).lower() for m in info.input_modalities}:
+                models.append(model)
+        if models:
