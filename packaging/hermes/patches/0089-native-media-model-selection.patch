+    return rows[:64]
+
+
+def model_metadata(toolset, provider, config):
+    task = provider.get("auxiliary_task")
+    if task:
+        current = _auxiliary_config(config, task)
+        return provider["media_models"], str(current.get("model") or "auto")
+    if toolset not in {"image_gen", "video_gen"}:
+        return None
+    from hermes_cli import tools_config as tc
+    plugin = provider.get(toolset + "_plugin_name")
+    if provider.get("managed_nous_feature") == toolset:
+        plugin = "fal"
+    if not plugin:
+        return None
+    catalog, default = (tc._plugin_image_gen_catalog(plugin) if toolset == "image_gen"
+                        else tc._plugin_video_gen_catalog(plugin))
+    models = [model for model in catalog if _model_id(model)]
+    current = config.get(toolset, {})
+    if not isinstance(current, dict) or len(models) > 256:
+        return [], ""
+    return models, str(current.get("model") or default or "")
+
+
+def auxiliary_selected(provider, config):
+    task = provider["auxiliary_task"]
+    current = _auxiliary_config(config, task)
+    return (not current.get("base_url") and not current.get("api_key")
+            and str(current.get("provider") or "auto") == provider["name"])
+
+
+def auxiliary_ready(toolset):
+    from tools.vision_tools import check_vision_requirements, check_video_requirements
+    return check_video_requirements() if toolset == "video" else check_vision_requirements()
+
+
+def validate_model(selection, provider, config):
+    model = selection.get("model")
+    if provider.get("auxiliary_task") and model is None:
+        raise ValueError("auxiliary setup requires an explicit model choice")
+    if model is None:
+        return
+    metadata = model_metadata(selection["toolset"], provider, config)
+    if not _model_id(model) or metadata is None or model not in metadata[0]:
+        raise ValueError("model is not in the current native media catalog")
+
+
+def apply_model(selection, provider, config):
+    model = selection.get("model")
+    if model is None:
+        return
+    task = provider.get("auxiliary_task")
+    if task:
+        section = config.setdefault("auxiliary", {}).setdefault(task, {})
+        # Same explicit-provider transition as the native vision picker. A
+        # previous endpoint override must never redirect the selected provider.
+        for key in ("base_url", "api_key", "key_env", "api_key_env", "api_mode"):
+            section.pop(key, None)
+        section.update(provider=provider["name"], model=model)
+    else:
+        config.setdefault(selection["toolset"], {})["model"] = model
