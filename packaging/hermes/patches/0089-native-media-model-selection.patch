+from copy import deepcopy
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from tui_gateway import native_media_setup as media
+from tui_gateway import native_setup as setup
+
+
+@pytest.fixture
+def inventory(monkeypatch):
+    monkeypatch.setattr("hermes_cli.inventory.build_aux_picker_rows", lambda **kw: [
+        {"slug": "google", "models": ["movie", "image", "text", "unknown", "paid"], "unavailable_models": ["paid"]},
+        {"slug": "bad\nprovider", "models": ["movie"]}])
+    monkeypatch.setattr("agent.models_dev.get_model_info", lambda provider, model, **kw:
+        None if model == "unknown" else SimpleNamespace(input_modalities={
+            "movie": ("text", "image", "video"), "image": ("text", "image"),
+            "text": ("text",), "paid": ("image", "video")}[model]))
+
+
+def test_media_catalog_excludes_unknown_text_only_and_unavailable_models(inventory):
+    video = media.auxiliary_providers("video", {})
+    image = media.auxiliary_providers("vision", {})
+    assert video == [{"name": "auto", "auxiliary_task": "video", "media_models": ["auto"]},
+                     {"name": "google", "auxiliary_task": "video", "media_models": ["movie"]}]
+    assert image[1]["media_models"] == ["movie", "image"]
+
+
+def test_auxiliary_selection_is_a_mapping_change_not_a_writer(inventory, monkeypatch):
+    from hermes_cli import tools_config as tc  # import aliases before patching their owner
+    config = {"auxiliary": {"vision": {"provider": "unchanged", "model": "image"},
+                            "video": {"base_url": "old", "api_key": "old", "timeout": 190}},
+              "approvals": {"mode": "smart"}, "platform_toolsets": {"cli": ["memory"]}}
+    before = deepcopy(config)
+    selection = {"toolset": "video", "provider": "google", "model": "movie"}
+    monkeypatch.setattr("hermes_cli.config.save_config", lambda *a, **k: pytest.fail("adapter must not save"))
+    monkeypatch.setattr(tc, "save_config", lambda *a, **k: pytest.fail("adapter must not save"))
+    setup.apply_selection(selection, config)
+    setup.verify_selection(selection, config)
+    assert config["auxiliary"]["video"] == {"provider": "google", "model": "movie", "timeout": 190}
+    assert config["auxiliary"]["vision"] == before["auxiliary"]["vision"]
+    assert config["approvals"] == before["approvals"]
+    assert config["platform_toolsets"] == before["platform_toolsets"]
+
+
+@pytest.mark.parametrize("change", [{"model": "text"}, {"model": "unknown"}, {"model": "paid"},
+    {"model": "../arbitrary"}, {"model": ""}, {"model": "movie\n"}, {"base_url": "https://invalid"}])
+def test_rejected_model_is_no_effect(inventory, change):
+    config = {"auxiliary": {"video": {"provider": "auto", "model": "auto"}}}
+    before = deepcopy(config)
+    with pytest.raises(ValueError):
+        setup.apply_selection({"toolset": "video", "provider": "google", "model": "movie", **change}, config)
+    assert config == before
+
+
+def test_generation_model_comes_from_native_plugin_catalog(monkeypatch):
+    monkeypatch.setattr("hermes_cli.tools_config._plugin_image_gen_catalog", lambda name: ({"native-model": {}}, "native-model"))
+    assert media.model_metadata("image_gen", {"image_gen_plugin_name": "fal"}, {}) == (["native-model"], "native-model")
+    with pytest.raises(ValueError):
+        media.validate_model({"toolset": "image_gen", "model": "chat-model"}, {"image_gen_plugin_name": "fal"}, {})
+
+
+def test_video_client_never_inherits_vision_config(monkeypatch):
+    from agent import auxiliary_client as aux
+    monkeypatch.setattr(aux, "_get_auxiliary_task_config", lambda task: {"provider": "explicit-video" if task == "video" else "wrong-vision", "model": task + "-model"})
+    monkeypatch.setattr(aux, "_normalize_main_runtime", lambda _: {})
+    monkeypatch.setattr(aux, "_refresh_stale_main_runtime_credentials", lambda runtime: runtime)
+    calls = []
+    # Stop at the routing boundary: no SDK, credential or provider request.
+    def resolve(task, *args):
+        calls.append(task)
+        raise RuntimeError("test route reached")
+    monkeypatch.setattr(aux, "_resolve_task_provider_model", resolve)
+    with pytest.raises(RuntimeError, match="test route reached"):
+        aux.resolve_vision_provider_client(task="video")
+    assert calls == ["video"]
+
+
+def test_video_execution_and_retries_keep_video_task():
+    import ast
+    from pathlib import Path
+    import agent.auxiliary_client as aux
+    import tools.vision_tools as vision
+    tree = ast.parse(Path(aux.__file__).read_text(encoding="utf-8"))
+    calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+             and n.func.id == "resolve_vision_provider_client"]
+    assert len(calls) == 6
+    assert all(any(k.arg == "task" and isinstance(k.value, ast.Name) and k.value.id == "task"
+                   for k in n.keywords) for n in calls)
+    video = next(n for n in ast.parse(Path(vision.__file__).read_text(encoding="utf-8")).body
+                 if isinstance(n, ast.AsyncFunctionDef) and n.name == "video_analyze_tool")
+    assert any(isinstance(n, ast.Dict) and any(isinstance(k, ast.Constant) and k.value == "task"
+               and isinstance(v, ast.Constant) and v.value == "video" for k, v in zip(n.keys, n.values)) for n in ast.walk(video))
