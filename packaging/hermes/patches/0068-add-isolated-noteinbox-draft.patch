+class FakeAgent:
+    def __init__(self, provider="deepseek"):
+        self.provider = self.requested_provider = provider
+        self.model = "deepseek-v4-pro" if provider == "deepseek" else "gemini-3-flash"
+        self.base_url = get_provider_profile(provider).base_url
+        self.api_mode = get_provider_profile(provider).api_mode
+        self.api_key = "fixture-only-key"
+        self.auth_mode = "api_key"
+        self._client_kwargs = {"api_key": self.api_key, "base_url": self.base_url}
+        self.request_overrides = {}
+        self.reasoning_config = {"enabled": True, "effort": "high"}
+        self.max_tokens = 9000
+        self._ephemeral_max_output_tokens = 8000
+        self._cached_system_prompt = "SOUL\n\nPERSONA\n\nMEMORY_MUST_NOT_ENTER_DRAFT"
+        self._identity_soul_content = "SOUL"
+        self._identity_personality_prompt = "PERSONA"
+        self._identity_policy = SimpleNamespace(enabled=True)
+        self.calls = []
+        self.clients = []
+        self.aborted = []
+        self.closed = []
+        self.payload = {"status": "ready", "text": "別忘了好好吃飯。"}
+        self.on_create = lambda: None
+        self.on_request = lambda: None
+        self.run_conversation = MagicMock(side_effect=AssertionError("no chat"))
+
+    def _is_openrouter_url(self):
+        return self.provider == "openrouter"
+
+    def _build_api_kwargs(self, messages, tools_for_api):
+        assert tools_for_api == []
+        return ChatCompletionsTransport().build_kwargs(
+            model=self.model, messages=messages, tools=tools_for_api,
+            base_url=self.base_url, provider_profile=get_provider_profile(self.provider),
+            reasoning_config=self.reasoning_config,
+            max_tokens=self.max_tokens, request_overrides=self.request_overrides)
+
+    def _create_request_openai_client(self, **kwargs):
+        self.on_create()
+
+        def create(**wire):
+            self.calls.append(copy.deepcopy(wire))
+            self.on_request()
+            return response(self.payload)
+
+        client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+        self.clients.append(client)
+        return client
+
+    def _close_request_openai_client(self, client, **kwargs):
+        self.closed.append(client)
+
+    def _abort_request_openai_client(self, client, **kwargs):
+        self.aborted.append(client)
+
