+@pytest.mark.parametrize("where", ["before_client", "during_request"])
+@pytest.mark.parametrize("change", ["credential", "provider", "model", "identity", "lineage", "cancel", "running", "history_version", "quarantine"])
+def test_authority_changes_discard_without_fallback(monkeypatch, where, change):
+    agent, session, params = setup(monkeypatch)
+
+    def mutate():
+        if change == "credential":
+            agent.api_key = "changed-key"
+        elif change in {"provider", "model"}:
+            setattr(agent, change, "changed")
+        elif change == "identity":
+            agent._identity_soul_content = "changed"
+        elif change == "lineage":
+            session["session_key"] = "changed-tip"
+        elif change == "cancel":
+            session["_turn_cancel_requested"] = True
+        elif change == "running":
+            session["running"] = True
+        elif change == "history_version":
+            session["history_version"] += 1
+        elif change == "quarantine":
+            monkeypatch.setattr(server, "_native_authority_quarantine_rpc_error", lambda rid: {"error": {}})
+
+    if where == "before_client":
+        agent.on_create = mutate
+    else:
+        agent.on_request = mutate
+    result = invoke(params)
+    assert result["status"] == "failed" and result["text"] == ""
+    assert len(agent.calls) == (0 if where == "before_client" else 1)
+    assert agent.closed == agent.clients
