+@pytest.mark.parametrize("provider", ["gemini", "deepseek"])
+@pytest.mark.parametrize("locale", ["zh-TW", "zh-CN", "ja", "en"])
+def test_one_native_completion_no_history_memory_tools_and_no_primary_mutation(monkeypatch, provider, locale):
+    agent, session, params = setup(monkeypatch, provider)
+    params["display_locale"] = locale
+    before = copy.deepcopy(session["history"])
+    reasoning = copy.deepcopy(agent.reasoning_config)
+    result = invoke(params)
+    assert result == {"operation_id": params["operation_id"], "event_id": params["event_id"], **agent.payload}
+    assert len(agent.calls) == 1
+    wire = agent.calls[0]
+    assert wire["model"] == agent.model
+    assert wire["stream"] is False and 0 < wire["timeout"] <= 25
+    assert "tools" not in wire and "tool_choice" not in wire and "response_format" not in wire
+    serialized = json.dumps(wire, ensure_ascii=False)
+    assert locale in serialized and params["topic"] in serialized
+    assert "HISTORY_MUST_NOT_ENTER_DRAFT" not in serialized
+    assert "MEMORY_MUST_NOT_ENTER_DRAFT" not in serialized
+    assert params["operation_id"] not in serialized
+    assert wire["messages"][0]["content"].startswith("SOUL\n\nPERSONA\n\n")
+    assert agent.closed == agent.clients and not agent.aborted
+    assert session["history"] == before and session["history_version"] == 2
+    assert session["running"] is False and session["inflight_turn"] is None
+    assert agent.reasoning_config == reasoning and agent._ephemeral_max_output_tokens == 8000
+    assert agent.max_tokens == 9000 and not agent.run_conversation.called
