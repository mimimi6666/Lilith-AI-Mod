+def test_timeout_aborts_only_owned_client_and_quarantines_late_worker(monkeypatch):
+    agent, _, params = setup(monkeypatch)
+    started, release = threading.Event(), threading.Event()
+    monkeypatch.setattr(note_draft, "_DEADLINE_SECONDS", 0.15)
+
+    def blocked():
+        started.set()
+        assert release.wait(4)
+
+    agent.on_request = blocked
+    try:
+        before = time.monotonic()
+        assert invoke(params)["status"] == "failed"
+        assert time.monotonic() - before < 2
+        abort_deadline = time.monotonic() + 2
+        while not agent.aborted and time.monotonic() < abort_deadline:
+            threading.Event().wait(0.01)
+        assert started.is_set() and agent.aborted == agent.clients
+        other = {**params, "operation_id": uuid.uuid4().hex, "event_id": uuid.uuid4().hex}
+        assert invoke(other)["status"] == "busy"
+        assert invoke(params)["status"] == "failed"
+        assert len(agent.calls) == 1
+    finally:
+        release.set()
+        deadline = time.monotonic() + 3
+        while note_draft._active and time.monotonic() < deadline:
+            threading.Event().wait(0.01)
+    assert not note_draft._active and agent.closed == agent.clients
+
