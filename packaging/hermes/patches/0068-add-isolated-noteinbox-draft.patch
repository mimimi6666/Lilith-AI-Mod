+@pytest.mark.parametrize("provider", ["gemini", "deepseek"])
+@pytest.mark.parametrize("status_code", [200, 429, 500])
+def test_native_client_wire_with_fake_http_has_one_physical_attempt(monkeypatch, provider, status_code):
+    import httpx
+    from agent.gemini_native_adapter import GeminiNativeClient
+    from openai import OpenAI
+
+    agent, _, params = setup(monkeypatch, provider)
+    physical = []
+
+    def wire(request):
+        physical.append(request)
+        if status_code != 200:
+            return httpx.Response(status_code, json={"error": {"message": "fake unavailable"}})
+        content = json.dumps(agent.payload, ensure_ascii=False)
+        if provider == "gemini":
+            payload = {"candidates": [{"content": {"role": "model", "parts": [{"text": content}]},
+                                      "finishReason": "STOP"}]}
+        else:
+            payload = {"id": "fake", "object": "chat.completion", "created": 1,
+                       "model": agent.model, "choices": [{"index": 0, "finish_reason": "stop",
+                       "message": {"role": "assistant", "content": content}}]}
+        return httpx.Response(200, json=payload)
+
+    http = httpx.Client(transport=httpx.MockTransport(wire))
+    if provider == "gemini":
+        client = GeminiNativeClient(api_key=agent.api_key, base_url=agent.base_url, http_client=http)
+    else:
+        client = OpenAI(api_key=agent.api_key, base_url=agent.base_url, http_client=http, max_retries=0)
+    monkeypatch.setattr(agent, "_create_request_openai_client", lambda **kwargs: client)
+    try:
+        result = invoke(params)
+        assert result["status"] == ("ready" if status_code == 200 else "failed")
+        assert len(physical) == 1
+        body = json.loads(physical[0].content)
+        assert not body.get("tools")
+        assert "HISTORY_MUST_NOT_ENTER_DRAFT" not in physical[0].content.decode()
+        assert "MEMORY_MUST_NOT_ENTER_DRAFT" not in physical[0].content.decode()
+        if provider == "gemini":
+            assert physical[0].url.path.endswith(":generateContent")
+            assert body["systemInstruction"]["parts"][0]["text"].startswith("SOUL\n\nPERSONA\n\n")
+        else:
+            assert physical[0].url.path.endswith("/chat/completions")
+            assert body["messages"][0]["content"].startswith("SOUL\n\nPERSONA\n\n")
+    finally:
+        client.close()
+
