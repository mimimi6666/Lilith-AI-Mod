+def scope(seconds=30):
+    return {"profile_id": "local", **{key: uuid.uuid4().hex for key in daily.GUID_FIELDS},
+            "expires_at_utc": timestamp(datetime.now(timezone.utc) + timedelta(seconds=seconds))}
+
+
+ARGS = {"action": "deliver", "locale": "zh-TW", "text": "今天也記得好好休息。 —莉莉絲"}
+SCHEMA = {"type": "function", "function": {"name": "lilith_leave_note",
+    "description": "Save a native game image note.", "parameters": {"type": "object",
+    "properties": {"action": {"type": "string"}, "locale": {"type": "string"}, "text": {"type": "string"}},
+    "required": ["action", "locale"], "additionalProperties": False}}}
+
+
+def receipt(value, status="delivered"):
+    return {"version": 1, "kind": bridge.RESULT_KIND, "operation_id": value["operation_id"],
+        "delivery_id": value["delivery_id"], "status": status, "code": "ok" if status == "delivered" else "fixture.deferred",
+        "artifact": {"artifact_id": value["delivery_id"], "sha256": "A" * 64, "byte_length": 55,
+                     "completed_at_utc": timestamp(datetime.now(timezone.utc))} if status == "delivered" else None}
