+def resolve_isolated_static_runtime(*, config_snapshot: Dict[str, Any],
+    requested: str, target_model: str) -> Dict[str, Any]:
+    """Native, read-only subset for one isolated request; never select a pool.
+
+    Unsupported authority cannot be reinterpreted as an environment fallback.
+    Normal provider resolution is unchanged. This first subset deliberately
+    supports only built-in DeepSeek/Gemini static-key chat-completions routes.
+    """
+    from hermes_cli.config import is_provider_enabled
+    if not isinstance(config_snapshot, dict) or requested not in {"deepseek", "gemini"}:
+        raise ValueError("unsupported isolated native provider")
+    model_cfg = config_snapshot.get("model")
+    if (not isinstance(model_cfg, dict) or model_cfg.get("provider") != requested
+            or model_cfg.get("default") != target_model or not isinstance(target_model, str)
+            or not target_model.strip()):
+        raise ValueError("isolated native provider requires the complete current pair")
+    block = (config_snapshot.get("providers") or {}).get(requested)
+    if block is not None and (not isinstance(block, dict) or not is_provider_enabled(block)
+            or set(block) - {"enabled"}):
+        raise ValueError("isolated native provider override is unsupported")
+    if config_snapshot.get("custom_providers") or any(model_cfg.get(key) for key in
+            ("api_key", "key_env", "api_key_env", "credential_pool", "fallback")):
+        raise ValueError("isolated native custom credentials are unsupported")
+    # The normal route selects persisted pool credentials before API-key
+    # fallback. Reject that authority, do not silently choose another key.
+    if auth_mod.read_credential_pool(requested):
+        raise ValueError("isolated native credential pool is unsupported")
+    pconfig = PROVIDER_REGISTRY[requested]
+    key, source = auth_mod._resolve_api_key_provider_secret(requested, pconfig, allow_pool=False)
+    if not has_usable_secret(key):
+        raise ValueError("isolated native static credential is unavailable")
+    runtime = _resolve_explicit_runtime(provider=requested, requested_provider=requested,
+        model_cfg=model_cfg, explicit_api_key=key,
+        explicit_base_url=str(model_cfg.get("base_url") or ""), target_model=target_model)
+    if (runtime is None or runtime.get("api_mode") != "chat_completions"
+            or runtime.get("base_url") != pconfig.inference_base_url.rstrip("/")):
+        raise ValueError("isolated native API mode is unsupported")
+    runtime["source"] = source
+    return runtime
+
+
 def resolve_runtime_provider(
     *,
     requested: Optional[str] = None,
