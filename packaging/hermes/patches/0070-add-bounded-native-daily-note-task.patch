+class FakeAgent:
+    def __init__(self, provider="deepseek"):
+        self.provider = self.requested_provider = provider
+        self.model = "deepseek-v4-pro" if provider == "deepseek" else "gemini-3-flash"
+        self.base_url = get_provider_profile(provider).base_url
+        self.api_mode = "chat_completions"
+        self.api_key = "fixture-key-only"
+        self.auth_mode = "api_key"
+        self._client_kwargs = {"api_key": self.api_key, "base_url": self.base_url}
+        self.request_overrides = {}
+        self.reasoning_config = {"enabled": False}
+        self.max_tokens = 2048
+        self._ephemeral_max_output_tokens = None
+        self.enabled_toolsets = ["lilith_leave_note"]
+        self.disabled_toolsets = []
+        self._identity_soul_content = "SOUL"
+        self._identity_personality_prompt = "PERSONA"
+        self._identity_policy = SimpleNamespace(enabled=True)
+        self.calls, self.clients, self.closed_clients, self.aborted = [], [], [], []
+        self.closed = False
+        self.tool_calls = [SimpleNamespace(id="native-call", function=SimpleNamespace(
+            name="lilith_leave_note", arguments=json.dumps(ARGS, ensure_ascii=False)))]
+        self.on_request = lambda: None
+        self.on_client = lambda: None
+        self.run_conversation = MagicMock(side_effect=AssertionError("must not run chat"))
+
+    def _is_openrouter_url(self):
+        return False
+
+    def _build_api_kwargs(self, messages, tools_for_api):
+        return ChatCompletionsTransport().build_kwargs(model=self.model, messages=messages, tools=tools_for_api,
+            base_url=self.base_url, provider_profile=get_provider_profile(self.provider),
+            reasoning_config=self.reasoning_config, max_tokens=self.max_tokens, request_overrides=self.request_overrides)
+
+    def _create_request_openai_client(self, **kwargs):
+        assert self._client_kwargs["max_retries"] == 0
+        self.on_client()
+        def create(**wire):
+            self.calls.append(copy.deepcopy(wire))
+            self.on_request()
+            return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(
+                content="Model prose is never delivery evidence", tool_calls=self.tool_calls))], usage=None)
+        client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+        self.clients.append(client)
+        return client
+
+    def _close_request_openai_client(self, client, **kwargs):
+        self.closed_clients.append(client)
+
+    def _abort_request_openai_client(self, client, **kwargs):
+        self.aborted.append(client)
+
+    def close(self):
+        self.closed = True
+
