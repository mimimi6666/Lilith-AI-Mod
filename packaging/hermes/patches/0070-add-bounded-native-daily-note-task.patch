+class Transport:
+    lilith_runtime_attested = True
+    _closed = False
+    def __init__(self):
+        self.frames = []
+        self.on_frame = lambda frame: None
+    def write(self, frame):
+        self.frames.append(copy.deepcopy(frame))
+        self.on_frame(frame)
+        return True
