@@ -0,0 +1,181 @@
+"""Cold native construction retains identity without background side effects."""
+import hashlib
+import os
+import threading
+import time
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+import yaml
+
+from run_agent import AIAgent
+
+
+@pytest.fixture
+def cold(monkeypatch, tmp_path):
+    soul, persona = "PINNED SOUL\n", "LOCKED CUSTOM VOICE\n"
+    config = {"identity": {"require_soul": True, "suppress_kernel_help": True,
+        "personality_allowlist": ["lilith"], "locked_personality": "lilith",
+        "force_soul_for_children": True, "fingerprint": "A" * 64},
+        "display": {"personality": "lilith"}, "agent": {"system_prompt": "",
+            "personalities": {"lilith": {"system_prompt": persona}}},
+        "model": {"provider": "openrouter", "default": "fixture-model"},
+        "context": {"engine": "must-not-start"},
+        "memory": {"memory_enabled": True, "user_profile_enabled": True, "provider": "must-not-start"},
+        "sessions": {"write_json_snapshots": True}}
+    (tmp_path / "config.yaml").write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8", newline="\n")
+    (tmp_path / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    for key, value in {"HERMES_HOME": str(tmp_path), "HERMES_IDENTITY_REQUIRED": "1",
+        "HERMES_IDENTITY_EXPECTED_FINGERPRINT": "A" * 64,
+        "HERMES_IDENTITY_EXPECTED_CONFIG_SHA256": hashlib.sha256((tmp_path / "config.yaml").read_bytes()).hexdigest(),
+        "HERMES_IDENTITY_EXPECTED_SOUL_SHA256": hashlib.sha256(soul.encode()).hexdigest(),
+        "HERMES_IDENTITY_EXPECTED_PERSONALITY_SHA256": hashlib.sha256(persona.encode()).hexdigest()}.items():
+        monkeypatch.setenv(key, value)
+    monkeypatch.setattr("run_agent.OpenAI", MagicMock())
+    definitions = MagicMock(return_value=[])
+    monkeypatch.setattr("run_agent.get_tool_definitions", definitions)
+    monkeypatch.setattr("run_agent.check_toolset_requirements", lambda *a, **k: {})
+    monkeypatch.setattr("run_agent._openrouter_prewarm_done", threading.Event())
+    effects = {}
+    for name in ("agent.agent_init.fetch_model_metadata", "hermes_cli.plugins.discover_plugins",
+                 "agent.agent_init.ContextCompressor", "tools.memory_tool.MemoryStore",
+                 "socket.create_connection"):
+        fake = MagicMock(side_effect=AssertionError("unexpected cold-init side effect " + name))
+        monkeypatch.setattr(name, fake)
+        effects[name] = fake
+    kwargs = dict(api_key="fixture-only-key", base_url="https://openrouter.ai/api/v1", provider="openrouter",
+        api_mode="chat_completions", model="fixture-model", session_id="a" * 32,
+        enabled_toolsets=["lilith_leave_note"], disabled_toolsets=[], max_iterations=1, quiet_mode=True,
+        skip_memory=True, skip_context_files=True, skip_background_review=True, isolated_request=True)
+    return kwargs, effects, definitions, tmp_path, soul, persona
+
+
+def test_cold_constructor_preserves_native_identity_and_has_no_adjacent_effects(cold, monkeypatch):
+    kwargs, effects, definitions, root, soul, persona = cold
+    before = {str(path.relative_to(root)): path.read_bytes() if path.is_file() else None for path in root.rglob("*")}
+    old_session = os.environ.get("HERMES_SESSION_ID")
+    directory_calls = []
+    mkdir = Path.mkdir
+    def trace_mkdir(path, *args, **kwargs):
+        if path == root / "sessions":
+            import traceback
+            directory_calls.append("".join(traceback.format_stack(limit=8)))
+        return mkdir(path, *args, **kwargs)
+    monkeypatch.setattr(Path, "mkdir", trace_mkdir)
+    agent = AIAgent(**kwargs)
+    try:
+        assert agent._identity_soul_content == soul and agent._identity_personality_prompt == persona
+        assert agent.provider == "openrouter" and agent.api_mode == "chat_completions"
+        assert agent._persist_disabled and not agent._session_json_enabled
+        assert agent.context_compressor is None and agent._session_db is None
+        assert agent._memory_store is None and agent._memory_manager is None
+        wire = agent._build_api_kwargs([{"role": "system", "content": soul + "\n" + persona},
+            {"role": "user", "content": "An isolated opportunity."}], tools_for_api=[])
+        assert wire["model"] == "fixture-model"
+        assert definitions.call_args.kwargs["enabled_toolsets"] == ["lilith_leave_note"]
+        assert all(not effect.called for effect in effects.values())
+        assert os.environ.get("HERMES_SESSION_ID") == old_session
+        assert not (root / "sessions").exists(), "\n".join(directory_calls)
+        assert {str(path.relative_to(root)): path.read_bytes() if path.is_file() else None for path in root.rglob("*")} == before
+        with pytest.raises(RuntimeError, match="cannot start a conversation"):
+            agent.run_conversation("not permitted")
+        assert agent._get_session_db_for_recall() is None
+    finally:
+        agent.close()
+    assert {str(path.relative_to(root)): path.read_bytes() if path.is_file() else None for path in root.rglob("*")} == before, "\n".join(directory_calls)
+
+
+def test_daily_factory_only_installs_note_tool_despite_other_enabled_native_tools(cold, monkeypatch):
+    from tui_gateway import daily_note as daily, server
+    kwargs, effects, definitions, root, _, _ = cold
+    monkeypatch.setattr(daily, "_config_proof", lambda: ("fixture", "A" * 64))
+    monkeypatch.setattr(server, "_load_cfg", lambda: {"model": {"provider": "openrouter", "default": "fixture-model"}})
+    monkeypatch.setattr(server, "_load_reasoning_config", lambda model: None)
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_isolated_static_runtime", lambda **kw: {
+        "provider": "openrouter", "api_mode": "chat_completions", "api_key": "fixture-only-key",
+        "base_url": "https://openrouter.ai/api/v1"})
+    monkeypatch.setattr("hermes_cli.tools_config._get_platform_tools", lambda *a, **kw:
