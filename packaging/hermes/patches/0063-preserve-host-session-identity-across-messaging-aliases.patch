diff --git a/tests/test_lilith_shared_session_identity.py b/tests/test_lilith_shared_session_identity.py
new file mode 100644
index 0000000..02f658c
--- /dev/null
+++ b/tests/test_lilith_shared_session_identity.py
@@ -0,0 +1,80 @@
+"""Regression proofs for one game transcript shared through messaging aliases."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent.conversation_compression import _compression_child_source
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def db(tmp_path):
+    handle = SessionDB(tmp_path / "state.db")
+    try:
+        yield handle
+    finally:
+        handle.close()
+
+
+@pytest.mark.parametrize("include_compression_ancestors", [False, True])
+def test_gateway_peer_refresh_preserves_archived_game_identity(
+    db, include_compression_ancestors
+):
+    db.create_session("game", source="lilith-game", archived=True)
+
+    db.record_gateway_session_peer(
+        "game",
+        source="telegram",
+        user_id="owner",
+        session_key="agent:main:telegram:dm:owner",
+        chat_id="owner",
+        chat_type="dm",
+        display_name="Owner",
+        origin_json='{"platform":"telegram"}',
+        include_compression_ancestors=include_compression_ancestors,
+    )
+
+    row = db.get_session("game")
+    assert row["source"] == "lilith-game"
+    assert row["archived"] == 1
+    assert row["session_key"] is None
+    assert row["user_id"] is None
+    assert row["chat_id"] is None
+    assert row["origin_json"] is None
+
+
+def test_gateway_peer_refresh_still_updates_an_ordinary_gateway_session(db):
+    db.create_session("ordinary", source="telegram")
+
+    db.record_gateway_session_peer(
+        "ordinary",
+        source="telegram",
+        user_id="owner",
+        session_key="agent:main:telegram:dm:owner",
+        chat_id="owner",
+        chat_type="dm",
+    )
+
+    row = db.get_session("ordinary")
+    assert row["session_key"] == "agent:main:telegram:dm:owner"
+    assert row["user_id"] == "owner"
+    assert row["chat_id"] == "owner"
+
+
+def test_compression_child_inherits_canonical_parent_source():
+    session_db = SimpleNamespace(
+        get_session=lambda session_id: {
+            "id": session_id,
+            "source": "lilith-game",
+        }
+    )
+    agent = SimpleNamespace(platform="telegram", _session_db=session_db)
+
+    assert _compression_child_source(agent, "game") == "lilith-game"
+
+
+def test_compression_child_falls_back_to_transport_when_parent_is_unavailable():
+    agent = SimpleNamespace(platform="telegram", _session_db=None)
+
+    assert _compression_child_source(agent, "missing") == "telegram"
