+def _compression_child_source(agent: Any, parent_session_id: str) -> str:
+    """Inherit the durable parent's source across a compression rotation.
+
+    A gateway transport can be only an alias for a host-owned transcript.  In
+    that case ``agent.platform`` names the current delivery transport (for
+    example Telegram), while the state row remains the authoritative
+    ``lilith-game`` identity required by the game bridge.  Compression must
+    continue that durable identity instead of converting the child to the
+    transient transport.
+    """
+    fallback = (
+        getattr(agent, "platform", None)
+        or os.environ.get("HERMES_SESSION_SOURCE", "cli")
+    )
+    session_db = getattr(agent, "_session_db", None)
+    getter = getattr(session_db, "get_session", None)
+    if callable(getter) and parent_session_id:
+        try:
+            parent = getter(parent_session_id)
+            source = parent.get("source") if isinstance(parent, dict) else None
+            if isinstance(source, str) and source.strip():
+                return source.strip()
+        except Exception:
+            # Compression was already able to proceed without this advisory
+            # read. Preserve that historical fallback on a transient DB read
+            # failure rather than turning it into a new failure mode.
+            pass
+    return str(fallback)
+
+
 def _adopt_live_compression_child(
     agent: Any,
     session_db: Any,
