@@ -0,0 +1,191 @@
+"""Synthetic data only; full-host harness separately verifies real identity."""
+from copy import deepcopy
+from dataclasses import FrozenInstanceError, replace
+import json
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.background_context import freeze_history_projection, attach_history_projection
+from agent.background_review_policy import BackgroundReviewGuardrails, review_capability_guidance
+from agent.tool_guardrails import ToolCallGuardrailController, ToolCallGuardrailConfig
+
+
+def agent():
+    return SimpleNamespace(session_id="synthetic", _session_init_model_config={},
+        _identity_policy=SimpleNamespace(enabled=True, fingerprint="a"*64),
+        _identity_legacy_history_v1={"cutoff":12,"migrated_to":"a"*64},
+        _memory_enabled=True, _user_profile_enabled=True,
+        _authoritative_user_profile_writes=True, _memory_manager=None,
+        _memory_store=SimpleNamespace(_char_count=lambda target:2186,
+                                      _char_limit=lambda target:2200))
+
+
+class HistoryHandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.policy = patch("agent.identity_policy.policy_for_agent", lambda a:a._identity_policy)
+        self.policy.start()
+        self.addCleanup(self.policy.stop)
+        self.parent = agent()
+        self.rows = [{"role":"user", "content":"synthetic", "api_content":"synthetic sidecar"},
+                     {"role":"assistant", "content":"answer", "reasoning_content":"old reasoning"}]
+        self.original = deepcopy(self.rows)
+        self.snapshot = freeze_history_projection(self.parent, self.rows)
+        self.child = agent()
+        del self.child._identity_legacy_history_v1
+
+    def test_frozen_metadata_independent_of_parent_and_child(self):
+        self.parent._identity_legacy_history_v1["cutoff"] = 99
+        self.assertTrue(attach_history_projection(self.child, self.snapshot, self.rows))
+        self.assertEqual(self.child._identity_legacy_history_v1["cutoff"], 12)
+        self.child._identity_legacy_history_v1["cutoff"] = 8
+        self.assertEqual(self.snapshot.migration[0], 12)
+        self.assertEqual(self.child._session_init_model_config["_identity_legacy_history_v1"]["cutoff"], 12)
+        self.assertEqual(self.rows, self.original)
+        with self.assertRaises(FrozenInstanceError):
+            self.snapshot.session_id = "other"
+
+    def test_no_migration_preserves_native_shape(self):
+        del self.parent._identity_legacy_history_v1
+        snapshot = freeze_history_projection(self.parent, self.rows)
+        self.assertTrue(attach_history_projection(self.child, snapshot, self.rows))
+        self.assertFalse(hasattr(self.child, "_identity_legacy_history_v1"))
+
+    def test_generic_identity_preserved(self):
+        for owner in (self.parent, self.child):
+            owner._identity_policy = SimpleNamespace(enabled=False, fingerprint="")
+        snapshot = freeze_history_projection(self.parent, self.rows)
+        self.assertTrue(attach_history_projection(self.child, snapshot, self.rows))
+        self.assertIsNone(snapshot.migration)
+
+    def test_malformed_boundary_rejected(self):
+        for boundary in ({"cutoff":True,"migrated_to":"a"*64}, {"cutoff":0,"migrated_to":"a"*64},
+                         {"cutoff":12,"migrated_to":"b"*64}, "not metadata"):
+            with self.subTest(boundary=boundary):
+                self.parent._identity_legacy_history_v1 = boundary
+                self.assertIsNone(freeze_history_projection(self.parent, self.rows))
+
+    def test_forged_snapshot_shape_rejected(self):
+        for snapshot in (None, {}, replace(self.snapshot, migration=(True,"a"*64)),
+                         replace(self.snapshot, migration=(0,"a"*64)),
+                         replace(self.snapshot, migration=(12,"b"*64))):
+            self.assertFalse(attach_history_projection(self.child, snapshot, self.rows))
+        self.assertFalse(hasattr(self.child, "_identity_legacy_history_v1"))
+
+    def test_scope_mismatch_never_mutates_child(self):
+        for snapshot in (replace(self.snapshot, session_id="other"),
+                         replace(self.snapshot, fingerprint="b"*64),
+                         replace(self.snapshot, identity_enabled=False)):
+            self.assertFalse(attach_history_projection(self.child, snapshot, self.rows))
+        self.assertEqual(self.child._session_init_model_config, {})
+
+    def test_every_history_field_and_order_are_bound(self):
+        for field in ("content", "api_content", "reasoning_content", "tool_calls"):
+            changed = deepcopy(self.rows)
+            changed[0][field] = "changed"
+            self.assertFalse(attach_history_projection(self.child, self.snapshot, changed))
+        self.assertFalse(attach_history_projection(self.child, self.snapshot, self.rows[::-1]))
+        self.assertFalse(attach_history_projection(self.child, self.snapshot, self.rows[1:]))
+
+    def test_existing_conflicting_boundary_rejected(self):
+        self.child._identity_legacy_history_v1 = {"cutoff":24,"migrated_to":"a"*64}
+        self.assertFalse(attach_history_projection(self.child, self.snapshot, self.rows))
+        self.assertEqual(self.child._identity_legacy_history_v1["cutoff"],24)
+
+    def test_unknown_nonserializable_history_rejected(self):
+        self.assertIsNone(freeze_history_projection(self.parent, [{"content":object()}]))
+        self.assertFalse(attach_history_projection(self.child, self.snapshot, [{"content":float("nan")}]))
+
+
+class ReviewPolicyTests(unittest.TestCase):
+    def setUp(self):
+        self.agent = agent()
+        self.guard = BackgroundReviewGuardrails(self.agent)
+
+    def result(self, data, tool="memory", args=None, failed=None):
+        return self.guard.after_call(tool, args or {"target":"memory"}, json.dumps(data), failed=failed)
+
+    def test_capabilities_explain_unavailable_profile_and_capacity(self):
+        text = review_capability_guidance(self.agent)
+        self.assertIn("target=user: unavailable", text)
+        self.assertIn("2186/2200", text)
+        self.assertIn("14 remaining", text)
+        self.assertIn("Do not copy user-profile facts", text)
+        self.assertEqual(self.agent._memory_store._char_count("memory"),2186)
+
+    def test_unknown_capacity_does_not_invent_zero(self):
+        self.agent._memory_store = SimpleNamespace()
+        self.assertNotIn("characters;", review_capability_guidance(self.agent))
+
+    def test_unavailable_user_target_blocked_before_writer(self):
+        self.assertFalse(self.guard.before_call("memory", {"target":"user"}).allows_execution)
+        self.assertIsNone(self.agent._memory_manager)
+
+    def test_builtin_user_allowed_when_no_external_owner(self):
+        self.agent._authoritative_user_profile_writes = False
+        self.assertTrue(self.guard.before_call("memory", {"target":"user"}).allows_execution)
+
+    def test_disabled_targets_blocked(self):
+        self.agent._memory_enabled = False
+        self.assertFalse(self.guard.before_call("memory", {}).allows_execution)
+
+    def test_missing_store_is_unavailable(self):
+        self.agent._memory_store = None
+        self.assertFalse(self.guard.before_call("memory", {}).allows_execution)
+
+    def test_terminal_provider_failure_stops_immediately(self):
+        result = self.result({"success":False,"done":True,"committed":False,
+                             "code":"memory.authoritative_provider_unavailable"})
+        self.assertTrue(result.should_halt)
+        self.assertFalse(self.guard.before_call("skill_manage", {}).allows_execution)
+
+    def test_one_capacity_correction_not_repeated_guessing(self):
+        error = {"success":False,"error":"After applying operations, memory would be over the limit.",
+                 "usage":"2,186/2,200","current_entries":["synthetic"]}
+        first = self.result(error)
+        self.assertEqual(first.action,"warn")
+        self.assertNotIn("keep using tools",first.message)
+        self.assertTrue(self.guard.before_call("memory", {"action":"batch"}).allows_execution)
+        self.assertTrue(self.result(error, args={"action":"batch"}).should_halt)
+
+    def test_corrected_success_can_continue(self):
+        self.result({"success":False,"error":"over capacity"})
+        decision = self.result({"success":True,"committed":True,"message":"Entry replaced"})
+        self.assertFalse(decision.should_halt)
+        self.assertTrue(self.guard.before_call("skill_manage", {"action":"create"}).allows_execution)
+
+    def test_protected_skill_denial_stops(self):
+        for kind in ("bundled", "pinned", "hub-installed", "protected"):
+            self.guard.reset_for_turn()
+            result = self.result({"success":False,"error":f"Refusing background curator patch for {kind} skill 'synthetic'."},tool="skill_manage")
+            self.assertTrue(result.should_halt)
+
+    def test_staged_is_not_committed_and_not_retried(self):
+        for receipt in ({"success":True,"staged":True,"committed":False},
+                        {"success":True,"committed":False}):
+            self.guard.reset_for_turn()
+            self.assertEqual(self.result(receipt).code,"background_write_pending")
+
+    def test_malformed_result_only_native_reported_failure_counts(self):
+        self.assertFalse(self.guard.after_call("memory", {}, "invalid", failed=False).should_halt)
+        self.assertEqual(self.guard.after_call("memory", {}, "invalid", failed=True).action,"warn")
+        self.assertTrue(self.guard.after_call("memory", {}, "invalid", failed=True).should_halt)
+
+    def test_native_stricter_guard_stays_effective(self):
+        config = ToolCallGuardrailConfig(hard_stop_enabled=True,same_tool_failure_halt_after=1)
+        self.guard = BackgroundReviewGuardrails(self.agent,config)
+        self.assertTrue(self.result({"success":False,"error":"synthetic"}).should_halt)
+
+    def test_foreground_defaults_and_other_tools_unchanged(self):
+        native = ToolCallGuardrailController()
+        for i in range(4):
+            decision = native.after_call("memory", {"content":str(i)}, '{"success":false,"error":"synthetic"}', failed=True)
+            self.assertFalse(decision.should_halt)
+        self.assertIn("keep using tools",decision.message)
+        self.assertEqual(self.guard.before_call("read_file", {}).action,native.before_call("read_file", {}).action)
+
+    def test_reset_starts_new_child_turn_only(self):
+        self.result({"success":False,"done":True})
+        self.guard.reset_for_turn()
+        self.assertTrue(self.guard.before_call("memory", {}).allows_execution)
+
