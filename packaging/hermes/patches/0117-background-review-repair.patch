 """Data-only summary handoff; no parent agent, compressor or write authority."""
 from dataclasses import dataclass
+import hashlib
+import json
 from agent.history_context import summary_scope
 
 
+@dataclass(frozen=True)
+class HistoryProjectionSnapshot:
+    """Data only: ordinal metadata belongs to one exact captured history."""
+    session_id: str
+    identity_enabled: bool
+    fingerprint: str
+    source_key: str
+    migration: tuple[int, str] | None
+
+
+def _source_key(rows):
+    return hashlib.sha256(json.dumps(rows, sort_keys=True, ensure_ascii=True,
+        separators=(",", ":"), allow_nan=False).encode()).hexdigest()
+
+
+def freeze_history_projection(agent, rows):
+    """Freeze before the next foreground turn; never read storage or an LLM."""
+    from agent.identity_policy import policy_for_agent
+    policy = policy_for_agent(agent)
+    migration = None
+    value = getattr(agent, "_identity_legacy_history_v1", None)
+    if policy.enabled and value is not None:
+        if (type(value) is not dict or type(value.get("cutoff")) is not int
+                or value["cutoff"] <= 0 or value.get("migrated_to") != policy.fingerprint):
+            return None
+        migration = (value["cutoff"], value["migrated_to"])
+    try:
+        return HistoryProjectionSnapshot(agent.session_id, policy.enabled,
+            policy.fingerprint, _source_key(rows), migration)
+    except (TypeError, ValueError):
+        return None
+
+
+def attach_history_projection(agent, snapshot, rows):
+    """Apply only to unchanged full history, never to a routed digest.
+
+    Identity attestation and summary scope/coverage are still independently
+    checked by their native owners. A child receives its own migration dict,
+    not a parent agent, database handle or shared mutable authority.
+    """
+    from agent.identity_policy import policy_for_agent
+    policy = policy_for_agent(agent)
+    if (type(snapshot) is not HistoryProjectionSnapshot
+            or snapshot.session_id != agent.session_id
+            or snapshot.identity_enabled != policy.enabled
+            or snapshot.fingerprint != policy.fingerprint):
+        return False
+    try:
+        if snapshot.source_key != _source_key(rows):
+            return False
+    except (TypeError, ValueError):
+        return False
+    migration = snapshot.migration
+    if migration is not None and (not policy.enabled or type(migration) is not tuple
+            or len(migration) != 2 or type(migration[0]) is not int
+            or migration[0] <= 0 or migration[1] != policy.fingerprint):
+        return False
+    value = None if migration is None else {"cutoff": migration[0], "migrated_to": migration[1]}
+    current = getattr(agent, "_identity_legacy_history_v1", None)
+    if current is not None and current != value:
+        return False
+    if value is not None:
+        agent._identity_legacy_history_v1 = dict(value)
+        config = getattr(agent, "_session_init_model_config", None)
+        if isinstance(config, dict):
+            config["_identity_legacy_history_v1"] = dict(value)
+    return True
+
+
 @dataclass(frozen=True)
 class SummarySnapshot:
     key: tuple
