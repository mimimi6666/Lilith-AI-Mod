@@ -0,0 +1,109 @@
+"""Background-only capability guidance and native loop convergence.
+
+No writer, extra provider, preference change or approval bypass. Foreground
+guardrails are untouched. Native tool results remain the outcome authority.
+"""
+import json
+from collections.abc import Mapping
+
+from agent.tool_guardrails import ToolCallGuardrailController, ToolGuardrailDecision
+
+
+def _target_available(agent, target):
+    if target not in ("memory", "user"):
+        return True  # native schema/target validation owns malformed requests
+    enabled = "_memory_enabled" if target == "memory" else "_user_profile_enabled"
+    if not getattr(agent, enabled, False):
+        return False
+    if target == "user" and getattr(agent, "_authoritative_user_profile_writes", False):
+        return getattr(agent, "_memory_manager", None) is not None
+    return getattr(agent, "_memory_store", None) is not None
+
+
+def review_capability_guidance(agent):
+    """Numeric advisory snapshot, not permission or a capacity reservation."""
+    lines = ["Background maintenance constraints (not new write authority):"]
+    for target in ("memory", "user"):
+        available = _target_available(agent, target)
+        lines.append(f"memory target={target}: {'available under native policy' if available else 'unavailable; skip this target'}.")
+        store = getattr(agent, "_memory_store", None)
+        if available and store is not None:
+            try:
+                used, limit = store._char_count(target), store._char_limit(target)
+                if type(used) is int and type(limit) is int and 0 <= used and 0 <= limit:
+                    lines.append(f"Built-in {target} snapshot: {used}/{limit} characters; {max(0, limit-used)} remaining. The native store rechecks the actual current state.")
+            except Exception:
+                pass  # unknown capacity is not an empty store
+    lines += [
+        "Do not copy user-profile facts into environmental memory or a skill as a workaround. The separate authoritative profile-review flow remains responsible for those facts.",
+        "No-op is complete. Do not delete unrelated knowledge merely to fit a new entry. If capacity is insufficient, skip or propose one safe atomic consolidation using exact existing entries; never repeatedly guess a shorter batch.",
+        "Protected/bundled/hub/user-owned/pinned skills remain protected. Skip a refused target; do not try another tool or path to change it.",
+        "An unavailable provider, denied write, pending approval or terminal result is not an invitation to retry. Only committed tool receipts mean saved; staged or skipped is not saved.",
+    ]
+    return "\n".join(lines)
+
+
+class BackgroundReviewGuardrails(ToolCallGuardrailController):
+    """Converge optional maintenance, using the existing controlled-halt seam."""
+    def __init__(self, agent, config=None):
+        self._review_agent = agent
+        super().__init__(config)
+
+    def reset_for_turn(self):
+        super().reset_for_turn()
+        self._review_failures = {}
+        self._review_stop = None
+
+    def _stop(self, tool_name, code, *, before=False, count=1):
+        decision = ToolGuardrailDecision(action="block" if before else "halt",
+            code=code, tool_name=tool_name, count=count,
+            message="Background maintenance stopped at an unavailable, uncommitted or repeatedly failing operation. Do not retry or bypass it. Earlier committed receipts remain valid; this operation was not reported as saved.")
+        self._review_stop = decision
+        self._halt_decision = decision
+        return decision
+
+    def before_call(self, tool_name, args):
+        if self._review_stop is not None:
+            return self._stop(tool_name, self._review_stop.code, before=True,
+                              count=self._review_stop.count)
+        native = super().before_call(tool_name, args)
+        if not native.allows_execution:
+            return native
+        if tool_name == "memory" and isinstance(args, Mapping):
+            if not _target_available(self._review_agent, args.get("target", "memory")):
+                return self._stop(tool_name, "background_memory_target_unavailable", before=True)
+        return native
+
+    def after_call(self, tool_name, args, result, *, failed=None):
+        if tool_name not in ("memory", "skill_manage"):
+            return super().after_call(tool_name, args, result, failed=failed)
+        try:
+            data = json.loads(result) if isinstance(result, str) else None
+        except (TypeError, ValueError):
+            data = None
+        data = data if isinstance(data, dict) else {}
+        if data.get("staged") is True or (data.get("success") is True and data.get("committed") is False):
+            return self._stop(tool_name, "background_write_pending")
+        is_failure = failed is True or data.get("success") is False or bool(data.get("error"))
+        if not is_failure:
+            self._review_failures.pop(tool_name, None)
+            return super().after_call(tool_name, args, result, failed=failed)
+        count = self._review_failures.get(tool_name, 0) + 1
+        self._review_failures[tool_name] = count
+        error = data.get("error")
+        protected = (tool_name == "skill_manage" and isinstance(error, str)
+                     and error.startswith("Refusing background curator "))
+        unavailable = data.get("code") in (
+            "memory.authoritative_provider_unavailable", "memory.authoritative_user_profile_required")
+        if data.get("done") is True or unavailable or protected:
+            return self._stop(tool_name, "background_write_terminal", count=count)
+        if count >= 2:
+            return self._stop(tool_name, "background_write_no_progress", count=count)
+        # One diagnostic/correction, never the foreground 'keep using tools'
+        # recovery instruction. Native stricter limits must still take effect.
+        native = super().after_call(tool_name, args, result, failed=True)
+        if native.should_halt:
+            return native
+        return ToolGuardrailDecision(action="warn", code="background_write_correction",
+            tool_name=tool_name, count=count,
+            message="This optional maintenance write failed. Skip it unless one safe correction is evident from the exact tool result. At most one corrective attempt; do not remove unrelated facts, change permissions or redirect user facts to another store.")
