diff --git a/agent/tool_result_projection.py b/agent/tool_result_projection.py
new file mode 100644
--- /dev/null
+++ b/agent/tool_result_projection.py
@@ -0,0 +1,188 @@
+"""Request-only projection for known verbose schemas; never transcript writes.
+
+No model call/quota. Unknown tools/shapes pass through. Match native call ID and
+tool name, not text. Keep all candidates/order/pagination and unknown fields.
+"""
+from copy import deepcopy
+import json
+import logging
+
+logger = logging.getLogger(__name__)
+_MIN_CHARS = 2000
+_MAX_CHARS = 2_000_000
+_GROUPS = {"tracks": "track", "artists": "artist", "albums": "album",
+           "playlists": "playlist", "shows": "show", "episodes": "episode",
+           "audiobooks": "audiobook"}
+_MEDIA_TYPES = set(_GROUPS.values())
+# Exact repeated metadata is stored once, not discarded. Keep the action
+# locators readable inline; all remaining fields (including artwork, errors,
+# availability and unknown future fields) remain in the shared metadata table.
+_INLINE = {"id", "name", "uri", "type", "external_urls"}
+_NOTICE = "Compact lossless metadata view. Merge each _metadata_ref from _shared_metadata with its inline fields. Original full result remains in chat history."
+
+
+def _media(value, expected=None, depth=0):
+    if not isinstance(value, dict) or depth > 8:
+        return value
+    kind = value.get("type")
+    if kind not in _MEDIA_TYPES or (expected is not None and expected != kind):
+        return value
+    if "error" in value or not isinstance(value.get("id"), str) or not isinstance(value.get("name"), str):
+        return value
+    result = deepcopy(value)
+    for key in ("album", "show", "audiobook"):
+        if key in result:
+            result[key] = _media(result[key], key, depth + 1)
+    if isinstance(result.get("artists"), list):
+        result["artists"] = [_media(a, "artist", depth + 1) for a in result["artists"]]
+    return result
+
+
+def _intern_metadata(payload):
+    """Factor exact repeated media objects; never fuzzy-deduplicate outcomes."""
+    counts = {}
+    def identity(node):
+        if (not isinstance(node, dict) or node.get("type") not in _MEDIA_TYPES
+                or not isinstance(node.get("id"), str) or not isinstance(node.get("name"), str)
+                or "error" in node):
+            return None
+        key = json.dumps(node, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
+        return key if len(key) > 250 else None
+    def visit(node, depth=0):
+        if depth > 24:
+            raise ValueError("result_depth_exceeded")
+        if isinstance(node, dict):
+            # Do not collide with native/future provider fields of this name.
+            if any(k in node for k in ("_metadata_ref", "_shared_metadata", "_model_view")):
+                raise ValueError("projection_field_collision")
+            key = identity(node)
+            if key is not None:
+                counts[key] = counts.get(key, 0) + 1
+            for value in node.values(): visit(value, depth + 1)
+        elif isinstance(node, list):
+            for value in node: visit(value, depth + 1)
+    visit(payload)
+    shared, names = {}, {}
+    def render(node):
+        if isinstance(node, dict):
+            key = identity(node)
+            if key is not None and counts[key] > 1:
+                if key not in names:
+                    ref = "m" + str(len(names) + 1)
+                    names[key] = ref
+                    shared[ref] = {k: render(v) for k, v in node.items() if k not in _INLINE}
+                return dict({k: deepcopy(v) for k, v in node.items() if k in _INLINE}, _metadata_ref=names[key])
+            return {k: render(v) for k, v in node.items()}
+        if isinstance(node, list):
+            return [render(v) for v in node]
+        return node
+    result = render(payload)
+    if shared:
+        result["_shared_metadata"] = shared
+    return result
+
+
+def _spotify_search(payload):
+    if not isinstance(payload, dict) or "error" in payload or payload.get("success") is False:
+        return None
+    groups = [key for key in _GROUPS if key in payload]
+    if not groups:
+        return None
+    result = deepcopy(payload)
+    for key in groups:
+        group = payload[key]
+        if not isinstance(group, dict) or not isinstance(group.get("items"), list):
+            return None
+        if len(group["items"]) > 100:
+            return None
+        # Page href/next/previous are actionable pagination: keep them.
+        items = [_media(item, _GROUPS[key]) for item in group["items"]]
+        result[key]["items"] = items
+    return _intern_metadata(result)
+
+
+def _spotify_playback(payload):
+    if (not isinstance(payload, dict) or "error" in payload or payload.get("success") is False
+            or type(payload.get("is_playing")) is not bool or not isinstance(payload.get("item"), dict)):
+        return None
+    item = _media(payload["item"])
+    result = deepcopy(payload)
+    result["item"] = item
+    return _intern_metadata(result)
+
+
+_REDUCERS = {"spotify_search": _spotify_search, "spotify_playback": _spotify_playback}
+
+
+def project_tool_results(rows):
+    """Return (copy with reduced results, changed indices); malformed unchanged.
+
+    Only complete assistant call/result groups qualify, including the fresh
+    completed group in the active turn. Do not rewrite partial/multimodal data,
+    arguments, reasoning signatures, the user request or primary responses.
+    """
+    calls, results, duplicates = {}, {}, set()
+    for index, row in enumerate(rows):
+        if not isinstance(row, dict):
+            continue
+        if row.get("role") == "assistant":
+            group = row.get("tool_calls")
+            if not isinstance(group, list) or not group:
+                continue
+            ids = []
+            for call in group:
+                if not isinstance(call, dict) or not isinstance(call.get("id"), str):
+                    ids = []
+                    break
+                ids.append(call["id"])
+            if not ids:
+                continue
+            for call in group:
+                key = call["id"]
+                if key in calls:
+                    duplicates.add(key)
+                calls[key] = (index, call.get("function"), tuple(ids))
+        elif row.get("role") == "tool" and isinstance(row.get("tool_call_id"), str):
+            key = row["tool_call_id"]
+            if key in results:
+                duplicates.add(key)
+            results[key] = index
+    output = list(rows)
+    changed = set()
+    for key, (call_index, function, group) in calls.items():
+        if (not isinstance(function, dict) or function.get("name") not in _REDUCERS
+                or any(i in duplicates or i not in results or results[i] <= call_index for i in group)):
+            continue
+        if any(not isinstance(row, dict) or row.get("role") != "tool"
+               or row.get("tool_call_id") not in group
+               for row in rows[call_index + 1:max(results[i] for i in group) + 1]):
+            continue
+        index = results[key]
+        text = rows[index].get("content")
+        if not isinstance(text, str) or not _MIN_CHARS <= len(text) <= _MAX_CHARS:
+            continue
+        try:
+            payload = json.loads(text)
+            reduced = _REDUCERS[function["name"]](payload)
+            if reduced is None or "_model_view" in reduced:
+                continue
+            reduced["_model_view"] = _NOTICE
+            content = json.dumps(reduced, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
+        except (TypeError, ValueError, RecursionError):
+            continue
+        if len(content) >= len(text):
+            continue
+        row = deepcopy(rows[index])
+        row["content"] = content
+        output[index] = row
+        changed.add(index)
+    return output, changed
+
+
+def project_request_results(rows):
+    result, changed = project_tool_results(rows)
+    if changed:
+        logger.info("[tool_result_projection] results=%d before_chars=%d after_chars=%d measurement=text_characters",
+                    len(changed), sum(len(rows[i]["content"]) for i in changed),
+                    sum(len(result[i]["content"]) for i in changed))
+    return result
