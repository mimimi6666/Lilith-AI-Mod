@@ -0,0 +1,48 @@
+"""Data-only summary handoff; no parent agent, compressor or write authority."""
+from dataclasses import dataclass
+from agent.history_context import summary_scope
+
+
+@dataclass(frozen=True)
+class SummarySnapshot:
+    key: tuple
+    covered: tuple[str, ...]
+    summary: str
+    origin_id: str
+
+
+def freeze_summary(agent):
+    from agent.usage_budget_runtime import capture_origin
+    origin = capture_origin()
+    if origin is None or origin.ledger.snapshot().stopped:
+        return None
+    spec = origin.ledger.policy.information_strategy
+    state = getattr(agent, "_information_summary", None)
+    if (spec.history_turns is None or not isinstance(state, dict)
+            or state.get("key") != summary_scope(agent, origin, spec)
+            or state.get("last") != origin.origin_id
+            or not isinstance(state.get("summary"), str) or not state["summary"].strip()
+            or not isinstance(state.get("covered"), tuple) or not state["covered"]
+            or not all(isinstance(k, str) and len(k) == 64 for k in state["covered"])):
+        return None
+    return SummarySnapshot(state["key"], state["covered"], state["summary"], origin.origin_id)
+
+
+def attach_summary(agent, snapshot):
+    # Even without a reusable checkpoint the background fork retains originals;
+    # it must not spend a second auxiliary call rebuilding the historical summary.
+    agent._background_context_readonly = True
+    from agent.usage_budget_runtime import capture_origin
+    origin = capture_origin()
+    if (type(snapshot) is not SummarySnapshot or origin is None
+            or origin.origin_id != snapshot.origin_id or origin.ledger.snapshot().stopped):
+        return False
+    spec = origin.ledger.policy.information_strategy
+    if spec.history_turns is None or snapshot.key != summary_scope(agent, origin, spec):
+        return False
+    # A new dict, with immutable values only. project_context independently
+    # verifies complete exchange coverage against the CHILD's actual send.
+    agent._information_summary = {"key": snapshot.key, "covered": snapshot.covered,
+        "summary": snapshot.summary, "last": snapshot.origin_id,
+        "attempt_count": len(snapshot.covered)}
+    return True
