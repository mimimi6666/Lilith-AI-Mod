+++ b/tools/computer_use/windows_app_catalog.py
@@ -0,0 +1,146 @@
+"""Read-only, current-user Windows catalog supplement for the local CUA driver.
+
+Some driver WinRT scans return an incomplete packaged-app catalog on timeout.
+StartApps supplies OS-registered names/AUMIDs, never paths or activation code.
+The existing driver remains the only launcher and native approval owner.
+"""
+import json
+import os
+import re
+import subprocess
+import sys
+from copy import deepcopy
+
+_AUMID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*![A-Za-z0-9][A-Za-z0-9._-]*\Z")
+_MAX_ROWS = 4096
+_SCRIPT = """$ErrorActionPreference = 'Stop'
+[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
+$apps = @(Get-StartApps | Select-Object -First 4097 -Property Name,AppID)
+ConvertTo-Json -InputObject $apps -Compress -Depth 3
+"""
+
+
+def valid_aumid(value):
+    return isinstance(value, str) and len(value) <= 512 and _AUMID.fullmatch(value) is not None
+
+
+def parse_start_apps(text):
+    if not isinstance(text, str) or len(text) > 2_000_000:
+        raise ValueError("windows_app_catalog_too_large")
+    rows = json.loads(text.lstrip("\ufeff"))
+    if not isinstance(rows, list) or len(rows) > _MAX_ROWS:
+        raise ValueError("windows_app_catalog_invalid")
+    result, seen = [], set()
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("windows_app_catalog_invalid")
+        name, app_id = row.get("Name"), row.get("AppID")
+        # Desktop activation records remain owned by the driver's shortcut
+        # resolver. An opaque Win32 StartAppID is NOT an executable path.
+        if not valid_aumid(app_id):
+            continue
+        if (not isinstance(name, str) or not name.strip() or len(name) > 512
+                or any(c in name for c in "\x00\r\n")):
+            raise ValueError("windows_app_catalog_invalid")
+        identity = (name.strip().casefold(), app_id.casefold())
+        if identity not in seen:
+            seen.add(identity)
+            result.append({"name": name.strip(), "aumid": app_id, "kind": "packaged",
+                           "catalog_source": "windows_start_apps"})
+    return result
+
+
+def read_start_apps():
+    if sys.platform != "win32":
+        return []
+    # Resolve the system executable via Windows, not PATH, an app name, or
+    # model-supplied command text. No user profile scripts/credentials loaded.
+    import ctypes
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.GetSystemDirectoryW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint]
+    kernel.GetSystemDirectoryW.restype = ctypes.c_uint
+    directory = ctypes.create_unicode_buffer(32768)
+    count = kernel.GetSystemDirectoryW(directory, len(directory))
+    if not 0 < count < len(directory):
+        raise OSError("windows_system_directory_unavailable")
+    executable = os.path.join(directory.value, "WindowsPowerShell", "v1.0", "powershell.exe")
+    environment = {k: v for k, v in os.environ.items()
+                   if k.upper() in {"SYSTEMROOT", "WINDIR", "TEMP", "TMP", "USERPROFILE", "APPDATA", "LOCALAPPDATA"}}
+    completed = subprocess.run(
+        [executable, "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", _SCRIPT],
+        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        timeout=8, check=True, creationflags=subprocess.CREATE_NO_WINDOW,
+        env=environment, encoding="utf-8", errors="strict")
+    return parse_start_apps(completed.stdout)
+
+
+def process_aumid(pid):
+    """Fresh identity from a query-only process handle; no privilege changes."""
+    if sys.platform != "win32" or type(pid) is not int or not 0 < pid <= 0xFFFFFFFF:
+        return None
+    import ctypes
+    from ctypes import wintypes
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+    kernel.OpenProcess.restype = wintypes.HANDLE
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    kernel.CloseHandle.restype = wintypes.BOOL
+    get_id = kernel.GetApplicationUserModelId
+    get_id.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.UINT), wintypes.LPWSTR]
+    get_id.restype = wintypes.LONG
+    handle = kernel.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
+    if not handle:
+        return None
+    try:
+        length = wintypes.UINT(0)
+        if get_id(handle, ctypes.byref(length), None) != 122 or not 1 < length.value <= 513:
+            return None
+        value = ctypes.create_unicode_buffer(length.value)
+        if get_id(handle, ctypes.byref(length), value) != 0:
+            return None
+        return value.value if valid_aumid(value.value) else None
+    finally:
+        kernel.CloseHandle(handle)
+
+
+def row_aumid(row):
+    if not isinstance(row, dict):
+        return None
+    for key in ("aumid", "app_id", "bundle_id", "bundleId"):
+        if valid_aumid(row.get(key)):
+            return row[key]
+    path = row.get("launch_path")
+    prefix = "shell:appsfolder\\"
+    if isinstance(path, str) and path.casefold().startswith(prefix) and valid_aumid(path[len(prefix):]):
+        return path[len(prefix):]
+    return None
+
+
+def merge_catalog(driver_rows, start_rows, running):
+    """Join only exact AUMIDs. Same-name/different-app ambiguity stays visible."""
+    if not isinstance(driver_rows, list) or len(driver_rows) > _MAX_ROWS:
+        raise ValueError("windows_driver_catalog_invalid")
+    result = deepcopy(driver_rows)
+    for entry in start_rows:
+        app_id = row_aumid(entry)
+        matches = [row for row in result if row_aumid(row) and row_aumid(row).casefold() == app_id.casefold()]
+        if matches:
+            # Do not silently collapse pre-existing ambiguity or override an
+            # existing OS name. Expose localized Start-menu names as aliases.
+            for row in matches:
+                if row.get("name") != entry["name"] and not row.get("display_name"):
+                    row["display_name"] = entry["name"]
+        else:
+            row = deepcopy(entry)
+            result.append(row)
+            matches = [row]
+        pids = [pid for pid, observed in running.items() if observed.casefold() == app_id.casefold()]
+        for row in matches:
+            if len(pids) == 1:
+                row.update(pid=pids[0], running=True)
+            elif row.get("pid") not in pids:
+                row.pop("pid", None)
+                row["running"] = False
+    if len(result) > _MAX_ROWS:
+        raise ValueError("windows_app_catalog_too_large")
+    return result
