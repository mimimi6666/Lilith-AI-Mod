diff --git a/tests/test_tool_efficiency.py b/tests/test_tool_efficiency.py
new file mode 100644
--- /dev/null
+++ b/tests/test_tool_efficiency.py
@@ -0,0 +1,258 @@
+from copy import deepcopy
+import json
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import NormalBudget, VerifiedModelLimits, resolve_policy, TurnBudgetLedger
+from agent.usage_strategy import strategy_for_level
+from agent.usage_strategy_context import project_context, compact_results
+from agent.background_context import freeze_summary, attach_summary
+from agent.tool_result_projection import project_tool_results
+from tools.computer_use.windows_app_catalog import parse_start_apps, merge_catalog, valid_aumid, process_aumid
+
+
+def search_fixture(count=10):
+    artist = {"id": "artist-1", "name": "Fixture Artist", "type": "artist", "uri": "spotify:artist:fixture",
+              "external_urls": {"spotify": "https://example.test/artist"},
+              "images": [{"url": "https://example.test/" + "a" * 160, "width": 640, "height": 640}] * 3,
+              "href": "https://example.test/api/artist"}
+    album = {"id": "album-1", "name": "Fixture Album", "type": "album", "uri": "spotify:album:fixture",
+             "images": artist["images"], "artists": [artist], "release_date": "2001", "album_type": "album"}
+    return {"tracks": {"items": [dict(id=f"track-{i}", name=f"Track {i}", type="track",
+        uri=f"spotify:track:fixture{i}", artists=[artist], album=album, is_playable=i != 2,
+        restrictions={"reason": "market"} if i == 2 else {}, explicit=False, duration_ms=180000,
+        unknown_future={"value": "retain"}) for i in range(count)],
+        "offset": 0, "limit": count, "total": 101, "next": "https://example.test/page/2", "previous": None}}
+
+
+def result_rows(payload=None, name="spotify_search"):
+    return [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "type": "function",
+             "extra_content": {"signature": "synthetic"},
+             "function": {"name": name, "arguments": '{"query":"fixture"}'}}]},
+            {"role": "tool", "tool_call_id": "c1", "content": json.dumps(payload or search_fixture(), indent=2)}]
+
+
+class ToolResultTests(unittest.TestCase):
+    def test_search_reduced_with_candidates_actions_limits_and_pagination_intact(self):
+        rows = result_rows()
+        before = deepcopy(rows)
+        output, changed = project_tool_results(rows)
+        self.assertEqual(changed, {1})
+        self.assertEqual(rows, before)
+        self.assertEqual(output[0], before[0])
+        original = json.loads(rows[1]["content"])
+        reduced = json.loads(output[1]["content"])
+        self.assertLess(len(output[1]["content"]), len(rows[1]["content"]) * .6)
+        self.assertEqual(len(reduced["tracks"]["items"]), 10)
+        for old, new in zip(original["tracks"]["items"], reduced["tracks"]["items"]):
+            for key in ("id", "name", "uri", "is_playable", "restrictions", "explicit", "duration_ms", "unknown_future"):
+                self.assertEqual(new[key], old[key])
+            self.assertEqual(new["artists"][0]["external_urls"], old["artists"][0]["external_urls"])
+        for key in ("offset", "limit", "total", "next", "previous"):
+            self.assertEqual(original["tracks"][key], reduced["tracks"][key])
+        table = reduced.pop("_shared_metadata")
+        reduced.pop("_model_view")
+        def expand(node):
+            if isinstance(node, dict):
+                raw = dict(table[node["_metadata_ref"]], **{k: v for k, v in node.items() if k != "_metadata_ref"}) if "_metadata_ref" in node else node
+                return {k: expand(v) for k, v in raw.items()}
+            return [expand(v) for v in node] if isinstance(node, list) else node
+        self.assertEqual(expand(reduced), original, "projection lost provider fields")
+
+    def test_playback_status_device_and_actions_preserved(self):
+        payload = {"is_playing": False, "item": search_fixture()["tracks"]["items"][0],
+                   "device": {"id": "fixture-device", "is_restricted": True}, "actions": {"disallows": {"resuming": True}}}
+        rows, changed = project_tool_results(result_rows(payload, "spotify_playback"))
+        value = json.loads(rows[1]["content"])
+        self.assertEqual(changed, {1})
+        for key in ("device", "actions", "is_playing"):
+            self.assertEqual(value[key], payload[key])
+
+    def test_error_and_unknown_tools_not_reinterpreted(self):
+        for payload, name in [(dict(search_fixture(), error={"status": 403}), "spotify_search"),
+                              (dict(search_fixture(), success=False), "spotify_search"),
+                              (search_fixture(), "third_party_search")]:
+            rows = result_rows(payload, name)
+            self.assertEqual(project_tool_results(rows), (rows, set()))
+
+    def test_malformed_unknown_shapes_multimodal_and_small_results_unchanged(self):
+        for value in ("{bad" * 1000, "short", [{"type": "image_url", "image_url": "fixture"}],
+                      json.dumps({"unknown": "x" * 3000}), json.dumps({"tracks": {"items": "x" * 3000}})):
+            rows = result_rows()
+            rows[1]["content"] = value
+            self.assertEqual(project_tool_results(rows), (rows, set()))
+
+    def test_all_parallel_results_required(self):
+        rows = result_rows()
+        rows[0]["tool_calls"].append({"id": "c2", "function": {"name": "other", "arguments": "{}"}})
+        self.assertEqual(project_tool_results(rows), (rows, set()))
+        rows.append({"role": "tool", "tool_call_id": "c2", "content": "error: retained"})
+        output, changed = project_tool_results(rows)
+        self.assertEqual(changed, {1})
+        self.assertEqual(output[-1], rows[-1])
+
+    def test_missing_and_duplicate_call_ids_do_not_project(self):
+        for variant in ("missing", "duplicate_result", "duplicate_call", "reversed"):
+            rows = result_rows()
+            if variant == "missing": rows[1]["tool_call_id"] = "unknown"
+            elif variant == "duplicate_result": rows.append(deepcopy(rows[1]))
+            elif variant == "duplicate_call": rows[0]["tool_calls"] *= 2
+            else: rows.reverse()
+            self.assertEqual(project_tool_results(rows), (rows, set()))
+
+    def test_projection_idempotent(self):
+        output, _ = project_tool_results(result_rows())
+        self.assertEqual(project_tool_results(output), (output, set()))
+
+    def test_old_structured_results_do_not_become_broken_json_excerpts(self):
+        rows = result_rows()
+        output = compact_results(rows, 1200)
+        payload = json.loads(output[1]["content"])
+        self.assertEqual(len(payload["tracks"]["items"]), 10)
+        self.assertEqual(rows, result_rows())
+
+    def test_no_cap_keeps_fifth_sixth_behavior(self):
+        rows = result_rows()
+        self.assertEqual(compact_results(rows, None), rows)
+
+
+class CatalogTests(unittest.TestCase):
+    def test_localized_current_user_names_and_non_default_app_ids(self):
+        rows = parse_start_apps(json.dumps([{"Name": "範例音樂", "AppID": "Example.Music_abc!Player"},
+            {"Name": "Other", "AppID": "Other.App_def!DesktopClient"}, {"Name": "Win32", "AppID": "OpaqueDesktopId"}]))
+        self.assertEqual([r["aumid"] for r in rows], ["Example.Music_abc!Player", "Other.App_def!DesktopClient"])
+        self.assertEqual(rows[0]["name"], "範例音樂")
+        self.assertTrue(all("launch_path" not in row for row in rows))
+
+    def test_untrusted_launch_paths_scripts_and_malformed_ids_not_admitted(self):
+        for value in (None, "", "file.exe", "shell:appsfolder\\Example!App", "x!App;exit", "x!App\n", "x!A B", "x"*513+"!A"):
+            self.assertFalse(valid_aumid(value))
+
+    def test_parse_rejects_non_list_overflow_and_malformed_rows(self):
+        for value in ({}, [None], [{"Name": "bad\nname", "AppID": "Example!App"}], [{}] * 4097):
+            with self.assertRaises(ValueError): parse_start_apps(json.dumps(value))
+
+    def test_exact_duplicate_registration_deduped_not_same_names(self):
+        rows = parse_start_apps(json.dumps([{"Name": "App", "AppID": "One!App"}] * 2 + [{"Name": "App", "AppID": "Two!App"}]))
+        self.assertEqual(len(rows), 2)
+
+    def test_supplements_missing_catalog_and_joins_only_exact_running_aumid(self):
+        desktop = [{"name": "Desktop", "kind": "desktop", "launch_path": "synthetic.exe"}]
+        start = parse_start_apps('[{"Name":"App","AppID":"Vendor.Family!Client"}]')
+        output = merge_catalog(desktop, start, {101: "Vendor.Family!Client", 102: "Other!Client"})
+        self.assertEqual(output[1]["pid"], 101)
+        self.assertEqual(desktop, [{"name": "Desktop", "kind": "desktop", "launch_path": "synthetic.exe"}])
+
+    def test_existing_driver_identity_keeps_locator_and_gains_local_name(self):
+        driver = [{"name": "Generic Name", "launch_path": "shell:AppsFolder\\Vendor.Family!Client", "kind": "uwp"}]
+        start = parse_start_apps('[{"Name":"Localized Name","AppID":"Vendor.Family!Client"}]')
+        output = merge_catalog(driver, start, {})
+        self.assertEqual(len(output), 1)
+        self.assertEqual(output[0]["display_name"], "Localized Name")
+        self.assertEqual(output[0]["launch_path"], driver[0]["launch_path"])
+
+    def test_same_name_different_identity_not_merged(self):
+        start = parse_start_apps('[{"Name":"App","AppID":"Vendor.Two!Client"}]')
+        output = merge_catalog([{"name": "App", "aumid": "Vendor.One!Client"}], start, {})
+        self.assertEqual(len(output), 2)
+
+    def test_ambiguous_running_identity_does_not_fabricate_one_pid(self):
+        start = parse_start_apps('[{"Name":"App","AppID":"Vendor!Client"}]')
+        output = merge_catalog([], start, {10: "Vendor!Client", 11: "Vendor!Client"})
+        self.assertNotIn("pid", output[0])
+
+    def test_non_windows_and_invalid_pid_never_query_os(self):
+        with patch("sys.platform", "linux"):
+            self.assertIsNone(process_aumid(123))
+        for pid in (None, -1, 0, True, "12", 0x100000000):
+            self.assertIsNone(process_aumid(pid))
+
+
+class BackgroundTests(unittest.TestCase):
+    def setUp(self):
+        policy = resolve_policy(4, NormalBudget(max_iterations=90), VerifiedModelLimits(), version=1)
+        self.origin = SimpleNamespace(origin_id="origin-one", ledger=TurnBudgetLedger("origin-one", policy))
+        self.agent = SimpleNamespace(session_id="synthetic", model="model", provider="provider", api_mode="chat_completions")
+        self.calls = []
+        def summarize(rows):
+            self.calls.append(deepcopy(rows))
+            return "Summary of synthetic old facts."
+        self.agent.context_compressor = SimpleNamespace(_generate_summary=summarize)
+        self.rows = [r for i in range(40) for r in ({"role": "user", "content": f"question-{i}"},
+                                                      {"role": "assistant", "content": f"answer-{i}"})]
+        self.units = tuple((i, i+1) for i in range(0, 78, 2))
+        self.spec = strategy_for_level(4)
+        project_context(self.agent, self.rows, self.units, self.spec, self.origin)
+        self.capture = patch("agent.usage_budget_runtime.capture_origin", return_value=self.origin)
+        self.capture.start()
+        self.addCleanup(self.capture.stop)
+
+    def child(self):
+        return SimpleNamespace(session_id="synthetic", model="model", provider="provider", api_mode="chat_completions",
+                               context_compressor=self.agent.context_compressor)
+
+    def test_child_reuses_summary_without_second_auxiliary_call(self):
+        snapshot = freeze_summary(self.agent)
+        child = self.child()
+        self.assertTrue(attach_summary(child, snapshot))
+        output = project_context(child, self.rows, self.units, self.spec, self.origin)
+        self.assertEqual(len(self.calls), 1)
+        self.assertLess(len(output), len(self.rows))
+        self.assertIsNot(child._information_summary, self.agent._information_summary)
+        self.assertEqual(output[-1], self.rows[-1])
+
+    def test_child_retains_new_uncovered_turn_without_regenerating(self):
+        snapshot = freeze_summary(self.agent)
+        child = self.child()
+        attach_summary(child, snapshot)
+        rows = self.rows + [{"role": "user", "content": "new"}, {"role": "assistant", "content": "new answer"}]
+        output = project_context(child, rows, self.units + ((78, 79),), self.spec, self.origin)
+        self.assertEqual(len(self.calls), 1)
+        self.assertEqual(output[-4:], rows[-4:])
+
+    def test_missing_snapshot_keeps_originals_without_summary_call(self):
+        child = self.child()
+        self.assertFalse(attach_summary(child, None))
+        output = project_context(child, self.rows, self.units, self.spec, self.origin)
+        self.assertEqual(output, self.rows)
+        self.assertEqual(len(self.calls), 1)
+
+    def test_snapshot_freezes_before_parent_advances(self):
+        snapshot = freeze_summary(self.agent)
+        self.agent._information_summary["summary"] = "later foreground summary"
+        child = self.child()
+        self.assertTrue(attach_summary(child, snapshot))
+        self.assertEqual(child._information_summary["summary"], "Summary of synthetic old facts.")
+
+    def test_route_session_and_identity_mismatches_cannot_reuse(self):
+        snapshot = freeze_summary(self.agent)
+        for key in ("session_id", "model", "provider", "api_mode", "base_url", "fingerprint"):
+            child = self.child()
+            setattr(child, key, "different")
+            self.assertFalse(attach_summary(child, snapshot), key)
+
+    def test_changed_originals_invalidate_without_rebuilding(self):
+        child = self.child()
+        attach_summary(child, freeze_summary(self.agent))
+        rows = deepcopy(self.rows)
+        rows[0]["content"] = "corrected fact"
+        output = project_context(child, rows, self.units, self.spec, self.origin)
+        self.assertEqual(output, rows)
+        self.assertEqual(len(self.calls), 1)
+
+    def test_wrong_origin_rejected(self):
+        snapshot = freeze_summary(self.agent)
+        self.origin.origin_id = "next"
+        self.assertFalse(attach_summary(self.child(), snapshot))
+        self.assertIsNone(freeze_summary(self.agent))
+
+    def test_stop_rejects_capture_and_attachment(self):
+        snapshot = freeze_summary(self.agent)
+        self.origin.ledger.stop()
+        self.assertIsNone(freeze_summary(self.agent))
+        self.assertFalse(attach_summary(self.child(), snapshot))
+
+
+if __name__ == "__main__":
+    unittest.main()
