+    def test_taps_are_after_native_writer_checks_before_relay_and_normalization(self):
+        source = Path(p.__file__).with_name("chat_completion_helpers.py").read_text(encoding="utf-8")
+        tree = ast.parse(source)
+        callback = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "_accept_stream_chunk")
+        call = next(n for n in ast.walk(callback) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+                    and n.func.id == "observe_chat_stream_chunk")
+        guards = [n for n in ast.walk(callback) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+                  and n.func.id in {"_stream_attempt_is_active", "stream_writer_is_current"}]
+        self.assertEqual(len(guards), 2)
+        self.assertTrue(all(n.lineno < call.lineno for n in guards))
+        self.assertEqual([a.id for a in call.args], ["agent", "_chunk"])
+        end_calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)
+                     and n.func.id == "observe_chat_stream_end"]
+        self.assertEqual(len(end_calls), 2)
