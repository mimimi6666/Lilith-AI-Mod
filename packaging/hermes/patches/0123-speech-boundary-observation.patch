+def _sdk_mapping(value):
+    # SDK Pydantic objects and SimpleNamespace fixtures expose stored fields.
+    # Do not call model_dump(), repr(), custom get()/__getattr__, or properties
+    # for individual fields. Missing/unknown carriers stay distinguishable.
+    if type(value) is dict:
+        return value
+    try:
+        data = object.__getattribute__(value, "__dict__")
+    except Exception:
+        return None
+    return data if type(data) is dict else None
+
+
+def _sdk_field(value, key):
+    data = _sdk_mapping(value)
+    if data is None:
+        return _UNAVAILABLE
+    if key in data:
+        return data[key]
+    # Pydantic v2 keeps provider-specific fields (including DeepSeek reasoning)
+    # outside __dict__. Read that exact storage, never a model_dump/property.
+    try:
+        extra = object.__getattribute__(value, "__pydantic_extra__")
+    except Exception:
+        extra = None
+    return extra.get(key, _UNAVAILABLE) if type(extra) is dict else _UNAVAILABLE
+
