+              "response_format": _format_observation(mapping.get("response_format", _UNAVAILABLE))}
+    for key in ("max_tokens", "max_completion_tokens", "max_output_tokens"):
+        value = mapping.get(key, _UNAVAILABLE)
+        result[key] = {"present": value is not _UNAVAILABLE,
+                       "value": value if type(value) is int and 0 <= value <= 2147483647 else None}
+    return result
