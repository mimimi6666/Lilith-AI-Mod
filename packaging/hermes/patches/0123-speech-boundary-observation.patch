+def _system_text(value):
+    """Lossless known text carriers only, including cache-split contracts."""
+    if type(value) is str:
+        return value
+    if type(value) is not list:
+        return None
+    parts = []
+    for part in value:
+        if type(part) is str:
+            parts.append(part)
+        elif (type(part) is dict and type(part.get("type")) is str
+              and part["type"] in {"text", "input_text"} and type(part.get("text")) is str):
+            parts.append(part["text"])
+        elif type(part) is dict and set(part) == {"cachePoint"}:
+            continue
+        else:
+            return None
+    return "".join(parts)
+
+
+def _system_contract_observation(messages):
+    result = {"status": "unavailable", "carriers": None, "roles": [],
+              "chars": None, "contract_count": None, "contract_exact": None}
+    if type(messages) is not list:
+        return result
+    roles, texts = [], []
+    for row in messages:
+        if type(row) is not dict or type(row.get("role")) is not str:
+            return result
+        if row["role"] in {"system", "developer"}:
+            text = _system_text(row.get("content"))
+            if text is None:
+                return result
+            roles.append(row["role"])
+            texts.append(text)
+    # Do not join separate authority messages: a contract split across roles
+    # must not be certified as one complete authoritative instruction.
+    count = sum(text.count(SYSTEM_OUTPUT_CONTRACT) for text in texts)
+    return {"status": "observed" if texts else "absent", "carriers": len(texts),
+            "roles": roles, "chars": sum(map(len, texts)), "contract_count": count,
+            "contract_exact": count > 0}
+
+
+def _stop_observation(value, state):
+    if value is _UNAVAILABLE:
+        return {"status": "absent", "count": 0, "delimiter_collision": False}
+    if value is None:
+        return {"status": "null", "count": 0, "delimiter_collision": False}
+    if type(value) is str:
+        values, status = [value], "string"
+    elif type(value) is list and len(value) <= 64 and all(type(item) is str for item in value):
+        values, status = value, "list"
+    else:
+        return {"status": "unavailable", "count": None, "delimiter_collision": None}
+    # A closed boolean, never the actual stop string or nonce. This is only
+    # literal delimiter overlap, not a prediction of model/provider stopping.
+    return {"status": status, "count": len(values), "delimiter_collision": any(
+        item and (item in state.open_tag or item in state.close_tag) for item in values)}
+
+
+def _format_observation(value):
+    if value is _UNAVAILABLE:
