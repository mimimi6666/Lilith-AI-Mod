+class _StreamTextObservation:
+    """Counts only; at most one delimiter-length tail retained in memory.
+
+    The tail is never serialized, persisted, used as speech or sent to a model.
+    An unknown field invalidates the count rather than pretending it is empty.
+    """
+    def __init__(self, state):
+        self.patterns = (state.open_tag, _PREFIX, state.close_tag)
+        self.counts = [0, 0, 0]
+        self.tail = ""
+        self.chars = self.parts = 0
+        self.available = True
+        self.bound = max(map(len, self.patterns)) - 1
+
+    def add(self, text):
+        if text is None:
+            return
+        if type(text) is not str:
+            self.available = False
+            self.tail = ""
+            return
+        self.parts += 1
+        self.chars += len(text)
+        if not self.available:
+            return
+        combined = self.tail + text
+        for index, pattern in enumerate(self.patterns):
+            probe, previous = (combined.lower(), self.tail.lower()) if index == 1 else (combined, self.tail)
+            self.counts[index] += probe.count(pattern) - previous.count(pattern)
+        self.tail = combined[-self.bound:]
+
+    def snapshot(self):
+        known = self.available
+        return {"status": "observed" if known else "unavailable",
+                "chars": self.chars if known else None, "parts": self.parts if known else None,
+                "marker_count": self.counts[0] if known else None,
+                "prefix_count": self.counts[1] if known else None,
+                "closing_count": self.counts[2] if known else None}
+
