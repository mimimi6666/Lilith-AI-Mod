+_WIRE_ROLES = ("system", "developer", "user", "assistant", "tool", "function", "unavailable")
+_WIRE_FINISHES = frozenset({"stop", "tool_calls", "length", "incomplete", "content_filter", "function_call"})
+_UNAVAILABLE = object()
