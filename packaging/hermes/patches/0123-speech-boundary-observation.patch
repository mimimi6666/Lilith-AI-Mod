+def observe_chat_stream_chunk(agent, chunk):
+    """Tap already-admitted SDK chunks, without wrapping/consuming the stream."""
+    try:
+        state, stream = _stream_observation_for(agent)
+        if stream is None:
+            return
+        stream["chunks"] += 1
+        choices = _sdk_field(chunk, "choices")
+        if type(choices) is list and not choices:
+            stream["empty_choices"] += 1
+            return
+        choice = choices[0] if type(choices) is list and choices else _UNAVAILABLE
+        delta = _sdk_field(choice, "delta")
+        for key in ("content", "reasoning_content", "reasoning"):
+            value = _sdk_field(delta, key)
+            # Optional reasoning fields are commonly absent from SDK chunks.
+            if value is _UNAVAILABLE and _sdk_mapping(delta) is not None:
+                value = None
+            stream[key].add(value)
