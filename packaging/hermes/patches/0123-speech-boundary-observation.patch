+"""Pure closed telemetry, request identity, SDK v1/v2 shapes and split markers."""
+import ast
+import copy
+import json
+import logging
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+
+from agent import paired_speech as p
+
+
+class BoundaryTests(unittest.TestCase):
+    def setUp(self):
+        self.pair = p.PairedSpeech("a" * 32, "zh-Hant")
+        self.agent = NS(_lilith_paired_speech=self.pair, _current_turn_id=self.pair.turn_id)
+        self.rows = []
+        self.capture = patch.object(p, "_emit_observation", lambda row: self.rows.append(copy.deepcopy(row)))
+        self.capture.start()
+        self.addCleanup(self.capture.stop)
+
+    def request(self, **kwargs):
+        request = {"messages": [{"role": "system", "content": p.SYSTEM_OUTPUT_CONTRACT},
+                    {"role": "user", "content": self.pair.instruction()}], **kwargs}
+        before = copy.deepcopy(request)
+        calls, result = [], object()
+        def create(**incoming):
+            calls.append(incoming)
+            return result
+        self.assertIs(p.observe_chat_sdk_request(self.agent, create, request), result)
+        self.assertEqual(len(calls), 1)
+        self.assertIs(calls[0]["messages"], request["messages"])
+        self.assertEqual(request, before)
+        return self.rows[-1]
+
+    def chunk(self, content=None, reasoning_content=None, reasoning=None, finish=None):
+        p.observe_chat_stream_chunk(self.agent, NS(choices=[NS(delta=NS(
+            content=content, reasoning_content=reasoning_content, reasoning=reasoning), finish_reason=finish)]))
+
+    def end(self, **kwargs):
+        p.observe_chat_stream_end(self.agent, **kwargs)
+        return self.rows[-1]
+
+    def test_fixed_system_exact_and_roles_not_imitation_in_user(self):
+        row = self.request(messages=[{"role": "user", "content": p.SYSTEM_OUTPUT_CONTRACT},
+            {"role": "system", "content": "synthetic system"},
+            {"role": "assistant", "content": self.pair.open_tag}])
+        self.assertFalse(row["system_contract"]["contract_exact"])
+        self.assertEqual(row["system_contract"]["roles"], ["system"])
+        self.assertEqual(row["roles"]["assistant"]["marker_count"], 1)
+        self.assertEqual(row["roles"]["user"]["message_count"], 1)
+
+    def test_system_cache_block_splits_and_duplicate_carriers(self):
+        text = p.SYSTEM_OUTPUT_CONTRACT
+        for split in (1, 39, len(text) - 1):
+            blocks = [{"type": "text", "text": text[:split], "cache_control": {"type": "ephemeral"}},
+                      {"type": "text", "text": text[split:]}]
+            row = self.request(messages=[{"role": "system", "content": blocks}])
+            self.assertEqual(row["system_contract"]["contract_count"], 1)
+        row = self.request(messages=[{"role": "system", "content": text},
+                                     {"role": "developer", "content": text}])
+        self.assertEqual(row["system_contract"]["contract_count"], 2)
+        self.assertEqual(row["system_contract"]["carriers"], 2)
+        row = self.request(messages=[{"role": "system", "content": text[:39]},
+                                     {"role": "developer", "content": text[39:]}])
+        self.assertFalse(row["system_contract"]["contract_exact"])
+
+    def test_unknown_system_shape_does_not_certify_absence(self):
+        row = self.request(messages=[{"role": "system", "content": [{"type": "image_url"}]}])
+        self.assertEqual(row["system_contract"]["status"], "unavailable")
+        self.assertIsNone(row["system_contract"]["contract_exact"])
+
+    def test_stops_and_extra_body_are_separately_observed_without_values(self):
+        row = self.request(stop=["synthetic-private-stop", "<lilith"], max_tokens=2048,
+            response_format={"type": "text"}, extra_body={"stop": self.pair.nonce,
+            "max_completion_tokens": 4096, "response_format": {"type": "json_schema", "json_schema": {
+                "name": "synthetic-private-schema", "schema": {"description": "private"}}}})
+        self.assertEqual(row["parameters"]["stop"], {"status": "list", "count": 2, "delimiter_collision": True})
+        self.assertTrue(row["extra_body_parameters"]["stop"]["delimiter_collision"])
+        self.assertEqual(row["extra_body_parameters"]["response_format"], "json_schema")
+        self.assertEqual(row["parameters"]["max_tokens"]["value"], 2048)
+        encoded = json.dumps(row)
+        for secret in (self.pair.nonce, "synthetic-private-stop", "synthetic-private-schema", self.pair.instruction()):
+            self.assertNotIn(secret, encoded)
+
+    def test_absent_null_invalid_and_bounded_parameters(self):
+        row = self.request()
+        self.assertEqual(row["parameters"]["stop"]["status"], "absent")
+        self.assertEqual(row["extra_body_parameters"]["status"], "absent")
+        self.assertFalse(row["parameters"]["max_tokens"]["present"])
+        row = self.request(stop=None, extra_body=None, max_tokens=True,
+            max_completion_tokens=1 << 80, max_output_tokens=-1, response_format={"type": "private-unknown"})
+        self.assertEqual(row["parameters"]["stop"]["status"], "null")
+        self.assertEqual(row["parameters"]["response_format"], "unavailable")
+        for key in ("max_tokens", "max_completion_tokens", "max_output_tokens"):
+            self.assertTrue(row["parameters"][key]["present"])
+            self.assertIsNone(row["parameters"][key]["value"])
+        for stop in (5, [None], ["x"] * 65, {"private": "x"}):
+            row = self.request(stop=stop)
+            self.assertEqual(row["parameters"]["stop"]["status"], "unavailable")
+            self.assertIsNone(row["parameters"]["stop"]["delimiter_collision"])
+
+    def test_all_two_part_splits_and_character_stream_match_whole_counts(self):
+        text = "synthetic visible\n" + self.pair.open_tag + "\n[emotion=gentle]\nおやすみなさい。\n" + self.pair.close_tag
+        for split in range(len(text) + 1):
+            self.request(stream=True)
+            self.chunk(text[:split])
+            self.chunk(text[split:], finish="stop")
+            row = self.end()
+            self.assertEqual(row["content"], {"status": "observed", "chars": len(text), "parts": 2,
+                "marker_count": 1, "prefix_count": 1, "closing_count": 1})
+            self.assertEqual(row["finish"], "stop")
+        self.request(stream=True)
+        for char in text:
+            self.chunk(char)
+        self.chunk(finish="stop")
+        self.assertEqual(self.end()["content"]["marker_count"], 1)
+
+    def test_duplicate_markers_and_no_cue_body(self):
+        self.request(stream=True)
+        text = self.pair.open_tag + "おやすみなさい。" + self.pair.close_tag
+        for char in text * 2:
+            self.chunk(char)
+        row = self.end()
+        self.assertEqual(row["content"]["marker_count"], 2)
+        self.assertEqual(row["content"]["closing_count"], 2)
+        self.assertIsNone(self.pair.result, "telemetry never certifies a speech candidate")
+
+    def test_pydantic_v2_provider_extras_and_separate_reasoning_channels(self):
+        class Delta:
+            def __init__(self):
+                self.content = None
+                self.__pydantic_extra__ = {"reasoning_content": self_marker, "reasoning": "private-thought"}
+            def model_dump(self, *args, **kwargs):
+                raise AssertionError("must not serialize SDK object")
+        self_marker = self.pair.open_tag
+        self.request(stream=True)
+        p.observe_chat_stream_chunk(self.agent, NS(choices=[NS(delta=Delta(), finish_reason="stop")]))
+        row = self.end()
+        self.assertEqual(row["reasoning_content"]["marker_count"], 1)
+        self.assertEqual(row["reasoning"]["chars"], len("private-thought"))
+        self.assertEqual(row["content"]["marker_count"], 0)
+        self.assertNotIn("private-thought", json.dumps(row))
+
+    def test_unknown_content_never_fabricates_cross_gap_marker(self):
+        self.request(stream=True)
+        self.chunk(self.pair.open_tag[:9])
+        self.chunk({"private": "do not stringify"})
+        self.chunk(self.pair.open_tag[9:])
+        row = self.end()
+        self.assertEqual(row["content"]["status"], "unavailable")
+        self.assertIsNone(row["content"]["marker_count"])
+        self.assertNotIn("do not stringify", json.dumps(row))
+
+    def test_usage_chunks_absent_finish_and_unknown_finish(self):
+        self.request(stream=True)
+        p.observe_chat_stream_chunk(self.agent, {"choices": [], "usage": {"private": "not inspected"}})
+        self.chunk("ordinary text")
+        row = self.end()
+        self.assertEqual(row["chunks"], 2)
+        self.assertEqual(row["empty_choices"], 1)
+        self.assertEqual(row["finish"], "absent")
+        self.assertEqual(row["finish_events"], 0)
+        self.request(stream=True)
+        self.chunk(finish="private-unknown-finish")
+        self.assertEqual(self.end()["finish"], "other")
+
+    def test_malformed_chunk_and_completion_object_are_not_empty_success(self):
+        self.request(stream=True)
+        p.observe_chat_stream_chunk(self.agent, NS(choices="private-unknown"))
+        row = self.end()
+        self.assertEqual(row["content"]["status"], "unavailable")
+        self.assertTrue(row["finish_shape_unavailable"])
+        self.request(stream=True)
+        row = self.end(completed_response=True)
+        self.assertTrue(row["completed_response"])
+        self.assertEqual(row["content"], {"status": "not_streamed"})
