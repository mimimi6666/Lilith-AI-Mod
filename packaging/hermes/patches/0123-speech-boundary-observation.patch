+        data.update(chunks=stream["chunks"], empty_choices=stream["empty_choices"],
+                    finish=stream["finish"], finish_events=stream["finish_events"],
+                    finish_shape_unavailable=stream["finish_shape_unavailable"],
+                    completed_response=completed_response is True, interrupted=interrupted is True)
+        for key in ("content", "reasoning_content", "reasoning"):
+            data[key] = stream[key].snapshot()
+            stream[key].tail = ""
