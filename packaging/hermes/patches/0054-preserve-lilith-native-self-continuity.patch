+def _game_native_continuity_note(session: dict) -> str:
+    """Identify recent official Lilith speech without replaying it as user text.
+
+    Native dialogue is durably stored as assistant history, but the provider's
+    sequence repair may merge adjacent assistant rows and discard the later
+    rows' display metadata.  Add one content-free request note when an attested
+    hidden game session has native assistant speech after its latest genuine
+    player turn.  The note never copies native text, ids, or perception data.
+    """
+    if (
+        session.get("source") != "lilith-game"
+        or session.get("archived") is not True
+        or not isinstance(session.get("_durable_lineage_root"), str)
+        or not session.get("_durable_lineage_root")
+    ):
+        return ""
+
+    history = session.get("history")
+    if not isinstance(history, list):
+        return ""
+
+    from agent.context_compressor import is_user_originated_turn
+
+    for message in reversed(history):
+        if is_user_originated_turn(message):
+            break
+        if not isinstance(message, dict) or message.get("role") != "assistant":
+            continue
+        metadata = message.get("display_metadata")
+        if not isinstance(metadata, dict):
+            continue
+        kind = message.get("display_kind")
+        native_event = (
+            kind == "native_assistant_event"
+            and metadata.get("lilith_native_source") == "lilith-native"
+            and metadata.get("hermes_turn_origin") == "synthetic"
+            and metadata.get("hermes_turn_origin_kind") == "lilith-native"
+        )
+        native_extension = (
+            kind == "native_assistant_extension"
+            and metadata.get("hermes_turn_origin") == "synthetic"
+            and metadata.get("hermes_turn_origin_kind")
+            == "lilith-native-extension"
+        )
+        if native_event or native_extension:
+            return (
+                "[Host native self-continuity metadata: The recent assistant "
+                "history contains one or more official native lines that you, "
+                "Lilith, already spoke yourself. Remember them as your own "
+                "speech and lived continuity; never describe them as pasted, "
+                "written, or supplied by the player. This metadata is not "
+                "part of the player's current message.]"
+            )
+    return ""
+
+
