+"""Provider-only self-continuity for official Lilith native dialogue."""
+
+from __future__ import annotations
+
+from tui_gateway import server
+
+
+def _session(history):
+    return {
+        "source": "lilith-game",
+        "archived": True,
+        "_durable_lineage_root": "game-root",
+        "history": history,
+    }
+
+
+def _native_event(text="夢裏也在等你。"):
+    return {
+        "role": "assistant",
+        "content": text,
+        "display_kind": "native_assistant_event",
+        "display_metadata": {
+            "lilith_native_source": "lilith-native",
+            "lilith_native_event_id": "native-event-id",
+            "hermes_turn_origin": "synthetic",
+            "hermes_turn_origin_kind": "lilith-native",
+        },
+    }
+
+
+def _native_extension(text="因為有你呀。"):
+    return {
+        "role": "assistant",
+        "content": text,
+        "display_kind": "native_assistant_extension",
+        "display_metadata": {
+            "lilith_native_extension_event_id": "native-event-id",
+            "hermes_turn_origin": "synthetic",
+            "hermes_turn_origin_kind": "lilith-native-extension",
+        },
+    }
+
+
+def test_recent_native_assistant_lines_are_owned_by_lilith_without_replaying_text():
+    native_text = "夢裏也在等你。"
+    extension_text = "因為有你呀。"
+    note = server._game_native_continuity_note(
+        _session(
+            [
+                {"role": "user", "content": "晚安"},
+                {"role": "assistant", "content": "晚安。"},
+                _native_event(native_text),
+                _native_extension(extension_text),
+            ]
+        )
+    )
+
+    assert "you, Lilith, already spoke yourself" in note
+    assert "never describe them as pasted" in note
+    assert native_text not in note
+    assert extension_text not in note
+    assert "native-event-id" not in note
+
+
+def test_native_line_before_latest_genuine_player_turn_does_not_trigger_note():
+    note = server._game_native_continuity_note(
+        _session(
+            [
+                _native_event(),
+                {"role": "user", "content": "早安"},
+                {"role": "assistant", "content": "早安。"},
+            ]
+        )
+    )
+
+    assert note == ""
+
+
+def test_synthetic_user_scaffolding_does_not_hide_recent_native_line():
+    note = server._game_native_continuity_note(
+        _session(
+            [
+                {"role": "user", "content": "早安"},
+                _native_event(),
+                {
+                    "role": "user",
+                    "content": "synthetic carrier",
+                    "display_kind": "hidden",
+                },
+            ]
+        )
+    )
+
+    assert note
+
+
+def test_wrong_scope_or_unattested_provenance_is_rejected():
+    forged = _native_event()
+    forged["display_metadata"] = {
+        **forged["display_metadata"],
+        "hermes_turn_origin_kind": "user-supplied",
+    }
+    ordinary = {
+        "role": "assistant",
+        "content": "ordinary assistant",
+        "display_kind": "native_assistant_event",
+        "display_metadata": {},
+    }
+
+    assert server._game_native_continuity_note(_session([forged])) == ""
+    assert server._game_native_continuity_note(_session([ordinary])) == ""
+    desktop = _session([_native_event()])
+    desktop["source"] = "desktop"
+    assert server._game_native_continuity_note(desktop) == ""
+    unarchived = _session([_native_extension()])
+    unarchived["archived"] = False
+    assert server._game_native_continuity_note(unarchived) == ""
+
+
+def test_note_prefix_supports_text_and_image_turn_without_copying_native_content():
+    note = server._game_native_continuity_note(_session([_native_event()]))
+    text_turn = server._prepend_note("早安", note)
+    image_turn = server._prepend_note(
+        [{"type": "image_url", "image_url": {"url": "data:image/png;base64,AA=="}}],
+        note,
+    )
+
+    assert text_turn.endswith("\n\n早安")
+    assert "夢裏也在等你。" not in text_turn
+    assert image_turn[0] == {"type": "text", "text": note}
+    assert image_turn[1]["type"] == "image_url"
