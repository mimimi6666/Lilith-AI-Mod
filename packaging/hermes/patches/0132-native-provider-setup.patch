+def _unique_json(raw):
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value:
+                raise ValueError("duplicate")
+            value[key] = item
+        return value
+    return json.loads(raw, object_pairs_hook=pairs,
+        parse_constant=lambda _value: (_ for _ in ()).throw(ValueError("non-finite")))
