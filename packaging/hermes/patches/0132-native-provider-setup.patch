+def verify_native_provider_setup_commit_receipt(
+    base: NativeConfigReceiptBase,
+    *,
+    previous_config_sha256: str,
+    config_sha256: str,
+    receipt_sha256: str,
+) -> None:
+    """Verify the exact durable provider-setup receipt before generation retire.
+
+    The process-local setup operation binds the operation id; the durable
+    receipt binds the previous/new config digests and all unchanged identity,
+    toolset and approval pins. A key-only edit carries a non-secret operation
+    stamp in config, so it cannot share the previous config digest.
+    """
+    require_native_runtime_parent_authority()
+    previous = _native_receipt_digest(previous_config_sha256, "previous config digest")
+    current = _native_receipt_digest(config_sha256, "config digest")
+    receipt_digest = _native_receipt_digest(receipt_sha256, "raw receipt digest")
+    if previous == current or not hmac.compare_digest(base.config_sha256, previous):
+        raise IdentityPolicyError("native setup receipt digest pair was invalid")
+    snapshot = capture_strict_authority_snapshot()
+    if snapshot is None or not hmac.compare_digest(snapshot.config_sha256, current):
+        raise IdentityPolicyError("native setup live config changed")
+    receipt = next(item for item in snapshot.files
+                   if item.label == "runtime/native-config-receipt.v1.json")
+    if not receipt.existed or receipt.raw is None:
+        raise IdentityPolicyError("native setup durable receipt was missing")
+    if not hmac.compare_digest(hashlib.sha256(receipt.raw).hexdigest(), receipt_digest):
+        raise IdentityPolicyError("native setup durable receipt hash mismatched")
+    value = _decode_native_config_receipt(receipt.raw)
+    expected = {
+        "schema_version": 1,
+        "source": _NATIVE_RECEIPT_SOURCE_PROVIDER_SETUP,
+        "sequence": base.sequence + 1,
+        "canonical_base_sha256": base.canonical_base_sha256,
+        "previous_config_sha256": previous,
+        "config_sha256": current,
+        "identity_fingerprint_sha256": base.identity_fingerprint_sha256,
+        "soul_sha256": base.soul_sha256,
+        "personality_sha256": base.personality_sha256,
+        "approval_mode": base.approval_mode,
+        "enabled_toolsets": list(base.enabled_toolsets),
+    }
+    if value != expected:
+        raise IdentityPolicyError("native setup receipt did not match prepared transition")
+    preflight = preflight_aia_agent_identity(request_overrides={})
+    if (not hmac.compare_digest(preflight.policy.fingerprint, base.identity_fingerprint_sha256)
+            or not hmac.compare_digest(preflight.soul_sha256, base.soul_sha256)
+            or not hmac.compare_digest(preflight.personality_sha256, base.personality_sha256)):
+        raise IdentityPolicyError("native setup receipt identity pins changed")
+
+
 def _authority_parent_matches(snapshot: StrictAuthorityFileSnapshot) -> bool:
     try:
         realpath, device, inode = _strict_authority_parent_identity(
