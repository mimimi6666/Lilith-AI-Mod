+def mutate(action, params, *, finalize, in_use=frozenset()):
+    """Atomic native stores; finalizer prepares the strict digest/receipt gate."""
+    from hermes_cli.config import (load_env, remove_env_value, save_env_value,
+                                   invalidate_env_cache, _CONFIG_LOCK)
+    from hermes_cli.credential_lifecycle import (_run_provider_mutation_transaction,
+        _provider_mutation_paths, _snapshot_path)
+    from hermes_cli.auth import _auth_store_lock
+    from utils import atomic_roundtrip_yaml_update
+    from hermes_cli.config import get_config_path
+    params = validate_params(params, action)
+    provider_id = params["provider_id"]
+    slot = key_env(provider_id)
+    descriptor = SimpleNamespace(slug=provider_id, api_key_env_vars=(slot,))
+    # Same order as the canonical credential lifecycle: auth store first,
+    # config writer second. The lifecycle's inner auth lock is reentrant.
+    with _auth_store_lock(), _CONFIG_LOCK:
+        before = config_sha256()
+        if before != params["expected_config_sha256"]:
+            raise SetupError("stale_config")
+        config = _raw_config()
+        providers = copy.deepcopy(config.get("providers") or {})
+        if type(providers) is not dict:
+            raise SetupError("catalog_unavailable")
+        name = provider_name(provider_id)
+        old = owned_entry(config, provider_id, required=action == "remove")
+        old_key = load_env().get(slot) or ""
+        model_before = copy.deepcopy(config.get("model"))
+        if action == "remove":
+            if provider_id in in_use or normalize_setup_identity((model_before or {}).get("provider")) == provider_id:
+                raise SetupError("entry_in_use")
+            del providers[name]
+            wanted_key = ""
+            changed = True
+        else:
+            if old is None and len(catalog()["entries"]) >= ENTRY_LIMIT:
+                raise SetupError("limit_reached")
+            if old is None and params["key_action"] == "keep":
+                raise SetupError("key_required")
+            if old is not None and old["base_url"] != params["base_url"] and params["key_action"] == "keep":
+                raise SetupError("endpoint_changed_requires_key")
+            wanted_key = (params["api_key"] if params["key_action"] == "replace" else
+                          old_key if params["key_action"] == "keep" else "")
+            if params["auth_mode"] == "api_key" and not wanted_key:
+                raise SetupError("key_required")
+            new = _make_entry(params)
+            comparable = copy.deepcopy(new)
+            if old is not None:
+                comparable["lilith_setup"]["last_operation_id"] = old["lilith_setup"]["last_operation_id"]
+            changed = old != comparable or old_key != wanted_key
+            providers[name] = new
+            if changed and (provider_id in in_use or normalize_setup_identity((model_before or {}).get("provider")) == provider_id):
+                raise SetupError("entry_in_use")
+        receipt = {"schema_version": SCHEMA, "operation_id": params["operation_id"],
+            "provider_id": provider_id, "action": action, "changed": bool(changed),
+            "previous_config_sha256": before, "config_sha256": before}
+        if not changed:
+            return receipt
+
+        def write():
+            if wanted_key:
+                # Remove duplicates first; save_env_value intentionally updates
+                # only the first definition. All steps remain inside rollback.
+                remove_env_value(slot)
+                save_env_value(slot, wanted_key)
+            else:
+                remove_env_value(slot)
+            invalidate_env_cache()
+            if (load_env().get(slot) or "") != wanted_key:
+                raise SetupError("storage_failed")
+            atomic_roundtrip_yaml_update(get_config_path(), "providers", providers)
+            saved = _raw_config()
+            if saved.get("providers") != providers or saved.get("model") != model_before:
+                raise SetupError("storage_failed")
+            after = config_sha256()
+            if after == before:
+                raise SetupError("storage_failed")
+            receipt["config_sha256"] = after
+            finalize(before, after)
+            return receipt
+
+        snapshots = tuple(_snapshot_path(path) for path in _provider_mutation_paths())
+        try:
+            return _run_provider_mutation_transaction(descriptor, write)
+        except BaseException:
+            try:
+                for snapshot in snapshots:
+                    if snapshot.path.exists() != snapshot.existed:
+                        raise RuntimeError()
+                    if snapshot.existed and snapshot.path.read_bytes() != snapshot.payload:
+                        raise RuntimeError()
+                invalidate_env_cache()
+                if (load_env().get(slot) or "") != old_key:
+                    raise RuntimeError()
+            except BaseException:
+                raise SetupError("rollback_unverified") from None
+            # No exception body can cross this boundary: I/O backends can
+            # include a credential or private path in arbitrary error text.
+            raise SetupError("storage_failed") from None
+
