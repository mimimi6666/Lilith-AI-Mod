+def discover_models(params, *, opener=None, monotonic=time.monotonic, cancelled=lambda: False):
+    """One explicit saved-destination metadata GET; never generation/probing LAN."""
+    if (type(params) is not dict or set(params) != {"authority", "provider_id", "expected_config_sha256"}
+            or params.get("authority") != AUTHORITY):
+        raise SetupError("invalid_request")
+    provider_id = params["provider_id"]
+    provider_name(provider_id)
+    if type(params["expected_config_sha256"]) is not str or not _SHA.fullmatch(params["expected_config_sha256"]):
+        raise SetupError("invalid_request")
+    if config_sha256() != params["expected_config_sha256"]:
+        raise SetupError("stale_config")
+    if cancelled():
+        raise SetupError("cancelled")
+    result = {"schema_version": SCHEMA, "provider_id": provider_id,
+              "status": "invalid_response", "models": [], "catalog_only": True}
+    try:
+        route = exact_route(provider_id)
+    except SetupError as error:
+        if error.code == "key_required":
+            result["status"] = "auth_required"
+            return result
+        raise
+    headers = {"Accept": "application/json"}
+    if route["auth_mode"] == "api_key":
+        headers["Authorization"] = "Bearer " + route["api_key"]
+    request = urllib.request.Request(route["base_url"].rstrip("/") + "/models", headers=headers, method="GET")
+    if opener is None:
+        # Explicit local endpoints must not traverse an ambient HTTP proxy;
+        # remote keys must not follow redirects to a different authority.
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect()).open
+    deadline = monotonic() + MODEL_TIMEOUT
+    try:
+        with opener(request, timeout=MODEL_TIMEOUT) as response:
+            if response.getcode() != 200:
+                raise ValueError("status")
+            raw = bytearray()
+            while True:
+                if cancelled():
+                    raise SetupError("cancelled")
+                remaining = deadline - monotonic()
+                if remaining <= 0:
+                    raise TimeoutError()
+                # read1 returns available bytes rather than waiting for a full
+                # 16KiB under a drip-feed response. Narrow the underlying
+                # socket timeout to the remaining overall receive deadline.
+                sock = getattr(getattr(getattr(response, "fp", None), "raw", None), "_sock", None)
+                if sock is not None:
+                    sock.settimeout(remaining)
+                reader = getattr(response, "read1", None)
+                if not callable(reader):
+                    raise ValueError("unbounded reader")
+                chunk = reader(min(16384, MODEL_BODY_LIMIT + 1 - len(raw)))
+                if not chunk:
+                    break
+                raw.extend(chunk)
+                if len(raw) > MODEL_BODY_LIMIT:
+                    raise ValueError("limit")
+            value = _unique_json(raw.decode("utf-8"))
+            if type(value) is not dict or type(value.get("data")) is not list or len(value["data"]) > MODEL_LIMIT:
+                raise ValueError("models")
+            ids = []
+            for item in value["data"]:
+                if type(item) is not dict:
+                    raise ValueError("model")
+                item_id = model_id(item.get("id"))
+                if item_id in ids:
+                    raise ValueError("duplicate model")
+                ids.append(item_id)
+            result.update(status="ready" if ids else "empty", models=ids)
+    except SetupError as error:
+        if error.code == "cancelled":
+            raise
+        result["status"] = "invalid_response"
+    except urllib.error.HTTPError as error:
+        code = error.code
+        error.close()
+        result["status"] = ("auth_required" if code in {401, 403} else
+            "request_rejected" if 300 <= code < 500 else "service_failed")
+    except (TimeoutError, socket.timeout):
+        result["status"] = "timeout"
+    except urllib.error.URLError as error:
+        result["status"] = "timeout" if isinstance(error.reason, (TimeoutError, socket.timeout)) else "unreachable"
+    except (OSError, http.client.HTTPException):
+        result["status"] = "unreachable"
+    except Exception:
+        result["status"] = "invalid_response"
+    # A slow catalog must not be reported for a newly edited destination.
+    if config_sha256() != params["expected_config_sha256"]:
+        raise SetupError("stale_config")
+    if cancelled():
+        raise SetupError("cancelled")
+    return result
