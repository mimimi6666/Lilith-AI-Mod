+"""Factory-attested Chat Completions bindings for owned custom setup entries.
+
+This attests the native SDK, selected route and final request seam, not a
+provider's model capacity or compliance with a requested output limit. It
+does not change information strategies, approve tools, or discover models.
+Only the native setup factories call registration; no RPC accepts a proof.
+"""
+from dataclasses import dataclass
+import hashlib
+import json
+from threading import RLock
+from weakref import ref
+
+from agent.usage_budget import BudgetError
+
+
+@dataclass(frozen=True)
+class _FactoryProof:
+    client: object
+    provider_id: str
+    model: str
+    state_digest: bytes
+    transport_fingerprint: tuple
+
+
+_PROOFS = {}
+_LOCK = RLock()
+
+
+def _state(client):
+    import httpx
+    import openai
+    from agent.usage_budget_official_routes import reviewed_http_transport_state
+
+    if type(client) not in (openai.OpenAI, openai.AsyncOpenAI):
+        raise BudgetError("managed_custom_factory_unverified")
+    http = getattr(client, "_client", None)
+    if (type(http) not in (httpx.Client, httpx.AsyncClient)
+            or getattr(http, "_trust_env", None) is not False
+            or http.follow_redirects is not False
+            or http.auth is not None or bool(http.cookies)
+            or any(http.event_hooks.values())
+            or type(client.max_retries) is not int or client.max_retries != 0
+            or reviewed_http_transport_state(client) is None
+            or type(client.api_key) is not str
+            or client._custom_headers or client.default_query
+            or client.organization or client.project):
+        raise BudgetError("managed_custom_factory_unverified")
+    # Hash the additional mutable auth state not included in the existing
+    # native transport fingerprint. No credential/header value is retained.
+    values = [str(client.base_url), client.api_key, sorted(http.headers.multi_items())]
+    return hashlib.sha256(json.dumps(values, ensure_ascii=True,
+                                    separators=(",", ":")).encode()).digest()
+
+
+def register_managed_compatible_client(client, provider_id, model):
+    """Called after actual SDK construction from the native owned setup route."""
+    from hermes_cli.provider_setup import exact_route, is_setup_identity
+    from agent.usage_budget_dispatch import WireCapability, WireRoute
+    from agent.usage_budget_native_dispatch import NativeDispatchBinding, register_native_dispatch_binding, _client_fingerprint
+    from agent.usage_budget_official_routes import estimate_final_input
+    from agent.usage_budget_usage import read_usage
+
+    if not is_setup_identity(provider_id):
+        raise BudgetError("managed_custom_factory_unverified")
+    route = exact_route(provider_id, expected_base_url=str(getattr(client, "base_url", "")))
+    if (model != route["model"] or route["api_mode"] != "chat_completions"
+            or getattr(client, "api_key", None) != route["api_key"]):
+        raise BudgetError("managed_custom_factory_unverified")
+    digest = _state(client)
+    binding = NativeDispatchBinding(
+        WireCapability("chat_max_tokens", evidence_id="managed-openai-compatible-factory-v1",
+                       output_cap_verified=False, all_output_counted=False,
+                       sdk_max_retries=0, final_wire_verified=True,
+                       route=WireRoute(provider_id, model, "managed-chat-completions")),
+        estimate_final_input, lambda value: read_usage(value, "chat_max_tokens"),
+        output_control="requested")
+    identity = id(client)
+    with _LOCK:
+        previous = _PROOFS.get(identity)
+        if previous is not None and previous.client() is client and (
+                previous.provider_id != provider_id or previous.model != model
+                or previous.state_digest != digest):
+            raise BudgetError("managed_custom_route_changed")
+    def retire(weak):
+        with _LOCK:
+            previous = _PROOFS.get(identity)
+            if previous is not None and previous.client is weak:
+                _PROOFS.pop(identity, None)
+    proof = _FactoryProof(ref(client, retire), provider_id, model, digest, _client_fingerprint(client))
+    register_native_dispatch_binding(client, binding)
+    with _LOCK:
+        _PROOFS[identity] = proof
+    return binding
+
+
+def get_verified_managed_route(client, model):
+    """Return immutable provider/model metadata only for a still-exact factory client.
+
+    Async conversion uses this proof, never a hostname or caller-supplied label.
+    The new SDK instance must be independently registered by its own factory.
+    """
+    from agent.usage_budget_native_dispatch import _client_fingerprint
+    with _LOCK:
+        proof = _PROOFS.get(id(client))
+    if proof is None or proof.client() is not client:
+        return None
+    if (model != proof.model or _state(client) != proof.state_digest
+            or _client_fingerprint(client) != proof.transport_fingerprint):
+        raise BudgetError("managed_custom_route_changed")
+    return (proof.provider_id, proof.model)
+
+
+def validate_managed_compatible_client(client, request, wire_format, model_id=None):
+    """Extra exact-route check at the existing guarded native dispatch seam."""
+    with _LOCK:
+        proof = _PROOFS.get(id(client))
+    if proof is None or proof.client() is not client:
+        return
+    if (_state(client) != proof.state_digest
+            or wire_format != "chat_max_tokens"
+            or request.get("model") != proof.model
+            or (model_id is not None and model_id != proof.model)
+            or request.get("extra_headers") or request.get("extra_query")):
+        raise BudgetError("managed_custom_route_changed")
