+    return {"name": provider_name(params["provider_id"]), "base_url": params["base_url"],
+        "default_model": params["model_id"], "models": {params["model_id"]: {}},
+        "api_mode": "chat_completions", "key_env": key_env(params["provider_id"]),
+        "auth_mode": params["auth_mode"], "discover_models": False,
+        "lilith_setup": {"schema_version": SCHEMA, "label": params["label"],
+            "preset_id": params["preset_id"], "kind": params["kind"],
+            "last_operation_id": params["operation_id"]}}
