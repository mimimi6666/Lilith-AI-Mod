+            "preset_id": marker["preset_id"], "kind": marker["kind"],
+            "base_url": entry["base_url"], "model_id": entry["default_model"],
+            "auth_mode": entry["auth_mode"], "key_present": bool(env.get(key_env(provider_id))),
+            "is_default": normalize_setup_identity(selected) == provider_id})
