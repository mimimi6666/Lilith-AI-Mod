diff --git a/tui_gateway/methods_provider_setup.py b/tui_gateway/methods_provider_setup.py
new file mode 100644
--- /dev/null
+++ b/tui_gateway/methods_provider_setup.py
@@ -0,0 +1,156 @@
+"""Authenticated human setup RPCs, isolated from model/tool command dispatch."""
+from __future__ import annotations
+
+import secrets
+import threading
+from hermes_cli import provider_setup as setup
+
+
+def register(server):
+    # Capture launch profile, not a client path or session profile override.
+    profile_root = server._hermes_home
+    stdio = server._stdio_transport
+    lock = threading.RLock()
+    pending = None
+
+    def fail(rid, code):
+        return server._ok(rid, {"schema_version": 1, "code": "setup." + code})
+
+    def quarantine():
+        from agent.identity_policy import latch_native_authority_quarantine
+        latch_native_authority_quarantine("native provider setup recovery was not verified",
+            drifted_labels=("config.yaml", "runtime/native-config-receipt.v1.json"))
+
+    def _in_use():
+        result = set()
+        for session in server._sessions.values():
+            agent = session.get("agent")
+            for value in (session.get("provider"), getattr(agent, "provider", None),
+                          getattr(agent, "requested_provider", None),
+                          (getattr(agent, "_session_init_model_config", None) or {}).get("provider")):
+                normalized = setup.normalize_setup_identity(value)
+                if normalized:
+                    result.add(normalized)
+        return frozenset(result)
+
+    def _mutate(params, action):
+        nonlocal pending
+        from agent import identity_policy as identity
+        from tools.approval import _capture_native_approval_policy
+        params = setup.validate_params(params, action)
+        if pending is not None or identity.native_authority_dispatch_block_state() is not None:
+            raise setup.SetupError("busy")
+        before = identity.prepare_host_config_digest_rotation()
+        if before != params["expected_config_sha256"]:
+            raise setup.SetupError("stale_config")
+        policy_mode, toolsets = _capture_native_approval_policy()
+        base = identity.capture_native_config_receipt_base(before,
+            approval_mode=policy_mode, enabled_toolsets=toolsets)
+        nonce = secrets.token_hex(32)
+        identity.begin_native_authority_commit_pending({"session_key": "provider.setup",
+            "commit_nonce": nonce, "source": setup.SOURCE})
+        rotated = False
+        try:
+            with server._paused_live_strict_sessions_for_native_model(before) as bindings:
+                def finalize(previous, after):
+                    nonlocal pending, rotated
+                    current = identity.commit_host_config_digest_rotation(previous)
+                    rotated = True
+                    if current != after:
+                        raise setup.SetupError("storage_failed")
+                    prepared = server._PreparedNativeModelDefaultCommit(
+                        commit_nonce=nonce, previous_config_sha256=previous,
+                        config_sha256=after, receipt_base=base, bindings=bindings)
+                    identity.update_native_authority_commit_pending(nonce, {
+                        "previous_config_sha256": previous, "config_sha256": after})
+                    pending = (params["operation_id"], prepared)
+                result = setup.mutate(action, params, finalize=finalize, in_use=_in_use())
+            if not result["changed"]:
+                identity.clear_native_authority_commit_pending(nonce)
+            return result
+        except BaseException as error:
+            pending = None
+            if rotated or isinstance(error, setup.SetupError) and error.code == "rollback_unverified":
+                quarantine()
+            try:
+                identity.clear_native_authority_commit_pending(nonce)
+            except BaseException:
+                quarantine()
+                raise setup.SetupError("rollback_unverified") from None
+            if isinstance(error, identity.NativeAuthorityTransitionBusyError):
+                raise setup.SetupError("busy") from None
+            if isinstance(error, setup.SetupError):
+                raise
+            raise setup.SetupError("storage_failed") from None
+
+    def _commit(params):
+        nonlocal pending
+        from agent import identity_policy as identity
+        from tools.approval import _capture_native_approval_policy
+        if pending is None:
+            raise setup.SetupError("receipt_required")
+        try:
+            if type(params) is not dict or set(params) != {
+                "authority", "operation_id", "previous_config_sha256", "config_sha256", "receipt_sha256"}:
+                raise setup.SetupError("invalid_request")
+            operation_id, prepared = pending
+            if (params["authority"] != setup.AUTHORITY or params["operation_id"] != operation_id
+                    or params["previous_config_sha256"] != prepared.previous_config_sha256
+                    or params["config_sha256"] != prepared.config_sha256):
+                raise setup.SetupError("receipt_invalid")
+            identity.require_native_runtime_parent_authority()
+            mode, toolsets = _capture_native_approval_policy()
+            if mode != prepared.receipt_base.approval_mode or tuple(toolsets) != prepared.receipt_base.enabled_toolsets:
+                raise setup.SetupError("receipt_invalid")
+            identity.verify_native_provider_setup_commit_receipt(prepared.receipt_base,
+                previous_config_sha256=prepared.previous_config_sha256,
+                config_sha256=prepared.config_sha256, receipt_sha256=params["receipt_sha256"])
+            server._rebind_prepared_native_model_sessions(prepared)
+            identity.clear_native_authority_commit_pending(prepared.commit_nonce)
+            pending = None
+            return {"schema_version": 1, "operation_id": operation_id, "committed": True}
+        except BaseException:
+            quarantine()
+            raise setup.SetupError("receipt_invalid") from None
+
+    def invoke(rid, params, name):
+        from agent import identity_policy as identity
+        from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+        try:
+            transport = server.current_transport()
+            if (not (transport is None or transport is stdio or
+                     getattr(transport, "lilith_runtime_attested", False) is True)
+                    or getattr(transport, "_closed", False)
+                    or identity.identity_lock_required_by_host() is not True):
+                return fail(rid, "unauthorized")
+            identity.require_native_runtime_parent_authority()
+            if identity.native_authority_quarantine_state() is not None:
+                return fail(rid, "rollback_unverified")
+            if type(params) is not dict or params.get("authority") != setup.AUTHORITY:
+                return fail(rid, "unauthorized")
+            token = set_hermes_home_override(profile_root)
+            try:
+                with lock:
+                    if name == "catalog":
+                        if set(params) != {"authority"}:
+                            raise setup.SetupError("invalid_request")
+                        # Phase-one readback is allowed; no resolver/network.
+                        return server._ok(rid, setup.catalog())
+                    if name == "commit":
+                        return server._ok(rid, _commit(params))
+                    if identity.native_authority_dispatch_block_state() is not None:
+                        raise setup.SetupError("busy")
+                    if name == "models":
+                        return server._ok(rid, setup.discover_models(params,
+                            cancelled=lambda: getattr(transport, "_closed", False) is True))
+                    return server._ok(rid, _mutate(params, name))
+            finally:
+                reset_hermes_home_override(token)
+        except setup.SetupError as error:
+            return fail(rid, error.code)
+        except Exception:
+            return fail(rid, "catalog_unavailable" if name == "catalog" else "storage_failed")
+
+    for name in ("catalog", "models", "save", "remove", "commit"):
+        server._methods["provider.setup." + name] = (
+            lambda rid, params, name=name: invoke(rid, params, name))
