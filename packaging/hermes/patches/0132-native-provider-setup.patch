+    @contextlib.contextmanager
+    def gateway(self):
+        from tui_gateway import server, methods_provider_setup
+        from agent import identity_policy as identity
+        import tools.approval
+        state = {"pending": None, "quarantined": None, "verified": [], "rebound": []}
+        base = SimpleNamespace(approval_mode="manual", enabled_toolsets=("hermes-cli",))
+        @contextlib.contextmanager
+        def idle(_digest):
+            yield ()
+        def begin(value):
+            if state["pending"] is not None:
+                raise identity.NativeAuthorityTransitionBusyError("synthetic busy")
+            state["pending"] = value
+        def clear(_nonce):
+            state["pending"] = None
+        with contextlib.ExitStack() as stack:
+            replacements = {
+                "identity_lock_required_by_host": lambda: True,
+                "require_native_runtime_parent_authority": lambda: None,
+                "native_authority_quarantine_state": lambda: state["quarantined"],
+                "native_authority_dispatch_block_state": lambda: state["pending"],
+                "prepare_host_config_digest_rotation": setup.config_sha256,
+                "capture_native_config_receipt_base": lambda *a, **k: base,
+                "begin_native_authority_commit_pending": begin,
+                "clear_native_authority_commit_pending": clear,
+                "update_native_authority_commit_pending": lambda *a: None,
+                "commit_host_config_digest_rotation": lambda _previous: setup.config_sha256(),
+                "verify_native_provider_setup_commit_receipt": lambda *a, **k: state["verified"].append(k),
+                "latch_native_authority_quarantine": lambda *a, **k: state.update(quarantined={"synthetic": True}),
+            }
+            for name, value in replacements.items():
+                stack.enter_context(patch.object(identity, name, value))
+            stack.enter_context(patch.object(tools.approval, "_capture_native_approval_policy", return_value=("manual", ["hermes-cli"])))
+            stack.enter_context(patch.object(server, "_hermes_home", self.home))
+            stack.enter_context(patch.object(server, "current_transport", return_value=SimpleNamespace(lilith_runtime_attested=True, _closed=False)))
+            stack.enter_context(patch.object(server, "_sessions", {}))
+            stack.enter_context(patch.object(server, "_paused_live_strict_sessions_for_native_model", idle))
+            stack.enter_context(patch.object(server, "_rebind_prepared_native_model_sessions", lambda value: state["rebound"].append(value)))
+            methods_provider_setup.register(server)
+            def rpc(name, params):
+                return server._methods["provider.setup." + name](1, params)["result"]
+            yield rpc, state, server
+
