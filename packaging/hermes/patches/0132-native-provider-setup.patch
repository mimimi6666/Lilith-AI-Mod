diff --git a/hermes_cli/provider_setup.py b/hermes_cli/provider_setup.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/provider_setup.py
@@ -0,0 +1,584 @@
+"""Human-owned, exact-route custom endpoint setup. No agent tool or inference.
+
+Only named entries bearing this module's versioned marker are mutable here.
+Secrets stay in Hermes' canonical .env; the metadata has no credential value.
+The gateway supplies strict-profile/CAS/idle/pending-receipt authority around
+mutation. The existing credential lifecycle owns multi-store rollback.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import http.client
+import ipaddress
+import json
+import re
+import socket
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from types import SimpleNamespace
+
+AUTHORITY = "lilith-provider-setup-v1"
+SOURCE = "hermes.provider.setup"
+SCHEMA = 1
+ENTRY_LIMIT = 128
+MODEL_LIMIT = 256
+MODEL_BODY_LIMIT = 512 * 1024
+MODEL_TIMEOUT = 8.0
+ERROR_CODES = frozenset({
+    "invalid_request", "unauthorized", "stale_config", "busy", "not_found",
+    "limit_reached", "entry_in_use", "key_required", "endpoint_changed_requires_key",
+    "storage_failed", "rollback_unverified", "receipt_required", "receipt_invalid",
+    "catalog_unavailable", "cancelled",
+})
+MODEL_STATUSES = frozenset({
+    "ready", "empty", "auth_required", "request_rejected", "service_failed",
+    "timeout", "unreachable", "invalid_response",
+})
+PRESETS = (
+    {"id": "siliconflow", "label": "SiliconFlow / 硅基流動", "kind": "cloud",
+     "base_url": "https://api.siliconflow.cn/v1", "auth_mode": "api_key"},
+    {"id": "openai-compatible", "label": "OpenAI-compatible cloud", "kind": "cloud",
+     "base_url": "", "auth_mode": "api_key"},
+    {"id": "ollama", "label": "Ollama", "kind": "local",
+     "base_url": "http://127.0.0.1:11434/v1", "auth_mode": "none"},
+    {"id": "lmstudio", "label": "LM Studio", "kind": "local",
+     "base_url": "http://127.0.0.1:1234/v1", "auth_mode": "none"},
+    {"id": "local-openai", "label": "Local OpenAI-compatible service", "kind": "local",
+     "base_url": "http://127.0.0.1:8080/v1", "auth_mode": "none"},
+)
+_PRESET_BY_ID = {p["id"]: p for p in PRESETS}
+_ID = re.compile(r"custom:[0-9a-f]{32}\Z")
+_OP = re.compile(r"[A-Za-z0-9._-]{1,128}\Z")
+_SHA = re.compile(r"[0-9a-f]{64}\Z")
+_MODEL = re.compile(r"[A-Za-z0-9_./:@+][A-Za-z0-9_./:@+\-]{0,255}\Z")
+_SAVE_KEYS = frozenset({"authority", "expected_config_sha256", "operation_id",
+    "provider_id", "label", "preset_id", "kind", "base_url", "model_id",
+    "auth_mode", "key_action", "api_key"})
+_REMOVE_KEYS = frozenset({"authority", "expected_config_sha256", "operation_id", "provider_id"})
+
+
+class SetupError(ValueError):
+    def __init__(self, code):
+        self.code = code if code in ERROR_CODES else "storage_failed"
+        super().__init__("setup." + self.code)
+
+
+def _text(value, *, maximum, byte_limit=None, empty=False):
+    if (type(value) is not str or (not value and not empty) or len(value) > maximum
+            or value != value.strip() or any(ord(c) < 32 or ord(c) == 127 for c in value)):
+        raise SetupError("invalid_request")
+    try:
+        if len(value.encode("utf-8")) > (byte_limit or maximum * 4):
+            raise SetupError("invalid_request")
+    except UnicodeError:
+        raise SetupError("invalid_request") from None
+    return value
+
+
+def provider_name(provider_id):
+    if type(provider_id) is not str or not _ID.fullmatch(provider_id):
+        raise SetupError("invalid_request")
+    return provider_id[7:]
+
+
+def model_id(value):
+    if type(value) is not str or not _MODEL.fullmatch(value):
+        raise SetupError("invalid_request")
+    return value
+
+
+def key_env(provider_id):
+    return "HERMES_CUSTOM_" + provider_name(provider_id).upper() + "_API_KEY"
+
+
+def canonical_url(value, kind):
+    value = _text(value, maximum=2048, byte_limit=8192)
+    if "\\" in value or any(c in value for c in "{}"):
+        raise SetupError("invalid_request")
+    try:
+        url = urllib.parse.urlsplit(value)
+        host, port = url.hostname, url.port
+    except ValueError:
+        raise SetupError("invalid_request") from None
+    if (not host or url.username is not None or url.password is not None
+            or url.query or url.fragment or "?" in value or "#" in value
+            or url.scheme not in {"http", "https"} or (port is not None and not 1 <= port <= 65535)):
+        raise SetupError("invalid_request")
+    loopback = host.lower() in {"localhost", "127.0.0.1", "::1"}
+    if kind == "local":
+        if not loopback:
+            raise SetupError("invalid_request")
+    elif kind == "cloud":
+        if url.scheme != "https" or loopback:
+            raise SetupError("invalid_request")
+        try:
+            address = ipaddress.ip_address(host)
+        except ValueError:
+            address = None
+        if address is not None and not address.is_global:
+            raise SetupError("invalid_request")
+    else:
+        raise SetupError("invalid_request")
+    # No destination expansion, host guessing, URL templates, or credentials.
+    if any(c.isspace() for c in host) or "%" in host:
+        raise SetupError("invalid_request")
+    try:
+        host.encode("ascii")
+    except UnicodeError:
+        raise SetupError("invalid_request") from None
+    # Preserve the authenticated UI value byte-for-byte. Runtime post-read
+    # compares the actual saved entry with the accepted request, not a silent
+    # rewrite of case, port notation, or a trailing slash.
+    return value
+
+
+def _endpoint_identity(value):
+    url = urllib.parse.urlsplit(str(value))
+    effective_port = url.port if url.port is not None else {"http": 80, "https": 443}.get(url.scheme.lower())
+    return (url.scheme.lower(), (url.hostname or "").lower(), effective_port,
+            url.path.rstrip("/"), url.query, url.fragment, url.username, url.password)
+
+
+def validate_params(params, action):
+    expected = _SAVE_KEYS if action == "save" else _REMOVE_KEYS
+    if type(params) is not dict or set(params) != expected:
+        raise SetupError("invalid_request")
+    if params["authority"] != AUTHORITY:
+        raise SetupError("unauthorized")
+    if (type(params["expected_config_sha256"]) is not str
+            or not _SHA.fullmatch(params["expected_config_sha256"])
+            or type(params["operation_id"]) is not str or not _OP.fullmatch(params["operation_id"])):
+        raise SetupError("invalid_request")
+    provider_name(params["provider_id"])
+    result = dict(params)
+    if action == "remove":
+        return result
+    _text(params["label"], maximum=128, byte_limit=512)
+    model_id(params["model_id"])
+    preset = _PRESET_BY_ID.get(params["preset_id"])
+    if not preset or params["kind"] != preset["kind"]:
+        raise SetupError("invalid_request")
+    result["base_url"] = canonical_url(params["base_url"], params["kind"])
+    if params["auth_mode"] not in {"api_key", "none"} or params["key_action"] not in {"keep", "replace", "clear"}:
+        raise SetupError("invalid_request")
+    if params["auth_mode"] == "none" and (params["kind"] != "local" or params["key_action"] != "clear"):
+        raise SetupError("invalid_request")
+    if params["auth_mode"] == "api_key" and params["key_action"] == "clear":
+        raise SetupError("invalid_request")
+    secret = params["api_key"]
+    if type(secret) is not str or len(secret) > 16384:
+        raise SetupError("invalid_request")
+    if params["key_action"] == "replace":
+        if not secret or any(ord(c) < 33 or ord(c) > 126 for c in secret):
+            raise SetupError("invalid_request")
+    elif secret:
+        raise SetupError("invalid_request")
+    return result
+
+
+def _raw_config():
+    from hermes_cli.config import read_raw_config
+    value = read_raw_config()
+    if type(value) is not dict:
+        raise SetupError("catalog_unavailable")
+    return value
+
+
+def config_sha256():
+    from hermes_cli.config import get_config_path
+    return hashlib.sha256(get_config_path().read_bytes()).hexdigest()
+
+
+def owned_entry(config, provider_id, *, required=True):
+    name = provider_name(provider_id)
+    providers = config.get("providers") or {}
+    entry = providers.get(name) if type(providers) is dict else None
+    if entry is None and not required:
+        return None
+    if type(entry) is not dict or type(entry.get("lilith_setup")) is not dict:
+        raise SetupError("not_found")
+    marker = entry["lilith_setup"]
+    if (set(marker) != {"schema_version", "label", "preset_id", "kind", "last_operation_id"}
+            or type(marker["schema_version"]) is not int or marker["schema_version"] != SCHEMA
+            or type(marker["last_operation_id"]) is not str or not _OP.fullmatch(marker["last_operation_id"])):
+        raise SetupError("catalog_unavailable")
+    # A mutable entry cannot acquire arbitrary headers, inline credentials,
+    # proxy/TLS overrides, response API modes, or foreign credential slots.
+    if set(entry) != {"name", "base_url", "default_model", "models", "api_mode",
+                      "key_env", "auth_mode", "discover_models", "lilith_setup"}:
+        raise SetupError("catalog_unavailable")
+    synthetic = {"authority": AUTHORITY, "expected_config_sha256": "0" * 64,
+        "operation_id": marker["last_operation_id"], "provider_id": provider_id,
+        "label": marker["label"], "preset_id": marker["preset_id"], "kind": marker["kind"],
+        "base_url": entry["base_url"], "model_id": entry["default_model"],
+        "auth_mode": entry["auth_mode"], "key_action": "clear" if entry["auth_mode"] == "none" else "keep", "api_key": ""}
+    validate_params(synthetic, "save")
+    if (entry["name"] != name or entry["key_env"] != key_env(provider_id)
+            or entry["api_mode"] != "chat_completions" or entry["discover_models"] is not False
+            or entry["models"] != {entry["default_model"]: {}}
+            or canonical_url(entry["base_url"], marker["kind"]) != entry["base_url"]):
+        raise SetupError("catalog_unavailable")
+    return entry
+
+
+def exact_route(provider_id, *, expected_base_url=None):
+    """Return only this saved entry's key; never a pool or ambient credential."""
+    from hermes_cli.config import load_env
+    entry = owned_entry(_raw_config(), provider_id)
+    base_url = entry["base_url"]
+    if expected_base_url is not None and _endpoint_identity(expected_base_url) != _endpoint_identity(base_url):
+        raise SetupError("stale_config")
+    secret = ""
+    if entry["auth_mode"] == "api_key":
+        secret = load_env().get(key_env(provider_id)) or ""
+        if not secret:
+            raise SetupError("key_required")
+    return {"provider": provider_id, "provider_id": provider_id, "base_url": base_url,
+        "api_key": secret, "auth_mode": entry["auth_mode"], "api_mode": "chat_completions",
+        "model": entry["default_model"], "source": "provider_setup:" + provider_id}
+
+
+def is_setup_identity(value):
+    """True only for an existing marked entry, never by hex-shaped name alone.
+
+    Existing manually declared hex names keep their legacy provider behavior.
+    An absent reserved identity fails closed instead of borrowing an ambient
+    route after deletion; a present but malformed ownership marker also fails.
+    """
+    if type(value) is not str or not _ID.fullmatch(value):
+        return False
+    config = _raw_config()
+    name = value[7:]
+    providers = config.get("providers") or {}
+    if type(providers) is not dict:
+        raise SetupError("catalog_unavailable")
+    if name in providers:
+        entry = providers[name]
+        if type(entry) is not dict:
+            raise SetupError("catalog_unavailable")
+        if "lilith_setup" not in entry:
+            return False
+        owned_entry(config, value)
+        return True
+    # Preserve legacy display-name aliases and the older list representation.
+    for key, entry in providers.items():
+        if type(entry) is dict and str(entry.get("name") or key).strip().lower() in {name, value}:
+            if "lilith_setup" in entry:
+                raise SetupError("catalog_unavailable")
+            return False
