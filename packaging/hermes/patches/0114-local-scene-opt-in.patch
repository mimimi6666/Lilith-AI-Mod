@@ -0,0 +1,60 @@
+"""Explicit native UI enable/disable, synthetic profile only."""
+import copy
+import pytest
+import yaml
+from hermes_cli import tools_config as tc
+from tools.lilith_scene import host
+from tests.tui_gateway.test_native_setup_selection import native_setup_env, _set
+from tests.tui_gateway.test_tools_policy_rpc import _clean_gateway_sessions, _home, _write_config
+import tui_gateway.server as server
+
+
+def test_scene_has_one_disclosed_default_off_desktop_catalog_entry():
+    rows = [row for row in tc._get_effective_configurable_toolsets() if row[0] == host.TOOL]
+    assert len(rows) == 1
+    assert "前景畫面" in rows[0][2] and "主動接話" in rows[0][2] and "不上傳圖片" in rows[0][2]
+    assert host.TOOL in tc._DEFAULT_OFF_TOOLSETS
+    assert tc._toolset_allowed_for_platform(host.TOOL, "cli")
+    for platform in ("telegram", "discord", "cron", "api"):
+        assert not tc._toolset_allowed_for_platform(host.TOOL, platform)
+    for config in ({}, {"platform_toolsets": {"cli": []}}, {"platform_toolsets": {"cli": ["hermes-cli"]}}):
+        assert host.TOOL not in tc._get_platform_tools(config, "cli", include_default_mcp_servers=False)
+
+
+def test_native_settings_enables_and_disables_scene_without_other_policy_change(monkeypatch):
+    # The existing native checklist deliberately clears the unrelated no_mcp
+    # sentinel on any save; test this capability with ordinary native settings.
+    config = {"platform_toolsets": {"cli": ["memory"]},
+              "approvals": {"mode": "manual", "timeout": 123}, "model": {"provider": "test", "default": "fake"}}
+    before = copy.deepcopy(config)
+    _write_config(config)
+    monkeypatch.setattr(tc, "_run_post_setup", lambda *_: pytest.fail("no installers or capture"))
+    assert not host.explicit_opt_in()
+    response = _set({"enabled_toolsets": ["memory", host.TOOL], "approval_mode": "manual"})
+    assert "error" not in response, response
+    assert host.TOOL in response["result"]["enabled_toolsets"]
+    assert host.explicit_opt_in()
+    saved = yaml.safe_load((_home() / "config.yaml").read_text(encoding="utf-8"))
+    assert saved["model"] == before["model"] and saved["approvals"] == before["approvals"]
+    response = _set({"enabled_toolsets": ["memory"], "approval_mode": "manual"})
+    assert "error" not in response, response
+    assert not host.explicit_opt_in()
+    saved = yaml.safe_load((_home() / "config.yaml").read_text(encoding="utf-8"))
+    assert saved["platform_toolsets"] == before["platform_toolsets"]
+    assert saved["model"] == before["model"] and saved["approvals"] == before["approvals"]
+
+
+@pytest.mark.parametrize("ready", [True, False])
+def test_real_catalog_row_reports_dependency_readiness_without_capturing(monkeypatch, ready):
+    from tools.registry import registry
+    import tools.lilith_local_scene  # native discovery registration
+    rows = [row for row in tc.CONFIGURABLE_TOOLSETS if row[0] == host.TOOL]
+    monkeypatch.setattr(tc, "_get_effective_configurable_toolsets", lambda: rows)
+    monkeypatch.setattr(registry._tools[host.TOOL], "check_fn", lambda: ready)
+    _write_config({"platform_toolsets": {"cli": []}, "approvals": {"mode": "manual"}})
+    result = server._methods["tools.catalog"]("catalog", {})
+    assert "error" not in result, result
+    row, = result["result"]["toolsets"]
+    assert row["name"] == host.TOOL and row["enabled"] is False
+    assert row["readiness"] == ("ready" if ready else "needs_setup")
+    assert row["tools"] == ([host.TOOL] if ready else [])
