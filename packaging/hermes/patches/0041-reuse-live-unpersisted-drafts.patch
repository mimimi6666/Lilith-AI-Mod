+def _find_live_unpersisted_draft_by_key(
+    session_key: str, *, profile_home: Path | None
+) -> tuple[str, dict] | None:
+    """Return one exact clean draft that has not reached ``state.db`` yet.
+
+    Ordinary ``session.create`` drafts intentionally stay ephemeral until their
+    first prompt, but a client may switch away and then resume the returned
+    ``stored_session_id`` while that draft is still live.  This predicate is
+    deliberately narrower than the normal live-session fast path: callers may
+    use it only after the exact DB lookup missed, and only for a same-profile,
+    untouched draft.  Durable/archived game sessions therefore continue through
+    the DB-backed lineage-attestation path.
+
+    The caller must hold ``_session_resume_lock`` so ``session.close`` cannot
+    retire the matching record between this check and payload construction.
+    """
+    # Do not use _find_live_session_by_key here: that general resolver prefers
+    # agent.session_id and may therefore match a rotated or synthetic identity.
+    # This recovery contract accepts only the raw stored key returned by the
+    # ordinary create response.
+    live = None
+    for sid, candidate in list(_sessions.items()):
+        if candidate.get("_finalized"):
+            continue
+        if str(candidate.get("session_key") or "") == session_key:
+            live = (sid, candidate)
+            break
+    if live is None:
+        return None
+    _sid, session = live
+
+    expected_home = str(profile_home or "").strip()
+    actual_home = str(session.get("profile_home") or "").strip()
+    if bool(expected_home) != bool(actual_home):
+        return None
+    if expected_home:
+        try:
+            expected_home = os.path.normcase(os.path.abspath(expected_home))
+            actual_home = os.path.normcase(os.path.abspath(actual_home))
+        except Exception:
+            pass
+    if expected_home != actual_home:
+        return None
+
+    history_lock = session.get("history_lock")
+    if history_lock is None:
+        return None
+    with history_lock:
+        if (
+            session.get("archived") is True
+            or session.get("_durable_lineage_root") is not None
+            or session.get("resume_session_id") is not None
+            or session.get("parent_session_id") is not None
+            or session.get("active_session_lease") is not None
+            or session.get("history_version", 0) != 0
+            or bool(session.get("history"))
+            or bool(session.get("display_history_prefix"))
+            or bool(session.get("running"))
+            or session.get("inflight_turn") is not None
+            or session.get("queued_prompt") is not None
+            or bool(session.get("queued_prompts"))
+            or isinstance(session.get(_COMPUTE_HOST_TURN_UNCERTAIN), dict)
+        ):
+            return None
+    return live
+
