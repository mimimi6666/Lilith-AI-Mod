+def test_session_resume_does_not_reuse_live_empty_draft_across_profiles(
+    gateway_db, monkeypatch, tmp_path
+):
+    db, _ = gateway_db
+    created = server._methods["session.create"]("create-launch-profile", {})
+    assert "error" not in created
+    stored_id = created["result"]["stored_session_id"]
+    assert db.get_session(stored_id) is None
+
+    other_home = tmp_path / "other-profile"
+    other_home.mkdir()
+    monkeypatch.setattr(
+        server,
+        "_profile_home",
+        lambda profile: Path(other_home) if profile == "other" else None,
+    )
+    resumed = server._methods["session.resume"](
+        "resume-other-profile",
+        {"session_id": stored_id, "profile": "other", "omit_messages": True},
+    )
+
+    assert resumed["error"]["code"] == 4007
+    assert resumed["error"]["message"] == "session not found"
+
