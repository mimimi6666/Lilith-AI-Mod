+def test_session_resume_reuses_exact_live_unpersisted_empty_draft(gateway_db):
+    db, _ = gateway_db
+    created = server._methods["session.create"]("create-empty", {"cols": 80})
+    assert "error" not in created
+    sid = created["result"]["session_id"]
+    stored_id = created["result"]["stored_session_id"]
+    before = set(server._sessions)
+
+    assert db.get_session(stored_id) is None
+    resumed = server._methods["session.resume"](
+        "resume-empty",
+        {"session_id": stored_id, "cols": 96, "omit_messages": True},
+    )
+
+    assert "error" not in resumed
+    assert resumed["result"]["session_id"] == sid
+    assert resumed["result"]["session_key"] == stored_id
+    assert resumed["result"]["resumed"] == stored_id
+    assert resumed["result"]["message_count"] == 0
+    assert resumed["result"]["messages"] == []
+    assert resumed["result"]["messages_omitted"] is True
+    assert resumed["result"]["status"] == "idle"
+    assert set(server._sessions) == before
+    assert db.get_session(stored_id) is None
+
+    # The ordinary live-draft shortcut must never satisfy the privileged hidden
+    # game resume contract, which still requires an exact durable DB lineage.
+    rejected = server._methods["session.resume"](
+        "resume-empty-durable",
+        {
+            "session_id": stored_id,
+            "require_durable_lineage": True,
+            "expected_source": "lilith-game",
+            "expected_archived": True,
+        },
+    )
+    assert rejected["error"]["code"] == 4094
+
