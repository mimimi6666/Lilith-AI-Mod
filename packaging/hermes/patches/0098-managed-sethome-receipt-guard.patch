diff --git a/tests/gateway/test_managed_sethome.py b/tests/gateway/test_managed_sethome.py
new file mode 100644
--- /dev/null
+++ b/tests/gateway/test_managed_sethome.py
@@ -0,0 +1,186 @@
+"""Managed /sethome must preserve the exact profile and its Runtime receipt.
+
+Real native handlers and writers run only against temporary profiles. Transport,
+plugin discovery and provider/network effects are forbidden or replaced below.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+from pathlib import Path
+import socket
+import subprocess
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from agent import identity_policy
+from gateway.config import GatewayConfig, HomeChannel, Platform, PlatformConfig, persist_home_channel
+from gateway.slash_commands import GatewaySlashCommandsMixin
+from hermes_cli import commands, config
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    for key in (
+        "HERMES_IDENTITY_REQUIRED", "HERMES_MANAGED", "HERMES_MANAGED_DIR",
+        "HERMES_MANAGED_CONFIG_SHA256", "TELEGRAM_HOME_CHANNEL", "TELEGRAM_HOME_THREAD",
+    ):
+        monkeypatch.delenv(key, raising=False)
+    original_connect = socket.socket.connect
+    def local_event_loop_only(sock, address):
+        # Native Windows asyncio builds its wakeup socket pair on loopback.
+        if isinstance(address, tuple) and address[0] in {"127.0.0.1", "::1"}:
+            return original_connect(sock, address)
+        pytest.fail("external network forbidden")
+    monkeypatch.setattr(socket.socket, "connect", local_event_loop_only)
+    monkeypatch.setattr(subprocess, "run", lambda *a, **k: pytest.fail("subprocess forbidden"))
+    monkeypatch.setattr(identity_policy, "strict_public_identity_by_host", lambda: None)
+    monkeypatch.setattr(commands, "_iter_plugin_command_entries", lambda: [])
+    monkeypatch.setattr(commands, "_collect_gateway_skill_entries", lambda **kw: ([], 0))
+    config._LOAD_CONFIG_CACHE.clear()
+    config._RAW_CONFIG_CACHE.clear()
+    yield
+    config._LOAD_CONFIG_CACHE.clear()
+    config._RAW_CONFIG_CACHE.clear()
+
+
+def _profile(tmp_path):
+    (tmp_path / "config.yaml").write_bytes(b"# exact managed bytes\r\nplatform_toolsets:\r\n  cli: []\r\n")
+    for name in ("native-config-receipt.v1.json", "SOUL.md", ".env", "auth.json"):
+        (tmp_path / name).write_bytes(b"fixture-preserved\r\n")
+    return {p.name: p.read_bytes() for p in tmp_path.iterdir() if p.is_file()}
+
+
+def _source(platform=Platform.TELEGRAM, **overrides):
+    values = dict(platform=platform, chat_id="fixture-chat", chat_name="Fixture chat",
+                  user_id="123", scope_id=None, thread_id=None, message_id="456", profile="default")
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def _runner():
+    runner = GatewaySlashCommandsMixin()
+    runner.config = GatewayConfig(platforms={Platform.TELEGRAM: PlatformConfig(enabled=True)})
+    runner._deliver_platform_notice = AsyncMock()
+    return runner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("command", ["sethome", "set-home"])
+async def test_managed_command_refuses_before_any_profile_or_memory_change(tmp_path, monkeypatch, command):
+    before = _profile(tmp_path)
+    digest = hashlib.sha256(before["config.yaml"]).hexdigest()
+    identity_policy._load_host_required_config(tmp_path, digest)
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+    runner = _runner()
+    config_before = copy.deepcopy(runner.config)
+    assert commands.resolve_command(command).name == "sethome"
+    result = await runner._handle_set_home_command(SimpleNamespace(source=_source()))
+    assert "does not support changing the home chat" in result
+    assert "No settings were changed" in result
+    assert runner.config == config_before
+    assert {name: (tmp_path / name).read_bytes() for name in before} == before
+    identity_policy._load_host_required_config(tmp_path, digest)
+
+
+@pytest.mark.parametrize("via_relay", [False, True])
+def test_managed_direct_home_writer_cannot_bypass_handler(tmp_path, monkeypatch, via_relay):
+    before = _profile(tmp_path)
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+    home = HomeChannel(platform=Platform.TELEGRAM, chat_id="fixture-chat", name="Fixture")
+    with pytest.raises(PermissionError, match="native management transaction"):
+        persist_home_channel(home, enabled_if_new=not via_relay)
+    assert {name: (tmp_path / name).read_bytes() for name in before} == before
+
+
+@pytest.mark.asyncio
+async def test_managed_rejection_does_not_even_consume_event_or_config(monkeypatch):
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+    result = await GatewaySlashCommandsMixin()._handle_set_home_command(object())
+    assert "No settings were changed" in result
+
+
+@pytest.mark.asyncio
+async def test_malformed_host_marker_fails_closed_without_writes(tmp_path, monkeypatch):
+    before = _profile(tmp_path)
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "0")
+    with pytest.raises(identity_policy.IdentityPolicyError):
+        await _runner()._handle_set_home_command(SimpleNamespace(source=_source()))
+    assert {name: (tmp_path / name).read_bytes() for name in before} == before
+
+
+@pytest.mark.asyncio
+async def test_unmanaged_command_still_persists_config_env_and_running_state(tmp_path):
+    runner = _runner()
+    await runner._handle_set_home_command(SimpleNamespace(source=_source()))
+    saved = config.load_config()["platforms"]["telegram"]["home_channel"]
+    assert saved["chat_id"] == "fixture-chat"
+    assert config.load_env()["TELEGRAM_HOME_CHANNEL"] == "fixture-chat"
+    assert runner.config.get_home_channel(Platform.TELEGRAM).chat_id == "fixture-chat"
+
+
+@pytest.mark.asyncio
+async def test_unmanaged_writer_control_reproduces_managed_digest_failure(tmp_path):
+    before = _profile(tmp_path)
+    digest = hashlib.sha256(before["config.yaml"]).hexdigest()
+    identity_policy._load_host_required_config(tmp_path, digest)
+    await _runner()._handle_set_home_command(SimpleNamespace(source=_source()))
+    assert (tmp_path / "native-config-receipt.v1.json").read_bytes() == before["native-config-receipt.v1.json"]
+    with pytest.raises(identity_policy.IdentityPolicyError):
+        identity_policy._load_host_required_config(tmp_path, digest)
+
+
+@pytest.mark.parametrize("managed", [False, True])
+def test_gateway_and_telegram_advertisement_matches_supported_home_writer(monkeypatch, managed):
+    if managed:
+        monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+    for name in ("sethome", "set-home", "set_home"):
+        assert commands.public_command_visible(name) is not managed
+    menu, _ = commands.telegram_menu_commands()
+    assert ("sethome" in {name for name, _ in menu}) is not managed
+    assert any("/sethome" in line for line in commands.gateway_help_lines()) is not managed
+    assert commands.resolve_command("set-home").name == "sethome"
+    assert commands.is_gateway_known_command("sethome")
+
+
+@pytest.mark.asyncio
+async def test_managed_onboarding_never_suggests_unsupported_command(monkeypatch):
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+    runner = _runner()
+    await runner._maybe_prompt_home_channel(object(), [])
+    runner._deliver_platform_notice.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("platform, command", [(Platform.TELEGRAM, "/sethome"), (Platform.SLACK, "/hermes sethome")])
+async def test_unmanaged_onboarding_preserves_platform_command(platform, command):
+    runner = _runner()
+    source = _source(platform)
+    await runner._maybe_prompt_home_channel(source, [])
+    runner._deliver_platform_notice.assert_awaited_once()
+    assert command in runner._deliver_platform_notice.await_args.args[1]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("case", ["history", "local", "webhook", "env", "config", "secondary-profile"])
+async def test_unmanaged_onboarding_preserves_existing_skip_conditions(monkeypatch, case):
+    runner = _runner()
+    source = _source()
+    history = []
+    if case == "history":
+        history = [{"role": "user", "content": "Fixture"}]
+    elif case in {"local", "webhook"}:
+        source.platform = Platform.LOCAL if case == "local" else Platform.WEBHOOK
+    elif case == "env":
+        monkeypatch.setenv("TELEGRAM_HOME_CHANNEL", "existing")
+    elif case == "config":
+        runner.config.platforms[Platform.TELEGRAM].home_channel = HomeChannel(Platform.TELEGRAM, "existing", "Fixture")
+    else:
+        source.profile = "fixture-secondary"
+        monkeypatch.setattr("gateway.config.load_gateway_config", lambda: SimpleNamespace(get_home_channel=lambda _: object()))
+    await runner._maybe_prompt_home_channel(source, history)
+    runner._deliver_platform_notice.assert_not_awaited()
