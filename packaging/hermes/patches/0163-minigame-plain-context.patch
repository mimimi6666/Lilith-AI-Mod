+def _validate_batch(batch, kind):
+    _exact(batch, _EVENT_BATCH)
+    if type(batch["batchId"]) is not str or not _GUID.fullmatch(batch["batchId"]) or batch["batchId"] == "0" * 32:
+        _reject()
+    for field in ("priorSequence", "throughSequence", "omittedEventCount", "deferredEventCount"):
+        _int(batch[field], 0, 1000000)
+    events = batch["events"]
+    if type(events) is not list or len(events) > 128:
+        _reject()
+    start = batch["priorSequence"] + batch["omittedEventCount"]
+    if (batch["throughSequence"] != start + len(events)
+            or batch["throughSequence"] + batch["deferredEventCount"] > 1000000):
+        _reject()
+    for offset, event in enumerate(events, 1):
+        if type(event) is not dict or event.get("sequence") != start + offset or type(event.get("sequence")) is not int:
+            _reject()
+        name = event.get("kind")
+        fields = {"sequence", "kind"}
+        if name == "started":
+            _exact(event, fields)
+            if event["sequence"] != 1:
+                _reject()
+        elif name == "finished":
+            _exact(event, fields | {"winner", "resultReason"})
+            _token(event["winner"], {"player", "lilith"} | ({"draw"} if kind == "chess" else set()))
+            reasons = {"all-pairs"} if kind == "old-maid" else _REASONS - {"none", "all-pairs"}
+            _token(event["resultReason"], reasons)
+            if kind == "chess" and ((event["winner"] == "draw") != (event["resultReason"] in _DRAWS)):
+                _reject()
+            if offset != len(events) or batch["deferredEventCount"]:
+                _reject()
+        elif kind == "old-maid" and name in {"card-drawn", "pair-discarded", "hand-reordered"}:
+            _token(event.get("actor"), {"player", "lilith"})
+            if name == "card-drawn":
+                _exact(event, fields | {"actor", "card"})
+                card = event["card"]
+                _exact(card, _CARD)
+                _token(card["rank"], _RANKS | {"JOKER"})
+                _token(card["suit"], {"hearts", "spades", "none"})
+                if (card["rank"] == "JOKER") != (card["suit"] == "none"):
+                    _reject()
+            elif name == "pair-discarded":
+                _exact(event, fields | {"actor", "rank"})
+                _token(event["rank"], _RANKS)
+            else:
+                _exact(event, fields | {"actor", "fromIndex", "toIndex"})
