+def _event_attachment(value):
+    return {"schema": "lilith.minigame.events.history.v1",
+            "gameEpoch": value["gameEpoch"], "matchId": value["matchId"],
+            "gameKind": value["gameKind"], "batch": deepcopy(value["events"])}
+
+
+def validate_event_attachment(value):
+    _exact(value, {"schema", "gameEpoch", "matchId", "gameKind", "batch"})
+    _token(value["schema"], {"lilith.minigame.events.history.v1"})
+    for key in ("gameEpoch", "matchId"):
+        if type(value[key]) is not str or not _GUID.fullmatch(value[key]) or value[key] == "0" * 32:
+            _reject()
+    _token(value["gameKind"], {"old-maid", "chess"})
+    _validate_batch(value["batch"], value["gameKind"])
+    wire = json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
+    if len(wire.encode("utf-8")) > EVENT_MAX_BYTES:
+        _reject()
+    return json.loads(wire)
+
