+def _save_diagnostic(outcome, reason, error=None):
+    # Closed outcomes/reasons are supplied only by save(). No exception text,
+    # paths, source identities or summary prose may enter routine diagnostics.
+    try:
+        code = 0
+        if isinstance(error, OSError):
+            for value in (getattr(error, "winerror", None), getattr(error, "errno", None)):
+                if type(value) is int and 0 <= value <= 65535:
+                    code = value
+                    break
+        level = logging.WARNING if outcome == "failed" else logging.INFO
+        logger.log(level, "[checkpoint_cache] operation=save outcome=%s reason=%s os_error=%d",
+                   outcome, reason, code)
+    except Exception:
+        pass  # Optional diagnostics cannot turn a cache failure into chat failure.
