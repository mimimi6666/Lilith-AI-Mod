+def _scene_step(code, function, *args, **kwargs):
+    """Keep a closed stage, never exception text, pixels or OCR in diagnostics."""
+    try:
+        return function(*args, **kwargs)
+    except SceneError:
+        raise
+    except Exception:
+        raise SceneError(code) from None
+
+
+def _visual_http_failure(status):
+    if status in (401, 403):
+        return "local_visual_http_unauthorized"
+    if status == 413:
+        return "local_visual_http_capacity"
+    if status == 429:
+        return "local_visual_http_busy"
+    if isinstance(status, int) and 500 <= status <= 599:
+        return "local_visual_http_server_error"
+    return "local_visual_http_rejected"
+
+
+def local_visual(http, base, token, image, question, cap):
+    """One request to the existing owned loopback worker; no retry or fallback."""
+    stream = io.BytesIO()
+    _scene_step("local_visual_request_invalid", image.save, stream, format="PNG")
+    body = {"messages": [{"role": "user", "content": [{"type": "text", "text": question},
+        {"type": "image_url", "image_url": {"url": "data:image/png;base64," + base64.b64encode(stream.getvalue()).decode("ascii")}}]}],
+        "max_tokens": cap, "temperature": .1, "stream": False}
+    req = urllib.request.Request(base + "/v1/chat/completions", json.dumps(body).encode(),
+        headers={"Content-Type": "application/json", "Authorization": "Bearer " + token})
+    try:
+        with http.open(req, timeout=15) as response:
+            raw = response.read(100_000)
+    except urllib.error.HTTPError as error:
+        # Do not read or copy the error body: it may echo private input.
+        raise SceneError(_visual_http_failure(error.code)) from None
+    except (TimeoutError, socket.timeout):
+        raise SceneError("local_visual_timeout") from None
+    except urllib.error.URLError as error:
+        code = "local_visual_timeout" if isinstance(error.reason, (TimeoutError, socket.timeout)) else "local_visual_transport_failed"
+        raise SceneError(code) from None
+    except OSError:
+        raise SceneError("local_visual_transport_failed") from None
+    try:
+        result = json.loads(raw)
+        answer = result["choices"][0]["message"]["content"]
+        if not isinstance(answer, str) or len(answer) > 4000:
+            raise ValueError("invalid_local_visual_response")
+        return answer
+    except Exception:
+        raise SceneError("local_visual_response_invalid") from None
+
