+
+    assert resumed["error"] == {
+        "code": 4094,
+        "message": "durable session lineage was rejected",
+    }
+    assert set(server._sessions) == before
+
+
+def test_durable_resume_never_reinterprets_a_handle_as_a_session_title(gateway_db):
+    db, _ = gateway_db
+    db.create_session("real-id", source="lilith-game", archived=True)
