+def _bind_durable_lineage_session(session: dict, proof: dict) -> None:
+    """Bind one privileged durable root to its live gateway session.
+
+    The binding is host-created by ``session.create``/``session.resume`` after
+    SessionDB has attested the exact archived ``lilith-game`` lineage.  It is
+    deliberately stored outside the client-visible session payload so an
+    ordinary prompt cannot manufacture a post-compression authority receipt.
+    """
+    if not isinstance(session, dict) or not isinstance(proof, dict):
+        raise ValueError("durable session lineage binding was malformed")
+    if set(proof) != {
+        "requested_session_id",
+        "resolved_session_id",
+        "session_ids",
+        "source",
+        "archived",
+    }:
+        raise ValueError("durable session lineage binding was non-canonical")
+    root = proof.get("requested_session_id")
+    resolved = proof.get("resolved_session_id")
+    session_ids = proof.get("session_ids")
+    if (
+        not isinstance(root, str)
+        or not root
+        or not isinstance(resolved, str)
+        or not resolved
+        or not isinstance(session_ids, list)
+        or not session_ids
+        or session_ids[0] != root
+        or session_ids[-1] != resolved
+        or len(session_ids) != len(set(session_ids))
+        or any(not isinstance(value, str) or not value for value in session_ids)
+        or proof.get("source") != "lilith-game"
+        or proof.get("archived") is not True
+        or session.get("source") != "lilith-game"
+        or session.get("session_key") != resolved
+    ):
