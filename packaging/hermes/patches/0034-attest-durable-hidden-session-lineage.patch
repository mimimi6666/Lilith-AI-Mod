--- a/hermes_state.py
+++ b/hermes_state.py
@@ -9115,6 +9115,120 @@ class SessionDB(SessionSearchMixin, SessionSchemaMixin, SessionPortabilityMixin)
 
             return best if best is not None else session_id
 
+    def attest_resume_session_lineage(
+        self,
+        requested_session_id: str,
+        resolved_session_id: Optional[str] = None,
+        *,
+        expected_source: str,
+        expected_archived: bool,
+    ) -> Dict[str, Any]:
+        """Resolve and prove one durable compression lineage atomically.
+
+        One recursive SQLite statement walks *forward* from the exact requested
+        row to the current compression tip.  Every edge must be a real
+        compression continuation, never a branch, delegate, reset, or tool
+        child, and every row must keep the caller's expected source and archive
+        policy.  Resolving the tip inside this same read snapshot avoids granting
+        scoped authority from a proof assembled across two compression states.
+
+        ``resolved_session_id`` is an optional assertion for callers that already
+        carry a candidate tip; omitting it makes the returned proof authoritative.
+        """
+        if not isinstance(requested_session_id, str) or not requested_session_id:
+            raise ValueError("durable session identity is required")
+        if resolved_session_id is not None and (
+            not isinstance(resolved_session_id, str) or not resolved_session_id
+        ):
+            raise ValueError("resolved durable session identity was rejected")
+        if not isinstance(expected_source, str) or not expected_source.strip():
+            raise ValueError("expected source is required")
+        if type(expected_archived) is not bool:
+            raise ValueError("expected archived must be a boolean")
+
+        source = expected_source.strip()
+        with self._read_ctx() as conn:
+            rows = conn.execute(
+                f"""
+                WITH RECURSIVE lineage(
+                    id, parent_session_id, source, archived, end_reason,
+                    model_config, depth
+                ) AS (
+                    SELECT id, parent_session_id, source, archived, end_reason,
+                           model_config, 0
+                    FROM sessions
+                    WHERE id = ?
+                    UNION ALL
+                    SELECT child.id, child.parent_session_id, child.source,
+                           child.archived, child.end_reason,
+                           child.model_config, parent.depth + 1
+                    FROM lineage AS parent
+                    JOIN sessions AS child
+                      ON child.id = (
+                          SELECT candidate.id
+                          FROM sessions AS candidate
+                          WHERE candidate.parent_session_id = parent.id
+                            AND json_extract(
+                                  COALESCE(candidate.model_config, '{{}}'),
+                                  '$._branched_from'
+                                ) IS NULL
+                            AND json_extract(
+                                  COALESCE(candidate.model_config, '{{}}'),
+                                  '$._delegate_from'
+                                ) IS NULL
+                            AND json_extract(
+                                  COALESCE(candidate.model_config, '{{}}'),
+                                  '$._reset_from'
+                                ) IS NULL
+                            AND COALESCE(candidate.source, '') != 'tool'
+                          ORDER BY
+                            CASE
+                              WHEN candidate.end_reason = 'compression' THEN 0
+                              WHEN candidate.ended_at IS NULL THEN 1
+                              ELSE 2
+                            END,
+                            {_sql_session_last_active("candidate")} DESC,
+                            candidate.started_at DESC,
+                            candidate.id DESC
+                          LIMIT 1
+                      )
+                    WHERE parent.depth < 100
+                      AND parent.end_reason = 'compression'
+                )
+                SELECT id, source, archived, depth
+                FROM lineage
+                ORDER BY depth ASC
+                """,
+                (requested_session_id,),
+            ).fetchall()
+
+        if not rows:
+            raise ValueError("durable session lineage was not found")
+        ids = [str(row["id"] or "") for row in rows]
+        if not all(ids) or len(ids) != len(set(ids)):
+            raise ValueError("durable session lineage was cyclic")
+        if len(rows) >= 101:
+            raise ValueError("durable session lineage exceeded its safe depth")
+        if ids[0] != requested_session_id:
+            raise ValueError("durable session lineage root did not match")
+        resolved = ids[-1]
+        if resolved_session_id is not None and resolved != resolved_session_id:
+            raise ValueError("resolved session is not a compression continuation")
+
+        for row in rows:
+            if str(row["source"] or "") != source:
+                raise ValueError("durable session source did not match")
+            if bool(int(row["archived"] or 0)) is not expected_archived:
+                raise ValueError("durable session archive policy did not match")
+
+        return {
+            "requested_session_id": requested_session_id,
+            "resolved_session_id": resolved,
+            "session_ids": ids,
+            "source": source,
+            "archived": expected_archived,
+        }
+
     def get_messages_as_conversation(
         self,
         session_id: str,
diff --git a/tests/test_durable_session_lineage.py b/tests/test_durable_session_lineage.py
