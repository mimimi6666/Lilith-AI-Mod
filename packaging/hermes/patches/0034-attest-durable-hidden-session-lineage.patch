+++ b/tests/test_durable_session_lineage.py
@@ -0,0 +1,162 @@
+"""Durable hidden-session lineage proofs used before scoped authority grants."""
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def db(tmp_path):
+    handle = SessionDB(tmp_path / "state.db")
+    try:
+        yield handle
+    finally:
+        handle.close()
+
+
+def _compression_child(db, parent, child, *, source="lilith-game", **kwargs):
+    db.end_session(parent, "compression")
+    db.create_session(
+        child,
+        source=source,
+        parent_session_id=parent,
+        archived=True,
+        **kwargs,
+    )
+
+
+def test_attests_one_exact_durable_archived_row(db):
+    db.create_session("game", source="lilith-game", archived=True)
+
+    assert db.attest_resume_session_lineage(
+        "game",
+        "game",
+        expected_source="lilith-game",
+        expected_archived=True,
+    ) == {
+        "requested_session_id": "game",
+        "resolved_session_id": "game",
+        "session_ids": ["game"],
+        "source": "lilith-game",
+        "archived": True,
+    }
+
+
+def test_attests_only_an_ordered_compression_continuation(db):
+    db.create_session("root", source="lilith-game", archived=True)
+    _compression_child(db, "root", "middle")
+    _compression_child(db, "middle", "tip")
+
+    proof = db.attest_resume_session_lineage(
+        "root",
+        "tip",
+        expected_source="lilith-game",
+        expected_archived=True,
+    )
+
+    assert proof["session_ids"] == ["root", "middle", "tip"]
+    assert proof["requested_session_id"] == "root"
+    assert proof["resolved_session_id"] == "tip"
+
+
+def test_atomic_compression_publication_preserves_hidden_policy_and_attestation(db):
+    db.create_session("root", source="lilith-game", archived=True)
+
+    db.publish_compression_child(
+        parent_session_id="root",
+        child_session_id="tip",
+        source="lilith-game",
+        messages=[{"role": "user", "content": "compressed context"}],
+        require_compression_lease=False,
+    )
+
+    assert db.get_session("root")["end_reason"] == "compression"
+    assert db.get_session("tip")["archived"] == 1
+    assert db.attest_resume_session_lineage(
+        "root",
+        expected_source="lilith-game",
+        expected_archived=True,
+    )["session_ids"] == ["root", "tip"]
+
+
+@pytest.mark.parametrize(
+    "model_config",
+    [
+        {"_branched_from": "root"},
+        {"_delegate_from": "root"},
+        {"_reset_from": "root"},
+    ],
+)
+def test_rejects_non_compression_child_markers(db, model_config):
+    db.create_session("root", source="lilith-game", archived=True)
+    _compression_child(db, "root", "tip", model_config=model_config)
+
+    with pytest.raises(ValueError, match="compression continuation"):
+        db.attest_resume_session_lineage(
+            "root",
+            "tip",
+            expected_source="lilith-game",
+            expected_archived=True,
+        )
+
+
+@pytest.mark.parametrize(
+    ("source", "archived"),
+    [("desktop", True), ("lilith-game", False)],
+)
+def test_rejects_any_row_with_the_wrong_policy(db, source, archived):
+    db.create_session("row", source=source, archived=archived)
+
+    with pytest.raises(ValueError, match="did not match"):
+        db.attest_resume_session_lineage(
+            "row",
+            "row",
+            expected_source="lilith-game",
+            expected_archived=True,
+        )
+
+
+def test_rejects_unrelated_requested_and_resolved_rows(db):
+    db.create_session("requested", source="lilith-game", archived=True)
+    db.create_session("resolved", source="lilith-game", archived=True)
+
+    with pytest.raises(ValueError, match="compression continuation"):
+        db.attest_resume_session_lineage(
+            "requested",
+            "resolved",
+            expected_source="lilith-game",
+            expected_archived=True,
+        )
+
+
+def test_rejects_tool_children_even_when_the_parent_was_compressed(db):
+    db.create_session("root", source="lilith-game", archived=True)
+    _compression_child(db, "root", "tool-tip", source="tool")
+
+    with pytest.raises(ValueError, match="compression continuation"):
+        db.attest_resume_session_lineage(
+            "root",
+            "tool-tip",
+            expected_source="lilith-game",
+            expected_archived=True,
+        )
+
+
+def test_rejects_cyclic_lineage(db):
+    db.create_session("root", source="lilith-game", archived=True)
+    _compression_child(db, "root", "tip")
+    db.end_session("tip", "compression")
+    db._execute_write(
+        lambda conn: conn.execute(
+            "UPDATE sessions SET parent_session_id = ? WHERE id = ?",
+            ("tip", "root"),
+        )
+    )
+
+    with pytest.raises(ValueError, match="cyclic"):
+        db.attest_resume_session_lineage(
+            "root",
+            "tip",
+            expected_source="lilith-game",
+            expected_archived=True,
+        )
