+def test_durable_archived_session_is_persisted_and_attested_before_first_prompt(
+    gateway_db,
+):
+    db, _ = gateway_db
+
+    created = server._methods["session.create"](
+        "create-durable",
+        {
+            "archived": True,
+            "durable": True,
+            "source": "lilith-game",
+        },
+    )
+
+    assert "error" not in created
+    result = created["result"]
+    stored_id = result["stored_session_id"]
+    row = db.get_session(stored_id)
+    assert row is not None
+    assert row["source"] == "lilith-game"
+    assert row["archived"] == 1
+    assert stored_id not in _listed_ids()
+    assert result["durable_lineage"] == {
+        "requested_session_id": stored_id,
+        "resolved_session_id": stored_id,
+        "session_ids": [stored_id],
+        "source": "lilith-game",
+        "archived": True,
+    }
+    session = server._sessions[result["session_id"]]
+    assert session["_durable_lineage_root"] == stored_id
+    assert server._attest_durable_lineage_postcondition(session) == {
+        "stored_session_id": stored_id,
+        "durable_lineage": result["durable_lineage"],
+    }
+
+
+def test_durable_resume_attests_the_exact_compression_lineage(gateway_db):
+    db, _ = gateway_db
+    db.create_session("game-root", source="lilith-game", archived=True)
+    db.append_message("game-root", role="user", content="before compression")
+    db.append_message("game-root", role="assistant", content="root reply")
+    db.end_session("game-root", end_reason="compression")
+    db.create_session(
+        "game-tip",
+        source="lilith-game",
+        parent_session_id="game-root",
+        archived=True,
+    )
+    db.append_message("game-tip", role="user", content="after compression")
+    db.append_message("game-tip", role="assistant", content="tip reply")
+
+    resumed = server._methods["session.resume"](
+        "resume-durable",
+        {
+            "session_id": "game-root",
+            "source": "lilith-game",
+            "require_durable_lineage": True,
+            "expected_source": "lilith-game",
+            "expected_archived": True,
+        },
+    )
+
+    assert "error" not in resumed
+    assert resumed["result"]["resumed"] == "game-tip"
+    assert resumed["result"]["durable_lineage"] == {
+        "requested_session_id": "game-root",
+        "resolved_session_id": "game-tip",
+        "session_ids": ["game-root", "game-tip"],
+        "source": "lilith-game",
+        "archived": True,
+    }
+    live_session = server._sessions[resumed["result"]["session_id"]]
+    assert live_session["_durable_lineage_root"] == "game-root"
+    assert server._attest_durable_lineage_postcondition(live_session) == {
+        "stored_session_id": "game-tip",
+        "durable_lineage": resumed["result"]["durable_lineage"],
+    }
+    history = server._methods["session.history"](
+        "history", {"session_id": resumed["result"]["session_id"]}
+    )
+    assert [message["text"] for message in history["result"]["messages"]] == [
+        "before compression",
+        "root reply",
+        "after compression",
+        "tip reply",
+    ]
+
+
+def test_durable_turn_postcondition_rotates_to_exact_compression_tip(gateway_db):
+    db, _ = gateway_db
+    created = server._methods["session.create"](
+        "create-durable-compress",
+        {
+            "archived": True,
+            "durable": True,
+            "source": "lilith-game",
+        },
+    )["result"]
+    root = created["stored_session_id"]
+    session = server._sessions[created["session_id"]]
+
+    db.end_session(root, end_reason="compression")
+    db.create_session(
+        "compressed-tip",
+        source="lilith-game",
+        parent_session_id=root,
+        archived=True,
+    )
+    session["session_key"] = "compressed-tip"
+
+    assert server._attest_durable_lineage_postcondition(session) == {
+        "stored_session_id": "compressed-tip",
+        "durable_lineage": {
+            "requested_session_id": root,
+            "resolved_session_id": "compressed-tip",
+            "session_ids": [root, "compressed-tip"],
+            "source": "lilith-game",
+            "archived": True,
+        },
+    }
+
+
+def test_durable_turn_postcondition_rejects_non_compression_substitution(gateway_db):
+    db, _ = gateway_db
+    created = server._methods["session.create"](
+        "create-durable-branch",
+        {
+            "archived": True,
+            "durable": True,
+            "source": "lilith-game",
+        },
+    )["result"]
+    session = server._sessions[created["session_id"]]
+    db.create_session(
+        "unrelated-game",
+        source="lilith-game",
+        archived=True,
+    )
+    session["session_key"] = "unrelated-game"
+
+    with pytest.raises(ValueError, match="compression continuation"):
+        server._attest_durable_lineage_postcondition(session)
+
+
+@pytest.mark.parametrize(
+    ("source", "archived", "expected_source", "expected_archived"),
+    [
+        ("desktop", True, "lilith-game", True),
+        ("lilith-game", False, "lilith-game", True),
+    ],
+)
+def test_durable_resume_rejects_policy_mismatch_before_allocating_live_session(
+    gateway_db,
+    source,
+    archived,
+    expected_source,
+    expected_archived,
+):
+    db, _ = gateway_db
+    db.create_session("wrong-policy", source=source, archived=archived)
+    before = set(server._sessions)
+
+    resumed = server._methods["session.resume"](
+        "resume-rejected",
+        {
+            "session_id": "wrong-policy",
+            "require_durable_lineage": True,
+            "expected_source": expected_source,
+            "expected_archived": expected_archived,
+        },
+    )
+
+    assert resumed["error"] == {
+        "code": 4094,
+        "message": "durable session lineage was rejected",
+    }
+    assert set(server._sessions) == before
+
+
+def test_durable_resume_maps_a_missing_stored_row_to_lineage_rejection(gateway_db):
