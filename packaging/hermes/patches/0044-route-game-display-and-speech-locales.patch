+"""Per-turn display-locale routing for the durable hidden game chat."""
+
+from __future__ import annotations
+
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from tui_gateway import server
+
+
+def _session(*, running=False, **extra):
+    return {
+        "agent": SimpleNamespace(),
+        "archived": True,
+        "attached_images": [],
+        "cols": 80,
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "inflight_turn": None,
+        "running": running,
+        "session_key": "game-tip",
+        "source": "lilith-game",
+        "transport": None,
+        "_durable_lineage_root": "game-root",
+        **extra,
+    }
+
+
+@pytest.mark.parametrize("display_locale", ["zh-Hant", "zh-Hans", "ja", "en"])
+@pytest.mark.parametrize("explicitly_queued", [False, True])
+def test_busy_game_submit_is_retryable_and_never_queued(
+    monkeypatch,
+    display_locale,
+    explicitly_queued,
+):
+    session = _session(running=True)
+    server._sessions["game-sid"] = session
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *_args: None)
+    try:
+        params = {
+            "session_id": "game-sid",
+            "text": "原文保留",
+            "display_locale": display_locale,
+        }
+        if explicitly_queued:
+            params["queued"] = True
+        result = server._methods["prompt.submit"](
+            "queued",
+            params,
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert result["error"] == {
+        "code": 4009,
+        "message": "session busy — retry the game prompt after the current turn finishes",
+    }
+    assert session.get("queued_prompt") is None
+    assert session.get("queued_prompts") is None
+    assert session["history"] == []
+
+
+def test_busy_game_submit_does_not_mutate_an_existing_queue(monkeypatch):
+    pending = {
+        "text": "既有控制中心訊息",
+        "transport": None,
+    }
+    session = _session(
+        running=True,
+        queued_prompt=pending,
+        queued_prompts=[{"text": "下一則", "transport": None}],
+    )
+    server._sessions["game-sid"] = session
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *_args: None)
+    try:
+        result = server._methods["prompt.submit"](
+            "game-busy",
+            {
+                "session_id": "game-sid",
+                "text": "遊戲訊息",
+                "display_locale": "ja",
+            },
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert result["error"]["code"] == 4009
+    assert session["queued_prompt"] is pending
+    assert session["queued_prompts"] == [{"text": "下一則", "transport": None}]
+
+
+def test_game_submit_losing_final_claim_race_is_never_queued(monkeypatch):
+    session = _session(running=False)
+
+    class BusyOnFinalClaim:
+        def __init__(self):
+            self.enters = 0
+
+        def __enter__(self):
+            self.enters += 1
+            if self.enters == 2:
+                session["running"] = True
+            return self
+
+        def __exit__(self, _exc_type, _exc, _traceback):
+            return False
+
+    session["history_lock"] = BusyOnFinalClaim()
+    server._sessions["game-sid"] = session
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *_args: None)
+    try:
+        result = server._methods["prompt.submit"](
+            "race",
+            {
+                "session_id": "game-sid",
+                "text": "競態訊息",
+                "display_locale": "zh-Hant",
+            },
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert result["error"]["code"] == 4009
+    assert session.get("queued_prompt") is None
+    assert session.get("queued_prompts") is None
+
+
+def test_queue_drain_forwards_the_claimed_envelope_locale(monkeypatch):
+    session = _session(
+        queued_prompt={
+            "text": "二",
+            "transport": None,
+            "display_locale": "ja",
+        }
+    )
+    server._sessions["game-sid"] = session
+    delivered = MagicMock()
+    monkeypatch.setattr(server, "_run_prompt_submit", delivered)
+    monkeypatch.setattr(server, "_emit_accepted_user_message", lambda *_args, **_kwargs: None)
+    try:
+        assert server._drain_queued_prompt(
+            "drain",
+            "game-sid",
+            session,
+            require_live_owner=True,
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    delivered.assert_called_once()
+    assert delivered.call_args.args[3] == "二"
+    assert delivered.call_args.kwargs["display_locale"] == "ja"
+    assert session["inflight_turn"]["user"] == "二"
+
+
+@pytest.mark.parametrize(
+    "session_change",
+    [
+        {"source": "desktop"},
+        {"archived": False},
+        {"_durable_lineage_root": None},
+    ],
+)
+def test_display_locale_is_rejected_outside_bound_hidden_game_sessions(
+    monkeypatch,
+    session_change,
+):
+    session = _session(running=True)
+    session.update(session_change)
+    server._sessions["not-game"] = session
+    try:
+        result = server._methods["prompt.submit"](
+            "reject",
+            {
+                "session_id": "not-game",
+                "text": "hello",
+                "display_locale": "ja",
+                "queued": True,
+            },
+        )
+    finally:
+        server._sessions.pop("not-game", None)
+
+    assert result["error"]["code"] == 4030
+    assert session.get("queued_prompt") is None
+
+
+def test_invalid_display_locale_is_rejected_before_turn_claim():
+    session = _session(running=False)
+    server._sessions["game-sid"] = session
+    try:
+        result = server._methods["prompt.submit"](
+            "reject-locale",
+            {
+                "session_id": "game-sid",
+                "text": "hello",
+                "display_locale": "zh-TW",
+            },
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert result["error"] == {
+        "code": 4004,
+        "message": "unsupported display_locale",
+    }
+    assert session["running"] is False
+
+
+def test_display_locale_changes_only_model_input_not_accepted_or_history_text(
+    monkeypatch,
+):
+    captured = {}
+    original_text = "  早安，今天好嗎？  "
+
+    class Agent:
+        model = "test-model"
+
+        def run_conversation(
+            self,
+            prompt,
+            *,
+            conversation_history=None,
+            stream_callback=None,
+            **kwargs,
+        ):
+            captured["prompt"] = prompt
+            captured["persist_user_message"] = kwargs["persist_user_message"]
+            return {
+                "final_response": "おはよう。元気だよ。",
+                "messages": [
+                    {"role": "user", "content": kwargs["persist_user_message"]},
+                    {"role": "assistant", "content": "おはよう。元気だよ。"},
+                ],
+            }
+
+    class ImmediateThread:
+        def __init__(self, target=None, daemon=None, **_kwargs):
+            self._target = target
+
+        def start(self):
+            self._target()
+
+    session = _session(agent=Agent(), running=True)
+    server._start_inflight_turn(session, original_text)
+    server._sessions["game-sid"] = session
+    monkeypatch.setattr(server.threading, "Thread", ImmediateThread)
+    monkeypatch.setattr(server, "record_turn_start", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_retire_turn_marker", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_get_usage", lambda _agent: {})
+    monkeypatch.setattr(server, "render_message", lambda _text, _cols: "")
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        lambda _session: {"stored_session_id": "game-tip"},
+    )
+    try:
+        server._run_prompt_submit(
+            "run",
+            "game-sid",
+            session,
+            original_text,
+            display_locale="ja",
+        )
+    finally:
+        server._sessions.pop("game-sid", None)
+
+    assert "write this turn's assistant reply in natural Japanese" in captured["prompt"]
+    assert captured["prompt"].endswith(original_text)
+    assert captured["persist_user_message"] == original_text
+    assert session["history"][0] == {"role": "user", "content": original_text}
+
+
+def test_compute_host_frame_carries_locale_but_keeps_accepted_text_exact():
+    original_text = "  原文  "
+    session = _session(running=True)
+    server._start_inflight_turn(session, original_text)
+    frame = server._compute_host_turn_frame(
+        "rid",
+        "game-sid",
+        session,
+        original_text,
+        display_locale="ja",
+    )
+
+    assert frame["display_locale"] == "ja"
+    assert frame["text"] == original_text
+    assert frame["accepted_text"] == original_text
