@@ -0,0 +1,440 @@
+"""Speech-only projection RPC contract.
+
+The projection must share the live session's model authority without becoming
+another conversation turn: no history, tools, memory, or persistence surface
+is available to the one structured completion.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent import identity_policy, plugin_llm
+from tui_gateway import server
+
+
+def _response(payload: dict) -> SimpleNamespace:
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                message=SimpleNamespace(
+                    content=json.dumps(payload, ensure_ascii=False),
+                    role="assistant",
+                ),
+                finish_reason="stop",
+            )
+        ],
+        usage=SimpleNamespace(
+            prompt_tokens=10,
+            completion_tokens=5,
+            total_tokens=15,
+        ),
+    )
+
+
+def _agent() -> SimpleNamespace:
+    return SimpleNamespace(
+        provider="gemini",
+        requested_provider="gemini",
+        model="gemini-2.5-flash",
+        base_url="https://generativelanguage.googleapis.com/v1beta/openai",
+        api_key="test-route-key",
+        api_mode="chat_completions",
+        auth_mode="api_key",
+        _cached_system_prompt="FROZEN SOUL\n\nFROZEN PERSONALITY\n\nSESSION CONTEXT",
+        run_conversation=MagicMock(
+            side_effect=AssertionError("speech projection must not run a conversation")
+        ),
+    )
+
+
+def _install_session(monkeypatch, agent: SimpleNamespace):
+    history = [
+        {"role": "user", "content": "早安"},
+        {"role": "assistant", "content": "早安，很高興見到你。"},
+    ]
+    session = {
+        "agent": agent,
+        "archived": True,
+        "history": history,
+        "history_lock": threading.Lock(),
+        "inflight_turn": None,
+        "running": False,
+        "session_key": "durable-tip",
+        "source": "lilith-game",
+        "_durable_lineage_root": "durable-root",
+    }
+    monkeypatch.setattr(server, "_sess", lambda _params, _rid: (session, None))
+    return session, copy.deepcopy(history)
+
+
+def _attest_session(monkeypatch, session):
+    attestation = MagicMock(
+        return_value={
+            "stored_session_id": session["session_key"],
+            "durable_lineage": {
+                "requested_session_id": session["_durable_lineage_root"],
+                "resolved_session_id": session["session_key"],
+                "session_ids": [
+                    session["_durable_lineage_root"],
+                    session["session_key"],
+                ],
+                "source": "lilith-game",
+                "archived": True,
+            },
+        }
+    )
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        attestation,
+    )
+    return attestation
+
+
+def _trust_projection_plugin(monkeypatch):
+    policy = plugin_llm._TrustPolicy(
+        plugin_id="lilith-runtime-speech-projection"
+    )
+    monkeypatch.setattr(
+        plugin_llm,
+        "_resolve_trust_policy",
+        lambda _plugin_id: policy,
+    )
+
+
+def test_project_speech_is_one_memory_isolated_structured_main_route_call(
+    monkeypatch,
+):
+    agent = _agent()
+    session, original_history = _install_session(monkeypatch, agent)
+    attestation = _attest_session(monkeypatch, session)
+    _trust_projection_plugin(monkeypatch)
+    checked_authority = {}
+
+    def assert_authority(candidate_agent, prompt, *, label):
+        checked_authority.update(agent=candidate_agent, prompt=prompt, label=label)
+
+    monkeypatch.setattr(
+        identity_policy,
+        "assert_scoped_identity_prompt",
+        assert_authority,
+    )
+    captured = {}
+
+    def fake_call_llm(**kwargs):
+        captured.update(kwargs)
+        captured["main_runtime_before_provider"] = kwargs["main_runtime"]["provider"]
+        # The handler passes a private copy, not its retained frozen snapshot.
+        kwargs["main_runtime"]["provider"] = "mutated-by-test-double"
+        kwargs["route_info"].update(
+            provider="gemini",
+            model="gemini-2.5-flash",
+        )
+        return _response({"speech_text": "おはよう。会えてうれしい。"})
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake_call_llm)
+
+    original_text = "  早安，很高興見到你。  "
+    result = server._methods["prompt.project_speech"](
+        "speech-1",
+        {
+            "session_id": "exact-live-session",
+            "text": original_text,
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+        },
+    )
+
+    assert result == {
+        "jsonrpc": "2.0",
+        "id": "speech-1",
+        "result": {"speech_text": "おはよう。会えてうれしい。"},
+    }
+    assert checked_authority == {
+        "agent": agent,
+        "prompt": agent._cached_system_prompt,
+        "label": "speech projection system prompt",
+    }
+    assert captured["task"] is None
+    assert captured["provider"] is None
+    assert captured["model"] is None
+    assert captured["tools"] is None
+    assert captured["stream"] is False
+    assert captured["temperature"] == 0.0
+    assert captured["max_tokens"] == 4096
+    assert captured["timeout"] == 60.0
+    assert captured["main_runtime_before_provider"] == "gemini"
+    assert {
+        key: value
+        for key, value in captured["main_runtime"].items()
+        if key != "provider"
+    } == {
+        "requested_provider": "gemini",
+        "model": "gemini-2.5-flash",
+        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
+        "api_key": "test-route-key",
+        "api_mode": "chat_completions",
+        "auth_mode": "api_key",
+        "session_id": "exact-live-session",
+    }
+
+    messages = captured["messages"]
+    assert [message["role"] for message in messages] == ["system", "user"]
+    assert messages[0]["content"].startswith(agent._cached_system_prompt + "\n\n")
+    assert "memory-isolated" in messages[0]["content"]
+    assert "display locale is zh-Hant" in messages[1]["content"][0]["text"]
+    assert "speech locale is ja" in messages[1]["content"][0]["text"]
+    assert messages[1]["content"][1] == {"type": "text", "text": original_text}
+
+    schema = captured["extra_body"]["response_format"]["json_schema"]["schema"]
+    assert schema == {
+        "type": "object",
+        "properties": {"speech_text": {"type": "string", "minLength": 1}},
+        "required": ["speech_text"],
+        "additionalProperties": False,
+    }
+    assert session["history"] == original_history
+    attestation.assert_called_once_with(session)
+    agent.run_conversation.assert_not_called()
+
+
+@pytest.mark.parametrize("display_locale", ["zh-Hant", "zh-Hans", "ja", "en"])
+@pytest.mark.parametrize("speech_locale", ["zh", "ja"])
+def test_project_speech_accepts_only_the_bounded_locale_sets(
+    monkeypatch,
+    display_locale,
+    speech_locale,
+):
+    agent = _agent()
+    session, _history = _install_session(monkeypatch, agent)
+    _attest_session(monkeypatch, session)
+    _trust_projection_plugin(monkeypatch)
+    monkeypatch.setattr(
+        identity_policy,
+        "assert_scoped_identity_prompt",
+        lambda *_args, **_kwargs: None,
+    )
+
+    def fake_call_llm(**kwargs):
+        kwargs["route_info"].update(provider="gemini", model=agent.model)
+        return _response({"speech_text": "ok"})
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake_call_llm)
+    result = server._methods["prompt.project_speech"](
+        "locale",
+        {
+            "session_id": "sid",
+            "text": "hello",
+            "display_locale": display_locale,
+            "speech_locale": speech_locale,
+        },
+    )
+    assert result["result"] == {"speech_text": "ok"}
+
+
+@pytest.mark.parametrize(
+    "params",
+    [
+        {
+            "session_id": "sid",
+            "text": "hello",
+            "display_locale": "zh-Hant",
+        },
+        {
+            "session_id": "sid",
+            "text": "hello",
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+            "extra": True,
+        },
+        {
+            "session_id": "sid",
+            "text": "bonjour",
+            "display_locale": "fr",
+            "speech_locale": "ja",
+        },
+        {
+            "session_id": "sid",
+            "text": "hello",
+            "display_locale": {},
+            "speech_locale": "ja",
+        },
+        {
+            "session_id": "sid",
+            "text": "   ",
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+        },
+        {
+            "session_id": "sid",
+            "text": "hello",
+            "display_locale": "zh-Hant",
+            "speech_locale": "en",
+        },
+    ],
+)
+def test_project_speech_rejects_malformed_input_before_session_access(
+    monkeypatch,
+    params,
+):
+    monkeypatch.setattr(
+        server,
+        "_sess",
+        MagicMock(side_effect=AssertionError("invalid input reached session lookup")),
+    )
+    result = server._methods["prompt.project_speech"]("bad", params)
+    assert result["error"]["code"] == 4004
+    server._sess.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"speech_text": "ok", "unexpected": "not allowed"},
+        {"speech_text": ""},
+        {"wrong_key": "こんにちは"},
+    ],
+)
+def test_project_speech_fails_closed_on_non_unique_or_blank_output(
+    monkeypatch,
+    payload,
+):
+    agent = _agent()
+    session, original_history = _install_session(monkeypatch, agent)
+    _attest_session(monkeypatch, session)
+    _trust_projection_plugin(monkeypatch)
+    monkeypatch.setattr(
+        identity_policy,
+        "assert_scoped_identity_prompt",
+        lambda *_args, **_kwargs: None,
+    )
+
+    def fake_call_llm(**kwargs):
+        kwargs["route_info"].update(provider="gemini", model=agent.model)
+        return _response(payload)
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake_call_llm)
+    result = server._methods["prompt.project_speech"](
+        "bad-output",
+        {
+            "session_id": "sid",
+            "text": "早安",
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+        },
+    )
+    assert result == {
+        "jsonrpc": "2.0",
+        "id": "bad-output",
+        "error": {"code": 5030, "message": "speech projection failed"},
+    }
+    assert session["history"] == original_history
+
+
+@pytest.mark.parametrize(
+    "session_change",
+    [
+        {"source": "desktop"},
+        {"archived": False},
+        {"_durable_lineage_root": None},
+    ],
+)
+def test_project_speech_rejects_non_attested_workbench_or_visible_sessions(
+    monkeypatch,
+    session_change,
+):
+    session, _history = _install_session(monkeypatch, _agent())
+    session.update(session_change)
+    attestation = MagicMock(
+        side_effect=AssertionError("untrusted session reached durable attestation")
+    )
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        attestation,
+    )
+    result = server._methods["prompt.project_speech"](
+        "wrong-session",
+        {
+            "session_id": "sid",
+            "text": "早安",
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+        },
+    )
+    assert result["error"]["code"] == 4030
+    attestation.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "session_change",
+    [
+        {"running": True},
+        {"inflight_turn": {"status": "streaming", "user": "早安"}},
+        {"inflight_turn": {"status": "error", "user": "早安"}},
+    ],
+)
+def test_project_speech_rejects_running_or_retained_inflight_turns(
+    monkeypatch,
+    session_change,
+):
+    session, _history = _install_session(monkeypatch, _agent())
+    session.update(session_change)
+    attestation = MagicMock(
+        side_effect=AssertionError("busy session reached durable attestation")
+    )
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        attestation,
+    )
+    result = server._methods["prompt.project_speech"](
+        "busy-session",
+        {
+            "session_id": "sid",
+            "text": "早安",
+            "display_locale": "zh-Hant",
+            "speech_locale": "ja",
+        },
+    )
+    assert result["error"]["code"] == 4090
+    attestation.assert_not_called()
+
+
+def test_project_speech_rejects_failed_durable_lineage_reattestation(monkeypatch):
+    session, original_history = _install_session(monkeypatch, _agent())
+    monkeypatch.setattr(
+        server,
+        "_attest_durable_lineage_postcondition",
+        MagicMock(side_effect=ValueError("lineage drift")),
