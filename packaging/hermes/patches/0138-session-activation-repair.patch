+"""Real resume dispatcher and durable DB; no provider/network/player data."""
+import copy
+import json
+import threading
+import types
+
+import pytest
+from hermes_state import SessionDB
+from tui_gateway import server
+from tests.tui_gateway.test_runtime_authority_races import _Agent, _install_build_stubs
+
+ROUTE = {"model": "deepseek-flash", "provider": "deepseek"}
+
+
+def params():
+    return dict(session_id="game-root", source="lilith-game",
+                require_durable_lineage=True, expected_source="lilith-game",
+                expected_archived=True, close_on_disconnect=True,
+                game_model_route=dict(ROUTE))
+
+
+@pytest.fixture
+def fixture(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("game-root", source="lilith-game", archived=True,
+                      model="qwen-old", model_config={
+                          "provider": "alibaba", "base_url": "https://old.invalid/v1",
+                          "reasoning_config": {"effort": "high"}, "service_tier": "priority"})
+    db.append_messages_batch("game-root", [{"role": "user", "content": "stored question"},
+                                           {"role": "assistant", "content": "stored answer"}])
+    known = dict(server._sessions)
+    server._sessions.clear()
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_profile_home", lambda profile: None)
+    monkeypatch.setattr(server, "_profile_configured_cwd", lambda home: str(tmp_path))
+    monkeypatch.setattr(server, "_default_session_cwd", lambda: str(tmp_path))
+    monkeypatch.setattr(server, "_config_model_target", lambda: (ROUTE["model"], ROUTE["provider"]))
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *a: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(server, "_maybe_schedule_auto_continue", lambda *a: None)
+    monkeypatch.setattr(server, "_child_run_active", lambda *a: False)
+    built = []
+
+    def make_agent(*args, **kwargs):
+        built.append(copy.deepcopy(kwargs))
+        if kwargs.get("provider_override") == "alibaba":
+            raise RuntimeError("synthetic missing old key")
+        return _Agent(kwargs)
+
+    _install_build_stubs(monkeypatch, make_agent)
+    try:
+        yield db, built
+    finally:
+        for session in server._sessions.values():
+            worker = session.get("_agent_build_thread")
+            if worker is not None:
+                worker.join(5)
+                assert not worker.is_alive()
+        server._sessions.clear()
+        server._sessions.update(known)
+        db.close()
+
+
+def resume(payload):
+    return server.handle_request({"id": "resume-test", "method": "session.resume", "params": payload})
+
+
+@pytest.mark.parametrize("omit", [False, True])
+def test_game_rebase_precedes_first_build_and_retains_history(fixture, omit):
+    db, built = fixture
+    before = db.get_messages_as_conversation("game-root")
+    payload = params()
+    payload["omit_messages"] = omit
+    result = resume(payload)
+    assert "error" not in result, result
+    sid = result["result"]["session_id"]
+    session = server._sessions[sid]
+    assert session["model_override"] == ROUTE
+    assert session["resume_runtime_overrides"] == {"model_override": ROUTE, "provider_override": "deepseek"}
+    assert result["result"]["durable_lineage"]["resolved_session_id"] == "game-root"
+    server._start_agent_build(sid, session)
+    assert session["agent_ready"].wait(5)
+    assert session.get("agent_error") is None
+    assert built and all(row["provider_override"] == "deepseek" for row in built)
+    assert db.get_messages_as_conversation("game-root") == before
+    assert db.get_session("game-root")["model"] == "qwen-old"
+
+
+def test_ordinary_chat_keeps_its_independent_model(fixture):
+    result = resume({"session_id": "game-root"})
+    assert "error" not in result, result
+    session = server._sessions[result["result"]["session_id"]]
+    assert session["model_override"]["provider"] == "alibaba"
+    assert session["model_override"]["model"] == "qwen-old"
+
+
+def test_failed_hot_game_builder_can_rebase_without_replacing_lineage(fixture):
+    previous_contract = params()
+    previous_contract.pop("game_model_route")
+    result = resume(previous_contract)
+    sid = result["result"]["session_id"]
+    session = server._sessions[sid]
+    server._start_agent_build(sid, session)
+    assert session["agent_ready"].wait(5)
+    session["_agent_build_thread"].join(5)
+    assert session["agent"] is None
+    result = resume(params())
+    assert "error" not in result, result
+    assert result["result"]["session_id"] == sid
+    assert session["agent_ready"].wait(5)
+    assert session["agent"] is not None
+    assert session["agent"].provider == "deepseek"
+
+
+def test_rebase_does_not_mutate_an_installed_agent():
+    old = types.SimpleNamespace(model="old", provider="old")
+    session = {"agent": old, "agent_runtime_revision": 7,
+               "model_override": {"model": "old", "provider": "old"}}
+    server._runtime_authority_lock(session)
+    before = copy.copy(session)
+    assert server._commit_runtime_desire(session, model_override=ROUTE, _only_if_unbuilt=True) == 7
+    assert session == before
+
+
+def test_inflight_old_builder_cannot_publish_after_rebase(fixture, monkeypatch):
+    entered, release = threading.Event(), threading.Event()
+    candidates = []
+
+    def build(*args, **kwargs):
+        agent = _Agent(kwargs)
+        candidates.append(agent)
+        if agent.provider == "alibaba":
+            entered.set()
+            assert release.wait(5)
+        return agent
+
+    monkeypatch.setattr(server, "_make_agent", build)
+    previous = params()
+    previous.pop("game_model_route")
+    result = resume(previous)
+    sid = result["result"]["session_id"]
+    session = server._sessions[sid]
+    server._start_agent_build(sid, session)
+    try:
+        assert entered.wait(5)
+        result = resume(params())
+        assert "error" not in result, result
+    finally:
+        release.set()
+    assert session["agent_ready"].wait(5)
+    assert session["agent"].provider == "deepseek"
+    assert candidates[0].closed
+
+
+@pytest.mark.parametrize("change", [
+    {"source": "lilith-runtime"}, {"expected_source": "telegram"},
+    {"expected_archived": False}, {"close_on_disconnect": False},
+    {"profile": "another"}, {"lazy": True}, {"eager_build": True},
+    {"game_model_route": None}, {"game_model_route": {}},
+    {"game_model_route": {"model": "wrong", "provider": "deepseek"}},
+    {"game_model_route": {"model": "deepseek-flash", "provider": "alibaba"}},
+    {"game_model_route": {**ROUTE, "base_url": "https://wrong.invalid"}},
+])
+def test_invalid_or_stale_game_route_is_rejected_before_materialization(fixture, change):
+    payload = params()
+    payload.update(change)
+    result = resume(payload)
+    assert "error" in result
+    assert not server._sessions
+    assert not fixture[1]
+
+
+def test_game_route_cannot_override_durable_source(fixture):
+    db, built = fixture
+    db.create_session("ordinary", source="cli", archived=True)
+    payload = params()
+    payload["session_id"] = "ordinary"
+    result = resume(payload)
+    assert result["error"]["code"] == 4094
+    assert not server._sessions and not built
