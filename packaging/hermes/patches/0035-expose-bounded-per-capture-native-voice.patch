+def cancel_continuous_capture() -> bool:
+    """Retire the active or transcribing capture without waiting for STT.
+
+    Python cannot safely kill a blocked native transcription thread. The epoch
+    is still advanced so every callback/state mutation in that worker becomes
+    a no-op, but the shared in-process model means the generation is no longer
+    reusable. If transcription is in flight, or native start/cancel does not
+    retire boundedly, this process stays fail-closed until Runtime kills the
+    Job. A recording-only cancel may be reused after the exact recorder is
+    physically closed.
+    """
+    global _continuous_active, _continuous_stopping, _continuous_epoch
+    global _continuous_recorder
+    global _continuous_on_transcript, _continuous_on_status
+    global _continuous_on_silent_limit, _continuous_on_stop_phrase
+    global _continuous_no_speech_count, _continuous_language
+    global _continuous_pinned_local_model_path
+    global _continuous_recognize_stop_phrase
+    global _continuous_transcribing_epoch
+    global _continuous_start_epoch, _continuous_start_completed
+    global _continuous_retirement_failed
+    global _continuous_cancel_completed, _continuous_cancel_result
+
+    with _continuous_lock:
+        if (
+            _continuous_stopping
+            and _continuous_recorder is None
+            and _continuous_cancel_completed is not None
+        ):
+            cancel_completed = _continuous_cancel_completed
+            reentrant = True
+            rec = None
+            start_completed = None
+            retired_epoch = _continuous_epoch
+        else:
+            reentrant = False
+            cancel_completed = threading.Event()
+            _continuous_cancel_completed = cancel_completed
+            _continuous_cancel_result = None
+            retired_epoch = _continuous_epoch
+            transcription_in_flight = (
+                _continuous_transcribing_epoch == retired_epoch
+            )
+            _continuous_epoch += 1
+            rec = _continuous_recorder
+            start_completed = (
+                _continuous_start_completed
+                if _continuous_start_epoch == retired_epoch
+                else None
+            )
+            # Detach before any potentially blocking native shutdown. The
+            # process remains ``stopping`` until physical close is proven, so
+            # no direct wrapper caller can open a replacement stream early.
+            _continuous_recorder = None
+            _continuous_active = False
+            _continuous_stopping = rec is not None
+            _continuous_transcribing_epoch = None
+            _continuous_on_transcript = None
+            _continuous_on_status = None
+            _continuous_on_silent_limit = None
+            _continuous_on_stop_phrase = None
+            _continuous_no_speech_count = 0
+            _continuous_language = None
+            _continuous_pinned_local_model_path = None
+            _continuous_recognize_stop_phrase = True
+            _continuous_start_epoch = None
+            _continuous_start_completed = None
+
+    if reentrant:
+        if not cancel_completed.wait(
+            timeout=_CONTINUOUS_NATIVE_RETIRE_TIMEOUT_SECONDS + 0.5
+        ):
+            return False
+        with _continuous_lock:
+            return _continuous_cancel_result is True
+
+    if rec is None:
+        physically_retired = not _continuous_retirement_failed
+    elif start_completed is not None and not start_completed.wait(
+        timeout=_CONTINUOUS_NATIVE_RETIRE_TIMEOUT_SECONDS
+    ):
+        logger.error("timed out waiting for continuous recorder start retirement")
+        physically_retired = False
+    else:
+        physically_retired = _retire_native_recorder_once(retired_epoch, rec)
+
+    if transcription_in_flight:
+        logger.error(
+            "cancelled capture has an in-flight transcription; "
+            "Runtime generation recovery is required"
+        )
+    retired = physically_retired and not transcription_in_flight
+
+    with _continuous_lock:
+        if retired:
+            _continuous_stopping = False
+            _continuous_retirement_failed = False
+        else:
+            _continuous_stopping = True
+            _continuous_retirement_failed = True
+        _continuous_cancel_result = retired
+    cancel_completed.set()
+    return retired
+
+
+def _cancel_native_recorder_bounded(recorder: Any) -> bool:
+    """Physically close one detached recorder or require Job recovery."""
+    completed = threading.Event()
+    failed: list[BaseException] = []
+
+    def _cancel() -> None:
+        try:
+            shutdown = getattr(recorder, "shutdown", None)
+            if not callable(shutdown) or shutdown() is not True:
+                raise RuntimeError(
+                    "native recorder did not prove physical stream shutdown"
+                )
+        except BaseException as exc:
+            failed.append(exc)
+        finally:
+            completed.set()
+
+    threading.Thread(target=_cancel, daemon=True).start()
+    if not completed.wait(timeout=_CONTINUOUS_NATIVE_RETIRE_TIMEOUT_SECONDS):
+        logger.error("timed out cancelling continuous recorder")
+        return False
+    if failed:
+        logger.warning("failed to cancel continuous recorder: %s", failed[0])
+        return False
+    return True
+
+
+def _retire_native_recorder_once(epoch: int, recorder: Any) -> bool:
+    """Share one bounded physical shutdown across Start/Cancel racers."""
+    global _continuous_retirement_epoch
+    global _continuous_retirement_completed, _continuous_retirement_result
+
+    with _continuous_lock:
+        if (
+            _continuous_retirement_epoch == epoch
+            and _continuous_retirement_completed is not None
+        ):
+            completed = _continuous_retirement_completed
+            owns_shutdown = False
+        else:
+            completed = threading.Event()
+            _continuous_retirement_epoch = epoch
+            _continuous_retirement_completed = completed
+            _continuous_retirement_result = None
+            owns_shutdown = True
+
+    if owns_shutdown:
+        result = _cancel_native_recorder_bounded(recorder)
+        with _continuous_lock:
+            if _continuous_retirement_epoch == epoch:
+                _continuous_retirement_result = result
+        completed.set()
+    elif not completed.wait(
+        timeout=_CONTINUOUS_NATIVE_RETIRE_TIMEOUT_SECONDS + 0.25
+    ):
+        return False
+
+    with _continuous_lock:
+        return (
+            _continuous_retirement_epoch == epoch
+            and _continuous_retirement_result is True
+        )
+
+
+def _continuous_epoch_is_current(epoch: int) -> bool:
+    with _continuous_lock:
+        return epoch == _continuous_epoch
+
