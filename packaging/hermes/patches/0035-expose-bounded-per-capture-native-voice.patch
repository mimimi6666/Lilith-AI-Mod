+            },
+            owns_listener=lambda owner: owner is wake_transport,
+            pause_listening=lambda *, owner: False,
+            resolve_capture_mode=lambda _cfg, *, prefer_client: "server",
+            start_listening=lambda *_args, **_kwargs: None,
+            wake_phrase=lambda _cfg: "wake",
+            wake_surface_enabled=lambda _surface, _cfg: True,
+        ),
+    )
+
+    voice_response = []
+    voice_thread = threading.Thread(
+        name="scoped-voice-start",
+        target=lambda: voice_response.append(
+            server._methods["voice.record"]("voice-start", _start_params())
+        ),
+    )
+    voice_thread.start()
+    assert snapshot_taken.wait(timeout=5)
+
+    wake_response = server._methods["wake.start"](
+        "wake-start",
