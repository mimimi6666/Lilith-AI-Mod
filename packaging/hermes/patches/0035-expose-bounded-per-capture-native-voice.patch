+    def _current_transport():
+        return (
+            voice_transport
+            if threading.current_thread().name == "scoped-voice-start"
+            else wake_transport
+        )
+
+    voice_snapshot_seen = False
+
+    def _coordinated_snapshot():
+        nonlocal voice_snapshot_seen
+        if (
+            threading.current_thread().name == "scoped-voice-start"
+            and not voice_snapshot_seen
+        ):
+            voice_snapshot_seen = True
+            snapshot_taken.set()
+            assert wake_started.wait(timeout=5)
+            # This is the stale optimistic snapshot that exposed the race.
+            return None, ""
+        return original_snapshot()
+
+    class _WakeWordInUse(Exception):
+        pass
+
+    monkeypatch.setattr(server, "current_transport", _current_transport)
+    monkeypatch.setattr(server, "_wake_owner_snapshot", _coordinated_snapshot)
+    monkeypatch.setitem(
+        sys.modules,
+        "tools.wake_word",
+        types.SimpleNamespace(
+            WakeWordInUse=_WakeWordInUse,
+            check_wake_word_requirements=lambda _cfg: {
