+def test_wake_start_finishing_after_preclaim_snapshot_cannot_open_second_mic(
+    monkeypatch,
+):
+    import threading
+
+    wrapper = _install_voice_wrapper(monkeypatch)
+    voice_transport = object()
+    wake_transport = object()
+    snapshot_taken = threading.Event()
+    wake_started = threading.Event()
+    original_snapshot = server._wake_owner_snapshot
