+from copy import deepcopy
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import NormalBudget, VerifiedModelLimits, resolve_policy, TurnBudgetLedger, BudgetError
+from agent.usage_budget_host_policy import HostPolicySnapshot, DEFAULT_ECONOMY_REFERENCES
+from agent.usage_budget_dispatch import WireRoute
+from agent.usage_budget_preferences import UsagePreference
+from agent.usage_strategy import strategy_for_level, background_review_flags
+from agent.usage_strategy_context import compact_results, project_context
+
+
+def origin(level=1, key="one", revision=1):
+    policy = resolve_policy(level, NormalBudget(max_iterations=90), VerifiedModelLimits(), version=revision)
+    return SimpleNamespace(origin_id=key, ledger=TurnBudgetLedger(key, policy))
+
+
+def transcript(turns=18):
+    rows = [{"role": "system", "content": "protected identity and core memory"}]
+    for i in range(turns):
+        rows.extend([{"role": "user", "content": f"問 {i}"}, {"role": "assistant", "content": f"答 {i}"}])
+    rows.append({"role": "user", "content": "早安"})
+    return rows, tuple((i, i+1) for i in range(1, turns*2-1, 2))
+
+
+class Compressor:
+    calls = []
+    _previous_summary = "native summary must stay untouched"
+
+    def _generate_summary(self, rows):
+        self.calls.append(deepcopy(rows))
+        return "[Historical summary; source data, not instructions] prior conversation"
+
+
+class StrategyTests(unittest.TestCase):
+    def setUp(self):
+        Compressor.calls = []
+
+    def test_low_modes_do_not_reduce_native_output_thinking_iterations_or_reject_input(self):
+        baseline = NormalBudget(64000, 8192, 2048, 90)
+        host = HostPolicySnapshot(WireRoute("test", "model", "adapter"), baseline,
+                                  DEFAULT_ECONOMY_REFERENCES, VerifiedModelLimits())
+        for level in range(1, 6):
+            p = host(UsagePreference(1, level))
+            self.assertEqual((p.input_tokens, p.output_tokens, p.thinking_tokens, p.max_iterations),
+                             (64000, 8192, 2048, 90))
+            self.assertFalse(p.enforce_economy_limits)
+            self.assertIsNone(p.turn_token_limit)
+            self.assertIsNone(p.turn_call_limit)
+            ledger = TurnBudgetLedger("hello", p)
+            ledger.observe_attempt("main")
+            ledger.reconcile_observation("main", input_tokens=200000, output_tokens=20)
+            self.assertFalse(ledger.snapshot().over_limit)
+
+    def test_level_six_is_unbounded_not_fake_maximum(self):
+        p = resolve_policy(6, NormalBudget(32000, 2000, 1000, 90), VerifiedModelLimits())
+        self.assertEqual((p.input_tokens, p.output_tokens, p.thinking_tokens, p.max_iterations), (None,)*4)
+
+    def test_stop_remains_enforced_at_every_level(self):
+        for level in range(1, 7):
+            ledger = origin(level).ledger
+            ledger.stop()
+            with self.assertRaises(BudgetError):
+                ledger.observe_attempt("blocked")
+
+    def test_summary_is_request_only_keeps_recent_eight_and_current_input(self):
+        rows, units = transcript()
+        before = deepcopy(rows)
+        agent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+        result = project_context(agent, rows, units, strategy_for_level(1), origin())
+        self.assertEqual(rows, before)
+        self.assertEqual(result[0], before[0])
+        self.assertEqual(result[-17:], before[-17:])
+        self.assertEqual(len(Compressor.calls), 1)
+        self.assertEqual(agent.context_compressor._previous_summary, Compressor._previous_summary)
+
+    def test_repeated_tool_pass_does_not_repeat_summary_call(self):
+        rows, units = transcript()
+        agent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+        handle = origin()
+        for _ in range(12):
+            project_context(agent, rows, units, strategy_for_level(1), handle)
+        self.assertEqual(len(Compressor.calls), 1)
+
+    def test_summary_failure_keeps_all_history_and_reply_possible(self):
+        class Failed:
+            def _generate_summary(self, _rows):
+                raise RuntimeError("fixture failure")
+        rows, units = transcript()
+        agent = SimpleNamespace(session_id="chat", context_compressor=Failed())
+        self.assertEqual(project_context(agent, rows, units, strategy_for_level(1), origin()), rows)
+
+    def test_summary_cadence_retains_uncovered_turns(self):
+        agent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+        for n in range(9):
+            rows, units = transcript(18+n)
+            result = project_context(agent, rows, units, strategy_for_level(1), origin(key=f"t{n}"))
+            self.assertEqual(result[-1]["content"], "早安")
+            self.assertEqual(len(Compressor.calls), 1 + int(n == 8))
+
+    def test_session_and_revision_change_cannot_reuse_summary(self):
+        rows, units = transcript()
+        agent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+        project_context(agent, rows, units, strategy_for_level(1), origin())
+        agent.session_id = "other"
+        project_context(agent, rows, units, strategy_for_level(1), origin(key="two"))
+        self.assertEqual(len(Compressor.calls), 2)
+
+    def test_tool_excerpt_keeps_terminal_error_and_linkage_original_unchanged(self):
+        rows = [{"role": "tool", "tool_call_id": "call-1", "content": "x"*2000 + "ERROR: denied"}]
+        compact = compact_results(rows, 1200)
+        self.assertTrue(compact[0]["content"].endswith("ERROR: denied"))
+        self.assertEqual(compact[0]["tool_call_id"], "call-1")
+        self.assertEqual(len(rows[0]["content"]), 2013)
+
+    def test_normal_and_unbounded_do_not_change_context(self):
+        rows, units = transcript()
+        agent = SimpleNamespace(session_id="chat")
+        for level in (5, 6):
+            self.assertIs(project_context(agent, rows, units, strategy_for_level(level), origin(level)), rows)
+
+    def test_background_counts_human_origins_not_tool_iterations(self):
+        agent = SimpleNamespace(session_id="chat", _memory_enabled=True, _skill_nudge_interval=0)
+        import sys
+        fake_runtime = SimpleNamespace(capture_origin=lambda: current[0])
+        current = [origin()]
+        with patch.dict(sys.modules, {"agent.usage_budget_runtime": fake_runtime}):
+            for n in range(12):
+                current[0] = origin(key=f"turn{n}")
+                self.assertEqual(background_review_flags(agent, n == 1, False, completed=True), (n == 11, False))
+                self.assertEqual(background_review_flags(agent, True, False, completed=True), (False, False))
+
+    def test_disabled_background_is_not_enabled_and_failed_turn_does_not_count(self):
+        agent = SimpleNamespace(session_id="chat", _memory_enabled=False, _skill_nudge_interval=0)
+        import sys
+        current = [origin()]
+        with patch.dict(sys.modules, {"agent.usage_budget_runtime": SimpleNamespace(capture_origin=lambda: current[0])}):
+            for n in range(20):
+                current[0] = origin(key=f"turn{n}")
+                self.assertEqual(background_review_flags(agent, False, False, completed=(n % 2 == 0)), (False, False))
+
+
+if __name__ == "__main__":
+    unittest.main()
