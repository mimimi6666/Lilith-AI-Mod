@@ -0,0 +1,84 @@
+"""Immutable information strategies, not quotas, permissions or model choices."""
+from dataclasses import asdict, dataclass
+
+STRATEGY_VERSION = "lilith-strategies-20260927-v1"
+
+
+@dataclass(frozen=True)
+class InformationStrategy:
+    history_turns: int | None = None
+    relationship_every: int = 1
+    summary_every: int = 1
+    summary_target_tokens: int | None = None
+    old_tool_chars: int | None = None
+    background_every: int = 1
+
+    def wire(self):
+        return asdict(self)
+
+
+_STRATEGIES = (
+    InformationStrategy(8, 8, 8, 800, 1200, 12),
+    InformationStrategy(12, 6, 6, 1200, 2400, 8),
+    InformationStrategy(16, 4, 4, 1800, 4000, 6),
+    InformationStrategy(24, 2, 2, 2600, 6000, 3),
+    InformationStrategy(),
+    InformationStrategy(),
+)
+
+
+def strategy_for_level(level):
+    if type(level) is not int or not 1 <= level <= 6:
+        raise ValueError("invalid_strategy_level")
+    return _STRATEGIES[level - 1]
+
+
+def current_strategy():
+    from agent.usage_budget import current_turn_budget
+    ledger = current_turn_budget()
+    return strategy_for_level(ledger.policy.level if ledger is not None else 5)
+
+
+def background_review_flags(agent, memory, skills, *, completed):
+    """Count eligible completed human turns, retaining enabled pending work.
+
+    No new task, timer, thread, or enabled flag is created here. Turn ID dedup
+    prevents a tool iteration/replayed finalizer from advancing the cadence.
+    """
+    from agent.usage_budget_runtime import capture_origin
+    origin = capture_origin()
+    if origin is None or not completed or getattr(agent, "skip_background_review", False):
+        return (memory, skills) if origin is None and completed else (False, False)
+    spec = origin.ledger.policy.information_strategy
+    memory_enabled = (getattr(agent, "_memory_enabled", False) is True
+                      or getattr(agent, "_user_profile_enabled", False) is True)
+    skills_enabled = (getattr(agent, "_skill_nudge_interval", 0) > 0
+                      and "skill_manage" in getattr(agent, "valid_tool_names", ()))
+    if spec.history_turns is None:
+        # Restore existing behavior, carrying only flags still enabled below.
+        prior = getattr(agent, "_information_background", None)
+        agent._information_background = None
+        return (bool(memory or (isinstance(prior, dict) and prior["memory"] and memory_enabled)),
+                bool(skills or (isinstance(prior, dict) and prior["skills"] and skills_enabled)))
+    key = (agent.session_id, origin.ledger.policy.level, origin.ledger.policy.version)
+    state = getattr(agent, "_information_background", None)
+    if not isinstance(state, dict) or state["key"] != key:
+        same_session = isinstance(state, dict) and state["key"][0] == agent.session_id
+        state = {"key": key, "last": None, "turns": 0,
+                 "memory": bool(same_session and state["memory"]),
+                 "skills": bool(same_session and state["skills"])}
+        agent._information_background = state
+    if state["last"] == origin.origin_id:
+        return False, False
+    state["last"] = origin.origin_id
+    state["turns"] += 1
+    state["memory"] |= bool(memory)
+    state["skills"] |= bool(skills)
+    state["memory"] &= memory_enabled
+    state["skills"] &= skills_enabled
+    if state["turns"] < spec.background_every:
+        return False, False
+    state["turns"] = 0
+    result = state["memory"], state["skills"]
+    state["memory"] = state["skills"] = False
+    return result
