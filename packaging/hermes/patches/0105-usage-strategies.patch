+++ b/agent/usage_strategy_context.py
@@ -0,0 +1,102 @@
+"""Request-local rolling summary and old-result projection. No transcript writes.
+
+Only immutable, structurally closed pre-turn exchanges are eligible. A failed
+summary keeps uncovered originals; the next model reply is never budget-blocked.
+The native summarizer supplies identity/redaction/provenance/usage boundaries.
+"""
+from copy import copy, deepcopy
+import hashlib
+import json
+
+
+def compact_results(rows, chars):
+    result = deepcopy(rows)
+    if chars is None:
+        return result
+    # Keep call IDs, arguments, order, errors and result boundaries. Dedup text
+    # only, never actions; latest duplicate remains the authoritative full one.
+    seen = set()
+    for row in reversed(result):
+        if row.get("role") != "tool" or not isinstance(row.get("content"), str):
+            continue
+        text = row["content"]
+        key = hashlib.sha256(text.encode("utf-8")).hexdigest()
+        if key in seen and len(text) > 200:
+            row["content"] = "[Repeated historical tool result; same text appears later.]"
+        elif len(text) > chars:
+            # A visible tail preserves terminal failures/outcomes often printed
+            # after long logs. This is labelled truncation, not invented summary.
+            head = chars * 2 // 3
+            row["content"] = text[:head] + "\n[Old tool output excerpt; full result in chat history]\n" + text[-(chars-head):]
+        seen.add(key)
+    return result
+
+
+def _key(rows):
+    return hashlib.sha256(json.dumps(rows, sort_keys=True, ensure_ascii=True,
+                                    separators=(",", ":")).encode()).hexdigest()
+
+
+def project_context(agent, projected, units, spec, origin):
+    if spec.history_turns is None or not units:
+        return projected
+    tool_indices = tuple(i for unit in units[:-1] for i in unit)
+    excerpts = compact_results([projected[i] for i in tool_indices], spec.old_tool_chars)
+    replacements = dict(zip(tool_indices, excerpts))
+    # capture_completed_history already protects the latest completed exchange.
+    old = units[:max(0, len(units) - (spec.history_turns - 1))]
+    if not old:
+        return [replacements.get(i, row) for i, row in enumerate(projected)]
+    state_key = (agent.session_id, origin.ledger.policy.level, origin.ledger.policy.version)
+    state = getattr(agent, "_information_summary", None)
+    if not isinstance(state, dict) or state["key"] != state_key:
+        state = {"key": state_key, "covered": (), "summary": "", "last": None, "attempt_count": None}
+        agent._information_summary = state
+    keys = tuple(_key([projected[i] for i in unit]) for unit in old)
+    covered = state["covered"]
+    if keys[:len(covered)] != covered:
+        # Rewind/edit/compaction invalidates the old source proof. Never inject
+        # a stale summary into a changed or different conversation.
+        state.update(covered=(), summary="", attempt_count=None)
+        covered = ()
+    new_origin = state["last"] != origin.origin_id
+    if new_origin:
+        state["last"] = origin.origin_id
+    due = state["attempt_count"] is None or len(keys) - state["attempt_count"] >= spec.summary_every
+    if (new_origin and len(keys) > len(covered) and due
+            and not origin.ledger.snapshot().stopped):
+        # Cadence advances with newly completed exchanges, not failed attempts,
+        # model/tool iterations or multiple requests in the same human turn.
+        state["attempt_count"] = len(keys)
+        compressor = getattr(agent, "context_compressor", None)
+        # Own a private working copy: no archive_and_compact or compressor state
+        # mutation. _generate_summary is the native redacted auxiliary call.
+        if compressor is not None and callable(getattr(compressor, "_generate_summary", None)):
+            checkpoint = copy(compressor)
+            recorder = getattr(compressor, "_record_aux_compression_call", None)
+            if callable(recorder):
+                checkpoint._record_aux_compression_call = recorder
+            checkpoint._previous_summary = state["summary"] or None
+            checkpoint._compute_summary_budget = lambda _rows: spec.summary_target_tokens
+            rows = [projected[i] for unit in old[len(covered):] for i in unit]
+            try:
+                summary = checkpoint._generate_summary(compact_results(rows, spec.old_tool_chars))
+            except Exception:
+                summary = None
+            if isinstance(summary, str) and summary.strip() and not origin.ledger.snapshot().stopped:
+                state.update(covered=keys, summary=summary)
+                covered = keys
+    removed = {i for unit in old[:len(covered)] for i in unit}
+    # Uncovered exchanges are still sent (with old-result excerpts). Current
+    # input, latest history, non-eligible rows and tool payloads are untouched.
+    result = []
+    for i, row in enumerate(projected):
+        if removed and i == min(removed):
+            result.append({"role": "user", "content": state["summary"]})
+        if i not in removed:
+            result.append(replacements.get(i, row))
+    agent._usage_budget_context_status = {
+        "strategy": "information_v1", "history_target_turns": spec.history_turns,
+        "summarized_turns": len(covered), "uncovered_turns_retained": len(old)-len(covered),
+    }
+    return result
