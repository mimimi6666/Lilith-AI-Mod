+def _lilith_chat_sound_enabled() -> bool:
+    """One non-authoritative UI preference. Never read chat/profile credentials.
+
+    Missing preferences preserve upstream behavior; malformed/linked files mute.
+    Re-read per send so the toggle does not require a gateway restart.
+    """
+    if os.name != "nt":
+        return True
+    try:
+        import json
+        import stat
+        from pathlib import Path
+
+        root = os.environ.get("LOCALAPPDATA", "")
+        if not root or not Path(root).is_absolute():
+            return False
+        path = Path(root) / "LilithAiMod" / "Config" / "control-center" / "ui-v1.json"
+        for item in (path, *path.parents):
+            try:
+                info = item.lstat()
+            except FileNotFoundError:
+                continue
+            if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+                return False
+        try:
+            with path.open("rb") as source:
+                raw = source.read(4097)
+        except FileNotFoundError:
+            return True
+        if not 0 < len(raw) <= 4096:
+            return False
+        pairs = json.loads(raw, object_pairs_hook=list)
+        if not isinstance(pairs, list) or len(pairs) != 4:
+            return False
+        value = dict(pairs)
+        if set(value) != {"Schema", "Revision", "Language", "ChatSendSoundEnabled"}:
+            return False
+        if (type(value["Schema"]) is not int or value["Schema"] != 1
+                or type(value["Revision"]) is not int or not 0 <= value["Revision"] < 2**63 - 1
+                or value["Language"] not in ("zh-TW", "zh-CN", "ja-JP", "en-US")
+                or type(value["ChatSendSoundEnabled"]) is not bool):
+            return False
+        return value["ChatSendSoundEnabled"]
+    except Exception:
+        return False
+
+
 def thinking_sound_enabled() -> bool:
     """Config gate: ``voice.thinking_sound`` (default True)."""
+    if not _lilith_chat_sound_enabled():
+        return False
     try:
         from hermes_cli.config import load_config
         from utils import is_truthy_value
