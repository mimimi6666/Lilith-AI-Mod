+@dataclass(frozen=True, slots=True)
+class GameContextDiagnosticLease:
+    """Content-free opt-in grant, carried only by the authenticated test turn."""
+    trace_id: str
+    expires_at_ms: int
+
+
+def parse_diagnostic_request(value, now_ms=None):
+    """Validate the exact bounded grant; expiry quietly disables diagnostics."""
+    if value is None:
+        return None
+    now_ms = int(time.time() * 1000) if now_ms is None else now_ms
+    if type(value) is GameContextDiagnosticLease:
+        trace_id, expiry = value.trace_id, value.expires_at_ms
+    else:
+        if type(value) is not dict or set(value) != {"traceId", "expiresAtUnixMs"}:
+            raise ValueError("invalid mini-game diagnostic grant")
+        trace_id, expiry = value["traceId"], value["expiresAtUnixMs"]
+    if (type(trace_id) is not str or not _GUID.fullmatch(trace_id) or trace_id == "0" * 32
+            or type(expiry) is not int or expiry < 1 or expiry > 253402300799999
+            or type(now_ms) is not int or now_ms < 1 or expiry > now_ms + 1800000):
+        raise ValueError("invalid mini-game diagnostic grant")
+    return GameContextDiagnosticLease(trace_id, expiry) if expiry > now_ms else None
+
+
+def diagnostic_grant_wire(value):
+    lease = parse_diagnostic_request(value)
+    return ({"traceId": lease.trace_id, "expiresAtUnixMs": lease.expires_at_ms}
+            if lease is not None else None)
+
+
+def diagnostic_context_status(before, after):
+    """No payload inspection: callers supply the result of their normal parse."""
+    return "absent" if before is None else "fresh" if after is not None else "stale"
+
+
+class GameContextDiagnosticObserver:
+    """One accepted turn, at most one event per stage; never stored on an agent.
+
+    The observer stores only the immutable grant, native turn identity, callback
+    and a three-item stage set. It never retains a context, prompt or request.
+    Optional evidence failures cannot change the ordinary conversation outcome.
+    """
+    __slots__ = ("_lease", "_turn_id", "_emit", "_seen")
+
+    def __init__(self, lease, turn_id, emit):
+        if (type(lease) is not GameContextDiagnosticLease or type(turn_id) is not str
+                or not _GUID.fullmatch(turn_id) or turn_id == "0" * 32 or not callable(emit)):
+            raise ValueError("invalid mini-game diagnostic observer")
+        self._lease, self._turn_id, self._emit = lease, turn_id, emit
+        self._seen = set()
+
+    def observe(self, stage, status, *, route="not-observed", strict_policy_enabled=None):
+        try:
+            if stage not in {"ingress", "agent", "dispatch"} or stage in self._seen:
+                return
+            if int(time.time() * 1000) >= self._lease.expires_at_ms:
+                return
+            statuses = {"present", "absent", "omitted-moa"} if stage == "dispatch" else {"fresh", "stale", "absent"}
+            if status not in statuses or route not in {"not-observed", "chat", "responses", "anthropic", "bedrock", "other"}:
+                return
+            if stage != "dispatch" and (route != "not-observed" or strict_policy_enabled is not None):
+                return
+            if strict_policy_enabled is not None and type(strict_policy_enabled) is not bool:
+                return
+            self._seen.add(stage)
+            self._emit({"traceId": self._lease.trace_id, "turnId": self._turn_id,
+                        "stage": stage, "status": status, "route": route,
+                        "strictPolicyEnabled": strict_policy_enabled})
+        except Exception:
+            # No message, exception text, payload or fallback log is retained.
+            return
+
+    def dispatch(self, request, context, *, provider, api_mode, strict_policy_enabled):
+        """Observe the final prepared main-loop authority, not network receipt.
+
+        Called after middleware, local compatibility and Responses preflight;
+        lower SDK/relay/budget adapters have not yet dispatched the request.
+        """
+        if "dispatch" in self._seen or int(time.time() * 1000) >= self._lease.expires_at_ms:
+            return
+        try:
+            from agent.identity_policy import _provider_authority_text
+            authority = []
+            if type(request) is dict:
+                rows = request.get("messages")
+                if type(rows) is list:
+                    authority.extend(_provider_authority_text(row.get("content")) for row in rows
+                                     if type(row) is dict and row.get("role") in {"system", "developer"})
+                authority.extend(_provider_authority_text(request[key])
+                                 for key in ("instructions", "system") if key in request)
+            present = (type(context) is PublicGameContext
+                       and any(type(text) is str and context.reference in text for text in authority))
+            status = "present" if present else "omitted-moa" if provider == "moa" and context is not None else "absent"
+            route = {"chat_completions": "chat", "codex_responses": "responses",
+                     "anthropic_messages": "anthropic", "bedrock_converse": "bedrock"}.get(api_mode, "other")
+            self.observe("dispatch", status, route=route, strict_policy_enabled=strict_policy_enabled)
+        except Exception:
+            return
+
+
