new file mode 100644
--- /dev/null
+++ b/agent/local_compatibility_checkpoint.py
@@ -0,0 +1,205 @@
+"""Host-owned, bounded process-memory work cache; never durable memory.
+
+Only validated local checkpoint results enter this cache. No transcript, files,
+database, credentials or authority are persisted. A validated summary and its
+source-derived focus contain private semantics in process memory only. Process
+restart intentionally forgets every result. A later caller may reuse an unchanged source
+prefix; this module never schedules, calls a model, or commits conversation state.
+"""
+from collections import OrderedDict
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+import os
+import threading
+import time
+from weakref import WeakValueDictionary
+
+VERSION = "local-checkpoint-resume-v1"
+TTL_SECONDS = 1800.0
+MAX_SCOPES = 16
+MAX_BYTES = 1024 * 1024
+MAX_SUMMARY_BYTES = 65536
+MAX_SOURCE_ROWS = 20000
+_lock = threading.RLock()
+_states = OrderedDict()
+# Live generation fences outlive result eviction only while a caller owns its
+# ticket. Weak values cannot become a second unbounded result store.
+_leases = WeakValueDictionary()
+
+
+def _hash(value):
+    return sha256(value.encode("utf-8")).hexdigest()
+
+
+def _canonical(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(",", ":"), allow_nan=False)
+
+
+@dataclass(frozen=True)
+class _Record:
+    source_rows: tuple
+    boundaries: tuple
+    summary: str
+    focus: str
+
+
+@dataclass(eq=False)
+class _Lease:
+    revoked: bool = False
+
+
+@dataclass(frozen=True)
+class Ticket:
+    scope: str
+    lease: object
+    source_rows: tuple
+    boundaries: tuple = ()
+    summary: str = ""
+    focus: str = ""
+
+    @property
+    def completed(self):
+        return len(self.boundaries)
+
+    @property
+    def consumed(self):
+        return self.boundaries[-1][0] if self.boundaries else 0
+
+
+def _weight(state):
+    record = state[2]
+    if record is None:
+        return 128
+    return (len(record.summary.encode("utf-8")) + len(record.focus.encode("utf-8"))
+            + len(record.source_rows) * 64 + len(record.boundaries) * 80 + 128)
+
+
+def _prune(now):
+    for key, value in list(_states.items()):
+        if now - value[0] >= TTL_SECONDS:
+            del _states[key]
+    while _states and (len(_states) > MAX_SCOPES or sum(map(_weight, _states.values())) > MAX_BYTES):
+        _states.popitem(last=False)
+
+
+def begin(compressor, policy, turns, serialized, contract, previous, focus):
+    """Issue one generation lease; reuse only exact old rows and chunk bytes.
+
+    `contract` is the actual render with empty data and fixed fragment counters.
+    For automatic focus only, the host uses a fixed strategy marker in that
+    render and may retain the old source-derived focus after prefix proof.
+    Explicit focus remains literal in the render and therefore in this key.
+    """
+    from agent.local_compatibility import LocalCompatibilityPolicy, for_agent
+    from agent.usage_budget_runtime import current_origin
+    from agent.identity_policy import scoped_identity_metadata
+    from hermes_cli.config import get_hermes_home
+    if type(policy) is not LocalCompatibilityPolicy:
+        return None
+    agent = getattr(compressor, "_strict_identity_agent", None)
+    if agent is None or for_agent(agent) is not policy:
+        return None
+    session = getattr(agent, "session_id", None)
+    if not isinstance(session, str) or not session or len(session) > 256:
+        return None
+    if not isinstance(turns, list) or len(turns) > MAX_SOURCE_ROWS:
+        return None
+    try:
+        # The only excluded key is the host's transient flush marker. Row IDs,
+        # role, content, source provenance and all other fields remain bound.
+        rows = tuple(_hash(_canonical({key: value for key, value in row.items()
+                                        if key != "_db_persisted"})) for row in turns)
+        origin = current_origin()
+        strategy = None if origin is None else (
+            origin.preference.level, origin.preference.revision)
+        profile = os.path.normcase(os.path.abspath(os.fspath(get_hermes_home())))
+        origin_profile = (None if origin is None else os.path.normcase(os.path.abspath(
+            os.fspath(origin._owner.store.profile_root))))
+        scope = _hash(_canonical((VERSION, profile, origin_profile, session, policy.route_digest,
+            policy.requested_provider, policy.provider, policy.context_tokens,
+            policy.input_budget, policy.output_reserve, strategy,
+            scoped_identity_metadata(agent), contract, previous)))
+    except (TypeError, ValueError, AttributeError):
+        # An unsupported source shape disables optimization, never compaction.
+        return None
+    now, lease = time.monotonic(), _Lease()
+    with _lock:
+        _prune(now)
+        old_lease = _leases.get(scope)
+        if old_lease is not None:
+            old_lease.revoked = True
+        _leases[scope] = lease
+        prior = _states.get(scope)
+        record = prior[2] if prior else None
+        matched = record is not None and rows[:len(record.source_rows)] == record.source_rows
+        if matched:
+            start = 0
+            for end, digest in record.boundaries:
+                if end <= start or end > len(serialized) or _hash(serialized[start:end]) != digest:
+                    matched = False
+                    break
+                start = end
+        if not matched:
+            record = None
+        _states[scope] = (now, lease, record)
+        _states.move_to_end(scope)
+        _prune(now)
+        return Ticket(scope, lease, rows,
+            record.boundaries if record else (), record.summary if record else "",
+            record.focus if record else focus)
+
+
+def publish(ticket, serialized, end, summary, focus, check_cancel):
+    """Publish only on the owning thread after validation and before cancellation.
+
+    A superseded lease cannot publish. Detached transport workers
+    never receive this method or a ticket. A new attempt invalidates old writers.
+    """
+    if ticket is None:
+        return None
+    check_cancel()
+    if not isinstance(summary, str) or len(summary.encode("utf-8")) > MAX_SUMMARY_BYTES:
+        return ticket
+    if type(end) is not int or end <= ticket.consumed or end > len(serialized):
+        raise ValueError("invalid checkpoint boundary")
+    boundary = (end, _hash(serialized[ticket.consumed:end]))
+    updated = Ticket(ticket.scope, ticket.lease, ticket.source_rows,
+                     ticket.boundaries + (boundary,), summary, focus)
+    now = time.monotonic()
+    with _lock:
+        _prune(now)
+        check_cancel()
+        if ticket.lease.revoked:
+            from agent.auxiliary_client import AuxiliaryExplicitCancellation
+            raise AuxiliaryExplicitCancellation()
+        record = _Record(updated.source_rows, updated.boundaries, summary, focus)
+        _states[ticket.scope] = (now, ticket.lease, record)
+        _states.move_to_end(ticket.scope)
+        _prune(now)
+    return updated
+
+
+def check_current(ticket):
+    """An older generation may neither send again nor commit after replacement."""
+    if ticket is None:
+        return
+    with _lock:
+        if ticket.lease.revoked:
+            from agent.auxiliary_client import AuxiliaryExplicitCancellation
+            raise AuxiliaryExplicitCancellation()
+
+
+def preserve_attempt_telemetry(compressor, expected_attempt_id):
+    """Copy only this local attempt's count metadata, not mutable authority."""
+    value = getattr(compressor, "_last_compression_telemetry", None)
+    if (not isinstance(value, dict) or value.get("local_checkpoint_version") != VERSION
+            or not isinstance(expected_attempt_id, str) or not expected_attempt_id
+            or value.get("attempt_id") != expected_attempt_id):
+        return None
+    return {key: value[key] for key in (
+        "event", "attempt_id", "session_id", "trigger_source", "chunking", "chunk_count",
+        "effective_aux_context", "aux_output_reservation", "local_checkpoint_version",
+        "local_chunks_completed", "local_chunks_reused", "local_summary_calls")
+        if key in value and (type(value[key]) in (str, int, bool) or value[key] is None)}
