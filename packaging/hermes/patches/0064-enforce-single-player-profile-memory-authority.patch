+    def has_authoritative_user_profile_provider(self) -> bool:
+        """Return whether the external provider exclusively owns profile writes."""
+
+        for provider in self._providers:
+            if provider.name == "builtin":
+                continue
+            try:
+                if provider.owns_user_profile_writes():
+                    return True
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed its user-profile authority check",
+                    provider.name,
+                    exc_info=True,
+                )
+                # An authority check that fails must not silently hand the same
+                # data to USER.md. Registration is limited to one external
+                # provider, so fail closed for the active provider.
+                return True
+        return False
+
+    def intercept_user_profile_write(
+        self,
+        tool_args: Dict[str, Any],
+        *,
+        build_metadata: Optional[Callable[[], Dict[str, Any]]] = None,
+    ) -> Optional[Any]:
+        """Route ``memory(target='user')`` to an authoritative provider.
+
+        ``None`` means no provider claimed the write and preserves the normal
+        built-in USER.md path. Once a provider claims authority, every error and
+        empty response fails closed so a provider outage cannot create a second,
+        unmanaged profile copy.
+        """
+
+        if str(tool_args.get("target") or "memory") != "user":
+            return None
+
+        for provider in self._providers:
+            if provider.name == "builtin":
+                continue
+            try:
+                owns_writes = provider.owns_user_profile_writes()
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed its user-profile authority check",
+                    provider.name,
+                    exc_info=True,
+                )
+                return tool_error(
+                    "The authoritative user-profile memory is unavailable; no built-in profile write was made.",
+                    success=False,
+                )
+            if not owns_writes:
+                continue
+
+            try:
+                metadata = dict(build_metadata() if build_metadata else {})
+                result = provider.handle_user_profile_write(
+                    dict(tool_args),
+                    metadata=metadata,
+                )
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed an authoritative user-profile write",
+                    provider.name,
+                    exc_info=True,
+                )
+                return tool_error(
+                    "The authoritative user-profile memory is unavailable; no built-in profile write was made.",
+                    success=False,
+                )
+            if result is None:
+                logger.warning(
+                    "Memory provider '%s' claimed user-profile writes but returned no result",
+                    provider.name,
+                )
+                return tool_error(
+                    "The authoritative user-profile memory declined the write; no built-in profile write was made.",
+                    success=False,
+                )
+            return result
+
+        return None
+
