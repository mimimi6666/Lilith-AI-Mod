+def test_slow_workbench_history_never_blocks_session_interrupt(server):
+    """A projection refresh may be slow, but emergency stop stays inline."""
+    released = threading.Event()
+
+    def slow_history(rid, params):
+        released.wait(timeout=5)
+        return server._ok(rid, {"messages": []})
+
+    server._methods["session.history"] = slow_history
+    server._methods["session.interrupt"] = (
+        lambda rid, params: server._ok(rid, {"status": "interrupted"})
+    )
+
+    started = time.monotonic()
+    assert server.dispatch(
+        {"id": "history", "method": "session.history", "params": {}}
+    ) is None
+    interrupt = server.dispatch(
+        {"id": "stop", "method": "session.interrupt", "params": {}}
+    )
+    elapsed = time.monotonic() - started
+
+    assert interrupt["result"] == {"status": "interrupted"}
+    assert elapsed < 2.0
+    assert "session.interrupt" not in server._LONG_HANDLERS
+
+    released.set()
+
+
