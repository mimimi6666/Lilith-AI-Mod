index 0000000..03ad5c3
--- /dev/null
+++ b/tests/tui_gateway/test_history_timestamp_projection.py
@@ -0,0 +1,39 @@
+from tui_gateway import server
+
+
+def test_history_to_messages_preserves_numeric_timestamps_for_durable_roles():
+    history = [
+        {"role": "user", "content": "question", "timestamp": 1_720_000_000},
+        {
+            "role": "assistant",
+            "content": "answer",
+            "timestamp": 1_720_000_001.25,
+        },
+        {
+            "role": "tool",
+            "content": "done",
+            "tool_name": "terminal",
+            "timestamp": 1_720_000_002,
+        },
+    ]
+
+    projected = server._history_to_messages(history)
+
+    assert [(row["role"], row["timestamp"]) for row in projected] == [
+        ("user", 1_720_000_000),
+        ("assistant", 1_720_000_001.25),
+        ("tool", 1_720_000_002),
+    ]
+
+
+def test_history_to_messages_does_not_fabricate_invalid_timestamps():
+    history = [
+        {"role": "user", "content": "missing"},
+        {"role": "assistant", "content": "string", "timestamp": "1720000003"},
+        {"role": "tool", "content": "bool", "timestamp": True},
+        {"role": "assistant", "content": "nan", "timestamp": float("nan")},
+    ]
+
+    projected = server._history_to_messages(history)
+
+    assert all("timestamp" not in row for row in projected)
