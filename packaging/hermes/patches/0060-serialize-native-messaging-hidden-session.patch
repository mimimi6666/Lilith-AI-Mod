index 0000000..e1407c4
--- /dev/null
+++ b/plugins/lilith_messaging_bridge/__init__.py
@@ -0,0 +1,155 @@
+"""Authorized Telegram routing bridge for the Lilith hidden game session.
+
+The Runtime owns ``runtime/game-session-v1.json``. This plugin only consumes
+that strict receipt and marks an authorized native Telegram event for deferred
+binding. The gateway performs the actual route mutation while holding the
+profile-global turn lease; the hook must never mutate SessionStore first. The
+plugin does not replace Telegram auth, pairing, adapters, delivery, or gateway
+lifecycle.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from pathlib import Path
+import stat
+from typing import Any, Optional
+import unicodedata
+
+from gateway.config import Platform
+from hermes_constants import get_hermes_home
+
+logger = logging.getLogger(__name__)
+
+_HANDLE_RELATIVE_PATH = Path("runtime") / "game-session-v1.json"
+_HANDLE_MAX_BYTES = 4096
+_SESSION_ID_MAX_UTF8_BYTES = 256
+_HANDLE_KEYS = frozenset({"schemaVersion", "storedSessionId"})
+_SHARED_SESSION_EVENT_ATTRIBUTE = "_lilith_shared_session_id"
+
+
+def _is_reparse_point(path_stat: os.stat_result) -> bool:
+    attributes = int(getattr(path_stat, "st_file_attributes", 0) or 0)
+    reparse_flag = int(getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400))
+    return bool(attributes & reparse_flag)
+
+
+def _strict_json_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON property")
+        result[key] = value
+    return result
+
+
+def _valid_stored_session_id(value: Any) -> Optional[str]:
+    if type(value) is not str or not value or value != value.strip():
+        return None
+    if any(unicodedata.category(char) == "Cc" for char in value):
+        return None
+    try:
+        encoded = value.encode("utf-8", errors="strict")
+    except UnicodeError:
+        return None
+    if not encoded or len(encoded) > _SESSION_ID_MAX_UTF8_BYTES:
+        return None
+    return value
+
+
+def _read_active_game_session_id() -> Optional[str]:
+    path = get_hermes_home() / _HANDLE_RELATIVE_PATH
+    try:
+        before = os.lstat(path)
+        if (
+            not stat.S_ISREG(before.st_mode)
+            or stat.S_ISLNK(before.st_mode)
+            or _is_reparse_point(before)
+            or before.st_size > _HANDLE_MAX_BYTES
+        ):
+            return None
+        with path.open("rb") as handle:
+            opened = os.fstat(handle.fileno())
+            if (
+                not stat.S_ISREG(opened.st_mode)
+                or _is_reparse_point(opened)
+                or opened.st_size > _HANDLE_MAX_BYTES
+                or (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino)
+            ):
+                return None
+            raw = handle.read(_HANDLE_MAX_BYTES + 1)
+    except (OSError, ValueError):
+        return None
+    if not raw or len(raw) > _HANDLE_MAX_BYTES:
+        return None
+    try:
+        document = json.loads(
+            raw.decode("utf-8", errors="strict"),
+            object_pairs_hook=_strict_json_object,
+        )
+    except (UnicodeError, ValueError, TypeError):
+        return None
+    if type(document) is not dict or frozenset(document) != _HANDLE_KEYS:
+        return None
+    if type(document.get("schemaVersion")) is not int:
+        return None
+    if document["schemaVersion"] != 1:
+        return None
+    return _valid_stored_session_id(document.get("storedSessionId"))
+
+
+def _pre_gateway_dispatch(*, event, gateway, session_store=None, **_kwargs):
+    """Mark an authorized Telegram event for lease-protected native binding."""
+    if event is None:
+        return None
+    # Hooks can be re-invoked by test/replay infrastructure. Clear a prior
+    # private mark first so an event that is no longer eligible cannot retain
+    # route authority from an earlier invocation.
+    try:
+        delattr(event, _SHARED_SESSION_EVENT_ATTRIBUTE)
+    except AttributeError:
+        pass
+    if bool(getattr(event, "internal", False)):
+        return None
+    source = getattr(event, "source", None)
+    if source is None or getattr(source, "platform", None) != Platform.TELEGRAM:
+        return None
+    user_id = getattr(source, "user_id", None)
+    if (
+        type(user_id) is not str
+        or not user_id
+        or user_id != user_id.strip()
+        or len(user_id.encode("utf-8", errors="ignore")) > 128
+        or any(unicodedata.category(char) == "Cc" for char in user_id)
+    ):
+        return None
+    if gateway is None:
+        return None
+    authorize = getattr(gateway, "_is_user_authorized", None)
+    if not callable(authorize):
+        return None
+    try:
+        authorized = authorize(source)
+    except Exception:
+        logger.warning("Lilith Telegram bridge authorization check failed")
+        return None
+    # Exact True prevents truthy test doubles or malformed adapters from
+    # becoming an authorization bypass. Unauthorized traffic remains wholly
+    # untouched so the native DM pairing flow can run immediately afterward.
+    if authorized is not True:
+        return None
+
+    stored_session_id = _read_active_game_session_id()
+    if stored_session_id is None:
+        return None
+    try:
+        setattr(event, _SHARED_SESSION_EVENT_ATTRIBUTE, stored_session_id)
+    except Exception:
+        logger.warning("Lilith Telegram bridge could not mark the native event")
+    return None
+
+
+def register(ctx) -> None:
+    ctx.register_hook("pre_gateway_dispatch", _pre_gateway_dispatch)
