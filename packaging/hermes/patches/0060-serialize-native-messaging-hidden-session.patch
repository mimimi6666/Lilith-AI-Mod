+        list_approved=lambda platform: [
+            {"platform": platform, "user_id": "42", "user_name": "Alice"},
+            {"platform": "discord", "user_id": "7"},
+        ],
+    )
+
+    assert messaging.telegram_pairing_list(store) == {
+        "pending": [
+            {
+                "request_id": "0123456789abcdef",
+                "user_id": "42",
+                "user_name": "Alice",
+                "age_minutes": 3,
+            }
+        ],
+        "approved": [{"user_id": "42"}],
+    }
+
+
+def test_pairing_approve_and_revoke_return_strict_receipts_and_explicit_misses():
+    store = SimpleNamespace(
+        approve_request=lambda platform, request_id: {
+            "user_id": "42",
+            "user_name": "Alice",
+        },
+        revoke=lambda platform, user_id: True,
+    )
+    assert messaging.approve_pairing_request("0123456789abcdef", store) == {
+        "request_id": "0123456789abcdef",
+        "user_id": "42",
+        "approved": True,
+    }
+    assert messaging.revoke_approved_user("42", store) == {
+        "user_id": "42",
+        "revoked": True,
+    }
+
+    store.approve_request = lambda *_args: None
+    with pytest.raises(messaging.TelegramMessagingRpcError) as approve_error:
+        messaging.approve_pairing_request("0123456789abcdef", store)
+    assert approve_error.value.rpc_code == messaging.TELEGRAM_PAIRING_REQUEST_NOT_FOUND
+
+    store.revoke = lambda *_args: False
+    with pytest.raises(messaging.TelegramMessagingRpcError) as revoke_error:
+        messaging.revoke_approved_user("42", store)
+    assert revoke_error.value.rpc_code == messaging.TELEGRAM_APPROVED_USER_NOT_FOUND
+
+
+def test_rpc_envelopes_match_fixed_schema_and_never_echo_token(monkeypatch):
+    token = "123456789:" + "B" * 35
+    monkeypatch.setattr(
+        messaging,
+        "replace_bot_token",
+        lambda bot_token, operation_id: {
+            "operation_id": operation_id,
+            "configured": True,
+            "changed": True,
+        },
+    )
+    response = _request(
+        "messaging.telegram.replace",
+        {"bot_token": token, "operation_id": "operation-1"},
+    )
+    assert response == {
+        "jsonrpc": "2.0",
+        "id": "rpc-1",
+        "result": {
+            "operation_id": "operation-1",
+            "configured": True,
+            "changed": True,
+        },
+    }
+    assert token not in repr(response)
