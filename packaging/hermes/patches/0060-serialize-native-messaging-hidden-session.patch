@@ -0,0 +1,188 @@
+"""TUI full-turn boundary tests for the shared profile kernel lease."""
+
+import threading
+import time
+import types
+
+from tui_gateway import server
+
+
+class _InlineThread:
+    def __init__(self, target=None, args=(), kwargs=None, **_ignored):
+        self._target = target
+        self._args = args
+        self._kwargs = kwargs or {}
+
+    def start(self):
+        if self._target is not None:
+            self._target(*self._args, **self._kwargs)
+
+    def is_alive(self):
+        return False
+
+
+def test_tui_holds_profile_lease_through_turn_and_releases_before_followups(
+    monkeypatch, tmp_path
+):
+    import gateway.turn_lease as turn_lease
+    from tools.process_registry import process_registry
+
+    events = []
+
+    class Lease:
+        released = False
+
+        def release(self):
+            if self.released:
+                return False
+            self.released = True
+            events.append("release")
+            return True
+
+    lease = Lease()
+
+    lease_options = {}
+
+    def acquire(session_id, *, owner_key, profile_home=None, **kwargs):
+        events.append(("acquire", session_id, owner_key, profile_home))
+        lease_options.update(kwargs)
+        lease_options["cancelled_at_acquire"] = kwargs["cancelled"]()
+        return lease
+
+    monkeypatch.setattr(turn_lease, "acquire_profile_turn_lease", acquire)
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda _sid: None)
+    monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda *_args: None)
+    monkeypatch.setattr(server, "_session_cwd", lambda _session: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda _session: None)
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda *_args: None)
+    monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *_a, **_k: None)
+    monkeypatch.setattr(server, "_get_usage", lambda _agent: {})
+    monkeypatch.setattr(server, "_load_cfg", lambda: {})
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server,
+        "_schedule_queued_prompt_drain",
+        lambda *_args: events.append("followups") or False,
+    )
+    monkeypatch.setattr(process_registry, "drain_notifications", lambda **_kw: [])
+
+    def run_conversation(_message, **_kwargs):
+        assert lease.released is False
+        events.append("turn")
+        return {"final_response": "done"}
+
+    agent = types.SimpleNamespace(
+        session_id="stored-session",
+        run_conversation=run_conversation,
+        clear_interrupt=lambda: None,
+    )
+    session = {
+        "agent": agent,
+        "session_key": "stored-session",
+        "profile_home": str(tmp_path),
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "running": True,
+        "attached_images": [],
+        "image_counter": 0,
+        "cols": 80,
+        "slash_worker": None,
+        "show_reasoning": False,
+        "tool_progress_mode": "all",
+        "inflight_turn": None,
+    }
+
+    server._run_prompt_submit("rid", "sid", session, "hello")
+
+    assert events[0] == (
+        "acquire",
+        "stored-session",
+        "tui:sid",
+        str(tmp_path),
+    )
+    assert events.count("release") == 1
+    assert events.index("turn") < events.index("release") < events.index("followups")
+    assert 0 < lease_options["timeout"] <= server._TUI_PROFILE_LEASE_WAIT_SECONDS
+    assert lease_options["deadline"] > time.monotonic()
+    assert lease_options["cancelled_at_acquire"] is False
+    assert lease_options["cancelled"]() is True
+    assert session["running"] is False
+
+
+def test_tui_cancel_during_profile_lease_wait_never_starts_background_turn(
+    monkeypatch, tmp_path
+):
+    import gateway.turn_lease as turn_lease
+
+    events = []
+    monkeypatch.setattr(server, "_TUI_TURN_ADMISSION_DEADLINE_SECONDS", 1.0)
+
+    def acquire(session_id, *, owner_key, timeout, deadline, cancelled, **_kwargs):
+        events.append(("acquire", session_id, owner_key, timeout, deadline))
+        assert timeout <= server._TUI_PROFILE_LEASE_WAIT_SECONDS
+        # The accepted receipt is already ~0.8s old, so only the remaining
+        # admission deadline (not a fresh full timeout) is available.
+        assert 0 < timeout < 0.4
+        assert deadline < time.monotonic() + 0.4
+        assert cancelled() is True
+        raise turn_lease.TurnLeaseCancelledError(
+            session_id,
+            owner_key=owner_key,
+            generation=0,
+            wait_seconds=timeout,
+        )
+
+    monkeypatch.setattr(turn_lease, "acquire_profile_turn_lease", acquire)
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_bind_agent_turn_callbacks", lambda *_a: None)
+    monkeypatch.setattr(server, "_clear_agent_turn_callbacks", lambda *_a: None)
+    monkeypatch.setattr(
+        server,
+        "_emit_terminal_turn_error",
+        lambda _sid, _session, error: events.append(("terminal", str(error))),
+    )
+    monkeypatch.setattr(server, "_emit_settled_session_info", lambda *_a: None)
+    monkeypatch.setattr(server, "_emit", lambda *_a, **_kw: None)
+
+    class Agent:
+        session_id = "stored-session"
+
+        def clear_interrupt(self):
+            return None
+
+        def run_conversation(self, *_args, **_kwargs):
+            events.append("turn")
+            raise AssertionError("cancelled lease waiter started a background turn")
+
+    session = {
+        "agent": Agent(),
+        "session_key": "stored-session",
+        "profile_home": str(tmp_path),
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "running": True,
+        "_turn_cancel_requested": True,
+        "attached_images": [],
+        "image_counter": 0,
+        "cols": 80,
+        "slash_worker": None,
+        "show_reasoning": False,
+        "tool_progress_mode": "all",
+        "inflight_turn": None,
+    }
+    server._start_inflight_turn(session, "hello")
+    session["inflight_turn"]["started_at"] = time.time() - 0.8
+
+    server._run_prompt_submit("rid", "sid", session, "hello")
+
+    assert events[0][:3] == ("acquire", "stored-session", "tui:sid")
+    assert events[1] == (
+        "terminal",
+        "Turn cancelled before it entered the shared session.",
+    )
+    assert "turn" not in events
+    assert session["running"] is False
+    assert session["inflight_turn"] is None
