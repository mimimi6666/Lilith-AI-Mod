@@ -0,0 +1,99 @@
+"""Strict Telegram messaging JSON-RPC handlers for the Lilith Runtime."""
+
+from .method_ctx import HandlerRegistry
+
+_registry = HandlerRegistry()
+method = _registry.method
+
+
+def _call(rid, params, expected_keys, operation):
+    # This helper is intentionally captured as a default argument by handlers
+    # below; HandlerRegistry rebinds their globals onto server.py at install.
+    if set(params) != set(expected_keys):
+        return {
+            "jsonrpc": "2.0",
+            "id": rid,
+            "error": {"code": -32602, "message": "invalid params"},
+        }
+    try:
+        return {"jsonrpc": "2.0", "id": rid, "result": operation()}
+    except Exception as exc:
+        from tui_gateway.telegram_messaging import TelegramMessagingRpcError
+
+        if isinstance(exc, TelegramMessagingRpcError):
+            code = exc.rpc_code
+            message = str(exc)
+        else:
+            code = -32603
+            message = "Telegram messaging operation failed"
+        return {
+            "jsonrpc": "2.0",
+            "id": rid,
+            "error": {"code": code, "message": message},
+        }
+
+
+@method("messaging.telegram.status")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import telegram_status
+
+    return _invoke(rid, params, (), telegram_status)
+
+
+@method("messaging.telegram.replace")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import replace_bot_token
+
+    return _invoke(
+        rid,
+        params,
+        ("bot_token", "operation_id"),
+        lambda: replace_bot_token(params.get("bot_token"), params.get("operation_id")),
+    )
+
+
+@method("messaging.telegram.remove")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import remove_bot_token
+
+    return _invoke(
+        rid,
+        params,
+        ("operation_id",),
+        lambda: remove_bot_token(params.get("operation_id")),
+    )
+
+
+@method("messaging.telegram.pairing.list")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import telegram_pairing_list
+
+    return _invoke(rid, params, (), telegram_pairing_list)
+
+
+@method("messaging.telegram.pairing.approve")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import approve_pairing_request
+
+    return _invoke(
+        rid,
+        params,
+        ("request_id",),
+        lambda: approve_pairing_request(params.get("request_id")),
+    )
+
+
+@method("messaging.telegram.pairing.revoke")
+def _(rid, params: dict, _invoke=_call) -> dict:
+    from tui_gateway.telegram_messaging import revoke_approved_user
+
+    return _invoke(
+        rid,
+        params,
+        ("user_id",),
+        lambda: revoke_approved_user(params.get("user_id")),
+    )
+
+
+def register(server) -> None:
+    _registry.install(server)
