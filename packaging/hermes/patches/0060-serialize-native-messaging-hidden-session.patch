diff --git a/tui_gateway/telegram_messaging.py b/tui_gateway/telegram_messaging.py
new file mode 100644
index 0000000..202935a
--- /dev/null
+++ b/tui_gateway/telegram_messaging.py
@@ -0,0 +1,316 @@
+"""Strict native Telegram control surface for the Lilith Runtime.
+
+Only bounded receipts and pairing identities cross this module boundary.
+The bot token is accepted write-only and is never returned or logged.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+import re
+import threading
+from typing import Any, Optional
+import unicodedata
+
+TELEGRAM_PAIRING_REQUEST_NOT_FOUND = 5071
+TELEGRAM_APPROVED_USER_NOT_FOUND = 5072
+TELEGRAM_CONFIG_WRITE_FAILED = 5073
+
+_BOT_TOKEN_RE = re.compile(r"^\d+:[A-Za-z0-9_-]{30,}$")
+_REQUEST_ID_RE = re.compile(r"^[0-9a-fA-F]{16}$")
+_USER_ID_RE = re.compile(r"^[0-9]{1,32}$")
+_MUTATION_LOCK = threading.RLock()
+
+
+class TelegramMessagingRpcError(ValueError):
+    def __init__(self, rpc_code: int, message: str) -> None:
+        self.rpc_code = int(rpc_code)
+        super().__init__(message)
+
+
+def _has_control(value: str) -> bool:
+    return any(unicodedata.category(char) == "Cc" for char in value)
+
+
+def _bounded_text(
+    value: Any,
+    *,
+    field: str,
+    max_utf8_bytes: int,
+    pattern: Optional[re.Pattern[str]] = None,
+) -> str:
+    if type(value) is not str or not value or value != value.strip():
+        raise TelegramMessagingRpcError(-32602, f"invalid params: {field}")
+    if _has_control(value):
+        raise TelegramMessagingRpcError(-32602, f"invalid params: {field}")
+    try:
+        encoded = value.encode("utf-8", errors="strict")
+    except UnicodeError:
+        raise TelegramMessagingRpcError(
+            -32602, f"invalid params: {field}"
+        ) from None
+    if len(encoded) > max_utf8_bytes or (pattern is not None and not pattern.fullmatch(value)):
+        raise TelegramMessagingRpcError(-32602, f"invalid params: {field}")
+    return value
+
+
+def validate_operation_id(value: Any) -> str:
+    return _bounded_text(
+        value,
+        field="operation_id",
+        max_utf8_bytes=128,
+    )
+
+
+def validate_bot_token(value: Any) -> str:
+    # The regex is the native hermes_cli.setup Telegram token grammar. Keep a
+    # hard byte bound as a defense before any credential writer sees input.
+    return _bounded_text(
+        value,
+        field="bot_token",
+        max_utf8_bytes=512,
+        pattern=_BOT_TOKEN_RE,
+    )
+
+
+def validate_request_id(value: Any) -> str:
+    return _bounded_text(
+        value,
+        field="request_id",
+        max_utf8_bytes=16,
+        pattern=_REQUEST_ID_RE,
+    ).lower()
+
+
+def validate_user_id(value: Any) -> str:
+    return _bounded_text(
+        value,
+        field="user_id",
+        max_utf8_bytes=32,
+        pattern=_USER_ID_RE,
+    )
+
+
+def _env_token() -> str:
+    from hermes_cli.config import load_env
+
+    value = load_env().get("TELEGRAM_BOT_TOKEN", "")
+    return value if isinstance(value, str) else ""
+
+
+def telegram_status() -> dict[str, Any]:
+    """Return a redacted four-state Telegram health projection."""
+    from gateway.status import read_runtime_status, resolve_gateway_liveness
+    from hermes_constants import get_hermes_home
+
+    home = Path(get_hermes_home())
+    try:
+        configured = bool(_env_token())
+    except Exception:
+        configured = False
+    try:
+        runtime = read_runtime_status(path=home / "gateway_state.json")
+    except Exception:
+        runtime = None
+    try:
+        liveness = resolve_gateway_liveness(
+            profile_dir=home,
+            runtime=runtime,
+        )
+        profile_gateway_running = bool(liveness.running)
+    except Exception:
+        profile_gateway_running = False
+
+    runtime = runtime if isinstance(runtime, dict) else {}
+    platforms = runtime.get("platforms")
+    telegram = platforms.get("telegram") if isinstance(platforms, dict) else None
+    telegram = telegram if isinstance(telegram, dict) else {}
+    platform_state = str(
+        telegram.get("state") or telegram.get("status") or ""
+    ).strip().lower()
+    connected_states = {"connected", "running", "ok"}
+    starting_states = {
+        "starting",
+        "connecting",
+        "initializing",
+        "pending",
+        "pending_restart",
+        "reconnecting",
+    }
+    # Once Telegram is configured, a live profile gateway owns its lifecycle.
+    # The Telegram adapter may still be starting/reconnecting, may not have
+    # written its platform entry yet, or may be reporting an error that needs
+    # attention. None of those states authorizes Runtime to spawn a second
+    # gateway process for the same profile.
+    gateway_running = bool(configured and profile_gateway_running)
+
+    if not configured:
+        state = "unconfigured"
+    elif gateway_running and platform_state in connected_states:
+        state = "connected"
+    elif gateway_running and (
+        not platform_state or platform_state in starting_states
+    ):
+        state = "starting"
+    else:
+        state = "attention"
+    return {
+        "configured": configured,
+        "gateway_running": gateway_running,
+        "state": state,
+    }
+
+
+def replace_bot_token(bot_token: Any, operation_id: Any) -> dict[str, Any]:
+    token = validate_bot_token(bot_token)
+    operation = validate_operation_id(operation_id)
+    from hermes_cli.config import load_env, save_env_value
+
+    with _MUTATION_LOCK:
+        before = load_env().get("TELEGRAM_BOT_TOKEN", "")
+        changed = before != token
+        if changed:
+            try:
+                save_env_value("TELEGRAM_BOT_TOKEN", token)
+            except Exception:
+                raise TelegramMessagingRpcError(
+                    TELEGRAM_CONFIG_WRITE_FAILED,
+                    "Telegram credential could not be saved",
+                ) from None
+        try:
+            persisted = load_env().get("TELEGRAM_BOT_TOKEN", "")
+        except Exception:
+            persisted = ""
+        if persisted != token:
+            raise TelegramMessagingRpcError(
+                TELEGRAM_CONFIG_WRITE_FAILED,
+                "Telegram credential could not be saved",
+            )
+    return {
+        "operation_id": operation,
+        "configured": True,
+        "changed": bool(changed),
+    }
+
+
+def remove_bot_token(operation_id: Any) -> dict[str, Any]:
+    operation = validate_operation_id(operation_id)
+    from hermes_cli.config import load_env, remove_env_value
+
+    with _MUTATION_LOCK:
+        before = load_env().get("TELEGRAM_BOT_TOKEN", "")
+        changed = bool(before)
+        if changed:
+            try:
+                remove_env_value("TELEGRAM_BOT_TOKEN")
+            except Exception:
+                raise TelegramMessagingRpcError(
+                    TELEGRAM_CONFIG_WRITE_FAILED,
+                    "Telegram credential could not be removed",
+                ) from None
+        try:
+            persisted = load_env().get("TELEGRAM_BOT_TOKEN", "")
+        except Exception:
+            persisted = before
+        if persisted:
+            raise TelegramMessagingRpcError(
+                TELEGRAM_CONFIG_WRITE_FAILED,
+                "Telegram credential could not be removed",
+            )
+    return {
+        "operation_id": operation,
+        "configured": False,
+        "changed": bool(changed),
+    }
+
+
+def _safe_output_text(value: Any, max_utf8_bytes: int) -> Optional[str]:
+    if type(value) is not str or not value or _has_control(value):
+        return None
+    try:
+        encoded = value.encode("utf-8", errors="strict")
+    except UnicodeError:
+        return None
+    if len(encoded) > max_utf8_bytes:
+        return None
+    return value
+
+
+def telegram_pairing_list(store=None) -> dict[str, list[dict[str, Any]]]:
+    if store is None:
+        from gateway.pairing import PairingStore
+
+        store = PairingStore()
+
+    pending = []
+    for item in store.list_pending("telegram"):
+        if not isinstance(item, dict) or item.get("platform") != "telegram":
+            continue
+        request_id = _safe_output_text(item.get("request_id"), 16)
+        user_id = _safe_output_text(item.get("user_id"), 128)
+        user_name = item.get("user_name")
+        if type(user_name) is not str:
+            user_name = ""
+        if _has_control(user_name) or len(user_name.encode("utf-8", errors="ignore")) > 256:
+            user_name = ""
+        age = item.get("age_minutes")
+        if (
+            request_id is None
+            or not _REQUEST_ID_RE.fullmatch(request_id)
+            or user_id is None
+            or type(age) is not int
+            or age < 0
+        ):
+            continue
+        pending.append(
+            {
+                "request_id": request_id.lower(),
+                "user_id": user_id,
+                "user_name": user_name,
+                "age_minutes": min(age, 2_147_483_647),
+            }
+        )
+
+    approved = []
+    for item in store.list_approved("telegram"):
+        if not isinstance(item, dict) or item.get("platform") != "telegram":
+            continue
+        user_id = _safe_output_text(item.get("user_id"), 128)
+        if user_id is not None:
+            approved.append({"user_id": user_id})
+    return {"pending": pending, "approved": approved}
+
+
+def approve_pairing_request(request_id: Any, store=None) -> dict[str, Any]:
+    request = validate_request_id(request_id)
+    if store is None:
+        from gateway.pairing import PairingStore
+
+        store = PairingStore()
+    result = store.approve_request("telegram", request)
+    if not isinstance(result, dict):
+        raise TelegramMessagingRpcError(
+            TELEGRAM_PAIRING_REQUEST_NOT_FOUND,
+            "Telegram pairing request was not found or has expired",
+        )
+    user_id = _safe_output_text(result.get("user_id"), 128)
+    if user_id is None:
+        raise TelegramMessagingRpcError(
+            TELEGRAM_PAIRING_REQUEST_NOT_FOUND,
+            "Telegram pairing request was not found or has expired",
+        )
+    return {"request_id": request, "user_id": user_id, "approved": True}
+
+
+def revoke_approved_user(user_id: Any, store=None) -> dict[str, Any]:
+    user = validate_user_id(user_id)
+    if store is None:
+        from gateway.pairing import PairingStore
+
+        store = PairingStore()
+    if store.revoke("telegram", user) is not True:
+        raise TelegramMessagingRpcError(
+            TELEGRAM_APPROVED_USER_NOT_FOUND,
+            "Telegram approved user was not found",
+        )
+    return {"user_id": user, "revoked": True}
