+"""Strict schema and redaction tests for six Telegram Runtime RPCs."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tui_gateway import server
+from tui_gateway import telegram_messaging as messaging
+
+
+METHODS = {
+    "messaging.telegram.status",
+    "messaging.telegram.replace",
+    "messaging.telegram.remove",
+    "messaging.telegram.pairing.list",
+    "messaging.telegram.pairing.approve",
+    "messaging.telegram.pairing.revoke",
+}
+
+
+def _request(method, params):
+    return server.handle_request(
+        {"jsonrpc": "2.0", "id": "rpc-1", "method": method, "params": params}
+    )
+
+
+def test_six_methods_are_registered_and_reject_extra_params():
+    assert METHODS <= set(server._methods)
+    for name in METHODS:
+        result = _request(name, {"unexpected": True})
+        assert result["error"] == {"code": -32602, "message": "invalid params"}
+
+
+@pytest.mark.parametrize(
+    "configured,running,gateway_state,platform_state,expected_running,expected",
+    [
+        (False, True, "running", "connected", False, "unconfigured"),
+        (True, True, "running", "connected", True, "connected"),
+        (True, True, "running", "running", True, "connected"),
+        (True, True, "running", "ok", True, "connected"),
+        (True, True, "starting", "starting", True, "starting"),
+        (True, True, "running", "connecting", True, "starting"),
+        (True, True, "running", "initializing", True, "starting"),
+        (True, True, "running", "pending", True, "starting"),
+        (True, True, "running", "pending_restart", True, "starting"),
+        (True, True, "running", "reconnecting", True, "starting"),
+        (True, True, "running", "", True, "starting"),
+        (True, False, "startup_failed", "fatal", False, "attention"),
+        (True, True, "running", "fatal", True, "attention"),
+    ],
+)
+def test_status_redlines_native_state_without_error_or_token(
+    monkeypatch,
+    tmp_path,
+    configured,
+    running,
+    gateway_state,
+    platform_state,
+    expected_running,
+    expected,
+):
+    import gateway.status as gateway_status
+    import hermes_constants
+
+    monkeypatch.setattr(messaging, "_env_token", lambda: "secret" if configured else "")
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: tmp_path)
+    runtime = {
+        "gateway_state": gateway_state,
+        "platforms": {"telegram": {"state": platform_state, "error_message": "secret"}},
+    }
+    monkeypatch.setattr(gateway_status, "read_runtime_status", lambda **_kw: runtime)
+    monkeypatch.setattr(
+        gateway_status,
+        "resolve_gateway_liveness",
+        lambda **_kw: SimpleNamespace(running=running),
+    )
+
+    result = messaging.telegram_status()
+    assert result == {
+        "configured": configured,
+        "gateway_running": expected_running,
+        "state": expected,
+    }
+    assert "secret" not in repr(result)
+
+
+def test_replace_and_remove_use_native_env_writers_without_returning_token(monkeypatch):
+    import hermes_cli.config as config
+
+    token = "123456789:" + "A" * 35
+    env = {}
+    writes = []
+
+    monkeypatch.setattr(config, "load_env", lambda: dict(env))
+
+    def save(key, value):
+        writes.append((key, value))
+        env[key] = value
+
+    def remove(key):
+        writes.append(("remove", key))
+        return env.pop(key, None) is not None
+
+    monkeypatch.setattr(config, "save_env_value", save)
+    monkeypatch.setattr(config, "remove_env_value", remove)
+
+    replaced = messaging.replace_bot_token(token, "operation-1")
+    assert replaced == {
+        "operation_id": "operation-1",
+        "configured": True,
+        "changed": True,
