@@ -0,0 +1,164 @@
+"""Focused authorization and strict-receipt tests for Lilith Telegram bridge."""
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform
+from plugins.lilith_messaging_bridge import (
+    _pre_gateway_dispatch,
+    _read_active_game_session_id,
+    register,
+)
+import plugins.lilith_messaging_bridge as bridge
+
+
+def _event(*, platform=Platform.TELEGRAM, user_id="42", internal=False):
+    source = SimpleNamespace(platform=platform, user_id=user_id)
+    return SimpleNamespace(source=source, internal=internal)
+
+
+def _write_handle(home: Path, raw: bytes) -> None:
+    runtime = home / "runtime"
+    runtime.mkdir(parents=True, exist_ok=True)
+    (runtime / "game-session-v1.json").write_bytes(raw)
+
+
+def test_authorized_telegram_event_marks_deferred_binding_without_mutating_route(
+    monkeypatch, tmp_path
+):
+    _write_handle(
+        tmp_path,
+        b'{"schemaVersion":1,"storedSessionId":"stored-game-session"}',
+    )
+    monkeypatch.setattr(bridge, "get_hermes_home", lambda: tmp_path)
+    event = _event()
+    gateway = SimpleNamespace(
+        _is_user_authorized=lambda source: True,
+    )
+    store = SimpleNamespace(
+        lookup_by_session_key=lambda *_args: pytest.fail("hook looked up route"),
+        get_or_create_session=lambda *_args: pytest.fail("hook created route"),
+        switch_session=lambda *_args: pytest.fail("hook switched route"),
+    )
+
+    assert (
+        _pre_gateway_dispatch(event=event, gateway=gateway, session_store=store)
+        is None
+    )
+    assert event._lilith_shared_session_id == "stored-game-session"
+
+
+@pytest.mark.parametrize(
+    "authorized,platform,user_id,internal",
+    [
+        (False, Platform.TELEGRAM, "42", False),
+        (True, Platform.SLACK, "42", False),
+        (True, Platform.TELEGRAM, None, False),
+        (True, Platform.TELEGRAM, "42", True),
+        (True, Platform.TELEGRAM, "42", 1),
+        (True, Platform.TELEGRAM, " 42", False),
+        (True, Platform.TELEGRAM, "42\n", False),
+    ],
+)
+def test_ineligible_event_never_reads_handle_or_mutates_route(
+    monkeypatch, authorized, platform, user_id, internal
+):
+    event = _event(platform=platform, user_id=user_id, internal=internal)
+    route_calls = []
+    gateway = SimpleNamespace(
+        _is_user_authorized=lambda source: authorized,
+        _session_key_for_source=lambda source: route_calls.append(source),
+    )
+    monkeypatch.setattr(
+        bridge,
+        "_read_active_game_session_id",
+        lambda: pytest.fail("ineligible event read the Lilith handle"),
+    )
+    store = SimpleNamespace(
+        switch_session=lambda *_args: pytest.fail("ineligible event switched route")
+    )
+
+    assert (
+        _pre_gateway_dispatch(event=event, gateway=gateway, session_store=store)
+        is None
+    )
+    assert route_calls == []
+    assert not hasattr(event, "_lilith_shared_session_id")
+
+
+def test_reinvocation_clears_stale_authority_mark(monkeypatch, tmp_path):
+    _write_handle(
+        tmp_path,
+        b'{"schemaVersion":1,"storedSessionId":"stored-game-session"}',
+    )
+    monkeypatch.setattr(bridge, "get_hermes_home", lambda: tmp_path)
+    event = _event()
+    gateway = SimpleNamespace(_is_user_authorized=lambda _source: True)
+    _pre_gateway_dispatch(event=event, gateway=gateway)
+    assert event._lilith_shared_session_id == "stored-game-session"
+
+    gateway._is_user_authorized = lambda _source: False
+    _pre_gateway_dispatch(event=event, gateway=gateway)
+    assert not hasattr(event, "_lilith_shared_session_id")
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        b'{"schemaVersion":true,"storedSessionId":"stored"}',
+        b'{"schemaVersion":2,"storedSessionId":"stored"}',
+        b'{"schemaVersion":1,"storedSessionId":" stored"}',
+        b'{"schemaVersion":1,"storedSessionId":"stored\\u0000"}',
+        b'{"schemaVersion":1,"storedSessionId":"stored","extra":1}',
+        b'{"schemaVersion":1,"schemaVersion":1,"storedSessionId":"stored"}',
+        b'not-json',
+    ],
+)
+def test_strict_handle_rejects_malformed_or_noncanonical_documents(
+    monkeypatch, tmp_path, raw
+):
+    _write_handle(tmp_path, raw)
+    monkeypatch.setattr(bridge, "get_hermes_home", lambda: tmp_path)
+    assert _read_active_game_session_id() is None
+
+
+def test_strict_handle_rejects_oversized_session_id(monkeypatch, tmp_path):
+    session_id = "x" * 257
+    _write_handle(
+        tmp_path,
+        (
+            '{"schemaVersion":1,"storedSessionId":"'
+            + session_id
+            + '"}'
+        ).encode("utf-8"),
+    )
+    monkeypatch.setattr(bridge, "get_hermes_home", lambda: tmp_path)
+    assert _read_active_game_session_id() is None
+
+
+def test_strict_handle_rejects_symlink(monkeypatch, tmp_path):
+    target = tmp_path / "target.json"
+    target.write_text(
+        '{"schemaVersion":1,"storedSessionId":"stored"}',
+        encoding="utf-8",
+    )
+    runtime = tmp_path / "runtime"
+    runtime.mkdir()
+    link = runtime / "game-session-v1.json"
+    try:
+        link.symlink_to(target)
+    except (OSError, NotImplementedError):
+        pytest.skip("symlinks are unavailable for this test account")
+    monkeypatch.setattr(bridge, "get_hermes_home", lambda: tmp_path)
+    assert _read_active_game_session_id() is None
+
+
+def test_registers_only_pre_gateway_dispatch_hook():
+    calls = []
+    context = SimpleNamespace(
+        register_hook=lambda name, callback: calls.append((name, callback))
+    )
+    register(context)
+    assert calls == [("pre_gateway_dispatch", _pre_gateway_dispatch)]
