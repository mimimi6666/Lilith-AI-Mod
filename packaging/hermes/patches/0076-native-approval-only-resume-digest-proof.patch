+def _adopt_idle_approval_resume_digest(session: dict) -> None:
+    """Resume the same strict conversation after an exact approval-only save.
+
+    This is not a general stale-config escape hatch: tools.set creates the
+    marker only while all sessions are idle and the toolset is unchanged.
+    Other config mutations cannot produce or widen the prepared digest chain.
+    """
+    pending = session.get("_native_approval_resume_digest")
+    if not isinstance(pending, dict):
+        return
+    agent = session.get("agent")
+    if agent is None:
+        # Deferred construction already verifies the newest trusted snapshot.
+        return
+    from agent.identity_policy import (
+        adopt_verified_native_config_digest,
+        preflight_aia_agent_identity,
+    )
+    from hermes_cli.config import _CONFIG_LOCK
+
+    with session["history_lock"], _runtime_authority_lock(session), _CONFIG_LOCK:
+        if (session.get("running") or session.get("tool_started_at")
+                or session.get("queued_prompt") or session.get("queued_prompts")
+                or session.get("agent_build_started")
+                or _native_model_agent_has_active_children(agent)):
+            raise RuntimeError("approval resume requires an idle strict session")
+        previous, current = pending.get("previous"), pending.get("current")
+        if not isinstance(previous, str) or not isinstance(current, str):
+            raise RuntimeError("approval resume digest proof is incomplete")
+        receipt = preflight_aia_agent_identity(request_overrides={})
+        if not hmac.compare_digest(receipt.config_sha256, current):
+            raise RuntimeError("approval resume config changed after native receipt")
+        # A deferred agent may already have been built from the new snapshot.
+        state = _native_model_agent_digest_state(agent, previous, current)
+        if state == "old":
+            key = str(session.get("session_key") or "").strip()
+            db = getattr(agent, "_session_db", None) or _get_db()
+            if db is None or not key:
+                raise RuntimeError("approval resume database identity is unavailable")
+            row = db.get_session(key)
+            if row is not None:
+                _adopt_verified_native_config_digest_for_session(
+                    session, agent, previous, current,
+                )
+            else:
+                # Never pretend an existing conversation is an untouched draft.
+                if (getattr(agent, "_session_db_created", False)
+                        or session.get("history") or session.get("resume_session_id")
+                        or session.get("display_history_prefix")
+                        or session.get("inflight_turn")
+                        or session.get("history_version", 0) != 0):
+                    raise RuntimeError("approval resume durable conversation is missing")
+                adopt_verified_native_config_digest(
+                    agent, previous_config_sha256=previous, config_sha256=current,
+                )
+        session.pop("_native_approval_resume_digest", None)
+
+
