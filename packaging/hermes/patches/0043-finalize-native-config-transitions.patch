+def _rebind_prepared_native_model_sessions(
+    prepared: _PreparedNativeModelDefaultCommit,
+) -> None:
+    """Persist every prepared session digest, then adopt it in live agents."""
+
+    from agent.identity_policy import adopt_verified_native_config_digest
+
+    previous = prepared.previous_config_sha256
+    current = prepared.config_sha256
+    with _locked_prepared_native_model_sessions(prepared) as locked_state:
+        current_bindings, dormant_sessions = locked_state
+        staged = []
+        for binding, state in current_bindings:
+            live_db = getattr(binding.agent, "_session_db", None) or _get_db()
+            if live_db is not binding.db:
+                raise RuntimeError("prepared strict session database changed")
+            row = None
+            if live_db is not None and hasattr(live_db, "get_session"):
+                row = live_db.get_session(binding.session_key)
+            if row is None:
+                if binding.durable_row_existed or bool(
+                    getattr(binding.agent, "_session_db_created", False)
+                ):
+                    raise RuntimeError(
+                        "prepared strict durable session row disappeared"
+                    )
+                staged.append((binding, None, None, state))
+                continue
+            if not isinstance(row, dict) or not hasattr(
+                live_db,
+                "update_session_meta",
+            ):
+                raise RuntimeError("prepared strict durable session was invalid")
+            model_config = _native_model_row_config(
+                row,
+                label="prepared strict durable session",
+            )
+            durable_digest = str(
+                model_config.get("_identity_config_sha256") or ""
+            ).strip().lower()
+            expected = previous if state == "old" else current
+            if not hmac.compare_digest(durable_digest, expected):
+                raise RuntimeError("prepared strict durable session digest changed")
+            if state == "new":
+                staged.append((binding, None, None, state))
+                continue
+            updated = dict(model_config)
+            updated["_identity_config_sha256"] = current
+            staged.append((binding, live_db, updated, state))
+
+        # A session may still be waiting for its deferred AIAgent. Rebind an
+        # existing durable row directly; the runtime revision bump above makes
+        # any in-flight candidate stale before it can publish.
+        for session in dormant_sessions:
+            session_key = str(session.get("session_key") or "").strip()
+            if not session_key:
+                raise RuntimeError("dormant strict session key was missing")
+            with _session_db(session) as db:
+                if db is None or not hasattr(db, "get_session"):
+                    continue
+                row = db.get_session(session_key)
+                if row is None:
+                    continue
+                if not isinstance(row, dict):
+                    raise RuntimeError("dormant strict durable row was malformed")
+                model_config = _native_model_row_config(
+                    row,
+                    label="dormant strict durable session",
+                )
+                durable_digest = str(
+                    model_config.get("_identity_config_sha256") or ""
+                ).strip().lower()
+                if hmac.compare_digest(durable_digest, current):
+                    continue
+                if not hmac.compare_digest(durable_digest, previous):
+                    raise RuntimeError("dormant strict durable digest changed")
+                if not hasattr(db, "update_session_meta"):
+                    raise RuntimeError("dormant strict session cannot be rebound")
+                updated = dict(model_config)
+                updated["_identity_config_sha256"] = current
+                db.update_session_meta(
+                    session_key,
+                    json.dumps(
+                        updated,
+                        separators=(",", ":"),
+                        ensure_ascii=False,
+                    ),
+                    None,
+                )
+                verified = db.get_session(session_key)
+                if not isinstance(verified, dict) or _native_model_row_config(
+                    verified,
+                    label="verified dormant strict durable session",
+                ) != updated:
+                    raise RuntimeError(
+                        "dormant strict session rebind was not durable"
+                    )
+
+        # Make every existing state.db row durable before changing any live
+        # agent.  A later failure is quarantined, so no partially rebound state
+        # can serve another turn.
+        for binding, db, updated, _state in staged:
+            if db is None:
+                continue
+            db.update_session_meta(
+                binding.session_key,
+                json.dumps(updated, separators=(",", ":"), ensure_ascii=False),
+                None,
+            )
+            verified = db.get_session(binding.session_key)
+            if not isinstance(verified, dict):
+                raise RuntimeError("strict session model rebind was not durable")
+            verified_config = _native_model_row_config(
+                verified,
+                label="verified strict durable session",
+            )
+            if verified_config != updated:
+                raise RuntimeError("strict session model rebind changed metadata")
+
+        for binding, state in current_bindings:
+            if state == "new":
+                continue
+            adopt_verified_native_config_digest(
+                binding.agent,
+                previous_config_sha256=previous,
+                config_sha256=current,
+            )
