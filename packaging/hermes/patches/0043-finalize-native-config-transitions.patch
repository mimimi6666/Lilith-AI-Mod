+        identity_policy.begin_native_authority_commit_pending(
+            {"session_key": "model", "commit_nonce": "f" * 64}
+        )
+    release_constructor.set()
+    worker.join(timeout=1)
+
+    assert not worker.is_alive()
+    identity_policy.begin_native_authority_commit_pending(
