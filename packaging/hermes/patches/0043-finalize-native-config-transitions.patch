+    )
+    committed = server._methods["approval.commit"](
+        "commit-live",
+        {
+            "session_id": session_id,
+            "authority": "lilith-runtime-native-config.v1",
+            "commit_nonce": prepared["commit_nonce"],
+            "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest(),
+        },
+    )
+
+    assert "error" not in committed, committed
