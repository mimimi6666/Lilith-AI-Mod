+        {"model_config": json.dumps(agent._session_init_model_config)}
+    )
+    agent._session_db = db
+    approval, session_id, _, entry = _pending_native_approval(monkeypatch)
+    server._sessions[session_id]["agent"] = agent
+
+    prepared = server._methods["approval.respond"](
+        "always-live",
+        {"session_id": session_id, "choice": "always"},
