+def test_background_review_reserves_native_effect_before_child_construction(
+    monkeypatch,
+):
+    import threading
+    import agent.identity_policy as identity_policy
+    from agent.background_review import _run_review_in_thread
+
+    identity_policy._reset_native_authority_quarantine_for_tests()
+    constructor_entered = threading.Event()
+    release_constructor = threading.Event()
+
+    class BlockingReviewAgent:
+        def __init__(self, **_kwargs):
+            constructor_entered.set()
+            release_constructor.wait(timeout=2)
+            raise RuntimeError("stop after construction gap")
+
+    monkeypatch.setattr(run_agent_module, "AIAgent", BlockingReviewAgent)
+    agent = _bare_agent()
+    agent._emit_auxiliary_failure = lambda *_args, **_kwargs: None
+    worker = threading.Thread(
