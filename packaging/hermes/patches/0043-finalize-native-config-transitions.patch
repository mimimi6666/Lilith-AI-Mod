+def test_model_commit_reenumerates_late_agent_and_invalidates_deferred_build(
+    monkeypatch,
+):
+    import types
+    from agent.identity_policy import (
+        NativeAuthorityTransitionBusyError,
+        enforce_scoped_turn_identity,
+    )
+    from hermes_cli.env_loader import load_hermes_dotenv
+    from tools.approval import _capture_native_approval_policy
+
+    class SessionDb:
+        def __init__(self, model_config):
+            self.row = {"model_config": json.dumps(model_config)}
+
+        def get_session(self, _session_id):
+            return dict(self.row)
+
+        def update_session_meta(self, _session_id, model_config, model=None):
+            self.row["model_config"] = model_config
+
+    soul = "Lilith soul.\n"
+    personality = "You are Lilith.\n"
+    config = _strict_config(personality)
+    config["model"] = {
+        "default": "deepseek-v4-flash",
+        "provider": "deepseek",
+    }
+    raw = _write_config(config)
+    (_home() / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    _attest_strict_host(monkeypatch, raw, soul, personality)
+    load_hermes_dotenv(hermes_home=_home())
+    old_digest = hashlib.sha256(raw).hexdigest()
+    # Simulates an eager resume/branch whose constructor starts before phase
+    # one but does not reach the registry publication boundary until after the
+    # durable receipt commit has completed.
+    stale_eager_candidate = _new_strict_agent()
+    approval_mode, enabled_toolsets = _capture_native_approval_policy()
+
+    digest = server._persist_model_switch(
+        types.SimpleNamespace(
+            new_model="gemini-3-flash-preview",
+            target_provider="gemini",
+            base_url=None,
+        )
+    )
+
+    # Both sessions appeared after phase one. The already-new agent must be
+    # verified rather than rebound; the dormant session's old state.db row
+    # must be rebound and its in-flight candidate made stale by revision.
+    late_agent = _new_strict_agent()
+    late_db = SessionDb(late_agent._session_init_model_config)
+    late_agent._session_db = late_db
+    server._sessions["late-agent"] = {
+        "session_key": "late-agent-key",
+        "agent": late_agent,
+        "history_lock": threading.RLock(),
+        "running": False,
+        "tool_started_at": {},
+    }
+    dormant_db = SessionDb({"_identity_config_sha256": old_digest})
+    monkeypatch.setattr(server, "_get_db", lambda: dormant_db)
+    server._sessions["late-build"] = {
+        "session_key": "late-build-key",
+        "agent": None,
+        "history_lock": threading.RLock(),
+        "running": False,
+        "tool_started_at": {},
+        "agent_build_started": True,
+        "agent_runtime_revision": 7,
+    }
+
+    receipt = {
+        "schema_version": 1,
+        "source": "hermes.model.default.set",
+        "sequence": 1,
+        "canonical_base_sha256": old_digest,
+        "previous_config_sha256": old_digest,
+        "config_sha256": digest,
+        "identity_fingerprint_sha256": "a" * 64,
+        "soul_sha256": hashlib.sha256(soul.encode("utf-8")).hexdigest(),
+        "personality_sha256": hashlib.sha256(
+            personality.encode("utf-8")
+        ).hexdigest(),
+        "approval_mode": approval_mode,
+        "enabled_toolsets": list(enabled_toolsets),
+    }
+    receipt_raw = json.dumps(receipt, separators=(",", ":")).encode("utf-8")
+    (_home() / "runtime" / "native-config-receipt.v1.json").write_bytes(
+        receipt_raw
+    )
+    response = server._methods["model.default.commit"](
+        "late-commit",
+        {
+            "authority": "lilith-runtime-native-config.v1",
+            "previous_config_sha256": old_digest,
+            "config_sha256": digest,
+            "receipt_sha256": hashlib.sha256(receipt_raw).hexdigest(),
+        },
+    )
+
+    assert response["result"] == {"committed": 1}
+    assert server._sessions["late-build"]["agent_runtime_revision"] == 8
+    assert json.loads(dormant_db.row["model_config"])[
+        "_identity_config_sha256"
+    ] == digest
+    assert json.loads(late_db.row["model_config"])[
+        "_identity_config_sha256"
+    ] == digest
+    enforce_scoped_turn_identity(late_agent)
+    try:
+        with pytest.raises(
+            NativeAuthorityTransitionBusyError,
+            match="stale native config",
+        ):
+            server._init_session(
+                "stale-eager",
+                "stale-eager-key",
+                stale_eager_candidate,
+                [],
+            )
+    finally:
+        stale_eager_candidate.close()
+    assert "stale-eager" not in server._sessions
+
