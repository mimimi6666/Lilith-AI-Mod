+def test_deferred_failed_registration_keeps_database_open_until_teardown(
+    monkeypatch,
+):
+    import agent.identity_policy as identity_policy
+
+    class RecordingDb:
+        def __init__(self):
+            self.close_count = 0
+
+        def get_session(self, session_id):
+            if self.close_count:
+                raise RuntimeError("database is closed")
+            return {"id": session_id}
+
+        def close(self):
+            self.close_count += 1
+
+    class RecordingAgent:
+        def __init__(self, db):
+            self._session_db = db
+            self._owns_session_db = False
+
+        def close(self):
+            if self._owns_session_db:
+                self._owns_session_db = False
+                self._session_db.close()
+
+    db = RecordingDb()
+    agent = RecordingAgent(db)
+    teardown_done = threading.Event()
+    server._sessions["failed-registration"] = {
+        "session_key": "failed-registration-key",
+        "agent": agent,
+    }
+
+    def _teardown(session, *, end_reason):
+        session["agent"].close()
+        teardown_done.set()
+
+    monkeypatch.setattr(server, "_teardown_session", _teardown)
+    nonce = "2" * 64
+    identity_policy.begin_native_authority_commit_pending(
+        {
+            "session_key": "__runtime_model_default__",
+            "commit_nonce": nonce,
+            "source": "hermes.model.default.set",
+        }
+    )
+    assert server._discard_failed_session_registration(
+        "failed-registration",
+        end_reason="resume_init_failed",
+    ) is None
+    assert server._preserve_deferred_session_db(
+        "failed-registration",
+        agent,
+        db,
+    ) is True
+    assert db.get_session("failed-registration-key")["id"] == (
+        "failed-registration-key"
+    )
+    assert "failed-registration" in server._sessions
+
+    identity_policy.clear_native_authority_commit_pending(nonce)
+    assert teardown_done.wait(timeout=1)
+    assert "failed-registration" not in server._sessions
+    assert db.close_count == 1
