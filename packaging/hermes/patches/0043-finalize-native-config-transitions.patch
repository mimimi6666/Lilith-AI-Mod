+def adopt_verified_native_config_digest(
+    agent: Any,
+    *,
+    previous_config_sha256: str,
+    config_sha256: str,
+) -> None:
+    """Rebind one blocked strict agent after a verified native approval.
+
+    A strict ``always`` choice rewrites only the native command allowlist while
+    the requesting tool call is paused. Runtime verifies and durably receipts
+    that exact rewrite before the waiter is released. Adopt the new whole-file
+    digest only after that proof so the same turn can report the tool's real
+    outcome instead of failing its next model iteration against the old pin.
+    """
+
+    policy = policy_for_agent(agent)
+    if not policy.enabled:
+        raise IdentityPolicyError(
+            "native config digest adoption requires a strict agent"
+        )
+    previous = _native_receipt_digest(
+        previous_config_sha256, "previous config digest"
+    )
+    current = _native_receipt_digest(config_sha256, "config digest")
+    from hermes_cli.env_loader import assert_trusted_identity_config_digest
+
+    assert_trusted_identity_config_digest(current)
+    preflight = preflight_aia_agent_identity(request_overrides={})
+    if not hmac.compare_digest(preflight.config_sha256, current):
+        raise IdentityPolicyError(
+            "native approval config digest did not match live identity"
+        )
+    agent_digest = str(
+        getattr(agent, "_identity_config_sha256", "") or ""
+    ).strip().lower()
+    model_config = getattr(agent, "_session_init_model_config", None)
+    stored_digest = (
+        str(model_config.get("_identity_config_sha256") or "")
+        .strip()
+        .lower()
+        if isinstance(model_config, dict)
+        else ""
+    )
+    if not hmac.compare_digest(agent_digest, previous) or not hmac.compare_digest(
+        stored_digest, previous
+    ):
+        raise IdentityPolicyError(
+            "native approval agent did not retain the prepared config digest"
+        )
+
+    agent._identity_config_sha256 = current
+    model_config["_identity_config_sha256"] = current
+
+
