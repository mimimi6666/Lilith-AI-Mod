+def test_permanent_approval_rebinds_live_strict_agent_before_release(
+    monkeypatch,
+):
+    from agent.identity_policy import enforce_scoped_turn_identity
+    from hermes_cli.env_loader import load_hermes_dotenv
+
+    class SessionDb:
+        def __init__(self, row):
+            self.row = dict(row)
+
