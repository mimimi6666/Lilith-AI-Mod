+    enforce_scoped_turn_identity(agent)
+    durable = json.loads(db.row["model_config"])
+    assert durable["_identity_config_sha256"] == prepared["config_sha256"]
+    with approval._lock:
+        approval._permanent_approved.discard("dangerous:test")
