+    identity_policy.clear_native_authority_commit_pending(nonce)
+
+    assert not submitter.is_alive()
+    assert responses[0]["error"]["code"] == 4090
+    assert responses[0]["error"]["data"]["pending_transition"] is True
+    assert responses[0]["error"]["data"]["restart_required"] is False
+    assert session.get("running") is False
+    assert session.get("inflight_turn") is None
