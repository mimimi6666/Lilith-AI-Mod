+    (_home() / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    _attest_strict_host(monkeypatch, old_raw, soul, personality)
+    load_hermes_dotenv(hermes_home=_home())
+    agent = _new_strict_agent()
