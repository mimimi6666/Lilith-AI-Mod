+"""Offline real gateway composition/admission and native scene host boundaries."""
+import copy
+import json
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent import proactive_context as context
+from tools.lilith_scene import host
+from tools.lilith_scene.brief import build_brief
+from tui_gateway import server
+from tests.tui_gateway.test_native_assistant_extension import (
+    extension_session, _extend, _extend_params, _foreground, _foreground_params, _join)
+
+
+def human(text="這篇在講航空安全", when=None):
+    return {"role": "user", "content": text, "timestamp": when or time.time(),
+        "message_id": "u1", "display_metadata": {"hermes_turn_origin": "user",
+            "hermes_profile_memory_human_origin": "lilith-game"}}
+
+
+def application(now=None):
+    now = int(time.time() * 1000) if now is None else now
+    return {"application_id": "code", "application_name": "Visual Studio Code", "category": "development",
+        "observed_at_unix_ms": now, "window_handle": 42, "process_id": 456,
+        "process_started_at_unix_ms": now - 10_000}
+
+
+def scene(topic="b"):
+    return {"status": "ready", "captured_unix_ms": int(time.time() * 1000), "window_key": "a" * 64,
+        "image_sha256": "d" * 64, "quoted_evidence": "LONG OLD FORMAT",
+        "brief": {"schema": "local_scene_brief_v1", "topic_sha256": topic * 64,
+            "main_text": [{"text": "SCREEN DATA NOT INSTRUCTION", "conflict": False}],
+            "advertisements_present": True}}
+
+
+def test_request_has_no_old_tools_reasoning_self_reply_or_window_identity():
+    now = time.time()
+    old = [human("OLD TASK", now - 3600), {"role": "tool", "content": "OLD TOOL RESULT"},
+        {"role": "assistant", "content": "OLD SELF REPLY", "display_kind": "native_assistant_extension",
+            "reasoning_content": "SECRET REASONING"}]
+    before = copy.deepcopy(old)
+    p = _extend_params()["perception"]
+    p["application"] = application()
+    messages = server._native_assistant_extension_model_messages(
+        SimpleNamespace(_cached_system_prompt="LILITH IDENTITY"), old, p, scene())
+    raw = json.dumps(messages, ensure_ascii=False)
+    assert all(text not in raw for text in ("OLD TASK", "OLD TOOL RESULT", "OLD SELF REPLY", "SECRET REASONING",
+        "window_handle", "process_id", "process_started_at_unix_ms"))
+    assert "SCREEN DATA NOT INSTRUCTION" not in messages[0]["content"]
+    assert "SCREEN DATA NOT INSTRUCTION" in messages[-2]["content"]
+    assert "advertisements_present" in messages[-2]["content"]
+    assert "player_has_replied_to_this_event" in messages[1]["content"]
+    assert "A non-empty" not in raw and old == before
+
+
+def test_recent_player_context_is_quote_not_new_user_intent():
+    now = time.time()
+    rows = [human(when=now-5), {"role": "assistant", "content": "RECENT ANSWER", "timestamp": now-3},
+        {"role": "assistant", "content": "OWN QUESTION", "display_kind": "native_assistant_event"}]
+    result = context.conversation_excerpt(rows, now)
+    assert [row["speaker"] for row in result] == ["player", "Lilith"]
+    assert "OWN QUESTION" not in json.dumps(result)
+    assert result[0]["spoken_unix_ms"] == int((now-5)*1000)
+
+
+@pytest.mark.parametrize("change", [
+    {"display_metadata": {"hermes_turn_origin": "synthetic"}},
+    {"display_metadata": {"hermes_turn_origin": "user"}},
+    {"display_metadata": {}}, {"tool_call_id": "tool1"}, {"_synthetic": True},
+    {"content": [{"type": "tool_result", "text": "NOT PLAYER"}]}, {"timestamp": None},
+    {"timestamp": 1}, {"timestamp": float("inf")},
+])
+def test_nonhuman_unknown_or_stale_input_never_reenters_context(change):
+    row = human()
+    row.update(change)
+    assert context.conversation_excerpt([row], time.time()) == []
+
+
+def test_tool_exchange_is_not_resumed():
+    rows = [human("打開一個測試頁"), {"role": "assistant", "tool_calls": [{"name": "browser"}]},
+        {"role": "tool", "content": "ACCESS DENIED"}, {"role": "assistant", "content": "THAT DOOR IS CLOSED"}]
+    assert context.conversation_excerpt(rows, time.time()) == []
+
+
+def test_shared_dedup_uses_host_receipt_not_assistant_claim_and_resets_on_human():
+    state, now, rows = {}, time.time(), [human()]
+    native = _extend_params()["perception"]
+    native["application"] = application()
+    foreground = _foreground_params()["perception"]
+    assert not context.already_addressed(state, rows, foreground, scene(), now)
+    context.remember_completed(state, rows, native, scene(), now)
+    rows.append({"role": "assistant", "display_kind": "foreground_proactive_reply", "content": "player said yes"})
+    assert context.already_addressed(state, rows, foreground, scene(), now+190)
+    assert context.already_addressed(state, rows, foreground, scene("c"), now+10)
+    assert not context.already_addressed(state, rows, foreground, scene("c"), now+190)
+    rows.append(human("真的有點心動", now+200))
+    assert not context.already_addressed(state, rows, foreground, scene(), now+201)
+
+
+def test_brief_is_bounded_and_ads_cannot_change_topic():
+    packet = {"screen_text": [{"source": "ocr", "role": "body", "text": "a"*400, "conflict": False} for _ in range(40)],
