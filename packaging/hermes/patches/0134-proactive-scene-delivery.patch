diff --git a/tests/test_notification_speech.py b/tests/test_notification_speech.py
new file mode 100644
--- /dev/null
+++ b/tests/test_notification_speech.py
@@ -0,0 +1,357 @@
+"""Synthetic durable events, actual economic/identity/SDK guards, no network."""
+import copy
+from contextlib import ExitStack, nullcontext
+import hashlib
+import json
+import os
+from pathlib import Path
+import threading
+import time
+import unittest
+import uuid
+from unittest.mock import patch
+
+
+class NotificationSpeechTests(unittest.TestCase):
+    def setUp(self):
+        import httpx
+        import requests
+        import yaml
+        import run_agent
+        import tools.env_probe
+        from hermes_cli import provider_setup
+        from agent import auxiliary_client, speech_recovery
+        from agent.usage_budget_runtime import get_runtime, capture_origin
+        from tui_gateway import server, speech_origin
+        self.server, self.origin, self.recovery = server, speech_origin, speech_recovery
+        self.profile = Path(os.environ["HERMES_HOME"])
+        self.identity, self.model = "custom:" + "e" * 32, "synthetic-model"
+        self.text, self.spoken = "這篇介紹很有意思呢。", "この紹介はとても面白いですね。"
+        soul, personality, fingerprint = "SYNTHETIC PINNED SOUL\n", "SYNTHETIC LOCKED VOICE\n", "d" * 64
+        config = {"model": {"default": self.model, "provider": self.identity},
+            "memory": {"memory_enabled": False, "user_profile_enabled": False},
+            "skills": {"creation_nudge_interval": 0}, "auxiliary": {"title_generation": {"enabled": False}},
+            "identity": {"require_soul": True, "suppress_kernel_help": True, "personality_allowlist": ["lilith"],
+                "locked_personality": "lilith", "force_soul_for_children": True, "fingerprint": fingerprint.upper()},
+            "display": {"personality": "lilith"},
+            "agent": {"system_prompt": "", "personalities": {"lilith": {"system_prompt": personality}}},
+            "providers": {self.identity[7:]: {"name": self.identity[7:], "base_url": "http://127.0.0.1:1234/v1",
+                "default_model": self.model, "models": {self.model: {}}, "api_mode": "chat_completions",
+                "discover_models": False, "key_env": provider_setup.key_env(self.identity), "auth_mode": "none",
+                "lilith_setup": {"schema_version": 1, "label": "Synthetic local", "preset_id": "lmstudio",
+                    "kind": "local", "last_operation_id": "synthetic"}}}}
+        (self.profile / "config.yaml").write_text(yaml.safe_dump(config), encoding="utf-8")
+        (self.profile / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+        (self.profile / ".env").write_text("", encoding="utf-8")
+        pins = dict(HERMES_IDENTITY_REQUIRED="1", HERMES_IDENTITY_EXPECTED_FINGERPRINT=fingerprint,
+            HERMES_IDENTITY_EXPECTED_CONFIG_SHA256=hashlib.sha256((self.profile / "config.yaml").read_bytes()).hexdigest(),
+            HERMES_IDENTITY_EXPECTED_SOUL_SHA256=hashlib.sha256(soul.encode()).hexdigest(),
+            HERMES_IDENTITY_EXPECTED_PERSONALITY_SHA256=hashlib.sha256(personality.encode()).hexdigest())
+        self.stack = ExitStack()
+        self.addCleanup(self.stack.close)
+        self.stack.enter_context(patch.dict(os.environ, pins))
+        self.calls, self.clients, self.databases = [], [], []
+        self.mode, self.target_locale = "ok", "ja"
+        original = httpx.Client.__init__
+
+        def response(request):
+            body = json.loads(request.content)
+            if not str(request.url).endswith("/chat/completions"):
+                # The native local-capability probe is mocked metadata too,
+                # not a model request. Never send it to a listening service.
+                return httpx.Response(200, json={"data": [], "capabilities": []})
+            self.calls.append((body, capture_origin()))
+            self.assertNotIn("Authorization", request.headers)
+            self.assertEqual("http://127.0.0.1:1234/v1/chat/completions", str(request.url))
+            if self.mode == "transport_failure":
+                return httpx.Response(503, json={"error": {"message": "synthetic unavailable"}})
+            if self.mode == "stop_during_send":
+                self.session["_turn_cancel_requested"] = True
+            content = json.dumps({"speech_text": self.spoken if self.target_locale == "ja" else self.text,
+                                  "speech_emotion": "gentle"}, ensure_ascii=False)
+            if body["messages"][0]["content"] not in {
+                    speech_recovery.COMPACT_SYSTEM, getattr(speech_recovery, "COMPACT_CHINESE_SYSTEM", "")}:
+                content = json.dumps({"text": self.text}, ensure_ascii=False)
+            return httpx.Response(200, json={"id": "synthetic", "object": "chat.completion", "created": 0,
+                "model": self.model, "choices": [{"index": 0,
+                    "message": {"role": "assistant", "content": content},
+                    "finish_reason": "length" if self.mode == "partial" else "stop"}]})
+
+        def mock_init(client, *args, **kwargs):
+            kwargs["transport"] = httpx.MockTransport(response)
+            original(client, *args, **kwargs)
+            self.clients.append(client)
+
+        def catalog(*args, **kwargs):
+            result = requests.Response()
+            result.status_code, result._content = 200, b'{"data":[]}'
+            return result
+
+        self.stack.enter_context(patch.object(httpx.Client, "__init__", mock_init))
+        self.stack.enter_context(patch.object(requests.Session, "request", catalog))
+        self.stack.enter_context(patch.object(tools.env_probe, "warm_environment_probe_async", lambda *a, **k: None))
+        self.stack.enter_context(patch.object(tools.env_probe, "get_environment_probe_line", lambda *a, **k: "synthetic environment"))
+        self.agent = run_agent.AIAgent(model=self.model, provider=self.identity, api_mode="chat_completions",
+            api_key="", base_url="http://127.0.0.1:1234/v1", max_tokens=2048,
+            session_id="synthetic", enabled_toolsets=[], skip_context_files=True, skip_memory=True,
+            skip_background_review=True, quiet_mode=True)
+        self.agent._cached_system_prompt = self.agent._build_system_prompt(None)
+        self.agent._persist_disabled, self.agent._disable_streaming = True, True
+        self.runtime = get_runtime(self.profile)
+        self.projection = server._methods["prompt.project_speech"]
+        self.addCleanup(auxiliary_client.shutdown_cached_clients)
+        self.addCleanup(lambda: [client.close() for client in self.clients])
+        self.addCleanup(lambda: [db.close() for db in self.databases])
+
+    def completed(self, *, level=6, source="foreground-application", publish=True):
+        from hermes_state import SessionDB
+        from agent.native_extension_delivery import accept_claim, delivery_scope
+        from agent.usage_budget_preferences import PreferenceUpdate
+        self.runtime.store.set(PreferenceUpdate(uuid.uuid4().hex, self.runtime.store.get().revision, level))
+        sid, event, turn, message, owner = [uuid.uuid4().hex for _ in range(5)]
+        db = SessionDB(self.profile / (sid + ".db"))
+        self.databases.append(db)
+        db.create_session(sid, source="lilith-game", archived=True)
+        perception = dict(schema_version=1, source=source, application_id="browser", application_name="Browser",
+                          category="browser", observed_at_unix_ms=1791475200000, locale="zh-Hant")
+        if source == "official-native-dialogue":
+            perception = dict(schema_version=1, source=source, text="在看什麼呢？", occurred_at_unix_ms=1791475200000,
+                              node_id="1", line_id="1", trigger="native.dialogue.complete", locale="zh-Hant")
+            db.append_native_assistant_event(sid, lineage_session_ids=[sid], event_id=event, source="lilith-native",
+                **{k: v for k, v in perception.items() if k not in {"schema_version", "source"}})
+        perception_hash = hashlib.sha256(json.dumps(perception, ensure_ascii=False, sort_keys=True,
+                                                   separators=(",", ":")).encode()).hexdigest()
+        claim = db.claim_native_assistant_extension(sid, lineage_root=sid, lineage_session_ids=[sid],
+            event_id=event, perception=perception, perception_sha256=perception_hash, turn_id=turn,
+            assistant_message_id=message, owner_pid=os.getpid(), owner_started_at=123456,
+            owner_token=owner, abandon=False)
+        native = accept_claim(self.profile, claim)
+        self.session = dict(agent=self.agent, source="lilith-game", archived=True, session_key=sid,
+            _durable_lineage_root=sid, history_lock=threading.RLock(), history=[], history_version=0,
+            running=True, inflight_turn=None, profile_home=self.profile,
+            _native_assistant_extension=dict(event_id=event, turn_id=turn, owner_token=owner))
+        with delivery_scope(native, self.agent, profile=self.profile, event_id=event, turn_id=turn,
+                            owner_token=owner) as handle:
+            pending = self.origin.capture_native_completed(self.session, sid, event_id=event, turn_id=turn,
+                assistant_message_id=message, owner_token=owner, text=self.text,
+                native_origin=native, perception_source=source)
+        terminal = db.finish_native_assistant_extension(sid, lineage_root=sid, event_id=event,
+            perception_sha256=perception_hash, turn_id=turn, assistant_message_id=message,
+            status="completed", text=self.text, perception_source=source)
+        self.session["history"].append(terminal["message"])
+        self.session["history_version"] += 1
+        if publish:
+            self.assertTrue(self.origin.publish_native_completed(self.session, pending, terminal))
+        self.session["running"] = False
+        self.session.pop("_native_assistant_extension", None)
+        self.grant, self.terminal, self.handle, self.db, self.native = pending, terminal, handle, db, native
+        return dict(session_id=sid, text=self.text, display_locale="zh-Hant", speech_locale=self.target_locale,
+                    turn_id=turn, notification_event_id=event, notification_message_id=message)
+
+    def rpc(self, params):
+        with patch.object(self.server, "_sess", return_value=(self.session, None)), \
+             patch.object(self.server, "_attest_durable_lineage_postcondition",
+                          return_value={"stored_session_id": self.session["session_key"]}):
+            return self.projection("synthetic", params)
+
+    def test_legacy_without_origin_is_closed(self):
+        # Baseline reproducer: a later notification RPC has no economic scope.
