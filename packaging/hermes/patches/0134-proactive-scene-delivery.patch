@@ -0,0 +1,157 @@
+"""Request-only proactive context and host-owned, process-local deduplication.
+
+No transcript writes, model calls, tools, permission changes or semantic guesses.
+The gateway supplies already-authenticated event/history/scene observations.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+
+APPLICATION_FIELDS = frozenset({"application_id", "application_name", "category",
+    "observed_at_unix_ms", "window_handle", "process_id", "process_started_at_unix_ms"})
+SYNTHETIC_KINDS = frozenset({"native_assistant_event", "native_assistant_extension", "foreground_proactive_reply"})
+HISTORY_TTL_SECONDS = 300
+
+
+def valid_application(value, occurred_at):
+    if not isinstance(value, dict) or set(value) != APPLICATION_FIELDS:
+        return False
+    for name, limit in (("application_id", 128), ("application_name", 128), ("category", 64)):
+        text = value.get(name)
+        if not isinstance(text, str) or not text.strip() or len(text) > limit or "\x00" in text:
+            return False
+        try:
+            text.encode("utf-8")
+        except UnicodeEncodeError:
+            return False
+    for key in ("observed_at_unix_ms", "window_handle", "process_id", "process_started_at_unix_ms"):
+        if type(value.get(key)) is not int or not 0 < value[key] < 2**63:
+            return False
+    return (type(occurred_at) is int and value["observed_at_unix_ms"] <= occurred_at
+        and occurred_at - value["observed_at_unix_ms"] <= 30_000
+        and value["process_started_at_unix_ms"] <= value["observed_at_unix_ms"])
+
+
+def _metadata(row):
+    value = row.get("display_metadata")
+    return value if isinstance(value, dict) else {}
+
+
+def genuine_player(row):
+    if not isinstance(row, dict) or row.get("role") != "user":
+        return False
+    # Use the existing host-issued human-surface attestation. A generic user
+    # role/origin can represent cron or tool completions in Hermes, so unknown
+    # legacy provenance is omitted instead of guessed to be a player response.
+    meta = _metadata(row)
+    origin = meta.get("hermes_turn_origin", row.get("_turn_origin"))
+    return (origin == "user" and meta.get("hermes_profile_memory_human_origin") in
+        {"lilith-game", "lilith-runtime", "telegram-paired"} and not row.get("tool_call_id")
+        and not row.get("_synthetic") and not row.get("synthetic")
+        and row.get("display_kind") not in SYNTHETIC_KINDS
+        and isinstance(row.get("content"), str) and bool(row["content"].strip()))
+
+
+def _time(row):
+    value = row.get("timestamp")
+    return float(value) if type(value) in (float, int) and math.isfinite(value) and value > 0 else None
+
+
+def player_revision(history):
+    for row in reversed(history):
+        if genuine_player(row):
+            # Hash only used in transient host state, never reported as proof of
+            # user intent. A new actual row, not another proactive line, resets it.
+            return hashlib.sha256(json.dumps([row.get("message_id"), row.get("timestamp"),
+                row["content"]], ensure_ascii=False).encode()).hexdigest()
+    return "no-player-turn"
+
+
+def conversation_excerpt(history, now):
+    """At most the latest recent genuine player text and its direct text reply.
+
+    This is quoted background, not a fresh user message or an unfinished task.
+    No API-only text, tool results/calls, reasoning or older proactive monologues.
+    """
+    result = []
+    for index in range(len(history) - 1, -1, -1):
+        row = history[index]
+        if not genuine_player(row):
+            continue
+        timestamp = _time(row)
+        if timestamp is None or not 0 <= now - timestamp <= HISTORY_TTL_SECONDS:
+            return []
+        result.append({"speaker": "player", "spoken_unix_ms": int(timestamp * 1000),
+            "text": row["content"][:1200]})
+        for reply in history[index + 1:]:
+            if not isinstance(reply, dict):
+                continue
+            if genuine_player(reply) or reply.get("display_kind") in SYNTHETIC_KINDS:
+                break
+            if reply.get("role") == "tool" or reply.get("tool_calls"):
+                # A completed computer task is not an invitation to resume it.
+                return []
+            if reply.get("role") == "assistant" and isinstance(reply.get("content"), str):
+                meta = _metadata(reply)
+                if meta.get("hermes_turn_origin") == "synthetic":
+                    break
+                when = _time(reply)
+                if when is not None and timestamp <= when <= now:
+                    result.append({"speaker": "Lilith", "spoken_unix_ms": int(when * 1000),
+                        "text": reply["content"][:700]})
+                break
+        return result
+    return []
+
+
+def public_perception(perception):
+    value = {key: item for key, item in perception.items() if key != "application"}
+    application = perception.get("application")
+    if isinstance(application, dict):
+        value["application"] = {key: application[key] for key in
+            ("application_id", "application_name", "category", "observed_at_unix_ms")}
+    return value
+
+
+def scene_topic(perception, scene):
+    application = perception.get("application") or perception
+    app = application.get("application_id") or ("native:" + str(perception.get("node_id", "")))
+    if scene is None:
+        material = [app, "coarse"]
+    else:
+        brief = scene.get("brief")
+        topic = brief.get("topic_sha256") if isinstance(brief, dict) else None
+        # Legacy evidence from an older worker remains bounded/fresh but cannot
+        # supply a trustworthy structural topic; image identity is conservative.
+        material = [app, scene.get("window_key"), topic or scene.get("image_sha256")]
+    return hashlib.sha256(json.dumps(material, sort_keys=True).encode()).hexdigest()
+
+
+def recently_addressed(session, history, now):
+    state = session.get("_proactive_context_receipts")
+    if not isinstance(state, dict) or state.get("player_revision") != player_revision(history):
+        return False
+    # Across both producers, a recent successful line gets room to land. This
+    # does not alter the existing producer's three-minute schedule.
+    latest = state.get("last_completed_at", 0)
+    return 0 <= now - latest < 180
+
+
+def already_addressed(session, history, perception, scene, now):
+    state = session.get("_proactive_context_receipts")
+    if not isinstance(state, dict) or state.get("player_revision") != player_revision(history):
+        return False
+    return recently_addressed(session, history, now) or scene_topic(perception, scene) in state.get("topics", ())
+
+
+def remember_completed(session, history, perception, scene, now):
+    revision = player_revision(history)
+    previous = session.get("_proactive_context_receipts") or {}
+    topics = list(previous.get("topics", ())) if previous.get("player_revision") == revision else []
+    topic = scene_topic(perception, scene)
+    if topic not in topics:
+        topics.append(topic)
+    session["_proactive_context_receipts"] = {"player_revision": revision,
+        "last_completed_at": now, "topics": topics[-16:]}
