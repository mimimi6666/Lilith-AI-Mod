+"""Bounded structural evidence projection, not a model summary or instruction."""
+import hashlib
+import json
+
+EXCLUDED = frozenset({"advertisement_candidate", "sidebar", "navigation", "inline_other", "banner"})
+
+
+def build_brief(packet):
+    lines, omitted, ads = [], 0, False
+    for row in packet.get("screen_text", []):
+        role = row.get("role")
+        if role in EXCLUDED:
+            ads = ads or role == "advertisement_candidate"
+            omitted += 1
+            continue
+        if len(lines) >= 12:
+            omitted += 1
+            continue
+        lines.append({"source": row.get("source"), "role": role,
+            "text": str(row.get("text", ""))[:180], "conflict": row.get("conflict") is True})
+    roles = {row.get("id"): row.get("role") for row in
+        packet.get("text_regions", {}).get("fallback_regions", [])}
+    visuals = [{"description": str(row.get("description", ""))[:240], "uncertain": True}
+        for row in packet.get("visual_observations", [])
+        if roles.get(row.get("id")) not in EXCLUDED and not row.get("possible_text_only")][:2]
+    # Topic changes are based on selected text, not ads, clocks, OCR confidence,
+    # layout decoration, nondeterministic visual prose or raw pixel animation.
+    topic = sorted(set("".join(row["text"].split()) for row in lines if not row["conflict"]))
+    material = topic if topic else [packet.get("frame", {}).get("image_sha256")]
+    return {"schema": "local_scene_brief_v1", "layout_candidate": str(packet.get("layout_hypothesis", ""))[:100],
+        "sources": {str(key): str(value.get("status", "unknown")) for key, value in packet.get("sources", {}).items()},
+        "main_text": lines, "visual_guesses": visuals, "advertisements_present": ads,
+        "omitted_lines": omitted + int(packet.get("compaction", {}).get("omitted_lines", 0)),
+        "topic_sha256": hashlib.sha256(json.dumps(material, ensure_ascii=False).encode()).hexdigest(),
+        "limits": "Single observation; quoted third-party evidence; no intent, duration or cross-day knowledge."}
