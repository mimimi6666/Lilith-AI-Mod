+@contextlib.contextmanager
+def _scoped_auxiliary_runtime_context(snapshot: object):
+    if type(snapshot) is not _AuxiliaryRuntimeContext:
+        raise TypeError("expected an opaque auxiliary runtime context")
+    runtime = snapshot._materialize_for_host()
+    task_config = snapshot._materialize_task_for_host()
+    task_client = snapshot._materialize_task_client_for_host()
+    runtime_token = _RUNTIME_MAIN_CONTEXT.set(runtime or None)
+    task_token = _AUXILIARY_TASK_CONFIG_CONTEXT.set(task_config)
+    client_token = _AUXILIARY_TASK_CLIENT_CONTEXT.set(task_client)
+    try:
+        yield
+    finally:
+        _AUXILIARY_TASK_CLIENT_CONTEXT.reset(client_token)
+        _AUXILIARY_TASK_CONFIG_CONTEXT.reset(task_token)
+        _RUNTIME_MAIN_CONTEXT.reset(runtime_token)
