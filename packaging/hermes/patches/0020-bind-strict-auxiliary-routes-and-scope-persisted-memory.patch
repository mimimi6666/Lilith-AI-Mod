+def _strict_exact_openai_headers(
+    provider: str,
+    base_url: str,
+    api_key: Any,
+    *,
+    is_vision: bool = False,
+) -> Dict[str, str]:
+    """Return deterministic transport headers without reading a profile."""
+
+    headers: Dict[str, str] = {}
+    if provider == "openrouter":
+        headers.update(_OR_HEADERS_BASE)
+    elif provider == "openai-codex":
+        headers.update(_codex_cloudflare_headers(str(api_key or "")))
+    elif provider == "xai-oauth" or base_url_host_matches(base_url, "x.ai"):
+        from tools.xai_http import hermes_xai_default_headers
+
+        headers.update(hermes_xai_default_headers())
+    elif base_url_host_matches(base_url, "api.kimi.com"):
+        headers["User-Agent"] = "claude-code/0.1.0"
+    elif base_url_host_matches(base_url, "githubcopilot.com"):
+        from hermes_cli.copilot_auth import copilot_request_headers
+
+        headers.update(
+            copilot_request_headers(
+                is_agent_turn=True,
+                is_vision=is_vision,
+            )
+        )
+    elif base_url_host_matches(base_url, "integrate.api.nvidia.com"):
+        headers.update(build_nvidia_nim_headers(base_url))
