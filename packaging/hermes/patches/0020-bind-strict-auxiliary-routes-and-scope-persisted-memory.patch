+def test_slot_runtime_cache_prunes_expired_secrets_and_enforces_hard_cap(monkeypatch):
+    now = 10_000.0
+    monkeypatch.setattr(moa_loop.time, "monotonic", lambda: now)
+    expired_key = ("provider", "model", "profile", "old-session", "fingerprint")
+    moa_loop._runtime_cache[expired_key] = (
+        now - moa_loop._RUNTIME_CACHE_TTL_SECONDS - 1,
+        {"api_key": "expired-raw-secret"},
+    )
+    for index in range(moa_loop._RUNTIME_CACHE_MAX_SIZE + 20):
+        moa_loop._runtime_cache[("p", str(index), "profile", str(index), "fp")] = (
+            now - 1 + index / 1000,
+            {"api_key": f"bounded-secret-{index}"},
+        )
+
+    monkeypatch.setattr(
+        "hermes_cli.runtime_provider.resolve_runtime_provider",
+        lambda **_kwargs: {
+            "base_url": "https://current.example/v1",
+            "api_key": "current-secret",
+            "api_mode": "chat_completions",
+        },
+    )
+    result = moa_loop._slot_runtime(
+        {"provider": "current-provider", "model": "current-model"}
+    )
+
+    assert result["api_key"] == "current-secret"
+    assert expired_key not in moa_loop._runtime_cache
+    assert all(
+        row.get("api_key") != "expired-raw-secret"
+        for _stamp, row in moa_loop._runtime_cache.values()
+    )
+    assert len(moa_loop._runtime_cache) <= moa_loop._RUNTIME_CACHE_MAX_SIZE
