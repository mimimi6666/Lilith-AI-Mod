+class _FrozenAuxiliaryTaskClient:
+    """Opaque handle to one origin-materialized strict auxiliary client."""
+
+    __slots__ = ("__client", "__route", "__task")
+
+    def __init__(
+        self,
+        constructor: object,
+        *,
+        task: str,
+        route: tuple[Any, ...],
+        client: Any,
+    ) -> None:
+        if constructor is not _AUXILIARY_RUNTIME_CONTEXT_CONSTRUCTOR:
+            raise TypeError("frozen auxiliary clients are host-created")
+        object.__setattr__(self, "_FrozenAuxiliaryTaskClient__task", task)
+        object.__setattr__(self, "_FrozenAuxiliaryTaskClient__route", route)
+        object.__setattr__(self, "_FrozenAuxiliaryTaskClient__client", client)
+
+    def __setattr__(self, _name: str, _value: Any) -> None:
+        raise AttributeError("frozen auxiliary clients are immutable")
+
+    def __repr__(self) -> str:
+        return "<FrozenAuxiliaryTaskClient>"
+
+    __str__ = __repr__
+
+    def __reduce_ex__(self, _protocol: int):
+        raise TypeError("frozen auxiliary clients cannot be serialized")
+
+    def _materialize_for_host(
+        self,
+        *,
+        task: Optional[str],
+        route: tuple[Any, ...],
+    ) -> Any:
+        if str(task or "").strip() != self.__task or route != self.__route:
+            raise RuntimeError(
+                "strict auxiliary task does not match its frozen origin route"
+            )
+        return self.__client
+
+    def _contains_client_for_host(self, target: Any) -> bool:
+        return _clients_share_identity_for_host(self.__client, target)
+
+    def close(self) -> None:
+        _close_cached_client(self.__client)
+
+
+def _client_identity_chain_for_host(client: Any) -> tuple[Any, ...]:
+    """Return wrapper identities down to a client's ``_real_client`` leaf."""
+    chain: list[Any] = []
+    seen: set[int] = set()
+    current = client
+    # A bounded walk also keeps permissive test doubles (for example a
+    # MagicMock that manufactures every unknown attribute) from presenting an
+    # infinite chain. Real auxiliary adapters are only a few wrappers deep.
+    for _depth in range(16):
+        if current is None or id(current) in seen:
+            break
+        seen.add(id(current))
+        chain.append(current)
+        try:
+            current = getattr(current, "_real_client", None)
+        except Exception:
+            break
+    return tuple(chain)
+
+
+def _clients_share_identity_for_host(left: Any, right: Any) -> bool:
+    """Match either wrapper or leaf identity across both client facades."""
+    if left is None or right is None:
+        return False
+    right_ids = {id(client) for client in _client_identity_chain_for_host(right)}
+    return any(
+        id(client) in right_ids
+        for client in _client_identity_chain_for_host(left)
+    )
+
+
+class _AuxiliaryRuntimeContext:
+    """Opaque, in-memory-only snapshot of one auxiliary wire route.
+
+    Plugins receive this object only as a capability to hand back to
+    :func:`run_in_auxiliary_runtime_context`.  Keeping the values in a private
+    immutable tuple (rather than a public mapping) prevents accidental logging
+    or JSON persistence of the API key.  This is an isolation carrier for the
+    trusted in-process plugin API, not a sandbox against a plugin deliberately
+    using Python reflection.  It is also not a general ``Context``: approval,
+    gateway, secret-scope, Relay, and accounting ContextVars are deliberately
+    absent. ``session_id`` is retained solely as explicit prompt-cache routing
+    metadata already owned by the main runtime.
+    """
+
+    __slots__ = ("__task_client", "__task_config", "__task_name", "__values")
+
+    def __init__(
+        self,
+        constructor: object,
+        values: tuple[tuple[str, Any], ...],
+        *,
+        task_name: str = "",
+        task_config: Optional[Dict[str, Any]] = None,
+        task_client: Optional[_FrozenAuxiliaryTaskClient] = None,
+    ) -> None:
+        if constructor is not _AUXILIARY_RUNTIME_CONTEXT_CONSTRUCTOR:
+            raise TypeError("auxiliary runtime contexts are host-created")
+        object.__setattr__(self, "_AuxiliaryRuntimeContext__values", values)
+        object.__setattr__(self, "_AuxiliaryRuntimeContext__task_name", task_name)
+        object.__setattr__(
+            self,
+            "_AuxiliaryRuntimeContext__task_config",
+            copy.deepcopy(task_config) if task_config is not None else None,
+        )
+        object.__setattr__(
+            self,
+            "_AuxiliaryRuntimeContext__task_client",
+            task_client,
+        )
+
+    def __setattr__(self, _name: str, _value: Any) -> None:
+        raise AttributeError("auxiliary runtime contexts are immutable")
+
+    def __repr__(self) -> str:
+        return "<AuxiliaryRuntimeContext>"
+
+    __str__ = __repr__
+
+    def __reduce_ex__(self, _protocol: int):
+        raise TypeError("auxiliary runtime contexts cannot be serialized")
+
+    def _materialize_for_host(self) -> Dict[str, Any]:
+        return dict(self.__values)
+
+    def _materialize_task_for_host(
+        self,
+    ) -> Optional[Tuple[str, Dict[str, Any]]]:
+        if not self.__task_name or self.__task_config is None:
+            return None
+        return self.__task_name, copy.deepcopy(self.__task_config)
+
+    def _materialize_task_client_for_host(
+        self,
+    ) -> Optional[_FrozenAuxiliaryTaskClient]:
+        return self.__task_client
+
+
+def _auxiliary_runtime_is_concrete(runtime: Any) -> bool:
+    """Return whether *runtime* is a self-contained provider wire route."""
+
+    if not isinstance(runtime, dict):
+        return False
+    provider = str(runtime.get("provider") or "").strip().lower()
+    model = str(runtime.get("model") or "").strip()
+    base_url = str(runtime.get("base_url") or "").strip()
+    api_mode = str(runtime.get("api_mode") or "").strip()
+    api_key = runtime.get("api_key")
+    has_api_key = (
+        callable(api_key) and not isinstance(api_key, str)
+    ) or bool(isinstance(api_key, str) and api_key.strip())
+    return bool(
+        provider not in {"", "auto", "moa"}
+        and model
+        and base_url
+        and api_mode
+        and has_api_key
+    )
+
+
+_STRICT_FROZEN_TASK_KNOBS = (
+    "extra_body",
+    "max_concurrency",
+    "reasoning_effort",
+    "timeout",
+)
+
+
+def _freeze_auxiliary_task_config(
+    task: str,
+    main_runtime: Dict[str, Any],
+) -> Dict[str, Any]:
+    """Freeze one task's origin-profile config for isolated background work.
+
+    Generic hosts retain the complete effective task config, copied at the
+    caller.  Strict hosts retain only bounded non-authority tuning plus one
+    fully concrete route.  In particular, fallback chains and late key-env
+    lookups are absent, so a clean worker cannot switch to another profile's
+    provider or credential.
+    """
+
+    task_config = copy.deepcopy(_get_auxiliary_task_config(task))
+    from agent.identity_policy import (
+        assert_scoped_identity_request_overrides,
+        identity_lock_required_by_host,
+    )
+
+    if not identity_lock_required_by_host():
+        return task_config
+
+    assert_scoped_identity_request_overrides(
+        task_config.get("extra_body"),
+        required=True,
+    )
+    task_token = _AUXILIARY_TASK_CONFIG_CONTEXT.set((task, task_config))
+    try:
+        provider, model, base_url, api_key, api_mode = _resolve_task_provider_model(
+            task=task,
+        )
+    finally:
+        _AUXILIARY_TASK_CONFIG_CONTEXT.reset(task_token)
+    provider, model, base_url, api_key, api_mode = (
+        _materialize_host_required_auxiliary_route(
+            provider,
+            model,
+            base_url,
+            api_key,
+            api_mode,
+            main_runtime=main_runtime,
+        )
+    )
+    provider_name = str(provider or "").strip().lower()
+    declared_provider = _normalize_aux_provider(
+        str(task_config.get("provider") or "").strip()
+    )
+    # _resolve_task_provider_model historically labels any task with an
+    # explicit base+key as ``custom`` unless its provider appears in a
+    # separate catalog.  For a strict, already-complete route that destroys
+    # transport identity (notably Vertex/Bedrock). Preserve the caller's
+    # concrete provider label; exact materialization below still validates
+    # whether that transport is self-contained.
+    if (
+        provider_name == "custom"
+        and declared_provider not in {"", "auto", "custom", "moa"}
+        and task_config.get("base_url")
+        and task_config.get("api_key")
+    ):
+        provider_name = declared_provider
+    main_provider = str(main_runtime.get("provider") or "").strip().lower()
+    main_base_url = str(main_runtime.get("base_url") or "").strip().rstrip("/")
+    task_base_url = str(base_url or "").strip().rstrip("/")
+    if (
+        task_base_url
+        and not api_key
+        and not (
+            provider_name == main_provider
+            and task_base_url == main_base_url
+        )
+    ):
+        raise RuntimeError(
+            "strict auxiliary task route requires an explicit credential"
+        )
+    resolved_model = str(model or "").strip()
+    if not resolved_model:
+        resolved_model = (
+            str(main_runtime.get("model") or "").strip()
+            if provider_name == main_provider
+            else _get_aux_model_for_provider(provider_name)
+            or str(main_runtime.get("model") or "").strip()
+        )
+
+    candidate: Dict[str, Any] = {
+        "provider": provider_name,
+        "model": resolved_model,
+    }
+    for field, value in (
+        ("base_url", base_url),
+        ("api_key", api_key),
+        ("api_mode", api_mode),
+    ):
+        if field == "api_key" and callable(value) and not isinstance(value, str):
+            candidate[field] = value
+        elif isinstance(value, str) and value.strip():
+            candidate[field] = value.strip()
+
+    # An auto/inherited task is already the exact frozen main route.  A task
+    # naming the same provider without a transport override inherits that
+    # route as well (a model override remains allowed by policy).
+    if provider_name == main_provider:
+        if not task_base_url:
+            candidate.setdefault("base_url", main_runtime.get("base_url"))
+        if not api_key and (
+            not task_base_url or task_base_url == main_base_url
+        ):
+            candidate.setdefault("api_key", main_runtime.get("api_key"))
+        if not api_mode and (
+            not task_base_url or task_base_url == main_base_url
+        ):
+            candidate.setdefault("api_mode", main_runtime.get("api_mode"))
+
+    if not _auxiliary_runtime_is_concrete(candidate):
+        try:
+            from hermes_cli.runtime_provider import resolve_runtime_provider
+
+            resolved_runtime = resolve_runtime_provider(
+                requested=provider_name,
+                explicit_api_key=(
+                    api_key if isinstance(api_key, str) else None
+                ),
+                explicit_base_url=base_url,
+                target_model=resolved_model,
+            )
+        except Exception as exc:
+            raise RuntimeError(
+                "strict auxiliary task route could not be resolved"
+            ) from exc
+        candidate["provider"] = str(
+            resolved_runtime.get("provider") or provider_name
+        ).strip().lower()
+        for field in ("base_url", "api_key", "api_mode"):
+            explicit = candidate.get(field)
+            resolved = resolved_runtime.get(field)
+            if field == "api_key" and callable(explicit) and not isinstance(
+                explicit,
+                str,
+            ):
+                continue
+            if not explicit and resolved:
+                candidate[field] = resolved
+
+    if not _auxiliary_runtime_is_concrete(candidate):
+        raise RuntimeError("strict auxiliary task route is incomplete")
+
+    frozen = {
+        key: copy.deepcopy(task_config[key])
+        for key in _STRICT_FROZEN_TASK_KNOBS
+        if key in task_config
+    }
+    frozen.update(candidate)
+    return frozen
+
+
+def _freeze_auxiliary_main_runtime(
+    main_runtime: Optional[Dict[str, Any]],
+) -> Dict[str, Any]:
+    """Freeze one main runtime, resolving a MoA facade to its wire route now.
+
+    Background execution must never resolve a virtual MoA preset after the
+    caller's profile/config Context has gone away. The caller-side snapshot
+    therefore resolves both the acting aggregator slot and that slot's full
+    provider runtime before retaining any values.
+    """
+
+    source_runtime = main_runtime
+    if source_runtime is None:
+        source_runtime = _RUNTIME_MAIN_CONTEXT.get()
+    if source_runtime is not None:
+        # Normalize the exact source selected above.  Passing the original
+        # ``None`` here would make _normalize_main_runtime consult the mutable
+        # process-compatibility mirror a second time.
+        runtime = _normalize_main_runtime(source_runtime)
+    else:
+        from agent.identity_policy import identity_lock_required_by_host
+
+        # Generic hosts retain the legacy main-thread compatibility fallback.
+        # A strict host must fail closed when this call owns no immutable
+        # current-turn binding; the mirror may belong to another session.
+        runtime = (
+            {}
+            if identity_lock_required_by_host()
+            else _normalize_main_runtime(None)
+        )
+    if isinstance(source_runtime, dict):
+        session_id = source_runtime.get("session_id")
+        if isinstance(session_id, str) and session_id.strip():
+            runtime["session_id"] = session_id.strip()
+
+    provider = str(runtime.get("provider") or "").strip().lower()
+    preset_name = str(runtime.get("model") or "").strip()
+    if provider != "moa" or not preset_name:
+        return runtime
+
+    try:
+        acting_provider, acting_model = _resolve_moa_aggregator(preset_name)
+    except Exception:
+        logger.debug(
+            "MoA acting aggregator freeze failed for preset %r",
+            preset_name,
+            exc_info=True,
+        )
+        return runtime
+    if not acting_provider or not acting_model:
+        return runtime
+    try:
+        from agent.moa_loop import _slot_runtime
+
+        wire_runtime = _slot_runtime(
+            {"provider": acting_provider, "model": acting_model},
+            require_resolved=True,
+        )
+    except Exception:
+        logger.debug(
+            "MoA acting runtime freeze failed for preset %r",
+            preset_name,
+            exc_info=True,
+        )
+        return runtime
+    if not isinstance(wire_runtime, dict):
+        return runtime
+
+    frozen: Dict[str, Any] = {
+        "provider": str(wire_runtime.get("provider") or acting_provider)
+        .strip()
+        .lower(),
+        "model": str(wire_runtime.get("model") or acting_model).strip(),
+    }
+    for field in ("base_url", "api_key", "api_mode"):
+        value = wire_runtime.get(field)
+        if field == "api_key" and callable(value) and not isinstance(value, str):
+            frozen[field] = value
+        elif isinstance(value, str) and value.strip():
+            frozen[field] = value.strip()
+    if session_id := runtime.get("session_id"):
+        frozen["session_id"] = session_id
+    return frozen
+
+
+def capture_auxiliary_runtime_context(*, task: Optional[str] = None) -> object:
+    """Capture only the active main model's immutable auxiliary wire route.
+
+    The returned object intentionally has no public route attributes and cannot
+    be pickled.  In particular, this does *not* call ``copy_context()``: all
+    ambient authority/session state remains outside the snapshot.
+    """
+
+    # Read only the authoritative current-turn binding. In particular, do not
+    # let _normalize_main_runtime(None) consult the legacy main-thread mirrors:
+    # those are mutable process compatibility state, not an immutable route
+    # owned by the callback being scheduled.
+    raw_runtime = _RUNTIME_MAIN_CONTEXT.get()
+    runtime = (
+        _freeze_auxiliary_main_runtime(raw_runtime)
+        if raw_runtime is not None
+        else {}
+    )
