+async def arun_in_auxiliary_runtime_context(
+    snapshot: object,
+    callback: Callable[..., Any],
+    *args: Any,
+    **kwargs: Any,
+) -> Any:
+    """Async sibling of :func:`run_in_auxiliary_runtime_context`."""
+
+    if not callable(callback):
+        raise TypeError("callback must be callable")
+
+    async def invoke() -> Any:
+        with _scoped_auxiliary_runtime_context(snapshot):
+            return await callback(*args, **kwargs)
+
+    # Calling clean_context.run(invoke) would only create a coroutine object;
+    # its body would later execute in the awaiting task's ambient Context.
+    # Create the Task itself inside the clean Context so asyncio captures the
+    # intended isolation boundary for the coroutine's complete lifetime.
+    clean_context = contextvars.Context()
+    task = clean_context.run(asyncio.create_task, invoke())
+    return await task
+
