+def bind_host_required_auxiliary_messages(messages: Any) -> Any:
+    """Bind auxiliary messages to the host-pinned identity without mutation.
+
+    Generic Hermes deployments retain the caller's object unchanged.  A strict
+    host projects its already-attested SOUL/personality prefix into the one
+    leading authority row (or creates that row when the task supplied none).
+    Ambiguous authority layouts remain invalid instead of being repaired.
+    """
+
+    if not identity_lock_required_by_host():
+        return messages
+    if not isinstance(messages, list) or not messages:
+        return messages
+
+    receipt = preflight_aia_agent_identity()
+    prefix = (
+        receipt.soul_content.strip()
+        + "\n\n"
+        + receipt.personality_prompt.strip()
+    )
+    authority = [
+        (index, row)
+        for index, row in enumerate(messages)
+        if isinstance(row, Mapping)
+        and str(row.get("role") or "").strip().lower() in {"system", "developer"}
+    ]
+    if len(authority) > 1 or (authority and authority[0][0] != 0):
+        raise IdentityPolicyError(
+            "strict auxiliary request must have at most one leading system authority"
+        )
+
+    projected = list(messages)
+    if not authority:
+        projected.insert(0, {"role": "system", "content": prefix})
+        return projected
+
+    _, row = authority[0]
+    existing = _provider_authority_text(row.get("content"))
+    if existing is None:
+        raise IdentityPolicyError(
+            "strict auxiliary request system authority could not be represented as text"
+        )
+    replacement = dict(row)
+    # Native adapters use one canonical system carrier.  A caller may use a
+    # leading OpenAI ``developer`` role as its authority input, but allowing
+    # that role to survive would make Responses adapters leave it in input[]
+    # and fall back to their generic helper instructions.  Normalize only the
+    # strict copy; generic hosts retain the exact caller object above.
+    replacement["role"] = "system"
+    if existing == prefix or existing.startswith(prefix + "\n\n"):
+        replacement["content"] = existing
+    else:
+        replacement["content"] = prefix if not existing else prefix + "\n\n" + existing
+    projected[0] = replacement
+    return projected
+
