+    approval_token = approval.set_current_session_key("approval-sentinel")
+    gateway_token = session_context._SESSION_KEY.set("gateway-sentinel")
+    accounting_token = set_accounting_context(
+        accounting_owner,
+        "accounting-sentinel",
+    )
+    relay_call = {"request_id": "relay-call-sentinel"}
+    relay_call_token = aux._RELAY_AUX_CALL_CONTEXT.set(relay_call)
+    relay_turn = object()
+    relay_turn_token = relay_runtime._CURRENT_TURN.set(relay_turn)
+    arbitrary_token = arbitrary.set("ambient-sentinel")
+    observed = {}
+
+    try:
+        with aux.scoped_runtime_main(
+            {
+                "provider": "provider-a",
+                "requested_provider": "must-not-cross",
+                "model": "model-a",
+                "base_url": "https://provider-a.example/v1",
+                "api_key": "route-secret",
+                "api_mode": "chat_completions",
+                "auth_mode": "must-not-cross",
+                "session_id": "must-not-cross",
+            }
+        ):
+            snapshot = llm.capture_runtime_context()
+
+        def callback():
+            observed["runtime"] = aux._normalize_main_runtime(None)
+            observed["secret_scope"] = current_secret_scope()
+            observed["approval"] = approval._approval_session_key.get()
+            observed["gateway"] = session_context._SESSION_KEY.get()
+            observed["accounting"] = get_accounting_context()
+            observed["relay_call"] = aux._RELAY_AUX_CALL_CONTEXT.get()
+            observed["relay_turn"] = relay_runtime._CURRENT_TURN.get()
+            observed["arbitrary"] = arbitrary.get()
+            return "callback-result"
+
+        def worker():
+            with aux.scoped_runtime_main(
+                {"provider": "worker-original", "model": "worker-model"}
+            ):
+                observed["result"] = llm.run_in_runtime_context(snapshot, callback)
+                observed["restored"] = aux._normalize_main_runtime(None)
+
+        thread = threading.Thread(target=worker)
+        thread.start()
+        thread.join(timeout=5)
+        assert not thread.is_alive()
+
+        assert observed["result"] == "callback-result"
+        assert observed["runtime"] == {
+            "provider": "provider-a",
+            "model": "model-a",
+            "base_url": "https://provider-a.example/v1",
+            "api_key": "route-secret",
+            "api_mode": "chat_completions",
+        }
+        assert observed["secret_scope"] is None
+        assert observed["approval"] == ""
+        assert observed["gateway"] is session_context._UNSET
+        assert observed["accounting"] is None
+        assert observed["relay_call"] is None
+        assert observed["relay_turn"] is None
+        assert observed["arbitrary"] == "absent"
+        assert observed["restored"] == {
+            "provider": "worker-original",
+            "model": "worker-model",
+        }
+
+        # Capturing/running the isolated callback never disturbs its caller.
+        assert current_secret_scope() == {
+            "PROFILE_TOKEN": "secret-scope-sentinel"
+        }
+        assert approval._approval_session_key.get() == "approval-sentinel"
+        assert session_context._SESSION_KEY.get() == "gateway-sentinel"
+        assert get_accounting_context() == (
+            accounting_owner,
+            "accounting-sentinel",
+        )
+        assert aux._RELAY_AUX_CALL_CONTEXT.get() is relay_call
+        assert relay_runtime._CURRENT_TURN.get() is relay_turn
+        assert arbitrary.get() == "ambient-sentinel"
+    finally:
+        arbitrary.reset(arbitrary_token)
+        relay_runtime._CURRENT_TURN.reset(relay_turn_token)
+        aux._RELAY_AUX_CALL_CONTEXT.reset(relay_call_token)
+        reset_accounting_context(accounting_token)
+        session_context._SESSION_KEY.reset(gateway_token)
+        approval.reset_current_session_key(approval_token)
+        reset_secret_scope(secret_token)
