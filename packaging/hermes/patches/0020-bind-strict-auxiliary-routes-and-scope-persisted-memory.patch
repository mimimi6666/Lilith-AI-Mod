+def _build_strict_exact_auxiliary_client(
+    *,
+    provider: str,
+    model: str,
+    base_url: str,
+    api_key: Any,
+    api_mode: str,
+    is_vision: bool = False,
+    default_headers: Optional[Dict[str, str]] = None,
+) -> Any:
+    """Build one client solely from the already-frozen wire route.
+
+    This deliberately does not call :func:`resolve_provider_client`: that
+    generic resolver is allowed to consult the active profile for OAuth/SDK
+    credentials and provider defaults.  A strict background task must instead
+    retain the exact origin account and endpoint or fail before it is queued.
+    """
+
+    provider_name = _normalize_aux_provider(provider)
+    model_name = str(model or "").strip()
+    raw_base_url = str(base_url or "").strip().rstrip("/")
+    mode = str(api_mode or "").strip().lower()
+    if not provider_name or provider_name in {"auto", "moa"}:
+        raise RuntimeError("strict auxiliary provider is not concrete")
+    if not model_name or not raw_base_url or not api_key:
+        raise RuntimeError("strict auxiliary client route is incomplete")
+
+    # External-process and native app-server transports need process handles
+    # that are not represented by provider/model/base/key/mode.  Do not guess
+    # or restart them under the clean worker's profile.
+    try:
+        from hermes_cli.auth import PROVIDER_REGISTRY
+
+        provider_config = PROVIDER_REGISTRY.get(provider_name)
+        if (
+            provider_config is not None
+            and provider_config.auth_type == "external_process"
+        ):
+            raise RuntimeError(
+                "strict auxiliary external-process route cannot be frozen"
+            )
+    except ImportError:
+        pass
+
+    if mode == "bedrock_converse":
+        # BedrockAuxiliaryClient resolves a boto client inside each request.
+        # The five-field frozen route cannot pin that credential chain.
+        raise RuntimeError(
+            "strict auxiliary Bedrock Converse route cannot be frozen"
+        )
+    if mode == "anthropic_messages":
+        if provider_name == "bedrock":
+            host = base_url_hostname(raw_base_url)
+            match = re.fullmatch(
+                r"bedrock-runtime\.([a-z0-9-]+)\.amazonaws\.com(?:\.cn)?",
+                host,
+            )
+            if match is None:
+                raise RuntimeError(
+                    "strict auxiliary Bedrock endpoint is not self-contained"
+                )
+            from agent.anthropic_adapter import build_anthropic_bedrock_client
+
+            real_client = build_anthropic_bedrock_client(match.group(1))
+            return AnthropicAuxiliaryClient(
+                real_client,
+                model_name,
+                api_key="aws-sdk",
+                base_url=raw_base_url,
+            )
+
+        from agent.anthropic_adapter import _is_oauth_token, build_anthropic_client
+
+        real_client = build_anthropic_client(api_key, raw_base_url)
+        is_oauth = bool(
+            provider_name == "anthropic"
+            and isinstance(api_key, str)
+            and _is_oauth_token(api_key)
+        )
+        return AnthropicAuxiliaryClient(
+            real_client,
+            model_name,
+            api_key,
+            raw_base_url,
+            is_oauth=is_oauth,
+        )
+
+    if mode not in {"chat_completions", "codex_responses"}:
+        raise RuntimeError(
+            f"strict auxiliary API mode {mode or '<empty>'!r} cannot be frozen"
+        )
+
+    if provider_name == "gemini" and mode == "chat_completions":
+        from agent.gemini_native_adapter import (
+            GeminiNativeClient,
+            is_native_gemini_base_url,
+        )
+
+        if is_native_gemini_base_url(raw_base_url):
+            return GeminiNativeClient(api_key=api_key, base_url=raw_base_url)
+
+    openai_base = _to_openai_base_url(raw_base_url)
+    clean_base, default_query = _extract_url_query_params(openai_base)
+    if default_headers is None:
+        headers = _strict_exact_openai_headers(
+            provider_name,
+            raw_base_url,
+            api_key,
+            is_vision=is_vision,
+        )
+        headers = _apply_user_default_headers(headers) or {}
+    else:
+        # The caller captured these under the origin profile. Never merge the
+        # clean worker's current model.default_headers here.
+        headers = dict(default_headers)
+    kwargs: Dict[str, Any] = {}
+    if default_query:
+        kwargs["default_query"] = default_query
+    if headers:
+        kwargs["default_headers"] = headers
+    real_client = _create_openai_client(
+        api_key=api_key,
+        base_url=clean_base,
+        **kwargs,
+    )
+    if mode == "codex_responses":
+        return CodexAuxiliaryClient(real_client, model_name)
+    return real_client
+
