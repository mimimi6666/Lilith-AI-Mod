+        content=[SimpleNamespace(type="output_text", text="ok")],
+    )
+
+    class _EventStream:
+        def __iter__(self):
+            return iter(
+                [
+                    SimpleNamespace(type="response.created"),
+                    SimpleNamespace(
+                        type="response.output_item.done",
+                        item=output_item,
+                    ),
+                    SimpleNamespace(
+                        type="response.completed",
+                        response=SimpleNamespace(
+                            status="completed",
+                            id="strict-response",
+                            usage=None,
+                        ),
+                    ),
+                ]
+            )
+
+        def close(self):
+            return None
+
+    create = MagicMock(return_value=_EventStream())
+    client = SimpleNamespace(
+        base_url="https://chatgpt.com/backend-api/codex",
+        responses=SimpleNamespace(create=create),
+    )
+
+    _CodexCompletionsAdapter(client, "gpt-5.5").create(
+        model="gpt-5.5",
+        messages=messages,
+    )
+
+    wire = create.call_args.kwargs
+    assert wire["instructions"] == expected
+    assert "You are a helpful assistant." not in wire["instructions"]
+    assert not any(
