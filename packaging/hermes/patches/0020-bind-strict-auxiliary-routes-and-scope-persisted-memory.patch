+def test_slot_runtime_cache_isolates_concurrent_profiles_endpoints_and_keys(
+    tmp_path,
+    monkeypatch,
+    caplog,
+):
+    barrier = threading.Barrier(2)
+    results = {}
+
+    def resolve_runtime_provider(*, requested, target_model):
+        scope = current_secret_scope() or {}
+        barrier.wait(timeout=5)
+        return {
+            "base_url": scope["ENDPOINT"],
+            "api_key": scope["API_KEY"],
+            "api_mode": scope["API_MODE"],
+        }
+
+    monkeypatch.setattr(
+        "hermes_cli.runtime_provider.resolve_runtime_provider",
+        resolve_runtime_provider,
+    )
+    caplog.set_level(logging.DEBUG, logger="agent.moa_loop")
+
+    def worker(label):
+        key = f"raw-profile-key-{label}"
+        endpoint = f"https://profile-{label}.example/v1"
+        home_token = set_hermes_home_override(tmp_path / f"profile-{label}")
+        secret_token = set_secret_scope(
+            {
+                "ENDPOINT": endpoint,
+                "API_KEY": key,
+                "API_MODE": f"mode-{label}",
+            }
+        )
+        runtime_token = aux._RUNTIME_MAIN_CONTEXT.set(
+            {"session_id": f"session-{label}"}
+        )
+        try:
+            results[label] = moa_loop._slot_runtime(
+                {"provider": "same-provider", "model": "same-model"}
+            )
+        finally:
+            aux._RUNTIME_MAIN_CONTEXT.reset(runtime_token)
+            reset_secret_scope(secret_token)
+            reset_hermes_home_override(home_token)
+
+    threads = [threading.Thread(target=worker, args=(label,)) for label in ("a", "b")]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=5)
+        assert not thread.is_alive()
+
+    assert results["a"]["base_url"] == "https://profile-a.example/v1"
+    assert results["a"]["api_key"] == "raw-profile-key-a"
+    assert results["a"]["api_mode"] == "mode-a"
+    assert results["b"]["base_url"] == "https://profile-b.example/v1"
+    assert results["b"]["api_key"] == "raw-profile-key-b"
+    assert results["b"]["api_mode"] == "mode-b"
+    assert len(moa_loop._runtime_cache) == 2
+
+    key_repr = repr(tuple(moa_loop._runtime_cache.keys()))
+    assert "raw-profile-key-a" not in key_repr
+    assert "raw-profile-key-b" not in key_repr
+    assert "raw-profile-key-a" not in caplog.text
+    assert "raw-profile-key-b" not in caplog.text
