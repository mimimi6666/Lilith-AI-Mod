+def _safe_auxiliary_base_url_for_log(value: Any) -> str:
+    """Return only a URL's safe scheme + host(+port) for info logs.
+
+    Paths and query strings can carry API keys, while userinfo can contain a
+    literal username/password. Invalid or control-character-bearing locations
+    are omitted rather than logged approximately.
+    """
+
+    raw = str(value or "").strip()
+    if not raw:
+        return ""
+    try:
+        parsed = urlparse(raw)
+        scheme = str(parsed.scheme or "").lower()
+        host = str(parsed.hostname or "").lower().rstrip(".")
+        if not re.fullmatch(r"[a-z][a-z0-9+.-]*", scheme):
+            return ""
+        if not host or not re.fullmatch(r"[a-z0-9._:-]+", host):
+            return ""
+        location = f"[{host}]" if ":" in host else host
+        try:
+            port = parsed.port
+        except ValueError:
+            port = None
+        if port is not None:
+            location = f"{location}:{port}"
+        return f"{scheme}://{location}"
+    except Exception:
+        return ""
+
+
+def _frozen_auxiliary_route_signature(
+    *,
+    provider: Any,
+    model: Any,
+    base_url: Any,
+    api_key: Any,
+    api_mode: Any,
+) -> tuple[Any, ...]:
+    """Return a comparable route identity without retaining URL/key plaintext."""
+
+    raw_base_url = str(base_url or "").strip().rstrip("/")
+    base_digest = hashlib.blake2b(
+        raw_base_url.encode("utf-8"),
+        digest_size=16,
+    ).digest()
+    return (
+        str(provider or "").strip().lower(),
+        str(model or "").strip(),
+        ("base-url-digest", base_digest),
+        _runtime_cache_discriminator("api_key", api_key),
+        str(api_mode or "").strip().lower(),
+    )
+
