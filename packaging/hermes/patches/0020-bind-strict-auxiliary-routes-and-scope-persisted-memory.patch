+def run_in_auxiliary_runtime_context(
+    snapshot: object,
+    callback: Callable[..., Any],
+    *args: Any,
+    **kwargs: Any,
+) -> Any:
+    """Execute a synchronous callback with only *snapshot*'s route bound."""
+
+    if not callable(callback):
+        raise TypeError("callback must be callable")
+
+    def invoke() -> Any:
+        with _scoped_auxiliary_runtime_context(snapshot):
+            return callback(*args, **kwargs)
+
+    # A fresh Context is essential even when the caller happens to use this
+    # seam on the same thread. Merely setting _RUNTIME_MAIN_CONTEXT in the
+    # caller's existing Context would leave every approval/secret/gateway/turn
+    # binding visible to the callback.
+    return contextvars.Context().run(invoke)
+
