@@ -0,0 +1,167 @@
+"""Hard AIAgent teardown owns MemoryManager shutdown exactly once."""
+
+from __future__ import annotations
+
+import threading
+from unittest.mock import MagicMock
+
+from agent.memory_manager import MemoryManager
+from agent.memory_provider import MemoryProvider
+from run_agent import AIAgent
+from tui_gateway import server
+
+
+class _WorkerOwningProvider(MemoryProvider):
+    """Concrete provider stand-in for reviewers with a background daemon."""
+
+    def __init__(self):
+        self.stop = threading.Event()
+        self.worker = threading.Thread(
+            target=self.stop.wait,
+            name="memory-provider-lifecycle-test",
+            daemon=True,
+        )
+        self.shutdown_calls = 0
+
+    @property
+    def name(self):
+        return "worker-owning-provider"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        self.worker.start()
+
+    def get_tool_schemas(self):
+        return []
+
+    def shutdown(self):
+        self.shutdown_calls += 1
+        self.stop.set()
+        self.worker.join(timeout=2)
+
+
+def _bare_agent(memory_manager):
+    agent = AIAgent.__new__(AIAgent)
+    agent.session_id = "memory-lifecycle-test"
+    agent._owns_session_tool_resources = False
+    agent._active_children = []
+    agent._active_children_lock = threading.Lock()
+    agent._memory_manager = memory_manager
+    agent._memory_manager_shutdown_lock = threading.Lock()
+    agent._session_messages = []
+    agent.client = None
+    agent.context_compressor = None
+    return agent
+
+
+def test_direct_close_detaches_and_shuts_down_active_manager_once():
+    manager = MagicMock()
+    agent = _bare_agent(manager)
+
+    agent.close()
+    agent.close()
+
+    assert agent._memory_manager is None
+    manager.shutdown_all.assert_called_once_with()
+    manager.on_session_end.assert_not_called()
+
+
+def test_explicit_memory_shutdown_then_close_does_not_double_stop_provider():
+    manager = MagicMock()
+    agent = _bare_agent(manager)
+    messages = [{"role": "user", "content": "goodbye"}]
+
+    agent.shutdown_memory_provider(messages)
+    agent.close()
+
+    manager.on_session_end.assert_called_once_with(messages)
+    manager.shutdown_all.assert_called_once_with()
+    assert agent._memory_manager is None
+
+
+def test_session_teardown_reaches_the_active_manager_owner(monkeypatch):
+    manager = MagicMock()
+    agent = _bare_agent(manager)
+    session = {"agent": agent, "history": [], "_sid": "ui-session"}
+    monkeypatch.setattr(server, "_finalize_session", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server,
+        "_announce_session_reclaimed",
+        lambda *_args, **_kwargs: None,
+    )
+
+    server._teardown_session(session, end_reason="tui_close")
+
+    manager.shutdown_all.assert_called_once_with()
+    assert agent._memory_manager is None
+
+
+def test_session_teardown_stops_a_real_provider_owned_worker(monkeypatch):
+    manager = MemoryManager()
+    provider = _WorkerOwningProvider()
+    manager.add_provider(provider)
+    provider.initialize("ui-session")
+    agent = _bare_agent(manager)
+    session = {"agent": agent, "history": [], "_sid": "ui-session"}
+    monkeypatch.setattr(server, "_finalize_session", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server,
+        "_announce_session_reclaimed",
+        lambda *_args, **_kwargs: None,
+    )
+
+    try:
+        server._teardown_session(session, end_reason="tui_close")
+    finally:
+        provider.stop.set()
+        provider.worker.join(timeout=2)
+
+    assert provider.shutdown_calls == 1
+    assert not provider.worker.is_alive()
+    assert agent._memory_manager is None
+
+
+def test_concurrent_close_threads_cannot_double_shutdown_manager():
+    started = threading.Event()
+    release = threading.Event()
+    calls = []
+
+    class BlockingManager:
+        def shutdown_all(self):
+            calls.append(threading.get_ident())
+            started.set()
+            assert release.wait(timeout=5)
+
+    agent = _bare_agent(BlockingManager())
+    first = threading.Thread(target=agent.close)
+    second = threading.Thread(target=agent.close)
+
+    first.start()
+    assert started.wait(timeout=5)
+    second.start()
+    release.set()
+    first.join(timeout=5)
+    second.join(timeout=5)
+
+    assert not first.is_alive()
+    assert not second.is_alive()
+    assert len(calls) == 1
+    assert agent._memory_manager is None
+
+
+def test_soft_commit_and_client_release_keep_manager_active():
+    manager = MagicMock()
+    agent = _bare_agent(manager)
+    messages = [{"role": "user", "content": "rotate, do not terminate"}]
+
+    agent.commit_memory_session(messages)
+    agent.release_clients()
+
+    assert agent._memory_manager is manager
+    manager.on_session_end.assert_called_once_with(messages)
+    manager.shutdown_all.assert_not_called()
+
+    agent.close()
+    manager.shutdown_all.assert_called_once_with()
