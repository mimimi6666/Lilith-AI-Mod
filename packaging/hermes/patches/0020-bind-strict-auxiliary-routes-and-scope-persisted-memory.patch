+def test_concurrent_strict_task_snapshots_do_not_bleed_origin_profiles():
+    task = "plugin_concurrent_origin_test"
+    active_profile = contextvars.ContextVar(
+        "concurrent-task-origin-profile",
+        default="hostile-default",
+    )
+    configs = {
+        label: {
+            "auxiliary": {
+                task: {
+                    "provider": "custom",
+                    "model": f"task-model-{label}",
+                    "base_url": f"https://task-{label}.example/v1",
+                    "api_key": f"task-secret-{label}",
+                    "api_mode": "chat_completions",
+                }
+            }
+        }
+        for label in ("a", "b", "hostile-default")
+    }
+    config_reads = []
+    config_reads_lock = threading.Lock()
+
+    def load_config_readonly():
+        label = active_profile.get()
+        with config_reads_lock:
+            config_reads.append(label)
+        return configs[label]
+
+    snapshots = {}
+    with patch(
+        "agent.identity_policy.identity_lock_required_by_host",
+        return_value=True,
+    ), patch(
+        "hermes_cli.config.load_config_readonly",
+        side_effect=load_config_readonly,
+    ):
+        for label in ("a", "b"):
+            profile_token = active_profile.set(label)
+            try:
+                with aux.scoped_runtime_main(
+                    _concrete_route(f"main-{label}", f"main-model-{label}")
+                ):
+                    snapshots[label] = _llm().capture_runtime_context(task=task)
+            finally:
+                active_profile.reset(profile_token)
+
+    barrier = threading.Barrier(2)
+    observed = {}
+
+    def worker(label):
+        def callback():
+            barrier.wait(timeout=5)
+            observed[label] = aux._resolve_task_provider_model(task=task)
+
+        _llm().run_in_runtime_context(snapshots[label], callback)
+
+    with patch(
+        "hermes_cli.config.load_config_readonly",
+        side_effect=load_config_readonly,
+    ):
+        threads = [
+            threading.Thread(target=worker, args=(label,))
+            for label in ("a", "b")
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=5)
+            assert not thread.is_alive()
+
+    assert observed["a"] == (
+        "custom",
+        "task-model-a",
+        "https://task-a.example/v1",
+        "task-secret-a",
+        "chat_completions",
+    )
+    assert observed["b"] == (
+        "custom",
+        "task-model-b",
+        "https://task-b.example/v1",
+        "task-secret-b",
+        "chat_completions",
+    )
+    assert config_reads.count("a") >= 1
+    assert config_reads.count("b") >= 1
+    assert "hostile-default" not in config_reads
+
