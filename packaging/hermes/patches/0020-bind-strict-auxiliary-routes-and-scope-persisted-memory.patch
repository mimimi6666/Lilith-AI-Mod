+def _capture_frozen_auxiliary_task_client(
+    task: str,
+    task_config: Dict[str, Any],
+    *,
+    session_id: str = "",
+) -> _FrozenAuxiliaryTaskClient:
+    """Origin-materialize and cache one strict task client capability."""
+
+    provider = str(task_config.get("provider") or "")
+    model = str(task_config.get("model") or "")
+    base_url = str(task_config.get("base_url") or "")
+    api_key = task_config.get("api_key")
+    api_mode = str(task_config.get("api_mode") or "")
+    route = _frozen_auxiliary_route_signature(
+        provider=provider,
+        model=model,
+        base_url=base_url,
+        api_key=api_key,
+        api_mode=api_mode,
+    )
+    frozen_headers: Dict[str, str] = {}
+    if api_mode.strip().lower() in {"chat_completions", "codex_responses"}:
+        frozen_headers = _strict_exact_openai_headers(
+            _normalize_aux_provider(provider),
+            base_url,
+            api_key,
+            is_vision=task == "vision",
+        )
+        frozen_headers = _apply_user_default_headers(frozen_headers) or {}
+    headers_payload = json.dumps(
+        sorted((str(key), str(value)) for key, value in frozen_headers.items()),
+        ensure_ascii=False,
+        separators=(",", ":"),
+    )
+    headers_digest = hashlib.blake2b(
+        headers_payload.encode("utf-8"),
+        digest_size=16,
+    ).digest()
+    # Session scope prevents credential-chain clients (notably AWS SDK) from
+    # crossing chats.  When no scope exists, make this capture unique rather
+    # than allowing two profiles with the same placeholder key to collide.
+    scope = session_id or ("capture", uuid.uuid4().hex)
+    cache_key = (
+        "strict-frozen-task-client",
+        task,
+        scope,
+        ("headers-digest", headers_digest),
+        *route,
+    )
+    with _client_cache_lock:
+        cached = _client_cache.get(cache_key)
+        if cached is not None:
+            capability = cached[0]
+            if isinstance(capability, _FrozenAuxiliaryTaskClient):
+                return capability
+
+    client = _build_strict_exact_auxiliary_client(
+        provider=provider,
+        model=model,
+        base_url=base_url,
+        api_key=api_key,
+        api_mode=api_mode,
+        is_vision=task == "vision",
+        default_headers=frozen_headers,
+    )
+    capability = _FrozenAuxiliaryTaskClient(
+        _AUXILIARY_RUNTIME_CONTEXT_CONSTRUCTOR,
+        task=task,
+        route=route,
+        client=client,
+    )
+    with _client_cache_lock:
+        existing = _client_cache.get(cache_key)
+        if existing is not None and isinstance(
+            existing[0],
+            _FrozenAuxiliaryTaskClient,
+        ):
+            _close_cached_client(capability)
+            return existing[0]
+        while len(_client_cache) >= _CLIENT_CACHE_MAX_SIZE:
+            evict_key = next(iter(_client_cache))
+            del _client_cache[evict_key]
+        _client_cache[cache_key] = (capability, task_config.get("model"), None)
+    return capability
+
