+def _read_host_image_bytes(path: Path) -> bytes:
+    # Enforce the existing ingest cap while reading, not only afterwards in
+    # _finalize. stat() alone is insufficient when a local file grows between
+    # inspection and read. Confinement/credential checks remain above.
+    with path.open("rb") as source:
+        data = source.read(_MAX_INGEST_BYTES + 1)
+    if len(data) > _MAX_INGEST_BYTES:
+        raise SourceTooLarge("local image exceeds size limit", origin="file")
+    return data
