@@ -0,0 +1,298 @@
+"""Official Google Gemini image generation; no FAL route or credential copy.
+
+The documented stateless generateContent REST endpoint is used deliberately:
+no remote Interaction session, SDK installation, model fallback or retry.
+Official catalog/API reference checked 2026-09-26:
+https://ai.google.dev/gemini-api/docs/generate-content/image-generation
+https://ai.google.dev/gemini-api/docs/image-generation
+"""
+from __future__ import annotations
+
+import asyncio
+import base64
+import io
+import json
+import time
+import warnings
+from typing import Any
+
+from agent.image_gen_provider import (
+    DEFAULT_ASPECT_RATIO, ImageGenProvider, error_response,
+    resolve_aspect_ratio, save_b64_image, success_response,
+)
+
+DEFAULT_MODEL = "gemini-3.1-flash-image"
+_MODELS = {
+    DEFAULT_MODEL: ("Nano Banana 2 — Gemini 3.1 Flash Image", 14),
+    "gemini-3.1-flash-lite-image": ("Nano Banana 2 Lite — Gemini 3.1 Flash Lite Image", 1),
+    "gemini-3-pro-image": ("Nano Banana Pro — Gemini 3 Pro Image", 14),
+    "gemini-2.5-flash-image": ("Nano Banana — Gemini 2.5 Flash Image (legacy)", 3),
+}
+_ENDPOINT = "https://generativelanguage.googleapis.com/v1/models/"
+_ASPECTS = {"landscape": "16:9", "square": "1:1", "portrait": "9:16"}
+_MIME = {"image/png": ("PNG", "png"), "image/jpeg": ("JPEG", "jpg"),
+         "image/webp": ("WEBP", "webp")}
+_MAX_INPUT = 12 * 1024 * 1024  # Leaves room in the official 20 MB inline request cap.
+_MAX_RESPONSE = 40 * 1024 * 1024
+_MAX_IMAGE = 25 * 1024 * 1024
+_MAX_PROMPT = 32000
+
+
+def _key() -> str:
+    """Read the existing Gemini owner, including tombstones and profile scope.
+
+    Do not use generic tool-helper fallback to custom:gemini, config.api_key,
+    FAL_KEY or another provider. A broken authority read means unconfigured.
+    """
+    try:
+        from agent.secret_scope import get_secret, is_multiplex_active
+        from hermes_cli.auth import (
+            PROVIDER_REGISTRY, has_usable_secret, is_source_suppressed,
+            resolve_api_key_provider_credentials,
+        )
+        if is_multiplex_active():
+            # With no scope, get_secret raises; never borrow process-global
+            # .env or a pool belonging to another profile.
+            for name in PROVIDER_REGISTRY["gemini"].api_key_env_vars:
+                if is_source_suppressed("gemini", "env:" + name):
+                    continue
+                value = get_secret(name, "")
+                if isinstance(value, str) and has_usable_secret(value):
+                    return value.strip()
+            return ""
+        credentials = resolve_api_key_provider_credentials("gemini")
+        value = credentials.get("api_key", "")
+        return value.strip() if isinstance(value, str) and has_usable_secret(value) else ""
+    except Exception:
+        return ""
+
+
+def _model(explicit=None) -> str:
+    if explicit is None:
+        from hermes_cli.config import load_config
+        config = load_config()
+        section = config.get("image_gen", {})
+        if not isinstance(section, dict):
+            raise ValueError("invalid image configuration")
+        explicit = section.get("model") or DEFAULT_MODEL
+    if not isinstance(explicit, str) or explicit not in _MODELS:
+        raise ValueError("model not in Google image catalog")
+    return explicit
+
+
+def _validate_image(data: bytes, mime: str) -> str:
+    """Only bounded, decodable still images can become a success receipt."""
+    from PIL import Image
+    if mime not in _MIME or not data or len(data) > _MAX_IMAGE:
+        raise ValueError("invalid image")
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", Image.DecompressionBombWarning)
+        with Image.open(io.BytesIO(data)) as picture:
+            if (picture.format != _MIME[mime][0] or
+                    picture.width * picture.height > 64 * 1024 * 1024 or
+                    picture.width < 1 or picture.height < 1 or
+                    getattr(picture, "is_animated", False)):
+                raise ValueError("invalid image format or dimensions")
+            picture.verify()
+        # verify() checks container structure but may accept a truncated JPEG
+        # scan. Decode after reopening so success means usable image pixels,
+        # still under the same format/dimension budget checked above.
+        with Image.open(io.BytesIO(data)) as picture:
+            picture.load()
+    return _MIME[mime][1]
+
+
+def _references(image_url, reference_image_urls, limit: int) -> list[dict]:
+    """Reuse native URL/website policy, sandbox confinement and secret guard."""
+    from tools.image_source import ResolveContext, resolve_image_source
+    if image_url is not None and (not isinstance(image_url, str) or not image_url.strip()):
+        raise ValueError("invalid reference")
+    if reference_image_urls is not None and not isinstance(reference_image_urls, (list, tuple)):
+        raise ValueError("invalid references")
+    refs = ([image_url] if image_url else []) + list(reference_image_urls or [])
+    if len(refs) > limit or any(not isinstance(ref, str) or not ref.strip() for ref in refs):
+        raise ValueError("invalid reference count")
+    result, total = [], 0
+    for ref in refs:
+        # Base64 preflight avoids allocating a giant caller-supplied payload.
+        if ref.startswith("data:") and len(ref) > (_MAX_INPUT * 4 // 3 + 128):
+            raise ValueError("reference too large")
+        from tools.interrupt import is_interrupted
+        if is_interrupted():
+            raise InterruptedError()
+        resolved = asyncio.run(resolve_image_source(ref, ResolveContext()))
+        total += len(resolved.data)
+        if total > _MAX_INPUT:
+            raise ValueError("reference budget exceeded")
+        _validate_image(resolved.data, resolved.mime)
+        result.append({"inlineData": {"mimeType": resolved.mime,
+                                     "data": base64.b64encode(resolved.data).decode("ascii")}})
+    return result
+
+
+def _read_response(response, deadline: float) -> dict:
+    raw = bytearray()
+    for chunk in response.iter_content(chunk_size=65536):
+        if time.monotonic() > deadline:
+            raise TimeoutError()
+        if chunk:
+            raw.extend(chunk)
+            if len(raw) > _MAX_RESPONSE:
+                raise ValueError("response too large")
+    value = json.loads(raw)
+    if not isinstance(value, dict):
+        raise ValueError("invalid response")
+    return value
+
+
+def _output(response: dict) -> tuple[str, str]:
+    if response.get("promptFeedback", {}).get("blockReason"):
+        raise PermissionError()
+    candidates = response.get("candidates")
+    if not isinstance(candidates, list) or len(candidates) != 1:
+        raise ValueError("missing candidate")
+    candidate = candidates[0]
+    if not isinstance(candidate, dict):
+        raise ValueError("invalid candidate")
+    if candidate.get("finishReason") in {"SAFETY", "BLOCKLIST", "PROHIBITED_CONTENT", "IMAGE_SAFETY", "RECITATION"}:
+        raise PermissionError()
+    if candidate.get("finishReason") != "STOP":
+        raise ValueError("generation did not finish")
+    parts = candidate.get("content", {}).get("parts")
+    if not isinstance(parts, list) or len(parts) > 128:
+        raise ValueError("missing image parts")
+    images = [part.get("inlineData") for part in parts
+              if isinstance(part, dict) and part.get("thought") is not True and "inlineData" in part]
+    # Never silently discard extra generated images; this interface returns one.
+    if len(images) != 1 or not isinstance(images[0], dict):
+        raise ValueError("expected one final image")
+    data, mime = images[0].get("data"), images[0].get("mimeType")
+    if not isinstance(data, str) or len(data) > (_MAX_IMAGE * 4 // 3 + 8):
+        raise ValueError("invalid image data")
+    decoded = base64.b64decode(data, validate=True)
+    extension = _validate_image(decoded, mime)
+    return data, extension
+
+
+class GoogleImageGenProvider(ImageGenProvider):
+    @property
+    def name(self):
+        return "google"
+
+    @property
+    def display_name(self):
+        return "Google AI Studio"
+
+    def is_available(self):
+        return self.get_readiness_status() == "ready"
+
+    def get_readiness_status(self):
+        # Structural readiness only: never a network probe or billing claim.
+        if not _key():
+            return "needs_keys"
+        try:
+            import requests  # noqa: F401
+            from PIL import Image  # noqa: F401
+            return "ready"
+        except ImportError:
+            return "needs_setup"
+
+    def get_setup_schema(self):
+        return {"name": self.display_name, "badge": "paid",
+                "tag": "Official Google API; uses the Google AI Studio key from model settings. No FAL account needed.",
+                "env_vars": [{"key": "GOOGLE_API_KEY", "prompt": "Google AI Studio API key (model settings)",
+                              "url": "https://aistudio.google.com/apikey"}]}
+
+    def list_models(self):
+        return [{"id": name, "display": meta[0]} for name, meta in _MODELS.items()]
+
+    def default_model(self):
+        return DEFAULT_MODEL
+
+    def capabilities(self):
+        try:
+            limit = _MODELS[_model()][1]
+        except Exception:
+            limit = 0
+        return {"modalities": ["text", "image"] if limit else ["text"], "max_reference_images": limit}
+
+    def generate(self, prompt, aspect_ratio=DEFAULT_ASPECT_RATIO, *, image_url=None,
+                 reference_image_urls=None, **kwargs: Any):
+        aspect, model = resolve_aspect_ratio(aspect_ratio), ""
+
+        def fail(kind, message, *, dispatched=False):
+            # No raw exceptions, response bodies, keys, URLs or input image data.
+            return {**error_response(error=message, error_type=kind, provider=self.name,
+                                     model=model, aspect_ratio=aspect),
+                    "retryable": False, "effect_disposition": "unknown" if dispatched else "none"}
+
+        try:
+            valid_prompt = isinstance(prompt, str) and prompt.strip() and len(prompt.encode("utf-8")) <= _MAX_PROMPT
+        except UnicodeError:
+            valid_prompt = False
+        if not valid_prompt:
+            return fail("invalid_argument", "A non-empty bounded image prompt is required.")
+        try:
+            model = _model(kwargs.get("model"))
+        except Exception:
+            return fail("invalid_model", "Select a model from the Google image-generation catalog.")
+        key = _key()
+        if not key:
+            return fail("auth_required", "Configure Google AI Studio in the existing model API-key settings. No FAL key is used.")
+        try:
+            import requests
+            parts = [{"text": prompt.strip()}] + _references(image_url, reference_image_urls, _MODELS[model][1])
+        except ImportError:
+            return fail("missing_dependency", "The packaged image HTTP or image-validation component is unavailable.")
+        except InterruptedError:
+            return fail("cancelled", "Cancelled before Google submission; no generation was started.")
+        except Exception:
+            return fail("invalid_reference", "A reference image is unavailable, blocked, invalid or exceeds the image limit.")
+        from tools.interrupt import is_interrupted
+        if is_interrupted():
+            return fail("cancelled", "Cancelled before Google submission; no generation was started.")
+        # Re-resolve after reference loading: deletion/rotation must take effect
+        # before submission, without retaining a key in a provider instance.
+        key = _key()
+        if not key:
+            return fail("auth_required", "The Google AI Studio credential is no longer available.")
+        image_config = {"aspectRatio": _ASPECTS[aspect]}
+        if model != "gemini-2.5-flash-image":
+            image_config["imageSize"] = "1K"
+        payload = {"contents": [{"role": "user", "parts": parts}],
+                   "generationConfig": {"candidateCount": 1, "responseModalities": ["TEXT", "IMAGE"],
+                                        "responseFormat": {"image": image_config}}}
+        deadline = time.monotonic() + 120
+        try:
+            # Fixed official host + no redirects: config/env cannot redirect a
+            # Google key. requests does not retry POST by default.
+            with requests.post(_ENDPOINT + model + ":generateContent", json=payload,
+                               headers={"x-goog-api-key": key, "Content-Type": "application/json"},
+                               timeout=(10, 120), stream=True, allow_redirects=False) as response:
+                if response.status_code != 200:
+                    kind = {401: "auth_failed", 403: "access_denied", 404: "model_unavailable",
+                            429: "quota_or_rate_limit"}.get(response.status_code, "api_error")
+                    return fail(kind, "Google did not complete image generation. Check access, model availability and quota; no automatic retry was sent.", dispatched=True)
+                output = _read_response(response, deadline)
+        except (requests.Timeout, TimeoutError):
+            return fail("timeout", "The Google request timed out. Its remote outcome and charges are unknown; do not retry automatically.", dispatched=True)
+        except Exception:
+            return fail("transport_error", "The Google response could not be received or validated. Its remote outcome is unknown; no automatic retry was sent.", dispatched=True)
+        try:
+            encoded, extension = _output(output)
+        except PermissionError:
+            return fail("content_blocked", "Google declined this image request under its content policy.", dispatched=True)
+        except Exception:
+            return fail("invalid_response", "Google returned no valid completed image. Text or reasoning is not an image result.", dispatched=True)
+        if is_interrupted():
+            return fail("cancelled", "The local wait was cancelled after submission. Remote generation may be billable; no image was published.", dispatched=True)
+        try:
+            path = save_b64_image(encoded, prefix="google_image", extension=extension)
+        except Exception:
+            return fail("io_error", "Google generated an image but it could not be saved locally. Do not regenerate automatically.", dispatched=True)
+        return success_response(image=str(path), model=model, prompt=prompt.strip(), aspect_ratio=aspect,
+                                provider=self.name, modality="image" if len(parts) > 1 else "text")
+
+
+def register(ctx):
+    ctx.register_image_gen_provider(GoogleImageGenProvider())
