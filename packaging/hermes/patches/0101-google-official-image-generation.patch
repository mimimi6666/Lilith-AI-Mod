+"""Synthetic profiles and mocked HTTP only; never a paid Google/FAL request."""
+import base64
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+SOURCE = Path(os.environ["LILITH_TEST_SOURCE"])
+spec = importlib.util.spec_from_file_location("google_image_test_backend", SOURCE / "plugins/image_gen/google/__init__.py")
+google = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(google)
+REAL_MODEL = google._model
+KEY = "fixture-google-secret-0A9z"
+
+
+@pytest.fixture(autouse=True)
+def isolated(monkeypatch, tmp_path):
+    import requests
+    import hermes_constants
+    from agent import secret_scope
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_LILITH_BOUND_HOME", str(tmp_path))
+    monkeypatch.delenv("GOOGLE_API_KEY", raising=False)
+    monkeypatch.delenv("GEMINI_API_KEY", raising=False)
+    monkeypatch.delenv("FAL_KEY", raising=False)
+    monkeypatch.setattr(secret_scope, "_MULTIPLEX_ACTIVE", False)
+    token = secret_scope.set_secret_scope(None)
+    monkeypatch.setattr(requests, "post", lambda *a, **kw: pytest.fail("unmocked generation request"))
+    monkeypatch.setattr(requests, "get", lambda *a, **kw: pytest.fail("unmocked reference request"))
+    monkeypatch.setattr(google, "_model", lambda explicit=None: explicit or google.DEFAULT_MODEL)
+    from tools import interrupt
+    monkeypatch.setattr(interrupt, "is_interrupted", lambda: False)
+    yield
+    secret_scope.reset_secret_scope(token)
+
+
+def png():
+    from PIL import Image
+    output = io.BytesIO()
+    Image.new("RGB", (2, 3), "blue").save(output, format="PNG")
+    return output.getvalue()
+
+
+def good_response():
+    return {"candidates": [{"finishReason": "STOP", "content": {"parts": [
+        {"text": "untrusted answer not used as image"},
+        {"inlineData": {"mimeType": "image/png", "data": base64.b64encode(png()).decode()}}
+    ]}}]}
+
+
+def truncated_jpeg():
+    from PIL import Image
+    output = io.BytesIO()
+    Image.new("RGB", (64, 64), "blue").save(output, format="JPEG")
+    return output.getvalue()[:-50]
+
+
+class Response:
+    def __init__(self, value=None, status=200, chunks=None):
+        self.status_code, self.value, self.chunks = status, value, chunks
+        self.closed = False
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        self.closed = True
+
+    def iter_content(self, chunk_size):
+        yield from self.chunks if self.chunks is not None else [json.dumps(self.value).encode()]
+
+
+def mocked_call(monkeypatch, response=None, error=None):
+    import requests
+    monkeypatch.setattr(google, "_key", lambda: KEY)
+    calls = []
+    def post(*args, **kwargs):
+        calls.append((args, kwargs))
+        if error:
+            raise error
+        return response if response is not None else Response(good_response())
+    monkeypatch.setattr(requests, "post", post)
+    return calls
+
+
+def test_metadata_and_native_catalog(monkeypatch):
+    from agent import image_gen_registry
+    from hermes_cli import tools_config, plugins
+    from tui_gateway.native_media_setup import model_metadata, validate_model, apply_model
+    provider = google.GoogleImageGenProvider()
+    registered = []
+    google.register(SimpleNamespace(register_image_gen_provider=registered.append))
+    assert [p.name for p in registered] == ["google"]
+    monkeypatch.setattr(image_gen_registry, "list_providers", lambda: [provider])
+    monkeypatch.setattr(image_gen_registry, "get_provider", lambda name: provider if name == "google" else None)
+    monkeypatch.setattr(plugins, "_ensure_plugins_discovered", lambda **kw: None)
+    row, = tools_config._plugin_image_gen_providers()
+    assert row["image_gen_plugin_name"] == "google"
+    assert row["name"] == "Google AI Studio"
+    assert row["env_vars"][0]["key"] == "GOOGLE_API_KEY"
+    assert "FAL_KEY" not in json.dumps(row)
+    models, selected = model_metadata("image_gen", row, {})
+    assert models == list(google._MODELS)
+    assert selected == google.DEFAULT_MODEL
+    cfg = {"image_gen": {"provider": "google"}}
+    selection = {"toolset": "image_gen", "provider": row["name"], "model": "gemini-3-pro-image"}
+    validate_model(selection, row, cfg)
+    apply_model(selection, row, cfg)
+    assert cfg["image_gen"] == {"provider": "google", "model": "gemini-3-pro-image"}
+    with pytest.raises(ValueError):
+        validate_model({**selection, "model": "fal-ai/nano-banana-2"}, row, cfg)
+
+
+@pytest.mark.parametrize("alias", ["GOOGLE_API_KEY", "GEMINI_API_KEY"])
+def test_existing_native_credential_alias(monkeypatch, alias):
+    monkeypatch.setenv(alias, KEY)
+    assert google._key() == KEY
+
+
+def test_native_pool_not_fal_or_custom_provider(monkeypatch):
+    from hermes_cli import auth
+    from agent import credential_pool
+    seen = []
+    monkeypatch.setenv("FAL_KEY", "fixture-fal-unrelated")
+    def load(name):
+        seen.append(name)
+        return SimpleNamespace(has_credentials=lambda: True, peek=lambda: SimpleNamespace(access_token=KEY))
+    monkeypatch.setattr(credential_pool, "load_pool", load)
+    assert google._key() == KEY
+    assert seen == ["gemini"]
+
+
+def test_native_dotenv_rotation_preferred_to_stale_environment(monkeypatch, tmp_path):
+    monkeypatch.setenv("GOOGLE_API_KEY", "fixture-stale-launcher-key")
+    (tmp_path / ".env").write_text("GOOGLE_API_KEY=" + KEY + "\n", encoding="utf-8")
+    assert google._key() == KEY
+    (tmp_path / ".env").write_text("GOOGLE_API_KEY=fixture-new-rotation-key\n", encoding="utf-8")
+    assert google._key() == "fixture-new-rotation-key"
+
+
+def test_native_suppression_and_delete_do_not_revive_key(monkeypatch):
+    from hermes_cli import auth
+    from agent import credential_pool
+    monkeypatch.setenv("GOOGLE_API_KEY", KEY)
+    monkeypatch.setenv("GEMINI_API_KEY", KEY)
+    monkeypatch.setattr(auth, "is_source_suppressed", lambda provider, source: provider == "gemini")
+    monkeypatch.setattr(credential_pool, "load_pool", lambda name: None)
+    assert google._key() == ""
+    assert google.GoogleImageGenProvider().is_available() is False
+    assert google.GoogleImageGenProvider().generate("a tree")["error_type"] == "auth_required"
+
+
+def test_real_native_replace_remove_lifecycle_on_synthetic_profile(monkeypatch, tmp_path):
+    from hermes_cli import credential_lifecycle as lifecycle
+    from hermes_cli.config import invalidate_env_cache
+    (tmp_path / "config.yaml").write_text("model:\n  provider: gemini\n  default: gemini-fixture\n", encoding="utf-8")
+    invalidate_env_cache()
+    lifecycle.replace_provider_api_key("gemini", KEY, "google-fixture-replace-a")
+    assert google._key() == KEY
+    lifecycle.replace_provider_api_key("gemini", "fixture-rotated-google-key", "google-fixture-replace-b")
+    assert google._key() == "fixture-rotated-google-key"
+    lifecycle.remove_provider_api_key("gemini", "google-fixture-remove-c")
+    assert google._key() == ""
+    # A launcher cannot resurrect an explicitly removed alias.
+    monkeypatch.setenv("GOOGLE_API_KEY", KEY)
+    assert google._key() == ""
+
+
+def test_legacy_readiness_does_not_invoke_remote_backend(monkeypatch):
+    from agent import image_gen_registry
+    from hermes_cli import tools_config as tc
+    monkeypatch.setattr(image_gen_registry, "get_provider", lambda name: SimpleNamespace(
+        is_available=lambda: pytest.fail("legacy entitlement probe must not run")))
+    monkeypatch.setattr(tc, "get_env_value", lambda name: "")
+    assert tc.provider_readiness_status({"image_gen_plugin_name": "legacy", "env_vars": [{"key": "FAKE_KEY"}]}, {}) == "needs_keys"
+
