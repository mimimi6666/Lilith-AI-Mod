+    def active_processes(self):
+        if not self._handle:
+            return None
+        accounting = _Accounting()
+        if not self._api.QueryInformationJobObject(self._handle, 1, ctypes.byref(accounting), ctypes.sizeof(accounting), None):
+            return None
+        return accounting.ActiveProcesses
+
+    def terminate_and_wait(self, timeout=2.0):
+        if not self._handle:
+            return False
+        if not self._api.TerminateJobObject(self._handle, 130):
+            return self.active_processes() == 0
+        return self.wait_empty(timeout)
+
+    def wait_empty(self, timeout=0.25):
+        # Accounting can briefly lag a signalled process handle. Give normal
+        # exit a bounded drain before diagnosing a surviving descendant.
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            if self.active_processes() == 0:
+                return True
+            time.sleep(0.02)
+        return self.active_processes() == 0
+
+    def close(self):
+        handle, self._handle = self._handle, None
+        if handle:
+            self._api.CloseHandle(handle)
+
+    def __del__(self):
+        if getattr(self, "_handle", None):
+            self.close()
