+                return result
+            data = json.loads(receipt.read_text(encoding="utf-8"))
+            if (data.get("schema") != 1 or not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", data.get("version", ""))
+                    or not re.fullmatch(r"[0-9a-f]{64}", data.get("sha256", ""))):
+                return result
+            sizes = data.get("files")
+            if not isinstance(sizes, dict) or set(sizes) != set(_CHROME_FILES):
+                return result
+            for name in _CHROME_FILES:
+                size = sizes[name]
+                if not isinstance(size, int) or size < 1 or _fingerprint(chrome.parent / name)[3] != size:
+                    return result
+            if _verified_cache.get("chrome") != chrome_key:
+                if _sha(chrome) != data["sha256"]:
+                    return result
+                _verified_cache["chrome"] = chrome_key
+            result["chrome"] = str(chrome)
+        except (OSError, ValueError, _SetupFailure):
+            pass
+        return result
+    except (OSError, ValueError, _SetupFailure):
+        return None
+
+
+def dependency_status(provider):
+    if not isinstance(provider, dict):
+        return "unknown"
+    hook = provider.get("post_setup")
+    if hook is not None and not isinstance(hook, str):
+        return "unknown"
+    if hook == "fal_client":
+        from tools.managed_python_dependencies import fal_dependency_status
+        return fal_dependency_status()
+    if isinstance(hook, str) and hook in _HOOKS:
+        managed = managed_browser_paths()
+        if managed and (hook == "browserbase" or "chrome" in managed):
+            return "ready"
+    # Preserve native external installations and all other provider predicates.
+    # This function is the outer wrapper; never call _dependency_status here.
+    from tui_gateway.native_setup import _legacy_dependency_status
+    return _legacy_dependency_status(provider)
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise _SetupFailure("download_redirect_rejected")
+
+
+def _download(url, destination, maximum, cancelled, deadline, digest=None):
+    allowed = url in {_TARBALL, _CFT_MANIFEST} or re.fullmatch(
+        r"https://storage\.googleapis\.com/chrome-for-testing-public/\d+\.\d+\.\d+\.\d+/win64/chrome-win64\.zip", url)
+    if not allowed:
+        raise _SetupFailure("download_source_rejected")
+    _check(cancelled, deadline)
+    _plain(destination.parent)
+    request = urllib.request.Request(url, headers={"User-Agent": "Lilith-managed-browser-dependencies/1"})
+    # No redirects, proxy credentials, ambient cookies or authentication handlers.
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
+    hasher = hashlib.sha512() if digest else None
+    with opener.open(request, timeout=min(10.0, max(0.1, deadline - time.monotonic()))) as response:
+        if response.status != 200 or response.geturl() != url:
+            raise _SetupFailure("download_source_rejected")
+        length = response.headers.get("Content-Length")
+        if length and (not length.isdigit() or int(length) > maximum):
+            raise _SetupFailure("download_too_large")
+        size = 0
+        with destination.open("xb") as output:
+            while True:
+                _check(cancelled, deadline)
+                chunk = response.read(128 * 1024)
+                if not chunk:
+                    break
+                size += len(chunk)
+                if size > maximum:
+                    raise _SetupFailure("download_too_large")
+                output.write(chunk)
+                if hasher:
+                    hasher.update(chunk)
+    if not size or (length and size != int(length)):
+        raise _SetupFailure("download_incomplete")
+    if hasher and hasher.hexdigest() != digest:
+        raise _SetupFailure("download_integrity_failed")
+
+
+def _extract_cli(archive, destination, cancelled, deadline):
+    _mkdir(destination)
+    expected = {"package/bin/agent-browser-win32-x64.exe": "agent-browser.exe", "package/LICENSE": "LICENSE"}
+    seen = set()
+    with tarfile.open(archive, "r:gz") as source:
+        for index, member in enumerate(source):
+            _check(cancelled, deadline)
+            if index > 4096:
+                raise _SetupFailure("archive_limits_exceeded")
+            if member.name not in expected:
+                continue
+            if member.name in seen or not member.isfile() or member.size > 128 * 1024 * 1024:
+                raise _SetupFailure("archive_entry_rejected")
+            seen.add(member.name)
+            target = destination / expected[member.name]
+            _plain(target, missing=True)
+            with source.extractfile(member) as stream, target.open("xb") as output:
+                shutil.copyfileobj(stream, output, 128 * 1024)
+    if seen != set(expected) or _sha(destination / "agent-browser.exe") != _CLI_SHA256:
+        raise _SetupFailure("download_integrity_failed")
+
+
+def _extract_chrome(archive, destination, cancelled, deadline):
+    _mkdir(destination)
+    total = 0
+    names = set()
+    with zipfile.ZipFile(archive) as source:
+        members = source.infolist()
+        if len(members) > 8192:
+            raise _SetupFailure("archive_limits_exceeded")
+        for member in members:
+            _check(cancelled, deadline)
+            name = member.filename
+            raw_parts = name.rstrip("/").split("/")
+            parts = PurePosixPath(name).parts
+            unix_mode = member.external_attr >> 16
+            if (not parts or parts[0] != "chrome-win64" or any(p in {"", ".", ".."} or ":" in p or p.endswith((".", " "))
+                    or any(ord(c) < 32 for c in p) or re.fullmatch(r"(?i)(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\..*)?", p) for p in raw_parts)
+                    or "\\" in name or name.startswith("/") or stat.S_ISLNK(unix_mode)
+                    or member.flag_bits & 1 or name.casefold() in names):
+                raise _SetupFailure("archive_entry_rejected")
+            names.add(name.casefold())
+            total += member.file_size
+            if total > 1024 * 1024 * 1024 or member.file_size > 512 * 1024 * 1024:
+                raise _SetupFailure("archive_limits_exceeded")
+            target = destination.joinpath(*parts)
+            _plain(target, missing=True)
+            if member.is_dir():
+                _mkdir(target)
+            else:
+                _mkdir(target.parent)
+                with source.open(member) as stream, target.open("xb") as output:
+                    while True:
+                        _check(cancelled, deadline)
+                        chunk = stream.read(128 * 1024)
+                        if not chunk:
+                            break
+                        output.write(chunk)
+    _fingerprint(destination / "chrome-win64" / "chrome.exe")
+
+
+def _probe(command, stage, cancelled, deadline, observer=None):
+    """Only exact freshly verified binaries; owned whole tree, no profile reuse."""
+    from tools.environments.windows_job import CREATE_SUSPENDED, ForegroundWindowsJob
+
+    env = {key: os.environ[key] for key in ("SystemRoot", "WINDIR", "COMSPEC") if key in os.environ}
+    env.update({"USERPROFILE": str(stage), "HOME": str(stage), "TEMP": str(stage), "TMP": str(stage),
+                "LOCALAPPDATA": str(stage / "local"), "APPDATA": str(stage / "roaming")})
+    output = stage / ("probe-" + uuid.uuid4().hex + ".txt")
+    job = ForegroundWindowsJob()
+    proc = None
+    try:
+        _check(cancelled, deadline)
+        with output.open("xb") as capture:
+            proc = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=capture, stderr=capture,
+                                    cwd=stage, env=env, creationflags=CREATE_SUSPENDED | subprocess.CREATE_NO_WINDOW)
+            job.attach_and_resume(proc)
+            while proc.poll() is None:
+                _check(cancelled, deadline)
+                if output.stat().st_size > 65536:
+                    raise _SetupFailure("probe_output_limit")
+                if observer is not None:
+                    observed = observer()
+                    if observed is not None:
+                        return observed
+                time.sleep(0.05)
+            if proc.returncode or not job.wait_empty(0.5):
+                raise _SetupFailure("dependency_probe_failed")
+        return output.read_text(encoding="utf-8", errors="replace")[:65536]
+    finally:
+        if proc is not None and not job.wait_empty(0.25):
+            if not job.terminate_and_wait(2):
+                job.close()
+                raise _SetupFailure("cleanup_unconfirmed")
+        if proc is not None:
+            proc.wait(timeout=2)
+        job.close()
+
+
+def _probe_chrome(chrome, stage, version, cancelled, deadline):
+    # Windows' GUI-subsystem chrome.exe ignores --version. Verify its actual
+    # loopback DevTools version in an isolated profile, then retire the entire
+    # owned process tree. No system profile, URL navigation or browser install.
+    profile = stage / "p"
+    port_file = profile / "DevToolsActivePort"
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
+
+    def observed():
+        try:
+            _fingerprint(port_file)
+            if port_file.stat().st_size > 256:
+                raise _SetupFailure("dependency_probe_failed")
+            port = port_file.read_text(encoding="ascii").splitlines()[0]
+            if not port.isdigit() or not 1 <= int(port) <= 65535:
+                raise _SetupFailure("dependency_probe_failed")
+            with opener.open("http://127.0.0.1:" + port + "/json/version", timeout=0.5) as response:
+                raw = response.read(16385)
+                if len(raw) > 16384:
+                    raise _SetupFailure("dependency_probe_failed")
+                data = json.loads(raw)
+                if data.get("Browser") not in {"Chrome/" + version, "HeadlessChrome/" + version}:
+                    raise _SetupFailure("dependency_probe_failed")
+                return version
+        except (FileNotFoundError, ConnectionError, TimeoutError, urllib.error.URLError):
+            return None
+        except _SetupFailure as exc:
+            if not port_file.exists():
+                return None
+            raise exc
+
+    return _probe([str(chrome), "--headless=new", "--no-first-run", "--no-default-browser-check",
+                   "--disable-background-networking", "--disable-component-update", "--disable-extensions",
+                   "--disable-sync", "--disable-gpu", "--remote-debugging-address=127.0.0.1",
+                   "--remote-debugging-port=0", "--user-data-dir=" + str(profile), "about:blank"],
+                  stage, cancelled, deadline, observed)
+
+
+def _remove_stage(stage, parent):
+    # This UUID directory was created exclusively by this invocation. Never
+    # recurse through junctions, or delete a destination/dependency/profile.
+    if stage.parent != parent or not re.fullmatch(r"\.browser-stage-[0-9a-f]{12}", stage.name):
+        return False
+    try:
+        _plain(stage)
+        for base, dirs, files in os.walk(stage, followlinks=False):
+            for name in dirs + files:
+                _plain(Path(base) / name)
+        shutil.rmtree(stage)
+        return True
+    except (OSError, _SetupFailure):
+        return False
+
+
+def _publish(source, destination):
+    _plain(source)
+    _plain(destination, missing=True)
+    if destination.exists():
+        raise _SetupFailure("existing_dependency_requires_review")
+    # On Windows rename does not replace an existing directory; a competing
+    # install is not overwritten. Both paths are on the same volume.
+    source.rename(destination)
+
+
+def can_install_provider_dependencies(provider):
+    """Whether this exact native hook has an automatic installer here.
+
+    Capability only, not selection, consent, readiness or authorization. The
+    setup card and dispatcher share this branch to avoid offering fake Install
+    actions for hooks that only have manual installation instructions.
+    """
+    hook = provider.get("post_setup") if isinstance(provider, dict) else None
+    if os.name != "nt" or not isinstance(hook, str):
+        return False
+    if hook == "fal_client":
+        return True
+    return hook in _HOOKS and platform.machine().lower() in {"amd64", "x86_64"}
+
+
+def install_provider_dependencies(provider, cancelled):
+    """Called only after native selection + human Install confirmation.
+
+    Returns closed/redacted codes, never local paths, exception text, URLs,
+    command output, credentials or claims about external API usability.
+    """
+    hook = provider.get("post_setup") if isinstance(provider, dict) else None
+    if not can_install_provider_dependencies(provider):
+        return {"status": "manual_setup_required", "verified": False}
+    if hook == "fal_client":
+        from tools.managed_python_dependencies import install_fal_dependencies
+        return install_fal_dependencies(cancelled)
+    if not callable(cancelled):
+        return {"status": "failed", "code": "cancellation_required", "verified": False}
+    if not _install_lock.acquire(blocking=False):
+        return {"status": "busy", "verified": False}
+    stage = root = None
+    result = {"status": "failed", "code": "dependency_setup_failed", "verified": False}
+    try:
+        deadline = time.monotonic() + 600
+        _check(cancelled, deadline)
+        root = _root()
+        if dependency_status(provider) == "ready":
+            return {"status": "already_ready", "verified": True}
+        _mkdir(root)
+        if shutil.disk_usage(root).free < 2 * 1024 * 1024 * 1024:
+            raise _SetupFailure("insufficient_disk_space")
+        stage = root / (".browser-stage-" + uuid.uuid4().hex[:12])
+        if len(str(stage / "p")) > 160:
+            raise _SetupFailure("dependency_path_too_long")
+        stage.mkdir(exist_ok=False)
+        _plain(stage)
+        paths = managed_browser_paths()
+        if not paths:
+            if (root / "cli").exists():
+                raise _SetupFailure("existing_dependency_requires_review")
+            tarball = stage / "agent-browser.tgz"
+            _download(_TARBALL, tarball, 64 * 1024 * 1024, cancelled, deadline, _TARBALL_SHA512)
+            _extract_cli(tarball, stage / "cli", cancelled, deadline)
+            text = _probe([str(stage / "cli" / "agent-browser.exe"), "--version"], stage, cancelled, min(deadline, time.monotonic() + 15))
+            if _VERSION not in text:
+                raise _SetupFailure("dependency_probe_failed")
+            _check(cancelled, deadline)
+            _publish(stage / "cli", root / "cli")
+        if hook == "agent_browser" and not (paths and paths.get("chrome")):
+            if (root / "chromium").exists():
+                raise _SetupFailure("existing_dependency_requires_review")
+            manifest = stage / "cft.json"
+            _download(_CFT_MANIFEST, manifest, 512 * 1024, cancelled, deadline)
+            stable = json.loads(manifest.read_text(encoding="utf-8"))["channels"]["Stable"]
+            version = stable["version"]
+            if not isinstance(version, str) or not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", version):
+                raise _SetupFailure("download_source_rejected")
+            url = "https://storage.googleapis.com/chrome-for-testing-public/" + version + "/win64/chrome-win64.zip"
+            if sum(row.get("platform") == "win64" and row.get("url") == url for row in stable["downloads"]["chrome"]) != 1:
+                raise _SetupFailure("download_source_rejected")
+            archive = stage / "chrome.zip"
+            _download(url, archive, 384 * 1024 * 1024, cancelled, deadline)
+            _extract_chrome(archive, stage / "chromium", cancelled, deadline)
+            chrome = stage / "chromium" / "chrome-win64" / "chrome.exe"
+            text = _probe_chrome(chrome, stage, version, cancelled, min(deadline, time.monotonic() + 15))
+            if version not in text:
+                raise _SetupFailure("dependency_probe_failed")
+            receipt = {"schema": 1, "version": version, "sha256": _sha(chrome),
+                       "files": {name: _fingerprint(chrome.parent / name)[3] for name in _CHROME_FILES}}
+            with (stage / "chromium" / "verified.json").open("x", encoding="utf-8") as stream:
+                json.dump(receipt, stream, sort_keys=True)
+            _check(cancelled, deadline)
+            _publish(stage / "chromium", root / "chromium")
+        paths = managed_browser_paths()
+        if not paths or (hook == "agent_browser" and not paths.get("chrome")):
+            raise _SetupFailure("dependency_readback_failed")
+        result = {"status": "installed", "verified": True}
+    except _SetupFailure as exc:
+        status = "cancelled" if exc.code == "cancelled" else "manual_setup_required" if exc.code == "dependency_path_too_long" else "failed"
+        result = {"status": status, "code": exc.code, "verified": False}
+        if exc.code == "cleanup_unconfirmed":
+            result["effect_disposition"] = "unknown"
+            result["retryable"] = False
+    except Exception:
+        result = {"status": "failed", "code": "dependency_setup_failed", "verified": False}
+    finally:
+        if (stage is not None and stage.exists() and result.get("effect_disposition") != "unknown"
+                and not _remove_stage(stage, root)):
+            result = {"status": "failed", "code": "staging_cleanup_incomplete", "verified": False, "retryable": False}
+        _install_lock.release()
+    return result
