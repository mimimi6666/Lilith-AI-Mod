+"""Human-requested, profile-owned browser dependencies for managed Hermes.
+
+No package manager, configuration/secret writes or system-browser install.
+The caller owns native provider selection and explicit human confirmation.
+Readiness is local evidence, never an implicit download or network probe.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import platform
+import re
+import shutil
+import stat
+import subprocess
+import tarfile
+import threading
+import time
+import urllib.request
+import uuid
+import zipfile
+
+_VERSION = "0.26.0"
+_TARBALL = "https://registry.npmjs.org/agent-browser/-/agent-browser-0.26.0.tgz"
+_TARBALL_SHA512 = "a5da927e3c1b152a7eaa7c256f6836ddef705ef78839f322d7dc693c0f716546f3100529e96e180598fa61b8fccf833b5a471b1830d873ea032070edf51dc40d"
+_CLI_SHA256 = "540fc7d8b3ec8dea2f84df605492d5ca0e1921281adf8543dc0326109c851b2a"
+_CFT_MANIFEST = "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json"
+_HOOKS = frozenset({"agent_browser", "browserbase"})
+_CHROME_FILES = ("chrome.exe", "chrome.dll", "chrome_elf.dll", "icudtl.dat", "resources.pak", "v8_context_snapshot.bin")
+_install_lock = threading.Lock()
+_verified_cache = {}
+
+
+class _SetupFailure(Exception):
+    def __init__(self, code):
+        self.code = code
+
+
+def _check(cancelled, deadline):
+    if cancelled():
+        raise _SetupFailure("cancelled")
+    if time.monotonic() >= deadline:
+        raise _SetupFailure("timeout")
+
+
+def _plain(path, *, missing=False):
+    """Reject reparse ancestors before every owned path operation."""
+    path = Path(os.path.abspath(path))
+    for item in (*reversed(path.parents), path):
+        try:
+            info = item.lstat()
+        except FileNotFoundError:
+            if missing:
+                continue
+            raise _SetupFailure("unsafe_dependency_path")
+        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+            raise _SetupFailure("unsafe_dependency_path")
+        if item != path and not stat.S_ISDIR(info.st_mode):
+            raise _SetupFailure("unsafe_dependency_path")
+    return path
+
+
+def _root():
+    from hermes_constants import get_hermes_home
+
+    raw = os.environ.get("HERMES_LILITH_BOUND_HOME", "")
+    if not raw or not Path(raw).is_absolute():
+        raise _SetupFailure("managed_home_required")
+    bound = _plain(raw)
+    if os.path.normcase(str(bound)) != os.path.normcase(os.path.abspath(get_hermes_home())):
+        raise _SetupFailure("managed_home_required")
+    return _plain(bound / "tools" / "dependencies" / ("browser-" + _VERSION), missing=True)
+
+
+def _mkdir(path):
+    _plain(path, missing=True)
+    path.mkdir(parents=True, exist_ok=True)
+    _plain(path)
+
+
+def _fingerprint(path):
+    _plain(path)
+    value = path.stat()
+    if not stat.S_ISREG(value.st_mode) or value.st_nlink != 1:
+        raise _SetupFailure("unsafe_dependency_path")
+    return (str(path), value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)
+
+
+def _sha(path, algorithm="sha256"):
+    digest = hashlib.new(algorithm)
+    with path.open("rb") as source:
+        for chunk in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def managed_browser_paths():
+    """Verified CLI and optional Chrome paths; no external probes/writes."""
+    if os.name != "nt" or platform.machine().lower() not in {"amd64", "x86_64"}:
+        return None
+    try:
+        root = _root()
+        cli = root / "cli" / "agent-browser.exe"
+        key = _fingerprint(cli)
+        if _verified_cache.get("cli") != key:
+            if _sha(cli) != _CLI_SHA256:
+                return None
+            _verified_cache["cli"] = key
+        result = {"cli": str(cli)}
+        chrome = root / "chromium" / "chrome-win64" / "chrome.exe"
+        receipt = root / "chromium" / "verified.json"
