@@ -0,0 +1,164 @@
+"""Owned Windows foreground process trees, never a PID-wide cleanup sweep.
+
+The child must be created suspended. Assignment failure kills that exact
+Popen handle without ever allowing the unowned command to run. Background
+process_registry launches do not use this helper.
+"""
+from __future__ import annotations
+
+import ctypes
+from ctypes import wintypes
+import os
+import subprocess
+import time
+
+CREATE_SUSPENDED = 0x00000004
+
+
+class _BasicLimits(ctypes.Structure):
+    _fields_ = [("PerProcessUserTimeLimit", ctypes.c_longlong),
+                ("PerJobUserTimeLimit", ctypes.c_longlong),
+                ("LimitFlags", wintypes.DWORD),
+                ("MinimumWorkingSetSize", ctypes.c_size_t),
+                ("MaximumWorkingSetSize", ctypes.c_size_t),
+                ("ActiveProcessLimit", wintypes.DWORD),
+                ("Affinity", ctypes.c_size_t),
+                ("PriorityClass", wintypes.DWORD),
+                ("SchedulingClass", wintypes.DWORD)]
+
+
+class _IoCounters(ctypes.Structure):
+    _fields_ = [(name, ctypes.c_ulonglong) for name in
+                ("ReadOperationCount", "WriteOperationCount", "OtherOperationCount",
+                 "ReadTransferCount", "WriteTransferCount", "OtherTransferCount")]
+
+
+class _ExtendedLimits(ctypes.Structure):
+    _fields_ = [("BasicLimitInformation", _BasicLimits),
+                ("IoInfo", _IoCounters),
+                ("ProcessMemoryLimit", ctypes.c_size_t),
+                ("JobMemoryLimit", ctypes.c_size_t),
+                ("PeakProcessMemoryUsed", ctypes.c_size_t),
+                ("PeakJobMemoryUsed", ctypes.c_size_t)]
+
+
+class _Accounting(ctypes.Structure):
+    _fields_ = [("TotalUserTime", ctypes.c_longlong),
+                ("TotalKernelTime", ctypes.c_longlong),
+                ("ThisPeriodTotalUserTime", ctypes.c_longlong),
+                ("ThisPeriodTotalKernelTime", ctypes.c_longlong),
+                ("TotalPageFaultCount", wintypes.DWORD),
+                ("TotalProcesses", wintypes.DWORD),
+                ("ActiveProcesses", wintypes.DWORD),
+                ("TotalTerminatedProcesses", wintypes.DWORD)]
+
+
+class _ThreadEntry(ctypes.Structure):
+    _fields_ = [("dwSize", wintypes.DWORD), ("cntUsage", wintypes.DWORD),
+                ("th32ThreadID", wintypes.DWORD), ("th32OwnerProcessID", wintypes.DWORD),
+                ("tpBasePri", wintypes.LONG), ("tpDeltaPri", wintypes.LONG),
+                ("dwFlags", wintypes.DWORD)]
+
+
+class ForegroundWindowsJob:
+    def __init__(self):
+        if os.name != "nt":
+            raise OSError("Windows foreground ownership is unavailable")
+        self._api = ctypes.WinDLL("kernel32", use_last_error=True)
+        signatures = {
+            "CreateJobObjectW": ([ctypes.c_void_p, wintypes.LPCWSTR], wintypes.HANDLE),
+            "SetInformationJobObject": ([wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD], wintypes.BOOL),
+            "QueryInformationJobObject": ([wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD, ctypes.c_void_p], wintypes.BOOL),
+            "AssignProcessToJobObject": ([wintypes.HANDLE, wintypes.HANDLE], wintypes.BOOL),
+            "TerminateJobObject": ([wintypes.HANDLE, wintypes.UINT], wintypes.BOOL),
+            "CloseHandle": ([wintypes.HANDLE], wintypes.BOOL),
+            "CreateToolhelp32Snapshot": ([wintypes.DWORD, wintypes.DWORD], wintypes.HANDLE),
+            "Thread32First": ([wintypes.HANDLE, ctypes.POINTER(_ThreadEntry)], wintypes.BOOL),
+            "Thread32Next": ([wintypes.HANDLE, ctypes.POINTER(_ThreadEntry)], wintypes.BOOL),
+            "OpenThread": ([wintypes.DWORD, wintypes.BOOL, wintypes.DWORD], wintypes.HANDLE),
+            "ResumeThread": ([wintypes.HANDLE], wintypes.DWORD),
+        }
+        for name, (args, result) in signatures.items():
+            method = getattr(self._api, name)
+            method.argtypes, method.restype = args, result
+        self._handle = self._api.CreateJobObjectW(None, None)
+        if not self._handle:
+            raise OSError("Cannot create foreground process ownership")
+        limits = _ExtendedLimits()
+        limits.BasicLimitInformation.LimitFlags = 0x00002000  # KILL_ON_JOB_CLOSE
+        if not self._api.SetInformationJobObject(self._handle, 9, ctypes.byref(limits), ctypes.sizeof(limits)):
+            self.close()
+            raise OSError("Cannot configure foreground process ownership")
+
+    def attach_and_resume(self, proc):
+        try:
+            # Windows 8+ supports nested jobs. If the hosting job's restrictions
+            # prevent assignment, fail closed: never use BREAKAWAY or resume.
+            if not self._api.AssignProcessToJobObject(self._handle, int(proc._handle)):
+                raise OSError("Cannot own foreground process tree in this host")
+            snapshot = self._api.CreateToolhelp32Snapshot(0x00000004, 0)
+            if snapshot == ctypes.c_void_p(-1).value:
+                raise OSError("Cannot inspect suspended foreground thread")
+            try:
+                entry = _ThreadEntry()
+                entry.dwSize = ctypes.sizeof(entry)
+                found = self._api.Thread32First(snapshot, ctypes.byref(entry))
+                while found:
+                    if entry.th32OwnerProcessID == proc.pid:
+                        thread = self._api.OpenThread(0x0002, False, entry.th32ThreadID)
+                        if not thread:
+                            raise OSError("Cannot open suspended foreground thread")
+                        try:
+                            previous = self._api.ResumeThread(thread)
+                            if previous == 0xFFFFFFFF or previous != 1:
+                                raise OSError("Cannot resume owned foreground process")
+                        finally:
+                            self._api.CloseHandle(thread)
+                        return
+                    found = self._api.Thread32Next(snapshot, ctypes.byref(entry))
+                raise OSError("Suspended foreground thread is unavailable")
+            finally:
+                self._api.CloseHandle(snapshot)
+        except BaseException:
+            self.terminate_and_wait(2.0)
+            # Assignment can fail before the process belongs to our job.
+            try:
+                proc.kill()
+                proc.wait(timeout=2.0)
+            finally:
+                self.close()
+            raise
