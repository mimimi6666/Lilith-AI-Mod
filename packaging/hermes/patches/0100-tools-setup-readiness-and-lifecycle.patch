+++ b/tools/skill_dependencies.py
@@ -0,0 +1,36 @@
+"""Read-only, declarative local dependency observations for native skills.
+
+Metadata is untrusted: never import a named module or execute a command to
+check it. These observations describe this Hermes interpreter/host only, not
+a remote sandbox, another Python on PATH, or a successful document operation.
+"""
+import importlib.util
+import re
+import shutil
+
+
+def inspect_skill_dependencies(frontmatter):
+    result = {"required_commands": [], "missing_required_commands": [],
+              "required_python_modules": [], "missing_required_python_modules": [],
+              "dependency_environment": "hermes_host", "dependency_metadata_valid": True}
+    for field, pattern, probe in (
+        ("required_commands", r"[A-Za-z0-9][A-Za-z0-9_.+-]{0,95}", shutil.which),
+        ("required_python_modules", r"[A-Za-z_][A-Za-z0-9_]{0,95}", importlib.util.find_spec),
+    ):
+        items = frontmatter.get(field, [])
+        if (not isinstance(items, list) or len(items) > 64
+                or any(not isinstance(value, str) or not re.fullmatch(pattern, value) for value in items)
+                or len(set(items)) != len(items)):
+            result["dependency_metadata_valid"] = False
+            continue
+        result[field] = items[:]
+        for value in items:
+            try:
+                present = bool(probe(value))
+            except Exception:
+                present = False
+            if not present:
+                result["missing_" + field].append(value)
+    result["dependency_setup_needed"] = (not result["dependency_metadata_valid"]
+        or bool(result["missing_required_commands"] or result["missing_required_python_modules"]))
+    return result
