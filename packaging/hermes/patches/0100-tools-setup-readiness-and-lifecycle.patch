+"""Explicit human setup of the native pinned FAL SDK, never lazy installation.
+
+The caller owns the native provider and human Install confirmation. This module
+cannot select a package/version/source from tool arguments. Neither readiness
+nor activation downloads, changes configuration, calls FAL or runs pip.
+"""
+from __future__ import annotations
+
+import hashlib
+import importlib
+import importlib.metadata
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import sys
+import sysconfig
+import threading
+import time
+import uuid
+
+from tools.managed_tool_dependencies import _SetupFailure, _check, _mkdir, _plain, _probe, _publish
+
+_FEATURE = "image.fal"
+_MODULE = "fal_client"
+_ROOT_ENV = "HERMES_LILITH_PYTHON_DEPENDENCIES_ROOT"
+_PIP_WHEEL = "pip-24.0-py3-none-any.whl"
+_MAX_FILES = 12000
+_MAX_BYTES = 256 * 1024 * 1024
+_lock = threading.Lock()
+_activation_lock = threading.RLock()
+_owned_paths = set()
+_activated_profiles = set()
+_active_profile_path = None
+_managed_seen = False
+
+
