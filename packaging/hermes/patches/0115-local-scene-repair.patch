+++ b/tools/lilith_scene/errors.py
@@ -0,0 +1,19 @@
+"""Closed diagnostic codes. Never project exception messages or local paths."""
+CODES = frozenset({
+    "cancelled", "busy", "dependency_unavailable", "worker_start_failed", "worker_failed", "worker_timeout",
+    "worker_output_invalid", "result_validation_failed", "asset_verification_failed", "ocr_initialization_failed",
+    "local_model_start_failed", "local_model_start_timeout", "local_model_exited", "local_inference_failed",
+    "capture_unavailable", "capture_timeout", "capture_backend_unavailable", "blank_capture", "ui_unavailable",
+    "sensitive_ui", "sensitive_window", "target_changed", "no_content_window", "own_window_foreground",
+    "target_selection_limit", "target_identity_unavailable", "ambiguous_content_window", "invalid_trigger",
+})
+
+
+class SceneError(Exception):
+    def __init__(self, code):
+        self.code = code if isinstance(code, str) and code in CODES else "worker_failed"
+        super().__init__(self.code)
+
+
+def failure(code):
+    return {"schema": "local_scene_error_v1", "status": "unavailable", "code": SceneError(code).code}
