+def test_parent_preserves_specific_worker_failure_and_cleans_up(code):
+    events = []
+    class Job:
+        def assign(self, process): events.append("assigned")
+        def close(self): events.append("closed")
+    class Process:
+        def __init__(self, *args, **kwargs):
+            self.stdin = io.BytesIO()
+            self.stdout = io.BytesIO(json.dumps(failure(code)).encode())
+            self.returncode = 2
+        def poll(self): return self.returncode
+        def wait(self, **kwargs): return self.returncode
+    with patch.object(host, "explicit_opt_in", return_value=True), \
+         patch.object(host, "configuration", return_value=({}, "fixture-python")), \
+         patch.object(host, "foreground", return_value=target()), \
+         patch.object(host, "OwnedJob", Job), patch.object(host.subprocess, "Popen", Process):
+        assert host.observe("player_share") == {"status": "unavailable", "code": code}
+    assert events == ["assigned", "closed"] and not host._busy.locked()
+
+
+@pytest.mark.parametrize("code", ["sensitive_ui", "local_inference_failed", "local_model_start_timeout"])
+def test_isolated_entry_point_serializes_code_but_not_exception_or_request(code):
+    output = io.BytesIO()
+    previous_path = worker.sys.path[:]
+    try:
+        with patch.object(worker.sys, "stdin", SimpleNamespace(buffer=io.BytesIO(b'{"private":"SECRET"}'))), \
+             patch.object(worker.sys, "stdout", SimpleNamespace(buffer=output)), \
+             patch.object(worker, "open", return_value=io.StringIO(), create=True), \
+             patch.object(worker, "run", side_effect=SceneError(code)):
+            assert worker.main() == 2
+        assert json.loads(output.getvalue()) == failure(code)
+        assert b"SECRET" not in output.getvalue()
+    finally:
+        worker.sys.path[:] = previous_path
+
