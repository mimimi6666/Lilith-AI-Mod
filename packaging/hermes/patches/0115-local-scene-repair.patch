+
+
+def selector(data, code=0, trigger="player_share"):
+    raw = data if isinstance(data, bytes) else json.dumps(data).encode()
+    with patch.object(host.subprocess, "run", return_value=SimpleNamespace(stdout=raw, returncode=code)) as run:
+        result = host.foreground({"capture": {"root": "fixture"}}, trigger)
