@@ -0,0 +1,32 @@
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from agent.conversation_loop import _notify_delegated_assistant_preview
+
+
+def test_root_final_content_is_not_relayed_as_reasoning() -> None:
+    observed: list[tuple[object, ...]] = []
+    agent = SimpleNamespace(
+        _delegate_depth=0,
+        tool_progress_callback=lambda *args: observed.append(args),
+    )
+
+    _notify_delegated_assistant_preview(agent, "This is the final answer.")
+
+    assert observed == []
+
+
+def test_delegated_child_keeps_bounded_first_line_progress_preview() -> None:
+    observed: list[tuple[object, ...]] = []
+    agent = SimpleNamespace(
+        _delegate_depth=1,
+        tool_progress_callback=lambda *args: observed.append(args),
+    )
+
+    _notify_delegated_assistant_preview(
+        agent,
+        "<reasoning>delegated result</reasoning>\nignored second line",
+    )
+
+    assert observed == [("_thinking", "delegated result")]
diff --git a/tests/tui_gateway/test_reasoning_event_semantics.py b/tests/tui_gateway/test_reasoning_event_semantics.py
new file mode 100644
index 0000000000000000000000000000000000000000..af44f06da9fc22f1aca33104f48187143195781d
--- /dev/null
+++ b/tests/tui_gateway/test_reasoning_event_semantics.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+import threading
+import types
+
+import pytest
+
+from tui_gateway import server
+
+
+class _InlineThread:
+    def __init__(self, target=None, daemon=None, args=(), kwargs=None):
+        self._target = target
+        self._args = args
+        self._kwargs = kwargs or {}
+
+    def start(self):
+        if self._target is not None:
+            self._target(*self._args, **self._kwargs)
+
+    def is_alive(self):
+        return False
+
+    def join(self, timeout=None):
+        return None
+
+
+def _session(agent):
+    return {
+        "agent": agent,
+        "session_key": "session-key",
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "running": True,
+        "attached_images": [],
+        "image_counter": 0,
+        "cols": 80,
+        "slash_worker": None,
+        "show_reasoning": False,
+        "tool_progress_mode": "all",
+        "inflight_turn": None,
+    }
+
+
+@pytest.fixture()
+def turn_env(monkeypatch, tmp_path):
+    captured: list[tuple[str, str, object]] = []
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: captured.append((event, sid, payload)),
+    )
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
+    monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
+    monkeypatch.setattr(server, "_session_cwd", lambda session: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda session: None)
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda: None)
+    monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_get_usage", lambda agent: {})
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    return captured
+
+
+def test_last_reasoning_is_emitted_exactly_before_message_complete(turn_env) -> None:
+    final_answer = "The final answer is separate."
+    actual_reasoning = "First weigh the two constraints, then choose the safer one."
+    agent = types.SimpleNamespace(
+        session_id="session-key",
+        run_conversation=lambda *args, **kwargs: {
+            "final_response": final_answer,
+            "last_reasoning": actual_reasoning,
+        },
+        clear_interrupt=lambda: None,
+    )
+
+    server._run_prompt_submit("rid", "sid", _session(agent), "compare them")
+
+    terminal = [
+        (event, payload)
+        for event, _sid, payload in turn_env
+        if event in {"reasoning.available", "message.complete"}
+    ]
+    assert [event for event, _payload in terminal] == [
+        "reasoning.available",
+        "message.complete",
+    ]
+    assert terminal[0][1] == {"text": actual_reasoning}
+    assert terminal[1][1]["text"] == final_answer
+    assert terminal[1][1]["reasoning"] == actual_reasoning
+    assert terminal[0][1]["text"] != terminal[1][1]["text"]
+
+
+def test_no_last_reasoning_emits_no_reasoning_event(turn_env) -> None:
+    final_answer = "A normal answer without provider-exposed reasoning."
+    agent = types.SimpleNamespace(
+        session_id="session-key",
+        run_conversation=lambda *args, **kwargs: {
+            "final_response": final_answer,
+            "last_reasoning": None,
+        },
+        clear_interrupt=lambda: None,
+    )
+
+    server._run_prompt_submit("rid", "sid", _session(agent), "answer normally")
+
+    assert not [event for event, _sid, _payload in turn_env if event == "reasoning.available"]
+    completes = [
+        payload for event, _sid, payload in turn_env if event == "message.complete"
+    ]
+    assert len(completes) == 1
+    assert completes[0]["text"] == final_answer
+    assert "reasoning" not in completes[0]
