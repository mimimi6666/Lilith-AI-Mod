+def _notify_delegated_assistant_preview(agent: Any, content: str) -> None:
+    """Relay final assistant prose only as a delegated-child progress preview.
+
+    Final assistant content is not reasoning.  Provider-exposed reasoning has
+    its own ``reasoning_callback`` path and the TUI gateway publishes the
+    completed per-turn snapshot from ``result.last_reasoning``.
+    """
+    callback = getattr(agent, "tool_progress_callback", None)
+    if not content or callback is None or getattr(agent, "_delegate_depth", 0) <= 0:
+        return
+
+    preview = re.sub(
+        r"</?(?:REASONING_SCRATCHPAD|think|reasoning)>", "", content
+    ).strip()
+    first_line = preview.split("\n")[0][:80] if preview else ""
+    if not first_line:
+        return
+    try:
+        callback("_thinking", first_line)
+    except Exception:
+        pass
+
