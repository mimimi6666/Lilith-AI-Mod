+    def get_display_resume_conversations(
+        self, session_id: str, *, mark_persisted: bool = False,
+        ancestors_only: bool = False,
+    ) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]]]:
+        """Opt-in bounded display projection; the legacy/model reader is unchanged.
+
+        Read a single snapshot including withdrawal *identities*, never their
+        bodies. Model rows remain the active tip. Display rows may additionally
+        use compaction originals, with exact identity/provenance reconciliation.
+        No schema change, repair write, text matching or model call is involved.
+        """
+        from agent.turn_identity import canonical_id
+
+        with self._read_ctx() as conn:
+            conn.execute("SAVEPOINT display_history_snapshot")
+            try:
+                chain, seen, current = [], set(), session_id
+                for _ in range(100):
+                    if not current:
+                        break
+                    if current in seen:
+                        raise HistoryProjectionError("history_lineage_invalid")
+                    seen.add(current)
+                    chain.append(current)
+                    parent = conn.execute(
+                        "SELECT parent_session_id FROM sessions WHERE id = ?", (current,)
+                    ).fetchone()
+                    current = parent[0] if parent else None
+                if current:
+                    raise HistoryProjectionError("history_lineage_too_large")
+                chain.reverse()
+                chain = chain or [session_id]
+                placeholders = ",".join("?" for _ in chain)
+                # The raw-row ceiling also includes tombstones and retained
+                # replicas. Repeated compaction cannot bypass the display cap.
+                fields = []
+                metadata_fields = {"id", "role", "tool_call_id", "tool_name",
+                                   "display_kind", "display_metadata"}
+                for field in self._CONVERSATION_ROW_COLUMNS.split(", "):
+                    fields.append(field if field in metadata_fields else
+                                  f"CASE WHEN active = 1 OR compacted = 1 THEN {field} END AS {field}")
+                rows = conn.execute(
+                    f"SELECT session_id, active, compacted, {', '.join(fields)} FROM messages "
+                    f"WHERE session_id IN ({placeholders}) ORDER BY id LIMIT ?",
+                    (*chain, _DISPLAY_HISTORY_ROW_LIMIT + 1),
+                ).fetchall()
+                if len(rows) > _DISPLAY_HISTORY_ROW_LIMIT:
+                    raise HistoryProjectionError("history_projection_too_large")
+            finally:
+                conn.execute("RELEASE SAVEPOINT display_history_snapshot")
+
+        tip = [row for row in rows if row["session_id"] == session_id and row["active"]]
+        model = self._rows_to_conversation(
+            tip, session_id=session_id, include_ancestors=False,
+            repair_alternation=True, include_row_ids=True, mark_persisted=mark_persisted,
+        )
+        by_id = {row["id"]: row for row in rows}
+        metadata = {row["id"]: self._decode_display_metadata(row["display_metadata"]) or {}
+                    for row in rows}
+        groups, origins = {}, {}
+        unknown = divergence = 0
+        for row in rows:
+            meta = metadata[row["id"]]
+            receipt = meta.get(_COMPACTION_DISPLAY_PROVENANCE)
+            if receipt is not None:
+                if not isinstance(receipt, dict):
+                    raise HistoryProjectionError("history_provenance_invalid")
+                if receipt == {"kind": "summary"}:
+                    origins[row["id"]] = None
+                    continue
+                origin_id = receipt.get("origin_row_id")
+                if (set(receipt) != {"kind", "origin_row_id"} or receipt.get("kind") != "replica"
+                        or not isinstance(origin_id, int) or isinstance(origin_id, bool)
+                        or origin_id >= row["id"]):
+                    raise HistoryProjectionError("history_provenance_invalid")
+                original = by_id.get(origin_id)
+                if (original is None or original["session_id"] != row["session_id"]
+                        or original["role"] != row["role"]
+                        or any(original[key] != row[key] for key in ("tool_call_id", "tool_name"))
+                        or not _display_tools_are_subset(original["tool_calls"], row["tool_calls"])
+                        or _display_canonical_metadata(metadata[origin_id]) != _display_canonical_metadata(meta)
+                        or origin_id not in origins or origins[origin_id] is None):
+                    raise HistoryProjectionError("history_provenance_conflict")
+                origins[row["id"]] = origins[origin_id]
+            else:
+                origins[row["id"]] = row["id"]
+            turn = canonical_id(meta.get("hermes_turn_id"))
+            message = canonical_id(meta.get("hermes_message_id"))
+            key = ("canonical", turn, message) if turn and message else ("row", origins[row["id"]])
+            groups.setdefault(key, []).append(row)
+
+        selected = []
+        for key, copies in groups.items():
+            # An edit/rewind withdraws a whole canonical revision. Do not reach
+            # across that boundary to an older compacted original. A subsequent
+            # restored/reinserted active revision is independently eligible.
+            tombstone = max((row["id"] for row in copies if not row["active"] and not row["compacted"]), default=-1)
+            eligible = [row for row in copies if row["id"] > tombstone and (row["active"] or row["compacted"])]
+            if not eligible:
+                continue
+            original = eligible[0]
+            for copy in eligible[1:]:
+                typed_replica = _COMPACTION_DISPLAY_PROVENANCE in metadata[copy["id"]]
+                immutable = ("role", "tool_call_id", "tool_name", "display_kind")
+                if (any(original[field] != copy[field] for field in immutable)
+                        or (not _display_tools_are_subset(original["tool_calls"], copy["tool_calls"])
+                            if typed_replica else _display_tool_calls(original["tool_calls"]) != _display_tool_calls(copy["tool_calls"]))
+                        or _display_canonical_metadata(metadata[original["id"]])
+                        != _display_canonical_metadata(metadata[copy["id"]])):
+                    raise HistoryProjectionError("history_identity_conflict")
+                if not typed_replica:
+                    # Legacy copies lack a durable rewrite receipt. All other
+                    # content/semantics fields must agree, and an archived
+                    # original must exist, before choosing that original.
+                    fields = ("api_content", "reasoning", "reasoning_content", "reasoning_details",
+                              "codex_reasoning_items", "codex_message_items", "finish_reason", "effect_disposition")
+                    ancestor_replay = (
+                        original["session_id"] != copy["session_id"]
+                        and chain.index(original["session_id"]) < chain.index(copy["session_id"])
+                        and original["content"] == copy["content"]
+                    )
+                    if (not (original["compacted"] or ancestor_replay)
+                            or any(original[field] != copy[field] for field in fields)):
+                        raise HistoryProjectionError("history_identity_conflict")
+                    if original["content"] != copy["content"]:
+                        divergence += 1
+            if key[0] == "row" and _COMPACTION_DISPLAY_PROVENANCE not in metadata[original["id"]]:
+                unknown += 1
+            if not ancestors_only or original["session_id"] != session_id:
+                selected.append(original)
+        selected.sort(key=lambda row: row["id"])
+        if unknown:
+            logger.info("history_legacy_provenance_unknown count=%d", unknown)
+        if divergence:
+            logger.warning("history_legacy_content_divergence count=%d", divergence)
+        display = self._rows_to_conversation(
+            selected, session_id=session_id, include_ancestors=False,
+            repair_alternation=False, include_row_ids=True,
+        )
+        return model, _DisplayHistory(display, (row_id for row_id, origin in origins.items() if origin is None))
+
+    def get_display_conversation(self, session_id: str, *, ancestors_only: bool = False):
+        return self.get_display_resume_conversations(session_id, ancestors_only=ancestors_only)[1]
+
