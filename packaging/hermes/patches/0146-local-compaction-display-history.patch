+def _display_canonical_metadata(metadata):
+    # Reactions and other presentation annotations can change independently on
+    # an original row. They are not immutable message correlation.
+    metadata = metadata if isinstance(metadata, dict) else {}
+    keys = (
+        "hermes_turn_id", "hermes_message_id", "hermes_message_kind",
+        "hermes_user_message_id", "hermes_turn_origin", "hermes_turn_origin_kind",
+        "hermes_profile_memory_human_origin", "hermes_profile_memory_subject_id",
+    )
+    return tuple((key, metadata.get(key)) for key in keys if key in metadata)
+
+
+def _display_tool_calls(value):
+    if not value:
+        return None
+    if isinstance(value, str):
+        try:
+            return json.loads(value)
+        except (TypeError, ValueError) as exc:
+            raise HistoryProjectionError("history_tool_linkage_invalid") from exc
+    return value
+
+
+def _display_tools_are_subset(original, rewritten):
+    """Allow only the compressor's ordered removal of orphaned calls."""
+    original, rewritten = _display_tool_calls(original), _display_tool_calls(rewritten)
+    if not rewritten:
+        return True
+    if not isinstance(original, list) or not isinstance(rewritten, list):
+        return False
+    position = 0
+    for call in rewritten:
+        while position < len(original) and original[position] != call:
+            position += 1
+        if position >= len(original):
+            return False
+        position += 1
+    return True
+
+
+class HistoryProjectionError(ValueError):
+    """A bounded display read failed; this never changes model/session authority."""
+
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
