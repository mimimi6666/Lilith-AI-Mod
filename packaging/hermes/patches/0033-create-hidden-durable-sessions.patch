diff --git a/tests/hermes_state/test_session_archiving.py b/tests/hermes_state/test_session_archiving.py
index 36ecb95..84d052e 100644
--- a/tests/hermes_state/test_session_archiving.py
+++ b/tests/hermes_state/test_session_archiving.py
@@ -49,3 +49,69 @@ def test_unarchiving_compression_tip_unarchives_projected_root(db):
     assert db.get_session("root")["archived"] == 0
     assert db.get_session("tip")["archived"] == 0
     assert [s["id"] for s in db.list_sessions_rich(order_by_last_active=True)] == ["tip"]
+
+
+def test_archived_parent_publishes_archived_compression_child(db):
+    db.create_session("root", source="tui", archived=True)
+    db.append_message("root", role="user", content="before compression")
+
+    db.publish_compression_child(
+        parent_session_id="root",
+        child_session_id="tip",
+        source="tui",
+        messages=[
+            {"role": "user", "content": "compressed context"},
+            {"role": "assistant", "content": "after compression"},
+        ],
+        require_compression_lease=False,
+    )
+
+    root = db.get_session("root")
+    tip = db.get_session("tip")
+    assert root["end_reason"] == "compression"
+    assert tip["parent_session_id"] == "root"
+    assert root["archived"] == 1
+    assert tip["archived"] == 1
+    assert db.list_sessions_rich(order_by_last_active=True) == []
+    assert [
+        session["id"]
+        for session in db.list_sessions_rich(
+            order_by_last_active=True, archived_only=True
+        )
+    ] == ["tip"]
+
+    # Existing lineage operations still treat the rotated conversation as one
+    # logical session rather than leaving a hidden ancestor behind.
+    assert db.set_session_archived("tip", False) is True
+    assert db.get_session("root")["archived"] == 0
+    assert db.get_session("tip")["archived"] == 0
+
+
+def test_archived_create_has_no_cross_transaction_visibility_window(tmp_path):
+    writer = SessionDB(tmp_path / "state.db")
+    reader = SessionDB(tmp_path / "state.db")
+    visible_during_writes = []
+    original_execute_write = writer._execute_write
+
+    def observing_execute_write(work, *args, **kwargs):
+        def observe_before_commit(conn):
+            result = work(conn)
+            visible_during_writes.extend(
+                session["id"] for session in reader.list_sessions_rich()
+            )
+            return result
+
+        return original_execute_write(observe_before_commit, *args, **kwargs)
+
+    writer._execute_write = observing_execute_write
+    try:
+        writer.create_session("hidden", source="tui", archived=True)
+
+        # A two-transaction implementation (visible INSERT followed by archive)
+        # would expose `hidden` to the reader between those writes.
+        assert visible_during_writes == []
+        assert reader.list_sessions_rich() == []
+        assert reader.get_session("hidden")["archived"] == 1
+    finally:
+        writer.close()
+        reader.close()
diff --git a/tests/tui_gateway/test_archived_session_create.py b/tests/tui_gateway/test_archived_session_create.py
new file mode 100644
index 0000000..293f5d2
--- /dev/null
+++ b/tests/tui_gateway/test_archived_session_create.py
@@ -0,0 +1,156 @@
+"""Behavior contract for hidden-but-durable TUI gateway sessions."""
+
+import threading
+
+import pytest
+
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+@pytest.fixture
+def gateway_db(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    existing_sids = set(server._sessions)
+    turn_settled = threading.Event()
+
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(
+        server,
+        "_resolve_session_create_model_pair",
+        lambda **_kwargs: ("test-model", "test-provider"),
+    )
+    monkeypatch.setattr(server, "_completion_cwd", lambda _params=None: str(tmp_path))
+    monkeypatch.setattr(server, "_schedule_agent_build", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server, "_schedule_session_cap_enforcement", lambda *_args, **_kwargs: None
+    )
+    monkeypatch.setattr(
+        server, "_native_authority_quarantine_rpc_error", lambda _rid: None
+    )
+    monkeypatch.setattr(
+        server, "_ensure_active_session_slot", lambda _sid, _session: None
+    )
+    monkeypatch.setattr(
+        server, "_load_dashboard_process_isolation_config", lambda: {}
+    )
+    monkeypatch.setattr(
+        server, "_session_uses_compute_host", lambda _session, _cfg: False
+    )
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_start_agent_build", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(
+        server, "_wait_agent_for_prompt", lambda _session, _rid, _sid: None
+    )
+    monkeypatch.setattr(
+        server, "_maybe_schedule_auto_continue", lambda *_args, **_kwargs: None
+    )
+
+    def settle_turn(_rid, _sid, session, _text):
+        with session["history_lock"]:
+            session["running"] = False
+            server._clear_inflight_turn(session)
+        turn_settled.set()
+
+    monkeypatch.setattr(server, "_run_prompt_submit", settle_turn)
+
+    try:
+        yield db, turn_settled
+    finally:
+        for sid in set(server._sessions) - existing_sids:
+            server._sessions.pop(sid, None)
+        db.close()
+
+
+def _create_and_submit(gateway_db, *, archived=None):
+    db, turn_settled = gateway_db
+    params = {"cols": 80}
+    if archived is not None:
+        params["archived"] = archived
+
+    created = server._methods["session.create"]("create", params)
+    assert "error" not in created
+    sid = created["result"]["session_id"]
+    stored_id = created["result"]["stored_session_id"]
+
+    # Drafts remain ephemeral regardless of visibility policy.
+    assert db.get_session(stored_id) is None
+
+    submitted = server._methods["prompt.submit"](
+        "submit", {"session_id": sid, "text": "hello"}
+    )
+    assert submitted["result"]["status"] == "streaming"
+    assert turn_settled.wait(2), "prompt worker did not settle"
+    return sid, stored_id
+
+
+def _listed_ids():
+    response = server._methods["session.list"]("list", {})
+    assert "error" not in response
+    return {item["id"] for item in response["result"]["sessions"]}
+
+
+def test_session_create_default_persists_visible_on_first_prompt(gateway_db):
+    db, _ = gateway_db
+    sid, stored_id = _create_and_submit(gateway_db)
+
+    assert server._sessions[sid]["archived"] is False
+    assert db.get_session(stored_id)["archived"] == 0
+    assert stored_id in _listed_ids()
+
+
+def test_archived_session_is_hidden_after_first_prompt_but_resumable_with_history(
+    gateway_db,
+):
+    db, _ = gateway_db
+    sid, stored_id = _create_and_submit(gateway_db, archived=True)
+
+    assert server._sessions[sid]["archived"] is True
+    assert db.get_session(stored_id)["archived"] == 1
+    assert stored_id not in _listed_ids()
+
+    db.append_message(stored_id, role="user", content="hello")
+    db.append_message(stored_id, role="assistant", content="hello back")
+
+    # Force the cold path: archive is a visibility flag, not a resume ban.
+    server._sessions.pop(sid)
+    resumed = server._methods["session.resume"](
+        "resume", {"session_id": stored_id}
+    )
+    assert "error" not in resumed
+    resumed_sid = resumed["result"]["session_id"]
+    assert resumed["result"]["resumed"] == stored_id
+    assert [message["text"] for message in resumed["result"]["messages"]] == [
+        "hello",
+        "hello back",
+    ]
+
+    history = server._methods["session.history"](
+        "history", {"session_id": resumed_sid}
+    )
+    assert "error" not in history
+    assert [message["text"] for message in history["result"]["messages"]] == [
+        "hello",
+        "hello back",
+    ]
+    assert db.get_session(stored_id)["archived"] == 1
+    assert stored_id not in _listed_ids()
+
+
+@pytest.mark.parametrize(
+    "malicious_value",
+    [None, 0, 1, "false", "true", [], {}],
+)
+def test_session_create_rejects_non_boolean_archived_without_allocating_session(
+    malicious_value,
+):
+    before = set(server._sessions)
+
+    response = server._methods["session.create"](
+        "invalid", {"archived": malicious_value}
+    )
+
+    assert response["error"]["code"] == 4004
+    assert response["error"]["message"] == "archived must be a boolean"
+    assert set(server._sessions) == before
+
