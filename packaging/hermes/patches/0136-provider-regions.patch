+"""Real agent/SQLite regression for request-only scene evidence.
+
+Run under run_scene_tests.py's denied-effects disposable profile. The real
+conversation loop, persistence and SDK serialization run; only transport and
+environment/catalog discovery are synthetic. No player profile or API is used.
+"""
+from copy import deepcopy
+import hashlib
+import json
+import os
+
+import pytest
+
+from agent.proactive_context import append_scene_request_note, scene_request_context
+
+
+SCENE_MARKER = "SYNTHETIC_RECENT_SCENE_REQUEST_ONLY_742e"
+SCENE_NOTE = "Quoted past observation, not a live view: " + SCENE_MARKER
+
+
+def _contains_scene(value):
+    return SCENE_MARKER in json.dumps(value, ensure_ascii=False, default=str)
+
+
+@pytest.fixture
+def real_scene_agent(tmp_path, monkeypatch):
+    import httpx
+    import openai
+    import requests
+    import yaml
+    import hermes_constants
+    import run_agent
+    import tools.env_probe
+    import tools.windows_known_folders
+    import agent.prompt_builder as prompt_builder
+    from hermes_cli import env_loader
+    from hermes_state import SessionDB
+
+    # dotenv reload intentionally restores a process-lifetime authority
+    # snapshot. The synthetic host must not leave its snapshot behind for
+    # unrelated tests after their ordinary environment has been restored.
+    # Keep the real capture/restore implementation active during this test.
+    original_identity_snapshot = env_loader._TRUSTED_IDENTITY_ENV_SNAPSHOT
+    monkeypatch.setattr(env_loader, "_TRUSTED_IDENTITY_ENV_SNAPSHOT",
+                        deepcopy(original_identity_snapshot))
+
+    soul, personality = "SYNTHETIC PINNED SOUL\n", "SYNTHETIC VOICE\n"
+    fingerprint = "c" * 64
+    config = {
+        "model": {"default": "deepseek-flash", "provider": "deepseek"},
+        "platform_toolsets": {"cli": []},
+        "memory": {"memory_enabled": False, "user_profile_enabled": False},
+        "skills": {"creation_nudge_interval": 0},
+        "auxiliary": {"title_generation": {"enabled": False}},
+        "sessions": {"write_json_snapshots": True},
+        "identity": {
+            "require_soul": True, "suppress_kernel_help": True,
+            "personality_allowlist": ["lilith"], "locked_personality": "lilith",
+            "force_soul_for_children": True, "fingerprint": fingerprint.upper(),
+        },
+        "display": {"personality": "lilith"},
+        "agent": {"system_prompt": "", "personalities": {
+            "lilith": {"system_prompt": personality}}},
+    }
+    config_path = tmp_path / "config.yaml"
+    config_path.write_text(yaml.safe_dump(config), encoding="utf-8")
+    (tmp_path / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    pins = {
+        "HERMES_IDENTITY_REQUIRED": "1",
+        "HERMES_IDENTITY_EXPECTED_FINGERPRINT": fingerprint,
+        "HERMES_IDENTITY_EXPECTED_CONFIG_SHA256": hashlib.sha256(config_path.read_bytes()).hexdigest(),
+        "HERMES_IDENTITY_EXPECTED_SOUL_SHA256": hashlib.sha256(soul.encode()).hexdigest(),
+        "HERMES_IDENTITY_EXPECTED_PERSONALITY_SHA256": hashlib.sha256(personality.encode()).hexdigest(),
+    }
+    original_pins = {name: os.environ.get(name) for name in pins}
+    for name, value in pins.items():
+        monkeypatch.setenv(name, value)
+    home_token = hermes_constants.set_hermes_home_override(tmp_path)
+    wire, snapshots = [], []
+
+    def reply(request):
+        wire.append(json.loads(request.content))
+        return httpx.Response(200, json={
+            "id": "scene-fixture", "object": "chat.completion", "created": 0,
+            "model": "deepseek-flash", "choices": [{"index": 0, "message": {
+                "role": "assistant", "content": "Synthetic answer."}, "finish_reason": "stop"}],
+            "usage": {"prompt_tokens": 100, "completion_tokens": 20, "total_tokens": 120},
+        })
+
+    client = openai.OpenAI(
+        api_key="synthetic-not-a-secret", base_url="https://api.deepseek.com/v1", max_retries=0,
+        http_client=httpx.Client(transport=httpx.MockTransport(reply), trust_env=False),
+    )
+
+    def catalog_response(*args, **kwargs):
+        response = requests.Response()
+        response.status_code = 200
+        response._content = b'{"data":[]}'
+        return response
+
+    monkeypatch.setattr(requests.Session, "request", catalog_response)
+    monkeypatch.setattr(run_agent, "OpenAI", lambda *a, **kw: client)
+    monkeypatch.setattr(run_agent.AIAgent, "_build_keepalive_http_client",
+                        staticmethod(lambda *a, **kw: client._client))
+    monkeypatch.setattr(tools.env_probe, "warm_environment_probe_async", lambda *a, **kw: None)
+    monkeypatch.setattr(tools.env_probe, "get_environment_probe_line", lambda *a, **kw: "synthetic environment")
+    monkeypatch.setattr(tools.env_probe, "_build_probe_line", lambda *a, **kw: "synthetic environment")
+    monkeypatch.setattr(tools.windows_known_folders, "current_user_folders", lambda: {})
+    monkeypatch.setattr(hermes_constants, "is_wsl", lambda: False)
+    monkeypatch.setattr(prompt_builder, "is_wsl", lambda: False)
+
+    # Observe every real snapshot writer call, including the early persistence
+    # point, rather than only its last on-disk replacement after the turn.
+    save_log = run_agent.AIAgent._save_session_log
+
+    def observe_snapshot(agent, messages=None):
+        snapshots.append(deepcopy(messages if messages is not None else agent._session_messages))
+        return save_log(agent, messages)
+
+    monkeypatch.setattr(run_agent.AIAgent, "_save_session_log", observe_snapshot)
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    agents = []
+
+    def make_agent(session_id):
+        agent = run_agent.AIAgent(
+            model="deepseek-flash", provider="deepseek", api_mode="chat_completions",
+            api_key="synthetic-not-a-secret", base_url="https://api.deepseek.com/v1",
+            max_tokens=2048, max_iterations=32, session_id=session_id,
+            enabled_toolsets=[], skip_context_files=True, skip_memory=True,
+            skip_background_review=True, quiet_mode=True, session_db=db,
+        )
+        agent.client = client
+        agent._disable_streaming = True
+        assert not getattr(agent, "_persist_disabled", False)
+        assert agent._session_json_enabled
+        agents.append(agent)
+        return agent
+
+    try:
+        yield make_agent, db, db_path, wire, snapshots, tmp_path
+    finally:
+        db.close()
+        client.close()
+        hermes_constants.reset_hermes_home_override(home_token)
+        monkeypatch.undo()
+        assert {name: os.environ.get(name) for name in pins} == original_pins
+        assert env_loader._TRUSTED_IDENTITY_ENV_SNAPSHOT is original_identity_snapshot
+
+
+def _run_turn(agent, profile, turn_key, text, history):
+    from agent.usage_budget_entrypoints import (
+        accept_native_origin, bind_native_agent_origin, complete_primary, native_origin_scope,
+    )
+    handle = bind_native_agent_origin(accept_native_origin(profile, turn_key), agent)
+    try:
+        with native_origin_scope(handle):
+            result = agent.run_conversation(text, conversation_history=history, persist_user_message=text)
+        assert not result.get("failed"), result
+        assert result.get("final_response") == "Synthetic answer.", result
+        return result
+    finally:
+        complete_primary(handle)
+
+
+def test_real_agent_scene_is_wire_only_and_does_not_replay_from_sqlite(real_scene_agent):
+    from hermes_state import SessionDB
+
+    make_agent, db, db_path, wire, snapshots, profile = real_scene_agent
+    session_id = "scene-request-persistence"
+    first = make_agent(session_id)
+    first_text = "Continue discussing the synthetic observation."
+    with scene_request_context(first, SCENE_NOTE):
+        result = _run_turn(first, profile, "scene-first", first_text, [])
+
+    assert len(wire) == 1
+    marked_rows = [row for row in wire[0]["messages"] if _contains_scene(row)]
+    assert len(marked_rows) == 1 and marked_rows[0]["role"] == "user"
+    assert first_text in json.dumps(marked_rows[0])
+    assert not _contains_scene(result)
+    assert not _contains_scene(first._session_messages)
+    assert not _contains_scene(first._cached_system_prompt)
+    raw_rows = db.get_messages(session_id, include_inactive=True)
+    assert [row["role"] for row in raw_rows] == ["user", "assistant"]
+    assert raw_rows[0]["content"] == first_text
+    # get_messages includes the physical api_content sidecar, not just UI text.
+    assert all("api_content" in row for row in raw_rows)
+    assert not _contains_scene(raw_rows)
+    assert snapshots and not _contains_scene(snapshots)
+    snapshot_files = list((profile / "sessions").glob("session_*.json"))
+    assert snapshot_files
+    assert all(SCENE_MARKER not in path.read_text(encoding="utf-8") for path in snapshot_files)
+
+    # A separate connection reloads exactly what a restarted gateway can see.
+    reloaded_db = SessionDB(db_path=db_path)
+    try:
+        history = reloaded_db.get_messages_as_conversation(session_id)
+    finally:
+        reloaded_db.close()
+    assert len(history) == 2 and not _contains_scene(history)
+    original_history = deepcopy(history)
+    second = make_agent(session_id)
+    result2 = _run_turn(second, profile, "scene-second", "What about now?", history)
+    assert len(wire) == 2
+    assert not _contains_scene(wire[1])
+    assert first_text in json.dumps(wire[1]["messages"])
+    # The real DB flush may tag rows as already persisted; their durable
+    # content and sidecars must otherwise remain byte-for-byte unchanged.
+    assert [{key: value for key, value in row.items() if key != "_db_persisted"}
+            for row in history] == original_history
+    assert not _contains_scene(result2)
+    final_rows = db.get_messages(session_id, include_inactive=True)
+    assert [row["role"] for row in final_rows] == ["user", "assistant", "user", "assistant"]
+    assert not _contains_scene(final_rows)
+    assert not _contains_scene(db.get_messages_as_conversation(session_id))
+    assert not _contains_scene(snapshots)
+    assert all(SCENE_MARKER not in path.read_text(encoding="utf-8") for path in snapshot_files)
+
+
+def test_scene_scope_resets_after_exception_and_nested_other_agent():
+    agent, other = object(), object()
+    outer_note = "SYNTHETIC_OUTER_SCENE"
+    with scene_request_context(agent, outer_note):
+        with pytest.raises(RuntimeError, match="synthetic scope exit"):
+            with scene_request_context(other, SCENE_NOTE):
+                wrong_agent = {"role": "user", "content": "plain"}
+                append_scene_request_note(wrong_agent, agent)
+                assert wrong_agent["content"] == "plain"
+                active = {"role": "user", "content": "plain"}
+                append_scene_request_note(active, other)
+                assert _contains_scene(active)
+                raise RuntimeError("synthetic scope exit")
+        restored = {"role": "user", "content": "plain"}
+        append_scene_request_note(restored, agent)
+        assert outer_note in restored["content"] and not _contains_scene(restored)
+    for target in (agent, other):
+        cleared = {"role": "user", "content": "plain"}
+        append_scene_request_note(cleared, target)
+        assert cleared["content"] == "plain"
+
+
+@pytest.mark.parametrize("note", [None, "", "x" * 10001, {"text": SCENE_NOTE}])
+def test_scene_scope_rejects_unbounded_or_non_text_notes(note):
+    agent = object()
+    with scene_request_context(agent, note):
+        row = {"role": "user", "content": "plain"}
+        append_scene_request_note(row, agent)
+        assert row["content"] == "plain"
+
+
+def test_scene_api_copy_preserves_original_multimodal_blocks_and_non_user_rows():
+    agent = object()
+    content = [{"type": "text", "text": "plain"},
+               {"type": "image_url", "image_url": {"url": "data:image/png;base64,SYNTHETIC"}}]
+    original = deepcopy(content)
+    with scene_request_context(agent, SCENE_NOTE):
+        api_copy = {"role": "user", "content": content}
+        append_scene_request_note(api_copy, agent)
+        assert content == original
+        assert api_copy["content"][:-1] == original
+        assert api_copy["content"][-1] == {"type": "text", "text": SCENE_NOTE}
+        for role in ("system", "assistant", "tool"):
+            row = {"role": role, "content": "plain"}
+            append_scene_request_note(row, agent)
+            assert row["content"] == "plain"
