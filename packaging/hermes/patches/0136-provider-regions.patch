+
+def test_real_prompt_ingress_adds_note_but_persists_original_player_message(turn_env, emits, monkeypatch, tmp_path):
+    seen = []
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda *a, **kw: None)
+    def run(text, **kwargs):
