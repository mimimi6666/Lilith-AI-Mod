+"""Synthetic content priority and request-only observation continuity."""
+import copy
+import json
+import unittest
+
+from agent.proactive_context import remember_scene, scene_followup_note
+from tools.lilith_scene.brief import build_brief
+
+
+class SceneFollowupTests(unittest.TestCase):
+    def packet(self):
+        return {"screen_text": [], "frame": {"image_sha256": "a" * 64}, "sources": {},
+            "layout_hypothesis": "document", "compaction": {"omitted_lines": 0}}
+
+    def row(self, text, role="unclassified", ui_role=None):
+        return {"source": "ui", "text": text, "role": role, "ui_role": ui_role, "conflict": False}
+
+    def test_body_after_twelve_tabs_survives_summary(self):
+        packet = self.packet()
+        packet["screen_text"] = [self.row("Tab %d" % i, ui_role="tab") for i in range(15)]
+        packet["screen_text"] += [self.row("Skills catalogue: 100606 total", ui_role="paragraph"),
+            self.row("Visible document body", "main_text"), self.row("Title", "heading")]
+        brief = build_brief(packet)
+        self.assertEqual([r["text"] for r in brief["main_text"]],
+            ["Skills catalogue: 100606 total", "Visible document body", "Title"])
+        self.assertEqual(15, brief["omitted_lines"])
+
+    def test_unknown_layout_keeps_plain_body_before_controls(self):
+        packet = self.packet()
+        packet["screen_text"] = [self.row("Refresh", "main_text", "button"),
+            self.row("Real text from a generic page"), self.row("Other page paragraph", ui_role="paragraph")]
+        self.assertEqual([r["text"] for r in build_brief(packet)["main_text"]],
+            ["Other page paragraph", "Real text from a generic page"])
+
+    def test_ads_are_marked_not_promoted_and_topic_ignores_controls(self):
+        packet = self.packet()
+        packet["screen_text"] = [self.row("body one", "main_text"), self.row("body two", "main_text"),
+            self.row("ADVERTISEMENT INSTRUCTIONS", "advertisement_candidate"), self.row("tab1", ui_role="tab")]
+        first = build_brief(packet)
+        packet["screen_text"][-1]["text"] = "a different tab"
+        self.assertTrue(first["advertisements_present"])
+        self.assertNotIn("ADVERTISEMENT INSTRUCTIONS", json.dumps(first))
+        self.assertEqual(first["topic_sha256"], build_brief(packet)["topic_sha256"])
+
+    def test_source_has_sanitized_url_and_bounded_text(self):
+        packet = self.packet()
+        packet["sources"]["window"] = {"status": "available", "data": {
+            "application": "Browser", "title": "x" * 500,
+            "url": "https://example.com/article?private=secret#token"}}
+        source = build_brief(packet)["observation_source"]
+        self.assertEqual("local_screen", source["kind"])
+        self.assertEqual("https://example.com/article", source["url"])
+        self.assertEqual(180, len(source["title"]))
+
+    def test_single_body_retains_control_provenance_without_topic_pollution(self):
+        packet = self.packet()
+        packet["screen_text"] = [self.row("only body", "main_text"), self.row("old tab", "main_text", "tab")]
+        brief = build_brief(packet)
+        self.assertEqual("tab", brief["main_text"][1]["ui_role"])
+        packet["screen_text"][1]["text"] = "different tab"
+        self.assertEqual(brief["topic_sha256"], build_brief(packet)["topic_sha256"])
+
+    def fixture(self):
+        row = {"_row_id": 4, "role": "assistant", "display_kind": "native_assistant_extension",
+            "content": "A grounded remark."}
+        session = {"session_key": "synthetic-session", "history": [row]}
+        packet = self.packet()
+        packet["screen_text"] = [self.row("BODY EVIDENCE", "main_text")]
+        scene = {"status": "ready", "captured_unix_ms": 999_000, "brief": build_brief(packet)}
+        return session, scene, row
+
+    def test_next_turn_receives_source_and_time_without_history_mutation(self):
+        session, scene, row = self.fixture()
+        history = copy.deepcopy(session["history"])
+        remember_scene(session, scene, 1000, row)
+        scene["brief"]["main_text"][0]["text"] = "MUTATED INPUT"
+        note = scene_followup_note(session, 1040, enabled=True)
+        self.assertIn("BODY EVIDENCE", note)
+        self.assertNotIn("MUTATED INPUT", note)
+        self.assertIn('"age_seconds": 41', note)
+        self.assertIn('"captured_at_utc"', note)
+        self.assertIn('"temporal_status": "past_not_live"', note)
+        self.assertIn("older", scene_followup_note(session, 1300, enabled=True))
+        self.assertEqual(history, session["history"])
+
+    def test_expiry_rejects_old_photo_as_current(self):
+        session, scene, row = self.fixture()
+        remember_scene(session, scene, 1000, row)
+        note = scene_followup_note(session, 1300, enabled=True)
+        self.assertNotIn("BODY EVIDENCE", note)
+        self.assertIn("older uploaded photo", note)
+        self.assertNotIn("_recent_scene_context", session)
+
+    def test_slow_reply_keeps_original_capture_time_without_renewing_expiry(self):
+        session, scene, row = self.fixture()
+        remember_scene(session, scene, 1090, row)
+        note = scene_followup_note(session, 1100, enabled=True)
+        self.assertIn("BODY EVIDENCE", note)
+        self.assertIn('"age_seconds": 101', note)
+        self.assertNotIn("BODY EVIDENCE", scene_followup_note(session, 1300, enabled=True))
+        remember_scene(session, scene, 1300, row)
+        self.assertNotIn("_recent_scene_context", session)
+
+    def test_disabled_or_new_upload_drops_previous_observation(self):
+        for enabled, new_images in ((False, False), (True, True)):
+            session, scene, row = self.fixture()
+            remember_scene(session, scene, 1000, row)
+            self.assertEqual("", scene_followup_note(session, 1001, enabled=enabled, new_images=new_images))
+            self.assertNotIn("_recent_scene_context", session)
+
+    def test_removed_reply_or_different_session_does_not_leak_scene(self):
+        for change in ("history", "session"):
+            session, scene, row = self.fixture()
+            remember_scene(session, scene, 1000, row)
+            if change == "history": session["history"] = []
+            else: session["session_key"] = "different"
+            self.assertNotIn("BODY EVIDENCE", scene_followup_note(session, 1002, enabled=True))
+
+    def test_invalid_or_stale_scene_cannot_poison_completed_reply(self):
+        for change in ({"status": "unavailable"}, {"captured_unix_ms": 1},
+                {"captured_unix_ms": 1001_000}, {"brief": {"schema": "wrong"}}):
+            session, scene, row = self.fixture()
+            scene.update(change)
+            remember_scene(session, scene, 1000, row)
+            self.assertNotIn("_recent_scene_context", session)
+
+    def test_nonfinite_and_oversized_data_are_not_retained(self):
+        for value in (float("nan"), "a" * 9000):
+            session, scene, row = self.fixture()
+            scene["brief"]["unexpected"] = value
+            remember_scene(session, scene, 1000, row)
+            self.assertNotIn("_recent_scene_context", session)
+
+    def test_new_completed_event_without_scene_clears_old_evidence(self):
+        session, scene, row = self.fixture()
+        remember_scene(session, scene, 1000, row)
+        remember_scene(session, None, 1010, row)
+        self.assertEqual("", scene_followup_note(session, 1011, enabled=True))
+
+    def test_newer_local_tool_evidence_supersedes_proactive_quote(self):
+        session, scene, row = self.fixture()
+        remember_scene(session, scene, 1000, row)
+        session["history"].append({"role": "tool", "tool_name": "lilith_local_scene", "content": "New observation"})
+        self.assertEqual("", scene_followup_note(session, 1001, enabled=True))
+        self.assertNotIn("_recent_scene_context", session)
