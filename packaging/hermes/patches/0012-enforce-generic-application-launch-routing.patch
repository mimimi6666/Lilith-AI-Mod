new file mode 100644
index 0000000000000000000000000000000000000000..a8cdd409ad2a3e4c193187dc5bf69d803dee11c3
--- /dev/null
+++ b/tests/skills/test_computer_use_contract.py
@@ -0,0 +1,90 @@
+"""Coherence contracts for typed installed-GUI-application launch guidance."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+from agent.prompt_builder import computer_use_guidance
+from tools.computer_use.schema import COMPUTER_USE_SCHEMA
+from toolsets import TOOLSETS
+
+
+REPO = Path(__file__).resolve().parents[2]
+SKILL_PATH = REPO / "skills" / "autonomous-ai-agents" / "computer-use" / "SKILL.md"
+
+
+def _launch_skill_section() -> str:
+    content = SKILL_PATH.read_text(encoding="utf-8")
+    marker = "## Launching installed GUI applications"
+    section = content.split(marker, 1)[1]
+    return section.split("\n## ", 1)[0]
+
+
+def _launch_prompt_section() -> str:
+    content = computer_use_guidance("win32")
+    marker = "## Installed GUI application launch"
+    section = content.split(marker, 1)[1]
+    return section.split("\n## ", 1)[0]
+
+
+def test_prompt_skill_and_schema_share_the_typed_launch_contract():
+    prompt = _launch_prompt_section()
+    skill = _launch_skill_section()
+    properties = COMPUTER_USE_SCHEMA["parameters"]["properties"]
+    schema = " ".join(
+        (
+            properties["action"]["description"],
+            properties["app"]["description"],
+            properties["app_id"]["description"],
+        )
+    )
+
+    for source in (prompt, skill, schema):
+        normalized = " ".join(source.split())
+        assert "launch_app" in normalized
+        assert "exactly one" in normalized
+        assert "catalog" in normalized
+        assert "ambiguous" in normalized
+        assert "accepted_unverified" in normalized
+        assert "non-authoritative human-name hint" in normalized
+        assert (
+            "process exit or activation acceptance is not launch proof"
+            in normalized.lower()
+        )
+    for source in (prompt, skill):
+        normalized = " ".join(source.split())
+        assert "Do not silently substitute terminal execution" in normalized
+        assert "PID" in normalized
+        assert "top-level window" in normalized
+    assert "must not silently change to another execution route" in schema
+
+
+def test_launch_guidance_uses_only_generic_selector_placeholders():
+    content = SKILL_PATH.read_text(encoding="utf-8")
+    action_line = next(
+        line for line in content.splitlines() if line.startswith("launch_app")
+    )
+    sections = (_launch_prompt_section(), _launch_skill_section())
+
+    assert action_line == (
+        'launch_app       app="<exact registered name>" '
+        'OR app_id="<exact OS identifier>"'
+    )
+    for section in sections:
+        assert "://" not in section
+        assert ".exe" not in section.lower()
+        assert not re.search(r"(?:^|\s)(?:[A-Za-z]:\\|/[^\s`]+)", section)
+
+
+def test_short_descriptions_expose_launch_verification():
+    import tools.computer_use_tool  # noqa: F401
+    from tools.registry import registry
+
+    descriptions = (
+        TOOLSETS["computer_use"]["description"],
+        registry._tools["computer_use"].description,
+    )
+    for description in descriptions:
+        assert "registered GUI application launch" in description
+        assert "verified process/window outcome" in description
