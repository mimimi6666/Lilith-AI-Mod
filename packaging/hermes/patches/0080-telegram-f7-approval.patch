@@ -0,0 +1,255 @@
+"""Real native approval/lease/DB contracts; fixtures never execute effects."""
+import ast
+import contextvars
+import json
+import os
+from pathlib import Path
+import socket
+import sys
+from types import SimpleNamespace as NS
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+import hermes_constants as hc
+from agent import identity_policy, secret_scope
+from gateway.config import Platform, PlatformConfig
+from gateway.turn_context import TurnContext
+from gateway.turn_lease import SessionTurnLeaseRegistry
+from gateway.lilith_session_policy import shared_f7_turn_scope, native_tool_context
+from hermes_state import SessionDB
+from hermes_cli import config
+from plugins import lilith_messaging_bridge as bridge
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from tools import approval
+
+SOURCE = Path(os.environ.get("LILITH_TEST_SOURCE", Path(__file__).resolve().parents[2]))
+
+
+@pytest.fixture(autouse=True)
+def isolated(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_LILITH_BOUND_HOME", str(tmp_path))
+    monkeypatch.setattr(hc, "get_default_hermes_root", lambda: tmp_path / "root")
+    monkeypatch.setattr(hc, "get_hermes_home_override", lambda: None)
+    monkeypatch.setattr(secret_scope, "_MULTIPLEX_ACTIVE", False)
+    scope = secret_scope.set_secret_scope(None)
+    monkeypatch.setattr(identity_policy, "identity_lock_required_by_host", lambda: True)
+    original_connect = socket.socket.connect
+    def no_network(sock, address):
+        # Windows asyncio builds its internal wakeup socketpair over loopback.
+        # Permit that stdlib-only constructor, never application networking.
+        caller = sys._getframe(1)
+        if (caller.f_code.co_filename == socket.__file__
+                and "socketpair" in caller.f_code.co_name):
+            return original_connect(sock, address)
+        pytest.fail("Network forbidden")
+    monkeypatch.setattr(socket.socket, "connect", no_network)
+    monkeypatch.setattr("webbrowser.open", lambda *a, **k: pytest.fail("Browser forbidden"))
+    monkeypatch.setattr(approval, "_release_permission_mode_dependents", lambda _: None)
+    monkeypatch.setattr(approval, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setattr(approval, "_get_approval_mode", lambda: "manual")
+    monkeypatch.setattr(approval, "save_permanent_allowlist", lambda *_: pytest.fail("Unexpected config write"))
+    identity_policy._reset_native_authority_quarantine_for_tests()
+    yield
+    secret_scope.reset_secret_scope(scope)
+    identity_policy._reset_native_authority_quarantine_for_tests()
+    approval._gateway_prepared_commit = None
+    approval._gateway_queues.clear()
+    approval._gateway_notify_cbs.clear()
+    approval._session_yolo.clear()
+
+
+async def make_turn(tmp_path):
+    (tmp_path / "runtime").mkdir(exist_ok=True)
+    (tmp_path / "runtime/game-session-v1.json").write_text(
+        json.dumps({"schemaVersion": 1, "storedSessionId": "game"}))
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("game", source="lilith-game", archived=True)
+    key = "agent:main:telegram:dm:42"
+    leases = SessionTurnLeaseRegistry()
+    token = await leases.acquire("game", owner_key=key, generation=7, timeout=1)
+    state = NS(turn=NS(lease_token=token, lease_generation=7))
+    pairing = NS(is_approved=lambda p, u: p == "telegram" and u == "42")
+    runner = NS(_session_db=NS(_db=db), _session_state=lambda k: state,
+                _turn_leases=leases, _is_user_authorized=lambda s: True,
+                _pairing_store_for=lambda s: pairing, _session_key_for_source=lambda s: key)
+    ctx = TurnContext(source=NS(platform=Platform.TELEGRAM, chat_type="dm", user_id="42", chat_id="42"),
+                      session_id="game", session_key=key, run_generation=7,
+                      _run_still_current=lambda: True, lilith_shared_session_id="game")
+    return runner, ctx, token, db, state
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("message_type", ["text", "voice"])
+async def test_paired_admitted_text_and_voice_use_native_scope_only(tmp_path, message_type):
+    runner, ctx, token, db, _ = await make_turn(tmp_path)
+    event = NS(source=ctx.source, internal=False, text="" if message_type == "voice" else "next",
+               message_type=message_type, media_urls=["fixture.ogg"] if message_type == "voice" else [])
+    bridge._pre_gateway_dispatch(event=event, gateway=runner)
+    ctx.lilith_shared_session_id = event._lilith_shared_session_id
+    context_token = approval.set_current_session_key(ctx.session_key)
+    try:
+        assert not approval.is_current_session_yolo_enabled()
+        with shared_f7_turn_scope(runner, ctx):
+            assert approval.is_current_session_yolo_enabled()
+            assert approval.is_approval_bypass_active()
+            assert not approval.is_session_yolo_enabled("other")
+            assert approval._get_approval_mode() == "manual"
+            assert not approval._session_yolo
+            copied = contextvars.copy_context()
+        assert not approval.is_current_session_yolo_enabled()
+        assert not copied.run(approval.is_current_session_yolo_enabled)
+    finally:
+        approval.reset_current_session_key(context_token)
+        runner._turn_leases.release(token)
+        db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("case", ["unpaired", "unauthorized", "group", "other-user", "unbound",
+                                  "other-session", "stale", "unmanaged", "revoked-lease",
+                                  "wrong-generation", "wrong-owner", "not-hidden", "rebound"])
+async def test_no_scope_for_untrusted_or_stale_admission(tmp_path, monkeypatch, case):
+    runner, ctx, token, db, state = await make_turn(tmp_path)
+    try:
+        if case == "unpaired": runner._pairing_store_for = lambda s: NS(is_approved=lambda *a: False)
+        if case == "unauthorized": runner._is_user_authorized = lambda s: False
+        if case == "group": ctx.source.chat_type = "group"
+        if case == "other-user": ctx.source.user_id = "43"
+        if case == "unbound": ctx.lilith_shared_session_id = None
+        if case == "other-session": ctx.session_id = "other"
+        if case == "stale": ctx._run_still_current = lambda: False
+        if case == "unmanaged": monkeypatch.setattr(identity_policy, "identity_lock_required_by_host", lambda: False)
+        if case == "revoked-lease": runner._turn_leases.release(token)
+        if case == "wrong-generation": state.turn.lease_generation = 6
+        if case == "wrong-owner": token.owner_key = "different"
+        if case == "not-hidden": runner._session_db = NS(get_session=lambda _: {"source":"telegram", "archived":1})
+        if case == "rebound": (tmp_path / "runtime/game-session-v1.json").write_text('{"schemaVersion":1,"storedSessionId":"other"}')
+        with shared_f7_turn_scope(runner, ctx):
+            assert not approval.is_session_yolo_enabled(ctx.session_key)
+    finally:
+        runner._turn_leases.release(token)
+        db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("revoke", ["pairing", "stop", "native-off", "lease", "exception"])
+async def test_scope_revokes_in_flight_and_on_exception(tmp_path, revoke):
+    runner, ctx, token, db, _ = await make_turn(tmp_path)
+    try:
+        try:
+            with shared_f7_turn_scope(runner, ctx):
+                assert approval.is_session_yolo_enabled(ctx.session_key)
+                if revoke == "pairing": runner._pairing_store_for = lambda s: NS(is_approved=lambda *a: False)
+                if revoke == "stop": ctx._run_still_current = lambda: False
+                if revoke == "native-off": approval.disable_session_yolo(ctx.session_key)
+                if revoke == "lease": runner._turn_leases.release(token)
+                if revoke == "exception": raise RuntimeError("fixture")
+                assert not approval.is_session_yolo_enabled(ctx.session_key)
+        except RuntimeError:
+            assert revoke == "exception"
+        assert not approval.is_session_yolo_enabled(ctx.session_key)
+    finally:
+        runner._turn_leases.release(token)
+        db.close()
+
+
+def test_count_only_always_rejects_before_prepare(monkeypatch):
+    monkeypatch.setattr(approval, "resolve_gateway_approval_with_persistence",
+                        lambda *a, **k: pytest.fail("Must not prepare"))
+    with pytest.raises(approval.NativeApprovalPersistenceUnavailable):
+        approval.resolve_gateway_approval("fixture", "always")
+
+
+@pytest.mark.parametrize("choice,strict", [("once", True), ("session", True), ("deny", True), ("always", False)])
+def test_supported_count_only_responses_unchanged(monkeypatch, choice, strict):
+    monkeypatch.setattr(identity_policy, "identity_lock_required_by_host", lambda: strict)
+    monkeypatch.setattr(approval, "resolve_gateway_approval_with_persistence", lambda *a, **k: (1, None))
+    assert approval.resolve_gateway_approval("fixture", choice) == 1
+
+
+def test_commit_failure_is_technical_not_user_denial(monkeypatch):
+    monkeypatch.setattr(approval, "_is_gateway_approval_context", lambda: True)
+    monkeypatch.setattr(approval, "_is_interactive_cli", lambda: False)
+    monkeypatch.setattr(approval, "is_approved", lambda *a: False)
+    monkeypatch.setattr(approval, "get_current_session_key", lambda *a, **k: "fixture")
+    approval._gateway_notify_cbs["fixture"] = lambda _: None
+    monkeypatch.setattr(approval, "_await_gateway_decision", lambda *a, **k: {
+        "resolved":True, "choice":"deny", "failure":"native_approval_commit_failed"})
+    result = approval.request_tool_approval("fixture", "test only")
+    assert not result["approved"] and result["user_consent"] is True
+    assert result["outcome"] == "native_approval_commit_failed"
+    assert "NOT a user denial" in result["message"]
+
+
+def test_native_scope_never_bypasses_hardline(monkeypatch):
+    monkeypatch.setattr(identity_policy, "identity_lock_required_by_host", lambda: False)
+    monkeypatch.setattr(approval, "get_current_session_key", lambda *a, **k: "fixture")
+    with approval.session_yolo_scope("fixture", is_current=lambda: True):
+        result = approval.check_all_command_guards("rm -rf /", "local")
+    assert result["approved"] is False and result["hardline"] is True
+
+
+@pytest.mark.asyncio
+async def test_strict_telegram_offers_only_choices_it_can_complete(monkeypatch):
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fixture"))
+    adapter._bot = AsyncMock()
+    adapter._bot.send_message.return_value = NS(message_id=1)
+    buttons = []
+    monkeypatch.setattr("plugins.platforms.telegram.adapter.InlineKeyboardButton",
+                        lambda text, callback_data: buttons.append(callback_data) or text)
+    monkeypatch.setattr("plugins.platforms.telegram.adapter.InlineKeyboardMarkup", lambda rows: rows)
+    result = await adapter.send_exec_approval("42", "fixture", "fixture")
+    assert result.success
+    assert {b.split(":")[1] for b in buttons} == {"once", "session", "deny"}
+
+
+def test_native_hint_uses_only_actual_schemas_and_no_app_keyword_routing():
+    note = native_tool_context([{"type":"function", "function":{"name":"fixture_native_control"}}])
+    assert "fixture_native_control" in note
+    assert "spotify" not in note.lower()
+    assert "not permission" in note and "do not switch routes" in note
+    assert native_tool_context([]) == ""
+
+
+@pytest.mark.asyncio
+async def test_stale_telegram_always_button_keeps_request_without_false_success(monkeypatch):
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fixture"))
+    adapter._bot = AsyncMock()
+    adapter._approval_state[1] = "fixture-session"
+    monkeypatch.setattr(adapter, "_is_callback_user_authorized", lambda *a, **k: True)
+    query = NS(data="ea:always:1", from_user=NS(id=42, first_name="Fixture"),
+               message=NS(chat=NS(id=42, type="private"), message_thread_id=None),
+               answer=AsyncMock(), edit_message_text=AsyncMock())
+    await adapter._handle_callback_query(NS(callback_query=query), None)
+    assert adapter._approval_state[1] == "fixture-session"
+    assert "No settings changed" in query.answer.call_args.kwargs["text"]
+    query.edit_message_text.assert_not_called()
+
+
+@pytest.mark.parametrize("choice", ["once", "session", "deny"])
+def test_count_api_releases_one_pending_entry_and_preserves_other_requests(choice):
+    entry = approval._ApprovalEntry({"pattern_key":"fixture", "pattern_keys":["fixture"],
+                                    "allow_session": True, "allow_permanent":True})
+    second = approval._ApprovalEntry({"pattern_key":"other", "pattern_keys":["other"]})
+    entry.notified = True
+    second.notified = True
+    approval._gateway_queues["fixture"] = [entry, second]
+    assert approval.resolve_gateway_approval("fixture", choice) == 1
+    assert entry.event.is_set() and entry.result == choice
+    assert not second.event.is_set()
+
+
+def test_strict_scope_cannot_bypass_identity_target_block(monkeypatch):
+    monkeypatch.setattr(approval, "get_current_session_key", lambda *a, **k: "fixture")
+    with approval.session_yolo_scope("fixture", is_current=lambda: True):
+        result = approval.check_all_command_guards("rm -rf /", "local")
+    assert not result["approved"]
+    assert "identity" in str(result).lower()
+
+
+def test_binding_reaches_worker_context():
+    tree = ast.parse((SOURCE / "gateway/run.py").read_text(encoding="utf-8"))
+    contexts = [n for n in ast.walk(tree) if isinstance(n, ast.Call)
+                and isinstance(n.func, ast.Name) and n.func.id == "TurnContext"]
+    assert any(any(k.arg == "lilith_shared_session_id" for k in n.keywords) for n in contexts)
