@@ -0,0 +1,100 @@
+"""Turn-local projection of Lilith's existing hidden F7 session policy.
+
+No global setting, persistent allowlist, pairing, or tool selection is written.
+Only a real paired private sender, an exact hidden game lineage and a current
+leased turn can inherit F7's native session bypass. All native hardline and
+identity guards remain in their original execution path.
+"""
+import contextlib
+import hashlib
+import json
+import logging
+import re
+
+from gateway.config import Platform
+
+logger = logging.getLogger(__name__)
+
+
+def shared_f7_turn_is_current(runner, ctx):
+    from agent.identity_policy import identity_lock_required_by_host
+    from plugins.lilith_messaging_bridge import _read_active_game_session_id
+
+    source = ctx.source
+    shared = getattr(ctx, "lilith_shared_session_id", None)
+    if not (identity_lock_required_by_host()
+            and type(shared) is str and shared and shared == ctx.session_id
+            and source.platform == Platform.TELEGRAM
+            and source.chat_type == "dm"
+            and type(source.user_id) is str and source.user_id
+            and source.chat_id == source.user_id
+            and ctx.run_generation is not None and ctx.session_key
+            and ctx._run_still_current() is True
+            and runner._session_key_for_source(source) == ctx.session_key
+            and runner._is_user_authorized(source) is True):
+        return False
+    pairing = runner._pairing_store_for(source)
+    if pairing is None or pairing.is_approved("telegram", source.user_id) is not True:
+        return False
+    if _read_active_game_session_id() != shared:
+        return False
+    # A durable id alone is not permission: verify the hidden game record AND
+    # the profile-global lease owned by this exact admission/generation.
+    db = getattr(runner._session_db, "_db", runner._session_db)
+    record = db.get_session(shared)
+    if not (isinstance(record, dict) and record.get("source") == "lilith-game"
+            and type(record.get("archived")) in (bool, int) and record["archived"] == 1):
+        return False
+    state = runner._session_state(ctx.session_key).turn
+    token = state.lease_token
+    registered = runner._turn_leases._leases.get(shared)
+    return (token is not None and state.lease_generation == ctx.run_generation
+            and token.session_id == shared and token.owner_key == ctx.session_key
+            and token.generation == ctx.run_generation and token.released is False
+            and token.profile_lease is not None and token.profile_lease.released is False
+            and registered is not None and registered.holder is token)
+
+
+@contextlib.contextmanager
+def shared_f7_turn_scope(runner, ctx):
+    from tools.approval import session_yolo_scope
+
+    def current():
+        try:
+            return shared_f7_turn_is_current(runner, ctx)
+        except Exception:
+            return False
+
+    admitted = current()
+    if getattr(ctx, "lilith_shared_session_id", None):
+        logger.info("Lilith shared ingress: paired_f7_session_approval=%s", admitted)
+    if not admitted:
+        yield
+        return
+    with session_yolo_scope(ctx.session_key, is_current=current):
+        yield
+
+
+def native_tool_context(definitions):
+    """Describe actual current native schemas, not claims in old chat history."""
+    names = []
+    for definition in definitions or []:
+        function = definition.get("function", {}) if isinstance(definition, dict) else {}
+        name = function.get("name") if isinstance(function, dict) else None
+        if isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", name):
+            names.append(name)
+    names = sorted(set(names))
+    if not names or len(names) > 512:
+        return ""
+    encoded = json.dumps(names, separators=(",", ":")).encode()
+    logger.info("Lilith native schemas: count=%d sha256=%s names=%s",
+                len(names), hashlib.sha256(encoded).hexdigest(), ",".join(names))
+    return (
+        "[Current native tool availability; describes capability, not permission]\n"
+        "Available in this turn: " + ", ".join(names) + ".\n"
+        "For the user's requested action, prefer a directly applicable native "
+        "integration over shell commands or desktop clicking. Old messages about "
+        "unavailable tools are not current capability evidence. Inspect native "
+        "tool results and report the actual outcome. If permission is denied or "
+        "identity is quarantined, stop; do not switch routes to bypass that decision."
+    )
