+def test_foreground_proactive_is_one_assistant_reply_without_user_row(
+    extension_session,
+):
+    db, session, agent, emitted = extension_session
+
+    response = _foreground()
+    assert "error" not in response
+    assert response["result"]["status"] == "streaming"
+    assert response["result"]["already_processed"] is False
+
+    _join(session)
+
+    assert agent.calls == 1
+    sent = agent.requests[0]["messages"]
+    canonical = json.dumps(
+        _foreground_params()["perception"],
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    assert canonical in sent[0]["content"]
+    assert "not a player or user message" in sent[0]["content"]
+    assert "Never claim to see the screen" in sent[0]["content"]
+    assert "game result" in sent[0]["content"]
+    assert sent[-1]["role"] == "user"
+    assert "foreground observation is not a player message" in sent[-1]["content"]
+
+    rows = db._conn.execute(
+        "SELECT role, display_kind, display_metadata FROM messages ORDER BY id"
+    ).fetchall()
+    assert [row["role"] for row in rows] == ["assistant", "assistant"]
+    assert rows[-1]["display_kind"] == "foreground_proactive_reply"
+    metadata = json.loads(rows[-1]["display_metadata"])
+    assert metadata["lilith_foreground_proactive_operation_id"] == FOREGROUND_ID
+    assert metadata["hermes_turn_origin_kind"] == "lilith-foreground-proactive"
+
+    completed = [
+        payload
+        for event, sid, payload in emitted
+        if event == "message.complete" and sid == "game-live"
+    ]
+    assert len(completed) == 1
+    assert completed[0]["foreground_proactive_status"] == "completed"
+    assert completed[0]["durable"]["conversation_activity"] is True
+    assert "native_assistant_extension_status" not in completed[0]
+
+    replay = _foreground()
+    assert replay["result"]["status"] == "completed"
+    assert replay["result"]["already_processed"] is True
+    assert agent.calls == 1
+
+
+def test_foreground_proactive_rejects_window_content_fields(extension_session):
+    db, _, agent, _ = extension_session
+    value = _foreground_params()
+    value["perception"]["window_title"] = "private-document.txt"
+
+    response = _foreground(value)
+
+    assert response["error"]["code"] == 4004
+    assert response["error"]["data"]["code"] == "foreground_proactive_invalid"
+    assert db._conn.execute(
+        "SELECT COUNT(*) FROM native_assistant_extensions"
+    ).fetchone()[0] == 0
+    assert agent.calls == 0
