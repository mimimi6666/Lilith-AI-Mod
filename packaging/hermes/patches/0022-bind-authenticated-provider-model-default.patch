+class AuthenticatedModelPairError(RuntimeError):
+    """A provider/model pair could not be proven from authenticated inventory.
+
+    ``code`` is intentionally stable so non-Python clients can distinguish a
+    required model selection from an agent-construction failure. Provider and
+    model are identifiers already exposed by the picker; credentials never
+    cross this boundary.
+    """
+
+    code = "model_selection_required"
+
+    def __init__(self, *, provider: str = "", model: str = "") -> None:
+        super().__init__("Select an authenticated provider and compatible model.")
+        self.provider = str(provider or "").strip()
+        self.model = str(model or "").strip()
+
+
+def _authenticated_pair_rows(rows: list[dict]) -> list[tuple[str, list[str], dict]]:
+    """Normalize rows that can prove an executable provider/model pair."""
+    normalized: list[tuple[str, list[str], dict]] = []
+    for row in rows:
+        # This function consumes an attested picker projection. Missing/None is
+        # not evidence; callers must first apply picker hints or supply an
+        # explicit authenticated=True row.
+        if not isinstance(row, dict) or row.get("authenticated") is not True:
+            continue
+        slug = str(row.get("slug") or "").strip()
+        raw_models = row.get("models")
+        if not slug or not isinstance(raw_models, (list, tuple)):
+            continue
+        models: list[str] = []
+        for item in raw_models:
+            model = item if isinstance(item, str) else ""
+            if model and model not in models:
+                models.append(model)
+        if models:
+            normalized.append((slug, models, row))
+    return normalized
+
+
+def _provider_row_default(slug: str, models: list[str]) -> str:
+    """Return a provider-specific catalog default that the row actually serves.
+
+    A provider helper is authoritative only when its result belongs to the
+    authenticated row. Unknown/custom providers have no generic helper default;
+    a one-model row is still deterministic, while a multi-model row requires a
+    user selection. This never borrows a global silent default from a different
+    provider.
+    """
+    try:
+        from hermes_cli.models import get_default_model_for_provider
+
+        default = str(get_default_model_for_provider(slug.casefold()) or "").strip()
+    except Exception:
+        default = ""
+    if default and default in models:
+        return default
+    return models[0] if len(models) == 1 else ""
+
+
+def select_authenticated_model_pair(
+    rows: list[dict],
+    ctx: ConfigContext,
+    *,
+    requested_provider: Optional[str] = None,
+    requested_model: Optional[str] = None,
+) -> tuple[str, str]:
+    """Select one exact authenticated provider/model pair, or ``("", "")``.
+
+    ``None`` means "use the configured value" while ``""`` is an explicit
+    absence. This distinction lets a provider-only launch request choose that
+    provider's own default instead of inheriting a stale model configured for a
+    different provider.
+
+    Resolution is deliberately conservative:
+
+    * a full pair must be present verbatim in one authenticated row;
+    * a provider-only request uses its provider-specific default helper, and
+      accepts a sole advertised model when the provider has no helper default;
+    * a model-only request must occur under exactly one authenticated provider;
+    * an implicit choice requires exactly one non-virtual authenticated row.
+
+    Virtual routing modes remain selectable when explicitly configured, but do
+    not compete with real credential providers for an implicit default.
+    """
+    provider = str(
+        ctx.current_provider if requested_provider is None else requested_provider
+    ).strip()
+    model = str(ctx.current_model if requested_model is None else requested_model).strip()
+    candidates = _authenticated_pair_rows(rows)
+
+    if provider and model:
+        key = provider.casefold()
+        matches = [entry for entry in candidates if entry[0].casefold() == key]
+        if len(matches) != 1 or model not in matches[0][1]:
+            return "", ""
+        return matches[0][0], model
+
+    if provider:
+        key = provider.casefold()
+        matches = [entry for entry in candidates if entry[0].casefold() == key]
+        if len(matches) != 1:
+            return "", ""
+        selected = _provider_row_default(matches[0][0], matches[0][1])
+        return (matches[0][0], selected) if selected else ("", "")
+
+    if model:
+        matches = [entry for entry in candidates if model in entry[1]]
+        slugs = {entry[0].casefold() for entry in matches}
+        if len(matches) != 1 or len(slugs) != 1:
+            return "", ""
+        return matches[0][0], model
+
+    real_candidates = [
+        entry
+        for entry in candidates
+        if str(entry[2].get("source") or "").strip().casefold() != "virtual"
+    ]
+    if len(real_candidates) != 1:
+        return "", ""
+    slug, models, _row = real_candidates[0]
+    selected = _provider_row_default(slug, models)
+    return (slug, selected) if selected else ("", "")
+
+
+def require_authenticated_model_pair(
+    rows: list[dict],
+    ctx: ConfigContext,
+    *,
+    requested_provider: Optional[str] = None,
+    requested_model: Optional[str] = None,
+) -> tuple[str, str]:
+    """Return a proven pair or raise the typed selection-required error."""
+    pair = select_authenticated_model_pair(
+        rows,
+        ctx,
+        requested_provider=requested_provider,
+        requested_model=requested_model,
+    )
+    if pair[0] and pair[1]:
+        return pair
+    raise AuthenticatedModelPairError(
+        provider=(
+            ctx.current_provider
+            if requested_provider is None
+            else requested_provider
+        ),
+        model=ctx.current_model if requested_model is None else requested_model,
+    )
+
+
