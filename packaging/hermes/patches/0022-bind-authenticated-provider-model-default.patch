--- /dev/null
+++ b/tests/tui_gateway/test_authenticated_model_pairing.py
@@ -0,0 +1,151 @@
+"""Authenticated provider/model binding at the desktop gateway boundary."""
+
+from __future__ import annotations
+
+import pytest
+
+import tui_gateway.server as server
+from hermes_cli.inventory import ConfigContext
+
+
+def _row(slug: str, *models: str) -> dict:
+    return {
+        "slug": slug,
+        "name": slug,
+        "models": list(models),
+        "total_models": len(models),
+        "is_current": False,
+        "is_user_defined": False,
+        "source": "built-in",
+        "authenticated": True,
+    }
+
+
+def _install_inventory(monkeypatch, *, rows: list[dict], configured: set[str]) -> None:
+    ctx = ConfigContext(
+        current_provider="",
+        current_model="",
+        current_base_url="",
+        user_providers={},
+        custom_providers=[],
+    )
+    monkeypatch.setattr("hermes_cli.inventory.load_picker_context", lambda: ctx)
+    monkeypatch.setattr(
+        "hermes_cli.model_switch.list_authenticated_providers",
+        lambda **_kwargs: [dict(row) for row in rows],
+    )
+    monkeypatch.setattr(
+        "hermes_cli.auth.is_provider_explicitly_configured",
+        lambda slug: slug in configured,
+    )
+    monkeypatch.setattr(
+        "hermes_cli.models.get_default_model_for_provider",
+        lambda slug: f"{slug}-default",
+    )
+    monkeypatch.setattr("hermes_cli.inventory._apply_pricing", lambda *_a, **_k: None)
+    monkeypatch.setattr("hermes_cli.inventory._apply_capabilities", lambda *_a, **_k: None)
+    monkeypatch.setattr("hermes_cli.inventory._apply_featured", lambda *_a, **_k: None)
+
+
+def test_sessionless_options_emit_one_provider_specific_exact_pair(monkeypatch):
+    _install_inventory(
+        monkeypatch,
+        rows=[
+            _row("provider-a", "provider-a-default", "provider-a-other"),
+            _row("ambient-provider", "ambient-provider-default"),
+        ],
+        configured={"provider-a"},
+    )
+    monkeypatch.setattr(
+        server,
+        "_resolve_model",
+        lambda: pytest.fail("a global silent model must not enter model.options"),
+    )
+
+    response = server._methods["model.options"](
+        "options-pair",
+        {"session_id": "", "explicit_only": True},
+    )
+
+    assert response["result"]["provider"] == "provider-a"
+    assert response["result"]["model"] == "provider-a-default"
+    assert [row["slug"] for row in response["result"]["providers"]] == [
+        "provider-a"
+    ]
+
+
+def test_session_create_resolves_unique_provider_default_before_build(
+    monkeypatch, tmp_path
+):
+    """Exercise the real preflight resolver, not its session-create seam."""
+    _install_inventory(
+        monkeypatch,
+        rows=[
+            _row("provider-a", "provider-a-default", "provider-a-other"),
+            _row("ambient-provider", "ambient-provider-default"),
+        ],
+        configured={"provider-a"},
+    )
+    scheduled: list[str] = []
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(server, "_completion_cwd", lambda _params: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda _session: None)
+    monkeypatch.setattr(server, "_schedule_agent_build", scheduled.append)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(
+        server,
+        "_resolve_model",
+        lambda: pytest.fail("session.create must not use a global silent model"),
+    )
+    before = set(server._sessions)
+
+    response = server._methods["session.create"]("create-pair", {"cols": 80})
+    sid = response["result"]["session_id"]
+    try:
+        assert set(server._sessions) == before | {sid}
+        assert server._sessions[sid]["model_override"] == {
+            "model": "provider-a-default",
+            "provider": "provider-a",
+        }
+        assert response["result"]["info"]["model"] == "provider-a-default"
+        assert response["result"]["info"]["provider"] == "provider-a"
+        assert scheduled == [sid]
+    finally:
+        server._sessions.pop(sid, None)
+
+
+@pytest.mark.parametrize(
+    ("params", "rows"),
+    [
+        (
+            {},
+            [
+                _row("provider-a", "provider-a-default"),
+                _row("provider-b", "provider-b-default"),
+            ],
+        ),
+        (
+            {"provider": "provider-a", "model": "unknown-model"},
+            [_row("provider-a", "provider-a-default")],
+        ),
+    ],
+)
+def test_session_create_requires_selection_before_allocating_or_building(
+    monkeypatch, params, rows
+):
+    configured = {str(row["slug"]) for row in rows}
+    _install_inventory(monkeypatch, rows=rows, configured=configured)
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(
+        server,
+        "_schedule_agent_build",
+        lambda _sid: pytest.fail("an unresolved pair must not schedule a build"),
+    )
+    before = set(server._sessions)
+
+    response = server._methods["session.create"]("selection-required", params)
+
+    assert response["error"]["code"] == 4091
+    assert response["error"]["message"] == "model selection required"
+    assert response["error"]["data"]["type"] == "model_selection_required"
+    assert set(server._sessions) == before
