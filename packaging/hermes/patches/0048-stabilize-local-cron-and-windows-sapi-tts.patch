+def _resolve_sapi_powershell(system_name: Optional[str] = None) -> Optional[str]:
+    """Resolve the trusted in-box Windows PowerShell used by SAPI.
+
+    The Runtime workspace and inherited ``PATH`` are writable/user-controlled,
+    so executable discovery must not search either location.  Ask Windows for
+    its system directory, then admit only the ordinary, non-reparse in-box
+    executable at the canonical Windows PowerShell location.
+    """
+    if (system_name or platform.system()).strip().lower() != "windows":
+        return None
+
+    try:
+        import ctypes
+        from ctypes import wintypes
+
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        get_system_directory = kernel32.GetSystemDirectoryW
+        get_system_directory.argtypes = [wintypes.LPWSTR, wintypes.UINT]
+        get_system_directory.restype = wintypes.UINT
+
+        buffer = ctypes.create_unicode_buffer(32768)
+        length = get_system_directory(buffer, len(buffer))
+        if length == 0 or length >= len(buffer):
+            return None
+
+        system_directory = Path(buffer.value)
+        candidate = (
+            system_directory
+            / "WindowsPowerShell"
+            / "v1.0"
+            / "powershell.exe"
+        )
+        if not system_directory.is_absolute() or not candidate.is_absolute():
+            return None
+
+        resolved_system_directory = system_directory.resolve(strict=True)
+        resolved_candidate = candidate.resolve(strict=True)
+        normalize = lambda value: os.path.normcase(os.path.normpath(str(value)))
+        if normalize(resolved_system_directory) != normalize(system_directory):
+            return None
+        if normalize(resolved_candidate) != normalize(candidate):
+            return None
+
+        reparse_flag = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)
+        for path in (
+            system_directory,
+            system_directory / "WindowsPowerShell",
+            system_directory / "WindowsPowerShell" / "v1.0",
+        ):
+            path_stat = path.lstat()
+            if not stat.S_ISDIR(path_stat.st_mode):
+                return None
+            if getattr(path_stat, "st_file_attributes", 0) & reparse_flag:
+                return None
+
+        candidate_stat = candidate.lstat()
+        if not stat.S_ISREG(candidate_stat.st_mode):
+            return None
+        if getattr(candidate_stat, "st_file_attributes", 0) & reparse_flag:
+            return None
+        return str(resolved_candidate)
+    except (AttributeError, OSError, RuntimeError, ValueError):
+        return None
+
+
+def _sapi_rate_from_speed(speed: Any) -> int:
+    """Map Hermes' 0.25..4.0 multiplier to SAPI's bounded -10..10 rate."""
+    try:
+        multiplier = float(speed)
+    except (TypeError, ValueError):
+        multiplier = 1.0
+    return max(-10, min(10, round((multiplier - 1.0) * 5.0)))
+
+
+def _sapi_wav_output_path(path: Path) -> Path:
+    """Return the exact truthful output path for the native WAV provider."""
+    return path if path.suffix.lower() == ".wav" else path.with_suffix(".wav")
+
+
+def _generate_sapi_tts(
+    text: str,
+    output_path: str,
+    tts_config: Dict[str, Any],
+) -> str:
+    """Synthesize through Windows SAPI using only fixed PowerShell code.
+
+    User text is written to a temporary UTF-8 file. The PowerShell command is
+    a module constant and receives only file paths plus optional voice/rate
+    settings through its process environment, so speech text can never become
+    executable PowerShell syntax.
+    """
+    powershell = _resolve_sapi_powershell()
+    if not powershell:
+        raise FileNotFoundError("Windows PowerShell with System.Speech is unavailable")
+
+    output = _sapi_wav_output_path(Path(output_path))
+    output.parent.mkdir(parents=True, exist_ok=True)
+    input_path = ""
+    scratch_path = ""
+
+    try:
+        handle, scratch_path = tempfile.mkstemp(
+            prefix=f".{output.stem}.sapi-",
+            suffix=".wav",
+            dir=str(output.parent),
+        )
+        os.close(handle)
+        os.unlink(scratch_path)
+        with tempfile.NamedTemporaryFile(
+            mode="w",
+            encoding="utf-8",
+            prefix="hermes-sapi-",
+            suffix=".txt",
+            delete=False,
+        ) as input_file:
+            input_file.write(text)
+            input_path = input_file.name
+
+        sapi_config = tts_config.get("sapi") or {} if isinstance(tts_config, dict) else {}
+        speed = sapi_config.get("speed", tts_config.get("speed", 1.0))
+        child_env = os.environ.copy()
+        child_env.update(
+            {
+                "HERMES_SAPI_INPUT_PATH": input_path,
+                "HERMES_SAPI_OUTPUT_PATH": scratch_path,
+                "HERMES_SAPI_VOICE": str(sapi_config.get("voice") or ""),
+                "HERMES_SAPI_RATE": str(_sapi_rate_from_speed(speed)),
+            }
+        )
+        result = subprocess.run(
+            [
+                powershell,
+                "-NoLogo",
+                "-NoProfile",
+                "-NonInteractive",
+                "-ExecutionPolicy",
+                "Bypass",
+                "-Command",
+                SAPI_POWERSHELL_SCRIPT,
+            ],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=90,
+            stdin=subprocess.DEVNULL,
+            env=child_env,
+            creationflags=windows_hide_flags(),
+        )
+        if result.returncode != 0:
+            detail = (result.stderr or result.stdout or "no PowerShell output").strip()
+            raise RuntimeError(f"Windows SAPI synthesis failed: {detail[:400]}")
+        if not os.path.isfile(scratch_path) or os.path.getsize(scratch_path) <= 0:
+            raise RuntimeError("Windows SAPI produced no WAV output")
+
+        # SAPI natively emits WAV.  Keep that truthful local format instead of
+        # discovering and executing an ffmpeg binary from the writable Runtime
+        # workspace or inherited PATH.  Platform-specific voice conversion, if
+        # explicitly requested elsewhere, remains owned by the bounded delivery
+        # layer rather than this default Windows provider.
+        os.replace(scratch_path, output)
+        scratch_path = ""
+        return str(output)
+    finally:
+        if input_path:
+            try:
+                os.unlink(input_path)
+            except OSError:
+                pass
+        if scratch_path:
+            try:
+                os.unlink(scratch_path)
+            except OSError:
+                pass
+
