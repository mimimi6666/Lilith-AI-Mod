+
+        started = threading.Event()
+        release = threading.Event()
+        exited = threading.Event()
+        resolve_calls = []
+
+        class _StuckProvider:
+            name = "stuck-test"
+
+            def start(self, _stop_event, *, interval):
+                assert interval == 5
+                started.set()
+                release.wait(5)
+                exited.set()
+
+            def stop(self):
+                return None
+
+        def _resolve():
