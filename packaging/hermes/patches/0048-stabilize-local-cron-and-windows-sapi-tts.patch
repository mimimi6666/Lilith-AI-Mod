+# Local Workbench cron completions cross a trust boundary: the cron agent's
+# output is untrusted model/tool text, while the receiving chat owns real user
+# authority.  Keep the queued shape explicit and small so it can be projected
+# as display-only assistant content without ever becoming a synthetic prompt.
+CRON_COMPLETION_EVENT_TYPE = "cron_completion"
+CRON_COMPLETION_SCHEMA = "lilith.cron.completion.v1"
+CRON_COMPLETION_TITLE_CHARS = 120
+CRON_COMPLETION_BODY_CHARS = 2_000
+_CRON_COMPLETION_ROUTE_CHARS = 512
+_CRON_COMPLETION_ID_CHARS = 256
+_CRON_COMPLETION_TRUNCATED = "\n…[truncated]"
+
+
+@dataclass(frozen=True)
+class CronCompletionNotification:
+    """Validated, redacted presentation payload for one exact live chat."""
+
+    execution_id: str
+    job_id: str
+    title: str
+    body: str
+    success: bool
+    session_key: str
+    origin_ui_session_id: str
+
+    def as_event(self) -> dict:
+        return {
+            "type": CRON_COMPLETION_EVENT_TYPE,
+            "schema": CRON_COMPLETION_SCHEMA,
+            "session_id": self.execution_id,
+            "job_id": self.job_id,
+            "title": self.title,
+            "body": self.body,
+            "success": self.success,
+            "session_key": self.session_key,
+            "origin_ui_session_id": self.origin_ui_session_id,
+            "exact_ui_session_only": True,
+        }
+
+    def display_text(self) -> str:
+        status = "completed" if self.success else "failed"
+        heading = f'Scheduled job "{self.title}" {status}.'
+        return f"{heading}\n{self.body}" if self.body else heading
+
+
+def _bounded_cron_display_text(value: Any, *, limit: int, fallback: str) -> str:
+    """Return control-safe, force-redacted text with a deterministic bound."""
+
+    text = str(value or "").replace("\r\n", "\n").replace("\r", "\n")
+    # Preserve ordinary newlines/tabs for readable results, but neutralise the
+    # remaining C0 controls so terminal/UI escape payloads cannot survive.
+    text = "".join(
+        ch if ch in {"\n", "\t"} or ord(ch) >= 0x20 else " " for ch in text
+    ).strip()
+    text = redact_sensitive_text(
+        text,
+        force=True,
+        redact_url_credentials=True,
+    ).strip()
+    if not text:
+        text = fallback
+    if len(text) > limit:
+        keep = max(0, limit - len(_CRON_COMPLETION_TRUNCATED))
+        text = text[:keep].rstrip() + _CRON_COMPLETION_TRUNCATED
+    return text
+
+
+def _cron_route_id(value: Any, *, limit: int) -> str:
+    """Validate an opaque routing identity without truncating or rewriting it."""
+
+    if not isinstance(value, str):
+        return ""
+    value = value.strip()
+    if not value or len(value) > limit:
+        return ""
+    if any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value):
+        return ""
+    return value
+
+
+def build_cron_completion_notification(
+    *,
+    execution_id: Any,
+    job_id: Any,
+    job_name: Any,
+    success: Any,
+    result: Any,
+    session_key: Any,
+    origin_ui_session_id: Any,
+) -> "dict | None":
+    """Build the sole accepted queue shape for a local cron completion.
+
+    Raw ``job_name``/``result`` never enter the queue.  They are force-redacted
+    and bounded here, before any cross-thread/session handoff.  Routing values
+    are exact opaque identities: an oversized or malformed address is rejected
+    instead of truncated into a potentially different session.
+    """
+
+    execution = _cron_route_id(execution_id, limit=_CRON_COMPLETION_ID_CHARS)
+    job = _cron_route_id(job_id, limit=_CRON_COMPLETION_ID_CHARS)
+    session = _cron_route_id(session_key, limit=_CRON_COMPLETION_ROUTE_CHARS)
+    ui_session = _cron_route_id(
+        origin_ui_session_id,
+        limit=_CRON_COMPLETION_ROUTE_CHARS,
+    )
+    if not execution or not job or not session or not ui_session:
+        return None
+    notification = CronCompletionNotification(
+        execution_id=execution,
+        job_id=job,
+        title=_bounded_cron_display_text(
+            job_name,
+            limit=CRON_COMPLETION_TITLE_CHARS,
+            fallback="scheduled job",
+        ).replace("\n", " ").replace("\t", " "),
+        body=_bounded_cron_display_text(
+            result,
+            limit=CRON_COMPLETION_BODY_CHARS,
+            fallback="No result was returned.",
+        ),
+        success=bool(success),
+        session_key=session,
+        origin_ui_session_id=ui_session,
+    )
+    return notification.as_event()
+
+
+def parse_cron_completion_notification(
+    event: Any,
+) -> "CronCompletionNotification | None":
+    """Fail closed unless ``event`` is the exact bounded v1 queue contract."""
+
+    if not isinstance(event, dict):
+        return None
+    if (
+        event.get("type") != CRON_COMPLETION_EVENT_TYPE
+        or event.get("schema") != CRON_COMPLETION_SCHEMA
+        or event.get("exact_ui_session_only") is not True
+        or not isinstance(event.get("success"), bool)
+    ):
+        return None
+    execution = _cron_route_id(
+        event.get("session_id"), limit=_CRON_COMPLETION_ID_CHARS
+    )
+    job = _cron_route_id(event.get("job_id"), limit=_CRON_COMPLETION_ID_CHARS)
+    session = _cron_route_id(
+        event.get("session_key"), limit=_CRON_COMPLETION_ROUTE_CHARS
+    )
+    ui_session = _cron_route_id(
+        event.get("origin_ui_session_id"), limit=_CRON_COMPLETION_ROUTE_CHARS
+    )
+    if not execution or not job or not session or not ui_session:
+        return None
+    return CronCompletionNotification(
+        execution_id=execution,
+        job_id=job,
+        title=_bounded_cron_display_text(
+            event.get("title"),
+            limit=CRON_COMPLETION_TITLE_CHARS,
+            fallback="scheduled job",
+        ).replace("\n", " ").replace("\t", " "),
+        body=_bounded_cron_display_text(
+            event.get("body"),
+            limit=CRON_COMPLETION_BODY_CHARS,
+            fallback="No result was returned.",
+        ),
+        success=event["success"],
+        session_key=session,
+        origin_ui_session_id=ui_session,
+    )
+
 
