+    assert session["history"] == prior_history
+    assert session["history_version"] == 7
+    assert injection not in repr(session["history"])
+    next_provider_messages = list(session["history"]) + [
+        {"role": "user", "content": "real next turn"}
+    ]
+    assert injection not in repr(next_provider_messages)
+    assert [row["role"] for row in next_provider_messages] == [
+        "assistant",
+        "user",
