+SAPI_POWERSHELL_SCRIPT = r"""
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Speech
+$synth = New-Object System.Speech.Synthesis.SpeechSynthesizer
+try {
+    $voice = [Environment]::GetEnvironmentVariable('HERMES_SAPI_VOICE', 'Process')
+    if (-not [string]::IsNullOrWhiteSpace($voice)) {
+        $synth.SelectVoice($voice)
+    }
+    $rate = [Environment]::GetEnvironmentVariable('HERMES_SAPI_RATE', 'Process')
+    if (-not [string]::IsNullOrWhiteSpace($rate)) {
+        $synth.Rate = [Math]::Max(-10, [Math]::Min(10, [int]$rate))
+    }
+    $inputPath = [Environment]::GetEnvironmentVariable('HERMES_SAPI_INPUT_PATH', 'Process')
+    $outputPath = [Environment]::GetEnvironmentVariable('HERMES_SAPI_OUTPUT_PATH', 'Process')
+    $text = [System.IO.File]::ReadAllText($inputPath, [System.Text.Encoding]::UTF8)
+    if ([string]::IsNullOrWhiteSpace($text)) {
+        throw 'SAPI input text is empty'
+    }
+    $synth.SetOutputToWaveFile($outputPath)
+    $synth.Speak($text)
+}
+finally {
+    $synth.Dispose()
+}
+""".strip()
+
