+def _project_cron_completion_notification(
+    sid: str,
+    session: dict,
+    evt: dict,
+) -> bool:
+    """Emit one presentation-only cron completion without an agent turn.
+
+    A cron result is untrusted model/tool output.  The scheduler already
+    force-redacts and bounds the typed queue payload; parse it again here at the
+    session boundary, then project the safe presentation as an assistant
+    timeline event.  This function deliberately never calls
+    ``_run_prompt_submit``, never marks the session running, and never appends
+    the untrusted text to live or durable model history.  It therefore cannot
+    borrow the user's model, tools, approvals, turn budget, or influence a
+    later real user turn.
+    """
+
+    from agent.turn_identity import new_message_id
+    from tools.process_registry import (
+        CRON_COMPLETION_EVENT_TYPE,
+        CRON_COMPLETION_SCHEMA,
+        parse_cron_completion_notification,
+    )
+
+    notification = parse_cron_completion_notification(evt)
+    if notification is None or evt.get("type") != CRON_COMPLETION_EVENT_TYPE:
+        return False
+    visible_text = notification.display_text()
+    if not visible_text:
+        return False
+
+    turn_id = new_message_id()
+    assistant_message_id = new_message_id(excluding=(turn_id,))
+    display_metadata = {
+        "cron_notification_schema": CRON_COMPLETION_SCHEMA,
+        "cron_execution_id": notification.execution_id,
+        "cron_job_id": notification.job_id,
+        "cron_success": notification.success,
+    }
+
+    # The caller already proved exact live-session ownership. Re-check the
+    # registry edge immediately before emitting so a close racing this
+    # projection wins cleanly and leaves the result only in cron storage.
+    with _sessions_lock:
+        if (
+            _sessions.get(str(sid or "")) is not session
+            or session.get("_finalized")
+        ):
+            return False
+
+    payload = {
+        "text": visible_text,
+        "status": "complete",
+        "display_kind": "cron_completion",
+        "display_metadata": display_metadata,
+    }
+    try:
+        payload["rendered"] = render_message(
+            visible_text,
+            int(session.get("cols", 80)),
+        )
+    except Exception:
+        pass
