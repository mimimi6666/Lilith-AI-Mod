+        observed["command"] = command
+        observed["env"] = kwargs["env"]
+        input_path = kwargs["env"]["HERMES_SAPI_INPUT_PATH"]
+        observed["input_path"] = input_path
+        observed["text"] = Path(input_path).read_text(encoding="utf-8")
+        Path(kwargs["env"]["HERMES_SAPI_OUTPUT_PATH"]).write_bytes(
+            b"RIFF\x04\x00\x00\x00WAVE"
