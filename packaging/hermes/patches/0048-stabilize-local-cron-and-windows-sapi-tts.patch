@@ -4823,6 +4823,65 @@ def _teardown_cron_agent(agent, job_id: str) -> None:
         logger.debug("Job '%s': failed to reap stale auxiliary clients: %s", job_id, e)
 
 
+def _queue_local_workbench_completion(
+    job: dict,
+    *,
+    execution_id: str,
+    success: bool,
+    result: str,
+) -> bool:
+    """Queue one live-only completion for the exact creating Workbench session.
+
+    The queue is intentionally process-local and non-restoring: if the exact UI
+    session is already closed (or closes before claiming it), the result remains
+    in cron storage and is never replayed into a reopened/foreign session.
+    """
+    local_origin = job.get("local_workbench_origin")
+    if (job.get("schedule") or {}).get("kind") != "once":
+        return False
+    if not isinstance(local_origin, dict):
+        return False
+    if local_origin.get("kind") != "local_workbench":
+        return False
+    ui_session_id = str(local_origin.get("ui_session_id") or "").strip()
+    session_key = str(local_origin.get("session_key") or "").strip()
+    content = str(result or "").strip()
+    if not ui_session_id or not session_key or not content:
+        return False
+    try:
+        from tools.process_registry import (
+            build_cron_completion_notification,
+            process_registry,
+        )
+
+        notification = build_cron_completion_notification(
+            execution_id=execution_id,
+            job_id=job.get("id"),
+            job_name=job.get("name") or job.get("id") or "scheduled job",
+            success=success,
+            result=content,
+            session_key=session_key,
+            origin_ui_session_id=ui_session_id,
+        )
+        if notification is None:
+            logger.warning(
+                "Job '%s': local Workbench completion had an invalid return "
+                "address; result remains saved",
+                job.get("id"),
+            )
+            return False
+        process_registry.completion_queue.put(notification)
+        return True
+    except Exception as exc:
+        logger.warning(
+            "Job '%s': local Workbench completion could not be queued; "
+            "result remains saved: %s",
+            job.get("id"),
+            exc,
+        )
+        return False
+
+
 def run_one_job(
     job: dict, *, adapters=None, loop=None, verbose: bool = False,
     extra_prompt: Optional[str] = None,
@@ -5053,6 +5112,13 @@ def run_one_job(
             error=error,
             delivery_outcome=delivery_outcome,
         )
+        if should_deliver:
+            _queue_local_workbench_completion(
+                job,
+                execution_id=execution_id,
+                success=success,
+                result=deliver_content,
+            )
         return True
 
     except BaseException as e:  # noqa: BLE001 — deliberate: see below
