+def rotate_trusted_identity_config_digest(
+    previous_sha256: str,
+    candidate_sha256: str,
+) -> None:
+    """CAS-rotate the Runtime config digest in both trusted env authorities.
+
+    ``load_hermes_dotenv`` restores values from an immutable startup snapshot,
+    not merely from ``os.environ``.  An authorized native config mutation must
+    therefore replace that snapshot and the live environment under one lock;
+    otherwise the next dotenv reload silently resurrects the old digest.
+    """
+
+    global _TRUSTED_IDENTITY_ENV_SNAPSHOT
+    previous = _normalized_config_digest(
+        previous_sha256,
+        label="previous trusted identity config digest",
+    )
+    candidate = _normalized_config_digest(
+        candidate_sha256,
+        label="candidate trusted identity config digest",
+    )
+
+    key = "HERMES_IDENTITY_EXPECTED_CONFIG_SHA256"
+    with _TRUSTED_IDENTITY_ENV_LOCK:
+        snapshot = _capture_trusted_identity_environment()
+        if snapshot is None:
+            raise TrustedIdentityEnvironmentError(
+                "trusted identity environment was not captured"
+            )
+        snapshot_value = str(snapshot.get(key) or "").strip().lower()
+        environ_value = str(os.environ.get(key) or "").strip().lower()
+        if not hmac.compare_digest(snapshot_value, previous) or not hmac.compare_digest(
+            environ_value, previous
+        ):
+            raise TrustedIdentityEnvironmentError(
+                "trusted identity config digest changed before rotation"
+            )
+
+        replacement = dict(snapshot)
+        replacement[key] = candidate
+        # ``os.environ`` is the only assignment here that can invoke an OS
+        # operation and fail.  Perform it first while the snapshot is still the
+        # proven previous authority; the following in-memory reference swap
+        # cannot leave a half-rotated pair.
+        os.environ[key] = candidate
+        _TRUSTED_IDENTITY_ENV_SNAPSHOT = replacement
+
+
