+        # writer cannot be blessed merely because it raced the candidate
+        # preflight; any later drift is still caught by the next strict turn.
+        try:
+            verified_sha256 = hashlib.sha256(config_path.read_bytes()).hexdigest()
+        except Exception as exc:
+            raise IdentityPolicyError(
+                f"rewritten identity config could not be re-read: {config_path}"
+            ) from exc
+        if not hmac.compare_digest(verified_sha256, candidate_sha256):
+            raise IdentityPolicyError(
+                "strict config bytes changed during candidate verification"
+            )
+        current_expected = _required_digest(
+            os.environ, _EXPECTED_CONFIG_SHA256_ENV
+        )
+        if not hmac.compare_digest(current_expected, previous):
+            raise IdentityPolicyError(
+                "strict config digest changed before candidate commit"
+            )
