+    strict = identity_lock_required_by_host()
+    if strict:
+        if previous_sha256 is None or not _FINGERPRINT_RE.fullmatch(
+            str(previous_sha256)
+        ):
+            raise IdentityPolicyError(
+                "strict config digest rotation requires a preflight token"
+            )
+        previous = str(previous_sha256).lower()
+        current_expected = _required_digest(
+            os.environ, _EXPECTED_CONFIG_SHA256_ENV
+        )
+        if not hmac.compare_digest(current_expected, previous):
+            raise IdentityPolicyError(
+                "strict config digest changed during the authorized mutation"
+            )
+    config_path = _host_config_path_for_digest_rotation(strict=strict)
