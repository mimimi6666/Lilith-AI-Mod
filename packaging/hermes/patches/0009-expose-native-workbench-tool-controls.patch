+            commit_host_config_digest_rotation,
+            prepare_host_config_digest_rotation,
+            restore_host_config_snapshot,
+        )
+        from hermes_cli.config import _CONFIG_LOCK, get_config_path, load_config
+        from hermes_cli.tools_config import (
+            _CONFIG_ONLY_TOOLSETS,
+            _get_effective_configurable_toolsets,
+            _get_platform_tools,
+            _save_platform_tools,
+            _toolset_allowed_for_platform,
+        )
+        from tools.approval import _normalize_approval_mode
+
+        platform = "cli"
+        valid = {
+            name
+            for name, _, _ in _get_effective_configurable_toolsets()
+            if name not in _CONFIG_ONLY_TOOLSETS
+            and _toolset_allowed_for_platform(name, platform)
+        }
+        unknown = sorted(requested - valid)
+        if unknown:
+            return _err(
+                rid,
+                -32602,
+                f"unknown cli toolset(s): {', '.join(unknown)}",
+            )
+
+        acquired_history_locks = []
+        _tool_policy_mutation_lock.acquire()
+        _sessions_lock.acquire()
+        try:
+            if _tool_policy_terminal_error is not None:
+                return _err(rid, 5035, _TOOL_POLICY_TERMINAL_MESSAGE)
+            seen_locks = set()
+            for session in list(_sessions.values()):
+                history_lock = session.get("history_lock")
+                if history_lock is not None and id(history_lock) not in seen_locks:
+                    seen_locks.add(id(history_lock))
+                    if not history_lock.acquire(blocking=False):
+                        return _err(
+                            rid,
+                            4090,
+                            "tool policy cannot change while a session is active",
+                        )
+                    acquired_history_locks.append(history_lock)
+
+            if any(
+                session.get("running") or bool(session.get("tool_started_at"))
+                for session in _sessions.values()
+            ):
+                return _err(
+                    rid,
+                    4090,
+                    "tool policy cannot change while a turn or tool call is running",
+                )
+
+            with _CONFIG_LOCK:
+                config_path = get_config_path()
+                try:
