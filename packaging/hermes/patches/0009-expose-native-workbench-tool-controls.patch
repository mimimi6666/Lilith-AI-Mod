+def commit_host_config_digest_rotation(
+    previous_sha256: Optional[str],
+) -> str:
+    """Verify one completed config write, then rotate the strict host pin.
+
+    The process-global expected digest is updated only after a candidate
+    preflight proves that the rewritten bytes still carry the exact pinned
+    identity, SOUL, and personality.  Existing agents intentionally retain
+    their old snapshot digest and therefore cannot continue under the new
+    config; callers must report that a new session is required.
+    """
