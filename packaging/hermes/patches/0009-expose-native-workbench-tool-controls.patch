+@method("tools.catalog")
+def _(rid, params: dict) -> dict:
+    """Return the native CLI toolset catalog and effective approval policy."""
+    if not isinstance(params, dict) or params:
+        return _err(rid, -32602, "tools.catalog params must be an empty object")
+
+    try:
+        from hermes_cli.config import load_config
+        from hermes_cli.tools_config import (
+            TOOL_CATEGORIES,
+            _CONFIG_ONLY_TOOLSETS,
+            _get_effective_configurable_toolsets,
+            _get_platform_tools,
+            _is_provider_active,
+            _toolset_allowed_for_platform,
+            _toolset_has_keys,
+            _visible_providers,
+            get_nous_subscription_features,
+            gui_toolset_label,
+            provider_readiness_status,
+        )
+        from toolsets import resolve_toolset
+        from tools.approval import _get_approval_mode
+
+        platform = "cli"
+        config = load_config()
+        catalog = [
+            row
+            for row in _get_effective_configurable_toolsets()
+            if row[0] not in _CONFIG_ONLY_TOOLSETS
+            and _toolset_allowed_for_platform(row[0], platform)
+        ]
+        catalog_names = {name for name, _, _ in catalog}
+        enabled = {
+            name
+            for name in _get_platform_tools(
+                config,
+                platform,
+                include_default_mcp_servers=False,
+            )
+            if name in catalog_names
+        }
+        features = get_nous_subscription_features(config)
+
+        def category_readiness(toolset_name: str) -> str:
+            category = TOOL_CATEGORIES.get(toolset_name)
+            if not category:
+                return (
+                    "ready"
+                    if _toolset_has_keys(
+                        toolset_name,
+                        config,
+                        features=features,
+                    )
+                    else "needs_keys"
+                )
+
+            providers = _visible_providers(
+                category,
+                config,
+                features=features,
+            )
+            active_statuses = []
+            for provider in providers:
+                try:
+                    is_active = _is_provider_active(provider, config)
+                except Exception:
+                    is_active = False
+                if not is_active:
+                    continue
+                status = provider_readiness_status(
+                    provider,
+                    config,
+                    features=features,
+                    is_active=True,
+                )
+                if status in {"ready", "needs_setup", "needs_auth", "needs_keys"}:
+                    active_statuses.append(status)
+
+            if "ready" in active_statuses:
+                return "ready"
+            for status in ("needs_auth", "needs_keys", "needs_setup"):
+                if status in active_statuses:
+                    return status
+
+            # A sole unselected provider can still explain the exact missing
+            # prerequisite (Spotify authentication, a required key, etc.), but
+            # it can never make the category look ready while inactive.
+            if len(providers) == 1:
+                status = provider_readiness_status(
+                    providers[0],
+                    config,
+                    features=features,
+                    is_active=False,
+                )
+                if status in {"needs_setup", "needs_auth", "needs_keys"}:
+                    return status
+            return "needs_setup"
+
+        rows = []
+        for name, label, description in catalog:
+            readiness = category_readiness(name)
+            try:
+                tools = sorted(set(resolve_toolset(name)))
+            except Exception:
+                tools = []
+            rows.append(
+                {
+                    "name": name,
+                    "label": gui_toolset_label(label),
+                    "description": description,
+                    "enabled": name in enabled,
+                    "configured": readiness == "ready",
+                    "readiness": readiness,
+                    "tools": tools,
+                }
+            )
+
+        return _ok(
+            rid,
+            {
+                "platform": platform,
+                "approval_mode": _get_approval_mode(),
+                "enabled_toolsets": sorted(enabled),
+                "toolsets": rows,
+                "new_session_required": False,
+            },
+        )
+    except Exception as e:
+        return _err(rid, 5031, str(e))
+
+
+@method("tools.set")
+def _(rid, params: dict) -> dict:
+    """Atomically replace native CLI toolsets and the approval mode."""
+    global _tool_policy_terminal_error
+
