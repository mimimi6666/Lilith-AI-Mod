+"""Behavior contracts for the native tools policy JSON-RPC surface."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import threading
+from unittest.mock import patch
+
+import pytest
+import yaml
+
+from hermes_cli.nous_account import NousPortalAccountInfo
+from hermes_cli.nous_subscription import NousSubscriptionFeatures
+import tui_gateway.server as server
+
+
+@pytest.fixture(autouse=True)
+def _clean_gateway_sessions(monkeypatch):
+    import hermes_cli.env_loader as env_loader
+
+    server._sessions.clear()
+    monkeypatch.setattr(server, "_tool_policy_terminal_error", None)
+    monkeypatch.setattr(env_loader, "_TRUSTED_IDENTITY_ENV_SNAPSHOT", None)
+    yield
+    server._sessions.clear()
+
+
+def _home():
+    from pathlib import Path
+
+    return Path(os.environ["HERMES_HOME"])
+
+
+def _write_config(config: dict) -> bytes:
+    raw = yaml.safe_dump(
+        config,
+        allow_unicode=True,
+        sort_keys=False,
+    ).encode("utf-8")
+    (_home() / "config.yaml").write_bytes(raw)
+    return raw
+
+
+def _logged_out_features() -> NousSubscriptionFeatures:
+    return NousSubscriptionFeatures(
+        subscribed=False,
+        nous_auth_present=False,
+        provider_is_nous=False,
+        features={},
+        account_info=NousPortalAccountInfo(
+            logged_in=False,
+            source="none",
+            fresh=False,
+        ),
+    )
+
+
+def _catalog_rows(monkeypatch) -> dict[str, dict]:
+    import hermes_cli.tools_config as tools_config
+
+    features = _logged_out_features()
+    monkeypatch.setattr(
+        tools_config,
+        "get_nous_subscription_features",
+        lambda *args, **kwargs: features,
+    )
+    response = server._methods["tools.catalog"]("catalog", {})
+    assert "error" not in response, response
+    result = response["result"]
+    assert result["platform"] == "cli"
+    assert result["new_session_required"] is False
+    return {row["name"]: row for row in result["toolsets"]}
+
+
+def test_catalog_never_calls_keyless_unready_providers_configured(monkeypatch):
+    import hermes_cli.tools_config as tools_config
+
+    _write_config(
+        {
+            "platform_toolsets": {
+                "cli": ["browser", "spotify", "web"],
+            },
+            "approvals": {"mode": "manual"},
+            "browser": {
+                "cloud_provider": "local",
+                "backend": "off",
+            },
+            "web": {"search_backend": "ddgs"},
+        }
+    )
+    monkeypatch.setitem(
+        tools_config._POST_SETUP_READY,
+        "agent_browser",
+        lambda: False,
+    )
+    monkeypatch.setitem(
+        tools_config._POST_SETUP_READY,
+        "ddgs",
+        lambda: False,
+    )
+    monkeypatch.setattr(
+        tools_config,
+        "_spotify_credentials_present",
+        lambda: False,
+    )
+
+    rows = _catalog_rows(monkeypatch)
+
+    assert rows["spotify"]["enabled"] is True
+    assert rows["spotify"]["configured"] is False
+    assert rows["spotify"]["readiness"] == "needs_auth"
+    assert rows["browser"]["enabled"] is True
+    assert rows["browser"]["configured"] is False
+    assert rows["browser"]["readiness"] == "needs_setup"
+    assert rows["web"]["enabled"] is True
+    assert rows["web"]["configured"] is False
+    assert rows["web"]["readiness"] == "needs_setup"
+    assert all(
+        row["configured"] is (row["readiness"] == "ready")
+        for row in rows.values()
+    )
+
+
+def test_catalog_reports_seeded_local_browser_ready_after_native_setup(monkeypatch):
+    import hermes_cli.tools_config as tools_config
+
+    _write_config(
+        {
+            "platform_toolsets": {"cli": ["browser", "web"]},
+            "approvals": {"mode": "manual"},
+            "browser": {
+                "cloud_provider": "local",
+                "backend": "off",
+            },
+            "web": {"search_backend": "ddgs"},
