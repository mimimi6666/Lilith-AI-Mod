+def _strict_config(*, personality: str = PERSONALITY, **identity_overrides):
+    identity = {
+        "require_soul": True,
+        "suppress_kernel_help": True,
+        "personality_allowlist": ["lilith"],
+        "locked_personality": "lilith",
+        "force_soul_for_children": True,
+        "fingerprint": FINGERPRINT.upper(),
+    }
