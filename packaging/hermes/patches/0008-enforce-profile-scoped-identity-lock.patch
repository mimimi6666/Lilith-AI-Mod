+def _write_profile(
+    home: Path,
+    *,
+    cfg=None,
+    soul: str = SOUL,
+) -> None:
+    home.mkdir(parents=True, exist_ok=True)
+    (home / "config.yaml").write_text(
+        yaml.safe_dump(
+            _strict_config() if cfg is None else cfg,
+            allow_unicode=True,
+            sort_keys=False,
+        ),
+        encoding="utf-8",
+        newline="\n",
+    )
+    (home / "SOUL.md").write_text(
+        soul,
+        encoding="utf-8",
+        newline="\n",
+    )
+
+
+def _attest(
+    monkeypatch,
+    home: Path,
+    *,
+    fingerprint: str = FINGERPRINT,
+    config_sha256: str | None = None,
+    soul_sha256: str | None = None,
+    personality_sha256: str | None = None,
+) -> None:
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_IDENTITY_EXPECTED_FINGERPRINT", fingerprint)
+    config_path = home / "config.yaml"
+    monkeypatch.setenv(
+        "HERMES_IDENTITY_EXPECTED_CONFIG_SHA256",
+        config_sha256
+        or (
+            hashlib.sha256(config_path.read_bytes()).hexdigest()
+            if config_path.is_file()
+            else "c" * 64
+        ),
+    )
+    monkeypatch.setenv(
+        "HERMES_IDENTITY_EXPECTED_SOUL_SHA256",
+        soul_sha256 or _sha(SOUL),
+    )
+    monkeypatch.setenv(
+        "HERMES_IDENTITY_EXPECTED_PERSONALITY_SHA256",
+        personality_sha256 or _sha(PERSONALITY),
+    )
+
+
+def _strict_agent(*, cached_prompt=None):
