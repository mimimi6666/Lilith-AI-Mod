+    ) -> List[Dict[str, Any]]:
+        """Attach the owning strict agent's exact pinned system authority."""
+
+        agent = getattr(self, "_strict_identity_agent", None)
+        if agent is None:
+            return messages
+        from agent.identity_policy import (
+            assert_scoped_identity_prompt,
+            policy_for_agent,
+        )
+
+        if not policy_for_agent(agent).enabled:
+            return messages
