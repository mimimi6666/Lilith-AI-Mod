+    ) -> None:
+        """Pin strict auxiliary routing to the already-attested main runtime."""
+
+        agent = getattr(self, "_strict_identity_agent", None)
+        if agent is None:
+            return
+        from agent.identity_policy import policy_for_agent
+
+        if not policy_for_agent(agent).enabled:
+            return
