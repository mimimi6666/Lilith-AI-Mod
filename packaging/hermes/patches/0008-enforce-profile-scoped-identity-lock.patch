+@dataclass(frozen=True)
+class PublicIdentity:
+    """Pinned public-facing identity for a host-locked deployment.
+
+    This is deliberately separate from product namespaces and technical
+    protocol identifiers.  It is only for surfaces where the running agent
+    identifies itself to a person or an external service.
+    """
+
+    display_name: str
+    ascii_name: str
+    description: str
+    provider_organization: str
+    email_subject: str
+    quit_reason: str
+    wake_aliases: Tuple[str, ...]
+
+
+_STRICT_PUBLIC_IDENTITY = PublicIdentity(
+    display_name="莉莉絲 Lilith",
+    ascii_name="Lilith",
+    description="莉莉絲 Lilith personal intelligence runtime",
+    provider_organization="Lilith Runtime",
+    email_subject="Lilith / 莉莉絲",
+    quit_reason="Lilith runtime shutting down",
+    wake_aliases=("Lilith", "莉莉絲", "莉莉丝", "リリス"),
+)
