+class IdentityPolicyError(ValueError):
+    """Raised when an enabled identity policy is incomplete or inconsistent."""
+
+
+def _normalized_name(value: Any) -> str:
+    name = str(value or "").strip().lower()
+    return "" if name in _NEUTRAL_NAMES else name
+
+
+@dataclass(frozen=True)
+class IdentityPolicy:
+    """Normalized immutable identity policy for one profile/session."""
+
+    require_soul: bool = False
+    suppress_kernel_help: bool = False
+    personality_allowlist: Tuple[str, ...] = ()
+    locked_personality: str = ""
+    force_soul_for_children: bool = False
+    fingerprint: str = ""
+
+    @property
+    def enabled(self) -> bool:
+        return self.require_soul
+
+    @classmethod
+    def disabled(cls) -> "IdentityPolicy":
+        return cls()
+
+
+@dataclass(frozen=True)
+class IdentityPreflight:
+    """Immutable result of the host-attested pre-I/O identity check."""
+
+    policy: IdentityPolicy = IdentityPolicy()
+    config: Optional[Dict[str, Any]] = None
+    soul_content: str = ""
+    personality_prompt: str = ""
+    config_sha256: str = ""
+    soul_sha256: str = ""
+    personality_sha256: str = ""
+
+    @property
+    def enabled(self) -> bool:
+        return self.policy.enabled
+
+    @classmethod
+    def disabled(cls) -> "IdentityPreflight":
+        return cls()
