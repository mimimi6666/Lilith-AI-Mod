+_SUBORDINATE_IDENTITY_DIRECTIVE_RE = re.compile(
+    r"(?im)(?:"
+    r"you\s+are\s+(?:(?:an?|the)\s+)?(?:hermes(?:\s+agent)?|assistant|chatbot|ai|model)\b"
+    r"|(?:your\s+)?(?:name|identity|personality)\s+(?:is|must\s+be)\b"
+    r"|(?:act|pretend)\s+as\b"
+    r"|ignore\b.{0,120}\b(?:identity|personality|system\s+prompt|previous\s+instructions)\b"
+    r"|你(?:的名字|的身份|的人格)?是\s*(?:hermes|赫尔墨斯|赫爾墨斯|助手|助理|ai)"
+    r"|あなた(?:の名前|の人格|のアイデンティティ)?は\s*(?:hermes|ヘルメス|アシスタント|ai)"
+    r")"
