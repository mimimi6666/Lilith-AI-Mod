+"""Profile-scoped policy for deployments that require a pinned identity.
+
+Hermes remains generic when the top-level ``identity.require_soul`` setting is
+absent or false.  A distribution can opt a profile into the stricter contract:
+SOUL becomes mandatory, the kernel help block can be omitted, and personality
+selection is restricted to explicitly configured custom definitions.
+
+The policy is resolved once while an :class:`AIAgent` is constructed.  Keeping
+the normalized result on the agent makes prompt construction deterministic for
+the lifetime of the session and preserves prefix-cache byte stability.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+import re
+from typing import Any, Dict, Mapping, Optional, Sequence, Tuple
+
+
+_FINGERPRINT_RE = re.compile(r"^[0-9a-fA-F]{64}$")
+_NEUTRAL_NAMES = frozenset({"", "none", "default", "neutral"})
+_IDENTITY_REQUIRED_ENV = "HERMES_IDENTITY_REQUIRED"
+_EXPECTED_FINGERPRINT_ENV = "HERMES_IDENTITY_EXPECTED_FINGERPRINT"
+_EXPECTED_CONFIG_SHA256_ENV = "HERMES_IDENTITY_EXPECTED_CONFIG_SHA256"
+_EXPECTED_SOUL_SHA256_ENV = "HERMES_IDENTITY_EXPECTED_SOUL_SHA256"
+_EXPECTED_PERSONALITY_SHA256_ENV = (
+    "HERMES_IDENTITY_EXPECTED_PERSONALITY_SHA256"
+)
+_FORBIDDEN_PROMPT_ENV = (
+    "HERMES_EPHEMERAL_SYSTEM_PROMPT",
+    "HERMES_ENVIRONMENT_HINT",
+)
+_LOCKED_CONFIG_PATHS = (
+    "identity",
+    "display.personality",
+    "agent.personalities",
+    "agent.system_prompt",
+    "agent.environment_hint",
+    "custom_prompt",
+)
+_STRICT_SYSTEM_AUTHORITY_API_MODES = frozenset(
+    {
+        "chat_completions",
+        "codex_responses",
+        "anthropic_messages",
+        "bedrock_converse",
+    }
