+        _cached_system_prompt=cached_prompt,
+        ephemeral_system_prompt=None,
+        api_mode="chat_completions",
+        provider="openrouter",
+        acp_command=None,
+    )
+    agent._session_init_model_config = scoped_identity_metadata(agent)
+    return agent
