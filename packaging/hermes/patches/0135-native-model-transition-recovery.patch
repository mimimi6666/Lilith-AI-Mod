+"""Actual handler/config/identity tests; transports and host attestation are synthetic."""
+import hashlib
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import agent.identity_policy as identity
+import hermes_cli.model_switch as model_switch
+import tui_gateway.server as server
+from tests.tui_gateway.test_tools_policy_rpc import (
+    _attest_strict_host, _clean_gateway_sessions, _home, _new_strict_agent,
+    _strict_config, _write_config,
+)
+
+
+class SessionDb:
+    def __init__(self, agent):
+        self.row = {"model_config": json.dumps(agent._session_init_model_config)}
+        self.writes = 0
+
+    def get_session(self, _key):
+        return dict(self.row)
+
+    def update_session_meta(self, _key, model_config, model=None):
+        self.writes += 1
+        self.row["model_config"] = model_config
+
+
+@pytest.fixture
+def strict_session(monkeypatch):
+    from hermes_cli.env_loader import load_hermes_dotenv
+    soul, personality = "Synthetic Lilith soul.\n", "Synthetic Lilith personality.\n"
+    config = _strict_config(personality)
+    # These fixture profiles have explicitly declined unrelated shipped tools;
+    # otherwise auto-discovery would make an approval-only edit a tool edit.
+    config["agent"]["disabled_toolsets"] = ["kanban", "bfl"]
+    config["model"] = {"default": "model-old", "provider": "provider-old"}
+    raw = _write_config(config)
+    (_home() / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    _attest_strict_host(monkeypatch, raw, soul, personality)
+    load_hermes_dotenv(hermes_home=_home())
+    agent = _new_strict_agent()
+    db = SessionDb(agent)
+    agent._session_db = db
+    session = dict(session_key="synthetic-live-key", agent=agent,
+                   history_lock=threading.RLock(), running=False, tool_started_at={})
+    server._sessions["synthetic-live"] = session
+    yield SimpleNamespace(session=session, agent=agent, db=db,
+                          raw=raw, soul=soul, personality=personality)
+    # The synthetic database is deliberately not an actual AIAgent-owned DB.
+    agent._session_db = None
+    agent.close()
+
+
+def rpc(method, params):
+    return server.handle_request({"jsonrpc": "2.0", "id": "fixture", "method": method, "params": params})
+
+
+def persist_receipt(fixture, source, previous, current):
+    """Synthetic Runtime boundary: actual native code independently verifies it."""
+    from tools.approval import _capture_native_approval_policy
+    path = _home() / "runtime" / "native-config-receipt.v1.json"
+    prior = json.loads(path.read_bytes()) if path.exists() else None
+    mode, toolsets = _capture_native_approval_policy()
+    receipt = dict(schema_version=1, source=source,
+        sequence=prior["sequence"] + 1 if prior else 1,
+        canonical_base_sha256=prior["canonical_base_sha256"] if prior else previous,
+        previous_config_sha256=previous, config_sha256=current,
+        identity_fingerprint_sha256="a" * 64,
+        soul_sha256=hashlib.sha256(fixture.soul.encode()).hexdigest(),
+        personality_sha256=hashlib.sha256(fixture.personality.encode()).hexdigest(),
+        approval_mode=mode, enabled_toolsets=list(toolsets))
+    raw = json.dumps(receipt, separators=(",", ":")).encode()
+    path.write_bytes(raw)
+    return hashlib.sha256(raw).hexdigest()
+
+
+def save_tools(fixture, **changes):
+    previous = hashlib.sha256((_home() / "config.yaml").read_bytes()).hexdigest()
+    response = rpc("tools.set", changes)
+    assert "error" not in response, response
+    current = response["result"]["config_sha256"]
+    persist_receipt(fixture, "hermes.tools.set", previous, current)
+    return current
+
+
+def select_model(monkeypatch, model="model-new", provider="provider-new"):
+    # Replace only external provider resolution. Actual parsing, strict session
+    # guards, config writes, pending ownership and phase-two receipt remain real.
+    monkeypatch.setattr(model_switch, "switch_model", lambda **kwargs: SimpleNamespace(
+        success=True, new_model=model, target_provider=provider, base_url=None,
+        api_key="synthetic", api_mode="chat_completions", warning_message=""))
+    return rpc("config.set", dict(key="model", value=f"{model} --provider {provider} --global",
+                                  confirm_expensive_model=True))
+
+
+def finish_model(fixture, previous):
+    current = hashlib.sha256((_home() / "config.yaml").read_bytes()).hexdigest()
+    digest = persist_receipt(fixture, "hermes.model.default.set", previous, current)
+    response = rpc("model.default.commit", dict(authority="lilith-runtime-native-config.v1",
+        previous_config_sha256=previous, config_sha256=current, receipt_sha256=digest))
+    assert response.get("result") == {"committed": 1}, response
+    assert identity.native_authority_pending_transition_state() is None
+    assert identity.native_authority_quarantine_state() is None
+    return current
+
+
+def test_real_tools_then_global_model_keeps_old_session_retired(monkeypatch, strict_session):
+    fixture = strict_session
+    tools_digest = save_tools(fixture, enabled_toolsets=["file", "terminal"], approval_mode="smart")
+    original_row = fixture.db.row.copy()
+    result = select_model(monkeypatch)
+    assert "error" not in result, result
+    assert identity.native_authority_pending_transition_state() is not None
+    model_digest = finish_model(fixture, tools_digest)
+    assert fixture.db.row == original_row and fixture.db.writes == 0
+    assert fixture.agent._identity_config_sha256 == hashlib.sha256(fixture.raw).hexdigest()
+    assert fixture.session["_native_model_retirement"].current == model_digest
+    assert "_native_approval_resume_digest" not in fixture.session
+    with pytest.raises(identity.IdentityPolicyError):
+        identity.enforce_scoped_turn_identity(fixture.agent)
+    result = select_model(monkeypatch, "model-third", "provider-third")
+    assert "error" not in result, result
+    finish_model(fixture, model_digest)
+    assert fixture.db.row == original_row
+
+
+@pytest.mark.parametrize("changed_tools", [False, True])
+def test_only_approval_chain_can_resume_after_model_commit(monkeypatch, strict_session, changed_tools):
+    fixture = strict_session
+    old = hashlib.sha256(fixture.raw).hexdigest()
+    from hermes_cli.config import load_config
+    from hermes_cli.tools_config import _get_platform_tools
+    unchanged_tools = sorted(_get_platform_tools(load_config(), "cli", include_default_mcp_servers=False))
+    current = save_tools(fixture, enabled_toolsets=unchanged_tools, approval_mode="smart")
+    assert fixture.session["_native_approval_resume_digest"] == {"previous": old, "current": current}
+    if changed_tools:
+        current = save_tools(fixture, enabled_toolsets=["file"], approval_mode="manual")
+        assert "_native_approval_resume_digest" not in fixture.session
+    result = select_model(monkeypatch)
+    assert "error" not in result, result
+    current = finish_model(fixture, current)
+    if changed_tools:
+        assert "_native_approval_resume_digest" not in fixture.session
+    else:
+        assert fixture.session["_native_approval_resume_digest"] == {"previous": old, "current": current}
+
+
+@pytest.mark.parametrize("provider", ["deepseek", "gemini", "custom:fixture-local"])
+def test_explicit_resolution_failure_never_enters_pending_or_mutates(monkeypatch, strict_session, provider):
+    before = (_home() / "config.yaml").read_bytes()
+    monkeypatch.setattr(model_switch, "switch_model", lambda **kwargs: SimpleNamespace(
+        success=False, error_message="secret-provider-error-must-not-escape"))
+    persist = Mock(side_effect=AssertionError("persistence called"))
+    begin = Mock(side_effect=AssertionError("pending called"))
+    desire = Mock(side_effect=AssertionError("desire called"))
+    monkeypatch.setattr(server, "_persist_model_switch", persist)
+    monkeypatch.setattr(server, "_commit_runtime_desire", desire)
+    monkeypatch.setattr(identity, "begin_native_authority_commit_pending", begin)
+    result = rpc("config.set", dict(key="model", value=f"model-new --provider {provider} --global",
+                                   confirm_expensive_model=True))
+    assert result.get("error", {}).get("code") == 4096, result
+    assert "secret-provider" not in str(result)
+    assert (_home() / "config.yaml").read_bytes() == before
+    assert identity.native_authority_pending_transition_state() is None
+    assert identity.native_authority_quarantine_state() is None
+    persist.assert_not_called(); begin.assert_not_called(); desire.assert_not_called()
+
+
+def test_failed_pending_release_cannot_masquerade_as_retryable_busy(monkeypatch, strict_session):
+    strict_session.session["running"] = True
+    before = (_home() / "config.yaml").read_bytes()
+    monkeypatch.setattr(identity, "clear_native_authority_commit_pending",
+        Mock(side_effect=RuntimeError("synthetic release failure")))
+    result = select_model(monkeypatch)
+    assert result.get("error", {}).get("code") == 5035, result
+    assert (_home() / "config.yaml").read_bytes() == before
+    assert identity.native_authority_quarantine_state() is not None
+
+
+def test_unknown_resolution_exception_is_not_proven_no_change(monkeypatch, strict_session):
+    monkeypatch.setattr(model_switch, "switch_model", Mock(side_effect=RuntimeError("synthetic unknown")))
+    result = rpc("config.set", dict(key="model", value="model-new --provider unknown --global",
+                                   confirm_expensive_model=True))
+    assert result.get("error", {}).get("code") == 5001, result
+
+
+def test_tools_authority_contention_is_prewrite_and_retry_is_safe(monkeypatch, strict_session):
+    fixture = strict_session
+    authority = server._runtime_authority_lock(fixture.session)
+    before = (_home() / "config.yaml").read_bytes()
+    params = dict(enabled_toolsets=["file", "terminal"], approval_mode="smart")
+    authority.acquire()
+    try:
+        response = rpc("tools.set", params)
+        assert response.get("error", {}).get("code") == 4090, response
+        assert (_home() / "config.yaml").read_bytes() == before
+        assert "_native_model_retirement" not in fixture.session
+        assert identity.native_authority_pending_transition_state() is None
+        assert identity.native_authority_quarantine_state() is None
+    finally:
+        authority.release()
+    current = save_tools(fixture, **params)
+    assert fixture.session["_native_model_retirement"].current == current
+    response = select_model(monkeypatch)
+    assert "error" not in response, response
+    finish_model(fixture, current)
+
+
+@pytest.mark.parametrize("busy", ["running", "tool_started_at", "agent_build_started", "queued_prompt", "queued_prompts"])
+def test_known_busy_before_persistence_has_no_pending_or_write(monkeypatch, strict_session, busy):
+    strict_session.session[busy] = True
+    before = (_home() / "config.yaml").read_bytes()
+    result = select_model(monkeypatch)
+    assert result.get("error", {}).get("code") == 4090, result
+    assert (_home() / "config.yaml").read_bytes() == before
+    assert identity.native_authority_pending_transition_state() is None
+    assert identity.native_authority_quarantine_state() is None
