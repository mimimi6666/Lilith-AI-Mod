+def _number_pattern(number):
+    words = ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
+    chinese = words[number] if number < 10 else ("十" if number < 20 else words[number//10]+"十") + (words[number%10] if number%10 else "")
+    choices = [str(number), chinese]
+    if number == 2:
+        choices += ["兩", "两"]
+    return "(?:" + "|".join(choices) + ")(?![0-9])"
+
+
+def _coverage(key, value, text):
+    """Finite positive recognizers. Never equate absence of Arabic digits to missing."""
+    if key == "turn":
+        actor = (r"(?:我|私|me|my)" if value == "lilith" else r"(?:你|妳|あなた|you|your)")
+        if re.search(r"輪到\s*"+actor+r"|轮到\s*"+actor+r"|"+actor+r"(?:的)?(?:回合|番|の番|の手番)|"+actor+r"(?:r)?\s+(?:turn|move)",text,re.I):
+            return "covered"
+        cue=r"輪到|轮到|回合|手番|の番|turn|move"
+    elif key == "hand-counts":
+        p,l = _number_pattern(value["player"]),_number_pattern(value["lilith"])
+        player = re.search(r"(?:你|妳|あなた)(?:有|還有|还有|剩|手上|的手牌|は|\s)*"+p+r"\s*(?:張|张|枚)|you\s+(?:have|hold)\s+"+p+r"\s+cards?",text,re.I)
+        lilith = re.search(r"(?:我|私)(?:有|還有|还有|剩|手上|的手牌|は|\s)*"+l+r"\s*(?:張|张|枚)|I\s+(?:have|hold)\s+"+l+r"\s+cards?",text,re.I)
+        if player and lilith:
+            return "covered"
+        cue=r"[0-9零一二兩两三四五六七八九十]+\s*(?:張|张|枚)|牌數|牌数|(?:剩|一些|幾|几).{0,8}牌|card counts?|(?:have|hold)\s+\w+\s+cards?"
+    elif key == "self-hand":
+        patterns=[]
+        for card in value["cards"]:
+            if card["rank"] == "JOKER":
+                patterns.append(r"(?:鬼牌|joker|ジョーカー)")
+            else:
+                suit = r"(?:紅心|红心|♥|hearts?|ハート)" if card["suit"] == "hearts" else r"(?:黑桃|♠|spades?|スペード)"
+                patterns.append(suit+r"\s*"+re.escape(card["rank"])+r"(?![0-9A-Z])")
+        remaining=text
+        for pattern in patterns:
+            match=re.search(pattern,remaining,re.I)
+            if not match:break
+            remaining=remaining[match.end():]
+        else:
+            if re.search(r"左.{0,8}右|left.{0,8}right",text,re.I):
+                return "covered"
+        cue=r"紅心|红心|黑桃|花色|牌面|鬼牌|♥|♠|hearts?|spades?|joker|ジョーカー|ハート|スペード|左.{0,8}右|left.{0,8}right"
+    elif key == "last-move":
+        if not value:
+            return "covered" if re.search(r"(?:還沒|还没|尚未|沒有|没有).{0,8}(?:走|下)|no.{0,8}(?:move|moves)|まだ.{0,8}指",text,re.I) else "uncertain" if re.search(r"走|下|move|指",text,re.I) else "missing"
+        if re.search(re.escape(value[:2])+r"\s*(?:→|->|到|to)?\s*"+re.escape(value[2:]),text,re.I):
+            return "covered"
+        cue=r"[a-h][1-8]|上一步|上一個|上一个|last move|直前|さっき"
+    elif key == "check":
+        actor = r"(?:我|私|me|my)" if value["actor"] == "lilith" else r"(?:你|妳|あなた|you|your)"
+        if value["inCheck"]:
+            positive = actor+r"(?:正|現在|现在|目前|的王|の王は|は|\s)*(?:被將軍|被将军|in check|王手されています)"
+        else:
+            positive = actor+r"(?:現在|现在|目前|的王|の王は|は|\s)*(?:沒有被將軍|没有被将军|沒被將軍|not in check|王手されていません)"
+        if re.search(positive,text,re.I):return "covered"
+        cue=r"將軍|将军|check|王手"
+    elif key == "pieces":
+        expected=[f"{chr(97+i%8)}{i//8+1}" for i,c in enumerate(value["board"]) if c != "."]
+        # Coordinates alone cannot prove correct piece names; only the exact
+        # finite notation supported by our renderer is positively recognized.
+        if all(re.search(re.escape(square)+r"\s*:\s*"+re.escape(value["board"][(int(square[1])-1)*8+ord(square[0])-97]),text) for square in expected):
+            return "covered"
+        cue=r"[a-h][1-8]|棋子|pieces?|駒"
+    elif key == "awareness":
+        # Freeform tactical prose is not reliably machine-verifiable. Preserve
+        # it as uncertain; no second request just because it differs from JSON.
+        cue=r"吃|將軍|将军|危險|危险|capture|check|danger|王手|危険|取れる"
+    else:
+        return "uncertain"
+    return "uncertain" if re.search(cue,text,re.I) else "missing"
+
+
+def missing_facts(plan, text):
+    """Return exact missing subset only when recognized, otherwise zero calls."""
+    if (type(text) is not str or not text.strip() or len(text) > 32768
+            or re.search(r"[\"“”「」『』]",text) or _NEGATED_DENIAL.search(text)):
+        return None
+    facts=json.loads(plan.facts_json)
+    statuses={key:_coverage(key,facts[key],text) for key in plan.ids}
+    if all(status=="covered" for status in statuses.values()):
+        return None
+    if _DENIAL.search(text):
+        # A denial about unasked or hidden player information isn't a miss.
+        if re.search(r"(?:你|妳|player|your).{0,8}(?:暗牌|hidden|手牌)",text,re.I):
+            return None
+        relevant=any(re.search(_QUERIES[key],text,re.I) for key in plan.ids)
+        generic=re.search(r"(?:牌局|棋局|局面|對局|对局|遊戲|游戏|game|board).{0,15}(?:資訊|信息|資料|数据|information|data)|(?:information|data).{0,15}(?:game|board)",text,re.I)
+        if not relevant and not generic:
+            return None
+        missing=tuple(key for key in plan.ids if statuses[key] != "covered")
+        return missing,"correction"
+    if text.strip().rstrip(".!。！～~") in _EMPTY_ANSWERS:
+        return plan.ids,"supplement"
+    if "covered" in statuses.values() and "uncertain" not in statuses.values():
+        missing=tuple(key for key in plan.ids if statuses[key] == "missing")
+        return (missing,"supplement") if missing else None
+    return None
+
+
+def missing_kind(plan, text):
+    result=missing_facts(plan,text)
+    return result[1] if result else None
+
+
+def _render(plan, values, kind):
+    locale = plan.locale
+    ja, en, hans = locale == "ja", locale == "en", locale == "zh-Hans"
+    who = {"lilith": "私" if ja else "me" if en else "我", "player": "あなた" if ja else "you" if en else "你"}
+    lines = []
+    for key in plan.ids:
+        value = values[key]
+        if key == "turn":
+            lines.append((f"手番は{who[value]}。" if ja else f"Turn: {who[value]}." if en else f"輪到{who[value]}。"))
+        elif key == "hand-counts":
+            lines.append(f"あなたは{value['player']}枚、私は{value['lilith']}枚。" if ja else f"You have {value['player']} cards; I have {value['lilith']}." if en else f"你有{value['player']}張，我有{value['lilith']}張。")
+        elif key == "self-hand":
+            suits = {"hearts": "ハート" if ja else "hearts " if en else "紅心", "spades": "スペード" if ja else "spades " if en else "黑桃", "none": ""}
+            cards = [(("ジョーカー" if ja else "Joker" if en else "鬼牌") if c["rank"] == "JOKER" else suits[c["suit"]] + c["rank"]) for c in value["cards"]]
+            lines.append(("私の手札、画面の左から右へ：" if ja else "My hand, screen left to right: " if en else "我的手牌，畫面從左到右：") + "、".join(cards) + "。")
+        elif key == "last-move":
+            if not value:
+                lines.append("まだ指された手はありません。" if ja else "No move has been committed yet." if en else "目前尚未走出第一步。")
+            else:
+                lines.append(("直前の手：" if ja else "Last committed move: " if en else "上一個已完成的走步：") + value[:2] + " → " + value[2:4] + (" (" + value[4:] + ")" if len(value) == 5 else "") + "。")
+        elif key == "check":
+            lines.append((f"{who[value['actor']]}の王は" + ("王手されています。" if value["inCheck"] else "王手されていません。")) if ja else (f"The side to move ({who[value['actor']]}) is " + ("in check." if value["inCheck"] else "not in check.")) if en else f"現在輪到{who[value['actor']]}，" + ("正被將軍。" if value["inCheck"] else "沒有被將軍。"))
+        elif key == "pieces":
+            rows = [f"{chr(97+i%8)}{i//8+1}:{c}" for i,c in enumerate(value["board"]) if c != "."]
+            lines.append(("駒の位置（大文字=白、小文字=ピンク、K王/Q后/R車/B象/N馬/P兵）：" if ja else "Pieces (uppercase white, lowercase pink; K king/Q queen/R rook/B bishop/N knight/P pawn): " if en else "棋子位置（大寫白方、小寫粉方；K王/Q后/R車/B象/N馬/P兵）：") + ", ".join(rows) + "。")
+        elif key == "awareness":
+            targets = ", ".join(value["captureTargetSquares"]) or ("なし" if ja else "none" if en else "無")
+            check = ("あり" if value["checkingMoveAvailable"] else "なし") if ja else ("yes" if value["checkingMoveAvailable"] else "no") if en else ("有" if value["checkingMoveAvailable"] else "沒有")
+            lines.append((f"手番側の合法な捕獲対象：{targets}。王手できる合法手：{check}。最善手や詰みの判定ではありません。" if ja else f"Side-to-move legal capture targets: {targets}. A legal checking move exists: {check}. This is not best-move or forced-mate analysis." if en else f"當前行棋方可合法吃子的目標格：{targets}。可將軍的合法走法：{check}；這不是最佳走法或必勝判斷。"))
+    header = (("訂正" if kind == "correction" else "補足") + "（メッセージ送信時の局面）：") if ja else (("Correction" if kind == "correction" else "Supplement") + " (position when you sent the message):") if en else (("更正" if kind == "correction" else "補充") + "（以你送出訊息時的局面為準）：")
+    text = header + "\n" + "\n".join(lines)
+    if hans:
+        for old, new in (("輪", "轮"), ("張", "张"), ("紅", "红"), ("畫", "画"), ("從", "从"), ("個", "个"), ("將", "将"), ("軍", "军"), ("寫", "写"), ("車", "车"), ("馬", "马"), ("當", "当"), ("標", "标"), ("無", "无"), ("這", "这"), ("勝", "胜"), ("斷", "断"), ("補", "补"), ("訊", "讯"), ("時", "时"), ("準", "准")):
+            text = text.replace(old, new)
+    return text
+
