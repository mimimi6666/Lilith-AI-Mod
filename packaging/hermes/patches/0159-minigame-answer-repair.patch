+@dataclass(frozen=True, slots=True, repr=False)
+class AcceptedRepair:
+    _issuer: object
+    _agent: object
+    _origin: object
+    _text_digest: str
+    _context_digest: str
+
+    def __reduce__(self):
+        raise TypeError("accepted game repair is process scoped")
+
+
+def is_accepted_repair(receipt, *, text, agent=None, origin=None):
+    return (type(receipt) is AcceptedRepair and receipt._issuer is _ISSUER
+            and type(text) is str and receipt._text_digest == _digest(text)
+            and (agent is None or receipt._agent is agent)
+            and (origin is None or receipt._origin is origin))
+
+
+def accepted_receipt(agent, text):
+    state = _TURN.get()
+    if (type(state) is _Turn and state.agent is agent
+            and is_accepted_repair(state.receipt, text=text, agent=agent, origin=state.origin)):
+        return state.receipt
+    return None
