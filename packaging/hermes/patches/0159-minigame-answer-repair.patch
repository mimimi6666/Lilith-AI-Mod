+def _parse_response(response, plan):
+    from agent.paired_speech import _sdk_field, _UNAVAILABLE
+    def get(value, key):
+        result = _sdk_field(value, key)
+        return None if result is _UNAVAILABLE else result
+    choices = get(response, "choices")
+    if type(choices) is not list or len(choices) != 1 or get(choices[0], "finish_reason") != "stop":
+        _fail()
+    message = get(choices[0], "message")
+    if get(message, "tool_calls") or get(message, "function_call") or get(message, "refusal"):
+        _fail()
+    content = get(message, "content")
+    if type(content) is not str or not content.strip() or len(content) > MAX_OUTPUT_CHARS:
+        _fail()
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                _fail()
+            result[key] = value
+        return result
+    result = json.loads(content, object_pairs_hook=unique)
+    # Canonical JSON comparison distinguishes bool/int and every exact value.
+    if type(result) is not dict or set(result) != {"facts"} or _json(result["facts"]) != plan.facts_json:
+        _fail()
+    return result["facts"]
+
+
+def _capture_runtime(agent):
+    from agent.auxiliary_client import scoped_runtime_main
+    from agent.plugin_llm import PluginLlm
+    runtime = {}
+    for key in ("provider", "requested_provider", "model", "base_url", "api_key", "api_mode", "auth_mode", "session_id"):
+        value = getattr(agent, key, None)
+        if type(value) is str and value.strip():
+            runtime[key] = value.strip()
+        elif key == "api_key" and (value == "" or callable(value)):
+            runtime[key] = value
+    if not runtime.get("session_id") or runtime.get("provider") == "moa":
+        _fail()
+    with scoped_runtime_main(runtime) as bound:
+        bound["session_id"] = runtime["session_id"]
+        snapshot = PluginLlm(plugin_id="lilith-minigame-answer-repair").capture_runtime_context(task=None)
+    return snapshot, runtime
+
+
+def maybe_repair(agent, original_text):
+    state = _TURN.get()
+    unchanged = RepairResult(original_text)
+    if not eligible(agent) or state.used:
+        return unchanged
+    state.used = True
+    missing = missing_facts(state.plan, original_text)
+    if missing is None:
+        return unchanged
+    ids,kind=missing
+    original_facts=json.loads(state.plan.facts_json)
+    repair_plan=replace(state.plan,ids=ids,facts_json=_json({key:original_facts[key] for key in ids}))
+    deadline = time.monotonic() + DEADLINE_SECONDS
+    cancelled, done = threading.Event(), threading.Event()
+    outcome = {}
+    try:
+        snapshot, route = _capture_runtime(agent)
+        from agent.identity_policy import bind_host_required_auxiliary_messages, identity_lock_required_by_host
+        if not identity_lock_required_by_host():
+            _fail()
+        messages = bind_host_required_auxiliary_messages([
+            {"role": "system", "content": _TASK},
+            {"role": "user", "content": _json({"question": repair_plan.question, "facts": json.loads(repair_plan.facts_json)})}])
+        frozen_messages = _json(messages)
+        def worker():
+            from agent.plugin_llm import PluginLlm
+            def invoke():
+                from agent.auxiliary_client import call_llm, _freeze_auxiliary_main_runtime
+                runtime = _freeze_auxiliary_main_runtime(None)
+                if runtime.get("session_id") != route["session_id"]:
+                    _fail()
+                for name in ("requested_provider", "auth_mode"):
+                    if route.get(name):
+                        runtime[name] = route[name]
+                cap = _Capability(state, runtime, frozen_messages, deadline, cancelled)
+                token = _ACTIVE.set(cap)
+                try:
+                    cap.current()
+                    response = call_llm(task=None, main_runtime=dict(runtime), messages=cap.messages(),
+                        tools=None, stream=False, temperature=0.0, max_tokens=MAX_OUTPUT_TOKENS,
+                        timeout=max(0.001, deadline-time.monotonic()), reasoning_config={"enabled": False})
+                    cap.current()
+                    if cap.attempts != 1:
+                        _fail()
+                    return _parse_response(response, repair_plan)
+                finally:
+                    cap.closed = True
+                    _ACTIVE.reset(token)
+            try:
+                outcome["facts"] = PluginLlm(plugin_id="lilith-minigame-answer-repair").run_in_runtime_context(snapshot, invoke)
+            except BaseException:
+                outcome["failed"] = True
+            finally:
+                done.set()
+        threading.Thread(target=worker, name="lilith-game-answer-repair", daemon=True).start()
+        while not done.wait(0.05):
+            if not state.valid() or time.monotonic() >= deadline:
+                _fail()
+        if not state.valid() or time.monotonic() >= deadline or outcome.get("failed") or "facts" not in outcome:
+            _fail()
+        supplement = _render(repair_plan, outcome["facts"], kind)
+        if len(supplement) > MAX_OUTPUT_CHARS:
+            _fail()
+        combined = original_text.rstrip() + "\n\n" + supplement
+        receipt = AcceptedRepair(_ISSUER, agent, state.origin, _digest(combined), _digest(state.plan.context.wire))
+        state.receipt = receipt
+        return RepairResult(combined, True, kind, receipt)
+    except Exception:
+        return RepairResult(original_text, False, "unavailable")
