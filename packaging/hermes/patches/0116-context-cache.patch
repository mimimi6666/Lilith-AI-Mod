+class DiagnosticTests(unittest.TestCase):
+    def setUp(self):
+        self.agent = SimpleNamespace(session_id="s", model="model", provider="provider", api_mode="chat_completions", base_url="https://example.test")
+        self.request = {"model": "fixture", "tools": [{"type": "function", "function": {"name": "fixture"}}],
+            "messages": [{"role": "system", "content": "stable policy"},
+                         {"role": "user", "content": "private sentry "+"a"*3000},
+                         {"role": "assistant", "content": "answer", "reasoning_content": "reasoning sentry"}]}
+
+    def test_identical_request_is_counted_and_never_mutated(self):
+        before = deepcopy(self.request)
+        first = record_request_prefix(self.agent, self.request)
+        second = record_request_prefix(self.agent, self.request)
+        self.assertEqual(first["status"], "baseline")
+        self.assertEqual(second["first_changed_kind"], "none")
+        self.assertEqual(second["payload_chars"], second["common_prefix_chars_lower_bound"])
+        self.assertEqual(self.request, before)
+        self.assertEqual(second["reasoning_chars"], len("reasoning sentry"))
+
+    def test_tail_append_keeps_full_old_prefix(self):
+        first = record_request_prefix(self.agent, self.request)
+        self.request["messages"].append({"role": "user", "content": "new input"})
+        last = record_request_prefix(self.agent, self.request)
+        self.assertEqual(last["common_prefix_chars_lower_bound"], first["payload_chars"])
+        self.assertEqual(last["first_changed_message"], 3)
+
+    def test_system_tool_and_old_history_changes_classified(self):
+        for kind, index in (("system", 0), ("user", 1), ("tools", None)):
+            with self.subTest(kind=kind):
+                self.setUp()
+                record_request_prefix(self.agent, self.request)
+                if index is None: self.request["tools"].append({"type": "function", "function": {"name": "second"}})
+                else: self.request["messages"][index]["content"] = "changed"
+                status = record_request_prefix(self.agent, self.request)
+                self.assertEqual(status["first_changed_kind"], kind)
+                self.assertEqual(status["first_changed_message"], index)
+
+    def test_inner_message_chunk_prefix_is_lower_bound(self):
+        first = record_request_prefix(self.agent, self.request)
+        self.request["messages"][1]["content"] += "new tail"
+        last = record_request_prefix(self.agent, self.request)
+        self.assertGreater(last["common_prefix_chars_lower_bound"], 2000)
+        self.assertLess(last["common_prefix_chars_lower_bound"], first["payload_chars"])
+
+    def test_no_content_digests_routes_or_salts_in_logs(self):
+        with self.assertLogs("agent.request_cache_diagnostics", level="INFO") as logs:
+            record_request_prefix(self.agent, self.request)
+        logged = "\n".join(logs.output)
+        for sentry in ("private sentry", "reasoning sentry", "example.test", "stable policy", "fixture"):
+            self.assertNotIn(sentry, logged)
+        stored = repr(self.agent._request_cache_trace)
+        self.assertNotIn("private sentry", stored)
+        self.assertNotIn("reasoning sentry", stored)
+        self.assertNotIn(self.agent._request_cache_trace["key"].hex(), logged)
+
+    def test_route_or_session_change_rebaselines(self):
+        record_request_prefix(self.agent, self.request)
+        self.agent.session_id = "new"
+        self.assertEqual(record_request_prefix(self.agent, self.request)["status"], "baseline")
+
+    def test_unsupported_and_oversized_requests_do_not_raise_or_mutate(self):
+        for value in ({"messages": "unsupported"}, {"messages": [{"content": object()}]}, {"messages": [{}]*4097}):
+            self.assertIsNone(record_request_prefix(self.agent, value))
+        before = deepcopy(self.request)
+        with patch("agent.request_cache_diagnostics._MAX_CHARS", 20):
+            self.assertIsNone(record_request_prefix(self.agent, self.request))
+        self.assertEqual(before, self.request)
+
+    def test_log_failure_does_not_break_send(self):
+        with patch("agent.request_cache_diagnostics.logger.info", side_effect=RuntimeError("private error sentry")):
+            self.assertIsNone(record_request_prefix(self.agent, self.request))
+
+    def test_reasoning_and_tool_arguments_counted_separately(self):
+        self.request["messages"][-1]["tool_calls"] = [{"id": "c", "function": {"name": "fixture", "arguments": "{\"x\":1}"}}]
+        status = record_request_prefix(self.agent, self.request)
