diff --git a/tests/test_context_cache.py b/tests/test_context_cache.py
new file mode 100644
--- /dev/null
+++ b/tests/test_context_cache.py
@@ -0,0 +1,268 @@
+from copy import deepcopy
+import json
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import NormalBudget, VerifiedModelLimits, resolve_policy, TurnBudgetLedger
+from agent.usage_budget_context import capture_completed_history, _strategy_projection_units
+from agent.usage_strategy import strategy_for_level
+from agent.usage_strategy_context import project_context
+from agent.history_checkpoint import detail_chars
+from agent.request_cache_diagnostics import record_request_prefix
+
+
+def origin(name, level=4, revision=1):
+    policy = resolve_policy(level, NormalBudget(), VerifiedModelLimits(), version=revision)
+    return SimpleNamespace(origin_id=name, ledger=TurnBudgetLedger(name, policy))
+
+
+def history(turns, *, size=0, sidecars=False):
+    rows = []
+    for i in range(turns):
+        user = {"role": "user", "content": "question " + str(i)}
+        if sidecars:
+            user["api_content"] = user["content"] + "\n\n[Subordinate operational context: pre_llm_call plugin context]\n" + "stable context " * 40 + "\n[End subordinate operational context: pre_llm_call plugin context]"
+        rows.extend([user,
+            {"role": "assistant", "content": "", "reasoning_content": "r" * size,
+             "tool_calls": [{"id": "c" + str(i), "type": "function", "function": {"name": "fixture", "arguments": "{}"}}]},
+            {"role": "tool", "tool_call_id": "c" + str(i), "content": "result " + str(i)},
+            {"role": "assistant", "content": "answer " + str(i), "reasoning_content": "required reasoning"}])
+    rows.append({"role": "user", "content": "current"})
+    return rows
+
+
+class Compressor:
+    def __init__(self):
+        self.calls = []
+        self._previous_summary = "original compressor must not change"
+
+    def _generate_summary(self, rows):
+        self.calls.append((deepcopy(rows), self._previous_summary))
+        return "Synthetic summary checkpoint " + str(len(self.calls))
+
+
+class CheckpointTests(unittest.TestCase):
+    def setUp(self):
+        self.agent = SimpleNamespace(session_id="fixture", model="model", provider="provider",
+            api_mode="chat_completions", context_compressor=Compressor())
+
+    def project(self, rows, name="first", handle=None):
+        handle = handle or origin(name)
+        selected = capture_completed_history(rows, len(rows)-1)
+        projected = [{"role": "system", "content": "protected system"}] + deepcopy(rows)
+        from agent.turn_context import substitute_api_content
+        for row in projected[1:]:
+            substitute_api_content(row)
+        units = _strategy_projection_units(self.agent, selected, rows, projected, 1)
+        return project_context(self.agent, projected, units, strategy_for_level(handle.ledger.policy.level),
+                               handle, source=rows, history_offset=1)
+
+    def test_small_updates_keep_published_prefix_and_two_turn_summary_cadence(self):
+        base = self.project(history(36, sidecars=True))
+        for n in (37, 38, 39, 40, 41):
+            result = self.project(history(n, sidecars=True), str(n))
+            self.assertEqual(result[:len(base)-1], base[:-1])
+            self.assertEqual(self.agent._information_summary["covered"].__len__(), 12)
+        calls = self.agent.context_compressor.calls
+        self.assertEqual([len(rows) for rows, _ in calls], [48, 8, 8])
+        self.assertEqual(calls[-1][1], "Synthetic summary checkpoint 2")
+
+    def test_six_new_old_turns_publish_together_and_retain_latest_24(self):
+        base = self.project(history(36))
+        for n in range(37, 43):
+            out = self.project(history(n), str(n))
+        self.assertNotEqual(out[1], base[1])
+        status = self.agent._usage_budget_context_status
+        self.assertEqual(status["summarized_turns"], 18)
+        self.assertEqual(status["pending_summarized_turns"], 0)
+        self.assertEqual(status["checkpoint_publication"], "batch")
+        self.assertEqual([r["content"] for r in out if r["role"] == "user" and r["content"].startswith("question")],
+                         ["question " + str(i) for i in range(18, 42)])
+
+    def test_reasoning_size_triggers_whole_exchange_summary_before_age_limit(self):
+        rows = history(24, size=15000)
+        before = deepcopy(rows)
+        out = self.project(rows)
+        self.assertGreater(self.agent._usage_budget_context_status["summarized_turns"], 0)
+        self.assertEqual(self.agent._usage_budget_context_status["checkpoint_publication"], "history_size")
+        self.assertLess(detail_chars(out), detail_chars(rows) * .6)
+        self.assertEqual(rows, before)
+        self.assertEqual(out[-9:], rows[-9:])  # two latest exchanges + current
+        calls = {c["id"] for r in out for c in r.get("tool_calls", ())}
+        self.assertEqual(calls, {r["tool_call_id"] for r in out if r["role"] == "tool"})
+        for r in out:
+            if r["role"] == "assistant": self.assertIn("reasoning_content", r)
+
+    def test_current_and_unverifiable_rows_are_never_discarded_for_size(self):
+        rows = history(5)
+        rows[1]["tool_calls"][0]["function"]["arguments"] = "bad JSON"
+        rows[1]["reasoning_content"] = "private current task " * 20000
+        rows[-1]["content"] = "large current " * 20000
+        out = self.project(rows)
+        self.assertEqual(out[-1], rows[-1])
+        self.assertIn(rows[1], out)
+
+    def test_latest_two_huge_turns_preserved_without_hard_rejection(self):
+        rows = history(4, size=200000)
+        out = self.project(rows)
+        self.assertEqual(out[-9:], rows[-9:])
+        self.assertGreater(detail_chars(out), 144000)
+
+    def test_summary_failure_keeps_all_original_reasoning_and_pairs(self):
+        self.agent.context_compressor._generate_summary = lambda _: None
+        rows = history(24, size=15000)
+        self.assertEqual(self.project(rows)[1:], rows)
+        self.assertEqual(self.agent._information_summary["covered"], ())
+
+    def test_stop_during_summary_does_not_publish_or_accept_pending(self):
+        handle = origin("stopped")
+        def stopped(_):
+            handle.ledger.stop()
+            return "must not publish"
+        self.agent.context_compressor._generate_summary = stopped
+        rows = history(36)
+        self.assertEqual(self.project(rows, handle=handle)[1:], rows)
+        self.assertEqual(self.agent._information_summary["pending_covered"], ())
+
+    def test_staged_summary_is_not_duplicated_in_payload(self):
+        self.project(history(36))
+        out = self.project(history(38), "second")
+        self.assertEqual(self.agent._usage_budget_context_status["pending_summarized_turns"], 2)
+        self.assertNotIn("Synthetic summary checkpoint 2", json.dumps(out))
+        self.assertIn("question 12", json.dumps(out))
+
+    def test_edit_invalidates_pending_and_committed_proof(self):
+        self.project(history(36))
+        self.project(history(38), "second")
+        rows = history(38)
+        rows[0]["content"] = "corrected source"
+        self.project(rows, "third")
+        self.assertIsNone(self.agent.context_compressor.calls[-1][1])
+        self.assertIn("corrected source", json.dumps(self.agent.context_compressor.calls[-1][0]))
+
+    def test_rewind_never_injects_deleted_summary(self):
+        self.project(history(36))
