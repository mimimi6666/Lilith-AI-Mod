--- /dev/null
+++ b/agent/request_cache_diagnostics.py
@@ -0,0 +1,123 @@
+"""Best-effort assembled-request comparison, never provider cache accounting.
+
+Only keyed digests/lengths survive this call. Logs contain neither prompt text,
+route, URLs, digests nor random keys. No requests, persistence or authority.
+"""
+import hashlib
+import hmac
+import json
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+_MAX_CHARS = 8_000_000
+_MAX_MESSAGES = 4096
+_CHUNK = 1024
+
+
+def _text(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(",", ":"), allow_nan=False)
+
+
+def _digest(key, value):
+    return hmac.new(key, value.encode("utf-8"), hashlib.sha256).digest()
+
+
+def _size(value):
+    if value is None:
+        return 0
+    return len(value) if isinstance(value, str) else len(_text(value))
+
+
+def record_request_prefix(agent, request):
+    """Observe the final assembled attempt without retaining or changing it.
+
+    This runs after hooks and before dispatch. Retries/failed sends may appear;
+    the next API usage event, not this diagnostic, owns actual billed tokens.
+    Malformed/huge/unsupported requests remain sendable by the native path.
+    """
+    try:
+        return _record(agent, request)
+    except Exception:
+        # Do not log exceptions: serializers/providers can include private data.
+        try:
+            agent._request_cache_trace = None
+            agent._request_cache_diagnostics_status = {"status": "unavailable"}
+            logger.info("[request_prefix] %s", '{"status":"unavailable"}')
+        except Exception:
+            pass
+        return None
+
+
+def _record(agent, request):
+    if not isinstance(request, dict):
+        raise ValueError("shape")
+    rows = request.get("messages", request.get("input"))
+    if not isinstance(rows, list) or len(rows) > _MAX_MESSAGES:
+        raise ValueError("shape")
+    previous = getattr(agent, "_request_cache_trace", None)
+    key = previous["key"] if isinstance(previous, dict) else os.urandom(32)
+    route = _digest(key, _text(tuple(str(getattr(agent, field, "")) for field in
+                    ("session_id", "provider", "model", "api_mode", "base_url"))))
+    parts = [("setup", None, {field: request[field] for field in
+              ("model", "thinking", "reasoning_effort", "response_format") if field in request}),
+             ("tools", None, request.get("tools")),
+             ("system", None, {field: request[field] for field in
+              ("system", "instructions") if field in request})]
+    counts = {"system_chars": _size(request.get("system")) + _size(request.get("instructions")),
+              "content_chars": 0, "reasoning_chars": 0, "tool_argument_chars": 0,
+              "tool_schema_chars": _size(request.get("tools"))}
+    for index, row in enumerate(rows):
+        if not isinstance(row, dict):
+            raise ValueError("message")
+        role = row.get("role")
+        kind = role if role in ("system", "developer", "user", "assistant", "tool") else "other"
+        parts.append((kind, index, row))
+        counts["system_chars" if kind in ("system", "developer") else "content_chars"] += _size(row.get("content"))
+        counts["reasoning_chars"] += _size(row.get("reasoning_content")) + _size(row.get("reasoning_details"))
+        for call in row.get("tool_calls") or ():
+            if isinstance(call, dict) and isinstance(call.get("function"), dict):
+                counts["tool_argument_chars"] += _size(call["function"].get("arguments"))
+    snapshots, total = [], 0
+    for kind, index, value in parts:
+        text = _text(value)
+        total += len(text)
+        if total > _MAX_CHARS:
+            raise ValueError("size")
+        chunks = tuple(_digest(key, text[start:start + _CHUNK]) for start in range(0, len(text), _CHUNK))
+        snapshots.append((kind, index, len(text), _digest(key, text), chunks))
+    matched, common = 0, 0
+    comparable = isinstance(previous, dict) and previous.get("route") == route
+    if comparable:
+        for old, new in zip(previous["parts"], snapshots):
+            if old[:4] == new[:4]:
+                matched += 1
+                common += new[2]
+                continue
+            if old[:2] == new[:2]:
+                for chunk_index, (old_chunk, new_chunk) in enumerate(zip(old[4], new[4])):
+                    if old_chunk != new_chunk:
+                        break
+                    common += min(_CHUNK, old[2] - chunk_index * _CHUNK, new[2] - chunk_index * _CHUNK)
+            break
+    changed = snapshots[matched] if matched < len(snapshots) else None
+    same = comparable and matched == len(snapshots) == len(previous["parts"])
+    status = {
+        "status": "compared" if comparable else "baseline",
+        "measurement": "assembled_payload_serialized_characters_not_provider_tokens",
+        "attempt": previous.get("attempt", 0) + 1 if comparable else 1,
+        "messages": len(rows), "payload_chars": total,
+        "common_prefix_chars_lower_bound": common,
+        "first_changed_kind": "none" if same else changed[0] if changed else "removed_tail",
+        "first_changed_message": changed[1] if comparable and changed else None,
+        **counts,
+    }
+    projection = getattr(agent, "_usage_budget_context_status", {})
+    publication = projection.get("checkpoint_publication") if isinstance(projection, dict) else None
+    if publication in ("batch", "history_size", "staged", "unchanged"):
+        status["checkpoint_publication"] = publication
+    agent._request_cache_trace = {"key": key, "route": route, "parts": tuple(snapshots), "attempt": status["attempt"]}
+    agent._request_cache_diagnostics_status = status
+    logger.info("[request_prefix] %s", json.dumps(status, sort_keys=True))
+    return status
