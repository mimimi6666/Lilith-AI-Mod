+++ b/agent/history_checkpoint.py
@@ -0,0 +1,55 @@
+"""Pure soft history-size/publication rules. No storage, quotas or authority."""
+import json
+
+
+def detail_chars(rows):
+    """Measure retained text, including reasoning and call arguments, not tokens.
+
+    Count reasoning_content once rather than its duplicate trajectory field.
+    Unknown/structured content is measured but never rewritten here.
+    """
+    total = 0
+    for row in rows:
+        for key in ("content", "reasoning_content", "reasoning_details", "tool_calls"):
+            value = row.get(key)
+            if value is None:
+                continue
+            total += len(value) if isinstance(value, str) else len(
+                json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
+    return total
+
+
+def history_limit(spec):
+    return spec.history_turns * spec.old_tool_chars
+
+
+def select_old_units(projected, units, replacements, spec):
+    """Select a prefix of already-certified exchanges; never individual fields.
+
+    The capture excludes the latest completed exchange. Protect one more here,
+    including from size-triggered selection. Current/unknown/unclosed rows are
+    not in units and cannot become disposable merely because they are large.
+    """
+    sizes = [detail_chars([replacements.get(i, projected[i]) for i in unit])
+             for unit in units]
+    count = max(0, len(units) - (spec.history_turns - 1))
+    retained = sum(sizes[count:])
+    while count < len(units) - 1 and retained > history_limit(spec):
+        retained -= sizes[count]
+        count += 1
+    return count, sizes
+
+
+def publication_reason(state, sizes, spec):
+    covered, pending = len(state["covered"]), len(state["pending_covered"])
+    if pending <= covered:
+        return "unchanged"
+    old_size = sum(sizes[:pending])
+    # A malformed/overlong summary cannot be advertised as a size reduction.
+    if len(state["pending_summary"]) >= old_size:
+        return "not_smaller"
+    if sum(sizes[covered:]) > history_limit(spec):
+        return "history_size"
+    if pending - covered >= max(spec.summary_every, max(1, spec.history_turns // 4)):
+        return "batch"
+    return "staged"
