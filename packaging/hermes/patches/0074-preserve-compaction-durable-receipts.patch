diff --git a/tests/agent/test_compaction_durable_receipts.py b/tests/agent/test_compaction_durable_receipts.py
new file mode 100644
--- /dev/null
+++ b/tests/agent/test_compaction_durable_receipts.py
@@ -0,0 +1,183 @@
+"""Real SQLite regressions for compaction timestamps and failed publication."""
+
+import copy
+import os
+import types
+from unittest.mock import patch
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture(autouse=True)
+def no_model_or_network(monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("network is forbidden in durability tests")
+    monkeypatch.setattr("socket.socket.connect", forbidden)
+    monkeypatch.setattr("agent.conversation_compression.check_compression_model_feasibility", lambda agent: None)
+
+
+def make_agent(db):
+    from run_agent import AIAgent
+
+    with patch.dict(os.environ, {"OPENROUTER_API_KEY": "test-key"}):
+        agent = AIAgent(
+            api_key="test-key", base_url="https://openrouter.ai/api/v1",
+            model="test/model", quiet_mode=True, session_db=db,
+            session_id="chat", skip_context_files=True, skip_memory=True,
+            enabled_toolsets=[],
+        )
+    agent.compression_in_place = True
+    return agent
+
+
+def test_compaction_accepts_durable_live_timestamp_without_refreshing_recency(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        agent = make_agent(db)
+        messages = [{"role": "user", "content": "question"},
+                    {"role": "assistant", "content": "answer"}]
+        agent._flush_messages_to_session_db(messages, [])
+        before = db.get_messages("chat")
+        assert messages[0]["_durable_timestamp"] == before[0]["timestamp"]
+        compacted = copy.deepcopy(messages)
+        for row in compacted:
+            row.pop("_db_persisted", None)
+        db.archive_and_compact("chat", compacted)
+        after = db.get_messages("chat")
+        assert [m["timestamp"] for m in after] == [m["timestamp"] for m in before]
+        assert all(row["_db_persisted"] is True for row in compacted)
+        assert [row["_row_id"] for row in compacted] == [row["id"] for row in after]
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("timestamp", [None, True, float("nan"), float("inf"), -1.0, 0.0])
+def test_compaction_rejects_missing_or_invalid_authored_clock(tmp_path, timestamp):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("chat", source="cli")
+        db.append_message("chat", "user", "original", timestamp=10.0)
+        before = db.get_messages("chat", include_inactive=True)
+        with pytest.raises(ValueError, match="durable timestamp"):
+            db.archive_and_compact("chat", [{"role": "user", "content": "tail", "timestamp": timestamp}])
+        assert db.get_messages("chat", include_inactive=True) == before
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("in_place", [True, False])
+def test_failed_compaction_does_not_publish_rolled_back_row_receipts(tmp_path, in_place):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("chat", source="cli")
+        db.append_message("chat", "user", "original", timestamp=10.0)
+        before = db.get_messages("chat", include_inactive=True)
+        compacted = [{"role": "user", "content": "valid", "timestamp": 10.0},
+                     {"role": "assistant", "content": "missing timestamp"}]
+        snapshot = copy.deepcopy(compacted)
+        with pytest.raises(ValueError, match="durable timestamp"):
+            if in_place:
+                db.archive_and_compact("chat", compacted)
+            else:
+                db.publish_compression_child(
+                    parent_session_id="chat", child_session_id="child", source="cli",
+                    messages=compacted, require_compression_lease=False,
+                )
+        assert compacted == snapshot
+        assert db.get_messages("chat", include_inactive=True) == before
+        assert db.get_session("chat")["ended_at"] is None
+        assert db.get_session("child") is None
+    finally:
+        db.close()
+
+
+def test_in_place_write_failure_keeps_original_context_and_no_completion_event(tmp_path):
+    from agent.conversation_compression import compress_context
+    from agent.context_compressor import ContextCompressor
+
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        agent = make_agent(db)
+        messages = [{"role": "user" if i % 2 == 0 else "assistant",
+                     "content": f"original {i}"} for i in range(12)]
+        agent._flush_messages_to_session_db(messages, [])
+        snapshot = copy.deepcopy(messages)
+        originals = list(messages)
+        before = db.get_messages("chat", include_inactive=True)
+        compressor = ContextCompressor(model="test/model", quiet_mode=True)
+        agent.context_compressor = compressor
+        events = []
+        agent.event_callback = lambda name, data: events.append(name)
+        agent._cached_system_prompt = "original system"
+        agent._cached_system_prompt_static = "original"
+        agent._identity_legacy_history_v1 = {"cutoff": 12}
+        agent._session_init_model_config["_identity_legacy_history_v1"] = {"cutoff": 12}
+        with patch.object(compressor, "compress", return_value=copy.deepcopy(messages[-2:])), \
+             patch.object(db, "archive_and_compact", side_effect=OSError("injected write failure")):
+            result, prompt = compress_context(agent, messages, "original system", force=True)
+        assert result == snapshot
+        assert all(a is b for a, b in zip(result, originals))
+        assert prompt == "original system"
+        assert agent._cached_system_prompt_static == "original"
+        assert agent._identity_legacy_history_v1 == {"cutoff": 12}
+        assert agent._session_init_model_config["_identity_legacy_history_v1"] == {"cutoff": 12}
+        assert "session:compress" not in events
+        assert not getattr(agent, "_last_compaction_in_place", False)
+        assert agent._last_compression_attempt_in_place is None
+        assert db.get_messages("chat", include_inactive=True) == before
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("in_place", [True, False])
+def test_preflight_compression_acknowledges_exact_committed_copy(tmp_path, in_place):
+    from agent.context_compressor import ContextCompressor
+    from agent.turn_context import build_turn_context
+
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        agent = make_agent(db)
+        history = [{"role": "user" if i % 2 == 0 else "assistant",
+                    "content": f"old {i}"} for i in range(12)]
+        agent._flush_messages_to_session_db(history, [])
+        agent.compression_enabled = True
+        agent.compression_in_place = in_place
+        compressor = ContextCompressor(model="test/model", quiet_mode=True)
+        agent.context_compressor = compressor
+        agent._relay_pending_turn_id = "11111111111111111111111111111111"
+        agent._relay_pending_user_message_id = "22222222222222222222222222222222"
+        agent._relay_pending_assistant_message_id = "33333333333333333333333333333333"
+        receipts = []
+        agent._relay_turn_durable_callback = receipts.append
+
+        def compact(messages, **kwargs):
+            result = copy.deepcopy(messages[-3:])
+            for row in result:
+                row.pop("_db_persisted", None)
+            return result
+
+        with patch.object(compressor, "should_compress", return_value=True), \
+             patch.object(compressor, "compress", side_effect=compact), \
+             patch("agent.turn_context._should_run_preflight_estimate", return_value=True):
+            ctx = build_turn_context(
+                agent, "new question", "system", history, None, None, None,
+                persist_user_timestamp=123456.0,
+                restore_or_build_system_prompt=lambda *a, **k: "system",
+                install_safe_stdio=lambda: None, sanitize_surrogates=lambda s: s,
+                summarize_user_message_for_log=lambda s: s,
+                set_session_context=lambda sid: None,
+                set_current_write_origin=lambda origin: None,
+                ra=lambda: types.SimpleNamespace(_set_interrupt=lambda *a, **k: None),
+            )
+        assert len(receipts) == 1
+        row = next(m for m in db.get_messages(agent.session_id) if m["content"] == "new question")
+        assert receipts[0]["durable"]["row_id"] == row["id"]
+        assert receipts[0]["durable"]["timestamp"] == 123456.0
+        assert receipts[0]["turn_id"] == "11111111111111111111111111111111"
+        assert receipts[0]["durable"]["turn_origin"] == "user"
+        assert ctx.messages[ctx.current_turn_user_idx]["_row_id"] == row["id"]
+        assert len([m for m in db.get_messages(agent.session_id) if m["content"] == "new question"]) == 1
+    finally:
+        db.close()
