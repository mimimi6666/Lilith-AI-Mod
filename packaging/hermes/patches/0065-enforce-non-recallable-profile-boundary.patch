diff --git a/agent/memory_manager.py b/agent/memory_manager.py
index a5af9f2688b9a2d2f633814b7ed8fd9576d248b9..b15e46882213ff7bba23af5c255de8d7bae776e3 100644
--- a/agent/memory_manager.py
+++ b/agent/memory_manager.py
@@ -566,6 +566,106 @@ class MemoryManager:
 
         return None
 
+    def intercept_memory_write(
+        self,
+        tool_args: Dict[str, Any],
+        *,
+        build_metadata: Optional[Callable[[], Dict[str, Any]]] = None,
+    ) -> Optional[Any]:
+        """Run provider pre-write policy, then preserve USER.md authority.
+
+        A provider may reject or reroute a model write before either built-in
+        memory file changes. ``target=user`` still fails closed through the
+        existing authoritative handler when no general interception occurred.
+        """
+
+        metadata: Optional[Dict[str, Any]] = None
+        for provider in self._providers:
+            if provider.name == "builtin":
+                continue
+            try:
+                owns_writes = provider.owns_user_profile_writes()
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed its user-profile authority check",
+                    provider.name,
+                    exc_info=True,
+                )
+                return tool_error(
+                    "The authoritative user-profile memory is unavailable; no built-in memory write was made.",
+                    success=False,
+                )
+            if not owns_writes:
+                continue
+            try:
+                if metadata is None:
+                    metadata = dict(build_metadata() if build_metadata else {})
+                result = provider.intercept_memory_write(
+                    dict(tool_args),
+                    metadata=dict(metadata),
+                )
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed its pre-write policy",
+                    provider.name,
+                    exc_info=True,
+                )
+                return tool_error(
+                    "The authoritative user-profile memory could not validate this write; no built-in memory write was made.",
+                    success=False,
+                )
+            if result is not None:
+                return result
+            break
+
+        if str(tool_args.get("target") or "memory") != "user":
+            return None
+        return self.intercept_user_profile_write(
+            tool_args,
+            build_metadata=(lambda: dict(metadata or {})),
+        )
+
+    def filter_session_search_result(
+        self,
+        tool_args: Dict[str, Any],
+        result: str,
+    ) -> str:
+        """Apply the authoritative profile provider's transcript boundary."""
+
+        filtered = result
+        for provider in self._providers:
+            if provider.name == "builtin":
+                continue
+            try:
+                if not provider.owns_user_profile_writes():
+                    continue
+                candidate = provider.filter_session_search_result(
+                    dict(tool_args),
+                    filtered,
+                )
+            except Exception:
+                logger.warning(
+                    "Memory provider '%s' failed its session-search filter",
+                    provider.name,
+                    exc_info=True,
+                )
+                return tool_error(
+                    "Session history was withheld because player-profile visibility could not be verified.",
+                    success=False,
+                )
+            if not isinstance(candidate, str):
+                logger.warning(
+                    "Memory provider '%s' returned an invalid session-search result",
+                    provider.name,
+                )
+                return tool_error(
+                    "Session history was withheld because player-profile visibility could not be verified.",
+                    success=False,
+                )
+            filtered = candidate
+            break
+        return filtered
+
     # -- System prompt -------------------------------------------------------
 
     def build_system_prompt(self) -> str:
