@@ -0,0 +1,1444 @@
+"""Durable proactive continuations for official Lilith native dialogue."""
+
+from __future__ import annotations
+
+import json
+import hashlib
+import os
+import sys
+import threading
+import types
+
+import pytest
+
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+EVENT_ID = "0123456789abcdef0123456789abcdef"
+
+
+def _append_params(**overrides):
+    value = {
+        "session_id": "game-live",
+        "event_id": EVENT_ID,
+        "text": "又在寫代碼呀……",
+        "occurred_at_unix_ms": 1787932800123,
+        "node_id": "700324",
+        "line_id": "2200001",
+        "trigger": "native.dialogue.complete",
+        "locale": "zh-Hant",
+        "source": "lilith-native",
+        "require_durable_lineage": True,
+    }
+    value.update(overrides)
+    return value
+
+
+def _extend_params(**overrides):
+    perception = {
+        "schema_version": 1,
+        "source": "official-native-dialogue",
+        "text": "又在寫代碼呀……",
+        "occurred_at_unix_ms": 1787932800123,
+        "node_id": "700324",
+        "line_id": "2200001",
+        "trigger": "native.dialogue.complete",
+        "locale": "zh-Hant",
+    }
+    value = {
+        "session_id": "game-live",
+        "event_id": EVENT_ID,
+        "proactive_dialogue_enabled": True,
+        "perception": perception,
+        "source": "lilith-native",
+        "require_durable_lineage": True,
+    }
+    value.update(overrides)
+    return value
+
+
+class _FakeAgent:
+    def __init__(self, output: str):
+        self._cached_system_prompt = "You are Lilith."
+        self.ephemeral_system_prompt = None
+        self._ephemeral_max_output_tokens = None
+        self._interrupt_requested = False
+        self._session_messages = []
+        self._session_db = None
+        self.provider = "test"
+        self.model = "test-model"
+        self.api_mode = "chat_completions"
+        self.output = output
+        self.calls = 0
+        self.interrupt_calls = 0
+        self.requests = []
+        self.entered = threading.Event()
+        self.release = None
+
+    def clear_interrupt(self):
+        self._interrupt_requested = False
+
+    def interrupt(self):
+        self.interrupt_calls += 1
+        self._interrupt_requested = True
+
+    def _copy_reasoning_content_for_api(self, _source, _projected):
+        return None
+
+    def _build_system_prompt(self, _system_message):
+        return "You are Lilith."
+
+    def _sanitize_api_messages(self, messages):
+        return messages
+
+    def _drop_thinking_only_and_merge_users(self, messages):
+        return messages
+
+    def _build_api_kwargs(self, messages, tools_for_api=None):
+        assert tools_for_api == []
+        return {"model": self.model, "messages": messages}
+
+    def _interruptible_api_call(
+        self,
+        kwargs,
+        *,
+        physical_attempt_limit=None,
+    ):
+        assert physical_attempt_limit == 1
+        self.calls += 1
+        self.requests.append(kwargs)
+        self.entered.set()
+        if self.release is not None:
+            self.release.wait(timeout=5)
+        return types.SimpleNamespace(output=self.output)
+
+    def _get_transport(self):
+        return types.SimpleNamespace(
+            normalize_response=lambda response: types.SimpleNamespace(
+                content=response.output
+            )
+        )
+
+
+@pytest.fixture
+def extension_session(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("game-root", source="lilith-game", archived=True)
+    agent = _FakeAgent('{"decision":"reply","text":"嗯，別忘了休息。"}')
+    session = {
+        "agent": agent,
+        "archived": True,
+        "cols": 80,
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "inflight_turn": None,
+        "profile_home": None,
+        "queued_prompt": None,
+        "running": False,
+        "session_key": "game-root",
+        "source": "lilith-game",
+        "transport": None,
+        "_durable_lineage_root": "game-root",
+    }
+    emitted = []
+    terminal_event = threading.Event()
+    existing = set(server._sessions)
+    server._sessions["game-live"] = session
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda *_args: False)
+    def emit(event, sid, payload=None):
+        emitted.append((event, sid, payload))
+        if event == "message.complete":
+            terminal_event.set()
+
+    monkeypatch.setattr(server, "_emit", emit)
+    append = server._methods["session.append_assistant_event"](
+        "append-native",
+        _append_params(),
+    )
+    assert "error" not in append
+    emitted.clear()
+    session["_test_native_extension_terminal"] = terminal_event
+    try:
+        yield db, session, agent, emitted
+    finally:
+        thread = session.get("_run_thread")
+        if thread is not None and thread.is_alive():
+            if agent.release is not None:
+                agent.release.set()
+            thread.join(timeout=5)
+        for sid in set(server._sessions) - existing:
+            server._sessions.pop(sid, None)
+        db.close()
+
+
+def _extend(params=None):
+    return server._methods["session.extend_native_assistant_event"](
+        "extend-native",
+        params or _extend_params(),
+    )
+
+
+def _join(session):
+    terminal = session["_test_native_extension_terminal"]
+    assert terminal.wait(timeout=5)
+    thread = session.get("_run_thread")
+    if thread is not None:
+        thread.join(timeout=5)
+        assert not thread.is_alive()
+    assert "_run_thread" not in session
+
+
+def test_reply_is_one_model_attempt_one_primary_assistant_and_no_user_row(
+    extension_session,
+):
+    db, session, agent, emitted = extension_session
+
+    response = _extend()
+    assert "error" not in response
+    receipt = response["result"]
+    assert set(receipt) == {
+        "status",
+        "event_id",
+        "turn_id",
+        "assistant_message_id",
+        "already_processed",
+        "attempted",
+    }
+    assert receipt["status"] == "streaming"
+    assert receipt["already_processed"] is False
+    assert receipt["attempted"] is True
+    assert len(receipt["turn_id"]) == 32
+    assert len(receipt["assistant_message_id"]) == 32
+    assert receipt["turn_id"] != receipt["assistant_message_id"]
+
+    _join(session)
+
+    assert agent.calls == 1
+    sent = agent.requests[0]["messages"]
+    assert sent[-1]["role"] == "user"
+    assert "NOT a player/user utterance" in sent[-1]["content"]
+    assert "official-native-dialogue" in sent[-1]["content"]
+    # Provider-facing control context never enters the durable transcript.
+    rows = db._conn.execute(
+        "SELECT role, display_kind, display_metadata FROM messages ORDER BY id"
+    ).fetchall()
+    assert [row["role"] for row in rows] == ["assistant", "assistant"]
+    assert rows[1]["display_kind"] == "native_assistant_extension"
+    metadata = json.loads(rows[1]["display_metadata"])
+    assert metadata == {
+        "lilith_native_extension_event_id": EVENT_ID,
+        "hermes_turn_id": receipt["turn_id"],
+        "hermes_message_id": receipt["assistant_message_id"],
+        "hermes_message_kind": "primary",
+        "hermes_turn_origin": "synthetic",
+        "hermes_turn_origin_kind": "lilith-native-extension",
+    }
+
+    history = server._methods["session.history"](
+        "history",
+        {"session_id": "game-live"},
+    )["result"]["messages"]
+    assert [message["role"] for message in history] == ["assistant", "assistant"]
+    assert history[-1]["text"] == "嗯，別忘了休息。"
+    assert history[-1]["message_id"] == receipt["assistant_message_id"]
+    assert history[-1]["turn_id"] == receipt["turn_id"]
+    assert history[-1]["message_kind"] == "primary"
+
+    message_events = [item for item in emitted if item[0].startswith("message.")]
+    assert [item[0] for item in message_events] == [
+        "message.start",
+        "message.complete",
+    ]
+    complete = message_events[-1][2]
+    assert complete["text"] == "嗯，別忘了休息。"
+    assert complete["status"] == "complete"
+    assert complete["native_assistant_extension_status"] == "completed"
+    assert complete["durable"]["turn_origin"] == "synthetic"
+    assert not any(item[0] == "message.user" for item in emitted)
+
+
+def test_fresh_agent_builds_identity_prompt_before_extension_dispatch(
+    extension_session,
+):
+    db, session, agent, _ = extension_session
+    agent._cached_system_prompt = None
+
+    assert _extend()["result"]["status"] == "streaming"
+    _join(session)
+
+    assert agent.calls == 1
+    assert agent._cached_system_prompt == "You are Lilith."
+    assert agent.requests[0]["messages"][0]["role"] == "system"
+    assert agent.requests[0]["messages"][0]["content"].startswith(
+        "You are Lilith."
+    )
+    assert db._conn.execute(
+        "SELECT COUNT(*) FROM messages WHERE role = 'user'"
+    ).fetchone()[0] == 0
+
+
+def test_silence_is_terminal_idempotent_and_never_adds_a_row(extension_session):
+    db, session, agent, emitted = extension_session
+    agent.output = '{"decision":"silent","text":""}'
+
+    first = _extend()["result"]
+    _join(session)
+    second = _extend()["result"]
+
+    assert first["status"] == "streaming"
+    assert second == {
+        "status": "silent",
+        "event_id": EVENT_ID,
+        "turn_id": first["turn_id"],
+        "assistant_message_id": first["assistant_message_id"],
+        "already_processed": True,
+        "attempted": True,
+    }
+    assert agent.calls == 1
+    assert db.message_count("game-root") == 1
+    completes = [item for item in emitted if item[0] == "message.complete"]
+    assert len(completes) == 1
+    assert completes[0][2]["text"] == ""
+    assert completes[0][2]["status"] == "complete"
+    assert "durable" not in completes[0][2]
+
+
+@pytest.mark.parametrize(
+    "output, expected_status",
+    [
+        ('{"decision":"reply","text":"再一句。"}', "completed"),
+        ('{"decision":"silent","text":""}', "silent"),
+    ],
+)
+def test_terminal_claim_never_blocks_session_deletion(
+    extension_session,
+    output,
+    expected_status,
+):
+    db, session, agent, _ = extension_session
+    agent.output = output
+
+    assert _extend()["result"]["status"] == "streaming"
+    _join(session)
