+def test_anthropic_single_attempt_forbids_stream_to_create_fallback():
+    from agent.anthropic_adapter import create_anthropic_message
+
+    class Messages:
+        def __init__(self):
+            self.stream_calls = 0
+            self.create_calls = 0
+
+        def stream(self, **_kwargs):
+            self.stream_calls += 1
+
+            class UnsupportedStream:
+                def __enter__(self):
+                    raise RuntimeError("stream not supported")
+
+                def __exit__(self, *_args):
+                    return False
+
+            return UnsupportedStream()
+
+        def create(self, **_kwargs):
+            self.create_calls += 1
+            return types.SimpleNamespace(content=[])
+
+    messages = Messages()
+    client = types.SimpleNamespace(messages=messages)
+
+    with pytest.raises(RuntimeError, match="stream not supported"):
+        create_anthropic_message(
+            client,
+            {"model": "claude-test", "messages": []},
+            allow_create_fallback=False,
+        )
+    assert (messages.stream_calls, messages.create_calls) == (1, 0)
+
+    create_anthropic_message(
+        client,
+        {"model": "claude-test", "messages": []},
+    )
+    assert (messages.stream_calls, messages.create_calls) == (2, 1)
