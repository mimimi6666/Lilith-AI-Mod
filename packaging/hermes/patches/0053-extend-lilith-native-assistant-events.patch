+        interrupt_entered.set()
+        assert release_interrupt.wait(timeout=5)
+
+    def run_queued(_rid, _sid, target_session, _text, **_kwargs):
+        with target_session["history_lock"]:
+            target_session["running"] = False
+            target_session["inflight_turn"] = None
+        drained.set()
+
+    monkeypatch.setattr(interrupt_compat, "request_hard_interrupt", hard_interrupt)
+    monkeypatch.setattr(server, "_run_prompt_submit", run_queued)
+    monkeypatch.setattr(
+        server,
+        "_emit_accepted_user_message",
+        lambda *_args, **_kwargs: None,
+    )
+
+    assert _extend()["result"]["status"] == "streaming"
+    assert agent.entered.wait(timeout=5)
+
+    def submit():
+        response["value"] = server._methods["prompt.submit"](
+            "player-prompt",
+            {"session_id": "game-live", "text": "這句優先"},
+        )
+
+    submit_thread = threading.Thread(target=submit)
+    submit_thread.start()
+    assert interrupt_entered.wait(timeout=5)
+    agent.release.set()
+    assert session["_test_native_extension_terminal"].wait(timeout=5)
+
+    # message.complete may publish, but ownership and the queued player turn
+    # stay fenced until the exact hard interrupt admitted for this owner ends.
+    assert session["running"] is True
+    assert "_native_assistant_extension" in session
+    assert not drained.is_set()
+
+    release_interrupt.set()
+    submit_thread.join(timeout=5)
