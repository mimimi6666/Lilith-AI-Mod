+                    )
+                return self._native_assistant_extension_receipt(
+                    existing,
+                    already_processed=True,
+                )
+
+            self._check_transcript_write_guards(conn, session_id, None)
+            placeholders = ",".join("?" for _ in lineage_session_ids)
+            native_rows = conn.execute(
+                f"""SELECT role, content, display_kind, display_metadata
+                    FROM messages
+                    WHERE session_id IN ({placeholders})
+                      AND platform_message_id = ?
+                    ORDER BY id ASC""",
+                (*lineage_session_ids, event_id),
+            ).fetchall()
+            if len(native_rows) != 1:
+                raise NativeAssistantExtensionConflictError(
+                    "native assistant event prerequisite was missing or duplicated"
+                )
+            native_row = native_rows[0]
+            metadata = self._decode_display_metadata(native_row["display_metadata"])
+            if (
+                native_row["role"] != "assistant"
+                or self._decode_content(native_row["content"])
+                != perception["text"]
+                or native_row["display_kind"] != "native_assistant_event"
+                or not isinstance(metadata, dict)
+                or any(metadata.get(key) != value for key, value in expected_metadata.items())
+            ):
+                raise NativeAssistantExtensionConflictError(
+                    "native assistant event prerequisite conflicted"
+                )
+
+            now = time.time()
+            state = "abandoned" if abandon else "streaming"
+            attempted = 0 if abandon else 1
+            conn.execute(
+                """INSERT INTO native_assistant_extensions (
+                       lineage_root, event_id, perception_sha256, session_id,
+                       turn_id, assistant_message_id, owner_pid,
+                       owner_started_at, owner_token, state, attempted,
+                       assistant_row_id, created_at, updated_at
+                   ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, ?)""",
+                (
+                    lineage_root,
+                    event_id,
+                    perception_sha256,
+                    session_id,
+                    turn_id,
+                    assistant_message_id,
+                    owner_pid,
+                    owner_started_at,
+                    owner_token,
+                    state,
+                    attempted,
+                    now,
+                    now,
+                ),
+            )
+            created = conn.execute(
+                """SELECT lineage_root, event_id, perception_sha256,
+                          session_id, turn_id, assistant_message_id, state,
+                          owner_pid, owner_started_at, owner_token, attempted,
+                          assistant_row_id
+                   FROM native_assistant_extensions
+                   WHERE event_id = ?""",
+                (event_id,),
+            ).fetchone()
+            return self._native_assistant_extension_receipt(
+                created,
+                already_processed=state != "streaming",
+            )
+
+        return self._execute_write(
+            _do, patience_s=self._TRANSCRIPT_WRITE_PATIENCE_S
+        )
+
+    def finish_native_assistant_extension(
+        self,
+        session_id: str,
+        *,
+        lineage_root: str,
+        event_id: str,
+        perception_sha256: str,
+        turn_id: str,
+        assistant_message_id: str,
+        status: str,
+        text: Optional[str] = None,
+    ) -> Dict[str, Any]:
+        """Atomically terminalize a claim and optionally append its reply."""
+        if (
+            status not in {"completed", "silent", "abandoned"}
+            or (status == "completed" and (not isinstance(text, str) or not text.strip()))
+            or (status != "completed" and text is not None)
+        ):
+            raise ValueError("native assistant extension terminal state was rejected")
+
+        def _do(conn):
+            row = conn.execute(
+                """SELECT lineage_root, event_id, perception_sha256,
+                          session_id, turn_id, assistant_message_id, state,
+                          owner_pid, owner_started_at, owner_token, attempted,
+                          assistant_row_id
+                   FROM native_assistant_extensions
+                   WHERE event_id = ?""",
+                (event_id,),
+            ).fetchone()
+            if row is None:
+                raise ValueError("native assistant extension claim was not found")
+            if (
+                row["lineage_root"] != lineage_root
+                or row["perception_sha256"] != perception_sha256
+                or row["session_id"] != session_id
+                or row["turn_id"] != turn_id
+                or row["assistant_message_id"] != assistant_message_id
+            ):
+                raise NativeAssistantExtensionConflictError(
+                    "native assistant extension identity conflicted"
+                )
+            if row["state"] != "streaming":
+                return {
+                    **self._native_assistant_extension_receipt(
+                        row,
+                        already_processed=True,
+                    ),
+                    "message": None,
+                }
+
+            message = None
+            assistant_row_id = None
+            if status == "completed":
+                self._check_transcript_write_guards(conn, session_id, None)
+                message = build_native_assistant_extension_message(
+                    event_id=event_id,
+                    turn_id=turn_id,
+                    assistant_message_id=assistant_message_id,
+                    text=text,
+                    timestamp=time.time(),
+                )
+                self._insert_message_rows(
+                    conn,
+                    session_id,
+                    [message],
+                    require_activity_timestamps=True,
+                )
+                assistant_row_id = int(message["_row_id"])
+                conn.execute(
+                    "UPDATE sessions SET message_count = message_count + 1 WHERE id = ?",
+                    (session_id,),
+                )
+
+            conn.execute(
+                """UPDATE native_assistant_extensions
+                   SET state = ?, assistant_row_id = ?, updated_at = ?
+                   WHERE event_id = ? AND state = 'streaming'""",
+                (
+                    status,
+                    assistant_row_id,
+                    time.time(),
+                    event_id,
+                ),
+            )
+            terminal = conn.execute(
+                """SELECT lineage_root, event_id, perception_sha256,
+                          session_id, turn_id, assistant_message_id, state,
+                          owner_pid, owner_started_at, owner_token, attempted,
+                          assistant_row_id
+                   FROM native_assistant_extensions
+                   WHERE event_id = ?""",
+                (event_id,),
+            ).fetchone()
+            return {
+                **self._native_assistant_extension_receipt(
+                    terminal,
+                    already_processed=True,
+                ),
+                "message": message,
+            }
+
+        return self._execute_write(
+            _do, patience_s=self._TRANSCRIPT_WRITE_PATIENCE_S
+        )
+
