+def _native_assistant_extension_owner_process_is_dead(row: Any) -> bool:
+    """Return True only when a durable extension process is provably gone.
+
+    Unlike the compression-lock holder string, a native extension persists a
+    PID and process-start fingerprint in dedicated columns.  Both checks are
+    conservative: probe failures keep the claim streaming, while a missing PID
+    or a start-time mismatch proves that no model worker can still own it.
+    Same-process thread liveness is supplied separately by the gateway because
+    only its owner-token registry can distinguish a live worker from an orphan.
+    """
+    try:
+        owner_pid = int(row["owner_pid"])
+        owner_started_at = int(row["owner_started_at"])
+    except (KeyError, TypeError, ValueError, IndexError):
+        return False
+    if owner_pid <= 0:
+        return False
+    try:
+        from gateway.status import _pid_exists, get_process_start_time
+
+        if not _pid_exists(owner_pid):
+            return True
+        live_started_at = get_process_start_time(owner_pid)
+    except Exception:
+        return False
+    return bool(
+        owner_started_at
+        and live_started_at is not None
+        and owner_started_at != int(live_started_at)
+    )
     return False
 
 
