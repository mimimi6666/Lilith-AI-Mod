diff --git a/tests/test_background_cache_handoff.py b/tests/test_background_cache_handoff.py
new file mode 100644
--- /dev/null
+++ b/tests/test_background_cache_handoff.py
@@ -0,0 +1,151 @@
+"""Synthetic immutable coverage and optional-review admission, no player data."""
+from copy import deepcopy
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.background_context import (BackgroundContextDeferred, attach_summary,
+    ensure_background_projection, freeze_summary)
+from agent.usage_budget import NormalBudget, VerifiedModelLimits, TurnBudgetLedger, resolve_policy
+from agent.usage_budget_context import (capture_completed_history, _strategy_projection_units,
+    prepare_budget_context)
+from agent.usage_strategy import strategy_for_level
+from agent.usage_strategy_context import project_context
+
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.spec = strategy_for_level(4)
+        self.policy = resolve_policy(4, NormalBudget(max_iterations=90), VerifiedModelLimits(), version=1)
+        self.origin = SimpleNamespace(origin_id="synthetic-origin",
+            ledger=TurnBudgetLedger("synthetic-origin", self.policy))
+        self.capture = patch("agent.usage_budget_runtime.capture_origin", return_value=self.origin)
+        self.capture.start()
+        self.addCleanup(self.capture.stop)
+        self.calls = []
+        self.parent = self.agent()
+        self.rows = [row for i in range(40) for row in
+            ({"role":"user", "content":f"question {i}"},
+             {"role":"assistant", "content":f"answer {i}"})]
+        self.rows.append({"role":"user", "content":"current input"})
+
+    def agent(self):
+        return SimpleNamespace(session_id="synthetic", model="model", provider="provider",
+            api_mode="chat_completions", context_compressor=SimpleNamespace(
+                _generate_summary=lambda rows:(self.calls.append(deepcopy(rows)) or "Synthetic summary")))
+
+    def units(self, rows, selection=None):
+        selection = selection or capture_completed_history(rows,len(rows)-1)
+        return _strategy_projection_units(self.parent,selection,rows,deepcopy(rows),0)
+
+    def project(self, owner, rows, selection=None):
+        return project_context(owner,rows,self.units(rows,selection),self.spec,self.origin)
+
+    def test_old_capture_loses_coverage_after_three_native_owned_history_changes(self):
+        before = capture_completed_history(self.rows,len(self.rows)-1)
+        # The full-host fixture exercises actual adjacent-assistant merging.
+        # Here the already-owned normalization's three changed row identities
+        # isolate the precise immutable-proof/prefix failure without startup.
+        for index in (2,6,10): self.rows[2*index+1]["content"] += "\ncontinuation"
+        self.project(self.parent,self.rows,before)
+        covered = len(self.parent._information_summary["covered"])
+        child = self.agent()
+        self.assertTrue(attach_summary(child,freeze_summary(self.parent)))
+        self.project(child,self.rows)
+        self.assertGreater(covered,0)
+        self.assertEqual(child._information_summary["covered"],())
+        self.assertEqual(len(self.calls),1)
+
+    def test_capture_after_normalization_retains_exact_child_coverage(self):
+        for index in (2,6,10): self.rows[2*index+1]["content"] += "\ncontinuation"
+        frozen = capture_completed_history(self.rows,len(self.rows)-1)
+        self.project(self.parent,self.rows,frozen)
+        snapshot = freeze_summary(self.parent)
+        child = self.agent()
+        self.assertTrue(attach_summary(child,snapshot))
+        self.project(child,self.rows)
+        self.assertEqual(child._information_summary["covered"],snapshot.covered)
+        self.assertEqual(len(self.calls),1)
+
+    def test_later_changes_remain_ineligible_without_recapture(self):
+        frozen = capture_completed_history(self.rows,len(self.rows)-1)
+        prior = len(self.units(self.rows,frozen))
+        self.rows[5]["content"] = "changed after capture"
+        self.rows.extend([{"role":"assistant","content":"current answer"},
+                          {"role":"user","content":"steered input"}])
+        units = self.units(self.rows,frozen)
+        self.assertEqual(len(units),prior-1)
+        self.assertTrue(all(max(unit)<80 for unit in units))
+
+    def test_scope_or_source_mismatch_does_not_borrow_summary(self):
+        self.project(self.parent,self.rows)
+        snapshot = freeze_summary(self.parent)
+        for field in ("model","provider","api_mode","base_url","session_id","fingerprint"):
+            child = self.agent()
+            setattr(child,field,"different")
+            self.assertFalse(attach_summary(child,snapshot),field)
+        child = self.agent()
+        self.assertTrue(attach_summary(child,snapshot))
+        self.rows[0]["content"] = "edited fact"
+        self.project(child,self.rows)
+        self.assertEqual(child._information_summary["covered"],())
+
+    def test_long_optional_history_without_checkpoint_defers(self):
+        child = self.agent()
+        attach_summary(child,None)
+        self.project(child,self.rows)
+        with self.assertRaisesRegex(BackgroundContextDeferred,"snapshot_missing"):
+            ensure_background_projection(child,capture_completed_history(self.rows,len(self.rows)-1),self.spec)
+
+    def test_valid_partial_checkpoint_and_short_history_are_allowed(self):
+        self.project(self.parent,self.rows)
+        child = self.agent()
+        attach_summary(child,freeze_summary(self.parent))
+        self.project(child,self.rows)
+        ensure_background_projection(child,capture_completed_history(self.rows,len(self.rows)-1),self.spec)
+        short = self.rows[-5:]
+        child = self.agent()
+        attach_summary(child,None)
+        self.project(child,short)
+        ensure_background_projection(child,capture_completed_history(short,len(short)-1),self.spec)
+
+    def test_guard_preserves_foreground_and_levels_five_six(self):
+        self.parent._usage_budget_context_status = {"strategy":"projection_unavailable_originals_retained"}
+        history = capture_completed_history(self.rows,len(self.rows)-1)
+        ensure_background_projection(self.parent,history,self.spec)
+        self.parent._background_context_readonly = True
+        for level in (5,6): ensure_background_projection(self.parent,history,strategy_for_level(level))
+
+    def test_projection_exception_not_swallowed_into_long_background_send(self):
+        child = self.agent()
+        attach_summary(child,None)
+        history = capture_completed_history(self.rows,len(self.rows)-1)
+        with patch("agent.usage_budget_context.current_turn_budget",return_value=self.origin.ledger), \
+             patch("agent.usage_strategy_context.project_context",side_effect=ValueError("synthetic")):
+            with self.assertRaisesRegex(BackgroundContextDeferred,"projection_unavailable"):
+                prepare_budget_context(child,self.rows,self.rows,history,history_offset=0)
+            # Ordinary foreground still preserves originals on that failure.
+            self.assertEqual(prepare_budget_context(self.parent,self.rows,self.rows,history,history_offset=0),self.rows)
+
+    def test_stopped_origin_does_not_attach_or_dispatch(self):
+        self.project(self.parent,self.rows)
+        snapshot = freeze_summary(self.parent)
+        self.origin.ledger.stop()
+        self.assertIsNone(freeze_summary(self.parent))
+        self.assertFalse(attach_summary(self.agent(),snapshot))
+
+    def test_diagnostics_contain_only_closed_codes_and_counts(self):
+        self.project(self.parent,self.rows)
+        with self.assertLogs("agent.background_context",level="INFO") as logs:
+            snapshot = freeze_summary(self.parent)
+            child = self.agent()
+            self.assertTrue(attach_summary(child,snapshot))
+        text = "\n".join(logs.output)
+        self.assertIn("stage=freeze code=accepted",text)
+        self.assertNotIn("Synthetic summary",text)
+        self.assertNotIn("synthetic-origin",text)
+        self.assertNotIn("question",text)
+
+
+if __name__ == "__main__":
+    unittest.main()
