 from dataclasses import dataclass
 import hashlib
 import json
+import logging
 from agent.history_context import summary_scope
 
+logger = logging.getLogger(__name__)
+
+
+class BackgroundContextDeferred(RuntimeError):
+    """Optional review lacks a verified bounded projection; never a retry."""
+
+
+def _summary_outcome(stage, code, covered=0):
+    # Closed codes and counts only: no transcript, scope values or credentials.
+    logger.info("[background_checkpoint] stage=%s code=%s covered=%d", stage, code, covered)
+
+
+def ensure_background_projection(agent, history, spec):
+    """Stop optional long-history review if its summary proof was lost.
+
+    Foreground replies and levels 5/6 keep their original behavior. The check
+    is outside prepare_budget_context's original-retention recovery catch.
+    """
+    if not getattr(agent, "_background_context_readonly", False) or spec.history_turns is None:
+        return
+    status = getattr(agent, "_usage_budget_context_status", None)
+    valid = isinstance(status, dict) and status.get("strategy") == "information_v1"
+    if valid:
+        needed = status.get("uncovered_turns_retained", 0) > 0
+        covered = status.get("summarized_turns", 0)
+    else:
+        from agent.history_checkpoint import detail_chars, history_limit
+        units = getattr(history, "units", ())
+        # Only the once-frozen pre-turn history is counted, never this review's
+        # current prompt or later tool results. Unknown projection cannot
+        # silently turn a known long history into an unrestricted replay.
+        needed = (len(units) >= spec.history_turns
+                  or sum(detail_chars([row.message for row in unit]) for unit in units)
+                     > history_limit(spec))
+        covered = 0
+    if needed and not covered:
+        handoff = getattr(agent, "_background_checkpoint_handoff", "snapshot_missing")
+        code = ("coverage_changed" if handoff == "accepted" else handoff) if valid else "projection_unavailable"
+        if code not in ("snapshot_missing", "origin_mismatch", "scope_mismatch", "coverage_changed", "projection_unavailable"):
+            code = "snapshot_missing"
+        _summary_outcome("defer", code)
+        raise BackgroundContextDeferred(code)
+
 
