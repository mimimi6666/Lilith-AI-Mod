+def test_selected_provider_secure_fields_complete_once_without_reselection(monkeypatch):
+    from tools import native_tool_setup_tool as tool
+    from hermes_cli import tools_config as tc
+    from hermes_cli.config import load_config, load_env
+
+    _write_config(_config())
+    result = _set()
+    assert "error" not in result, result
+    before = (_home() / "config.yaml").read_bytes()
+    provider = next(row for row in tc.TOOL_CATEGORIES["browser"]["providers"] if row["name"] == "Camofox")
+    monkeypatch.setattr(tool, "bound_setup_available", lambda: True)
+    monkeypatch.setattr(tool, "_metadata", lambda *_: (load_config(), [provider]))
+    monkeypatch.setitem(tc._POST_SETUP_READY, "camofox", lambda: False)
+    monkeypatch.setattr(tc, "_run_post_setup", lambda *a: pytest.fail("chat cannot install"))
+    cards = []
+    def prompt(kind, data, **kwargs):
+        if kind == "clarify.request":
+            return tool._CONFIRM
+        assert kind == "secret.request"
+        cards.append(data["env_var"])
+        assert data["env_var"] == "CAMOFOX_URL"
+        return "http://localhost:9377"
+    for _ in range(2):
+        result = tool.run_native_setup("browser", "configure", prompt=prompt, cancelled=lambda: False)
+        assert result["status"] == "settings_saved", result
+        assert "manager_request" not in result
+        assert result["providers"][0]["readiness"] == "needs_setup"
+        assert result["providers"][0]["dependency_status"] == "missing"
+    assert cards == ["CAMOFOX_URL"]
+    assert load_env()["CAMOFOX_URL"] == "http://localhost:9377"
+    assert (_home() / "config.yaml").read_bytes() == before
+
