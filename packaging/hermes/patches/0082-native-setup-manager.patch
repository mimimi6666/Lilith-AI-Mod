+    assert "error" not in result, result
+    rows = result["result"]["toolsets"]
+    assert rows
+    assert any(row["setup_providers"] for row in rows)
+    for row in rows:
+        providers = row["setup_providers"]
+        assert len(providers) <= 64
+        assert len({provider["name"] for provider in providers}) == len(providers)
+        for provider in providers:
+            assert set(provider) == {"name", "readiness", "setup_support", "selected", "dependency_status"}
+            assert provider["readiness"] in {"ready", "needs_keys", "needs_auth", "needs_setup"}
+            assert provider["dependency_status"] in {"not_required", "ready", "missing", "unknown"}
+            assert provider["setup_support"] in {"provider_selection", "secure_fields", "spotify_oauth", "native_manager_required", "no_setup_fields"}
