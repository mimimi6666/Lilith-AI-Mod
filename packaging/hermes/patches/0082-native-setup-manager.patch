new file mode 100644
--- /dev/null
+++ b/tui_gateway/native_setup.py
@@ -0,0 +1,161 @@
+"""Non-secret native setup projection and provider-selection validation.
+
+No credential, installer, approval, or configuration writer lives here.
+Only tools.set may persist a selection inside its existing idle transaction.
+"""
+from copy import deepcopy
+import re
+import sys
+
+
+# These are the selector markers consumed by native apply_provider_selection,
+# not tool names or permissions. Other setup operations remain separate.
+_SELECTORS = frozenset({
+    "tts_provider", "stt_provider", "browser_provider", "browser_backend",
+    "web_backend", "image_gen_plugin_name", "video_gen_plugin_name",
+    "imagegen_backend", "managed_nous_feature",
+})
+_READINESS = frozenset({"ready", "needs_setup", "needs_auth", "needs_keys"})
+
+
+def validate_selection_shape(selection):
+    if not isinstance(selection, dict) or set(selection) != {"toolset", "provider"}:
+        raise ValueError("setup_selection requires exactly toolset and provider")
+    name, provider = selection["toolset"], selection["provider"]
+    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,95}", name):
+        raise ValueError("invalid setup toolset")
+    if (not isinstance(provider, str) or not provider or provider != provider.strip()
+            or len(provider) > 256 or any(ord(c) < 32 for c in provider)):
+        raise ValueError("invalid setup provider")
+    return {"toolset": name, "provider": provider}
+
+
+def _providers(toolset, config, features=None):
+    from hermes_cli import tools_config as tc
+
+    if toolset not in {row[0] for row in tc._get_effective_configurable_toolsets()}:
+        return []
+    if not tc._toolset_allowed_for_platform(toolset, "cli"):
+        return []
+    category = tc.TOOL_CATEGORIES.get(toolset)
+    if not category:
+        return []
+    gate = category.get("platform_gate")
+    if gate and sys.platform not in gate:
+        return []
+    return tc._visible_providers(category, config, features=features)
+
+
+def _dependency_status(provider):
+    from hermes_cli import tools_config as tc
+
+    hook = provider.get("post_setup")
+    if hook is not None and not isinstance(hook, str):
+        return "unknown"
+    if not hook or hook in {"spotify", "xai_grok"}:
+        return "not_required"
+    predicate = tc._POST_SETUP_READY.get(hook)
+    if hook == "browser_use_cli":
+        from tools.browser_use_cli import _find_cli
+
+        # A uvx fallback means available on demand, not an installed binary.
+        predicate = lambda: bool((command := _find_cli()) and len(command) == 1)
+    if predicate is None:
+        return "unknown"
+    try:
+        return "ready" if predicate() else "missing"
+    except Exception:
+        return "unknown"
+
+
+def setup_support(provider):
+    if any(provider.get(key) for key in _SELECTORS):
+        return "provider_selection"
+    from tools.native_tool_setup_tool import _support
+
+    return _support(provider)
+
+
+def setup_providers(toolset, config, *, features=None):
+    from hermes_cli import tools_config as tc
+
+    providers = _providers(toolset, config, features)
+    if len(providers) > 64:
+        return []  # An unbounded or ambiguous projection cannot drive a choice.
+    names = [provider.get("name") for provider in providers]
+    if any(not isinstance(name, str) for name in names) or len(set(names)) != len(names):
+        return []
+    rows = []
+    for provider in providers:
+        try:
+            validate_selection_shape({"toolset": toolset, "provider": provider["name"]})
+        except ValueError:
+            continue
+        try:
+            selected = bool(tc._is_provider_active(provider, config))
+        except Exception:
+            selected = False
+        try:
+            readiness = tc.provider_readiness_status(
+                provider, config, features=features, is_active=selected,
+            )
+        except Exception:
+            readiness = "needs_setup"
+        if readiness not in _READINESS:
+            readiness = "needs_setup"
+        dependency = _dependency_status(provider)
+        # Env presence and provider selection never prove installation.
+        if readiness == "ready" and dependency in {"missing", "unknown"}:
+            readiness = "needs_setup"
+        rows.append({
+            "name": provider["name"], "readiness": readiness,
+            "setup_support": setup_support(provider), "selected": selected,
+            "dependency_status": dependency,
+        })
+    return rows
+
+
+def resolve_selection(selection, config):
+    from hermes_cli import tools_config as tc
+    from hermes_cli.nous_subscription import MANAGED_FEATURE_COVERAGE_CATEGORY
+
+    selection = validate_selection_shape(selection)
+    features = tc.get_nous_subscription_features(config)
+    providers = _providers(selection["toolset"], config, features)
+    if len(providers) > 64:
+        raise ValueError("native provider catalog exceeds the management protocol bound")
+    matches = [row for row in providers if row.get("name") == selection["provider"]]
+    if len(matches) != 1 or setup_support(matches[0]) != "provider_selection":
+        raise ValueError("native provider selection is unavailable")
+    provider = matches[0]
+    feature = provider.get("managed_nous_feature")
+    if feature or provider.get("requires_nous_auth"):
+        account = features.account_info
+        category = MANAGED_FEATURE_COVERAGE_CATEGORY.get(feature)
+        entitled = bool(account and account.logged_in and (
+            account.tool_gateway_entitled_for(category) if category
+            else account.tool_gateway_entitled if feature
+            else account.paid_service_access is True
+        ))
+        if not features.nous_auth_present or not entitled:
+            raise ValueError("native provider authentication or entitlement is required")
+    return provider
+
+
+def apply_selection(selection, config):
+    """Mutate only the transaction-owned mapping with the native selector."""
+    from hermes_cli.tools_config import apply_provider_selection
+
+    resolve_selection(selection, config)
+    apply_provider_selection(selection["toolset"], selection["provider"], config)
+
+
+def verify_selection(selection, config):
+    """Require a native selected row and an idempotent exact selector readback."""
+    from hermes_cli.tools_config import _is_provider_active
+
+    provider = resolve_selection(selection, config)
+    expected = deepcopy(config)
+    apply_selection(selection, expected)
+    if expected != config or not _is_provider_active(provider, config):
+        raise RuntimeError("native provider selection readback did not match")
