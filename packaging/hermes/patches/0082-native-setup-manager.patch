+++ b/tests/tui_gateway/test_native_setup_selection.py
@@ -0,0 +1,364 @@
+"""Provider setup uses native metadata and the existing idle config transaction."""
+import hashlib
+import json
+import os
+import threading
+from copy import deepcopy
+
+import pytest
+import yaml
+
+import tui_gateway.server as server
+from tests.tui_gateway.test_tools_policy_rpc import (
+    _attest_strict_host, _clean_gateway_sessions, _home,
+    _logged_out_features, _strict_config, _write_config,
+)
+
+
+@pytest.fixture(autouse=True)
+def native_setup_env(monkeypatch):
+    from hermes_cli import tools_config as tc
+
+    monkeypatch.setattr(tc, "get_nous_subscription_features", lambda *a, **k: _logged_out_features())
+    originals = {}
+    for builder in ("_plugin_browser_providers", "_plugin_web_search_providers",
+                    "_plugin_image_gen_providers", "_plugin_video_gen_providers", "_plugin_tts_providers"):
+        originals[builder] = getattr(tc, builder)
+        monkeypatch.setattr(tc, builder, lambda: [])
+    return originals
+
+
+def _config():
+    return {
+        "platform_toolsets": {"cli": ["browser", "memory", "no_mcp"]},
+        "approvals": {"mode": "manual", "timeout": 123},
+        "browser": {"cloud_provider": "local", "backend": "off"},
+        "mcp_servers": {"preserved": {"command": "example", "enabled": False}},
+    }
+
+
+def _params(provider="Camofox"):
+    from hermes_cli.config import load_config
+    from hermes_cli import tools_config as tc
+
+    valid = {name for name, _, _ in tc._get_effective_configurable_toolsets()
+             if name not in tc._CONFIG_ONLY_TOOLSETS and tc._toolset_allowed_for_platform(name, "cli")}
+    enabled = tc._get_platform_tools(load_config(), "cli", include_default_mcp_servers=False) & valid
+    return {"enabled_toolsets": sorted(enabled), "approval_mode": "manual",
+            "setup_selection": {"toolset": "browser", "provider": provider}}
+
+
+def _set(params=None):
+    return server._methods["tools.set"]("setup", params or _params())
+
+
+def test_provider_selection_saves_once_preserves_policy_and_echoes(monkeypatch):
+    from hermes_cli import tools_config as tc
+
+    config = _config()
+    _write_config(config)
+    saves = []
+    original = tc.save_config
+    monkeypatch.setattr(tc, "save_config", lambda cfg: (saves.append(deepcopy(cfg)), original(cfg))[1])
+    monkeypatch.setattr(tc, "_run_post_setup", lambda *_: pytest.fail("must not install"))
+    params = _params()
+    response = _set(params)
+    assert "error" not in response, response
+    assert len(saves) == 1
+    result = response["result"]
+    assert result["setup_selection"] == _params()["setup_selection"]
+    assert result["approval_mode"] == "manual"
+    assert result["enabled_toolsets"] == params["enabled_toolsets"]
+    raw = (_home() / "config.yaml").read_bytes()
+    assert result["config_sha256"] == hashlib.sha256(raw).hexdigest()
+    saved = yaml.safe_load(raw)
+    assert saved["browser"]["cloud_provider"] == "camofox"
+    assert saved["platform_toolsets"] == config["platform_toolsets"]
+    assert saved["approvals"] == config["approvals"]
+    assert saved["mcp_servers"] == config["mcp_servers"]
+
+
+@pytest.mark.parametrize("change", [
+    {"approval_mode": "off"}, {"enabled_toolsets": ["memory"]},
+    {"setup_selection": None},
+    {"setup_selection": {"toolset": "browser", "provider": "Camofox", "command": "bad"}},
+    {"setup_selection": {"toolset": "browser", "provider": " Camofox"}},
+    {"setup_selection": {"toolset": "browser", "provider": "unknown"}},
+    {"setup_selection": {"toolset": "spotify", "provider": "Spotify Web API"}},
+    {"setup_selection": {"toolset": "mcp_unknown", "provider": "unknown"}},
+])
+def test_invalid_or_mixed_selection_never_writes(change):
+    before = _write_config(_config())
+    assert _set({**_params(), **change})["error"]["code"] == -32602
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_provider_choice_still_rejects_active_turn():
+    before = _write_config(_config())
+    server._sessions["busy"] = {"history_lock": threading.RLock(), "running": True}
+    assert _set()["error"]["code"] == 4090
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_declared_unsupported_platform_cannot_select(monkeypatch):
+    from hermes_cli import tools_config as tc
+
+    before = _write_config(_config())
+    monkeypatch.setitem(tc.TOOL_CATEGORIES["browser"], "platform_gate", ["unsupported-test-host"])
+    assert _set()["error"]["code"] == -32602
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_nous_selection_does_not_bypass_entitlement():
+    before = _write_config(_config())
+    response = _set(_params("Nous Subscription (Browser Use cloud)"))
+    assert response["error"]["code"] == -32602
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_failed_provider_readback_restores_exact_bytes(monkeypatch):
+    import tui_gateway.native_setup as setup
+
+    before = _write_config(_config())
+    monkeypatch.setattr(setup, "verify_selection", lambda *a: (_ for _ in ()).throw(RuntimeError("bad readback")))
+    response = _set()
+    assert "error" in response
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_provider_commit_rotates_strict_digest_but_cannot_resume_old_agent(monkeypatch):
+    import agent.identity_policy as identity
+
+    soul, personality = "Lilith soul.\n", "You are Lilith.\n"
+    config = _strict_config(personality)
+    config.update(_config())
+    before = _write_config(config)
+    (_home() / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    _attest_strict_host(monkeypatch, before, soul, personality)
+    session = {"history_lock": threading.RLock(), "running": False,
+               "_native_approval_resume_digest": {"previous": "a" * 64, "current": "b" * 64}}
+    server._sessions["idle"] = session
+    result = _set()
+    assert "error" not in result, result
+    digest = result["result"]["config_sha256"]
+    assert os.environ["HERMES_IDENTITY_EXPECTED_CONFIG_SHA256"] == digest
+    assert identity.preflight_aia_agent_identity(request_overrides={}).config_sha256 == digest
+    assert "_native_approval_resume_digest" not in session
+
+
+def test_metadata_never_treats_credentials_as_installed(monkeypatch):
+    from hermes_cli import tools_config as tc
+    from tui_gateway.native_setup import setup_providers
+
+    monkeypatch.setattr(tc, "get_env_value", lambda *_: "must-never-appear-secret")
+    monkeypatch.setitem(tc._POST_SETUP_READY, "camofox", lambda: False)
+    rows = setup_providers("browser", _config(), features=_logged_out_features())
+    row = next(row for row in rows if row["name"] == "Camofox")
