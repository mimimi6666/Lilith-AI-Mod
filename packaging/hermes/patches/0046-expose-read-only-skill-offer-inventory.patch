         return False
 
 
+_SKILL_PLATFORM_INCOMPATIBLE = "platform_incompatible"
+_SKILL_ENVIRONMENT_INCOMPATIBLE = "environment_incompatible"
+_SKILL_DISABLED = "disabled"
+
+
+def _skill_offer_exclusion_reason(
+    frontmatter: Dict[str, Any], name: str, disabled: Set[str]
+) -> str | None:
+    """Return the closed reason token that keeps a discovered skill unoffered.
+
+    Keep this ordering aligned with the historical ``_find_all_skills``
+    filters: platform first, then runtime environment, then user-disabled
+    state.  The helper is shared by the ordinary offer surface and the
+    read-only inventory so they cannot silently classify the same skill
+    differently.
+    """
+    if not skill_matches_platform(frontmatter):
+        return _SKILL_PLATFORM_INCOMPATIBLE
+    if not skill_matches_environment(frontmatter):
+        return _SKILL_ENVIRONMENT_INCOMPATIBLE
+    if name in disabled:
+        return _SKILL_DISABLED
+    return None
+
+
+def _skill_dirs_to_scan() -> List[Path]:
+    """Resolve the same local-first discovery roots for every skill listing."""
+    from agent.skill_utils import get_external_skills_dirs
+
+    dirs_to_scan: List[Path] = []
+    active_skills_dir = _skills_dir()
+    if active_skills_dir.exists():
+        dirs_to_scan.append(active_skills_dir)
+    dirs_to_scan.extend(get_external_skills_dirs())
+    return dirs_to_scan
+
+
+def _iter_discovered_skill_documents(dirs_to_scan: List[Path]):
+    """Yield parsed skill identity without exposing filesystem provenance.
+
+    The yielded tuple is internal-only.  Read and parse failures retain the
+    existing fail-closed listing behavior and are logged locally; callers
+    never receive paths or raw exception text.
+    """
+    from agent.skill_utils import iter_skill_index_files
+
+    for scan_dir in dirs_to_scan:
+        for skill_md in iter_skill_index_files(scan_dir, "SKILL.md"):
+            if any(part in _EXCLUDED_SKILL_DIRS for part in skill_md.parts):
+                continue
+
+            skill_dir = skill_md.parent
+            try:
+                content = skill_md.read_text(
+                    encoding="utf-8-sig", errors="replace"
+                )[:4000]
+                frontmatter, body = _parse_frontmatter(content)
+                name = frontmatter.get("name", skill_dir.name)[:MAX_NAME_LENGTH]
+                category = _get_category_from_path(skill_md)
+                yield frontmatter, body, name, category
+            except (UnicodeDecodeError, PermissionError) as e:
+                logger.debug("Failed to read skill file %s: %s", skill_md, e)
+            except Exception as e:
+                logger.debug(
+                    "Skipping skill at %s: failed to parse: %s",
+                    skill_md,
+                    e,
+                    exc_info=True,
+                )
+
+
+def get_skills_inventory() -> Dict[str, Any]:
+    """Return a safe, read-only inventory plus the legacy offered grouping.
+
+    ``skills`` intentionally retains the existing ``skills.manage`` list
+    contract.  The additive fields distinguish every discovered skill from
+    the subset currently offered and report only closed exclusion tokens.
+    Descriptions, source paths, and parser/read errors are deliberately not
+    part of this boundary.
+    """
+    disabled = _get_disabled_skill_names()
+    installed_by_name: Dict[str, Dict[str, str]] = {}
+    first_exclusion_by_name: Dict[str, str] = {}
+    offered_by_name: Dict[str, Dict[str, str]] = {}
+    skills_by_category: Dict[str, List[str]] = {}
+
+    for frontmatter, _body, name, raw_category in _iter_discovered_skill_documents(
+        _skill_dirs_to_scan()
+    ):
+        category = raw_category or "general"
+        safe_row = {"name": name, "category": category}
+        installed_by_name.setdefault(name, safe_row)
+
+        reason = _skill_offer_exclusion_reason(frontmatter, name, disabled)
+        if reason is not None:
+            first_exclusion_by_name.setdefault(name, reason)
+            continue
+        if name in offered_by_name:
+            continue
+
+        # Match _find_all_skills' eligible-first duplicate behavior while
+        # keeping installed/excluded logical names disjoint.
+        offered_by_name[name] = safe_row
+        installed_by_name[name] = safe_row
+        skills_by_category.setdefault(category, []).append(name)
+
+    installed = sorted(
+        installed_by_name.values(),
+        key=lambda row: (row["category"].casefold(), row["name"].casefold()),
+    )
+    excluded = sorted(
+        (
+            {
+                "name": row["name"],
+                "category": row["category"],
+                "reason": first_exclusion_by_name[row["name"]],
+            }
+            for row in installed
+            if row["name"] not in offered_by_name
+        ),
+        key=lambda row: (row["category"].casefold(), row["name"].casefold()),
+    )
+
+    return {
+        "skills": skills_by_category,
+        "installed": installed,
+        "excluded": excluded,
+        "counts": {
+            "installed": len(installed),
+            "offered": len(offered_by_name),
+            "excluded": len(excluded),
+        },
+    }
+
+
