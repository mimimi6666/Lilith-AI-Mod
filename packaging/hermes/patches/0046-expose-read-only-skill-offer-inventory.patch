+def test_skills_manage_list_keeps_legacy_skills_and_adds_safe_inventory(server):
+    inventory = {
+        "skills": {"general": ["offered-skill"]},
+        "installed": [
+            {"name": "offered-skill", "category": "general"},
+            {"name": "hidden-skill", "category": "general"},
+        ],
+        "excluded": [
+            {
+                "name": "hidden-skill",
+                "category": "general",
+                "reason": "platform_incompatible",
+            }
+        ],
+        "counts": {"installed": 2, "offered": 1, "excluded": 1},
+    }
+
+    with patch("tools.skills_tool.get_skills_inventory", return_value=inventory):
+        resp = server.handle_request(
+            {
+                "id": "skills-list",
+                "method": "skills.manage",
+                "params": {"action": "list"},
+            }
+        )
+
+    assert "error" not in resp
+    assert resp["result"] == inventory
+    assert resp["result"]["skills"] == {"general": ["offered-skill"]}
+
+
+def test_skills_manage_list_does_not_expose_inventory_exception(server):
+    with patch(
+        "tools.skills_tool.get_skills_inventory",
+        side_effect=RuntimeError("secret path and parser details"),
+    ):
+        resp = server.handle_request(
+            {
+                "id": "skills-list-failed",
+                "method": "skills.manage",
+                "params": {"action": "list"},
+            }
+        )
+
+    assert resp["error"]["code"] == 5024
+    assert resp["error"]["message"] == "skills inventory unavailable"
+
