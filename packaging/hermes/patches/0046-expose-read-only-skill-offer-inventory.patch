+class TestSkillsInventory:
+    def test_classifies_installed_offered_and_excluded_without_sensitive_fields(
+        self, tmp_path
+    ):
+        with (
+            patch("tools.skills_tool.SKILLS_DIR", tmp_path),
+            patch(
+                "agent.skill_utils.get_external_skills_dirs", return_value=[]
+            ),
+            patch(
+                "tools.skills_tool.skill_matches_platform",
+                side_effect=lambda fm: fm.get("test_gate") != "platform",
+            ),
+            patch(
+                "tools.skills_tool.skill_matches_environment",
+                side_effect=lambda fm: fm.get("test_gate") != "environment",
+            ),
+            patch(
+                "tools.skills_tool._get_disabled_skill_names",
+                return_value={"disabled-skill", "platform-first"},
+            ),
+        ):
+            _make_skill(tmp_path, "offered-skill", category="tools")
+            _make_skill(
+                tmp_path,
+                "platform-skill",
+                frontmatter_extra="test_gate: platform\n",
+            )
+            _make_skill(
+                tmp_path,
+                "environment-skill",
+                frontmatter_extra="test_gate: environment\n",
+            )
+            _make_skill(tmp_path, "disabled-skill")
+            _make_skill(
+                tmp_path,
+                "platform-first",
+                frontmatter_extra="test_gate: platform\n",
+            )
+
+            inventory = get_skills_inventory()
+
+        assert inventory["skills"] == {"tools": ["offered-skill"]}
+        assert {row["name"] for row in inventory["installed"]} == {
+            "offered-skill",
+            "platform-skill",
+            "environment-skill",
+            "disabled-skill",
+            "platform-first",
+        }
+        assert {row["name"]: row["reason"] for row in inventory["excluded"]} == {
+            "disabled-skill": "disabled",
+            "environment-skill": "environment_incompatible",
+            "platform-first": "platform_incompatible",
+            "platform-skill": "platform_incompatible",
+        }
+        assert inventory["counts"] == {
+            "installed": 5,
+            "offered": 1,
+            "excluded": 4,
+        }
+        assert inventory["counts"]["installed"] == (
+            inventory["counts"]["offered"] + inventory["counts"]["excluded"]
+        )
+        assert all(set(row) == {"name", "category"} for row in inventory["installed"])
+        assert all(
+            set(row) == {"name", "category", "reason"}
+            for row in inventory["excluded"]
+        )
+        serialized = json.dumps(inventory)
+        assert "description" not in serialized
+        assert "path" not in serialized
+
+
+
