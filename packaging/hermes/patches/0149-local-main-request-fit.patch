+        # Local request capacity is enforced on the provider projection, not
+        # the clean text shown in chat history. Historical user/assistant rows
+        # can replay a much larger api_content sidecar. Charging only content
+        # can protect the entire old transcript, leaving only a prior summary
+        # in the compressible window and making every subsequent pass a no-op.
+        # Count a shallow send-copy through the SAME sidecar admission helper;
+        # never rewrite stored rows or revive a rejected external-memory copy.
+        # The active user is composed afresh at send time, so its old sidecar
+        # is not replayed here. The final complete-request guard still decides
+        # whether the assembled request fits; this is only tail planning.
+        from agent.local_compatibility import compressor_policy
+        _local_tail_projection = compressor_policy(self) is not None
+        _active_user_idx = (
+            self._find_last_user_message_idx(messages, head_end)
+            if _local_tail_projection else -1
+        )
+
+        def _tail_message_tokens(index):
+            message = messages[index]
+            if _local_tail_projection and index != _active_user_idx:
+                from agent.turn_context import substitute_api_content
+                message = dict(message)
+                substitute_api_content(message)
+            return _estimate_msg_budget_tokens(
+                message, charge_stale_thinking=(index == _newest_asst_idx)
             )
+
+        for i in range(n - 1, head_end - 1, -1):
+            msg_tokens = _tail_message_tokens(i)
             # Stop once we exceed the soft ceiling (unless we haven't hit min_tail yet)
