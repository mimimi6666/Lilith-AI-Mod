+class _Attempt:
+    def __init__(self, ledger, binding, request, category, *, defer=False, client=None):
+        self.ledger, self.binding = ledger, binding
+        self.id = "native-" + uuid4().hex
+        self.finished = False
+        self.last_usage = UsageCount()
+        self.usage_unreadable = False
+        from copy import deepcopy
+        from agent.usage_budget_official_routes import normalize_official_economy_request
+        request = normalize_official_economy_request(client, request, binding.capability.wire_format)
+        output_limit = ledger.policy.output_tokens
+        if binding.output_control != "verified" and ledger.policy.strict:
+            raise BudgetError("strict_output_cap_unverified")
+        from agent.usage_budget_official_routes import split_final_sdk_body, lower_reviewed_thinking_budget
+        body, restore = split_final_sdk_body(client, request, binding.capability.wire_format)
+        body = lower_reviewed_thinking_budget(client, body, binding.capability.wire_format, ledger.policy)
+        if binding.output_control == "unavailable":
+            guarded, cap = prepare_uncontrolled_estimated_request(
+                body, output_limit, binding.capability, binding.capability.route)
+        else:
+            guarded, cap = prepare_wire_request(body, output_limit=output_limit,
+                capability=binding.capability, route=binding.capability.route,
+                estimated_output=binding.output_control == "requested")
+        self.request = restore(guarded)
+        if cap is None:
+            raise BudgetError("output_limit_unknown")
+        counted = binding.count_input(deepcopy(self.request))
+        if type(counted) is not InputCount or type(counted.exact) is not bool:
+            raise BudgetError("invalid_input_count")
+        ledger.reserve(self.id, input_tokens=counted.tokens, output_tokens=cap,
+                       input_is_exact=counted.exact, output_cap_verified=binding.output_control == "verified",
+                       category=category)
+        receipts = _GUARD_RECEIPTS.get()
+        if receipts is not None:
+            receipts.append((ledger, binding.capability.route, self.id))
+        if not defer:
+            self.start()
+
+    def start(self):
+        try:
+            self.ledger.mark_dispatched(self.id)
+        except BaseException:
+            # A sibling may exhaust allowance between reservation and dispatch.
+            # Release only the locally proven unsent reservation; stop may have
+            # already released it. Never refund an acquired dispatch permit.
+            try:
+                self.ledger.cancel_before_dispatch(self.id)
+            except BudgetError:
+                pass
+            raise
+
+    def observe(self, value):
+        try:
+            usage = self.binding.read_usage(value)
+            if isinstance(usage, UsageCount):
+                self.last_usage = UsageCount(
+                    self.last_usage.input_tokens if usage.input_tokens is None else usage.input_tokens,
+                    self.last_usage.output_tokens if usage.output_tokens is None else usage.output_tokens,
+                )
+                if usage.input_tokens is not None and usage.output_tokens is not None:
+                    self.usage_unreadable = False
+                return True
+        except Exception:
+            pass
+        self.usage_unreadable = True
+        return False
+
+    def complete(self, value=None):
+        if self.finished and value is None:
+            return
+        if value is not None:
+            if not self.observe(value):
+                if self.finished:
+                    self.ledger.stop()
+                    raise BudgetError("usage_report_unreadable")
+                self.finished = True
+                self.ledger.finalize_unknown(self.id)
+                return
+        if self.usage_unreadable:
+            # A malformed later event cannot make an earlier partial usage
+            # authoritative. Only a complete later report can recover it.
+            self.finished = True
+            self.ledger.finalize_unknown(self.id)
+            return
+        self.finished = True
+        try:
+            self.ledger.reconcile(self.id, input_tokens=self.last_usage.input_tokens,
+                                  output_tokens=self.last_usage.output_tokens)
+        except BudgetError:
+            self.ledger.stop()
+            raise
+        except Exception:
+            self.ledger.finalize_unknown(self.id)
+
+    def unknown(self):
+        if not self.finished:
+            self.finished = True
+            self.ledger.finalize_unknown(self.id)
+
+
+class _BudgetStream:
+    def __init__(self, stream, attempt):
+        self._stream, self._attempt = stream, attempt
+        self._iterator = iter(stream)
+
+    def __getattr__(self, name):
+        return getattr(self._stream, name)
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        try:
+            from agent.usage_budget_usage import NativeUsageEvent
+            while True:
+                value = next(self._iterator)
+                if type(value) is not NativeUsageEvent:
+                    break
+                self._attempt.observe(value.value)
+        except StopIteration:
+            self._attempt.complete()
+            raise
+        except BaseException:
+            self._attempt.unknown()
+            raise
+        self._attempt.observe(value)
+        event_type = value.get("type") if isinstance(value, dict) else getattr(value, "type", None)
+        if event_type in {"response.completed", "response.incomplete", "response.failed"}:
+            self._attempt.complete(value)
+        return value
+
+    def get_final_message(self):
+        try:
+            response = self._stream.get_final_message()
+        except BaseException:
+            self._attempt.unknown()
+            raise
+        self._attempt.complete(response)
+        return response
+
+    def close(self):
+        try:
+            close = getattr(self._stream, "close", None)
+            if callable(close):
+                close()
+        finally:
+            self._attempt.unknown()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+
+class _BudgetAsyncStream:
+    def __init__(self, stream, attempt):
+        self._stream, self._attempt = stream, attempt
+        self._iterator = stream.__aiter__()
+
+    def __getattr__(self, name):
+        return getattr(self._stream, name)
+
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        try:
+            from agent.usage_budget_usage import NativeUsageEvent
+            while True:
+                value = await self._iterator.__anext__()
+                if type(value) is not NativeUsageEvent:
+                    break
+                self._attempt.observe(value.value)
+        except StopAsyncIteration:
+            self._attempt.complete()
+            raise
+        except BaseException:
+            self._attempt.unknown()
+            raise
+        self._attempt.observe(value)
+        event_type = value.get("type") if isinstance(value, dict) else getattr(value, "type", None)
+        if event_type in {"response.completed", "response.incomplete", "response.failed"}:
+            self._attempt.complete(value)
+        return value
+
+    async def aclose(self):
+        try:
+            close = getattr(self._stream, "aclose", None) or getattr(self._stream, "close", None)
+            if callable(close):
+                result = close()
+                if hasattr(result, "__await__"):
+                    await result
+        finally:
+            self._attempt.unknown()
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *exc):
+        await self.aclose()
+
+
+class _BudgetLazyStream:
+    """For adapters whose generator opens the wire only on first next()."""
+    def __init__(self, client, request, factory, wire_format, model_id, ledger, binding, category):
+        self._client, self._factory = client, factory
+        self._wire_format, self._model_id = wire_format, model_id
+        self._ledger = ledger
+        self._attempt = _Attempt(ledger, binding, request, category, defer=True, client=client)
+        self._stream = None
+        self._closed = False
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        if self._closed:
+            raise StopIteration
+        if self._stream is None:
+            if current_turn_budget() is not self._ledger:
+                raise BudgetError("origin_budget_scope_missing")
+            require_native_dispatch_route(self._client, self._attempt.request, self._wire_format,
+                                          model_id=self._model_id)
+            self._attempt.start()
+            try:
+                self._stream = _BudgetStream(self._factory(self._attempt.request), self._attempt)
+            except BaseException:
+                self._attempt.unknown()
+                raise
+        return next(self._stream)
+
+    def close(self):
+        if self._closed:
+            return
+        self._closed = True
+        if self._stream is not None:
+            self._stream.close()
+        else:
+            try:
+                self._ledger.cancel_before_dispatch(self._attempt.id)
+            except BudgetError:
+                pass
+
+
+def native_dispatch_lazy_stream(client, request, factory, *, wire_format, model_id=None,
+                                category=None, expected_handle=None):
+    ledger = _active_ledger(expected_handle)
+    if ledger is None:
+        attempt = _normal_observer(client, request, wire_format, category or _CATEGORY.get(), model_id=model_id)
+        if attempt is None:
+            return factory(request)
+        def observed_generator():
+            _validate_unbounded_deferred_origin(attempt.ledger, expected_handle)
+            final_request = (_neutral_wire_request(client, request, wire_format)
+                             if attempt.ledger.policy.level == 6 else request)
+            attempt.start()
+            wrapped = None
+            try:
+                wrapped = _BudgetStream(factory(final_request), attempt)
+                yield from wrapped
+            finally:
+                if wrapped is not None:
+                    wrapped.close()
+                else:
+                    attempt.unknown()
+        return observed_generator()
+    binding = require_native_dispatch_route(client, request, wire_format, model_id=model_id)
+    return _BudgetLazyStream(client, request, factory, wire_format, model_id, ledger, binding,
+                             category or _CATEGORY.get())
+
+
+def native_dispatch_sync(client, request, send, *, wire_format, category=None,
+                         stream=False, expected_handle=None, model_id=None):
+    ledger = _active_ledger(expected_handle)
+    if ledger is None:
+        return _observed_sync(client, request, send, wire_format, category or _CATEGORY.get(), stream, model_id)
+    binding = require_native_dispatch_route(client, request, wire_format, model_id=model_id)
+    attempt = _Attempt(ledger, binding, request, category or _CATEGORY.get(), client=client)
+    try:
+        result = send(attempt.request)
+        if stream and not _is_completed_stream_response(result, wire_format):
+            return _BudgetStream(result, attempt)
+    except BaseException:
+        attempt.unknown()
+        raise
+    attempt.complete(result)
+    return result
+
+
+async def native_dispatch_async(client, request, send, *, wire_format,
+                                category="auxiliary", stream=False, expected_handle=None):
+    ledger = _active_ledger(expected_handle)
+    if ledger is None:
+        return await _observed_async(client, request, send, wire_format, category, stream)
+    binding = require_native_dispatch_route(client, request, wire_format)
+    attempt = _Attempt(ledger, binding, request, category, client=client)
+    try:
+        result = await send(attempt.request)
+        if stream and not _is_completed_stream_response(result, wire_format):
+            return _BudgetAsyncStream(result, attempt)
+    except BaseException:
+        attempt.unknown()
+        raise
+    attempt.complete(result)
+    return result
+
+
+class _BudgetStreamManager:
+    def __init__(self, client, request, factory, wire_format, category, expected_handle):
+        from copy import deepcopy
+        self._client, self._request, self._factory = client, deepcopy(request), factory
+        self._wire_format, self._category = wire_format, category
+        self._expected_handle = expected_handle
+        self._ledger = _active_ledger(expected_handle)
+        self._manager = self._attempt = self._stream = None
+
+    def __enter__(self):
+        if self._manager is not None:
+            raise BudgetError("stream_manager_already_entered")
+        ledger = _active_ledger(self._expected_handle)
+        if ledger is not self._ledger:
+            raise BudgetError("origin_budget_scope_missing")
+        binding = require_native_dispatch_route(self._client, self._request, self._wire_format)
+        self._attempt = _Attempt(ledger, binding, self._request, self._category, client=self._client)
+        try:
+            self._manager = self._factory(self._attempt.request)
+            self._stream = _BudgetStream(self._manager.__enter__(), self._attempt)
+            return self._stream
+        except BaseException:
+            self._attempt.unknown()
+            raise
+
+    def __exit__(self, *exc):
+        try:
+            if self._manager is not None:
+                return self._manager.__exit__(*exc)
+        finally:
+            if self._attempt is not None:
+                self._attempt.unknown()
+
+
+def native_dispatch_manager(client, request, factory, *, wire_format,
+                            category=None, expected_handle=None):
+    if _active_ledger(expected_handle) is None:
+        attempt = _normal_observer(client, request, wire_format, category or _CATEGORY.get())
+        if attempt is None:
+            return factory(request)
+        # Native SDK manager construction is unchanged; dispatch starts at its
+        # context entry, not when the caller merely constructs the manager.
+        manager = factory(_neutral_wire_request(client, request, wire_format))
+        class ObservedManager:
+            def __enter__(self):
+                _validate_unbounded_deferred_origin(attempt.ledger, expected_handle)
+                attempt.start()
+                try:
+                    return _BudgetStream(manager.__enter__(), attempt)
+                except BaseException:
+                    attempt.unknown()
+                    raise
+            def __exit__(self, *exc):
+                try:
+                    return manager.__exit__(*exc)
+                finally:
+                    attempt.unknown()
+        return ObservedManager()
+    # Capture admission scope now; manager entry may occur in another thread.
+    require_native_dispatch_route(client, request, wire_format)
+    return _BudgetStreamManager(client, request, factory, wire_format, category or _CATEGORY.get(), expected_handle)
+
+
+def native_bedrock_dispatch(client, request, *, stream=False, expected_handle=None):
+    """One actual boto3 Converse attempt, preserving native stream containers."""
+    if not stream:
+        return native_dispatch_sync(client, request, lambda wire: client.converse(**wire),
+            wire_format="bedrock_converse", model_id=request.get("modelId"), expected_handle=expected_handle)
+    response = {}
+    def send(wire):
+        response["raw"] = client.converse_stream(**wire)
+        return response["raw"].get("stream", [])
+    events = native_dispatch_sync(client, request, send, wire_format="bedrock_converse", stream=True,
+        model_id=request.get("modelId"), expected_handle=expected_handle)
+    return {**response["raw"], "stream": events}
