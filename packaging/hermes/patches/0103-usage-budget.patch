+class MemoryStore(UsageBudgetStore):
+    def __init__(self, level=1):
+        super().__init__(ROOT / "synthetic-profile-no-io")
+        self.preference = UsagePreference(revision=1, level=level)
+        self.claims = set()
+
+    def get(self):
+        return self.preference
+
+    def claim_origin(self, origin_id, generation_id):
+        from agent.usage_budget_store import BudgetStoreError
+        if origin_id in self.claims:
+            raise BudgetStoreError("origin_already_admitted")
+        self.claims.add(origin_id)
+        return self.preference
+
+    def bind_origin_claim(self, origin_id, generation_id):
+        if origin_id not in self.claims:
+            raise AssertionError("fixture has no accepted origin")
