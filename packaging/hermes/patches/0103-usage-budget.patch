+def normal(**overrides):
+    return NormalBudget(**dict({
+        "input_tokens": 8_000, "output_tokens": 2_000,
+        "thinking_tokens": 1_000, "max_iterations": 32,
+        "turn_reference_tokens": 80_000, "turn_reference_calls": 32,
+    }, **overrides))
+
+
+def limits(**overrides):
+    return VerifiedModelLimits(**dict({
+        "context_tokens": 32_000, "output_tokens": 8_000,
+        "thinking_tokens": 4_000, "max_iterations": 64,
+        "evidence_id": "offline:model-a:runtime-1",
+    }, **overrides))
+
+
+def policy(level=1, **kwargs):
+    return resolve_policy(level, kwargs.pop("normal", normal()),
+                          kwargs.pop("limits", limits()), **kwargs)
+
+
+def reserve(ledger, attempt_id="call-1", *, input_tokens=100,
+            output_tokens=100, **kwargs):
+    return ledger.reserve(attempt_id, input_tokens=input_tokens,
+                          output_tokens=output_tokens, input_is_exact=True,
+                          output_cap_verified=True, **kwargs)
