+"""Pure terminal display projection: no profile, provider or filesystem fixture."""
+import json
+from types import SimpleNamespace
+import unittest
+
+from agent.usage_budget import NormalBudget, TurnBudgetLedger, VerifiedModelLimits, resolve_policy
+from agent.usage_budget_preferences import UsagePreference
+from agent.usage_budget_projection import project_budget_constraints
+from agent.usage_budget_runtime import OriginBudgetHandle
+
+
+def origin(level=6):
+    preference = UsagePreference(3, level)
+    policy = resolve_policy(level, NormalBudget(input_tokens=4096, output_tokens=2048,
+                            turn_reference_tokens=16384, turn_reference_calls=16),
+                            VerifiedModelLimits(), version=3, strict=False)
+    ledger = TurnBudgetLedger("synthetic-origin", policy)
+    # No store is needed: projection does not exercise or consult owner authority.
+    return OriginBudgetHandle("synthetic-origin", "synthetic-generation", preference, ledger, object())
+
+
+class ProjectionTests(unittest.TestCase):
+    def test_level_six_exposes_required_original_number_not_a_model_maximum(self):
+        handle = origin()
+        handle.ledger.record_native_constraint("anthropic_messages", "max_tokens", 4096)
+        projected = project_budget_constraints(handle, SimpleNamespace())
+        self.assertEqual([{"schema_version": 1, "wire_format": "anthropic_messages",
+                           "parameter": "max_tokens", "retained_value": 4096,
+                           "reason": "api_required_parameter"}], projected)
+        self.assertEqual(0, handle.ledger.snapshot().observed_calls)
+
+    def test_only_frozen_level_six_emits_constraints(self):
+        for level in range(1, 6):
+            with self.subTest(level=level):
+                handle = origin(level)
+                handle.ledger.record_native_constraint("anthropic_messages", "max_tokens", 256)
+                self.assertEqual([], project_budget_constraints(handle, SimpleNamespace(_config_context_length=8192)))
+
+    def test_known_raw_context_settings_are_displayed_and_never_mutated(self):
+        compressor = SimpleNamespace(threshold_tokens_cap=12000, _base_threshold_percent=.5)
+        agent = SimpleNamespace(_config_context_length=32768, context_compressor=compressor)
+        before = (dict(vars(agent)), dict(vars(compressor)))
+        projected = project_budget_constraints(origin(), agent)
+        self.assertEqual([("context_length", 32768), ("threshold_tokens_cap", 12000),
+                          ("threshold_basis_points", 5000)],
+                         [(p["parameter"], p["retained_value"]) for p in projected])
+        self.assertTrue(all(p["reason"] == "existing_context_setting" for p in projected))
+        self.assertEqual(before, (vars(agent), vars(compressor)))
+
+    def test_unknown_numeric_fields_remain_null_not_zero_or_text(self):
+        for value in (True, -1, 2**63, "synthetic-secret", {}, 1.5):
+            with self.subTest(type=type(value).__name__):
+                projected = project_budget_constraints(origin(), SimpleNamespace(_config_context_length=value))
+                self.assertEqual(1, len(projected))
+                self.assertIsNone(projected[0]["retained_value"])
+                self.assertNotIn("synthetic-secret", json.dumps(projected))
+
+    def test_unknown_percentage_is_nullable_and_known_basis_points_are_bounded(self):
+        for value in (True, -1, float("nan"), float("inf"), 2, "0.5"):
+            compressor = SimpleNamespace(_base_threshold_percent=value)
+            self.assertIsNone(project_budget_constraints(origin(), SimpleNamespace(context_compressor=compressor))[0]["retained_value"])
+        self.assertEqual(10000, project_budget_constraints(origin(), SimpleNamespace(
+            context_compressor=SimpleNamespace(_base_threshold_percent=1)))[0]["retained_value"])
+
+    def test_properties_and_custom_getattribute_cannot_probe(self):
+        class Compressor:
+            @property
+            def threshold_tokens_cap(self):
+                raise AssertionError("would probe provider")
+
+            @property
+            def _base_threshold_percent(self):
+                raise AssertionError("would resolve metadata")
+
+        class Agent:
+            def __init__(self):
+                self.context_compressor = Compressor()
+
+            @property
+            def _config_context_length(self):
+                raise AssertionError("would read config")
+
+            def __getattribute__(self, name):
+                raise AssertionError("custom getter must never run")
+
+        self.assertEqual([], project_budget_constraints(origin(), Agent()))
+
+    def test_custom_dictionary_property_is_not_invoked(self):
+        class Agent:
+            @property
+            def __dict__(self):
+                raise AssertionError("custom dictionary getter")
+        self.assertEqual([], project_budget_constraints(origin(), Agent()))
+
+    def test_null_unset_fields_and_absent_origin_emit_nothing(self):
+        self.assertEqual([], project_budget_constraints(None, object()))
+        self.assertEqual([], project_budget_constraints(origin(), SimpleNamespace(
+            _config_context_length=None, context_compressor=None)))
+        self.assertEqual([], project_budget_constraints(SimpleNamespace(ledger="secret"), object()))
+
+    def test_unknown_labels_never_echo_and_huge_wire_numbers_are_null(self):
+        handle = origin()
+        handle.ledger.record_native_constraint("synthetic-private-endpoint", "synthetic-secret", 42)
+        handle.ledger.record_native_constraint("anthropic_messages", "max_tokens", 2**65)
+        projected = project_budget_constraints(handle, SimpleNamespace(api_key="synthetic-key", model="synthetic-model"))
+        self.assertEqual(1, len(projected))
+        self.assertIsNone(projected[0]["retained_value"])
+        self.assertNotIn("synthetic", json.dumps(projected))
+
+    def test_display_bound_prioritizes_context_and_preserves_ledger(self):
+        handle = origin()
+        for value in range(50):
+            handle.ledger.record_native_constraint("anthropic_messages", "max_tokens", value)
+        before = handle.ledger.snapshot()
+        projected = project_budget_constraints(handle, SimpleNamespace(_config_context_length=8192))
+        self.assertEqual(32, len(projected))
+        self.assertEqual("native_context", projected[0]["wire_format"])
+        self.assertEqual(before, handle.ledger.snapshot())
+        self.assertTrue(all(set(p) == {"schema_version", "wire_format", "parameter", "retained_value", "reason"}
+                            for p in projected))
+
+    def test_projection_after_stop_still_reports_constraints_without_new_attempt(self):
+        handle = origin()
+        handle.ledger.record_native_constraint("bedrock_converse", "thinking.budget_tokens", 2048)
+        handle.ledger.stop()
+        self.assertEqual(2048, project_budget_constraints(handle, SimpleNamespace())[0]["retained_value"])
+        self.assertTrue(handle.ledger.snapshot().stopped)
+        self.assertEqual(0, handle.ledger.snapshot().observed_calls)
+
+
+if __name__ == "__main__":
+    unittest.main()
