+    def test_two_real_processes_serialize_compare_and_swap(self):
+        workers = [self.worker("process-a", 0, 1), self.worker("process-b", 0, 6)]
+        results = []
+        try:
+            for process in workers:
+                output, error = process.communicate(timeout=15)
+                self.assertEqual(0, process.returncode, error)
+                results.append(json.loads(output))
+        finally:
+            for process in workers:
+                if process.poll() is None:
+                    process.kill()
+                    process.wait(timeout=5)
+        self.assertEqual(1, sum(value["status"] == "committed" for value in results))
+        self.assertEqual(1, sum(value["status"] == "revision_conflict" for value in results))
