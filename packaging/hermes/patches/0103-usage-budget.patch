+++ b/agent/usage_budget_host_policy.py
@@ -0,0 +1,243 @@
+"""Immutable host policy assembly; no catalog fallback becomes certification.
+
+The native ingress captures the preference before queued work starts, then
+passes this callable snapshot to bind_native_origin. Its inputs come from the
+trusted selected-model host, not a tool packet or preference JSON. No model,
+profile, environment, network or token-count service is consulted here.
+
+The two native ingress assemblers use explicit, versioned engineering reference
+allowances below. Catalog fallbacks are not model certification. Estimated input is explicitly
+non-strict; economy wire capability is independently checked by dispatch.
+Level 6 removes human usage limits, not by inventing provider maximum values.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+import hashlib
+import json
+from urllib.parse import urlsplit
+
+from agent.usage_budget import BudgetError, NormalBudget, VerifiedModelLimits, resolve_policy
+from agent.usage_budget_dispatch import WireRoute
+from agent.usage_budget_preferences import UsagePreference
+
+
+def _positive(value, name):
+    if type(value) is not int or value < 1:
+        raise BudgetError("invalid_" + name)
+
+
+@dataclass(frozen=True)
+class EconomyReferences:
+    """Explicit host reference allowances, never restrictions on normal mode.
+
+    Request references bound modes 1--4 and preserve smaller native values. Turn calls
+    count admitted dispatch attempts and are NOT derived from logical iterations
+    or a billing guarantee. Input usage may be estimated. The input allocation
+    reserve is an explicit engineering allowance, not a measured mandatory cost.
+    These references are engineering allowances, never model capacity evidence.
+    """
+    input_tokens: int
+    output_tokens: int
+    turn_tokens: int
+    turn_calls: int
+    input_allocation_reserve_tokens: int = 0
+
+    def __post_init__(self):
+        for name in ("input_tokens", "output_tokens", "turn_tokens", "turn_calls"):
+            _positive(getattr(self, name), "economy_reference_" + name)
+        if (type(self.input_allocation_reserve_tokens) is not int
+                or self.input_allocation_reserve_tokens < 0):
+            raise BudgetError("invalid_economy_reference_input_allocation_reserve_tokens")
+
+
+# Applied only to levels 1--4. These are source-reviewed starting allowances,
+# not the player's normal policy, provider maxima or predicted bill savings.
+# Default level 1: 45,056 estimated request-input tokens, 2,048 output tokens,
+# 262,144 aggregate estimated tokens and 8 admitted dispatch attempts. The
+# 32,768 input allocation reserve leaves room for protected prompts/tools; it
+# does not claim their measured size or guarantee any particular request fits.
+ECONOMY_REFERENCE_VERSION = "lilith-economy-20260926-v2"
+DEFAULT_ECONOMY_REFERENCES = EconomyReferences(131072, 16384, 2097152, 64, 32768)
+
+
+@dataclass(frozen=True)
+class HostPolicySnapshot:
+    """One selected model's immutable baseline, independent from saved level.
+
+    A host must construct a new snapshot when the selected model changes. The
+    route identifies the baseline; it does not register or certify an outbound
+    client. Descendants inherit their parent's ledger, not a new snapshot/budget.
+    """
+    route: WireRoute
+    normal: NormalBudget
+    reference: EconomyReferences
+    limits: VerifiedModelLimits
+    mandatory_input_tokens: int = 0
+    input_count_is_exact: bool = False
+
+    def __post_init__(self):
+        if (type(self.route) is not WireRoute or type(self.normal) is not NormalBudget
+                or type(self.reference) is not EconomyReferences
+                or type(self.limits) is not VerifiedModelLimits):
+            raise BudgetError("invalid_host_policy_snapshot")
+        if type(self.mandatory_input_tokens) is not int or self.mandatory_input_tokens < 0:
+            raise BudgetError("invalid_mandatory_input_tokens")
+        if type(self.input_count_is_exact) is not bool:
+            raise BudgetError("invalid_host_count_mode")
+
+    def __call__(self, preference: UsagePreference):
+        if type(preference) is not UsagePreference:
+            raise BudgetError("invalid_usage_preference")
+        baseline = self.normal
+        if preference.level <= 4:
+            # Fill explicit economy references without rewriting the preserved
+            # native baseline. Level 5 subsequently still restores None/custom.
+            baseline = replace(
+                baseline,
+                input_tokens=(min(baseline.input_tokens, self.reference.input_tokens)
+                              if baseline.input_tokens is not None else self.reference.input_tokens),
+                output_tokens=(min(baseline.output_tokens, self.reference.output_tokens)
+                               if baseline.output_tokens is not None else self.reference.output_tokens),
+                turn_reference_tokens=self.reference.turn_tokens,
+                turn_reference_calls=self.reference.turn_calls,
+            )
+        policy = resolve_policy(
+            preference.level, baseline, self.limits,
+            version=preference.revision,
+            mandatory_input_tokens=self.mandatory_input_tokens,
+            input_allocation_reserve_tokens=self.reference.input_allocation_reserve_tokens,
+            strict=self.input_count_is_exact,
+        )
+        return replace(policy, normal=self.normal)
+
+    def describe(self, preference: UsagePreference):
+        """Content-free local projection, not an applied-UI or dispatch receipt."""
+        policy = self(preference)
+        return {
+            "level": policy.level,
+            "revision": policy.version,
+            "input_count_mode": ("native" if policy.level >= 5 else
+                                 "exact" if self.input_count_is_exact else "estimated"),
+            "request_input_tokens": policy.input_tokens,
+            "request_output_tokens": policy.output_tokens,
+            "request_thinking_tokens": policy.thinking_tokens,
+            "logical_iterations": policy.max_iterations,
+            "turn_token_allowance": policy.turn_token_limit,
+            "turn_actual_call_allowance": policy.turn_call_limit,
+            "unresolved": policy.unresolved,
+        }
+
+
+def _native_optional_positive(value):
+    """Normalize only native numeric fields; never inspect arbitrary settings.
+
+    Config strings are allowed as in native initialization. Invalid, disabled,
+    dynamic or absent fields are not a numeric restriction. No zero/negative
+    pseudo-unlimited value is passed into a positive policy field.
+    """
+    if type(value) is int:
+        return value if value > 0 else None
+    if type(value) is str:
+        try:
+            result = int(value)
+            return result if result > 0 else None
+        except ValueError:
+            pass
+    return None
+
+
+def _endpoint_identity(value):
+    # Hosts may have userinfo or credentials in URL queries. They must not be
+    # retained, hashed into diagnostics or displayed as a policy identity.
+    if not isinstance(value, str) or not value:
+        return ""
+    try:
+        parsed = urlsplit(value)
+        return (parsed.scheme.lower(), (parsed.hostname or "").lower(),
+                parsed.port, parsed.path.rstrip("/"))
+    except ValueError:
+        raise BudgetError("invalid_host_endpoint") from None
+
+
+def _host_route(model, provider, base_url, api_mode):
+    if not isinstance(model, str) or not model.strip():
+        raise BudgetError("host_model_unresolved")
+    if provider is not None and not isinstance(provider, str):
+        raise BudgetError("invalid_host_provider")
+    if api_mode is not None and not isinstance(api_mode, str):
+        raise BudgetError("invalid_host_adapter")
+    # This is a baseline identity only, not dispatch capability registration.
+    # Hash arbitrary model/provider names to keep opaque IDs schema-safe.
+    def opaque(value):
+        return hashlib.sha256(json.dumps(value, ensure_ascii=True,
+                                        separators=(",", ":")).encode()).hexdigest()
+    return WireRoute("host-" + opaque([provider, _endpoint_identity(base_url)]),
+                     "model-" + opaque(model.strip()), "adapter-" + opaque(api_mode))
+
+
+def _thinking_cap(reasoning_config):
+    # Native reasoning_config follows the OpenRouter-shaped max_tokens field.
+    # Effort/enabled/exclude are behavior switches, not numeric budgets.
+    if isinstance(reasoning_config, dict):
+        return _native_optional_positive(reasoning_config.get("max_tokens"))
+    return None
+
+
+def build_host_policy_resolver(agent):
+    """Snapshot a resolved native AIAgent; no profile reads, probes or mutation.
+
+    Called just before binding the accepted human-origin ticket. A later model
+    switch gets a fresh snapshot next turn. The compressor's guessed metadata
+    window is deliberately not used as certified capacity or normal policy.
+    """
+    return HostPolicySnapshot(
+        route=_host_route(getattr(agent, "model", None), getattr(agent, "provider", None),
+                          getattr(agent, "base_url", None), getattr(agent, "api_mode", None)),
+        normal=NormalBudget(
+            input_tokens=_native_optional_positive(getattr(agent, "_config_context_length", None)),
+            output_tokens=_native_optional_positive(getattr(agent, "max_tokens", None)),
+            thinking_tokens=_thinking_cap(getattr(agent, "reasoning_config", None)),
+            max_iterations=_native_optional_positive(getattr(agent, "max_iterations", None))),
+        reference=DEFAULT_ECONOMY_REFERENCES, limits=VerifiedModelLimits(),
+        input_count_is_exact=False,
+    )
+
+
+def build_config_policy_resolver(config, *, model, provider, base_url, api_mode,
+                                 max_tokens=None, max_iterations=None,
+                                 reasoning_config=None):
+    """Build the same policy before Gateway vision, from native resolved inputs.
+
+    The caller already applies session > channel > global route precedence.
+    No credentials are accepted and no model discovery is performed. A global
+    context pin belongs only to its matching configured route; a switched
+    model must not inherit a different model's context pin. Final adapters
+    remain responsible for actual model capacity and protocol evidence.
+    """
+    if not isinstance(config, dict):
+        raise BudgetError("invalid_host_config")
+    model_config = config.get("model", {})
+    if not isinstance(model_config, dict):
+        model_config = {}
+    # Mirror native fallback for the optional output setting without mutating
+    # it. None means the resolved route did not override the config setting.
+    output = _native_optional_positive(max_tokens)
+    if max_tokens is None:
+        output = _native_optional_positive(model_config.get("max_tokens"))
+    same_model = str(model_config.get("default") or "").strip() == str(model).strip()
+    configured_provider = str(model_config.get("provider") or "").strip().lower()
+    same_provider = bool(configured_provider) and configured_provider == str(provider or "").strip().lower()
+    configured_endpoint = model_config.get("base_url")
+    same_endpoint = (not configured_endpoint or
+                     _endpoint_identity(configured_endpoint) == _endpoint_identity(base_url))
+    context = (_native_optional_positive(model_config.get("context_length"))
+               if same_model and same_provider and same_endpoint else None)
+    return HostPolicySnapshot(
+        route=_host_route(model, provider, base_url, api_mode),
+        normal=NormalBudget(input_tokens=context, output_tokens=output,
+                            thinking_tokens=_thinking_cap(reasoning_config),
+                            max_iterations=_native_optional_positive(max_iterations)),
+        reference=DEFAULT_ECONOMY_REFERENCES, limits=VerifiedModelLimits(),
+        input_count_is_exact=False,
+    )
