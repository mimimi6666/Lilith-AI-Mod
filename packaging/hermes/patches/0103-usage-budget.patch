+class OriginContextTests(unittest.TestCase):
+    def test_nested_binding_same_origin_and_finally_reset(self):
+        ledger = TurnBudgetLedger("turn-1", policy())
+        self.assertIsNone(current_turn_budget())
+        with self.assertRaises(RuntimeError):
+            with bind_turn_budget(ledger):
+                self.assertIs(ledger, current_turn_budget())
+                with bind_turn_budget(ledger):
+                    self.assertIs(ledger, current_turn_budget())
+                raise RuntimeError("synthetic")
+        self.assertIsNone(current_turn_budget())
+
+    def test_descendant_cannot_replace_origin_with_fresh_allowance(self):
+        ledger = TurnBudgetLedger("turn-1", policy())
+        another = TurnBudgetLedger("turn-2", policy())
+        with bind_turn_budget(ledger):
+            with self.assertRaises(BudgetError) as raised:
+                with bind_turn_budget(another):
+                    self.fail("replacement accepted")
+            self.assertEqual("origin_budget_replacement_forbidden", raised.exception.code)
+
+    def test_async_child_inherits_same_ledger_not_new_policy(self):
+        ledger = TurnBudgetLedger("turn-1", policy(version=12))
+        # Real asyncio Tasks copy and restore ContextVars, but asyncio.run on
+        # Windows creates a socketpair even for sleep(0). Use a callback-only
+        # test loop so the audit harness can forbid ALL sockets unchanged.
+        class CallbackOnlyLoop(asyncio.AbstractEventLoop):
+            def __init__(self):
+                self.ready = deque()
+
+            def get_debug(self):
+                return False
+
+            def call_soon(self, callback, *args, context=None):
+                handle = asyncio.Handle(callback, args, self, context=context)
+                self.ready.append(handle)
+                return handle
+
+            def call_exception_handler(self, context):
+                raise AssertionError("Unexpected asynchronous test exception")
+
+            def drain(self):
+                while self.ready:
+                    self.ready.popleft()._run()
+
+        async def child():
+            await asyncio.sleep(0)
+            return current_turn_budget()
+
+        loop = CallbackOnlyLoop()
+        with bind_turn_budget(ledger):
+            task = asyncio.Task(child(), loop=loop)
+        self.assertIsNone(current_turn_budget())
+        loop.drain()
+        self.assertIs(ledger, task.result())
+        self.assertIsNone(current_turn_budget())
+
+    def test_background_thread_requires_explicit_context_propagation(self):
+        ledger = TurnBudgetLedger("turn-1", policy())
+        with bind_turn_budget(ledger):
+            context = copy_context()
+            with ThreadPoolExecutor(max_workers=1) as pool:
+                self.assertIsNone(pool.submit(current_turn_budget).result(timeout=10))
+                self.assertIs(ledger, pool.submit(context.run, current_turn_budget).result(timeout=10))
+
+
+if __name__ == "__main__":
+    unittest.main()
