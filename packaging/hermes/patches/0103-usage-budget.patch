+"""Actual selected compressor methods plus structural batch guard checks."""
+import ast
+from contextlib import nullcontext
+import logging
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import BudgetError, NormalBudget, TurnBudgetLedger, VerifiedModelLimits, bind_turn_budget, resolve_policy
+from agent.usage_budget_compression import require_complete_budgeted_summary
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "agent" / "context_compressor.py"
+
+
+def ledger(level):
+    return TurnBudgetLedger("summary-fixture", resolve_policy(level,
+        NormalBudget(input_tokens=8000, output_tokens=8000, turn_reference_tokens=80000, turn_reference_calls=32),
+        VerifiedModelLimits()))
+
+
+def response(reason="stop"):
+    return SimpleNamespace(choices=[SimpleNamespace(finish_reason=reason,
+        message=SimpleNamespace(content="Preserved summary."))])
+
+
+def method(name):
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "ContextCompressor")
+    node = next(node for node in cls.body if isinstance(node, ast.FunctionDef) and node.name == name)
+    scope = {"BudgetError": BudgetError, "require_complete_budgeted_summary": require_complete_budgeted_summary,
+             "logger": logging.getLogger("synthetic-compressor"),
+             "COMPRESSED_SUMMARY_METADATA_KEY": "summary", "MICRO_COMPACT_MARKER_KEY": "micro",
+             "_DB_PERSISTED_MARKER": "persisted"}
+    module = ast.Module(body=ast.parse("from __future__ import annotations").body + [node], type_ignores=[])
+    exec(compile(module, str(SOURCE), "exec"), scope)
+    return scope[name]
+
+
+class CompressionBudgetTests(unittest.TestCase):
+    def test_app_server_compaction_rejects_unsupported_levels_before_process_work(self):
+        path = SOURCE.with_name("conversation_compression.py")
+        tree = ast.parse(path.read_text(encoding="utf-8"))
+        node = next(n for n in tree.body if isinstance(n, ast.FunctionDef)
+                    and n.name == "_compress_context_via_codex_app_server")
+        scope = {"logger": logging.getLogger("synthetic-compressor")}
+        module = ast.Module(body=ast.parse("from __future__ import annotations").body + [node], type_ignores=[])
+        exec(compile(module, str(path), "exec"), scope)
+        owner = SimpleNamespace(codex_app_server_auto_compaction="hermes",
+                                _codex_session=object())
+        messages = [{"role": "user", "content": "keep intact"}]
+        for level in (1, 2, 3, 4, 6):
+            with bind_turn_budget(ledger(level)), self.assertRaisesRegex(BudgetError, "route_not_integrated"):
+                scope[node.name](owner, messages, "identity", force=True)
+        self.assertEqual("keep intact", messages[0]["content"])
+
+    def test_app_server_noop_still_needs_no_paid_admission(self):
+        path = SOURCE.with_name("conversation_compression.py")
+        tree = ast.parse(path.read_text(encoding="utf-8"))
+        node = next(n for n in tree.body if isinstance(n, ast.FunctionDef)
+                    and n.name == "_compress_context_via_codex_app_server")
+        scope = {"logger": logging.getLogger("synthetic-compressor")}
+        module = ast.Module(body=ast.parse("from __future__ import annotations").body + [node], type_ignores=[])
+        exec(compile(module, str(path), "exec"), scope)
+        owner = SimpleNamespace(codex_app_server_auto_compaction="native",
+                                _cached_system_prompt="unchanged")
+        messages = [{"role": "user", "content": "keep intact"}]
+        with bind_turn_budget(ledger(6)):
+            self.assertEqual((messages, "unchanged"), scope[node.name](owner, messages, None))
+
+    def test_normal_and_unbound_keep_native_response_behavior(self):
+        require_complete_budgeted_summary(None)
+        with bind_turn_budget(ledger(5)):
+            require_complete_budgeted_summary(response("length"))
+
+    def test_complete_normalized_economic_summary(self):
+        for reason in ("stop", "end_turn", "stop_sequence"):
+            with self.subTest(reason=reason), bind_turn_budget(ledger(1)):
+                require_complete_budgeted_summary(response(reason))
+
+    def test_partial_missing_and_tool_finish_cannot_replace_context(self):
+        for value in (response("length"), response(None), response("tool_calls"),
+                      None, {"choices": []}, {"choices": [{"finish_reason": "MAX_TOKENS"}]}):
+            with self.subTest(value=value), bind_turn_budget(ledger(1)), self.assertRaises(BudgetError):
+                require_complete_budgeted_summary(value)
+
+    def test_unlimited_mode_does_not_add_economic_completion_gate(self):
+        with bind_turn_budget(ledger(6)):
+            require_complete_budgeted_summary(response("length"))
+
+    def run_micro(self, effect):
+        calls = []
+        aux = ModuleType("agent.auxiliary_client")
+        def call(**kwargs):
+            calls.append(kwargs)
+            if isinstance(effect, Exception):
+                raise effect
+            return effect
+        aux.call_llm = call
+        aux.aux_interrupt_protection = nullcontext
+        runtime = ModuleType("agent.agent_runtime_helpers")
+        runtime.strip_think_blocks = lambda _, content: content
+        owner = SimpleNamespace(
+            _micro_compact_rolling_summary="Old summary", max_summary_tokens=1500,
+            summary_model="", model="", _build_micro_summary_prompt=lambda *_: [{"role": "user", "content": "synthetic"}],
+            _strict_identity_summary_messages=lambda messages: messages,
+            _strict_identity_summary_runtime=lambda _: None)
+        with patch.dict(sys.modules, {"agent.auxiliary_client": aux, "agent.agent_runtime_helpers": runtime}):
+            try:
+                return method("_micro_summarize_one")(owner, "new exchange"), calls
+            finally:
+                self.assertEqual(1, len(calls))
+                self.assertEqual("Old summary", owner._micro_compact_rolling_summary)
+
+    def test_actual_micro_method_propagates_budget_without_retry(self):
+        with bind_turn_budget(ledger(1)), self.assertRaisesRegex(BudgetError, "turn_token_limit"):
+            self.run_micro(BudgetError("turn_token_limit"))
+
+    def test_actual_micro_method_rejects_capped_partial(self):
+        with bind_turn_budget(ledger(1)), self.assertRaisesRegex(BudgetError, "summary_completion_unverified"):
+            self.run_micro(response("length"))
+
+    def test_actual_micro_method_complete_and_normal_compatibility(self):
+        with bind_turn_budget(ledger(1)):
+            self.assertEqual("Preserved summary.", self.run_micro(response())[0])
+        with bind_turn_budget(ledger(5)):
+            self.assertEqual("Preserved summary.", self.run_micro(response("length"))[0])
+
+    def test_actual_defrag_restores_old_summary_on_budget_error(self):
+        owner = SimpleNamespace(_micro_compact_rolling_summary="Keep this checkpoint")
+        def fail(_):
+            self.assertEqual("", owner._micro_compact_rolling_summary)
+            raise BudgetError("turn_stopped")
+        owner._micro_summarize_one = fail
+        messages = [{"role": "user", "content": "untouched"}]
+        with self.assertRaises(BudgetError):
+            method("_defrag_rolling_summary")(owner, messages)
+        self.assertEqual("Keep this checkpoint", owner._micro_compact_rolling_summary)
+        self.assertEqual([{"role": "user", "content": "untouched"}], messages)
+
+    def test_batch_typed_failure_precedes_generic_fallback_and_restores_scan(self):
+        tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+        generate = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "_generate_summary")
+        handlers = next(n.handlers for n in ast.walk(generate) if isinstance(n, ast.Try)
+                        and any(isinstance(h.type, ast.Name) and h.type.id == "BudgetError" for h in n.handlers))
+        self.assertEqual("BudgetError", handlers[0].type.id)
+        self.assertIsInstance(handlers[0].body[-1], ast.Raise)
+        compress = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "compress")
+        handler = next(n for n in ast.walk(compress) if isinstance(n, ast.ExceptHandler)
+                       and isinstance(n.type, ast.Tuple)
+                       and {e.id for e in n.type.elts} == {"AuxiliaryExplicitCancellation", "BudgetError"})
+        scope = {"self": SimpleNamespace(_previous_summary="changed", _summary_has_user_turn=False),
+                 "_previous_summary_before_scan": "original", "_summary_has_user_turn_before_scan": True}
+        # Execute actual rollback statements; re-raise itself belongs to the catch.
+        exec(compile(ast.Module(body=handler.body[:-1], type_ignores=[]), str(SOURCE), "exec"), scope)
+        self.assertEqual("original", scope["self"]._previous_summary)
+        self.assertTrue(scope["self"]._summary_has_user_turn)
+
+
+if __name__ == "__main__":
+    unittest.main()
