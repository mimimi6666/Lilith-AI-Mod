@@ -0,0 +1,360 @@
+"""Request-only economy projection; never a history/memory writer or tokenizer.
+
+Only structurally closed, unchanged, older pre-turn units can be omitted. All current
+input, system/developer messages and ephemeral insertions are mandatory. The
+host counter measures this projection, not the provider's final wire: final
+dispatch must still count/admit the converted request independently.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from dataclasses import dataclass
+import hashlib
+import json
+from threading import RLock
+from weakref import ref
+
+from agent.usage_budget import BudgetError, BudgetExceeded, current_turn_budget
+from agent.usage_budget_dispatch import InputCount
+
+
+EFFICIENCY_GUIDANCE = (
+    "[Efficient execution]\n"
+    "Prefer a known, currently ready method for the correct target with the fewest "
+    "necessary model/tool steps. Reuse prior successful methods or fresh read results "
+    "only while their target, version and readiness still apply. Once the requested "
+    "outcome has sufficient evidence, stop; if an attempt makes no progress, do not "
+    "repeat it unchanged. Explore only when needed within the available allowance. "
+    "Do not skip approval, privacy, identity or safety checks, and do not suppress "
+    "intentional repeated actions."
+)
+
+
+def with_efficiency_guidance(system_prompt):
+    """Stable per-turn suffix: cached/stored identity prompt is untouched.
+
+    The model learns the chosen exploration policy without an extra planner.
+    Values describe the frozen allowance, not a promise about provider bills.
+    No dynamic per-attempt counter churns the cacheable system prefix.
+    """
+    if not isinstance(system_prompt, str):
+        raise BudgetError("invalid_system_projection")
+    if system_prompt.endswith(EFFICIENCY_GUIDANCE):
+        return system_prompt
+    ledger = current_turn_budget()
+    economy_guidance = ""
+    if ledger is not None and ledger.policy.enforce_economy_limits:
+        policy = ledger.policy
+        priorities = {
+            1: "Strongest economy: prefer direct execution via an already-ready, target-bound method; avoid broad discovery.",
+            2: "High economy: reuse applicable methods; allow only a small, focused check when essential.",
+            3: "Balanced economy: use focused exploration only where existing methods cannot meet the request.",
+            4: "Light economy: keep necessary investigation, but avoid redundant discovery and repeated checks.",
+        }
+        economy_guidance = (
+            f"[Usage mode {policy.level}/6]\n{priorities[policy.level]} "
+            f"This source turn shares an allowance of {policy.turn_call_limit} model requests "
+            f"and {policy.turn_token_limit} estimated tokens across replies, retries, delegates and background work. "
+            "Spend only what is needed; these are allowances, not targets. "
+            "Do not launch extra planning, verification or summaries after sufficient completion evidence. "
+            "If the target is ambiguous, clarify instead of guessing or exploring unrelated apps. "
+            "Never claim an unsent action or unsaved memory succeeded.\n\n"
+        )
+    suffix = economy_guidance + EFFICIENCY_GUIDANCE
+    return (system_prompt + "\n\n" + suffix) if system_prompt else suffix
+
+
+@dataclass(frozen=True)
+class _ObservedRow:
+    message: dict
+    digest: bytes
+
+
+@dataclass(frozen=True)
+class HistorySelection:
+    # Strong references avoid identity reuse during one origin turn. No content
+    # leaves this process; digests are neither logged nor persisted.
+    units: tuple[tuple[_ObservedRow, ...], ...] = ()
+
+
+@dataclass(frozen=True)
+class ContextSelection:
+    messages: list
+    status: str
+    removed_units: int = 0
+    removed_messages: int = 0
+    input_tokens: int | None = None
+    exact: bool = False
+
+    def status_wire(self):
+        return {"status": self.status, "removed_units": self.removed_units,
+                "removed_messages": self.removed_messages,
+                "input_tokens": self.input_tokens, "exact": self.exact}
+
+
+def _digest(message):
+    try:
+        data = json.dumps(message, ensure_ascii=True, sort_keys=True,
+                          separators=(",", ":"), allow_nan=False)
+        return hashlib.sha256(data.encode("ascii")).digest()
+    except (TypeError, ValueError, RecursionError):
+        return None
+
+
+def _completed_unit(rows):
+    """Structurally closed exchange, NOT proof the user's goal was completed."""
+    if (len(rows) < 2 or rows[0].get("role") != "user"
+            or rows[-1].get("role") != "assistant"
+            or not rows[-1].get("content") or rows[-1].get("tool_calls")):
+        return False
+    pending, seen = set(), set()
+    for index, row in enumerate(rows):
+        role = row.get("role")
+        # Native continuation/notification/prefill markers may carry active
+        # task state even in an otherwise closed role sequence. Preserve it;
+        # never infer "finished" from assistant prose or a tool name.
+        if (row.get("display_kind") or row.get("_thinking_prefill")
+                or row.get("_length_continuation_fragment")
+                or row.get("_length_continuation_nudge")
+                or (row.get("finish_reason") not in (None, "stop", "end_turn")
+                    and not (role == "assistant" and row.get("tool_calls")
+                             and row.get("finish_reason") in ("tool_calls", "tool_use")))):
+            return False
+        if row.get("function_call") or role not in {"user", "assistant", "tool"}:
+            return False
+        if role == "user":
+            if index != 0 or row.get("tool_calls"):
+                return False
+        elif role == "assistant":
+            if pending:
+                return False
+            calls = row.get("tool_calls")
+            if calls is not None and not isinstance(calls, list):
+                return False
+            for call in calls or ():
+                if not isinstance(call, dict):
+                    return False
+                call_id = call.get("id")
+                if type(call_id) is not str or not call_id or call_id in seen:
+                    return False
+                function = call.get("function")
+                if not isinstance(function, dict) or type(function.get("arguments")) is not str:
+                    return False
+                # We omit whole rows, never abbreviate the JSON arguments.
+                try:
+                    json.loads(function["arguments"])
+                except (ValueError, TypeError, RecursionError):
+                    return False
+                seen.add(call_id)
+                pending.add(call_id)
+        elif role == "tool":
+            call_id = row.get("tool_call_id")
+            if type(call_id) is not str or call_id not in pending:
+                return False
+            pending.remove(call_id)
+    return not pending
+
+
+def capture_completed_history(messages, current_turn_user_idx):
+    """Capture ONLY before-turn history, never infer a boundary from its text.
+
+    If repair/compression later replaces a row, or a steer changes an old tool
+    result, that unit loses eligibility. We do not re-capture a moving boundary
+    and accidentally label this turn's earlier inputs as completed history.
+    """
+    if (type(current_turn_user_idx) is not int or not isinstance(messages, list)
+            or not 0 <= current_turn_user_idx < len(messages)
+            or not isinstance(messages[current_turn_user_idx], dict)
+            or messages[current_turn_user_idx].get("role") != "user"):
+        return HistorySelection()
+    units, chunk = [], []
+
+    def append_chunk():
+        if chunk and _completed_unit(chunk):
+            digests = tuple(_digest(row) for row in chunk)
+            if all(value is not None for value in digests):
+                units.append(tuple(_ObservedRow(row, digest)
+                                   for row, digest in zip(chunk, digests)))
+
+    for row in messages[:current_turn_user_idx]:
+        if not isinstance(row, dict):
+            # Unknown data is not interpreted as disposable context.
+            append_chunk()
+            chunk = []
+            continue
+        if row.get("role") == "user":
+            append_chunk()
+            chunk = []
+        chunk.append(row)
+    append_chunk()
+    # A final assistant message can say "continue later". Always retain the
+    # latest closed exchange, so a new "continue" keeps its immediate task
+    # context. Earlier task dependencies cannot be semantically certified by
+    # role shape; callers may supply additional mandatory context in prefill.
+    return HistorySelection(tuple(units[:-1]))
+
+
+def capture_budget_history(messages, current_turn_user_idx):
+    ledger = current_turn_budget()
+    if ledger is None or not ledger.policy.enforce_economy_limits:
+        return HistorySelection()
+    return capture_completed_history(messages, current_turn_user_idx)
+
+
+_COUNTERS = {}
+_COUNTER_LOCK = RLock()
+
+
+def _route_fingerprint(agent):
+    client = getattr(agent, "client", None)
+    fields = tuple(str(getattr(agent, name, ""))
+                   for name in ("model", "provider", "api_mode", "base_url"))
+    endpoint = str(getattr(client, "base_url", ""))
+    return (id(client), id(getattr(client, "_http", None)),
+            id(getattr(client, "_client", None)),
+            hashlib.sha256(repr((fields, endpoint)).encode("utf-8")).digest())
+
+
+def register_context_counter(agent, counter):
+    """Internal trusted-host seam, never a tool/RPC or model-supplied callback.
+
+    ``counter(messages, tools) -> InputCount`` must be local and side-effect-free.
+    An adapter may provide an exact converted-input count; a reviewed rough
+    counter must return exact=False. No tokenizer is guessed here. Changing
+    agent/provider/client/endpoint invalidates the binding until host rebinds it.
+    """
+    if not callable(counter):
+        raise BudgetError("invalid_context_counter")
+    identity = id(agent)
+
+    def retire(weak):
+        with _COUNTER_LOCK:
+            existing = _COUNTERS.get(identity)
+            if existing is not None and existing[0] is weak:
+                _COUNTERS.pop(identity, None)
+
+    try:
+        weak = ref(agent, retire)
+    except TypeError:
+        raise BudgetError("context_counter_identity_unsupported") from None
+    with _COUNTER_LOCK:
+        _COUNTERS[identity] = (weak, _route_fingerprint(agent), counter)
+
+
+def _bound_counter(agent):
+    with _COUNTER_LOCK:
+        stored = _COUNTERS.get(id(agent))
+    if (stored is None or stored[0]() is not agent
+            or stored[1] != _route_fingerprint(agent)):
+        return None
+    return stored[2]
+
+
+def _eligible_projection_units(selection, source, projected, history_offset):
+    if (type(selection) is not HistorySelection or type(history_offset) is not int
+            or history_offset < 0 or len(projected) != len(source) + history_offset):
+        return ()
+    positions = {id(row): index for index, row in enumerate(source)}
+    if len(positions) != len(source):
+        return ()
+    result = []
+    for unit in selection.units:
+        indices = []
+        for observed in unit:
+            index = positions.get(id(observed.message))
+            if (index is None or source[index] is not observed.message
+                    or _digest(source[index]) != observed.digest
+                    or _projection_digest(projected[history_offset + index])
+                    != _projection_digest(source[index])):
+                break
+            indices.append(history_offset + index)
+        else:
+            if (indices == list(range(indices[0], indices[0] + len(indices)))
+                    and all(isinstance(projected[i], dict) for i in indices)
+                    and _completed_unit([projected[i] for i in indices])):
+                result.append(tuple(indices))
+    return tuple(sorted(result, key=lambda unit: unit[0]))
+
+
+def _projection_digest(row):
+    if not isinstance(row, dict):
+        return None
+    # These fields are unconditionally removed by the owned projection loop.
+    # Every other difference (including added memory/role content, canonical
+    # tool changes or reasoning conversion) conservatively protects the unit.
+    removed = {"api_content", "display_kind", "display_metadata", "_row_id",
+               "_terminal_error_closed", "reasoning", "finish_reason",
+               "_length_continuation_fragment", "_length_continuation_nudge"}
+    return _digest({key: value for key, value in row.items() if key not in removed})
+
+
+def select_working_context(projected, source, history, *, history_offset,
+                           policy, counter, tools=None):
+    """Drop whole oldest eligible units only until the selected input fits.
+
+    Counter failures/unknown counts leave input unchanged; the final wire guard
+    remains authoritative. Known mandatory overflow ends locally, not with an
+    extra model compression call or a silent larger allowance.
+    """
+    if policy is None or not policy.enforce_economy_limits:
+        return ContextSelection(projected, "normal_passthrough")
+    cap = policy.input_tokens
+    if cap is None or counter is None:
+        return ContextSelection(projected, "counter_unavailable")
+
+    def count(rows):
+        try:
+            result = counter(deepcopy(rows), deepcopy(tools))
+        except BudgetError:
+            raise
+        except Exception:
+            return None
+        if (type(result) is not InputCount or type(result.tokens) is not int
+                or result.tokens < 0 or type(result.exact) is not bool
+                or (policy.strict and not result.exact)):
+            return None
+        return result
+
+    measured = count(projected)
+    if measured is None:
+        return ContextSelection(projected, "counter_unavailable")
+    if measured.tokens <= cap:
+        return ContextSelection(projected, "unchanged", input_tokens=measured.tokens,
+                                exact=measured.exact)
+    eligible = _eligible_projection_units(history, source, projected, history_offset)
+    removed = set()
+    removed_units = 0
+    for unit in eligible:
+        removed.update(unit)
+        removed_units += 1
+        selected = [row for i, row in enumerate(projected) if i not in removed]
+        measured = count(selected)
+        if measured is None:
+            # Never present an unmeasured partial selection as a budget fit.
+            return ContextSelection(projected, "counter_unavailable")
+        if measured.tokens <= cap:
+            return ContextSelection(selected, "trimmed", removed_units,
+                                    len(removed), measured.tokens, measured.exact)
+    raise BudgetExceeded("mandatory_context_exceeds_allowance")
+
+
+def prepare_budget_context(agent, projected, source, history, *, history_offset,
+                           estimate_input=None):
+    """Actual conversation-loop seam, before request selection/sanitization."""
+    ledger = current_turn_budget()
+    policy = ledger.policy if ledger is not None else None
+    counter = _bound_counter(agent) if policy and policy.enforce_economy_limits else None
+    if (counter is None and policy is not None and policy.enforce_economy_limits
+            and not policy.strict and callable(estimate_input)):
+        # Explicitly estimated mode can reuse Hermes' existing whole-request
+        # rough estimator. It counts tools/images too but is NOT a tokenizer or
+        # certified upper bound. Strict mode never falls back to this branch.
+        def counter(messages, tools):
+            return InputCount(estimate_input(messages, tools=tools), False)
+    result = select_working_context(
+        projected, source, history, history_offset=history_offset,
+        policy=policy, counter=counter,
+        tools=getattr(agent, "tools", None),
+    )
+    agent._usage_budget_context_status = result.status_wire()
+    return result.messages
