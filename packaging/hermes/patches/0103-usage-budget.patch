+            with bind_turn_budget(budget(level)):
+                native_chat_dispatch_sync(client, request, lambda value: client.chat.completions.create(**value))
+        self.assertEqual([222, None, 222], [r["reasoning"].get("max_tokens") for r in sent])
+        self.assertEqual({"enabled": True, "exclude": True, "effort": "low"}, sent[1]["reasoning"])
+        self.assertEqual([999, None, 999], [r.get("max_tokens") for r in sent])
+        self.assertEqual(222, request["extra_body"]["reasoning"]["max_tokens"])
+
+    def responses_client(self, sent, base="https://api.openai.com/v1", output=80, missing=False):
+        def handle(request):
