+class PreferenceContractTests(unittest.TestCase):
+    def test_absent_preference_is_unchanged_normal(self):
+        self.assertEqual(UsagePreference().to_wire(),
+                         {"schema_version": 1, "revision": 0, "level": 5})
+
+    def test_all_six_levels_roundtrip_without_exposing_numeric_knobs(self):
+        for level in range(1, 7):
+            with self.subTest(level=level):
+                current = UsagePreference()
+                packet = {"schema_version": 1, "operation_id": "test-" + str(level),
+                          "expected_revision": 0, "level": level}
+                update = parse_update(decode_packet(json.dumps(packet).encode()))
+                transition = plan_update(current, update)
+                self.assertEqual(transition.proposed, UsagePreference(1, level))
+                self.assertEqual(parse_preference(transition.proposed.to_wire()), transition.proposed)
+                self.assertEqual(parse_receipt(transition.receipt.to_wire()), transition.receipt)
+                self.assertTrue(matches_readback(transition.receipt, transition.proposed))
+                self.assertEqual(transition.receipt.to_wire()["applies_from"], APPLIES_FROM)
+
+    def test_snapshot_is_immutable_and_new_setting_cannot_change_admitted_turn(self):
+        frozen_turn_preference = UsagePreference(7, 1)
+        transition = plan_update(frozen_turn_preference, PreferenceUpdate("adjust", 7, 6))
+        self.assertEqual(frozen_turn_preference.level, 1)
+        self.assertEqual(transition.proposed.level, 6)
+        with self.assertRaises(FrozenInstanceError):
+            frozen_turn_preference.level = 6
+
+    def test_same_operation_replays_without_new_revision(self):
+        request = PreferenceUpdate("operation", 0, 2)
+        first = plan_update(UsagePreference(), request)
+        replay = plan_update(first.proposed, request, first.receipt)
+        self.assertTrue(replay.replay)
+        self.assertEqual(replay.proposed, first.proposed)
+        self.assertIs(replay.receipt, first.receipt)
+
+    def test_old_receipt_does_not_roll_back_newer_preference(self):
+        old_request = PreferenceUpdate("first", 0, 1)
+        first = plan_update(UsagePreference(), old_request)
+        second = plan_update(first.proposed, PreferenceUpdate("second", 1, 6))
+        replay = plan_update(second.proposed, old_request, first.receipt)
+        self.assertEqual(replay.proposed, second.proposed)
+        self.assertEqual(replay.receipt.committed, first.proposed)
+        self.assertFalse(matches_readback(replay.receipt, second.proposed))
