@@ -0,0 +1,72 @@
+"""Nullable usage readers, not endpoint/model capability certifications.
+
+Missing totals stay unknown. OpenAI-compatible totals already include cached
+input and reasoning output subsets. Anthropic's cache input fields are separate.
+Gemini's total includes prompt + thoughts + response candidates:
+https://ai.google.dev/api/generate-content#UsageMetadata
+https://platform.claude.com/docs/en/build-with-claude/prompt-caching
+"""
+from dataclasses import dataclass
+from agent.usage_budget_dispatch import UsageCount
+
+
+@dataclass(frozen=True)
+class NativeUsageEvent:
+    """Internal accounting event, consumed before the native stream consumer."""
+    value: dict
+
+
+def gemini_numeric_usage(raw):
+    if not isinstance(raw, dict):
+        return {}
+    return {key: raw[key] for key in (
+        "promptTokenCount", "totalTokenCount", "candidatesTokenCount", "thoughtsTokenCount",
+        "cachedContentTokenCount", "toolUsePromptTokenCount",
+    ) if key in raw and type(raw[key]) is int and raw[key] >= 0}
+
+
+def _get(value, name, default=None):
+    return value.get(name, default) if isinstance(value, dict) else getattr(value, name, default)
+
+
+def _count(value):
+    return value if type(value) is int and value >= 0 else None
+
+
+def read_usage(value, wire_format):
+    if wire_format == "gemini_generate_content":
+        raw = _get(value, "_lilith_gemini_usage")
+        if raw is None:
+            raw = _get(value, "usageMetadata")
+        if raw is None:
+            return UsageCount()
+        incoming = _count(_get(raw, "promptTokenCount"))
+        total = _count(_get(raw, "totalTokenCount"))
+        outgoing = total - incoming if total is not None and incoming is not None and total >= incoming else None
+        return UsageCount(incoming, outgoing)
+    raw = _get(value, "usage")
+    if wire_format == "anthropic_messages":
+        if raw is None:
+            raw = _get(_get(value, "message"), "usage")
+        incoming = _count(_get(raw, "input_tokens"))
+        if incoming is not None:
+            cached = _count(_get(raw, "cache_read_input_tokens", 0))
+            created = _count(_get(raw, "cache_creation_input_tokens", 0))
+            incoming = incoming + cached + created if cached is not None and created is not None else None
+        return UsageCount(incoming, _count(_get(raw, "output_tokens")))
+    if wire_format in {"chat_max_tokens", "chat_max_completion_tokens", "chat_completions"}:
+        return UsageCount(_count(_get(raw, "prompt_tokens")), _count(_get(raw, "completion_tokens")))
+    if wire_format == "responses":
+        if raw is None:
+            raw = _get(_get(value, "response"), "usage")
+        return UsageCount(_count(_get(raw, "input_tokens")), _count(_get(raw, "output_tokens")))
+    if wire_format == "bedrock_converse":
+        if raw is None:
+            raw = _get(_get(value, "metadata"), "usage")
+        incoming = _count(_get(raw, "inputTokens"))
+        if incoming is not None:
+            cached = _count(_get(raw, "cacheReadInputTokens", 0))
+            created = _count(_get(raw, "cacheWriteInputTokens", 0))
+            incoming = incoming + cached + created if cached is not None and created is not None else None
+        return UsageCount(incoming, _count(_get(raw, "outputTokens")))
+    return UsageCount()
