+def require_native_dispatch_route(client, request, wire_format, *, expected_handle=None, model_id=None):
+    """Validate an outer shim without reserving a second physical attempt."""
+    ledger = _active_ledger(expected_handle)
+    if ledger is None:
+        return None
+    model = request.get("model") if model_id is None else model_id
+    with _BINDINGS_LOCK:
+        try:
+            stored = _identity_entries(_BINDINGS, client).get((model, wire_format))
+        except TypeError:
+            stored = None
+    if stored is None:
+        from agent.usage_budget_official_routes import ensure_official_dispatch_binding
+        if not ensure_official_dispatch_binding(client, request, wire_format=wire_format, model_id=model_id):
+            raise BudgetError("native_budget_route_unverified")
+        with _BINDINGS_LOCK:
+            stored = _identity_entries(_BINDINGS, client).get((model, wire_format))
+        if stored is None:
+            raise BudgetError("native_budget_route_unverified")
+    fingerprint, binding = stored
+    if _client_fingerprint(client) != fingerprint:
+        raise BudgetError("native_budget_transport_changed")
+    # Client SDK options may have changed since the host attested this binding.
+    retries = getattr(client, "max_retries", binding.capability.sdk_max_retries)
+    if wire_format == "bedrock_converse":
+        config = getattr(getattr(client, "meta", None), "config", None)
+        options = getattr(config, "retries", {}) or {}
+        retries = 0 if type(options.get("total_max_attempts")) is int and options["total_max_attempts"] == 1 else None
+    if type(retries) is not int or retries != 0:
+        raise BudgetError("hidden_transport_retries")
+    return binding
+
+
+def reject_unintegrated_economic_route(name, *, expected_handle=None):
+    if _active_ledger(expected_handle) is not None:
+        raise BudgetError("native_budget_route_not_integrated")
+    ledger = current_turn_budget()
+    if ledger is not None and ledger.policy.level == 6:
+        raise BudgetError("native_unbounded_route_not_integrated")
+
+
+def _chat_wire_format(client, request):
+    with _BINDINGS_LOCK:
+        try:
+            entries = _identity_entries(_BINDINGS, client)
+            formats = [format_ for (model, format_) in entries
+                       if model == request.get("model") and format_ in {
+                           "chat_max_tokens", "chat_max_completion_tokens"}]
+        except TypeError:
+            formats = []
+    if len(formats) != 1:
+        if not formats:
+            from agent.usage_budget_official_routes import ensure_official_dispatch_binding, official_wire_format
+            if ensure_official_dispatch_binding(client, request):
+                with _BINDINGS_LOCK:
+                    formats = [f for (model, f) in _identity_entries(_BINDINGS, client)
+                               if model == request.get("model") and f in {"chat_max_tokens", "chat_max_completion_tokens"}]
+                if len(formats) == 1:
+                    return formats[0]
+        raise BudgetError("native_budget_route_unverified")
+    return formats[0]
+
