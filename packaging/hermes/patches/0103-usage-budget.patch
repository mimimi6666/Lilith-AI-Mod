+"""Economic summaries must be complete before replacing working context."""
+from agent.usage_budget import BudgetError, current_turn_budget
+
+
+def require_complete_budgeted_summary(response):
+    ledger = current_turn_budget()
+    if ledger is None or not ledger.policy.enforce_economy_limits:
+        return
+    try:
+        choices = response.get("choices") if isinstance(response, dict) else response.choices
+        if not isinstance(choices, (list, tuple)) or len(choices) != 1:
+            raise ValueError("invalid_summary_choices")
+        choice = choices[0]
+        reason = choice.get("finish_reason") if isinstance(choice, dict) else choice.finish_reason
+    except (AttributeError, KeyError, IndexError, TypeError, ValueError):
+        raise BudgetError("summary_completion_unverified") from None
+    # All supported auxiliary adapters normalize to OpenAI-style choices. A
+    # partial/thinking-only/tool-call/unknown answer is not a completed summary.
+    if reason not in ("stop", "end_turn", "stop_sequence"):
+        raise BudgetError("summary_completion_unverified")
