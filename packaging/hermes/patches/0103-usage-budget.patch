+def register_native_final_wire_shim(client, leaf_client, factory_type, *, wire_format):
+    """Only exact built-in adapter factories register a deferred final seam.
+
+    A marker attribute, subclass or equal-valued object cannot opt out of
+    admission. The eventual leaf also requires independent host route evidence.
+    This is an internal trusted-host seam, not a sandbox against Python code
+    which can replace modules or invoke private host APIs.
+    """
+    allowed = {
+        ("agent.gemini_native_adapter", "GeminiNativeClient"): "gemini_generate_content",
+        ("agent.gemini_native_adapter", "AsyncGeminiNativeClient"): "gemini_generate_content",
+        ("agent.auxiliary_client", "AnthropicAuxiliaryClient"): "anthropic_messages",
+        ("agent.auxiliary_client", "AsyncAnthropicAuxiliaryClient"): "anthropic_messages",
+        ("agent.auxiliary_client", "CodexAuxiliaryClient"): "responses",
+        ("agent.auxiliary_client", "AsyncCodexAuxiliaryClient"): "responses",
+    }
+    module = sys.modules.get(getattr(factory_type, "__module__", ""))
+    key = (getattr(factory_type, "__module__", ""), getattr(factory_type, "__name__", ""))
+    if (type(client) is not factory_type or allowed.get(key) != wire_format or module is None
+            or getattr(module, key[1], None) is not factory_type):
+        raise BudgetError("native_shim_factory_unverified")
+    with _BINDINGS_LOCK:
+        entries = _identity_entries(_SHIMS, client, create=True)
+        try:
+            leaf_ref = ref(leaf_client)
+        except TypeError:
+            raise BudgetError("native_client_identity_unsupported") from None
+        entries["binding"] = (leaf_ref, factory_type, wire_format, _client_fingerprint(client))
+
+
+def try_register_native_final_wire_shim(client, leaf_client, factory_type, *, wire_format):
+    """Constructor compatibility: unsupported mocks remain usable in normal mode.
+
+    Failure leaves no deferred exemption. A subsequent economic dispatch must
+    still find a registered final route and therefore fails closed.
+    """
+    try:
+        register_native_final_wire_shim(client, leaf_client, factory_type, wire_format=wire_format)
+        return True
+    except BudgetError:
+        return False
+
+
+def _shim_binding(client, request):
+    with _BINDINGS_LOCK:
+        stored = _identity_entries(_SHIMS, client).get("binding")
+    if stored is None:
+        return None
+    leaf_ref, factory_type, wire_format, fingerprint = stored
+    leaf = leaf_ref()
+    if leaf is None or type(client) is not factory_type or _client_fingerprint(client) != fingerprint:
+        raise BudgetError("native_budget_transport_changed")
+    model = request.get("model")
+    if wire_format == "gemini_generate_content" and isinstance(model, str):
+        model = model.removeprefix("models/")
+    return require_native_dispatch_route(leaf, request, wire_format, model_id=model)
+
+
+def _require_shim_receipt(receipts, ledger, binding):
+    if not any(item[0] is ledger and item[1] == binding.capability.route for item in receipts):
+        raise BudgetError("native_final_guard_not_reached")
+
+
+def _normal_shim_has_inner_observer(client):
+    # This is only an observation de-duplication decision, never cap authority.
+    with _BINDINGS_LOCK:
+        stored = _identity_entries(_SHIMS, client).get("binding")
+    return stored is not None and stored[0]() is not None and type(client) is stored[1] and _client_fingerprint(client) == stored[3]
+
+
+def _is_native_multiplex_shim(client):
+    # These exact factories dispatch through multiple or late-created leaf
+    # clients. Never reserve the aggregate facade as an additional paid call.
+    cls = type(client)
+    key = (getattr(cls, "__module__", ""), getattr(cls, "__name__", ""))
+    module = sys.modules.get(key[0])
+    return (key in {("agent.moa_loop", "MoAClient"),
+                    ("agent.auxiliary_client", "BedrockAuxiliaryClient"),
+                    ("agent.auxiliary_client", "AsyncBedrockAuxiliaryClient")}
+            and module is not None and getattr(module, key[1], None) is cls)
+
+
+def _is_completed_stream_response(result, wire_format):
+    if wire_format != "responses":
+        return False
+    return (isinstance(result, dict) and "output" in result) or hasattr(result, "output")
+
