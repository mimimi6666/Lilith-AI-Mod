+"""Execute copied native function bodies against fake transports, offline.
+
+AST extraction avoids importing the installed runtime, SDKs, configuration or
+provider environment. It does NOT prove a complete native module import or real
+provider compatibility. The exercised dispatch/helper bodies are the actual
+candidate source, not reimplementations in this test.
+"""
+import ast
+import copy
+from contextlib import nullcontext
+import logging
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import BudgetError, NormalBudget, TurnBudgetLedger, VerifiedModelLimits, bind_turn_budget, resolve_policy
+from agent.usage_budget_dispatch import InputCount, UsageCount, WireCapability, WireRoute
+from agent.usage_budget_native_dispatch import (
+    NativeDispatchBinding, native_chat_dispatch_sync, native_chat_dispatch_async,
+    native_dispatch_sync, native_dispatch_manager, native_dispatch_lazy_stream, register_native_dispatch_binding,
+    register_native_final_wire_shim,
+)
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "agent"
+
+
+def extract(file, names, namespace=None):
+    tree = ast.parse((SOURCE / file).read_text(encoding="utf-8"), filename=file)
+    nodes = [node for node in tree.body if getattr(node, "name", None) in names]
+    if {node.name for node in nodes} != set(names):
+        raise AssertionError("native fixture target missing")
+    module = ast.Module(body=ast.parse("from __future__ import annotations").body + nodes, type_ignores=[])
+    scope = {"BudgetError": BudgetError, "logger": logging.getLogger("synthetic-native"), **(namespace or {})}
+    exec(compile(module, file, "exec"), scope)
+    return scope
+
+
+def immediate(coroutine):
+    """Fake async sends contain no I/O/scheduling; no event-loop sockets needed."""
+    try:
+        coroutine.send(None)
+    except StopIteration as done:
+        return done.value
+    finally:
+        coroutine.close()
+    raise AssertionError("unexpected asynchronous external work")
+
+
+def budget(level=1):
+    return TurnBudgetLedger("native-fixture", resolve_policy(
+        level, NormalBudget(input_tokens=8000, output_tokens=8000,
+                            turn_reference_calls=32, turn_reference_tokens=80000),
+        VerifiedModelLimits(context_tokens=32000, output_tokens=8000, evidence_id="synthetic-only")))
+
+
+def usage(value):
+    if isinstance(value, dict):
+        value = value.get("usage", {})
+        return UsageCount(value.get("input"), value.get("output"))
+    return UsageCount()
+
+
+def register(client, format_="chat_max_completion_tokens", model="synthetic-model", exact=True):
+    capability = WireCapability(format_, evidence_id="synthetic-adapter-only", output_cap_verified=True,
+                                all_output_counted=True, sdk_max_retries=0, final_wire_verified=True,
+                                route=WireRoute("fixture-transport", model, "fixture-adapter"))
+    register_native_dispatch_binding(client, NativeDispatchBinding(
+        capability, lambda _: InputCount(100, exact=exact), usage))
+
+
+class FakeStream:
+    def __init__(self, values=None):
+        self.values = iter(values if values is not None else [{"text": "partial"}, {"usage": {"input": 100, "output": 50}}])
+        self.closed = False
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        value = next(self.values)
+        if isinstance(value, BaseException):
+            raise value
+        return value
+
+    def close(self):
+        self.closed = True
+
+    def get_final_message(self):
+        list(self)
+        return {"usage": {"input": 100, "output": 50}, "answer": "finished"}
+
+
+class FakeManager:
+    def __init__(self, stream=None, error=None):
+        self.stream = stream or FakeStream()
+        self.error = error
+        self.closed = False
+
+    def __enter__(self):
+        if self.error:
+            raise self.error
+        return self.stream
+
+    def __exit__(self, *exc):
+        self.closed = True
+        self.stream.close()
+
+
+class FakeClient:
+    max_retries = 0
+
+    def __init__(self):
+        self.calls = []
+        self.manager_error = None
+        self.chat = SimpleNamespace(completions=SimpleNamespace(create=self.create))
+        self.messages = SimpleNamespace(create=self.create, stream=self.stream)
+
+    def create(self, **request):
+        self.calls.append(copy.deepcopy(request))
+        if request.get("stream"):
+            return FakeStream()
+        return {"answer": "finished", "usage": {"input": 100, "output": 50}}
+
+    def stream(self, **request):
+        self.calls.append(copy.deepcopy(request))
+        return FakeManager(error=self.manager_error)
+
