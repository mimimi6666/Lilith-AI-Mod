+            self.assertEqual(fields["max_tokens"], request["max_tokens"])
+        for fields in ({"max_tokens": 123, "max_completion_tokens": 124}, {"max_tokens": 0},
+                       {"max_tokens": True}, {"max_tokens": "123"}, {"max_tokens": None}):
+            ledger = TurnBudgetLedger("sdk-legacy-reject", replace(budget().policy, strict=False))
+            with bind_turn_budget(ledger), self.assertRaises(BudgetError):
+                native_chat_dispatch_sync(client, {"model": "synthetic-model", "messages": [], **fields},
+                                          lambda value: client.chat.completions.create(**value))
+        self.assertEqual(3, len(sent))
+
+    def test_actual_openrouter_unbounded_removes_only_optional_reasoning_cap(self):
+        sent = []
