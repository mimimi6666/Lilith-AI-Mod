+"""Narrow official API wire bindings, not model limits or an exact tokenizer.
+
+Evidence (API schema, not live billing certification):
+https://developers.openai.com/api/docs/guides/token-counting
+https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create
+https://platform.claude.com/docs/en/build-with-claude/thinking-steering-and-cost
+
+No compatibility proxy, cloud deployment or provider-name alias inherits an
+all-output hard-cap claim. Explicit reviewed estimated bindings separately mark
+requested or unavailable output control. The actual loaded SDK class, exact HTTPS API base,
+selected model identity and zero SDK retries are bound independently per client.
+Model availability and maximum capacities are NOT certified. Gemini's combined
+thinking/output cap is deliberately unclaimed by this reviewed subset.
+"""
+from __future__ import annotations
+
+import json
+import base64
+from copy import deepcopy
+import sys
+import re
+from weakref import ref
+from urllib.parse import urlsplit
+
+from agent.usage_budget import BudgetError
+from agent.usage_budget_dispatch import InputCount, WireCapability, WireRoute
+from agent.usage_budget_usage import read_usage
+
+_BEDROCK_CLIENTS = {}
+_DASHSCOPE_CHAT_ENDPOINTS = frozenset({
+    "https://dashscope.aliyuncs.com/compatible-mode/v1",
+    "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
+    "https://dashscope-us.aliyuncs.com/compatible-mode/v1",
+    "https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1",
+})
+
+
+def register_bedrock_factory_client(client, region):
+    """Called only by the native boto3 factory after isolated retry configuration.
+
+    API schema: https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_InferenceConfiguration.html
+    No model-specific additional fields or endpoint aliases inherit this claim.
+    """
+    module = sys.modules.get("botocore.client")
+    base = getattr(module, "BaseClient", None)
+    meta = getattr(client, "meta", None)
+    if (base is None or type(client).__bases__ != (base,)
+            or type(region) is not str or re.fullmatch(r"[a-z]{2}(?:-[a-z]+)+-\d", region) is None
+            or getattr(meta, "endpoint_url", None) != f"https://bedrock-runtime.{region}.amazonaws.com"
+            or getattr(getattr(client, "_endpoint", None), "host", None) != getattr(meta, "endpoint_url", None)
+            or getattr(getattr(meta, "service_model", None), "service_name", None) != "bedrock-runtime"):
+        raise BudgetError("bedrock_factory_identity_unverified")
+    _BEDROCK_CLIENTS[id(client)] = (ref(client), type(client), region)
+
+
+def _ensure_bedrock_binding(client, request, model_id):
+    entry = _BEDROCK_CLIENTS.get(id(client))
+    if entry is None or entry[0]() is not client or type(client) is not entry[1]:
+        return False
+    meta = getattr(client, "meta", None)
+    retries = getattr(getattr(meta, "config", None), "retries", {}) or {}
+    if (getattr(meta, "endpoint_url", None) != f"https://bedrock-runtime.{entry[2]}.amazonaws.com"
+            or getattr(getattr(client, "_endpoint", None), "host", None) != getattr(meta, "endpoint_url", None)
+            or type(retries.get("total_max_attempts")) is not int or retries["total_max_attempts"] != 1):
+        return False
+    route = WireRoute("official-bedrock-converse", model_id or request.get("modelId"), "native-bedrock-converse")
+    from agent.usage_budget_native_dispatch import NativeDispatchBinding, register_native_dispatch_binding
+    register_native_dispatch_binding(client, NativeDispatchBinding(
+        WireCapability("bedrock_converse", "aws-converse-schema-2026-09-26", True, True, 0, True, route),
+        estimate_final_input, lambda value: read_usage(value, "bedrock_converse")))
+    return True
+
+
+def _exact_sdk(client, package, names):
+    module = sys.modules.get(package)
+    return module is not None and any(type(client) is getattr(module, name, None) for name in names)
+
+
+def reviewed_http_transport_state(client):
+    """Known HTTPX transports only; custom retrying transports need own review.
+
+    MockTransport itself has no retry loop and exists solely for offline SDK
+    fixtures here. This does not certify what arbitrary callbacks do.
+    """
+    httpx = sys.modules.get("httpx")
+    http = getattr(client, "_http", None) or getattr(client, "_client", None)
+    if httpx is None or http is None:
+        return None
+    transports = [getattr(http, "_transport", None)] + [
+        value for value in getattr(http, "_mounts", {}).values() if value is not None]
+    state = []
+    for transport in transports:
+        if type(transport) is getattr(httpx, "MockTransport", None):
+            retries = 0
+        elif type(transport) in (getattr(httpx, "HTTPTransport", None), getattr(httpx, "AsyncHTTPTransport", None)):
+            retries = getattr(getattr(transport, "_pool", None), "_retries", None)
+        else:
+            return None
+        if type(retries) is not int or retries != 0:
+            return None
+        state.append((id(transport), retries))
+    return tuple(state)
+
+
+def official_wire_format(client):
+    """Return an API schema only; this does not certify an arbitrary request."""
+    try:
+        endpoint = str(client.base_url).rstrip("/")
+        parsed = urlsplit(endpoint)
+        if parsed.username is not None or parsed.password is not None or parsed.query or parsed.fragment:
+            return None
+        if endpoint == "https://api.openai.com/v1" and _exact_sdk(client, "openai", ("OpenAI", "AsyncOpenAI")):
+            return "chat_max_completion_tokens"
+        if endpoint == "https://api.anthropic.com" and _exact_sdk(client, "anthropic", ("Anthropic", "AsyncAnthropic")):
+            return "anthropic_messages"
+    except Exception:
+        pass
+    return None
+
+
+def is_official_openrouter_chat(client):
+    """Only recognizes optional reasoning syntax; NOT a hard-cap certification.
+
+    https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
+    """
+    try:
+        return (str(client.base_url).rstrip("/") == "https://openrouter.ai/api/v1"
+                and _exact_sdk(client, "openai", ("OpenAI", "AsyncOpenAI")))
+    except Exception:
+        return False
+
+
+def is_official_dashscope_chat(client):
+    """Fixed public compatibility endpoints, not OAuth or arbitrary proxies.
+
+    https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope
+    https://www.alibabacloud.com/help/en/model-studio/qwen-api-via-openai-chat-completions
+    Workspace-specific domains require a separately reviewed endpoint binding.
+    """
+    return (_exact_sdk(client, "openai", ("OpenAI", "AsyncOpenAI"))
+            and str(getattr(client, "base_url", "")).rstrip("/") in _DASHSCOPE_CHAT_ENDPOINTS)
+
+
+def normalize_official_economy_request(client, request, wire_format):
+    """Use the total-output field only for the exact reviewed OpenAI API.
+
+    Call only for levels 1–4, before final counting and reservation. A smaller
+    caller cap stays smaller; conflicting/invalid fields never enlarge it.
+    """
+    if (wire_format != "chat_max_completion_tokens"
+            or official_wire_format(client) != wire_format or "max_tokens" not in request):
+        return request
+    legacy = request["max_tokens"]
+    if type(legacy) is not int or legacy <= 0:
+        raise BudgetError("invalid_existing_output_cap")
+    if "max_completion_tokens" in request:
+        modern = request["max_completion_tokens"]
+        if type(modern) is not int or modern <= 0:
+            raise BudgetError("invalid_existing_output_cap")
+        if modern != legacy:
+            raise BudgetError("conflicting_output_caps")
+    result = dict(request)
+    result.pop("max_tokens")
+    result["max_completion_tokens"] = legacy
+    return result
+
+
+def estimate_final_input(request):
+    """Native heuristic over the complete final body; explicitly NOT exact."""
+    from agent.model_metadata import estimate_tokens_rough
+    try:
+        body = dict(request)
+        extra = body.pop("extra_body", None)
+        if isinstance(extra, dict):
+            body.update(extra)
+        for key in ("timeout", "extra_headers", "extra_query", "stream_options"):
+            body.pop(key, None)  # SDK transport controls are not model input.
+        body, image_tokens = _image_estimate_shadow(body)
+        def encode_binary(value):
+            if isinstance(value, (bytes, bytearray)):
+                return base64.b64encode(value).decode("ascii")
+            raise TypeError("unsupported_wire_value")
+        serialized = json.dumps(body, ensure_ascii=False, separators=(",", ":"), allow_nan=False,
+                                default=encode_binary)
+        result = estimate_tokens_rough(serialized) + image_tokens
+    except Exception:
+        raise BudgetError("native_input_estimate_unavailable") from None
+    if type(result) is not int or result < 0:
+        raise BudgetError("native_input_estimate_unavailable")
+    return InputCount(result, exact=False)
+
+
+def _image_estimate_shadow(body):
+    """Known image content only; never alter the actual request or tool schema.
+
+    Native102 model_metadata.estimate_messages_tokens_rough uses a flat 1500
+    tokens/image. This same heuristic is NOT image/model/tokenizer evidence.
+    Unknown audio/video/document payloads remain conservatively serialized.
+    """
+    result, count = deepcopy(body), 0
+    def content_parts(parts):
+        nonlocal count
+        if not isinstance(parts, list):
+            return
+        for part in parts:
+            if not isinstance(part, dict):
+                continue
+            kind = part.get("type")
+            if kind in {"image_url", "input_image"} and "image_url" in part:
+                image = part["image_url"]
+                if isinstance(image, dict) and isinstance(image.get("url"), str):
+                    image["url"] = "[image]"
+                    count += 1
+                elif isinstance(image, str):
+                    part["image_url"] = "[image]"
+                    count += 1
+            elif kind == "input_image" and isinstance(part.get("file_id"), str):
+                part["file_id"] = "[image]"
+                count += 1
+            elif kind == "image" and isinstance(part.get("source"), dict):
+                source = part["source"]
+                field = "data" if source.get("type") == "base64" else "url" if source.get("type") == "url" else None
+                if field is not None and isinstance(source.get(field), str):
+                    source[field] = "[image]"
+                    count += 1
+            elif kind == "tool_result":
+                content_parts(part.get("content"))
+            elif isinstance(part.get("image"), dict):  # Bedrock content block
+                source = part["image"].get("source")
+                if isinstance(source, dict) and (isinstance(source.get("bytes"), (bytes, bytearray))
+                                                  or isinstance(source.get("s3Location"), dict)):
+                    part["image"]["source"] = {"image": "[image]"}
+                    count += 1
+    for key in ("messages", "input"):
+        messages = result.get(key)
+        if isinstance(messages, list):
+            for message in messages:
+                if isinstance(message, dict):
+                    content_parts(message.get("content"))
+    contents = result.get("contents")
+    if isinstance(contents, list):
+        for item in contents:
+            if not isinstance(item, dict) or not isinstance(item.get("parts"), list):
+                continue
+            for part in item["parts"]:
+                if not isinstance(part, dict):
+                    continue
+                for key, data_key in (("inlineData", "data"), ("fileData", "fileUri")):
+                    data = part.get(key)
+                    if (isinstance(data, dict) and str(data.get("mimeType", "")).lower().startswith("image/")
+                            and isinstance(data.get(data_key), (str, bytes, bytearray))):
+                        data[data_key] = "[image]"
+                        count += 1
+    return result, count * 1500
+
+
+def _requested_official_format(client):
+    if _exact_sdk(client, "openai", ("OpenAI", "AsyncOpenAI")):
+        endpoint = str(client.base_url).rstrip("/")
+        if endpoint == "https://openrouter.ai/api/v1":
+            return "chat_max_tokens", "requested"
+        # Final schema only, not a guarantee across each model's thinking
+        # semantics. Strict mode refuses these estimated-output bindings.
+        # https://api-docs.deepseek.com/api/create-chat-completion/
+        if endpoint in {"https://api.deepseek.com", "https://api.deepseek.com/v1"} or is_official_dashscope_chat(client):
+            return "chat_max_tokens", "requested"
+        if endpoint == "https://chatgpt.com/backend-api/codex":
+            return "responses", "unavailable"
+    cls = type(client)
+    module = sys.modules.get("agent.gemini_native_adapter")
+    if (module is not None and cls is getattr(module, "GeminiNativeClient", None)
+            and str(client.base_url).rstrip("/") == "https://generativelanguage.googleapis.com/v1beta"):
+        httpx = sys.modules.get("httpx")
+        http = getattr(client, "_http", None)
+        if (httpx is not None and type(http) is getattr(httpx, "Client", None)
+                and reviewed_http_transport_state(client) is not None):
+            return "gemini_generate_content", "requested"
+    return None
+
+
+def split_final_sdk_body(client, request, wire_format):
+    """Guard the actual SDK extra_body merge, then restore its call signature."""
+    if not (_exact_sdk(client, "openai", ("OpenAI", "AsyncOpenAI"))
+            and (official_wire_format(client) or _requested_official_format(client))):
+        return request, lambda body: body
+    extra = request.get("extra_body")
+    if not extra:
+        return request, lambda body: body
+    if type(extra) is not dict:
+        raise BudgetError("invalid_extra_body")
+    # These controls are interpreted by the SDK before its body merge. Moving
+    # them into JSON could change response shape after stream accounting chose
+    # its lifecycle, or put transport-only objects in an allegedly final body.
+    if any(key in extra for key in ("stream", "stream_options", "timeout", "extra_headers",
+                                   "extra_query", "extra_body")):
+        raise BudgetError("late_wire_override")
+    body = {key: value for key, value in request.items() if key != "extra_body"}
+    body.update(extra)
+    original_keys = set(request) - {"extra_body"}
+    output_keys = {"max_tokens", "max_completion_tokens", "max_output_tokens"}
+    def restore(guarded):
+        result = {key: value for key, value in guarded.items() if key in original_keys or key in output_keys}
+        rest = {key: value for key, value in guarded.items() if key not in result}
+        if rest:
+            result["extra_body"] = rest
+        return result
+    return body, restore
+
+
+def lower_reviewed_thinking_budget(client, body, wire_format, policy):
+    """Only lower an existing numeric budget; never enable/disable reasoning.
+
+    Anthropic manual mode has a documented 1024 minimum and requires room for
+    an answer. No model-name inference changes adaptive/effort modes. Google
+    and OpenRouter remain requested estimates, not hard thinking guarantees.
+    https://platform.claude.com/docs/en/build-with-claude/extended-thinking
+    https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
+    https://ai.google.dev/gemini-api/docs/thinking
+    """
+    result = deepcopy(body)
+    node, key, limit, minimum = None, None, policy.thinking_tokens, None
+    if wire_format == "anthropic_messages":
+        thinking = result.get("thinking")
+        if isinstance(thinking, dict) and thinking.get("type") == "enabled":
+            node, key, minimum = thinking, "budget_tokens", 1024
+            native_output = result.get("max_tokens")
+            if native_output is not None and (type(native_output) is not int or native_output <= 0):
+                raise BudgetError("invalid_existing_output_cap")
+            output = min(policy.output_tokens, native_output or policy.output_tokens)
+            limit = min(limit, output - 1) if limit is not None else output - 1
+    elif wire_format == "gemini_generate_content":
+        generation = result.get("generationConfig")
+        thinking = generation.get("thinkingConfig") if isinstance(generation, dict) else None
+        if isinstance(thinking, dict):
+            node, key = thinking, "thinkingBudget"
+            # Known public numeric thinking modes accept 1024; a lower target
+            # needs exact-model minimum evidence, not an inferred model family.
+            minimum = 1024
+    elif is_official_openrouter_chat(client):
+        reasoning = result.get("reasoning")
+        if isinstance(reasoning, dict):
+            node, key, minimum = reasoning, "max_tokens", 1024
+    elif is_official_dashscope_chat(client):
+        node, key, minimum = result, "thinking_budget", 1
+    if node is not None and key in node and limit is not None:
+        existing = node[key]
+        if type(existing) is not int:
+            raise BudgetError("invalid_thinking_budget")
+        # Zero/-1 may mean disabled/dynamic in a native protocol, not a cap.
+        if existing > 0 and limit < existing:
+            if minimum is not None and limit < minimum:
+                raise BudgetError("thinking_budget_minimum_unresolved")
+            node[key] = limit
+    return result
+
+
+def ensure_official_dispatch_binding(client, request, *, wire_format=None, model_id=None):
+    """Typed install hook used only at the final native dispatch boundary.
+
+    An unsupported route remains unsupported; there is no fallback certification.
+    A release host still has to provide explicit economy reference allowances.
+    """
+    if wire_format == "bedrock_converse":
+        return _ensure_bedrock_binding(client, request, model_id)
+    actual_format = official_wire_format(client)
+    output_control = "verified"
+    if actual_format is None:
+        requested = _requested_official_format(client)
+        if requested is not None:
+            actual_format, output_control = requested
+    if wire_format == "responses" and actual_format == "chat_max_completion_tokens":
+        actual_format = "responses"
+    if actual_format is None or (wire_format is not None and wire_format != actual_format):
+        return False
+    if reviewed_http_transport_state(client) is None:
+        return False
+    retries = getattr(client, "max_retries", 0 if actual_format == "gemini_generate_content" else None)
+    if type(retries) is not int or retries != 0:
+        return False
+    model = request.get("model") if model_id is None else model_id
+    try:
+        route = WireRoute("reviewed-native-" + actual_format,
+                          model, "native-" + actual_format)
+    except BudgetError:
+        return False
+    from agent.usage_budget_native_dispatch import NativeDispatchBinding, register_native_dispatch_binding
+    register_native_dispatch_binding(client, NativeDispatchBinding(
+        WireCapability(actual_format, evidence_id="official-wire-schema-2026-09-26", output_cap_verified=output_control == "verified",
+                       all_output_counted=output_control == "verified", sdk_max_retries=0, final_wire_verified=True, route=route),
+        estimate_final_input, lambda value: read_usage(value, actual_format), output_control))
+    return True
diff --git a/agent/usage_budget_preferences.py b/agent/usage_budget_preferences.py
new file mode 100644
--- /dev/null
+++ b/agent/usage_budget_preferences.py
@@ -0,0 +1,210 @@
+"""Pure next-origin-turn preference transaction contracts (inactive candidate).
+
+This module is not an RPC, authentication boundary, file store or permission
+owner. A future Hermes-owned setter must bind the profile from its authenticated
+human channel and atomically persist the planned snapshot AND operation receipt
+under the native single-writer gate. Never write config.yaml through this helper:
+economic revisions must not invalidate tool/approval attestations or sessions.
+
+Only the level is player-selectable here. Numeric limits come from the native
+policy resolver, never arbitrary request fields, model text or remembered data.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import re
+from typing import Any
+
+
+SCHEMA_VERSION = 1
+MAX_REVISION = 2**63 - 1
+MAX_PACKET_BYTES = 2048
+APPLIES_FROM = "next_origin_turn"
+_OPERATION_ID = re.compile(r"[A-Za-z0-9_-]{1,96}\Z", re.ASCII)
+
+
+class PreferenceError(ValueError):
+    """Fixed, content-free protocol diagnostic; never echo rejected payloads."""
+
+
+def _integer(value: Any, minimum: int, maximum: int, field: str) -> int:
+    if type(value) is not int or not minimum <= value <= maximum:
+        raise PreferenceError("invalid_" + field)
+    return value
+
+
+def _shape(value: Any, keys: set[str]) -> dict:
+    if type(value) is not dict or set(value) != keys:
+        raise PreferenceError("invalid_fields")
+    return value
+
+
+def _schema(value: Any) -> None:
+    if type(value) is not int or value != SCHEMA_VERSION:
+        raise PreferenceError("unsupported_schema")
+
+
+def _operation(value: Any) -> str:
+    if type(value) is not str or _OPERATION_ID.fullmatch(value) is None:
+        raise PreferenceError("invalid_operation_id")
+    return value
+
+
+def _unique_object(pairs: list[tuple[str, Any]]) -> dict:
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise PreferenceError("duplicate_field")
+        result[key] = value
+    return result
+
+
+def _invalid_constant(_value: str) -> None:
+    raise PreferenceError("invalid_json")
+
+
+def decode_packet(payload: bytes) -> dict:
+    """Strict bounded JSON; duplicate keys cannot acquire last-write-wins meaning."""
+    if type(payload) is not bytes or not 0 < len(payload) <= MAX_PACKET_BYTES:
+        raise PreferenceError("invalid_packet_size")
+    try:
+        value = json.loads(payload.decode("utf-8", errors="strict"),
+                           object_pairs_hook=_unique_object,
+                           parse_constant=_invalid_constant)
+    except PreferenceError:
+        raise
+    except (UnicodeError, ValueError, RecursionError):
+        raise PreferenceError("invalid_json") from None
+    if type(value) is not dict:
+        raise PreferenceError("invalid_fields")
+    return value
+
+
+@dataclass(frozen=True)
+class UsagePreference:
+    revision: int = 0
+    level: int = 5
+
+    def __post_init__(self) -> None:
+        _integer(self.revision, 0, MAX_REVISION, "revision")
+        _integer(self.level, 1, 6, "level")
+        if self.revision == 0 and self.level != 5:
+            raise PreferenceError("invalid_initial_policy")
+
+    def to_wire(self) -> dict:
+        return {"schema_version": SCHEMA_VERSION,
+                "revision": self.revision, "level": self.level}
+
+    @property
+    def digest(self) -> str:
+        canonical = json.dumps(self.to_wire(), sort_keys=True,
+                               separators=(",", ":")).encode("ascii")
+        return hashlib.sha256(canonical).hexdigest()
+
+
+def parse_preference(value: Any) -> UsagePreference:
+    doc = _shape(value, {"schema_version", "revision", "level"})
+    _schema(doc["schema_version"])
+    return UsagePreference(doc["revision"], doc["level"])
+
+
+@dataclass(frozen=True)
+class PreferenceUpdate:
+    operation_id: str
+    expected_revision: int
+    level: int
+
+    def __post_init__(self) -> None:
+        _operation(self.operation_id)
+        _integer(self.expected_revision, 0, MAX_REVISION, "expected_revision")
+        _integer(self.level, 1, 6, "level")
+
+
+def parse_update(value: Any) -> PreferenceUpdate:
+    doc = _shape(value, {"schema_version", "operation_id", "expected_revision", "level"})
+    _schema(doc["schema_version"])
+    return PreferenceUpdate(doc["operation_id"], doc["expected_revision"], doc["level"])
+
+
+@dataclass(frozen=True)
+class PreferenceReceipt:
+    operation_id: str
+    expected_revision: int
+    committed: UsagePreference
+
+    def __post_init__(self) -> None:
+        _operation(self.operation_id)
+        _integer(self.expected_revision, 0, MAX_REVISION - 1, "expected_revision")
+        if type(self.committed) is not UsagePreference:
+            raise PreferenceError("invalid_committed_policy")
+        if self.committed.revision != self.expected_revision + 1:
+            raise PreferenceError("invalid_revision_transition")
+
+    def to_wire(self) -> dict:
+        return {"schema_version": SCHEMA_VERSION,
+                "operation_id": self.operation_id,
+                "expected_revision": self.expected_revision,
+                "revision": self.committed.revision,
+                "level": self.committed.level,
+                "preference_digest": self.committed.digest,
+                "applies_from": APPLIES_FROM}
+
+
+def parse_receipt(value: Any) -> PreferenceReceipt:
+    doc = _shape(value, {"schema_version", "operation_id", "expected_revision",
+                        "revision", "level", "preference_digest", "applies_from"})
+    _schema(doc["schema_version"])
+    if doc["applies_from"] != APPLIES_FROM:
+        raise PreferenceError("invalid_application_boundary")
+    committed = UsagePreference(doc["revision"], doc["level"])
+    if type(doc["preference_digest"]) is not str or doc["preference_digest"] != committed.digest:
+        raise PreferenceError("invalid_preference_digest")
+    return PreferenceReceipt(doc["operation_id"], doc["expected_revision"], committed)
+
+
+@dataclass(frozen=True)
+class PreferenceTransition:
+    """A plan, not evidence of a successful write or running-turn application."""
+    current: UsagePreference
+    proposed: UsagePreference
+    receipt: PreferenceReceipt
+    replay: bool
+
+
+def plan_update(current: UsagePreference, update: PreferenceUpdate,
+                prior_receipt: PreferenceReceipt | None = None) -> PreferenceTransition:
+    """Called inside a future host transaction after profile/authentication checks.
+
+    A replay returns the old immutable receipt but retains today's snapshot.
+    Old receipts must never roll the profile back after another valid update.
+    No in-flight turn or ledger is supplied or mutated by this function.
+    """
+    if type(current) is not UsagePreference or type(update) is not PreferenceUpdate:
+        raise PreferenceError("invalid_typed_transaction")
+    if prior_receipt is not None:
+        if type(prior_receipt) is not PreferenceReceipt:
+            raise PreferenceError("invalid_prior_receipt")
+        if (prior_receipt.operation_id != update.operation_id
+                or prior_receipt.expected_revision != update.expected_revision
+                or prior_receipt.committed.level != update.level):
+            raise PreferenceError("operation_conflict")
+        if (current.revision < prior_receipt.committed.revision
+                or (current.revision == prior_receipt.committed.revision
+                    and current != prior_receipt.committed)):
+            raise PreferenceError("receipt_state_conflict")
+        return PreferenceTransition(current, current, prior_receipt, True)
+    if update.expected_revision != current.revision:
+        raise PreferenceError("revision_conflict")
+    if current.revision == MAX_REVISION:
+        raise PreferenceError("revision_exhausted")
+    proposed = UsagePreference(current.revision + 1, update.level)
+    receipt = PreferenceReceipt(update.operation_id, current.revision, proposed)
+    return PreferenceTransition(current, proposed, receipt, False)
+
+
+def matches_readback(receipt: PreferenceReceipt, snapshot: UsagePreference) -> bool:
+    """Exact saved-state acknowledgement, never 'all running turns effective'."""
+    return (type(receipt) is PreferenceReceipt and type(snapshot) is UsagePreference
+            and receipt.committed == snapshot)
