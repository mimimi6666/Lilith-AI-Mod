+from agent.usage_budget import BudgetError, TurnBudgetLedger, bind_turn_budget
+from agent.usage_budget_native_dispatch import native_chat_dispatch_sync, native_dispatch_sync
+from agent.usage_budget_official_routes import official_wire_format
+from test_lilith_usage_budget_native_dispatch import budget, extract
+
+
+class ActualSdkTests(unittest.TestCase):
+    def setUp(self):
+        # This fixture tests SDK serialization, not native heuristic quality.
+        metadata = ModuleType("agent.model_metadata")
+        metadata.estimate_tokens_rough = lambda text: 100
+        self.modules = patch.dict(sys.modules, {"agent.model_metadata": metadata})
+        self.modules.start()
+        self.addCleanup(self.modules.stop)
+
+    def openai_client(self, sent, base="https://api.openai.com/v1", streaming=False):
+        def handle(request):
+            sent.append(json.loads(request.content))
+            response = {"id": "fixture", "object": "chat.completion", "created": 0,
+                        "model": "synthetic-model", "choices": [],
+                        "usage": {"prompt_tokens": 100, "completion_tokens": 80, "total_tokens": 180}}
+            if streaming:
+                response["object"] = "chat.completion.chunk"
+                return httpx.Response(200, content=("data: " + json.dumps(response) + "\n\ndata: [DONE]\n\n").encode(),
+                                      headers={"Content-Type": "text/event-stream"})
+            return httpx.Response(200, json=response)
+        transport = httpx.Client(transport=httpx.MockTransport(handle), trust_env=False)
+        client = openai.OpenAI(api_key="synthetic-offline-key", base_url=base, max_retries=0, http_client=transport)
+        self.addCleanup(client.close)
+        return client
+
+    def test_actual_openai_default5_and_unbounded6_serialized_wire(self):
+        sent = []
+        client = self.openai_client(sent)
+        request = {"model": "synthetic-model", "messages": [{"role": "user", "content": "fixture"}],
+                   "max_completion_tokens": 123}
+        for level in (5, 6, 5):
+            ledger = budget(level)
+            with bind_turn_budget(ledger):
+                response = native_chat_dispatch_sync(client, request, lambda value: client.chat.completions.create(**value))
+            self.assertEqual(180, ledger.snapshot().total_charged_tokens)
+            self.assertEqual(80, response.usage.completion_tokens)
+        self.assertEqual([123, None, 123], [r.get("max_completion_tokens") for r in sent])
+
+    def test_actual_openai_estimated_binding_final_cap_and_real_stream_usage(self):
+        sent = []
+        client = self.openai_client(sent, streaming=True)
+        ledger = TurnBudgetLedger("sdk-estimated", replace(budget().policy, strict=False))
+        with bind_turn_budget(ledger):
+            result = native_chat_dispatch_sync(client, {"model": "synthetic-model", "messages": [], "stream": True,
+                "stream_options": {"include_usage": True}}, lambda value: client.chat.completions.create(**value))
+            list(result)
+        self.assertEqual(1000, sent[0]["max_completion_tokens"])
+        self.assertEqual(180, ledger.snapshot().total_charged_tokens)
+        self.assertFalse(ledger.snapshot().attempts[0].reservation.input_is_exact)
+
+    def test_real_sdk_custom_endpoint_is_not_official_certified(self):
+        sent = []
+        client = self.openai_client(sent, "https://proxy.invalid/v1")
+        self.assertIsNone(official_wire_format(client))
+        with bind_turn_budget(budget()), self.assertRaises(BudgetError):
+            native_chat_dispatch_sync(client, {"model": "synthetic-model", "messages": []},
+                                      lambda value: client.chat.completions.create(**value))
