+"""Actual handler registration with fake transport/store; no native boot or IO."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget_preferences import PreferenceError, UsagePreference, plan_update
+from tui_gateway import methods_usage_budget as handlers
+
+
+class HandlerTests(unittest.TestCase):
+    def setUp(self):
+        self.calls = []
+        self.current = UsagePreference()
+        self.receipt = None
+        self.stdio = object()
+        self.profile = object()  # Not an actual player/test directory.
+        self.server = SimpleNamespace(
+            _hermes_home=self.profile, _stdio_transport=self.stdio, _methods={},
+            current_transport=lambda: None,
+            _native_authority_quarantine_rpc_error=lambda rid: None,
+            _ok=lambda rid, value: {"jsonrpc": "2.0", "id": rid, "result": value},
+        )
+        self.patches = [patch.object(handlers, "_strict_host_required", return_value=True),
+                        patch.object(handlers, "get_preference", side_effect=self.get),
+                        patch.object(handlers, "set_preference", side_effect=self.set)]
+        for item in self.patches:
+            item.start()
+            self.addCleanup(item.stop)
+        handlers.register(self.server)
+
+    def get(self, root):
+        self.assertIs(root, self.profile)
+        self.calls.append("get")
+        return self.current
+
+    def set(self, root, update):
+        self.assertIs(root, self.profile)
+        self.calls.append("set")
+        decision = plan_update(self.current, update, self.receipt)
+        self.current, self.receipt = decision.proposed, decision.receipt
+        return SimpleNamespace(to_wire=lambda: {
+            "preference": self.current.to_wire(), "receipt": self.receipt.to_wire(),
+            "replay": decision.replay})
+
+    def call(self, method, params=None):
+        return self.server._methods[method]("request-1", {} if params is None else params)["result"]
+
+    @staticmethod
+    def update(**changes):
+        value = dict(schema_version=1, operation_id="save-1", expected_revision=0, level=1)
+        value.update(changes)
+        return value
+
+    def test_actual_registration_closed_methods_and_exact_packets(self):
+        self.assertEqual(set(self.server._methods), {"budget.get", "budget.set"})
+        self.assertEqual(self.call("budget.get"), dict(schema_version=1, revision=0, level=5))
+        result = self.call("budget.set", self.update())
+        self.assertEqual(set(result), {"preference", "receipt", "replay"})
+        self.assertEqual(result["preference"], dict(schema_version=1, revision=1, level=1))
+        self.assertFalse(result["replay"])
+        self.assertEqual(result["receipt"]["applies_from"], "next_origin_turn")
+
+    def test_replay_does_not_recommit(self):
+        self.call("budget.set", self.update())
+        self.assertTrue(self.call("budget.set", self.update())["replay"])
+        self.assertEqual(self.current.revision, 1)
+
+    def test_path_session_permission_and_numeric_knobs_rejected_before_store(self):
+        for field in ("profile_root", "session_id", "permission", "max_tokens", "applies_from"):
+            self.assertEqual(self.call("budget.set", self.update(**{field: "injected"}))["code"],
+                             "budget.invalid_request")
+            self.assertEqual(self.call("budget.get", {field: "injected"})["code"], "budget.invalid_request")
+        self.assertEqual(self.calls, [])
+
+    def test_wrong_types_missing_and_extra_fields_never_store(self):
+        for value in ([], "level=1", {"level": 1}, self.update(level=True), self.update(level=0),
+                      self.update(level=7), self.update(expected_revision=0.0),
+                      self.update(operation_id="../injected"), self.update(schema_version=2)):
+            self.assertEqual(self.call("budget.set", value)["code"], "budget.invalid_request")
+        self.assertEqual(self.calls, [])
+
+    def test_host_and_non_stdio_transport_rejected(self):
+        for transport in (object(), "stdio"):
+            self.server.current_transport = lambda: transport
+            self.assertEqual(self.call("budget.set", self.update())["code"], "budget.host_required")
+        self.server.current_transport = lambda: self.stdio
+        with patch.object(handlers, "_strict_host_required", return_value=False):
+            self.assertEqual(self.call("budget.get")["code"], "budget.host_required")
+        self.assertEqual(self.calls, [])
+
+    def test_frozen_host_profile_does_not_follow_session_override(self):
+        self.server._hermes_home = object()
+        self.server._sessions = {"active": {"profile_home": "untrusted", "running": True}}
+        self.call("budget.set", self.update())
+        self.assertEqual(self.current.level, 1)
+        self.assertTrue(self.server._sessions["active"]["running"])
+
+    def test_native_quarantine_stays_fail_closed_without_store(self):
+        error = {"error": {"code": 5035}}
+        self.server._native_authority_quarantine_rpc_error = lambda rid: error
+        self.assertIs(self.server._methods["budget.get"]("r", {}), error)
+        self.assertEqual(self.calls, [])
+
+    def test_conflict_and_uncertain_failures_are_content_free(self):
+        for error, code in [(PreferenceError("revision_conflict"), "budget.revision_conflict"),
+                            (PreferenceError("store_unavailable"), "budget.store_unavailable"),
+                            (OSError("private path and key"), "budget.operation_failed")]:
+            with patch.object(handlers, "set_preference", side_effect=error):
+                self.assertEqual(self.call("budget.set", self.update()), {"schema_version": 1, "code": code})
+
+    def test_candidate_server_registers_module_without_booting_native(self):
+        source = (Path(__file__).parents[1] / "tui_gateway" / "server.py").read_text(encoding="utf-8")
+        tree = ast.parse(source)
+        self.assertTrue(any(isinstance(node, ast.ImportFrom) and any(
+            item.name == "methods_usage_budget" for item in node.names) for node in tree.body))
+        self.assertTrue(any(isinstance(node, ast.For) and isinstance(node.iter, ast.Tuple) and any(
+            isinstance(item, ast.Name) and item.id == "_methods_usage_budget" for item in node.iter.elts)
+            for node in tree.body))
+
+
+if __name__ == "__main__":
+    unittest.main()
