+
+class HostPolicyTests(unittest.TestCase):
+    def snapshot(self, **overrides):
+        fields = dict(
+            route=WireRoute("synthetic-transport", "synthetic-model", "synthetic-adapter"),
+            normal=NormalBudget(max_iterations=32),
+            reference=EconomyReferences(32000, 8000, 320000, 40),
+            limits=VerifiedModelLimits(),
+        )
+        fields.update(overrides)
+        return HostPolicySnapshot(**fields)
+
+    def test_normal_unset_is_not_replaced_by_economy_references(self):
+        snapshot = self.snapshot()
+        policy = snapshot(UsagePreference(level=5, revision=8))
+        self.assertIsNone(policy.input_tokens)
+        self.assertIsNone(policy.output_tokens)
+        self.assertEqual(32, policy.max_iterations)
+        self.assertIsNone(policy.turn_call_limit)
+        self.assertIsNone(policy.turn_token_limit)
+        self.assertEqual(snapshot.normal, policy.normal)
+
+    def test_custom_baseline_preserved_after_multiple_levels(self):
+        normal = NormalBudget(input_tokens=16000, output_tokens=4000,
+                              thinking_tokens=512, max_iterations=20)
+        snapshot = self.snapshot(normal=normal)
+        before = dataclasses.asdict(snapshot)
+        for level in (1, 2, 3, 4, 6, 5):
+            policy = snapshot(UsagePreference(level=level, revision=level))
+            self.assertEqual(normal, policy.normal)
+        self.assertEqual(normal.input_tokens, policy.input_tokens)
+        self.assertEqual(normal.output_tokens, policy.output_tokens)
+        self.assertEqual(before, dataclasses.asdict(snapshot))
+
+    def test_estimated_is_explicit_not_unresolved_or_exact(self):
+        snapshot = self.snapshot()
+        preference = UsagePreference(level=1, revision=9)
+        policy = snapshot(preference)
+        self.assertFalse(policy.strict)
+        self.assertEqual((), policy.unresolved)
+        self.assertEqual("estimated", snapshot.describe(preference)["input_count_mode"])
+
+    def test_exact_mode_does_not_certify_dispatch_capability(self):
+        snapshot = self.snapshot(input_count_is_exact=True)
+        self.assertTrue(snapshot(UsagePreference(level=2, revision=9)).strict)
+        self.assertEqual("exact", snapshot.describe(UsagePreference(level=2, revision=9))["input_count_mode"])
+        self.assertEqual("", snapshot.limits.evidence_id)
+
+    def test_calls_are_explicit_reference_not_logical_iterations(self):
+        snapshot = self.snapshot(normal=NormalBudget(max_iterations=800))
+        policy = snapshot(UsagePreference(level=1, revision=1))
+        self.assertEqual(5, policy.turn_call_limit)
+        self.assertEqual(100, policy.max_iterations)
+
+    def test_economy_capacities_are_monotonic_and_keep_floor(self):
+        snapshot = self.snapshot(mandatory_input_tokens=2000)
+        policies = [snapshot(UsagePreference(level=level, revision=1)) for level in range(1, 5)]
+        for key in ("input_tokens", "output_tokens", "turn_token_limit", "turn_call_limit"):
+            values = [getattr(policy, key) for policy in policies]
