+"""Synthetic request projection and extracted actual conversation-loop seams.
+
+The fixture counter assigns ten units per message; it is not a real tokenizer
+or evidence that any real provider has an exact local counter.
+"""
+from __future__ import annotations
+
+import ast
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+from agent.usage_budget import (
+    BudgetError, BudgetExceeded, NormalBudget, VerifiedModelLimits,
+    TurnBudgetLedger, bind_turn_budget, resolve_policy,
+)
+from agent.usage_budget_dispatch import InputCount
+from agent.usage_budget_context import (
+    EFFICIENCY_GUIDANCE, HistorySelection, capture_budget_history,
+    capture_completed_history, prepare_budget_context,
+    register_context_counter, select_working_context, with_efficiency_guidance,
+)
+from agent.iteration_budget import (
+    ContinuationProgress, IterationBudget, continuation_transport_ok, unlimited_iterations,
+)
+
+
+def policy(cap=30, *, level=1, strict=True):
+    numerator, denominator = {1: (1, 8), 2: (1, 4), 3: (1, 2), 4: (3, 4)}.get(level, (1, 1))
+    return resolve_policy(level, NormalBudget(input_tokens=(cap * denominator + numerator - 1) // numerator,
+        output_tokens=64, turn_reference_tokens=10000, turn_reference_calls=64),
+        VerifiedModelLimits(context_tokens=100000, output_tokens=1000,
+                            max_iterations=100, evidence_id="fixture:context"), strict=strict)
+
+
+def count_rows(messages, tools):
+    return InputCount(10 * len(messages), True)
+
+
+def exchange(ask="old", answer="done"):
+    return [{"role": "user", "content": ask}, {"role": "assistant", "content": answer}]
+
+
+def tool_exchange():
+    return [
+        {"role": "user", "content": "old tool request"},
+        {"role": "assistant", "content": None, "tool_calls": [
+            {"id": "call1", "type": "function", "function": {"name": "fixture", "arguments": '{"s":"你好"}'}}
+        ]},
+        {"role": "tool", "tool_call_id": "call1", "content": '{"ok":true}'},
+        {"role": "assistant", "content": "verified"},
+    ]
+
+
+class Agent:
+    def __init__(self):
+        self.model = "fixture-model"
+        self.provider = "fixture-provider"
+        self.api_mode = "chat_completions"
+        self.base_url = "https://example.invalid"
+        self.client = SimpleNamespace(base_url=self.base_url, _http=object())
+        self.tools = [{"function": {"name": "fixture", "parameters": {"type": "object"}}}]
+        self.ephemeral_system_prompt = "privacy and role context"
+        self.prefill_messages = []
+
+
+class ContextSelectionTests(unittest.TestCase):
+    def source(self):
+        return exchange("oldest", "oldest answer") + exchange("newer", "newer answer") + [
+            {"role": "user", "content": "current ask"}]
+
+    def select(self, source=None, *, cap=50, counter=count_rows, level=1, strict=True, prefix=None):
+        source = self.source() if source is None else source
+        prefix = [{"role": "system", "content": "required identity/privacy/memory"}] if prefix is None else prefix
+        projected = deepcopy(prefix + source)
+        history = capture_completed_history(source, len(source) - 1)
+        return select_working_context(projected, source, history, history_offset=len(prefix),
+                                      policy=policy(cap, level=level, strict=strict), counter=counter)
+
+    def test_oldest_completed_units_removed_until_fit(self):
+        result = self.select(cap=40)
+        self.assertEqual("trimmed", result.status)
+        self.assertEqual((1, 2, 40, True), (result.removed_units, result.removed_messages, result.input_tokens, result.exact))
+        self.assertEqual(["required identity/privacy/memory", "newer", "newer answer", "current ask"],
+                         [row["content"] for row in result.messages])
+
+    def test_source_and_nested_tool_json_remain_byte_equivalent(self):
+        source = tool_exchange() + exchange("recent", "recent reply") + [{"role": "user", "content": "new"}]
+        before = deepcopy(source)
+        result = self.select(source, cap=40)
+        self.assertEqual(before, source)
+        self.assertEqual(4, result.removed_messages)
+        self.assertEqual('{"s":"你好"}', source[1]["tool_calls"][0]["function"]["arguments"])
+
+    def test_parallel_tool_results_are_removed_together(self):
+        source = tool_exchange()
+        source[1]["finish_reason"] = "tool_calls"
+        source[1]["tool_calls"].append({"id": "call2", "function": {"name": "other", "arguments": "{}"}})
+        source.insert(2, {"role": "tool", "tool_call_id": "call2", "content": "ok"})
+        source.extend(exchange("recent", "recent reply"))
+        source.append({"role": "user", "content": "new"})
+        result = self.select(source, cap=40)
+        self.assertEqual(5, result.removed_messages)
+        self.assertEqual(["system", "user", "assistant", "user"], [row["role"] for row in result.messages])
+
+    def test_incomplete_tool_pair_is_mandatory_not_orphaned(self):
+        source = tool_exchange()
+        source.pop(2)
+        source.append({"role": "user", "content": "new"})
+        with self.assertRaisesRegex(BudgetExceeded, "mandatory_context_exceeds_allowance"):
+            self.select(source, cap=20)
+
+    def test_tool_result_without_call_is_never_disposable(self):
+        source = exchange()
+        source.insert(1, {"role": "tool", "tool_call_id": "missing", "content": "outcome"})
+        source.append({"role": "user", "content": "new"})
+        with self.assertRaises(BudgetExceeded):
+            self.select(source, cap=20)
+
+    def test_malformed_tool_json_stays_whole_and_refuses_overflow(self):
+        source = tool_exchange()
+        source[1]["tool_calls"][0]["function"]["arguments"] = '{"broken":'
+        source.append({"role": "user", "content": "new"})
+        before = deepcopy(source)
+        with self.assertRaises(BudgetExceeded):
+            self.select(source, cap=20)
+        self.assertEqual(before, source)
+
+    def test_legacy_function_call_is_protected(self):
+        source = exchange()
+        source[1]["function_call"] = {"name": "legacy", "arguments": "{}"}
+        source.append({"role": "user", "content": "new"})
+        with self.assertRaises(BudgetExceeded):
+            self.select(source, cap=20)
+
+    def test_system_and_developer_within_history_are_protected(self):
+        for role in ("system", "developer"):
+            with self.subTest(role=role):
+                source = exchange()
+                source.insert(1, {"role": role, "content": "necessary policy"})
+                source.append({"role": "user", "content": "new"})
+                with self.assertRaises(BudgetExceeded):
+                    self.select(source, cap=20)
+
+    def test_current_images_multilingual_input_and_memory_remain_intact(self):
+        for text in ("這張圖裡有什麼？", "この画像は？", "What is in this image?"):
+            with self.subTest(text=text):
+                source = exchange() + exchange("recent", "recent reply") + [{"role": "user", "content": [
+                    {"type": "text", "text": text + "\n[required recall] 記憶"},
+                    {"type": "image_url", "image_url": {"url": "data:image/png;base64,fixture"}},
