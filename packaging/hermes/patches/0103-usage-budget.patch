+class FakeTransport:
+    max_retries = 0
+
+    def __init__(self, model="fixture-model"):
+        self.calls = []
+        self.response = {"usage": {"input": 100, "output": 50}}
+        self.error = None
+        self.model = model
+        register_native_dispatch_binding(self, NativeDispatchBinding(
+            WireCapability("chat_max_completion_tokens", evidence_id="fixture-only",
+                           output_cap_verified=True, all_output_counted=True,
+                           sdk_max_retries=0, final_wire_verified=True,
+                           route=WireRoute("fixture-transport", model, "fixture-adapter")),
+            lambda request: InputCount(100, exact=False),
+            lambda response: UsageCount(response.get("usage", {}).get("input"),
+                                        response.get("usage", {}).get("output")),
+        ))
+
+    def send(self, request):
+        self.calls.append(copy.deepcopy(request))
+        if self.error:
+            raise self.error
+        return self.response
+
+    def request(self, handle, *, category="main"):
+        return native_dispatch_sync(
+            self, {"model": self.model, "messages": [{"role": "user", "content": "fixture"}],
+                   "max_completion_tokens": 2048}, self.send,
+            wire_format="chat_max_completion_tokens", category=category, expected_handle=handle,
+        )
