+++ b/agent/usage_budget_native_dispatch.py
@@ -0,0 +1,894 @@
+"""Native candidate dispatch hooks with explicit host-owned route evidence.
+
+No route is certified by a provider name. The registry is populated only by a
+reviewed adapter binding (including exact official SDK/endpoint bindings), never
+configuration or model text. Unknown economic routes fail before transport;
+normal mode preserves requests and observes nullable provider usage separately.
+Stream usage must be cumulative final totals, not token deltas. Closing early
+retains the full reservation rather than reporting a free or completed request.
+"""
+from __future__ import annotations
+
+from collections.abc import Callable
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+import hashlib
+from threading import RLock
+from typing import Any
+from uuid import uuid4
+import sys
+from weakref import ref
+
+from agent.usage_budget import BudgetError, current_turn_budget
+from agent.usage_budget_dispatch import (
+    InputCount, UsageCount, WireCapability, WireRoute, prepare_wire_request, prepare_unbounded_wire_request,
+    prepare_uncontrolled_estimated_request,
+)
+
+
+@dataclass(frozen=True)
+class NativeDispatchBinding:
+    capability: WireCapability
+    count_input: Callable[[dict[str, Any]], InputCount]
+    read_usage: Callable[[Any], UsageCount]
+    output_control: str = "verified"
+
+
+_BINDINGS = {}
+_SHIMS = {}
+_BINDINGS_LOCK = RLock()
+_CATEGORY = ContextVar("lilith_usage_dispatch_category", default="main")
+_GUARD_RECEIPTS = ContextVar("lilith_usage_guard_receipts", default=None)
+
+
+def _identity_entries(registry, client, *, create=False):
+    identity = id(client)
+    record = registry.get(identity)
+    if record is not None and record[0]() is client:
+        return record[1]
+    if not create:
+        return {}
+    def retire(weak):
+        with _BINDINGS_LOCK:
+            current = registry.get(identity)
+            if current is not None and current[0] is weak:
+                registry.pop(identity, None)
+    try:
+        weak = ref(client, retire)
+    except TypeError:
+        raise BudgetError("native_client_identity_unsupported") from None
+    values = {}
+    registry[identity] = (weak, values)
+    return values
+
+
+def _client_fingerprint(client):
+    # Bind reviewed evidence to the current endpoint and underlying transport,
+    # not merely a reusable SDK object. Only a digest is retained; no URL/key is
+    # exposed through diagnostics, exceptions or a public capability field.
+    endpoint = str(getattr(client, "base_url", ""))
+    if not endpoint:
+        endpoint = str(getattr(getattr(client, "meta", None), "endpoint_url", ""))
+    from agent.usage_budget_official_routes import reviewed_http_transport_state
+    actual_endpoint = getattr(client, "_endpoint", None)
+    retries = getattr(getattr(getattr(client, "meta", None), "config", None), "retries", None)
+    retry_state = tuple(sorted((str(key), repr(value)) for key, value in retries.items())) if isinstance(retries, dict) else None
+    return (hashlib.sha256(endpoint.encode("utf-8")).digest(),
+            id(getattr(client, "_http", None)), id(getattr(client, "_client", None)),
+            id(actual_endpoint), reviewed_http_transport_state(client),
+            hashlib.sha256(str(getattr(actual_endpoint, "host", "")).encode("utf-8")).digest(),
+            id(getattr(actual_endpoint, "http_session", None)), retry_state)
+
+
+def register_native_dispatch_binding(client: Any, binding: NativeDispatchBinding) -> None:
+    """Trusted adapter seam; mutable transport/model identity is rechecked."""
+    if (type(binding) is not NativeDispatchBinding or type(binding.capability) is not WireCapability
+            or type(binding.capability.route) is not WireRoute):
+        raise BudgetError("invalid_native_dispatch_binding")
+    if not callable(binding.count_input) or not callable(binding.read_usage):
+        raise BudgetError("invalid_native_dispatch_binding")
+    if type(binding.output_control) is not str or binding.output_control not in {"verified", "requested", "unavailable"}:
+        raise BudgetError("invalid_output_control")
+    route = binding.capability.route
+    key = (route.model_id, binding.capability.wire_format)
+    with _BINDINGS_LOCK:
+        entries = _identity_entries(_BINDINGS, client, create=True)
+        entries[key] = (_client_fingerprint(client), binding)
+
+
+def _active_ledger(expected_handle=None):
+    ledger = current_turn_budget()
+    from agent.usage_budget_runtime import current_accepted_origin
+    accepted = current_accepted_origin()
+    if accepted is not None and (ledger is None or accepted._state.handle is None
+                                 or accepted._state.handle.ledger is not ledger):
+        raise BudgetError("origin_context_missing")
+    if expected_handle is not None and (ledger is None or expected_handle.ledger is not ledger):
+        raise BudgetError("origin_budget_scope_missing")
+    if ledger is None:
+        # Standalone title/compression/background calls must not become a paid
+        # escape hatch merely because a caller forgot to carry its origin.
+        # This is the same host/profile check as the conversation entry; import
+        # failures are not converted into an implicit normal-mode permission.
+        from agent.usage_budget_entrypoints import require_native_origin_for_conversation
+        require_native_origin_for_conversation()
+    if ledger is None or not ledger.policy.enforce_economy_limits:
+        return None
+    return ledger
+
+
+def validate_native_origin(expected_handle=None):
+    _active_ledger(expected_handle)
