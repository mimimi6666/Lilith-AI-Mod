diff --git a/agent/usage_budget.py b/agent/usage_budget.py
new file mode 100644
--- /dev/null
+++ b/agent/usage_budget.py
@@ -0,0 +1,666 @@
+"""Inactive candidate: immutable usage policies and one-origin-turn accounting.
+
+This module does not read configuration, discover tools, call a model, modify a
+prompt, or own permissions. Production admission is NOT established by importing
+it: every actual outbound attempt, including SDK retries and descendant work,
+must pass the same ledger before a product may advertise an aggregate limit.
+Tokens are not money. Provider usage is normalized input/output totals; cached
+input and reasoning that are subsets MUST NOT be supplied as additional tokens.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from threading import RLock
+from typing import Iterator
+import re
+
+
+class BudgetError(ValueError):
+    """Content-free, stable failure code suitable for an existing typed surface."""
+
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
+class BudgetExceeded(BudgetError):
+    pass
+
+
+def _integer(value: object, name: str, *, minimum: int = 0) -> int:
+    # bool is an int in Python, but is never a valid capacity or usage count.
+    if type(value) is not int or value < minimum:
+        raise BudgetError("invalid_" + name)
+    return value
+
+
+def _optional_positive(value: int | None, name: str) -> None:
+    if value is not None:
+        _integer(value, name, minimum=1)
+
+
+def _identifier(value: str, name: str) -> str:
+    if not isinstance(value, str) or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", value) is None:
+        raise BudgetError("invalid_" + name)
+    return value
+
+
+@dataclass(frozen=True)
+class NormalBudget:
+    """Captured normal policy, never reconstructed from a prior economy policy.
+
+    ``max_iterations`` is the existing native logical-iteration setting, NOT a
+    count of dispatched model attempts. Aggregate reference values must be explicitly
+    reviewed/configured by the host; none is derived from logical iterations.
+    They are reference capacities for modes 1--4, not new mode-5 restrictions.
+    """
+
+    input_tokens: int | None = None
+    output_tokens: int | None = None
+    thinking_tokens: int | None = None
+    max_iterations: int | None = None
+    turn_reference_tokens: int | None = None
+    turn_reference_calls: int | None = None
+
+    def __post_init__(self) -> None:
+        for name in self.__dataclass_fields__:
+            _optional_positive(getattr(self, name), name)
+
+
+@dataclass(frozen=True)
+class VerifiedModelLimits:
+    """Host-attested capacities for this exact provider/model/runtime binding.
+
+    The evidence ID is an opaque reference, never proof supplied by model prose.
+    Unknown capacity remains None. This class does not verify a remote model.
+    ``thinking_tokens`` must fit inside output_tokens when they share output.
+    """
+
+    context_tokens: int | None = None
+    output_tokens: int | None = None
+    thinking_tokens: int | None = None
+    max_iterations: int | None = None
+    shared_context: bool = True
+    evidence_id: str = ""
+
+    def __post_init__(self) -> None:
+        for name in ("context_tokens", "output_tokens", "thinking_tokens", "max_iterations"):
+            _optional_positive(getattr(self, name), name)
+        if type(self.shared_context) is not bool:
+            raise BudgetError("invalid_shared_context")
+        if any(getattr(self, name) is not None for name in (
+            "context_tokens", "output_tokens", "thinking_tokens", "max_iterations"
+        )):
+            _identifier(self.evidence_id, "capacity_evidence")
+        elif self.evidence_id:
+            _identifier(self.evidence_id, "capacity_evidence")
+
+
+# Guidance is shared by every mode. These are execution-efficiency principles,
+# NOT another tool catalog, a planner, a shortcut executor, or permission grants.
+ROUTE_EFFICIENCY_RULES = (
+    "Prefer an already known, ready, target-bound route with sufficient outcome evidence.",
+    "Compare the whole workflow, including model turns, discovery, tool results and retries.",
+    "Reuse a successful procedure only while its tool, version, target and readiness still apply.",
+    "Do not repeat a fresh reusable read; do not deduplicate intentional side-effect actions.",
+    "Stop when the requested outcome is sufficiently verified; stop or change route on no progress.",
+    "Explore only when known routes do not apply, within the remaining turn allowance.",
+    "Never relax tool approval, target identity, cancellation or existing safety boundaries.",
+)
+
+
+@dataclass(frozen=True)
+class UsagePolicy:
+    level: int
+    version: int
+    normal: NormalBudget
+    limits: VerifiedModelLimits
+    input_tokens: int | None
+    output_tokens: int | None
+    thinking_tokens: int | None
+    max_iterations: int | None
+    turn_token_limit: int | None
+    turn_call_limit: int | None
+    strict: bool
+    mandatory_input_tokens: int
+    unresolved: tuple[str, ...] = ()
+    guidance: tuple[str, ...] = ROUTE_EFFICIENCY_RULES
+
+    def __post_init__(self) -> None:
+        _integer(self.level, "level", minimum=1)
+        if self.level > 6:
+            raise BudgetError("invalid_level")
+        _integer(self.version, "version")
+        _integer(self.mandatory_input_tokens, "mandatory_input_tokens")
+        if not isinstance(self.normal, NormalBudget) or not isinstance(self.limits, VerifiedModelLimits):
+            raise BudgetError("invalid_policy_source")
+        for name in ("input_tokens", "output_tokens", "thinking_tokens", "max_iterations",
+                     "turn_token_limit", "turn_call_limit"):
+            _optional_positive(getattr(self, name), name)
+        if type(self.strict) is not bool:
+            raise BudgetError("invalid_strict")
+        if self.level >= 5 and (self.strict or self.turn_token_limit is not None or self.turn_call_limit is not None):
+            raise BudgetError("neutral_mode_economy_limit_forbidden")
+        if self.level == 5 and any(getattr(self, name) != getattr(self.normal, name) for name in (
+            "input_tokens", "output_tokens", "thinking_tokens", "max_iterations"
+        )):
+            raise BudgetError("normal_mode_baseline_changed")
+        if self.level == 6 and any(getattr(self, name) is not None for name in (
+                "input_tokens", "output_tokens", "thinking_tokens", "max_iterations")):
+            raise BudgetError("unbounded_mode_numeric_limit_forbidden")
+        if not isinstance(self.unresolved, tuple) or not all(isinstance(v, str) for v in self.unresolved):
+            raise BudgetError("invalid_unresolved")
+        if self.guidance != ROUTE_EFFICIENCY_RULES:
+            raise BudgetError("invalid_efficiency_guidance")
+
+    @property
+    def enforce_economy_limits(self) -> bool:
+        return 1 <= self.level <= 4
+
+
+_RATIOS = ((1, 8), (1, 4), (1, 2), (3, 4))
+
+
+def _scaled(value: int | None, numerator: int, denominator: int) -> int | None:
+    if value is None:
+        return None
+    return max(1, value * numerator // denominator)
+
+
+def resolve_policy(
+    level: int,
+    normal: NormalBudget,
+    limits: VerifiedModelLimits,
+    *,
+    mandatory_input_tokens: int = 0,
+    input_allocation_reserve_tokens: int = 0,
+    version: int = 0,
+    strict: bool = True,
+) -> UsagePolicy:
+    """Resolve a frozen candidate policy without touching original messages.
+
+    Economy ratios reduce *variable* input above the host's mandatory floor or
+    explicit engineering allocation reserve, whichever is larger. The reserve
+    is NOT measured necessary content, a tokenizer result or model capacity.
+    It is clamped AFTER baseline/verified-capacity bounds and buys no free tokens.
+    They are engineering starting points, not claimed cost-saving percentages.
+    An actual request still must fit: the ledger never truncates current input,
+    drops protected memory, raises the selected level, or adds a summary call.
+    Level 5 preserves captured native policy, including unset values. Level 6
+    removes human usage ceilings, represented as None rather than fake infinity.
+    API-required parameters and native cancellation remain adapter-owned.
+    """
+    _integer(level, "level", minimum=1)
+    if level > 6:
+        raise BudgetError("invalid_level")
+    _integer(version, "version")
+    _integer(mandatory_input_tokens, "mandatory_input_tokens")
+    _integer(input_allocation_reserve_tokens, "input_allocation_reserve_tokens")
+    if type(strict) is not bool:
+        raise BudgetError("invalid_strict")
+    if not isinstance(normal, NormalBudget) or not isinstance(limits, VerifiedModelLimits):
+        raise BudgetError("invalid_policy_source")
+
+    input_tokens, output_tokens = normal.input_tokens, normal.output_tokens
+    thinking_tokens, max_iterations = normal.thinking_tokens, normal.max_iterations
+    turn_tokens = turn_calls = None
+    unresolved: list[str] = []
+
+    if level <= 4:
+        numerator, denominator = _RATIOS[level - 1]
+        # Project the *baseline* onto verified joint capacities before scaling.
+        # Clamping each already-scaled input against growing output would make
+        # higher economy levels sometimes allow LESS input than lower levels.
+        if limits.output_tokens is not None and output_tokens is not None:
+            output_tokens = min(output_tokens, limits.output_tokens)
+        if limits.context_tokens is not None and input_tokens is not None:
+            available_input = limits.context_tokens
+            if limits.shared_context:
+                if output_tokens is None:
+                    unresolved.append("shared_context_output_unknown")
+                else:
+                    max_output = limits.context_tokens - max(1, mandatory_input_tokens)
+                    if max_output < 1:
+                        raise BudgetExceeded("mandatory_input_exceeds_model_capacity")
+                    output_tokens = min(output_tokens, max_output)
+                    available_input -= output_tokens
+            if available_input < mandatory_input_tokens or available_input < 1:
+                raise BudgetExceeded("mandatory_input_exceeds_model_capacity")
+            input_tokens = min(input_tokens, available_input)
+        if input_tokens is not None:
+            if mandatory_input_tokens > input_tokens:
+                raise BudgetExceeded("mandatory_input_exceeds_normal_capacity")
+            allocation_floor = max(mandatory_input_tokens,
+                                   min(input_allocation_reserve_tokens, input_tokens))
+            variable = (input_tokens - allocation_floor) * numerator // denominator
+            input_tokens = max(1, allocation_floor + variable)
+        output_tokens = _scaled(output_tokens, numerator, denominator)
+        thinking_tokens = _scaled(thinking_tokens, numerator, denominator)
+        # Existing logical iterations and shared actual attempts stay separate.
+        max_iterations = _scaled(max_iterations, numerator, denominator)
+        turn_tokens = _scaled(normal.turn_reference_tokens, numerator, denominator)
+        turn_calls = _scaled(normal.turn_reference_calls, numerator, denominator)
+        for name, value in (
+            ("normal_input_capacity_unknown", input_tokens),
+            ("normal_output_capacity_unknown", output_tokens),
+            ("turn_token_reference_unknown", turn_tokens),
+            ("turn_call_reference_unknown", turn_calls),
+        ):
+            if value is None:
+                unresolved.append(name)
+        if thinking_tokens is not None and output_tokens is not None:
+            thinking_tokens = min(thinking_tokens, output_tokens)
+        if limits.thinking_tokens is not None and thinking_tokens is not None:
+            thinking_tokens = min(thinking_tokens, limits.thinking_tokens)
+        if limits.max_iterations is not None and max_iterations is not None:
+            max_iterations = min(max_iterations, limits.max_iterations)
+        if turn_tokens is not None and turn_tokens < mandatory_input_tokens + 1:
+            # No silent rise of an aggregate allowance to satisfy the floor.
+            unresolved.append("turn_allowance_below_mandatory_input_and_output")
+    elif level == 6:
+        input_tokens = output_tokens = thinking_tokens = max_iterations = None
+
+    return UsagePolicy(
+        level=level, version=version, normal=normal, limits=limits,
+        input_tokens=input_tokens, output_tokens=output_tokens,
+        thinking_tokens=thinking_tokens, max_iterations=max_iterations,
+        turn_token_limit=turn_tokens, turn_call_limit=turn_calls,
+        strict=strict if level <= 4 else False,
+        mandatory_input_tokens=mandatory_input_tokens,
+        unresolved=tuple(unresolved),
+    )
+
+
+@dataclass(frozen=True)
+class Reservation:
+    origin_turn_id: str
+    attempt_id: str
+    policy_version: int
+    category: str
+    input_tokens: int
+    output_tokens: int
+    input_is_exact: bool
+    output_cap_verified: bool
+
+
+@dataclass(frozen=True)
+class AttemptSnapshot:
+    reservation: Reservation
+    state: str
+    actual_input_tokens: int | None
+    actual_output_tokens: int | None
+    charged_input_tokens: int
+    charged_output_tokens: int
+
+
+@dataclass(frozen=True)
+class LedgerSnapshot:
+    origin_turn_id: str
+    policy_version: int
+    stopped: bool
+    total_charged_tokens: int
+    known_input_tokens: int
+    known_output_tokens: int
+    unknown_reserved_tokens: int
+    committed_calls: int
+    dispatched_calls: int
+    released_calls: int
+    capability_violation: bool
+    over_limit: bool
+    attempts: tuple[AttemptSnapshot, ...]
+    observations: tuple["ObservationSnapshot", ...] = ()
+    observed_calls: int = 0
+    observed_unknown_components: int = 0
+    physical_attempt_count_exact: bool = True
+    native_constraints: tuple["NativeConstraint", ...] = ()
+
+
+@dataclass(frozen=True)
+class NativeConstraint:
+    wire_format: str
+    parameter: str
+    retained_value: int | None
+    reason: str = "api_required_parameter"
+
+
+@dataclass(frozen=True)
+class ObservationSnapshot:
+    """No reservation or allowance: nullable provider-reported usage only."""
+    attempt_id: str
+    category: str
+    state: str
+    input_tokens: int | None
+    output_tokens: int | None
+    attempts_exact: bool
+
+
+@dataclass
+class _Attempt:
+    reservation: Reservation
+    state: str = "reserved"
+    actual_input_tokens: int | None = None
+    actual_output_tokens: int | None = None
+    ever_dispatched: bool = False
+
+    def snapshot(self) -> AttemptSnapshot:
+        released = self.state == "released"
+        return AttemptSnapshot(
+            reservation=self.reservation, state=self.state,
+            actual_input_tokens=self.actual_input_tokens,
+            actual_output_tokens=self.actual_output_tokens,
+            charged_input_tokens=0 if released else (
+                self.reservation.input_tokens if self.actual_input_tokens is None
+                else self.actual_input_tokens
+            ),
+            charged_output_tokens=0 if released else (
+                self.reservation.output_tokens if self.actual_output_tokens is None
+                else self.actual_output_tokens
+            ),
+        )
+
+
+class TurnBudgetLedger:
+    """Thread-safe admission/accounting for a single immutable origin turn.
+
+    Reservations include pending work so concurrent children cannot oversubscribe.
+    Only a host-proven *undispatched* reservation may be released. Cancellation,
+    timeout and missing/partial usage AFTER dispatch retain unknown components.
+    IDs remain as tombstones even after release, so a retry needs a new ID.
+
+    This is an in-memory candidate, not durable accounting or a crash-recovery
+    store. Reconnect/restore integration must never construct a new ledger for
+    the same active turn and advertise the reset as remaining allowance.
+    """
+
+    def __init__(self, origin_turn_id: str, policy: UsagePolicy):
+        self._origin_turn_id = _identifier(origin_turn_id, "origin_turn_id")
+        if not isinstance(policy, UsagePolicy):
+            raise BudgetError("invalid_policy")
+        self._policy = policy
+        self._lock = RLock()
+        self._attempts: dict[str, _Attempt] = {}
+        self._observations: dict[str, ObservationSnapshot] = {}
+        self._native_constraints: set[NativeConstraint] = set()
+        self._stopped = False
+
+    @property
+    def origin_turn_id(self) -> str:
+        return self._origin_turn_id
+
+    @property
+    def policy(self) -> UsagePolicy:
+        return self._policy
+
+    def observe_attempt(self, attempt_id: str, *, category: str = "main", attempts_exact: bool = False) -> None:
+        """Record a mode-5/6 native send without inventing a zero reservation.
+
+        SDK retries are unknown unless the adapter proves each actual attempt.
+        This observer is not admission; normal cancellation remains native-owned.
+        """
+        _identifier(attempt_id, "attempt_id")
+        _identifier(category, "category")
+        if self._policy.enforce_economy_limits or type(attempts_exact) is not bool:
+            raise BudgetError("observation_not_selected")
+        with self._lock:
+            # Level 6 removes usage ceilings, not cancellation. This is the
+            # atomic send permit for an unbounded request; a stop before this
+            # point must prevent it. Mode 5 keeps native cancellation behavior.
+            if self._policy.level == 6 and self._stopped:
+                raise BudgetError("turn_stopped")
+            if attempt_id in self._attempts or attempt_id in self._observations:
+                raise BudgetError("attempt_id_already_used")
+            self._observations[attempt_id] = ObservationSnapshot(
+                attempt_id, category, "dispatched", None, None, attempts_exact)
+
+    def record_native_constraint(self, wire_format: str, parameter: str, retained_value: int | None,
+                                 *, reason: str = "api_required_parameter") -> None:
+        _identifier(wire_format, "wire_format")
+        _identifier(parameter, "parameter")
+        if retained_value is not None:
+            _integer(retained_value, "retained_value")
+        if reason not in {"api_required_parameter", "unreviewed_optional_parameter"}:
+            raise BudgetError("invalid_native_constraint_reason")
+        with self._lock:
+            self._native_constraints.add(NativeConstraint(wire_format, parameter, retained_value, reason))
+
+    def reconcile_observation(self, attempt_id: str, *, input_tokens: int | None,
+                              output_tokens: int | None) -> ObservationSnapshot:
+        for name, value in (("input_tokens", input_tokens), ("output_tokens", output_tokens)):
+            if value is not None:
+                _integer(value, name)
+        with self._lock:
+            try:
+                old = self._observations[attempt_id]
+            except KeyError:
+                raise BudgetError("observation_not_started") from None
+            if old.state == "conflict":
+                return old
+            conflict = any(a is not None and b is not None and a != b for a, b in (
+                (old.input_tokens, input_tokens), (old.output_tokens, output_tokens)))
+            incoming = old.input_tokens if input_tokens is None else input_tokens
+            outgoing = old.output_tokens if output_tokens is None else output_tokens
+            state = "settled" if incoming is not None and outgoing is not None else "unknown"
+            if conflict:
+                incoming = outgoing = None
+                state = "conflict"
+            value = ObservationSnapshot(old.attempt_id, old.category, state, incoming, outgoing, old.attempts_exact)
+            self._observations[attempt_id] = value
+            return value
+
+    def invalidate_observation(self, attempt_id: str) -> None:
+        with self._lock:
+            old = self._observations[attempt_id]
+            self._observations[attempt_id] = ObservationSnapshot(
+                old.attempt_id, old.category, "conflict", None, None, old.attempts_exact)
+
+    def reserve(
+        self, attempt_id: str, *, input_tokens: int, output_tokens: int,
+        input_is_exact: bool = False, output_cap_verified: bool = False,
+        category: str = "main", required_input_tokens: int = 0,
+    ) -> Reservation:
+        _identifier(attempt_id, "attempt_id")
+        _identifier(category, "category")
+        _integer(input_tokens, "input_tokens")
+        _integer(output_tokens, "output_tokens")
+        _integer(required_input_tokens, "required_input_tokens")
+        if type(input_is_exact) is not bool or type(output_cap_verified) is not bool:
+            raise BudgetError("invalid_capability_flag")
+        with self._lock:
+            if attempt_id in self._attempts or attempt_id in self._observations:
+                raise BudgetError("attempt_id_already_used")
+            if self._stopped:
+                raise BudgetError("turn_stopped")
+            policy = self._policy
+            if policy.enforce_economy_limits:
+                if policy.strict and (policy.unresolved or any(value is None for value in (
+                    policy.input_tokens, policy.output_tokens,
+                    policy.turn_token_limit, policy.turn_call_limit,
+                ))):
+                    raise BudgetError("strict_policy_unresolved")
+                if policy.strict and not input_is_exact:
+                    raise BudgetError("strict_input_count_unverified")
+                if policy.strict and not output_cap_verified:
+                    raise BudgetError("strict_output_cap_unverified")
+                if policy.strict and output_tokens == 0:
+                    raise BudgetError("strict_output_allowance_missing")
+                # A title/reviewer has different mandatory content from the
+                # primary conversation. Its host supplies its own minimum;
+                # never impose the main role/current-input floor on every call.
+                if input_tokens < required_input_tokens:
+                    raise BudgetError("mandatory_input_not_counted")
+                if policy.input_tokens is not None and input_tokens > policy.input_tokens:
+                    raise BudgetExceeded("request_input_limit")
+                if policy.output_tokens is not None and output_tokens > policy.output_tokens:
+                    raise BudgetExceeded("request_output_limit")
+                snapshot = self._snapshot_locked()
+                if snapshot.over_limit:
+                    raise BudgetExceeded("actual_usage_exceeded_allowance")
+                if policy.turn_call_limit is not None and snapshot.committed_calls >= policy.turn_call_limit:
+                    raise BudgetExceeded("turn_call_limit")
+                if (policy.turn_token_limit is not None and
+                        snapshot.total_charged_tokens + input_tokens + output_tokens > policy.turn_token_limit):
+                    raise BudgetExceeded("turn_token_limit")
+            reservation = Reservation(
+                origin_turn_id=self._origin_turn_id, attempt_id=attempt_id,
+                policy_version=policy.version, category=category,
+                input_tokens=input_tokens, output_tokens=output_tokens,
+                input_is_exact=input_is_exact, output_cap_verified=output_cap_verified,
+            )
+            self._attempts[attempt_id] = _Attempt(reservation)
+            return reservation
+
+    def _attempt(self, attempt_id: str) -> _Attempt:
+        _identifier(attempt_id, "attempt_id")
+        try:
+            return self._attempts[attempt_id]
+        except KeyError:
+            raise BudgetError("attempt_not_reserved") from None
+
+    def mark_dispatched(self, attempt_id: str) -> Reservation:
+        """Called once immediately before the transport may issue this attempt."""
+        with self._lock:
+            attempt = self._attempt(attempt_id)
+            if self._stopped:
+                raise BudgetError("turn_stopped")
+            if attempt.state != "reserved":
+                raise BudgetError("attempt_not_pending")
+            if self._policy.enforce_economy_limits and self._snapshot_locked().over_limit:
+                raise BudgetExceeded("actual_usage_exceeded_allowance")
+            attempt.state = "dispatched"
+            attempt.ever_dispatched = True
+            return attempt.reservation
+
+    def cancel_before_dispatch(self, attempt_id: str) -> AttemptSnapshot:
+        """Release only when no dispatch permit was acquired by any thread."""
+        with self._lock:
+            attempt = self._attempt(attempt_id)
+            if attempt.state != "reserved":
+                raise BudgetError("attempt_cannot_be_released")
+            attempt.state = "released"
+            return attempt.snapshot()
+
+    def reconcile(
+        self, attempt_id: str, *, input_tokens: int | None, output_tokens: int | None,
+    ) -> AttemptSnapshot:
+        """Record normalized cumulative final usage; late missing fields may fill.
+
+        Never pass streaming *deltas*. Known fields cannot be revised or refunded
+        by a replay. Exact duplicate reports are idempotent; unknown fields keep
+        their reservation until a corresponding final count is actually known.
+        Provider overruns are recorded truthfully, not clipped to our allowance.
+        """
+        for name, value in (("input_tokens", input_tokens), ("output_tokens", output_tokens)):
+            if value is not None:
+                _integer(value, name)
+        with self._lock:
+            attempt = self._attempt(attempt_id)
+            if not attempt.ever_dispatched:
+                raise BudgetError("attempt_not_dispatched")
+            for old, new in ((attempt.actual_input_tokens, input_tokens),
+                             (attempt.actual_output_tokens, output_tokens)):
+                if old is not None and new is not None and old != new:
+                    raise BudgetError("usage_report_conflict")
+            if input_tokens is not None:
+                attempt.actual_input_tokens = input_tokens
+            if output_tokens is not None:
+                attempt.actual_output_tokens = output_tokens
+            attempt.state = "settled" if (
+                attempt.actual_input_tokens is not None and
+                attempt.actual_output_tokens is not None
+            ) else "unknown"
+            return attempt.snapshot()
+
+    def finalize_unknown(self, attempt_id: str) -> AttemptSnapshot:
+        return self.reconcile(attempt_id, input_tokens=None, output_tokens=None)
+
+    def stop(self) -> LedgerSnapshot:
+        """No new dispatches; pending reservations release, sent work stays charged.
+
+        The existing executor still owns actual cancellation. Stopping this
+        ledger does not pretend to cancel a provider request already in flight.
+        """
+        with self._lock:
+            self._stopped = True
+            for attempt in self._attempts.values():
+                if attempt.state == "reserved":
+                    attempt.state = "released"
+                elif attempt.state == "dispatched":
+                    attempt.state = "unknown"
+            return self._snapshot_locked()
+
+    def snapshot(self) -> LedgerSnapshot:
+        with self._lock:
+            return self._snapshot_locked()
+
+    def _snapshot_locked(self) -> LedgerSnapshot:
+        attempts = tuple(attempt.snapshot() for attempt in self._attempts.values())
+        observations = tuple(self._observations.values())
+        charged = sum(a.charged_input_tokens + a.charged_output_tokens for a in attempts)
+        known_input = sum(a.actual_input_tokens or 0 for a in attempts)
+        known_output = sum(a.actual_output_tokens or 0 for a in attempts)
+        committed = sum(a.state != "released" for a in attempts)
+        capability_violation = any(
+            (a.reservation.input_is_exact and a.actual_input_tokens is not None and
+             a.actual_input_tokens > a.reservation.input_tokens) or
+            (a.reservation.output_cap_verified and a.actual_output_tokens is not None and
+             a.actual_output_tokens > a.reservation.output_tokens)
+            for a in attempts
+        )
+        return LedgerSnapshot(
+            origin_turn_id=self._origin_turn_id, policy_version=self._policy.version,
+            stopped=self._stopped, total_charged_tokens=charged + sum(
+                (a.input_tokens or 0) + (a.output_tokens or 0) for a in observations),
+            known_input_tokens=known_input + sum(a.input_tokens or 0 for a in observations),
+            known_output_tokens=known_output + sum(a.output_tokens or 0 for a in observations),
+            unknown_reserved_tokens=charged - known_input - known_output,
+            committed_calls=committed,
+            dispatched_calls=sum(a.ever_dispatched for a in self._attempts.values()),
+            released_calls=sum(a.state == "released" for a in attempts),
+            capability_violation=capability_violation,
+            over_limit=self._policy.enforce_economy_limits and (
+                capability_violation or
+                (self._policy.turn_token_limit is not None and charged > self._policy.turn_token_limit) or
+                (self._policy.turn_call_limit is not None and committed > self._policy.turn_call_limit) or
+                any((self._policy.input_tokens is not None and a.charged_input_tokens > self._policy.input_tokens) or
+                    (self._policy.output_tokens is not None and a.charged_output_tokens > self._policy.output_tokens)
+                    for a in attempts)
+            ),
+            attempts=attempts,
+            observations=observations, observed_calls=len(observations),
+            observed_unknown_components=sum((a.input_tokens is None) + (a.output_tokens is None) for a in observations),
+            physical_attempt_count_exact=all(a.attempts_exact for a in observations),
+            native_constraints=tuple(sorted(self._native_constraints,
+                key=lambda value: (value.wire_format, value.parameter, -1 if value.retained_value is None else value.retained_value))),
+        )
+
+
+_CURRENT_TURN_BUDGET: ContextVar[TurnBudgetLedger | None] = ContextVar(
+    "lilith_usage_budget_origin", default=None,
+)
+
+
+def current_turn_budget() -> TurnBudgetLedger | None:
+    return _CURRENT_TURN_BUDGET.get()
+
+
+@contextmanager
+def bind_turn_budget(ledger: TurnBudgetLedger) -> Iterator[TurnBudgetLedger]:
+    """Bind only the exact origin ledger; descendants must not replace it.
+
+    Async tasks inherit ContextVars. A new OS thread does not: the host must use
+    copy_context().run or explicitly pass/bind this same ledger there. This
+    helper does not claim missing background routes have been integrated.
+    """
+    if not isinstance(ledger, TurnBudgetLedger):
+        raise BudgetError("invalid_ledger")
+    existing = current_turn_budget()
+    if existing is not None and existing is not ledger:
+        raise BudgetError("origin_budget_replacement_forbidden")
+    token = _CURRENT_TURN_BUDGET.set(ledger)
+    try:
+        yield ledger
+    finally:
+        _CURRENT_TURN_BUDGET.reset(token)
