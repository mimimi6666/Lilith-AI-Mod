+++ b/agent/usage_budget_projection.py
@@ -0,0 +1,119 @@
+"""Bounded, content-free terminal disclosure of retained level-six constraints.
+
+This is presentation data, never budget/permission authority. Read only the
+frozen origin and fields already present on the constructed native agent. In
+particular, do not resolve compressor properties: they may probe a provider.
+Required API fields can retain native/user numeric values; this projection
+does NOT certify those values as provider maxima or as unavoidable values.
+"""
+from __future__ import annotations
+
+import math
+from types import GetSetDescriptorType, MemberDescriptorType
+
+from agent.usage_budget import NativeConstraint, TurnBudgetLedger
+from agent.usage_budget_runtime import OriginBudgetHandle
+
+
+SCHEMA_VERSION = 1
+MAX_CONSTRAINTS = 32
+MAX_RETAINED_VALUE = 2**63 - 1
+
+_WIRE_CONSTRAINTS = {
+    ("anthropic_messages", "max_tokens", "api_required_parameter"),
+    ("anthropic_messages", "thinking.budget_tokens", "api_required_parameter"),
+    ("bedrock_converse", "thinking.budget_tokens", "api_required_parameter"),
+} | {
+    (wire, parameter, "unreviewed_optional_parameter")
+    for wire in ("chat_completions", "chat_max_tokens", "chat_max_completion_tokens")
+    for parameter in ("thinking_budget", "reasoning.max_tokens")
+}
+
+
+def _instance_fields(value):
+    """Get a builtin instance dictionary without invoking custom descriptors.
+
+    vars()/getattr() can call a plugin's __getattribute__ or a __dict__ property.
+    Accept only Python's builtin storage descriptor, never a custom getter.
+    Missing/unusual plugin storage is unknown rather than permission to probe.
+    """
+    cls = type(value)
+    for base in type.__getattribute__(cls, "__mro__"):
+        descriptor = type.__getattribute__(base, "__dict__").get("__dict__")
+        if descriptor is None:
+            continue
+        if type(descriptor) not in (GetSetDescriptorType, MemberDescriptorType):
+            return {}
+        try:
+            fields = descriptor.__get__(value, cls)
+        except (TypeError, AttributeError):
+            return {}
+        return fields if type(fields) is dict else {}
+    return {}
+
+
+def _bounded_integer(value):
+    return value if type(value) is int and 0 <= value <= MAX_RETAINED_VALUE else None
+
+
+def _threshold_basis_points(value):
+    # A UI unit, not token accounting: 5000 means an existing 50% threshold.
+    if type(value) not in (int, float) or not 0 < value <= 1:
+        return None
+    if type(value) is float and not math.isfinite(value):
+        return None
+    return int(round(value * 10_000))
+
+
+def project_budget_constraints(handle, agent) -> list[dict]:
+    """Return the optional ``message.complete.budget_constraints`` value.
+
+    Each v1 entry has exactly schema_version/wire_format/parameter/
+    retained_value/reason. Values are nonnegative Int64 or null (unknown),
+    never strings, credentials, model IDs, endpoints, prompts or raw config.
+    Only level six emits entries. The local context entries take precedence
+    within the bounded 32-entry display; repeated identical entries collapse.
+    A retained context setting describes current native compression, not a
+    verified model window. It is deliberately not changed by this observer.
+    """
+    if type(handle) is not OriginBudgetHandle or type(handle.ledger) is not TurnBudgetLedger:
+        return []
+    ledger = handle.ledger
+    if ledger.policy.level != 6:
+        return []
+    result = []
+    seen = set()
+
+    def append(wire_format, parameter, retained_value, reason):
+        identity = (wire_format, parameter, retained_value, reason)
+        if identity in seen or len(result) >= MAX_CONSTRAINTS:
+            return
+        seen.add(identity)
+        result.append({"schema_version": SCHEMA_VERSION, "wire_format": wire_format,
+                       "parameter": parameter, "retained_value": retained_value,
+                       "reason": reason})
+
+    fields = _instance_fields(agent)
+    context_length = fields.get("_config_context_length")
+    if context_length is not None:
+        append("native_context", "context_length", _bounded_integer(context_length),
+               "existing_context_setting")
+    compressor = _instance_fields(fields.get("context_compressor"))
+    threshold_cap = compressor.get("threshold_tokens_cap")
+    if threshold_cap is not None:
+        append("native_context", "threshold_tokens_cap", _bounded_integer(threshold_cap),
+               "existing_context_setting")
+    threshold_percent = compressor.get("_base_threshold_percent")
+    if threshold_percent is not None:
+        append("native_context", "threshold_basis_points", _threshold_basis_points(threshold_percent),
+               "existing_context_setting")
+
+    for item in TurnBudgetLedger.snapshot(ledger).native_constraints:
+        if type(item) is not NativeConstraint:
+            continue
+        if (type(item.wire_format) is not str or type(item.parameter) is not str
+                or type(item.reason) is not str
+                or (item.wire_format, item.parameter, item.reason) not in _WIRE_CONSTRAINTS):
+            continue
+        append(item.wire_format, item.parameter, _bounded_integer(item.retained_value), item.reason)
+    return result
diff --git a/agent/usage_budget_runtime.py b/agent/usage_budget_runtime.py
new file mode 100644
--- /dev/null
+++ b/agent/usage_budget_runtime.py
@@ -0,0 +1,362 @@
+"""Profile-owned origin lifecycle for next-player-turn economic policy.
+
+Native ingress supplies a durable/inflight *turn* ID, never a socket ID. Only a
+new authenticated human event calls admit_new_origin. Reconnect and deferred
+work resume/capture the existing handle; an unknown resume after process restart
+fails closed instead of minting a fresh allowance. This file does not restore
+usage across process death. An unbound admission can be transferred once over
+the host's private compute pipe; a live ledger can never be transferred.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+import os
+from pathlib import Path
+import re
+import secrets
+from threading import RLock
+from typing import Callable, Iterator, TypeVar
+import uuid
+import weakref
+
+from agent.usage_budget import BudgetError, TurnBudgetLedger, UsagePolicy, bind_turn_budget
+from agent.usage_budget_preferences import UsagePreference
+from agent.usage_budget_store import BudgetStoreError, UsageBudgetStore
+
+
+_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\Z", re.ASCII)
+_Result = TypeVar("_Result")
+
+
+def _identity(value: str) -> str:
+    if type(value) is not str or _ID.fullmatch(value) is None:
+        raise BudgetError("invalid_origin_identity")
+    return value
+
+
+@dataclass
+class _OriginLifecycle:
+    primary_complete: bool = False
+    retired: bool = False
+
+
+@dataclass
+class _AcceptedState:
+    handle: "OriginBudgetHandle | None" = None
+    transferred: bool = False
+
+
+@dataclass(frozen=True)
+class AcceptedOrigin:
+    """Host-issued process-local admission, frozen before queue/build/vision."""
+    origin_id: str
+    generation_id: str
+    preference: UsagePreference
+    _owner: "UsageBudgetRuntime" = field(repr=False, compare=False)
+    _state: _AcceptedState = field(default_factory=_AcceptedState, repr=False, compare=False)
+
+    def __reduce__(self):
+        raise TypeError("economic origin tickets cannot cross processes")
+
+
+@dataclass(frozen=True)
+class OriginBudgetHandle:
+    origin_id: str
+    generation_id: str
+    preference: UsagePreference
+    ledger: TurnBudgetLedger
+    _owner: "UsageBudgetRuntime" = field(repr=False, compare=False)
+    _lifecycle: _OriginLifecycle = field(default_factory=_OriginLifecycle, repr=False, compare=False)
+
+    def __reduce__(self):
+        raise TypeError("economic ledger handles cannot cross processes")
+
+
+@dataclass(frozen=True)
+class OriginStatus:
+    origin_id: str
+    generation_id: str
+    preference: UsagePreference
+    primary_complete: bool
+    stopped: bool
+    retired: bool
+
+
+@dataclass
+class _Origin:
+    handle: OriginBudgetHandle
+
+    @property
+    def primary_complete(self):
+        return self.handle._lifecycle.primary_complete
+
+    @primary_complete.setter
+    def primary_complete(self, value):
+        self.handle._lifecycle.primary_complete = value
+
+    @property
+    def retired(self):
+        return self.handle._lifecycle.retired
+
+    @retired.setter
+    def retired(self, value):
+        self.handle._lifecycle.retired = value
+
+
+class UsageBudgetRuntime:
+    """One process-lifetime economic owner for one host-bound Hermes profile.
+
+    SQLite retains consumed identities; live handles are weakly indexed. Once
+    every real primary/background owner releases its handle, memory can be
+    reclaimed without making the old identity eligible for another allowance.
+    """
+
+    def __init__(self, store: UsageBudgetStore, *, generation_id: str | None = None,
+                 max_origins: int = 4096):
+        if not isinstance(store, UsageBudgetStore):
+            raise BudgetError("invalid_budget_store")
+        if type(max_origins) is not int or not 1 <= max_origins <= 100_000:
+            raise BudgetError("invalid_origin_capacity")
+        self.store = store
+        self.generation_id = _identity(generation_id or uuid.uuid4().hex)
+        self._lock = RLock()
+        # max_origins remains accepted for source compatibility, not a quota.
+        self._origins: weakref.WeakValueDictionary[str, OriginBudgetHandle] = weakref.WeakValueDictionary()
+        self._accepted: weakref.WeakValueDictionary[str, AcceptedOrigin] = weakref.WeakValueDictionary()
+
+    def accept_new_origin(self, origin_id: str) -> AcceptedOrigin:
+        _identity(origin_id)
+        with self._lock:
+            try:
+                preference = self.store.claim_origin(origin_id, self.generation_id)
+            except BudgetStoreError as error:
+                if error.code == "origin_already_admitted":
+                    raise BudgetError(error.code) from None
+                raise
+            accepted = AcceptedOrigin(origin_id, self.generation_id, preference, self)
+            self._accepted[origin_id] = accepted
+            return accepted
+
+    def bind_accepted_origin(self, accepted: AcceptedOrigin,
+                             resolver: Callable[[UsagePreference], UsagePolicy]) -> OriginBudgetHandle:
+        if not callable(resolver):
+            raise BudgetError("invalid_policy_resolver")
+        with self._lock:
+            if (type(accepted) is not AcceptedOrigin or accepted._owner is not self
+                    or accepted.generation_id != self.generation_id
+                    or self._accepted.get(accepted.origin_id) is not accepted):
+                raise BudgetError("foreign_origin_ticket")
+            if accepted._state.transferred:
+                raise BudgetError("origin_transferred")
+            if accepted._state.handle is not None:
+                self._validate(accepted._state.handle)
+                return accepted._state.handle
+            policy = resolver(accepted.preference)
+            if (not isinstance(policy, UsagePolicy) or policy.level != accepted.preference.level
+                    or policy.version != accepted.preference.revision):
+                raise BudgetError("origin_policy_mismatch")
+            self.store.bind_origin_claim(accepted.origin_id, self.generation_id)
+            handle = OriginBudgetHandle(accepted.origin_id, self.generation_id,
+                                       accepted.preference, TurnBudgetLedger(accepted.origin_id, policy), self)
+            self._origins[accepted.origin_id] = handle
+            accepted._state.handle = handle
+            return handle
+
+    def transfer_accepted_origin(self, accepted: AcceptedOrigin) -> dict:
+        """One-time pre-execution transfer over the existing private host pipe."""
+        with self._lock:
+            if (type(accepted) is not AcceptedOrigin or accepted._owner is not self
+                    or self._accepted.get(accepted.origin_id) is not accepted):
+                raise BudgetError("foreign_origin_ticket")
+            if accepted._state.handle is not None or accepted._state.transferred:
+                raise BudgetError("origin_transfer_unavailable")
+            token = secrets.token_hex(32)
+            # Any uncertain commit must also forbid parent execution.
+            accepted._state.transferred = True
+            self.store.transfer_origin(accepted.origin_id, self.generation_id, token)
+            return {"origin_id": accepted.origin_id, "token": token}
+
+    def redeem_transferred_origin(self, envelope: dict) -> AcceptedOrigin:
+        if type(envelope) is not dict or set(envelope) != {"origin_id", "token"}:
+            raise BudgetError("invalid_origin_transfer")
+        origin_id = _identity(envelope["origin_id"])
+        with self._lock:
+            preference = self.store.redeem_origin(origin_id, self.generation_id, envelope["token"])
+            accepted = AcceptedOrigin(origin_id, self.generation_id, preference, self)
+            self._accepted[origin_id] = accepted
+            return accepted
+
+    def admit_new_origin(self, origin_id: str,
+                         resolver: Callable[[UsagePreference], UsagePolicy]) -> OriginBudgetHandle:
+        """Freeze the current durable preference once, before any paid work.
+
+        ``resolver`` is native host code bound to the selected model, its normal
+        policy and attested capabilities. No model/user numeric values are used.
+        This method cannot be used for resume/reconnect, even with the same ID.
+        """
+        _identity(origin_id)
+        if not callable(resolver):
+            raise BudgetError("invalid_policy_resolver")
+        return self.bind_accepted_origin(self.accept_new_origin(origin_id), resolver)
+
+    def _get(self, origin_id: str) -> _Origin:
+        _identity(origin_id)
+        try:
+            return _Origin(self._origins[origin_id])
+        except KeyError:
+            raise BudgetError("origin_resume_unavailable") from None
+
+    def _validate(self, handle: OriginBudgetHandle) -> _Origin:
+        if type(handle) is not OriginBudgetHandle or handle._owner is not self:
+            raise BudgetError("foreign_origin_handle")
+        with self._lock:
+            origin = self._get(handle.origin_id)
+            if origin.handle is not handle or handle.generation_id != self.generation_id:
+                raise BudgetError("foreign_origin_handle")
+            if origin.retired:
+                raise BudgetError("origin_retired")
+            return origin
+
+    def resume_origin(self, origin_id: str) -> OriginBudgetHandle:
+        with self._lock:
+            origin = self._get(origin_id)
+            if origin.retired:
+                raise BudgetError("origin_retired")
+            return origin.handle
+
+    def status(self, origin_id: str) -> OriginStatus:
+        with self._lock:
+            origin = self._get(origin_id)
+            return OriginStatus(origin_id, self.generation_id, origin.handle.preference,
+                                origin.primary_complete, origin.handle.ledger.snapshot().stopped,
+                                origin.retired)
+
+    def complete_primary(self, origin_id: str) -> OriginStatus:
+        with self._lock:
+            origin = self._get(origin_id)
+            origin.primary_complete = True
+            # Persisted-turn review and other already-associated work still
+            # use this same policy/ledger after the main reply completes.
+            return self.status(origin_id)
+
+    def stop_origin(self, origin_id: str) -> OriginStatus:
+        with self._lock:
+            self._get(origin_id).handle.ledger.stop()
+            return self.status(origin_id)
+
+    def retire_origin(self, origin_id: str) -> OriginStatus:
+        with self._lock:
+            origin = self._get(origin_id)
+            origin.handle.ledger.stop()
+            origin.retired = True
+            return self.status(origin_id)
+
+
+_CURRENT_ORIGIN: ContextVar[OriginBudgetHandle | None] = ContextVar(
+    "lilith_usage_budget_origin_handle", default=None,
+)
+_CURRENT_ACCEPTED: ContextVar[AcceptedOrigin | None] = ContextVar(
+    "lilith_usage_budget_accepted_origin", default=None,
+)
+_RUNTIMES: dict[str, UsageBudgetRuntime] = {}
+_RUNTIMES_LOCK = RLock()
+
+
+def get_runtime(profile_root) -> UsageBudgetRuntime:
+    """Native code passes the authenticated profile, never request-supplied data."""
+    store = UsageBudgetStore(profile_root)
+    # Do not resolve symlinks into a trusted root. The store validates and pins
+    # the original path on every I/O. Normalization only deduplicates spelling.
+    key = os.path.normcase(os.path.normpath(str(Path(profile_root))))
+    with _RUNTIMES_LOCK:
+        if key not in _RUNTIMES:
+            _RUNTIMES[key] = UsageBudgetRuntime(store)
+        return _RUNTIMES[key]
+
+
+def current_origin() -> OriginBudgetHandle | None:
+    return _CURRENT_ORIGIN.get()
+
+
+def current_accepted_origin() -> AcceptedOrigin | None:
+    return _CURRENT_ACCEPTED.get()
+
+
+@contextmanager
+def pending_origin_scope(accepted):
+    """Freeze required dispatch lineage while allowing non-paid control work.
+
+    Dispatch must reject a pending ticket without its matching bound ledger;
+    it must not reread a newly relaxed preference and treat it as free work.
+    """
+    if accepted is not None:
+        if (type(accepted) is not AcceptedOrigin
+                or accepted._owner._accepted.get(accepted.origin_id) is not accepted
+                or accepted._state.transferred):
+            raise BudgetError("foreign_origin_ticket")
+    token = _CURRENT_ACCEPTED.set(accepted)
+    try:
+        yield accepted
+    finally:
+        _CURRENT_ACCEPTED.reset(token)
+
+
+@contextmanager
+def isolated_ingress_scope():
+    """Only a fresh authenticated platform ingress clears inherited economy.
+
+    Async platform tasks may inherit the spawning turn's ContextVars. Reset
+    these three accounting values only, not any permission/secret authority.
+    Continuations must present an explicit captured handle on their event.
+    """
+    from agent.usage_budget import _CURRENT_TURN_BUDGET
+    origin = _CURRENT_ORIGIN.set(None)
+    accepted = _CURRENT_ACCEPTED.set(None)
+    ledger = _CURRENT_TURN_BUDGET.set(None)
+    try:
+        yield
+    finally:
+        _CURRENT_TURN_BUDGET.reset(ledger)
+        _CURRENT_ACCEPTED.reset(accepted)
+        _CURRENT_ORIGIN.reset(origin)
+
+
+def require_origin() -> OriginBudgetHandle:
+    handle = current_origin()
+    if handle is None:
+        raise BudgetError("origin_context_missing")
+    handle._owner._validate(handle)
+    return handle
+
+
+def capture_origin() -> OriginBudgetHandle | None:
+    """Capture only economy lineage, not tool/approval/secret ContextVars."""
+    handle = current_origin()
+    if handle is not None:
+        handle._owner._validate(handle)
+    return handle
+
+
+@contextmanager
+def bind_origin(handle: OriginBudgetHandle) -> Iterator[OriginBudgetHandle]:
+    if type(handle) is not OriginBudgetHandle:
+        raise BudgetError("invalid_origin_handle")
+    handle._owner._validate(handle)
+    existing = current_origin()
+    if existing is not None and existing is not handle:
+        raise BudgetError("origin_budget_replacement_forbidden")
+    with bind_turn_budget(handle.ledger):
+        token = _CURRENT_ORIGIN.set(handle)
+        try:
+            yield handle
+        finally:
+            _CURRENT_ORIGIN.reset(token)
+
+
+def run_in_origin(handle: OriginBudgetHandle, callback: Callable[..., _Result],
+                  *args, **kwargs) -> _Result:
+    """Explicit same-process worker bridge; no ambient execution authority copied."""
+    with bind_origin(handle):
+        return callback(*args, **kwargs)
