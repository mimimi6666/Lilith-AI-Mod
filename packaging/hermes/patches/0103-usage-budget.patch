diff --git a/tui_gateway/methods_usage_budget.py b/tui_gateway/methods_usage_budget.py
new file mode 100644
--- /dev/null
+++ b/tui_gateway/methods_usage_budget.py
@@ -0,0 +1,63 @@
+"""Human Runtime control-plane handlers, not agent tools or config setters.
+
+Registration freezes the trusted gateway launch profile. Neither a session's
+ambient home override nor any client-supplied path can redirect this store.
+The authenticated Runtime enforces Workbench ownership; native additionally
+rejects generic/WS transports and hosts without the pinned identity contract.
+"""
+from agent.usage_budget_preferences import PreferenceError, parse_update
+from agent.usage_budget_store import get_preference, set_preference
+
+
+def _strict_host_required():
+    from agent.identity_policy import identity_lock_required_by_host
+    return identity_lock_required_by_host() is True
+
+
+def register(server):
+    profile_root = server._hermes_home
+    stdio = server._stdio_transport
+
+    def failure(rid, code):
+        return server._ok(rid, {"schema_version": 1, "code": "budget." + code})
+
+    def invoke(rid, params, *, mutation):
+        try:
+            transport = server.current_transport()
+            if (transport is not None and transport is not stdio) or not _strict_host_required():
+                return failure(rid, "host_required")
+        except Exception:
+            return failure(rid, "host_required")
+        quarantined = server._native_authority_quarantine_rpc_error(rid)
+        if quarantined is not None:
+            return quarantined
+        # Validate before touching storage. There are no hidden passthrough
+        # knobs for permission, maximum tokens, session identity or profile.
+        try:
+            if mutation:
+                update = parse_update(params)
+            elif type(params) is not dict or params:
+                raise PreferenceError("invalid_fields")
+        except PreferenceError:
+            return failure(rid, "invalid_request")
+        try:
+            if mutation:
+                return server._ok(rid, set_preference(profile_root, update).to_wire())
+            return server._ok(rid, get_preference(profile_root).to_wire())
+        except PreferenceError as error:
+            # Never echo exception text, private paths or rejected data.
+            code = str(error)
+            if code not in {
+                "revision_conflict", "operation_conflict", "revision_exhausted",
+                "store_capacity_reached", "store_busy", "store_unavailable",
+                "store_malformed", "unsafe_store_path",
+            }:
+                code = "operation_failed"
+            return failure(rid, code)
+        except Exception:
+            # Persistence may have committed before an IO failure; the caller
+            # must use the same operation ID/readback, not presume rollback.
+            return failure(rid, "operation_failed")
+
+    server._methods["budget.get"] = lambda rid, params: invoke(rid, params, mutation=False)
+    server._methods["budget.set"] = lambda rid, params: invoke(rid, params, mutation=True)
