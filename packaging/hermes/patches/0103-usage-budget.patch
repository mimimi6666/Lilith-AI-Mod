+def policy(preference):
+    return resolve_policy(preference.level,
+                          NormalBudget(8000, 800, None, 32, 32000, 32),
+                          VerifiedModelLimits(16000, 1600, None, 64,
+                                              evidence_id="synthetic"),
+                          version=preference.revision)
+
+
+def native_functions(path, names, namespace=None):
+    tree = ast.parse((ROOT / path).read_text(encoding="utf-8"))
+    if path == "gateway/run.py":
+        names = set(names) | {"_gateway_usage_route_scope"}
+    functions = [node for node in ast.walk(tree)
+                 if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in names]
+    result = {} if namespace is None else namespace
+    if path == "gateway/run.py":
+        result.setdefault("contextlib", contextlib)
+        result.setdefault("_USAGE_BUDGET_GATEWAY_ROUTE_SCOPE", ContextVar("fixture-route", default=None))
+    module = ast.Module(body=[ast.ImportFrom(module="__future__", names=[
+        ast.alias(name="annotations")], level=0)] + functions, type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), "actual-candidate-ingress", "exec"), result)
+    return result
+
+
+def immediate(coroutine):
+    try:
+        coroutine.send(None)
+    except StopIteration as done:
+        return done.value
+    finally:
+        coroutine.close()
+    raise AssertionError("fixture must not schedule real I/O")
