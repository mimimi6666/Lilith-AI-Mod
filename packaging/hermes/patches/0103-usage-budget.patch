@@ -0,0 +1,135 @@
+"""Cross-module synthetic scenarios, not real surface/provider integration."""
+from contextvars import ContextVar
+import threading
+import unittest
+
+from agent.usage_budget import (
+    BudgetError, NormalBudget, TurnBudgetLedger, VerifiedModelLimits,
+    bind_turn_budget, current_turn_budget, resolve_policy,
+)
+from agent.usage_budget_dispatch import (
+    InputCount, UsageCount, WireCapability, WireRoute, dispatch_budgeted_once,
+)
+from agent.usage_budget_preferences import (
+    PreferenceUpdate, UsagePreference, matches_readback, plan_update,
+)
+
+
+NORMAL = NormalBudget(input_tokens=16000, output_tokens=8000,
+                      turn_reference_tokens=80000, turn_reference_calls=16)
+LIMITS = VerifiedModelLimits(context_tokens=64000, output_tokens=8000,
+                             evidence_id="synthetic-capacity")
+ROUTE = WireRoute("synthetic-provider", "synthetic-model", "synthetic-adapter")
+CAPABILITY = WireCapability("chat_max_completion_tokens", "synthetic-wire", True,
+                            True, 0, True, ROUTE)
+
+
+def admit(origin, preference):
+    return TurnBudgetLedger(origin, resolve_policy(
+        preference.level, NORMAL, LIMITS, version=preference.revision))
+
+
+def request(ledger, attempt, *, category="main", send=lambda _body: object(),
+            usage=lambda _response: UsageCount(80, 20)):
+    return dispatch_budgeted_once(
+        ledger, attempt, {"model": ROUTE.model_id, "messages": [{"role": "user", "content": "synthetic"}]},
+        route=ROUTE, capability=CAPABILITY, count_input=lambda _body: InputCount(80, True),
+        send=send, read_usage=usage, category=category)
+
+
+class BudgetScenarioTests(unittest.TestCase):
+    def test_setting_change_never_refills_existing_origin_or_its_late_child(self):
+        initial = UsagePreference(1, 1)
+        active = admit("first-turn", initial)
+        request(active, "main-1")
+        transition = plan_update(initial, PreferenceUpdate("relax-next-turn", 1, 4))
+        # Simulate a successful native persistence/read-back, not a real store.
+        saved = transition.proposed
+        self.assertTrue(matches_readback(transition.receipt, saved))
+        with bind_turn_budget(active):
+            request(current_turn_budget(), "late-review", category="memory")
+            with self.assertRaises(BudgetError):
+                request(current_turn_budget(), "late-child", category="child")
+        self.assertEqual(1, active.policy.version)
+        self.assertEqual(2, active.snapshot().dispatched_calls)
+        next_turn = admit("next-turn", saved)
+        self.assertEqual(2, next_turn.policy.version)
+        self.assertEqual(4, next_turn.policy.level)
+        self.assertEqual(0, next_turn.snapshot().dispatched_calls)
+        for index in range(3):
+            request(next_turn, "new-" + str(index))
+
+    def test_explicit_thread_lineage_inherits_budget_without_ambient_authority(self):
+        ledger = admit("threaded-turn", UsagePreference(1, 1))
+        unrelated_authority = ContextVar("synthetic_unrelated_authority", default=None)
+        token = unrelated_authority.set("do-not-propagate")
+        observed = []
+        failures = []
+
+        def worker():
+            try:
+                self.assertIsNone(current_turn_budget())
+                self.assertIsNone(unrelated_authority.get())
+                with bind_turn_budget(ledger):
+                    request(current_turn_budget(), "background", category="memory")
+                    observed.append(current_turn_budget())
+                self.assertIsNone(current_turn_budget())
+            except BaseException as exc:
+                failures.append(exc)
+
+        try:
+            with bind_turn_budget(ledger):
+                request(ledger, "main")
+                thread = threading.Thread(target=worker)
+                thread.start()
+                thread.join(5)
+                self.assertFalse(thread.is_alive())
+                self.assertEqual([], failures)
+                self.assertEqual([ledger], observed)
+                with self.assertRaises(BudgetError):
+                    request(ledger, "no-free-new-origin", category="child")
+        finally:
+            unrelated_authority.reset(token)
+
+    def test_late_usage_reconciles_original_turn_after_preference_replay(self):
+        baseline = UsagePreference()
+        update = PreferenceUpdate("save-economy", 0, 2)
+        first = plan_update(baseline, update)
+        ledger = admit("original", first.proposed)
+        request(ledger, "unknown", usage=lambda _: UsageCount())
+        reserved = ledger.snapshot().unknown_reserved_tokens
+        self.assertGreater(reserved, 0)
+        second = plan_update(first.proposed, PreferenceUpdate("restore-normal", 1, 5))
+        replay = plan_update(second.proposed, update, first.receipt)
+        self.assertEqual(5, replay.proposed.level)
+        self.assertFalse(matches_readback(replay.receipt, second.proposed))
+        ledger.reconcile("unknown", input_tokens=80, output_tokens=20)
+        self.assertEqual(100, ledger.snapshot().total_charged_tokens)
+        self.assertEqual(1, ledger.policy.version)
+        self.assertEqual(2, ledger.policy.level)
+
+    def test_categories_share_one_call_count_instead_of_independent_budgets(self):
+        ledger = admit("mixed-work", UsagePreference(1, 3))
+        categories = ("main", "child", "compression", "memory", "title", "vision", "retry", "fallback")
+        for index, category in enumerate(categories):
+            request(ledger, "attempt-" + str(index), category=category)
+        with self.assertRaises(BudgetError):
+            request(ledger, "unbudgeted-final-summary", category="summary")
+        snapshot = ledger.snapshot()
+        self.assertEqual(8, snapshot.dispatched_calls)
+        self.assertEqual(800, snapshot.total_charged_tokens)
+        self.assertEqual(categories, tuple(item.reservation.category for item in snapshot.attempts))
+
+    def test_stop_does_not_become_resume_when_next_turn_level_is_raised(self):
+        preference = UsagePreference(1, 1)
+        ledger = admit("stopped", preference)
+        request(ledger, "sent", usage=lambda _: UsageCount())
+        before = ledger.stop()
+        plan_update(preference, PreferenceUpdate("maximum-next", 1, 6))
+        with self.assertRaises(BudgetError):
+            request(ledger, "not-a-resume")
+        self.assertEqual(before, ledger.snapshot())
+
+
+if __name__ == "__main__":
+    unittest.main()
