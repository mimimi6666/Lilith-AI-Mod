+class _ObservedAttempt:
+    """Best-effort normal accounting: no cap, counter or transport mutation."""
+    def __init__(self, ledger, reader, category, attempts_exact):
+        self.ledger, self.reader, self.category = ledger, reader, category
+        self.id = "observed-" + uuid4().hex
+        self.attempts_exact = attempts_exact
+        self.finished = self.started = self.usage_unreadable = False
+        self.last_usage = UsageCount()
+
+    def start(self):
+        try:
+            self.ledger.observe_attempt(self.id, category=self.category, attempts_exact=self.attempts_exact)
+            self.started = True
+        except BudgetError:
+            if self.ledger.policy.level == 6:
+                raise  # Atomic stop admission is authority, not observation.
+        except Exception:
+            if self.ledger.policy.level == 6:
+                raise BudgetError("unbounded_admission_failed") from None
+            pass  # Normal requests never fail due to an observer.
+
+    def observe(self, value):
+        try:
+            usage = self.reader(value)
+            if type(usage) is not UsageCount:
+                raise ValueError("unreadable usage")
+            if any(v is not None and (type(v) is not int or v < 0) for v in (usage.input_tokens, usage.output_tokens)):
+                raise ValueError("invalid usage")
+            self.last_usage = UsageCount(
+                self.last_usage.input_tokens if usage.input_tokens is None else usage.input_tokens,
+                self.last_usage.output_tokens if usage.output_tokens is None else usage.output_tokens)
+            if usage.input_tokens is not None and usage.output_tokens is not None:
+                self.usage_unreadable = False
+            return True
+        except Exception:
+            self.usage_unreadable = True
+            return False
+
+    def complete(self, value=None):
+        if self.finished and value is None:
+            return
+        was_finished = self.finished
+        if value is not None:
+            self.observe(value)
+        self.finished = True
+        if not self.started:
+            return
+        try:
+            if self.usage_unreadable and was_finished:
+                self.ledger.invalidate_observation(self.id)
+            else:
+                usage = UsageCount() if self.usage_unreadable else self.last_usage
+                self.ledger.reconcile_observation(self.id, input_tokens=usage.input_tokens, output_tokens=usage.output_tokens)
+        except Exception:
+            try:
+                self.ledger.invalidate_observation(self.id)
+            except Exception:
+                pass
+
+    def unknown(self):
+        if self.finished:
+            return
+        self.last_usage = UsageCount()
+        self.complete()
+
+
+def _normal_observer(client, request, wire_format, category, *, model_id=None):
+    ledger = current_turn_budget()
+    if ledger is None or ledger.policy.enforce_economy_limits:
+        return None
+    from agent.usage_budget_usage import read_usage
+    reader = lambda value: read_usage(value, wire_format)
+    exact = False
+    # A known leaf reader may be reused without treating it as enforcement.
+    try:
+        model = request.get("model") if model_id is None else model_id
+        with _BINDINGS_LOCK:
+            stored = _identity_entries(_BINDINGS, client).get((model, wire_format))
+            if stored is None and wire_format == "chat_completions":
+                stored = next((v for (m, f), v in _identity_entries(_BINDINGS, client).items()
+                               if m == model and f in {"chat_max_tokens", "chat_max_completion_tokens"}), None)
+        if stored is not None and stored[0] == _client_fingerprint(client):
+            reader = stored[1].read_usage
+            retries = getattr(client, "max_retries", stored[1].capability.sdk_max_retries)
+            exact = type(retries) is int and retries == 0 and stored[1].capability.sdk_max_retries == 0
+    except Exception:
+        pass
+    return _ObservedAttempt(ledger, reader, category, exact)
+
+
+def _neutral_wire_request(client, request, wire_format):
+    ledger = current_turn_budget()
+    if ledger is None or ledger.policy.level != 6:
+        return request
+    if ledger.snapshot().stopped:
+        raise BudgetError("turn_stopped")
+    result, constraints = prepare_unbounded_wire_request(request, wire_format)
+    for parameter, value in constraints:
+        ledger.record_native_constraint(wire_format, parameter, value)
+    if wire_format in {"chat_completions", "chat_max_tokens", "chat_max_completion_tokens"}:
+        from agent.usage_budget_official_routes import is_official_openrouter_chat, is_official_dashscope_chat
+        official_openrouter = is_official_openrouter_chat(client)
+        official_dashscope = is_official_dashscope_chat(client)
+        containers = [result]
+        if isinstance(result.get("extra_body"), dict):
+            containers.append(result["extra_body"])
+        for container in containers:
+            if "thinking_budget" in container:
+                if official_dashscope:
+                    container.pop("thinking_budget")
+                else:
+                    value = container["thinking_budget"]
+                    ledger.record_native_constraint(wire_format, "thinking_budget",
+                        value if type(value) is int and value >= 0 else None,
+                        reason="unreviewed_optional_parameter")
+            reasoning = container.get("reasoning")
+            if isinstance(reasoning, dict) and "max_tokens" in reasoning:
+                if official_openrouter:
+                    reasoning.pop("max_tokens")
+                else:
+                    value = reasoning["max_tokens"]
+                    ledger.record_native_constraint(wire_format, "reasoning.max_tokens",
+                        value if type(value) is int and value >= 0 else None,
+                        reason="unreviewed_optional_parameter")
+    return result
+
+
+def _validate_unbounded_deferred_origin(ledger, expected_handle=None):
+    if ledger.policy.level != 6:
+        return
+    validate_native_origin(expected_handle)
+    if current_turn_budget() is not ledger:
+        raise BudgetError("origin_budget_scope_missing")
+    if ledger.snapshot().stopped:
+        raise BudgetError("turn_stopped")
+
+
+def _observed_sync(client, request, send, wire_format, category, stream=False, model_id=None):
+    request = _neutral_wire_request(client, request, wire_format)
+    attempt = _normal_observer(client, request, wire_format, category, model_id=model_id)
+    if attempt is None:
+        return send(request)
+    attempt.start()
+    try:
+        result = send(request)
+        if stream and not _is_completed_stream_response(result, wire_format):
+            return _BudgetStream(result, attempt)
+    except BaseException:
+        attempt.unknown()
+        raise
+    attempt.complete(result)
+    return result
+
+
+async def _observed_async(client, request, send, wire_format, category, stream=False):
+    request = _neutral_wire_request(client, request, wire_format)
+    attempt = _normal_observer(client, request, wire_format, category)
+    if attempt is None:
+        return await send(request)
+    attempt.start()
+    try:
+        result = await send(request)
+        if stream and not _is_completed_stream_response(result, wire_format):
+            return _BudgetAsyncStream(result, attempt)
+    except BaseException:
+        attempt.unknown()
+        raise
+    attempt.complete(result)
+    return result
+
+
+def native_chat_dispatch_sync(client, request, send, *, category="main", expected_handle=None):
+    _active_ledger(expected_handle)
+    if _is_native_multiplex_shim(client):
+        with native_dispatch_category(category):
+            return send(request)
+    if _active_ledger(expected_handle) is None:
+        if _normal_shim_has_inner_observer(client):
+            with native_dispatch_category(category):
+                return send(request)
+        return _observed_sync(client, request, send, "chat_completions", category, bool(request.get("stream")))
+    binding = _shim_binding(client, request)
+    if binding is not None:
+        # These built-in shims transform the request and have their own final
+        # guard. Reserving here would count a single physical attempt twice.
+        token = _CATEGORY.set(category)
+        receipts = []
+        receipt_token = _GUARD_RECEIPTS.set(receipts)
+        try:
+            result = send(request)
+            _require_shim_receipt(receipts, current_turn_budget(), binding)
+            return result
+        finally:
+            _GUARD_RECEIPTS.reset(receipt_token)
+            _CATEGORY.reset(token)
+    return native_dispatch_sync(client, request, send,
+                                wire_format=_chat_wire_format(client, request),
+                                stream=bool(request.get("stream")), category=category)
+
+
+async def native_chat_dispatch_async(client, request, send, *, category="auxiliary", expected_handle=None):
+    _active_ledger(expected_handle)
+    if _is_native_multiplex_shim(client):
+        with native_dispatch_category(category):
+            return await send(request)
+    if _active_ledger(expected_handle) is None:
+        if _normal_shim_has_inner_observer(client):
+            with native_dispatch_category(category):
+                return await send(request)
+        return await _observed_async(client, request, send, "chat_completions", category, bool(request.get("stream")))
+    binding = _shim_binding(client, request)
+    if binding is not None:
+        token = _CATEGORY.set(category)
+        receipts = []
+        receipt_token = _GUARD_RECEIPTS.set(receipts)
+        try:
+            result = await send(request)
+            _require_shim_receipt(receipts, current_turn_budget(), binding)
+            return result
+        finally:
+            _GUARD_RECEIPTS.reset(receipt_token)
+            _CATEGORY.reset(token)
+    return await native_dispatch_async(client, request, send,
+                                       wire_format=_chat_wire_format(client, request),
+                                       stream=bool(request.get("stream")), category=category)
+
