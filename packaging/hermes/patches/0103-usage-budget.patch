+"""Offline candidate: admission at an adapter's *final* request boundary.
+
+Native integration lives in usage_budget_native_dispatch. Its host must supply
+reviewed capability evidence for the selected model/adapter, disable hidden SDK
+retries, and count the final complete input. A passing fake adapter test does not
+certify a provider, every Hermes route, or a whole-turn hard cap.
+
+The synchronous helper covers one completed response only. Stream opening is
+not response completion: streaming and native route integration remain separate
+work. Normal mode must keep its existing native path; it is not intercepted by
+the economic admission helper. No prompt, tool, history or memory is truncated.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from copy import deepcopy
+from dataclasses import dataclass
+import re
+from typing import Any
+
+from agent.usage_budget import BudgetError, TurnBudgetLedger
+
+
+_CAP_PATHS = {
+    "chat_max_tokens": ("max_tokens",),
+    "chat_max_completion_tokens": ("max_completion_tokens",),
+    "responses": ("max_output_tokens",),
+    "anthropic_messages": ("max_tokens",),
+    "gemini_generate_content": ("generationConfig", "maxOutputTokens"),
+    "bedrock_converse": ("inferenceConfig", "maxTokens"),
+}
+_ROOT_CAPS = frozenset({"max_tokens", "max_completion_tokens", "max_output_tokens"})
+
+
+@dataclass(frozen=True)
+class WireRoute:
+    """Opaque host transport/model/adapter identity; no credentials or URL."""
+
+    transport_id: str
+    model_id: str
+    adapter_id: str
+
+    def __post_init__(self) -> None:
+        for name in ("transport_id", "model_id", "adapter_id"):
+            value = getattr(self, name)
+            if (not isinstance(value, str)
+                    or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", value) is None):
+                raise BudgetError("invalid_wire_route")
+
+
+@dataclass(frozen=True)
+class WireCapability:
+    """Trusted host evidence, never a model-provided assertion.
+
+    ``sdk_max_retries`` describes the instantiated dispatch client, not just its
+    default constructor. ``all_output_counted`` includes reasoning and every
+    generated candidate in the enforced cap. Neither is inferred from a URL.
+    """
+
+    wire_format: str
+    evidence_id: str = ""
+    output_cap_verified: bool = False
+    all_output_counted: bool = False
+    sdk_max_retries: int | None = None
+    final_wire_verified: bool = False
+    route: WireRoute | None = None
+
+
+@dataclass(frozen=True)
+class InputCount:
+    tokens: int
+    exact: bool = False
+
+
+@dataclass(frozen=True)
+class UsageCount:
+    """Input/output totals. Cache and reasoning subsets are NOT added again."""
+
+    input_tokens: int | None = None
+    output_tokens: int | None = None
+
+
+def _positive_integer(value: Any, code: str) -> int:
+    if type(value) is not int or value <= 0:
+        raise BudgetError(code)
+    return value
+
+
+def _verified_capability(capability: WireCapability, route: WireRoute | None, *, estimated=False) -> tuple[str, ...]:
+    if (
+        not isinstance(capability, WireCapability)
+        or not isinstance(capability.evidence_id, str)
+        or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}", capability.evidence_id) is None
+        or type(capability.output_cap_verified) is not bool
+        or type(capability.all_output_counted) is not bool
+        or (not estimated and (capability.output_cap_verified is not True or capability.all_output_counted is not True))
+        or capability.final_wire_verified is not True
+        or not isinstance(capability.wire_format, str)
+        or capability.wire_format not in _CAP_PATHS
+    ):
+        raise BudgetError("wire_capability_unverified")
+    if (not isinstance(route, WireRoute) or not isinstance(capability.route, WireRoute)
+            or capability.route != route):
+        raise BudgetError("wire_route_unverified")
+    if type(capability.sdk_max_retries) is not int or capability.sdk_max_retries != 0:
+        raise BudgetError("hidden_transport_retries")
+    return _CAP_PATHS[capability.wire_format]
+
+
+def _reject_cap_overrides(request: Mapping[str, Any], path: tuple[str, ...]) -> None:
+    # SDK extra_body is merged later and can silently replace guarded fields.
+    # A real final-body hook must be placed after that merge. This candidate
+    # refuses conflicting pre-merge input rather than pretending it is final.
+    extra = request.get("extra_body")
+    if extra is not None:
+        if not isinstance(extra, Mapping):
+            raise BudgetError("invalid_extra_body")
+        # Even a non-cap override (messages/tools/stream) can invalidate input
+        # counting or turn a complete response into an unaccounted iterator.
+        if extra:
+            raise BudgetError("late_wire_override")
+    allowed_root = path[0] if len(path) == 1 else None
+    if any(name in request for name in _ROOT_CAPS if name != allowed_root):
+        raise BudgetError("conflicting_output_caps")
+    if "n" in request and (type(request["n"]) is not int or request["n"] != 1):
+        raise BudgetError("multiple_output_candidates")
+
+
+def prepare_wire_request(
+    request: dict[str, Any],
+    *,
+    output_limit: int | None,
+    capability: WireCapability,
+    route: WireRoute | None = None,
+    estimated_output: bool = False,
+) -> tuple[dict[str, Any], int | None]:
+    """Return a guarded copy and its exact requested cap; never increase a cap.
+
+    A ``None`` limit is an exact identity-preserving pass-through for existing
+    normal mode. It does not inspect capabilities, inject defaults or claim
+    that unbounded usage has become accounted or controlled.
+    """
+
+    if output_limit is None:
+        return request, None
+    if type(estimated_output) is not bool:
+        raise BudgetError("invalid_output_control")
+    limit = _positive_integer(output_limit, "invalid_output_limit")
+    if type(request) is not dict:
+        raise BudgetError("invalid_final_wire_request")
+    path = _verified_capability(capability, route, estimated=estimated_output)
+    # Gemini binds the model in the URL rather than JSON; the adapter passes
+    # the actual selected resource identity through route at that final seam.
+    if "model" in request and (
+        not isinstance(request["model"], str) or request["model"] != route.model_id
+    ):
+        raise BudgetError("wire_model_mismatch")
+    if capability.wire_format == "bedrock_converse" and request.get("modelId") != route.model_id:
+        raise BudgetError("wire_model_mismatch")
+    if capability.wire_format == "bedrock_converse" and request.get("additionalModelRequestFields"):
+        raise BudgetError("unverified_model_specific_fields")
+    _reject_cap_overrides(request, path)
+    guarded = deepcopy(request)
+    target = guarded
+    for name in path[:-1]:
+        if name not in target:
+            target[name] = {}
+        if type(target[name]) is not dict:
+            raise BudgetError("invalid_generation_config")
+        target = target[name]
+    existing = target.get(path[-1])
+    if existing is not None:
+        limit = min(limit, _positive_integer(existing, "invalid_existing_output_cap"))
+    target[path[-1]] = limit
+
+    if capability.wire_format == "anthropic_messages":
+        thinking = guarded.get("thinking")
+        if thinking is not None:
+            if not isinstance(thinking, Mapping):
+                raise BudgetError("invalid_thinking_config")
+            if thinking.get("type") == "enabled":
+                budget = _positive_integer(thinking.get("budget_tokens"), "invalid_thinking_budget")
+                # Do not silently disable thinking or guess provider minimums.
+                # Caller must resolve a supported thinking/output allocation.
+                if budget >= limit:
+                    raise BudgetError("thinking_budget_exceeds_output")
+            elif thinking.get("type") not in {"disabled", "adaptive"}:
+                raise BudgetError("unknown_thinking_mode")
+
+    if capability.wire_format == "gemini_generate_content":
+        generation = guarded["generationConfig"]
+        candidates = generation.get("candidateCount", 1)
+        if type(candidates) is not int or candidates != 1:
+            raise BudgetError("multiple_output_candidates")
+
+    return guarded, limit
+
+
+def prepare_uncontrolled_estimated_request(request, output_limit, capability, route):
+    """Known native protocol with no numeric output control. Never a hard cap."""
+    path = _verified_capability(capability, route, estimated=True)
+    limit = _positive_integer(output_limit, "output_limit_unknown")
+    if type(request) is not dict or request.get("model") != route.model_id:
+        raise BudgetError("wire_model_mismatch")
+    _reject_cap_overrides(request, path)
+    if any(name in request for name in _ROOT_CAPS):
+        raise BudgetError("unsupported_native_output_parameter")
+    return deepcopy(request), limit
+
+
+def dispatch_budgeted_once(
+    ledger: TurnBudgetLedger,
+    attempt_id: str,
+    request: dict[str, Any],
+    *,
+    capability: WireCapability,
+    route: WireRoute,
+    count_input: Callable[[dict[str, Any]], InputCount],
+    send: Callable[[dict[str, Any]], Any],
+    read_usage: Callable[[Any], UsageCount],
+    category: str = "main",
+) -> Any:
+    """Admit one synchronous, final-wire economic attempt, without retries.
+
+    The caller supplies an original request again for each physical attempt;
+    the same ID cannot reserve or dispatch twice. Exceptions and missing usage
+    retain the reservation, including cancellation after dispatch. User-visible
+    response validation belongs after this helper so even invalid responses
+    with genuine usage can be accounted before native recovery retries.
+
+    Normal and unbounded modes deliberately have no caller here: routing them
+    through this helper is an integration error, not an excuse to inject caps.
+    """
+
+    if not ledger.policy.enforce_economy_limits:
+        raise BudgetError("economic_admission_not_selected")
+    if request.get("stream"):
+        raise BudgetError("stream_accounting_not_integrated")
+    output_limit = ledger.policy.output_tokens
+    if output_limit is None:
+        raise BudgetError("output_limit_unknown")
+    guarded, cap = prepare_wire_request(
+        request, output_limit=output_limit, capability=capability, route=route
+    )
+    # Give the counter a copy: counting must not rewrite the request after its
+    # final cap was validated. Input includes system, tools, images and history.
+    counted = count_input(deepcopy(guarded))
+    if not isinstance(counted, InputCount) or type(counted.tokens) is not int or counted.tokens < 0:
+        raise BudgetError("invalid_input_count")
+    ledger.reserve(
+        attempt_id,
+        input_tokens=counted.tokens,
+        output_tokens=cap,
+        input_is_exact=counted.exact,
+        output_cap_verified=True,
+        category=category,
+    )
+    ledger.mark_dispatched(attempt_id)
+    try:
+        response = send(guarded)
+    except BaseException:
+        ledger.finalize_unknown(attempt_id)
+        raise
+    # An invalid/missing usage receipt cannot make a successful call "free" or
+    # trigger a second provider call by turning response parsing into a retry.
+    try:
+        usage = read_usage(response)
+        if not isinstance(usage, UsageCount):
+            raise ValueError("unrecognized usage receipt")
+        ledger.reconcile(
+            attempt_id,
+            input_tokens=usage.input_tokens,
+            output_tokens=usage.output_tokens,
+        )
+    except Exception:
+        ledger.finalize_unknown(attempt_id)
+    return response
+
+
+def prepare_unbounded_wire_request(request: dict[str, Any], wire_format: str):
+    """Remove optional human usage caps for level 6; never guess infinity.
+
+    Anthropic requires max_tokens and manual-thinking budget_tokens. Those
+    remain explicit constraints, not a claim that the provider is unlimited.
+    Request content/tools/approval/effort are untouched; caller owns policy.
+    """
+    if type(request) is not dict:
+        raise BudgetError("invalid_final_wire_request")
+    if wire_format not in {"chat_completions", "chat_max_tokens", "chat_max_completion_tokens",
+                            "responses", "anthropic_messages", "gemini_generate_content", "bedrock_converse"}:
+        raise BudgetError("unbounded_wire_format_unsupported")
+    result = deepcopy(request)
+    constraints = []
+    containers = [result]
+    if isinstance(result.get("extra_body"), dict):
+        containers.append(result["extra_body"])
+    for value in containers:
+        if wire_format == "anthropic_messages":
+            if "max_tokens" in value:
+                cap = value["max_tokens"]
+                constraints.append(("max_tokens", cap if type(cap) is int and cap >= 0 else None))
+            thinking = value.get("thinking")
+            if isinstance(thinking, dict) and thinking.get("type") == "enabled" and "budget_tokens" in thinking:
+                cap = thinking["budget_tokens"]
+                constraints.append(("thinking.budget_tokens", cap if type(cap) is int and cap >= 0 else None))
+        elif wire_format == "bedrock_converse":
+            inference = value.get("inferenceConfig")
+            if isinstance(inference, dict):
+                inference.pop("maxTokens", None)
+            extra = value.get("additionalModelRequestFields")
+            if isinstance(extra, dict):
+                thinking = extra.get("thinking")
+                if isinstance(thinking, dict) and thinking.get("type") == "enabled" and "budget_tokens" in thinking:
+                    cap = thinking["budget_tokens"]
+                    constraints.append(("thinking.budget_tokens", cap if type(cap) is int and cap >= 0 else None))
+        elif wire_format == "gemini_generate_content":
+            generation = value.get("generationConfig")
+            if isinstance(generation, dict):
+                generation.pop("maxOutputTokens", None)
+                thinking = generation.get("thinkingConfig")
+                if isinstance(thinking, dict):
+                    thinking.pop("thinkingBudget", None)
+        else:
+            for key in ("max_tokens", "max_completion_tokens", "max_output_tokens"):
+                value.pop(key, None)
+    return result, tuple(constraints)
