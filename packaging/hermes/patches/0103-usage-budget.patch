+++ b/agent/usage_budget_entrypoints.py
@@ -0,0 +1,264 @@
+"""Candidate native ingress bridges; no model-controlled policy or new planner.
+
+The authenticated host freezes a preference before it starts a worker. A policy
+resolver must be installed by reviewed native host code for that exact profile;
+neither a preference packet nor a model reply can supply capacities/evidence.
+Levels 1--4 need reviewed host route/reference assembly. Levels 5 and 6 can
+freeze lineage without invented numeric limits; removing a native limit at
+level 6 is separately enforced by the final-wire and loop adapters.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager, nullcontext
+from functools import wraps
+import hashlib
+import json
+import os
+from pathlib import Path
+from threading import RLock
+import uuid
+
+from agent.usage_budget import BudgetError, NormalBudget, VerifiedModelLimits, resolve_policy
+from agent.usage_budget_runtime import capture_origin, get_runtime, bind_origin
+
+
+_RESOLVERS = {}
+_RESOLVER_LOCK = RLock()
+
+
+def _profile_key(profile_root):
+    # Store validation still rejects links/reparse points; resolving them here
+    # would convert an untrusted alias into an apparently trusted path.
+    return os.path.normcase(os.path.normpath(str(Path(profile_root))))
+
+
+def register_host_policy_resolver(profile_root, resolver):
+    """Internal native assembly seam, never registered as an RPC or tool."""
+    if not callable(resolver):
+        raise BudgetError("invalid_policy_resolver")
+    runtime = get_runtime(profile_root)
+    with _RESOLVER_LOCK:
+        key = _profile_key(runtime.store.profile_root)
+        if key in _RESOLVERS and _RESOLVERS[key] is not resolver:
+            raise BudgetError("policy_resolver_already_bound")
+        _RESOLVERS[key] = resolver
+
+
+def accept_native_origin(profile_root, turn_id, *, kind="human", inherited=None):
+    """Freeze at trusted admission, before queue waits or lazy agent setup."""
+    if kind not in {"human", "resume", "continuation"}:
+        raise BudgetError("invalid_origin_kind")
+    runtime = get_runtime(profile_root)
+    if kind == "resume":
+        return runtime.resume_origin(turn_id)
+    if kind == "continuation" and inherited is not None:
+        if inherited._owner is not runtime:
+            raise BudgetError("origin_profile_mismatch")
+        if runtime.resume_origin(inherited.origin_id) is not inherited:
+            raise BudgetError("invalid_origin_handle")
+        return inherited
+    if kind != "human":
+        if runtime.store.get().level == 5:
+            return None
+        raise BudgetError("origin_context_missing")
+    return runtime.accept_new_origin(turn_id)
+
+
+def bind_native_origin(accepted, *, resolver=None):
+    """Bind a trusted route policy once, using the already accepted revision.
+
+    The explicit resolver is host-owned assembly for the selected route, never
+    numeric data supplied by a request. Existing profile registration is a
+    compatibility fallback. Rebinding cannot change an already issued ledger.
+    """
+    from agent.usage_budget_runtime import AcceptedOrigin, OriginBudgetHandle
+    if accepted is None:
+        return None
+    if type(accepted) is OriginBudgetHandle:
+        accepted._owner._validate(accepted)
+        return accepted
+    if type(accepted) is not AcceptedOrigin:
+        raise BudgetError("invalid_origin_ticket")
+    if resolver is None:
+        with _RESOLVER_LOCK:
+            resolver = _RESOLVERS.get(_profile_key(accepted._owner.store.profile_root))
+    def resolve_frozen(preference):
+        if resolver is None and preference.level in (5, 6):
+            return resolve_policy(preference.level, NormalBudget(), VerifiedModelLimits(),
+                                  version=preference.revision)
+        if resolver is None:
+            raise BudgetError("policy_capabilities_unavailable")
+        policy = resolver(preference)
+        if policy.unresolved and preference.level in (1, 2, 3, 4):
+            raise BudgetError("policy_capabilities_unavailable")
+        return policy
+    return accepted._owner.bind_accepted_origin(accepted, resolve_frozen)
+
+
+def freeze_native_origin(profile_root, turn_id, *, kind, inherited=None, resolver=None):
+    """Compatibility admission+binding for already resolved immediate ingress."""
+    return bind_native_origin(accept_native_origin(
+        profile_root, turn_id, kind=kind, inherited=inherited), resolver=resolver)
+
+
+def bind_native_agent_origin(accepted, agent):
+    """Product Workbench/compute bind against the actual constructed agent.
+
+    A later child or continuation never reassembles its parent's policy. This
+    path does not depend on a test-installed callback or a profile-global model.
+    """
+    from agent.usage_budget_runtime import AcceptedOrigin
+    if type(accepted) is AcceptedOrigin and accepted._state.handle is None:
+        from agent.usage_budget_host_policy import build_host_policy_resolver
+        return bind_native_origin(accepted, resolver=build_host_policy_resolver(agent))
+    return bind_native_origin(accepted)
+
+
+@contextmanager
+def manual_native_operation(profile_root, agent, *, operation):
+    """Host-only manual paid operation; automatic work keeps its origin.
+
+    The caller must be an authenticated native command/RPC, never a model tool
+    offering an arbitrary new allowance. Pending compute transfers are bound
+    against the child agent, without rereading the accepted preference.
+    """
+    from agent.usage_budget_runtime import current_accepted_origin
+    if operation not in {"compression", "oneshot"}:
+        raise BudgetError("invalid_manual_operation")
+    inherited = capture_origin()
+    accepted = inherited or current_accepted_origin()
+    if accepted is None:
+        accepted = accept_native_origin(profile_root, "manual-" + uuid.uuid4().hex)
+    if _profile_key(accepted._owner.store.profile_root) != _profile_key(profile_root):
+        raise BudgetError("origin_profile_mismatch")
+    handle = bind_native_agent_origin(accepted, agent)
+    owns_completion = inherited is None
+    previous = getattr(agent, "_usage_budget_handle", None)
+    if operation == "compression":
+        agent._usage_budget_handle = handle
+    try:
+        with native_origin_scope(handle):
+            yield handle
+    except BaseException:
+        if owns_completion:
+            stop_origin(handle)
+        raise
+    finally:
+        if operation == "compression":
+            agent._usage_budget_handle = previous
+        if owns_completion:
+            complete_primary(handle)
+
+
+def accept_gateway_event(profile_root, event, source, *, is_internal):
+    """Called only after native platform authorization, never on public metadata."""
+    from agent.usage_budget_runtime import AcceptedOrigin, OriginBudgetHandle
+    runtime = get_runtime(profile_root)
+    inherited = getattr(event, "_usage_budget_origin", None)
+    if inherited is not None:
+        if type(inherited) is not OriginBudgetHandle or inherited._owner is not runtime:
+            raise BudgetError("origin_profile_mismatch")
+        runtime._validate(inherited)
+        if getattr(event, "_usage_budget_execution_complete", False) and not is_internal:
+            raise BudgetError("origin_replay_completed")
+        return inherited
+    accepted = getattr(event, "_usage_budget_accepted", None)
+    if accepted is not None:
+        if (type(accepted) is not AcceptedOrigin or accepted._owner is not runtime
+                or runtime._accepted.get(accepted.origin_id) is not accepted):
+            raise BudgetError("foreign_origin_ticket")
+        return accepted
+    if is_internal:
+        # A background event without its actual owner cannot borrow a current
+        # unrelated turn or mint new credit, including after process restart.
+        return accept_native_origin(profile_root, "unowned-internal-event", kind="continuation")
+    message_id = getattr(event, "message_id", None)
+    if message_id is None:
+        origin_id = "gateway-" + uuid.uuid4().hex
+    else:
+        platform = getattr(source, "platform", None)
+        identity = [str(getattr(platform, "value", platform)),
+                    str(getattr(source, "chat_id", "")), str(getattr(source, "user_id", "")),
+                    str(message_id)]
+        origin_id = "gateway-" + hashlib.sha256(json.dumps(identity, ensure_ascii=True).encode()).hexdigest()
+    accepted = runtime.accept_new_origin(origin_id)
+    event._usage_budget_accepted = accepted
+    return accepted
+
+
+def copy_gateway_acceptance(source_event, target_event):
+    """Host-only event rewrite/queue copy; these fields never enter metadata."""
+    for key in ("_usage_budget_accepted", "_usage_budget_origin"):
+        value = getattr(source_event, key, None)
+        if value is not None:
+            setattr(target_event, key, value)
+
+
+def same_gateway_preference(first, second):
+    def preference(event):
+        value = getattr(event, "_usage_budget_origin", None) or getattr(event, "_usage_budget_accepted", None)
+        return value.preference if value is not None else None
+    return preference(first) == preference(second)
+
+@contextmanager
+def native_origin_scope(handle):
+    """Bind only the issued economy lineage; do not copy execution authority."""
+    if handle is None:
+        if capture_origin() is not None:
+            raise BudgetError("origin_context_conflict")
+        yield None
+        return
+    with bind_origin(handle):
+        yield handle
+
+
+def require_native_origin_for_conversation():
+    """Catch an unintegrated entry instead of silently bypassing a strict cap."""
+    handle = capture_origin()
+    from agent.usage_budget_runtime import current_accepted_origin
+    accepted = current_accepted_origin()
+    if accepted is not None and (handle is None or accepted._state.handle is not handle):
+        raise BudgetError("origin_context_missing")
+    if handle is not None:
+        return handle
+    from agent.identity_policy import identity_lock_required_by_host
+    if identity_lock_required_by_host():
+        from hermes_cli.config import get_hermes_home
+        if get_runtime(get_hermes_home()).store.get().level != 5:
+            raise BudgetError("origin_context_missing")
+    return None
+
+
+def budgeted_conversation(callback):
+    """Wrap the *whole* native prologue/loop/finalizer without a second loop."""
+    @wraps(callback)
+    def invoke(*args, **kwargs):
+        handle = require_native_origin_for_conversation()
+        agent = args[0] if args else kwargs.get("agent")
+        missing = object()
+        previous = getattr(agent, "_usage_budget_handle", missing)
+        if previous is not missing and previous is not None and previous is not handle:
+            raise BudgetError("origin_context_conflict")
+        writable_agent = hasattr(agent, "__dict__")
+        if writable_agent:
+            agent._usage_budget_handle = handle
+        try:
+            with bind_origin(handle) if handle is not None else nullcontext():
+                return callback(*args, **kwargs)
+        finally:
+            if writable_agent:
+                if previous is missing:
+                    del agent._usage_budget_handle
+                else:
+                    agent._usage_budget_handle = previous
+    return invoke
+
+
+def complete_primary(handle):
+    if handle is not None:
+        handle._owner.complete_primary(handle.origin_id)
+
+
+def stop_origin(handle):
+    if handle is not None:
+        handle._owner.stop_origin(handle.origin_id)
