+"""Run actual candidate classifiers/file-tool guards with synthetic host paths.
+
+No native module initialization, file writes, shell execution, provider calls or
+player profile reads. Static command classification is not an OS security claim.
+"""
+import ast
+import os
+from pathlib import Path
+import re
+import shlex
+import sys
+from types import ModuleType
+import unicodedata
+import unittest
+from unittest.mock import patch
+
+
+OVERLAY = Path(__file__).parents[1]
+
+
+def extract(file, functions, constants=()):
+    tree = ast.parse(file.read_text(encoding="utf-8"))
+    body = [ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0)]
+    for node in tree.body:
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in functions:
+            body.append(node)
+        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id in constants for t in node.targets):
+            body.append(node)
+    module = ModuleType("synthetic_budget_tool_classifiers")
+    module.__dict__.update(os=os, re=re, shlex=shlex, unicodedata=unicodedata)
+    exec(compile(ast.fix_missing_locations(ast.Module(body=body, type_ignores=[])), str(file), "exec"), module.__dict__)
+    return module
+
+
+class ToolOwnershipTests(unittest.TestCase):
+    def setUp(self):
+        self.profile = str(OVERLAY / "uncreated-synthetic-profile")
+        identity = ModuleType("agent.identity_policy")
+        identity.IdentityPolicyError = ValueError
+        def required():
+            value = os.environ.get("HERMES_IDENTITY_REQUIRED")
+            if value is None: return False
+            if value != "1": raise ValueError("malformed_required_host")
+            return True
+        identity.identity_lock_required_by_host = required
+        modules = patch.dict(sys.modules, {"agent.identity_policy": identity})
+        modules.start(); self.addCleanup(modules.stop)
+        environment = patch.dict(os.environ, {"HERMES_IDENTITY_REQUIRED": "1", "HERMES_HOME": self.profile})
+        environment.start(); self.addCleanup(environment.stop)
+        self.approval = extract(OVERLAY / "tools" / "approval.py", {
+            "_strict_authority_home", "_strict_authority_targets", "_strict_path_key",
+            "strict_identity_authority_path_label", "_expand_strict_authority_command_paths",
+            "_strict_authority_operand_label", "_strict_mutation_command_tokens",
+            "strict_identity_authority_command_mutation", "strict_identity_authority_block_result",
+            "_shell_segment_tokens", "_iter_top_level_shell_segments",
+        }, {"_STRICT_AUTHORITY_RELATIVE_PATHS", "_STRICT_ECONOMIC_TEMP_LABEL", "_STRICT_AUTHORITY_SENTINELS",
+            "_COMMAND_WRAPPER_WORDS", "_ENV_ASSIGNMENT_RE"})
+        self.file_tools = extract(OVERLAY / "tools" / "file_tools.py", {
+            "_check_strict_identity_authority_path", "write_file_tool", "patch_tool"})
+        self.file_tools._uses_container_paths = lambda task: False
+        self.file_tools._check_sensitive_path = lambda value, task: None
+        self.file_tools._resolve_path_for_task = lambda value, task: Path(self.profile) / value if not os.path.isabs(value) else Path(value)
+        self.file_tools.tool_error = lambda value: {"error": value}
+        operations = ModuleType("tools.path_security")
+        operations.has_traversal_component = lambda value: ".." in value.replace("\\", "/").split("/")
+        bindings = patch.dict(sys.modules, {"tools.approval": self.approval, "tools.path_security": operations})
+        bindings.start(); self.addCleanup(bindings.stop)
+
+    def path(self, name):
+        return os.path.join(self.profile, name)
+
+    def classify(self, command):
+        return self.approval.strict_identity_authority_command_mutation(command, cwd=self.profile)
+
+    def test_exact_state_lock_and_atomic_namespace_are_protected(self):
+        for name in (".lilith-usage-budget.json", ".lilith-usage-budget.lock",
+                     ".lilith-usage-budget.sqlite3", ".lilith-usage-budget.sqlite3-journal",
+                     ".lilith-usage-budget-" + "a" * 32 + ".tmp",
+                     ".lilith-usage-budget-" + "a" * 32 + ".tmp-journal"):
+            with self.subTest(name=name):
+                self.assertIsNotNone(self.approval.strict_identity_authority_path_label(name, cwd=self.profile))
+                self.assertIsNotNone(self.approval.strict_identity_authority_path_label(
+                    self.path("nested/../" + name), cwd=self.profile))
+                if os.name == "nt":
+                    self.assertIsNotNone(self.approval.strict_identity_authority_path_label(self.path(name).upper()))
+
+    def test_unrelated_files_and_similar_names_outside_profile_stay_allowed(self):
+        for path in (self.path("notes.json"), self.path(".lilith-usage-budget-help.txt"),
+                     self.path(".lilith-usage-budget-not-a-transaction.tmp"),
+                     str(OVERLAY / "elsewhere" / ".lilith-usage-budget.json"),
+                     self.path("nested/.lilith-usage-budget-" + "a" * 32 + ".tmp")):
+            self.assertIsNone(self.approval.strict_identity_authority_path_label(path), path)
+
+    def test_terminal_write_delete_move_and_redirection_are_non_approvable(self):
+        for name in (".lilith-usage-budget.json", ".lilith-usage-budget.lock",
+                     ".lilith-usage-budget.sqlite3", ".lilith-usage-budget.sqlite3-journal",
+                     ".lilith-usage-budget-" + "b" * 32 + ".tmp",
+                     ".lilith-usage-budget-" + "b" * 32 + ".tmp-journal"):
+            target = self.path(name).replace("\\", "/")
+            for command in (f'Set-Content "{target}" x', f'Remove-Item "{target}"',
+                            f'mv "{target}" other', f'echo x > "{target}"',
+                            f'Copy-Item input -Destination "{target}"',
+                            f'[IO.File]::WriteAllText("{target}", "x")'):
+                with self.subTest(command=command):
+                    label = self.classify(command)
+                    self.assertIsNotNone(label)
+                    decision = self.approval.strict_identity_authority_block_result(command, label)
+                    self.assertFalse(decision["approved"]); self.assertTrue(decision["hard_denied"])
+
+    def test_reads_unrelated_commands_and_generic_host_unchanged(self):
+        target = self.path(".lilith-usage-budget.json").replace("\\", "/")
+        self.assertIsNone(self.classify(f'Get-Content "{target}"'))
+        self.assertIsNone(self.classify(f'Copy-Item "{target}" "other.txt"'))
+        self.assertIsNone(self.classify('Set-Content notes.txt hello'))
+        with patch.dict(os.environ):
+            os.environ.pop("HERMES_IDENTITY_REQUIRED", None)
+            self.assertIsNone(self.classify(f'Remove-Item "{target}"'))
+
+    def test_malformed_host_marker_never_downgrades_file_mutation(self):
+        with patch.dict(os.environ, {"HERMES_IDENTITY_REQUIRED": "0"}):
+            denied = self.file_tools.write_file_tool(self.path(".lilith-usage-budget.json"), "untrusted")
+            self.assertIn("not be verified", denied["error"])
+
+    def test_host_variable_and_parent_delete_are_classified(self):
+        self.assertIsNotNone(self.classify('Remove-Item "$env:HERMES_HOME/.lilith-usage-budget.json"'))
+        self.assertIsNotNone(self.classify(f'Remove-Item -Recurse "{self.profile.replace(chr(92), "/")}"'))
+
+    def test_actual_write_file_and_patch_delete_move_return_before_write(self):
+        for name in (".lilith-usage-budget.json", ".lilith-usage-budget.lock",
+                     ".lilith-usage-budget.sqlite3", ".lilith-usage-budget.sqlite3-journal"):
+            target = self.path(name)
+            denied = self.file_tools.write_file_tool(target, "untrusted", cross_profile=True)
+            self.assertIn("cannot be approved", denied["error"])
+            denied = self.file_tools.patch_tool(path=target, old_string="old", new_string="new", cross_profile=True)
+            self.assertIn("error", denied)
+            for statement in (f"*** Delete File: {target}", f"*** Move File: {target} -> other.txt",
+                              f"*** Move File: other.txt -> {target}"):
+                denied = self.file_tools.patch_tool(mode="patch", patch=statement, cross_profile=True)
+                self.assertIn("error", denied)
+
+    def test_economic_paths_do_not_extend_native_attestation_hashing(self):
+        # Protection extends only the tool classifier. The policy setter and
+        # store remain independent of native config/identity digests.
+        source = (OVERLAY / "agent" / "usage_budget_store.py").read_text(encoding="utf-8")
+        self.assertNotIn("commit_host_config_digest_rotation", source)
+        self.assertNotIn("capture_strict_native_authority", source)
+
+
+if __name__ == "__main__":
+    unittest.main()
