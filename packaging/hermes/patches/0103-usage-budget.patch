+            event = {"type": "response.completed", "response": response}
+            return httpx.Response(200, content=("data: " + json.dumps(event) + "\n\n").encode(),
+                                  headers={"Content-Type": "text/event-stream"})
+        client = openai.OpenAI(api_key="synthetic-offline-key", base_url=base, max_retries=0,
+            http_client=httpx.Client(transport=httpx.MockTransport(handle), trust_env=False))
+        self.addCleanup(client.close)
+        return client
+
+    def test_actual_responses_body_and_terminal_usage_for_1_5_6(self):
+        sent = []
+        client = self.responses_client(sent)
+        for level in (1, 5, 6, 5):
+            ledger = TurnBudgetLedger("responses-fixture", replace(budget(level).policy, strict=False))
+            request = {"model": "synthetic-model", "input": "fixture", "stream": True, "max_output_tokens": 2000}
+            with bind_turn_budget(ledger):
+                result = native_dispatch_sync(client, request, lambda value: client.responses.create(**value),
