+        for fields, expected in (({"max_tokens": 123}, 123), ({"max_tokens": 2000}, 1000),
+                                 ({"max_tokens": 123, "max_completion_tokens": 123}, 123)):
+            request = {"model": "synthetic-model", "messages": [], **fields}
