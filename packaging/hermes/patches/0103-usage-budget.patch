+class ContinuationProgress:
+    """Bound no-progress recovery, not successful level-6 output continuations.
+
+    This is evidence of new visible text, not proof of semantic task progress.
+    Only hashes and the last visible chunk are held, for this origin turn only.
+    """
+    def __init__(self):
