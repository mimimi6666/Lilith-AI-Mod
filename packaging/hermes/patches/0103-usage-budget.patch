+                return error.code
+        with ThreadPoolExecutor(max_workers=12) as pool:
+            results = list(pool.map(admit, range(12)))
+        self.assertEqual(1, results.count("admitted"))
+        self.assertEqual(11, results.count("origin_already_admitted"))
+        self.assertEqual(1, len(resolve_count))
+        self.assertEqual(1, len(active_owners))
+
+    def test_normal_unknown_resume_after_last_owner_releases_handle_fails_closed(self):
+        handle = self.runtime.admit_new_origin("completed-normal", resolver)
+        self.runtime.complete_primary("completed-normal")
+        del handle
+        gc.collect()
+        self.assertCode("origin_resume_unavailable", lambda: self.runtime.resume_origin("completed-normal"))
+        self.preference_revision_after_cleanup = self.store.set(PreferenceUpdate("strict", 0, 1))
+        self.assertCode("origin_resume_unavailable", lambda: self.runtime.resume_origin("completed-normal"))
+
+    def test_host_resolver_must_match_exact_saved_level_and_revision(self):
+        self.store.set(PreferenceUpdate("level-1", 0, 1))
+        self.assertCode("origin_policy_mismatch", lambda: self.runtime.admit_new_origin(
+            "wrong", lambda _: resolver(UsagePreference())))
+        self.assertCode("origin_resume_unavailable", lambda: self.runtime.resume_origin("wrong"))
+
+    def test_profile_singleton_is_stable_but_other_profiles_are_separate(self):
+        self.assertIs(get_runtime(self.profile), get_runtime(str(self.profile)))
+        second = self.profile / "other-profile"
+        second.mkdir()
+        self.assertIsNot(get_runtime(self.profile), get_runtime(second))
+
+    def test_foreign_or_forged_handle_cannot_replace_issued_handle(self):
+        handle = self.runtime.admit_new_origin("turn-1", resolver)
+        changed = replace(handle, generation_id="other-generation")
+        self.assertCode("foreign_origin_handle", lambda: run_in_origin(changed, lambda: None))
+        changed = replace(handle, origin_id="unknown")
+        self.assertCode("origin_resume_unavailable", lambda: run_in_origin(changed, lambda: None))
+        other = UsageBudgetRuntime(self.store).admit_new_origin("turn-2", resolver)
+        with bind_origin(handle):
+            self.assertCode("origin_budget_replacement_forbidden", lambda: run_in_origin(other, lambda: None))
+
+    def test_handle_is_immutable_and_context_clears_on_exception(self):
+        handle = self.runtime.admit_new_origin("turn-1", resolver)
+        with self.assertRaises(FrozenInstanceError):
+            handle.preference = UsagePreference(1, 6)
+        with self.assertRaises(RuntimeError):
+            with bind_origin(handle):
+                self.assertIs(handle, require_origin())
+                raise RuntimeError("fixture")
+        self.assertIsNone(capture_origin())
+        self.assertIsNone(current_turn_budget())
+        self.assertCode("origin_context_missing", require_origin)
+
+
+if __name__ == "__main__":
+    unittest.main()
