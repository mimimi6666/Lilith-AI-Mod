+def _worker():
+    if len(sys.argv) != 6 or sys.argv[1] not in {"--writer", "--origin-worker"}:
+        raise SystemExit("invalid_fixture_worker")
+    root = Path(os.environ["LILITH_BUDGET_TEST_ROOT"]).resolve(strict=True)
+    profile = Path(sys.argv[2]).resolve(strict=True)
+    if profile == root or not profile.is_relative_to(root) or not profile.name.startswith("budget-store-"):
+        raise SystemExit("fixture_worker_scope_rejected")
+    try:
+        store = UsageBudgetStore(profile)
+        if sys.argv[1] == "--writer":
+            result = store.set(PreferenceUpdate(sys.argv[3], int(sys.argv[4]), int(sys.argv[5])))
+            print(json.dumps({"status": "committed", "revision": result.current.revision, "replay": result.replay}))
+            return
+        action, origin, token = sys.argv[3:6]
+        if action == "claim":
+            store.claim_origin(origin, "worker")
+            print(json.dumps({"status": "claimed"}))
+        elif action == "redeem":
+            preference = store.redeem_origin(origin, "worker", token)
+            print(json.dumps({"status": "redeemed", "revision": preference.revision, "level": preference.level}))
+        elif action in {"crash_setting_before", "crash_setting_after", "crash_origin_after"}:
+            original = UsageBudgetStore._commit
+            def crash(connection):
+                if action.endswith("before"):
+                    os._exit(71)
+                original(connection)
+                os._exit(72)
+            with patch.object(UsageBudgetStore, "_commit", staticmethod(crash)):
+                if action.startswith("crash_origin"):
+                    store.claim_origin(origin, "worker")
+                else:
+                    store.set(PreferenceUpdate(origin, 0, 2))
+        else:
+            raise SystemExit("invalid_fixture_action")
+    except PreferenceError as error:
+        print(json.dumps({"status": str(error)}))
