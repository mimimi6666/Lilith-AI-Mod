+def module(name, **values):
+    result = ModuleType(name)
+    result.__dict__.update(values)
+    return result
+
+
+class BedrockClient(FakeClient):
+    def __init__(self):
+        super().__init__()
+        self.meta = SimpleNamespace(config=SimpleNamespace(retries={"total_max_attempts": 1}),
+            endpoint_url="https://bedrock-runtime.us-east-1.amazonaws.com")
+        self.events = [{"metadata": {"usage": {"inputTokens": 70, "cacheReadInputTokens": 20,
+                                              "cacheWriteInputTokens": 10, "outputTokens": 50}}}]
+    def converse(self, **request):
+        self.calls.append(request)
+        return {"usage": self.events[-1]["metadata"]["usage"], "answer": "ok"}
+    def converse_stream(self, **request):
+        self.calls.append(request)
+        return {"stream": FakeStream(self.events), "ResponseMetadata": {"fixture": True}}
+
+
+class ProviderRouteTests(unittest.TestCase):
+    def test_known_image_counter_shadows_only_payload_and_keeps_cjk_tools_system(self):
+        from agent.usage_budget_official_routes import estimate_final_input
+        def native_rough(text):
+            dense = len(re.findall(r"[\u2e80-\u9fff]", text))
+            return dense + (len(text) - dense + 3) // 4
+        metadata = module("agent.model_metadata", estimate_tokens_rough=native_rough)
+        forms = [
+            lambda payload: {"messages": [{"role": "user", "content": [
+                {"type": "text", "text": "請分析這張照片"}, {"type": "image_url", "image_url": {"url": "data:image/png;base64," + payload}}]}]},
+            lambda payload: {"input": [{"role": "user", "content": [{"type": "input_image", "image_url": "data:image/png;base64," + payload}]}]},
+            lambda payload: {"messages": [{"role": "user", "content": [{"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": payload}}]}]},
+            lambda payload: {"contents": [{"parts": [{"inlineData": {"mimeType": "image/png", "data": payload}}]}]},
+            lambda payload: {"messages": [{"role": "user", "content": [{"image": {"format": "png", "source": {"bytes": payload.encode()}}}]}]},
+        ]
+        with patch.dict(sys.modules, {"agent.model_metadata": metadata}):
+            for make in forms:
+                small, large = make("A" * 40), make("A" * 4000000)
+                small_count, large_count = estimate_final_input(small), estimate_final_input(large)
+                self.assertEqual(small_count, large_count)
+                self.assertFalse(large_count.exact)
+                self.assertGreaterEqual(large_count.tokens, 1500)
+                self.assertLess(large_count.tokens, 2000)
+                enriched = {**large, "system": "保留系統內容" * 100, "tools": [{"description": "完整工具定義" * 100}]}
+                self.assertGreater(estimate_final_input(enriched).tokens, large_count.tokens + 1000)
+                self.assertEqual(make("A" * 4000000), large)
+            cjk = estimate_final_input({"messages": [{"content": "中" * 400}]}).tokens
+            ascii_ = estimate_final_input({"messages": [{"content": "a" * 400}]}).tokens
+            self.assertGreater(cjk, ascii_ + 250)
+            # Unknown media is not silently dropped as an image placeholder.
+            self.assertGreater(estimate_final_input({"contents": [{"parts": [{"inlineData": {
+                "mimeType": "audio/wav", "data": "A" * 400000}}]}]}).tokens, 99000)
