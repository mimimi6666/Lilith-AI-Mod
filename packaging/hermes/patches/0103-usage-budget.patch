+    def continuation_gate(self, name, *, level):
+        target = "_allow_" + name + "_continuation"
+        initial = next(node for node in ast.walk(self.run_node) if isinstance(node, ast.Assign)
+                       and isinstance(node.value, ast.Compare)
+                       and any(isinstance(t, ast.Name) and t.id == target for t in node.targets))
+        conditional = next(node for node in ast.walk(self.run_node) if isinstance(node, ast.If)
+                           and isinstance(node.test, ast.Name) and node.test.id == "_unlimited_iterations"
+                           and any(isinstance(child, ast.Assign) and any(isinstance(t, ast.Name) and t.id == target
+                               for t in child.targets) for child in node.body))
+        namespace = {"_unlimited_iterations": level == 6,
+                     "ContinuationProgress": ContinuationProgress,
+                     "_unlimited_length_progress": ContinuationProgress(),
+                     "_unlimited_codex_progress": ContinuationProgress(),
+                     "agent": SimpleNamespace(_strip_think_blocks=lambda text: text, _codex_incomplete_retries=0),
+                     "assistant_message": SimpleNamespace(content=""),
+                     "response": SimpleNamespace(id="fixture-success"), "PARTIAL_STREAM_STUB_ID": "fixture-stub",
+                     "continuation_transport_ok": continuation_transport_ok, "_cf_terminated": False}
+        code = compile(ast.Module(body=[initial, conditional], type_ignores=[]), "actual-" + name + "-continuation", "exec")
+        def invoke(attempt, content, response=None):
+            namespace["length_continue_retries"] = attempt
+            namespace["agent"]._codex_incomplete_retries = attempt
+            namespace["assistant_message"].content = content
+            if response is not None:
+                namespace["response"] = response
+            exec(code, namespace)
+            return namespace[target]
+        return invoke
