+    ],
+)
+def test_native_client_rejects_unknown_response_format_before_http(
+    monkeypatch,
+    response_format,
+):
+    from agent.gemini_native_adapter import GeminiNativeClient
+
+    calls = []
+
+    class DummyHTTP:
+        def post(self, *args, **kwargs):
+            calls.append((args, kwargs))
