+def _normalize_response_format(config: Any) -> Optional[Dict[str, Any]]:
+    """Translate the existing OpenAI-shaped structured-output envelope.
+
+    The native Gemini transport must not silently discard a response format
+    that the shared host already accepted. Unknown or malformed shapes fail
+    closed so callers can use their explicit fallback policy.
+    """
+
+    if config is None:
+        return None
+    if not isinstance(config, dict):
+        raise ValueError("Gemini response_format must be an object")
+    format_type = config.get("type")
+    if format_type == "json_object":
+        return {"mime_type": "application/json", "json_schema": None}
+    if format_type != "json_schema":
+        raise ValueError("Gemini response_format has an unsupported type")
+    envelope = config.get("json_schema")
+    if not isinstance(envelope, dict):
+        raise ValueError("Gemini json_schema response_format must contain an object")
+    schema = envelope.get("schema")
+    if not isinstance(schema, dict):
+        raise ValueError("Gemini json_schema response_format must contain a schema object")
+    return {
+        "mime_type": "application/json",
+        "json_schema": copy.deepcopy(schema),
+    }
+
+
