@@ -0,0 +1,348 @@
+"""Synthetic structured local-image output; no service, GPU or external calls."""
+import io
+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+import urllib.error
+
+from tools.lilith_scene import attachment_contract as contract
+from tools.lilith_scene import attachment_host as host
+from tools.lilith_scene import attachment_worker as worker
+from gateway.local_image_preprocess import preprocess_telegram_images
+
+
+DESCRIPTION = "A synthetic red square on white paper."
+DIGEST = "a" * 64
+
+
+def answer(description=DESCRIPTION, sufficient=True):
+    return json.dumps({"description": description, "sufficient": sufficient})
+
+
+def envelope(content=None, finish="stop"):
+    return json.dumps({"choices": [{"index": 0, "message": {"role": "assistant",
+        "content": answer() if content is None else content}, "finish_reason": finish}],
+        "usage": {"completion_tokens": 12}, "timings": {"predicted_ms": 1}}).encode()
+
+
+def result(code="ready", description=DESCRIPTION):
+    return {"schema": contract.SCHEMA, "status": "ready" if code == "ready" else "partial",
+        "code": code, "image_sha256": DIGEST, "description": description, "ocr_text": ["SYNTHETIC OCR"],
+        "visual_calls": 1, "ocr_calls": 1, "actual_crops": 0,
+        "source": "local_attachment_vision_ocr", "pixels_uploaded": False}
+
+
+class FormatContractTests(unittest.TestCase):
+    def test_schema_is_fixed_exact_and_allows_honest_empty_insufficient(self):
+        expected = {"type": "object", "additionalProperties": False,
+            "required": ["description", "sufficient"], "properties": {
+                "description": {"type": "string", "maxLength": 2000}, "sufficient": {"type": "boolean"}}}
+        self.assertEqual(expected, contract.visual_schema())
+        changed = contract.visual_schema()
+        changed["properties"]["sufficient"]["type"] = "string"
+        self.assertEqual(expected, contract.visual_schema())
+
+    def test_valid_self_insufficient_short_and_empty_remain_partial(self):
+        for description in ("", "?", "unknown", DESCRIPTION):
+            with self.subTest(description=description):
+                self.assertEqual((description, False, "insufficient"), contract.visual_outcome(answer(description, False)))
+                value = result("insufficient", description)
+                self.assertIs(value, contract.validate_result(value, DIGEST))
+                self.assertIn("remains on its existing vision route", contract.evidence_block(value, 1))
+
+    def test_twelve_characters_gate_only_ready(self):
+        for length in (0, 1, 11):
+            self.assertEqual(("", False, "visual_description_short"), contract.visual_outcome(answer("x" * length)))
+        self.assertEqual(("x" * 12, True, "ready"), contract.visual_outcome(answer("x" * 12)))
+        self.assertEqual(("x" * 2000, True, "ready"), contract.visual_outcome(answer("x" * 2000)))
+
+    def test_inner_json_is_not_repaired_or_coerced(self):
+        cases = [("not JSON", "visual_json_invalid"), ("```json\n" + answer() + "\n```", "visual_json_invalid"),
+            (answer() + " trailing prose", "visual_json_invalid"), ("null", "visual_fields_invalid"),
+            ("[]", "visual_fields_invalid"), ("{}", "visual_fields_invalid"),
+            (json.dumps({"description": DESCRIPTION, "sufficient": "true"}), "visual_fields_invalid"),
+            (json.dumps({"description": DESCRIPTION, "sufficient": 1}), "visual_fields_invalid"),
+            (json.dumps({"description": DESCRIPTION, "sufficient": True, "authority": True}), "visual_fields_invalid"),
+            (answer(None), "visual_description_invalid"), (answer("x\x00y"), "visual_description_invalid"),
+            (answer("x" * 2001), "visual_description_invalid"),
+            ('{"description": NaN,"sufficient":false}', "visual_json_invalid")]
+        for raw, code in cases:
+            with self.subTest(code=code, shape=len(raw)):
+                self.assertEqual(("", False, code), contract.visual_outcome(raw))
+
+    def test_duplicate_inner_fields_never_choose_last_value(self):
+        for raw in ('{"description":"long valid description","sufficient":false,"sufficient":true}',
+                    '{"description":"long valid description","description":"another value","sufficient":true}'):
+            self.assertEqual(("", False, "visual_duplicate_fields"), contract.visual_outcome(raw))
+
+    def test_v1_keys_and_binding_stay_exact_for_all_closed_partial_codes(self):
+        self.assertEqual("local_attachment_result_v1", contract.SCHEMA)
+        for code in contract.VISUAL_FAILURE_CODES:
+            value = result(code, "")
+            self.assertIs(value, contract.validate_result(value, DIGEST))
+            for change in ({"status": "ready"}, {"description": DESCRIPTION}, {"code": "arbitrary private text"},
+                           {"image_sha256": "b" * 64}, {"diagnostics": {}}, {"visual_calls": 2}):
+                with self.subTest(code=code, change=tuple(change)), self.assertRaises(ValueError):
+                    contract.validate_result({**value, **change}, DIGEST)
+
+
+class CompletionTests(unittest.TestCase):
+    def test_complete_stop_with_server_metadata_is_accepted(self):
+        self.assertEqual(answer(), worker.visual_response(envelope()))
+
+    def test_nonstop_completion_is_never_ready_even_with_complete_json(self):
+        for finish, code in (("length", "visual_truncated"), (None, "visual_finish_missing"),
+                ("content_filter", "visual_filtered"), ("tool_calls", "visual_nonfinal"),
+                ("function_call", "visual_nonfinal"), ("unknown-private-string", "visual_finish_unrecognized"),
+                (False, "visual_finish_unrecognized"), (42, "visual_finish_unrecognized")):
+            with self.subTest(finish=finish), self.assertRaises(contract.VisualFailure) as raised:
+                worker.visual_response(envelope(finish=finish))
+            self.assertEqual(code, raised.exception.code)
+            self.assertEqual(code, str(raised.exception))
+        value = json.loads(envelope())
+        del value["choices"][0]["finish_reason"]
+        with self.assertRaises(contract.VisualFailure) as raised:
+            worker.visual_response(json.dumps(value))
+        self.assertEqual("visual_finish_missing", raised.exception.code)
+
+    def test_outer_duplicates_cannot_replace_length_or_content(self):
+        for raw in (b'{"choices":[],"choices":[]}',
+                b'{"choices":[{"finish_reason":"length","finish_reason":"stop","message":{}}]}',
+                b'{"choices":[{"finish_reason":"stop","message":{},"message":{}}]}',
+                b'{"choices":[{"finish_reason":"stop","message":{"content":"first","content":"second"}}]}'):
+            with self.assertRaises(contract.VisualFailure) as raised:
+                worker.visual_response(raw)
+            self.assertEqual("visual_duplicate_fields", raised.exception.code)
+
+    def test_response_shape_and_refused_content_are_bounded(self):
+        cases = [b'not json', b'null', b'[]', b'{"choices":[]}', b'{"choices":[{},{}]}',
+                 b'{"choices":[null]}', envelope(content="x" * 4001)]
+        for raw in cases:
+            with self.assertRaises(contract.VisualFailure) as raised:
+                worker.visual_response(raw)
+            self.assertEqual("visual_response_invalid", raised.exception.code)
+        for field, refused in (("tool_calls", [{"name": "ignored"}]), ("refusal", "private refusal")):
+            value = json.loads(envelope())
+            value["choices"][0]["message"][field] = refused
+            with self.assertRaises(contract.VisualFailure):
+                worker.visual_response(json.dumps(value))
+
+    def test_finish_failure_keeps_ocr_and_has_one_visual_attempt(self):
+        image = SimpleNamespace(width=6, height=8)
+        visual = Mock(side_effect=contract.VisualFailure("visual_truncated"))
+        def ocr(model, supplied, view, case):
+            case["ocr_lines"].append({"text": "SYNTHETIC", "score": .99})
+        with patch.object(worker.scene, "ocr_lines", ocr):
+            value = worker.analyze(image, object(), visual, "question", DIGEST)
+        self.assertEqual(("partial", "visual_truncated", "", ["SYNTHETIC"]),
+            (value["status"], value["code"], value["description"], value["ocr_text"]))
+        self.assertEqual(1, visual.call_count)
+        self.assertEqual(220, visual.call_args.args[2])
+        contract.validate_result(value, DIGEST)
+
+    def test_ocr_prompt_is_whole_line_prefix_and_return_keeps_all_selected_lines(self):
+        lines = ["a" * 600, "b" * 600, "c" * 200]
+        captured = []
+        def ocr(model, supplied, view, case):
+            case["ocr_lines"].extend({"text": text, "score": .99} for text in lines)
+        def visual(image, prompt, cap):
+            captured.append(json.loads(prompt[prompt.index('{"question"'):]))
+            return answer("?", False)
+        with patch.object(worker.scene, "ocr_lines", ocr):
+            value = worker.analyze(SimpleNamespace(width=2, height=2), object(), visual, "question", DIGEST)
+        self.assertEqual([lines[0]], captured[0]["confident_ocr"])
+        self.assertIs(True, captured[0]["ocr_excerpt_incomplete"])
+        self.assertEqual(lines, value["ocr_text"])
+        self.assertEqual(("partial", "insufficient", "?"), (value["status"], value["code"], value["description"]))
+
+    def _actual_worker(self, raw=None, open_error=None, read_error=None, ocr_error=None, template_prefill_guard=False):
+        with tempfile.TemporaryDirectory(prefix="lilith-local-attachment-") as scratch:
+            private = Path(scratch)
+            (private / "attachment.bin").write_bytes(b"synthetic image fixture")
+            image = SimpleNamespace(width=6, height=8, thumbnail=Mock(), close=Mock(),
+                save=lambda stream, **kwargs: stream.write(b"synthetic image fixture"))
+            probe = Mock()
+            probe.__enter__ = Mock(return_value=probe)
+            probe.__exit__ = Mock(return_value=False)
+            probe.getsockname.return_value = ("127.0.0.1", 43210)
+            commands, requests = [], []
+            process = Mock()
+            process.poll.return_value = None
+            model = SimpleNamespace(predict=Mock(side_effect=ocr_error))
+            def ocr(supplied_model, supplied, view, case):
+                supplied_model.predict(input="synthetic pixels")
+                case["ocr_lines"].append({"text": "SYNTHETIC", "score": .99})
+            def start(command, **kwargs):
+                commands.append(command)
+                return process
+            class Response(io.BytesIO):
+                def read(self, size=-1):
+                    if read_error is not None:
+                        raise read_error
+                    return super().read(size)
+            def receive(request, timeout):
+                if request.full_url.endswith("/health"):
+                    return io.BytesIO(b'{"status":"ok"}')
+                requests.append((request, timeout))
+                if open_error is not None:
+                    raise open_error
+                if template_prefill_guard:
+                    # Synthetic upstream boundary, NOT an inference/parser
+                    # implementation: the observed global-output-format path
+                    # rejected this template prefix before content generation.
+                    schema_shape = {"type": "json_schema", "json_schema": {"schema": contract.visual_schema()}}
+                    if "--json-schema" in commands[0] or json.loads(request.data).get("response_format") != schema_shape:
+                        raise urllib.error.HTTPError(request.full_url, 400,
+                            "Failed to initialize samplers: Unexpected empty grammar stack after accepting piece: <|im_start|> (6)",
+                            {}, io.BytesIO(b"synthetic rejection"))
+                return Response(envelope() if raw is None else raw)
+            http = SimpleNamespace(open=receive)
+            with patch.object(Path, "cwd", return_value=private), \
+                 patch.object(worker.socket, "socket", return_value=probe), \
+                 patch.object(worker.scene, "local_network_only"), \
+                 patch.object(worker.scene, "verify_assets", return_value=private), \
+                 patch.object(worker.scene, "initialize_ocr", return_value=model), \
+                 patch.object(worker.scene, "ocr_lines", side_effect=ocr), \
+                 patch.object(worker, "decode_image", return_value=image), \
+                 patch.object(worker.urllib.request, "build_opener", return_value=http), \
+                 patch.object(worker.subprocess, "Popen", side_effect=start):
+                value = worker.run({"schema": 1, "binding": {}, "private": str(private),
+                    "image_sha256": DIGEST, "question": "Synthetic question"})
+            process.terminate.assert_called_once()
+            process.wait.assert_called_once_with(timeout=5)
+            image.close.assert_called_once()
+            model.predict.assert_called_once()
+            return value, commands, requests
+
+    def test_actual_worker_request_schema_cap_and_one_mock_http_dispatch(self):
+        for finish, expected in (("stop", "ready"), ("length", "visual_truncated")):
+            with self.subTest(finish=finish):
+                value, commands, requests = self._actual_worker(raw=envelope(finish=finish))
+                self.assertEqual(expected, value["code"])
+                self.assertEqual(1, len(commands))
+                argv = commands[0]
+                for option in ("--json-schema", "-j", "--json-schema-file", "-jf", "--grammar", "--grammar-file"):
+                    self.assertNotIn(option, argv)
+                self.assertIn("--offline", argv)
+                self.assertEqual(1, len(requests))
+                request, timeout = requests[0]
+                self.assertEqual("http://127.0.0.1:43210/v1/chat/completions", request.full_url)
+                body = json.loads(request.data)
+                self.assertEqual({"type": "json_schema", "json_schema": {"schema": contract.visual_schema()}}, body["response_format"])
+                self.assertEqual({"messages", "max_tokens", "temperature", "stream", "response_format"}, set(body))
+                self.assertEqual((220, .1, False, 15), (body["max_tokens"], body["temperature"], body["stream"], timeout))
+                self.assertEqual(2, len(body["messages"][0]["content"]))
+                self.assertEqual(1, sum(row["type"] == "image_url" for row in body["messages"][0]["content"]))
+
+    def test_actual_worker_template_prefill_fixture_requires_request_owned_schema(self):
+        value, commands, requests = self._actual_worker(template_prefill_guard=True)
+        self.assertEqual("ready", value["code"])
+        contract.validate_result(value, DIGEST)
+        self.assertEqual((1, 1), (len(commands), len(requests)))
+        self.assertEqual(2000, json.loads(requests[0][0].data)["response_format"]["json_schema"]["schema"]["properties"]["description"]["maxLength"])
+
+    def test_actual_worker_transport_and_output_failures_keep_ocr_without_private_error_text(self):
+        for location in ("open_error", "read_error"):
+            for status, code in ((400, "visual_request_rejected"), (429, "visual_request_rejected"),
+                    (500, "visual_service_failed"), (503, "visual_service_failed"), (307, "visual_http_error")):
+                body = Mock()
+                body.read.side_effect = AssertionError("HTTP error body must not be read")
+                error = urllib.error.HTTPError("http://private.invalid/private", status, "PRIVATE SERVER TEXT", {}, body)
+                with self.subTest(location=location, status=status):
+                    value, commands, requests = self._actual_worker(**{location: error})
+                    self.assertEqual(("partial", code, "", ["SYNTHETIC"]),
+                        (value["status"], value["code"], value["description"], value["ocr_text"]))
+                    contract.validate_result(value, DIGEST)
+                    self.assertEqual((1, 1), (len(commands), len(requests)))
+                    body.read.assert_not_called()
+                    body.close.assert_called_once()
+                    self.assertNotIn("PRIVATE", json.dumps(value))
+                    self.assertNotIn("private.invalid", json.dumps(value))
+            for error, code in ((urllib.error.URLError("PRIVATE CONNECTION TEXT"), "visual_transport_failed"),
+                    (TimeoutError("PRIVATE TIMEOUT"), "visual_timeout"),
+                    (urllib.error.URLError(TimeoutError("PRIVATE TIMEOUT")), "visual_timeout"),
+                    (ConnectionResetError("PRIVATE RESET"), "visual_transport_failed"),
+                    (worker.HTTPException("PRIVATE PROTOCOL TEXT"), "visual_transport_failed")):
+                with self.subTest(location=location, error=type(error).__name__):
+                    value, commands, requests = self._actual_worker(**{location: error})
+                    self.assertEqual(("partial", code, "", ["SYNTHETIC"]),
+                        (value["status"], value["code"], value["description"], value["ocr_text"]))
+                    contract.validate_result(value, DIGEST)
+                    self.assertEqual((1, 1), (len(commands), len(requests)))
+                    self.assertNotIn("PRIVATE", json.dumps(value))
+        value, commands, requests = self._actual_worker(raw=b"PRIVATE" * 7000)
+        self.assertEqual(("partial", "visual_output_exceeded", "", ["SYNTHETIC"]),
+            (value["status"], value["code"], value["description"], value["ocr_text"]))
+        self.assertEqual((1, 1), (len(commands), len(requests)))
+        contract.validate_result(value, DIGEST)
+        self.assertNotIn("PRIVATE", json.dumps(value))
+        bounded = envelope() + b" " * (48_000 - len(envelope()))
+        self.assertEqual("ready", self._actual_worker(raw=bounded)[0]["code"])
+
+    def test_actual_worker_ocr_predict_failure_is_distinct_and_never_dispatches_visual(self):
+        value, commands, requests = self._actual_worker(ocr_error=RuntimeError("PRIVATE OCR TEXT"))
+        self.assertEqual({"status": "unavailable", "code": "ocr_inference_failed"}, value)
+        self.assertEqual((1, 0), (len(commands), len(requests)))
+        self.assertNotIn("PRIVATE", json.dumps(value))
+
+    def test_actual_host_rejects_duplicate_worker_status_and_releases_owned_lane(self):
