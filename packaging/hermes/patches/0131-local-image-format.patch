+class GatewayFormatTests(unittest.IsolatedAsyncioTestCase):
+    async def test_ready_and_partial_finish_codes_preserve_request_only_routing_and_private_logs(self):
+        source = SimpleNamespace(platform="telegram")
+        private_path = "synthetic-private-image-path"
+        caption = "synthetic private caption"
+        for code in ("ready", "insufficient", *sorted(contract.VISUAL_FAILURE_CODES)):
+            description = DESCRIPTION if code in {"ready", "insufficient"} else ""
+            value = result(code, description)
+            with patch.object(host, "bound_home", return_value=Path.cwd()), \
+                 patch.object(host, "analyze_attachment", return_value=value), \
+                 self.assertLogs("gateway.local_image_preprocess", level="INFO") as logs:
+                text, remaining, meta = await preprocess_telegram_images(caption, [private_path], source)
+            self.assertEqual([] if code == "ready" else [private_path], remaining)
+            self.assertEqual([code], meta["codes"])
+            self.assertIn(caption, text)
+            line = " ".join(logs.output)
+            self.assertIn("description_chars=" + str(len(description)), line)
+            self.assertIn("ocr_lines=1", line)
+            for private in (caption, private_path, DESCRIPTION, "SYNTHETIC OCR"):
+                self.assertNotIn(private, line)
+
+    async def test_unavailable_counts_are_unknown_and_no_evidence_is_invented(self):
+        with patch.object(host, "bound_home", return_value=Path.cwd()), \
+             patch.object(host, "analyze_attachment", return_value=contract.failure("busy")), \
+             self.assertLogs("gateway.local_image_preprocess", level="INFO") as logs:
+            text, remaining, meta = await preprocess_telegram_images("private caption", ["private path"], SimpleNamespace(platform="telegram"))
+        self.assertEqual("private caption", text)
+        self.assertEqual(["private path"], remaining)
+        self.assertEqual("existing_fallback", meta["route"])
+        self.assertIn("description_chars=-1 ocr_lines=-1", " ".join(logs.output))
+
+
+if __name__ == "__main__":
+    unittest.main()
