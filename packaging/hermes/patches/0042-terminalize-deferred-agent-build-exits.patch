+def test_start_agent_build_detached_session_is_normal_cancellation(monkeypatch):
+    """Closing/replacing a session during build must not emit a false failure."""
+    build_entered = threading.Event()
+    release_build = threading.Event()
+    events = []
+
+    def cancelled_build(*_args, **_kwargs):
+        build_entered.set()
+        assert release_build.wait(timeout=3), "test did not release build"
+        raise SystemExit("cancelled worker")
+
+    monkeypatch.setattr(server, "_set_session_context", lambda _target: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", cancelled_build)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: events.append((event, sid, payload)),
+    )
+    monkeypatch.setattr("tui_gateway.entry.ensure_mcp_discovery_started", lambda: None)
+
+    sid = "cancelled-build"
+    ready = threading.Event()
+    session = {
+        "agent": None,
+        "agent_error": None,
+        "agent_ready": ready,
+        "session_key": "stored-session",
+        "profile_home": None,
+    }
+    server._sessions[sid] = session
+    try:
+        server._start_agent_build(sid, session)
+        assert build_entered.wait(timeout=2), "agent build did not start"
+        with server._sessions_lock:
+            assert server._sessions.pop(sid) is session
+        release_build.set()
+        build_thread = session["_agent_build_thread"]
+        build_thread.join(timeout=3)
+
+        assert not build_thread.is_alive(), "cancelled build did not terminate"
+        assert not ready.is_set()
+        assert session["agent_error"] is None
+        assert events == []
+    finally:
+        release_build.set()
+        server._sessions.pop(sid, None)
+
+
