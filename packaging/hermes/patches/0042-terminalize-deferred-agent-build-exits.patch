+def test_start_agent_build_baseexception_publishes_terminal_readiness(monkeypatch):
+    """A hard first-import exit must not leave agent_ready unset forever."""
+    events = []
+
+    def fail_before_agent(*_args, **_kwargs):
+        raise SystemExit("first import aborted")
+
+    monkeypatch.setattr(server, "_set_session_context", lambda _target: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", fail_before_agent)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: events.append((event, sid, payload)),
+    )
+    monkeypatch.setattr("tui_gateway.entry.ensure_mcp_discovery_started", lambda: None)
+
+    sid = "baseexception-build"
+    ready = threading.Event()
+    session = {
+        "agent": None,
+        "agent_error": None,
+        "agent_ready": ready,
+        "agent_runtime_revision": 7,
+        "session_key": "stored-session",
+        "profile_home": None,
+    }
+    server._sessions[sid] = session
+    try:
+        server._start_agent_build(sid, session)
+        build_thread = session["_agent_build_thread"]
+        build_thread.join(timeout=3)
+
+        assert not build_thread.is_alive(), "agent build did not terminate"
+        assert ready.is_set()
+        assert session["agent"] is None
+        assert "first import aborted" in session["agent_error"]
+        assert session["agent_error_revision"] == 7
+        assert session["agent_build_started"] is False
+        assert events == [
+            (
+                "error",
+                sid,
+                {
+                    "message": "agent init failed: first import aborted",
+                    "runtime_revision": 7,
+                    "runtime_ready": False,
+                },
+            )
+        ]
+    finally:
+        server._sessions.pop(sid, None)
+
+
+def test_live_durable_resume_retries_terminal_build_and_publishes_session_info(
+    monkeypatch, tmp_path
+):
+    """The hidden-session live fast path must recover a dead first worker."""
+    from hermes_state import SessionDB
+
+    class CandidateAgent:
+        model = "test-model"
+
+    events = []
+    build_calls = 0
+    stored_id = "durable-game-session"
+    sid = "live-durable-retry"
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session(stored_id, source="lilith-game", archived=True)
+
+    def make_agent(*_args, **_kwargs):
+        nonlocal build_calls
+        build_calls += 1
+        if build_calls == 1:
+            raise SystemExit("first import aborted")
+        return CandidateAgent()
+
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_set_session_context", lambda _target: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", make_agent)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda _sid: None)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, event_sid, payload=None: events.append(
+            (event, event_sid, payload)
+        ),
+    )
+    monkeypatch.setattr(
+        server, "_session_info", lambda agent, *_args: {"model": agent.model}
+    )
+    monkeypatch.setattr(
+        server, "_start_notification_poller", lambda *_args, **_kwargs: threading.Event()
+    )
+    monkeypatch.setattr(server, "_notify_session_boundary", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_schedule_mcp_late_refresh", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_probe_config_health", lambda *_args: None)
+    monkeypatch.setattr(server, "_config_model_target", lambda: ("", ""))
+    monkeypatch.setattr(server, "_load_memory_notifications", lambda: [])
+    monkeypatch.setattr(server, "_load_cfg", lambda: {})
+    monkeypatch.setattr(server, "_git_branch_for_cwd", lambda _cwd: "")
+    monkeypatch.setattr(server, "_project_info_for_cwd", lambda _cwd: None)
+    monkeypatch.setattr("tui_gateway.entry.ensure_mcp_discovery_started", lambda: None)
+    monkeypatch.setattr("tools.approval.register_gateway_notify", lambda *_args: None)
+    monkeypatch.setattr("tools.approval.load_permanent_allowlist", lambda: None)
+    monkeypatch.setattr("agent.credits_tracker.seed_credits_at_session_start", lambda _agent: None)
+
+    session = server._deferred_session_record(
+        stored_id,
+        cols=80,
+        cwd=str(tmp_path),
+        history=[],
+        lease=None,
+        source="lilith-game",
+        model_override={"model": "test-model", "provider": "test-provider"},
+    )
+    server._sessions[sid] = session
+    try:
+        server._start_agent_build(sid, session)
+        first_worker = session["_agent_build_thread"]
+        first_worker.join(timeout=3)
+        assert not first_worker.is_alive(), "first agent build did not terminate"
+        assert session["agent_ready"].is_set()
+        assert session["agent"] is None
+        assert session["agent_build_started"] is False
+        assert [event for event, _sid, _payload in events] == ["error"]
+
+        resumed = server._methods["session.resume"](
+            "resume-live-durable",
+            {
+                "session_id": stored_id,
+                "source": "lilith-game",
+                "require_durable_lineage": True,
+                "expected_source": "lilith-game",
+                "expected_archived": True,
+                "omit_messages": True,
+            },
+        )
+        assert "error" not in resumed
+        assert resumed["result"]["session_id"] == sid
+
+        second_worker = session["_agent_build_thread"]
+        assert second_worker is not first_worker
+        second_worker.join(timeout=3)
+        assert not second_worker.is_alive(), "retried agent build did not finish"
+        assert build_calls == 2
+        assert session["agent_ready"].is_set()
+        assert session["agent_error"] is None
+        assert isinstance(session["agent"], CandidateAgent)
+        assert [event for event, _sid, _payload in events] == [
+            "error",
+            "session.info",
+        ]
+        assert events[-1][1] == sid
+        assert events[-1][2]["runtime_ready"] is True
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
+
