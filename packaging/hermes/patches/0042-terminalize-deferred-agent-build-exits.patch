-    build_thread = threading.Thread(target=_build, daemon=True)
+    def _run_build_worker() -> None:
+        """Never leave an attached deferred session waiting on a dead worker.
+
+        The build body handles ordinary ``Exception`` failures itself so it can
+        preserve runtime-revision retry semantics.  A ``BaseException`` raised
+        by a first-import dependency (for example ``SystemExit``) bypasses that
+        handler and would otherwise kill this daemon thread with ``agent_ready``
+        permanently unset.  Also guard future accidental fall-throughs from the
+        body: if this exact session record is still attached and unpublished
+        when the worker exits, publish one terminal initialization failure.
+
+        Session close/replacement is the normal cancellation path.  It removes
+        or replaces the record before the worker unwinds, so it is deliberately
+        not reported as an initialization failure.
+        """
+        unexpected: BaseException | None = None
+        try:
+            _build()
+        except BaseException as exc:
+            unexpected = exc
+
+        safe_error = "agent initialization terminated before completing"
+        if unexpected is not None:
+            try:
+                safe_error = _safe_turn_error(None, unexpected)
+            except BaseException:
+                # This boundary exists specifically for failures outside the
+                # normal Exception rail.  Error formatting must not reopen the
+                # permanent-wait bug it is closing.
+                safe_error = "agent initialization terminated unexpectedly"
+
+        runtime_revision = 0
+        terminalized = False
+        with _sessions_lock:
+            current = _sessions.get(sid)
+            if current is session and not current.get("_finalized"):
+                with lock:
+                    if current.get("agent") is None and not ready.is_set():
+                        runtime_revision = _runtime_revision_locked(current)
+                        current["agent_error"] = safe_error
+                        current["agent_error_revision"] = runtime_revision
+                        current["agent_build_started"] = False
+                        ready.set()
+                        terminalized = True
+
+        if not terminalized:
+            return
+        try:
+            logger.error(
+                "agent build worker terminated before readiness (%s): %s",
+                type(unexpected).__name__ if unexpected is not None else "early return",
+                safe_error,
+            )
+        except BaseException:
+            # A custom logging handler must not prevent the protocol terminal.
+            pass
+        try:
+            _emit(
+                "error",
+                sid,
+                {
+                    "message": f"agent init failed: {safe_error}",
+                    "runtime_revision": runtime_revision,
+                    "runtime_ready": False,
+                },
+            )
+        except BaseException:
+            # Readiness and the retained error are authoritative even if the
+            # client transport disappears while the terminal frame is emitted.
+            logger.debug("agent build terminal error emit failed", exc_info=True)
+
+    build_thread = threading.Thread(target=_run_build_worker, daemon=True)
