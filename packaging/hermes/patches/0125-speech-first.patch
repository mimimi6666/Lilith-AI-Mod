@@ -0,0 +1,248 @@
+"""Speech-first display framing; synthetic text only, no effects or provider calls."""
+from copy import deepcopy
+from types import SimpleNamespace
+import random
+import unittest
+
+from agent.paired_speech import (
+    EMOTIONS, PairedSpeech, SYSTEM_OUTPUT_CONTRACT, _host_contract_digest,
+    _PREVIOUS_COMPACT_CONTRACT_HASH, accept_response, project_historical_speech,
+)
+
+
+def previous_contract(nonce="b" * 32):
+    return (
+        "Host presentation contract for THIS turn only: after the visible answer, "
+        "ALWAYS append this Japanese speech template, even without vocal cues. "
+        "Choose VALUE from the host emotion list; the emotion line is hidden.\n"
+        f'<lilith_speech id="{nonce}" locale="ja">\n[emotion=VALUE]\nFaithful Japanese rendition\n</lilith_speech>\n'
+        "Only this id is valid. No suffix on tool calls. Nothing after the closing tag.\n"
+        "[End host presentation contract]"
+    )
+
+
+class SpeechFirstTests(unittest.TestCase):
+    def setUp(self):
+        self.pair = PairedSpeech("a" * 32, "zh-Hant")
+        self.answer = "今天辛苦了，先休息一下吧。"
+        self.spoken = "今日はお疲れさま。少し休もうね。"
+
+    def frame(self, body=None):
+        return self.pair.open_tag + "\n" + (self.spoken if body is None else body) + "\n" + self.pair.close_tag
+
+    def wire(self, body=None, answer=None):
+        return self.frame(body) + "\n\n" + (self.answer if answer is None else answer)
+
+    def streamed(self, text, chunks=None):
+        self.pair.begin_response()
+        return "".join(self.pair.feed(chunk) for chunk in (chunks if chunks is not None else text)).strip()
+
+    def test_prefix_every_two_part_split_and_character_stream(self):
+        wire = self.wire("[emotion=gentle]\n" + self.spoken)
+        for cut in range(len(wire) + 1):
+            with self.subTest(cut=cut):
+                self.assertEqual(self.streamed(wire, [wire[:cut], wire[cut:]]), self.answer)
+        self.assertEqual(self.streamed(wire), self.answer)
+        self.assertEqual(self.pair.accept(wire), self.answer)
+        self.assertEqual(self.pair.result.speech_text, self.spoken)
+        self.assertEqual(self.pair.result.speech_emotion, "gentle")
+        self.assertEqual(self.pair.output_order, "prefix")
+
+    def test_three_part_splits_cover_both_control_markers(self):
+        wire = self.wire()
+        for first in range(len(self.pair.open_tag) + 1):
+            for second in range(len(self.pair.open_tag), len(wire) + 1):
+                self.assertEqual(self.streamed(wire, [wire[:first], wire[first:second], wire[second:]]), self.answer)
+
+    def test_seeded_irregular_chunks_preserve_display(self):
+        wire = " \r\n" + self.wire("[emotion=playful]\nふふ、" + self.spoken)
+        rng = random.Random(124)
+        for _ in range(80):
+            chunks, at = [], 0
+            while at < len(wire):
+                size = rng.randrange(1, 25)
+                chunks.append(wire[at:at + size])
+                at += size
+            self.assertEqual(self.streamed(wire, chunks), self.answer)
+            self.assertEqual(self.pair.accept(wire), self.answer)
+            self.assertEqual(self.pair.output_order, "prefix")
+
+    def test_no_display_before_frame_closes_and_no_early_voice_candidate(self):
+        frame = self.frame("[emotion=gentle]\n" + self.spoken)
+        for char in frame:
+            self.assertEqual(self.pair.feed(char), "")
+            self.assertIsNone(self.pair.result)
+        self.assertEqual(self.pair.feed(self.answer), self.answer)
+        self.assertIsNone(self.pair.result)
+        self.assertEqual(self.pair.accept(frame + self.answer), self.answer)
+        self.assertIsNotNone(self.pair.result)
+
+    def test_truncated_frame_never_displays_or_accepts_speech(self):
+        frame = self.frame("[emotion=excited]\nジャジャーン！" + self.spoken)
+        for cut in range(len(frame) + 1):
+            raw = frame[:cut]
+            self.assertEqual(self.streamed(raw), "")
+            self.assertEqual(self.pair.accept(raw), "")
+            self.assertIsNone(self.pair.result)
+
+    def test_frame_without_visible_answer_is_not_publishable(self):
+        for tail in ("", " ", "\n\t\r\n"):
+            self.assertEqual(self.pair.accept(self.frame() + tail), "")
+            self.assertIsNone(self.pair.result)
+
+    def test_all_emotions_without_cues_and_legacy_no_hint_remain_supported(self):
+        for hint in [""] + [f"[emotion={emotion}]\n" for emotion in sorted(EMOTIONS)]:
+            wire = self.wire(hint + self.spoken)
+            self.assertEqual(self.streamed(wire), self.answer)
+            self.assertEqual(self.pair.accept(wire), self.answer)
+            self.assertEqual(self.pair.result.speech_text, self.spoken)
+            self.assertEqual(self.pair.output_order, "prefix")
+
+    def test_cue_does_not_change_rendition_or_selected_emotion(self):
+        body = "ジャジャーン！今日は一緒にお祝いしよう！"
+        self.pair.accept(self.wire("[emotion=excited]\n" + body))
+        self.assertEqual(self.pair.result.speech_text, body)
+        self.assertEqual(self.pair.result.speech_emotion, "excited")
+
+    def test_four_display_locales_keep_same_prefix_contract(self):
+        for locale, answer in (("zh-Hant", self.answer), ("zh-Hans", "今天辛苦了，先休息一下吧。"),
+                               ("en", "Good work today. Take a little rest."), ("ja", self.spoken)):
+            self.pair = PairedSpeech("a" * 32, locale)
+            raw = self.wire(answer=answer)
+            self.assertEqual(self.streamed(raw), answer)
+            self.assertEqual(self.pair.accept(raw), answer)
+            self.assertEqual(self.pair.result.speech_text, self.spoken)
+
+    def test_old_suffix_still_works_in_all_chunk_positions(self):
+        raw = self.answer + "\n" + self.frame("[emotion=gentle]\n" + self.spoken)
+        for cut in range(len(raw) + 1):
+            self.assertEqual(self.streamed(raw, [raw[:cut], raw[cut:]]), self.answer)
+        self.assertEqual(self.pair.accept(raw), self.answer)
+        self.assertEqual(self.pair.output_order, "suffix")
+
+    def test_legacy_suffix_with_tail_remains_rejected_and_tail_hidden(self):
+        raw = self.answer + "\n" + self.frame() + "不應顯示的尾巴"
+        self.assertEqual(self.streamed(raw), self.answer)
+        self.assertEqual(self.pair.accept(raw), self.answer)
+        self.assertIsNone(self.pair.result)
+
+    def test_wrong_nonce_and_locale_do_not_authorize_voice(self):
+        for raw in (self.wire().replace(self.pair.nonce, "b" * 32),
+                    self.wire().replace('locale="ja"', 'locale="zh"'),
+                    self.wire().replace("<lilith_speech", "<LILITH_SPEECH")):
+            self.assertEqual(self.streamed(raw), self.answer)
+            self.assertEqual(self.pair.accept(raw), self.answer)
+            self.assertIsNone(self.pair.result)
+            self.assertEqual(self.pair.outcome, "invalid_current_marker")
+
+    def test_bad_emotions_wrong_language_and_markup_cannot_be_spoken(self):
+        for body in ("[emotion=unknown]\n" + self.spoken,
+                     "[emotion=gentle]\n[emotion=playful]\n" + self.spoken,
+                     "[emotion=../path]\n" + self.spoken,
+                     "[emotion=gentle]" + self.spoken, "我只有中文。",
+                     "<b>" + self.spoken + "</b>", "", "[emotion=gentle]\n"):
+            self.assertEqual(self.streamed(self.wire(body)), self.answer)
+            self.assertEqual(self.pair.accept(self.wire(body)), self.answer)
+            self.assertIsNone(self.pair.result)
+
+    def test_repeated_frames_are_hidden_and_never_publish(self):
+        for raw in (self.wire() + self.frame(), self.wire() + self.frame() + "extra",
+                    self.frame() + self.frame() + self.answer):
+            visible = self.streamed(raw)
+            self.assertNotIn(self.spoken, visible)
+            self.assertNotIn("lilith_speech", visible)
+            self.pair.accept(raw)
+            self.assertIsNone(self.pair.result)
+
+    def test_nested_frame_fails_closed_in_stream_and_final_display(self):
+        raw = self.pair.open_tag + "\n" + self.frame() + self.spoken + self.pair.close_tag + self.answer
+        for cut in range(len(raw) + 1):
+            self.assertEqual(self.streamed(raw, [raw[:cut], raw[cut:]]), "")
+        self.assertEqual(self.pair.accept(raw), "")
+        self.assertIsNone(self.pair.result)
+
+    def test_repeated_closing_marker_is_hidden_and_rejected(self):
+        raw = self.wire() + self.pair.close_tag + self.spoken
+        for cut in range(len(raw) + 1):
+            self.assertEqual(self.streamed(raw, [raw[:cut], raw[cut:]]), self.answer)
+        self.assertEqual(self.pair.accept(raw), self.answer)
+        self.assertIsNone(self.pair.result)
+
+    def test_nonfinal_and_tool_turns_never_publish_a_leading_script(self):
+        for options in ({"has_tools": True}, {"finish_reason": "length"},
+                        {"finish_reason": "incomplete"}, {"finish_reason": "content_filter"}):
+            self.assertEqual(self.pair.accept(self.wire(), **options), self.answer)
+            self.assertIsNone(self.pair.result)
+
+    def test_new_attempt_discards_stream_state_and_previous_voice(self):
+        self.pair.accept(self.wire())
+        self.pair.feed(self.pair.open_tag + "partial")
+        self.pair.begin_response()
+        self.assertIsNone(self.pair.result)
+        self.assertEqual(self.pair.output_order, "none")
+        self.assertEqual(self.pair.feed(self.answer), self.answer)
+
+    def test_hidden_stream_buffer_is_bounded_and_oversized_voice_rejected(self):
+        self.pair.feed(self.pair.open_tag)
+        for _ in range(80):
+            self.assertEqual(self.pair.feed("あ" * 4096), "")
+            self.assertLess(len(self.pair._close_pending), len(self.pair.close_tag))
+        self.pair.accept(self.wire("あ" * 32769))
+        self.assertIsNone(self.pair.result)
+
+    def test_plain_chat_and_non_string_chunks_preserved(self):
+        self.assertEqual(self.streamed(self.answer), self.answer)
+        self.assertEqual(self.pair.feed(None), "")
+        self.assertEqual(self.pair.accept(self.answer), self.answer)
+        self.assertEqual(self.pair.outcome, "missing_suffix")
+
+    def test_only_current_turn_can_consume_and_reasoning_is_never_speech(self):
+        agent = SimpleNamespace(_lilith_paired_speech=self.pair, _current_turn_id="a" * 32)
+        msg = SimpleNamespace(content=self.answer, reasoning_content=self.wire(), tool_calls=[])
+        accept_response(agent, msg, "stop")
+        self.assertIsNone(self.pair.result)
+        self.assertEqual(msg.content, self.answer)
+        agent._current_turn_id = "b" * 32
+        msg.content = self.wire()
+        accept_response(agent, msg, "stop")
+        self.assertIsNone(self.pair.result)
+
+    def test_observation_distinguishes_orders_without_logging_text(self):
+        agent = SimpleNamespace(_lilith_paired_speech=self.pair, _current_turn_id="a" * 32)
+        for order, raw in (("prefix", self.wire()), ("suffix", self.answer + self.frame())):
+            msg = SimpleNamespace(content=raw, tool_calls=[])
+            with self.assertLogs("agent.paired_speech", level="INFO") as captured:
+                accept_response(agent, msg, "stop")
+            rendered = "\n".join(captured.output)
+            self.assertIn("order=" + order, rendered)
+            for private in (self.spoken, self.answer, self.pair.nonce):
+                self.assertNotIn(private, rendered)
+
+    def test_instructions_only_change_order_not_cue_or_emotion_requirements(self):
+        self.assertIn("(1) the hidden Japanese", SYSTEM_OUTPUT_CONTRACT)
+        self.assertIn("block FIRST", SYSTEM_OUTPUT_CONTRACT)
+        self.assertIn("BEFORE the visible answer", self.pair.instruction())
+        self.assertIn("After the closing tag, write the visible answer", self.pair.instruction())
+        self.assertIn("Then write the visible answer", self.pair.terminal_reminder())
+        self.assertNotIn("Nothing after the closing tag", self.pair.instruction())
+        self.assertNotIn(self.pair.nonce, SYSTEM_OUTPUT_CONTRACT)
+        self.assertEqual(len(EMOTIONS), 7)
+        self.assertIn("VOCAL CUES are OPTIONAL", SYSTEM_OUTPUT_CONTRACT)
+
+    def test_previous_template_exact_projection_preserves_sources(self):
+        self.assertEqual(_host_contract_digest(previous_contract())[0], _PREVIOUS_COMPACT_CONTRACT_HASH)
+        agent = SimpleNamespace(_lilith_paired_speech=self.pair, _current_turn_id="a" * 32)
+        source = {"role": "user", "content": "player text", "display_kind": "user",
+                  "api_content": "keep note\n\n" + previous_contract() + "\n\nplayer text"}
+        actual = {"role": "user", "content": source["api_content"]}
+        before = deepcopy((source, actual))
+        self.assertEqual(project_historical_speech(agent, source, actual)["content"], "keep note\n\nplayer text")
+        self.assertEqual((source, actual), before)
+        for contract in (previous_contract(self.pair.nonce), previous_contract().replace("append", "invent")):
+            source["api_content"] = "keep note\n\n" + contract + "\n\nplayer text"
+            actual["content"] = source["api_content"]
+            self.assertIs(project_historical_speech(agent, source, actual), actual)
+
+
