new file mode 100644
--- /dev/null
+++ b/agent/paired_speech.py
@@ -0,0 +1,134 @@
+"""Ephemeral, host-requested display/speech pairing from ONE main completion.
+
+This is output formatting, not a tool or permission. No provider calls, database
+writes, preference reads or extra origins. Legacy/notification turns opt out.
+"""
+from dataclasses import dataclass
+import uuid
+
+_PREFIX = "<lilith_speech"
+_KEY = "_lilith_paired_speech"
+
+
+@dataclass(frozen=True)
+class PairedSpeechResult:
+    turn_id: str
+    display_locale: str
+    speech_locale: str
+    display_text: str
+    speech_text: str
+
+
+class PairedSpeech:
+    def __init__(self, turn_id, display_locale):
+        from agent.turn_identity import require_canonical_id
+        require_canonical_id(turn_id, "turn_id")
+        if display_locale not in {"zh-Hant", "zh-Hans", "en"}:
+            raise ValueError("unsupported paired display locale")
+        self.turn_id = turn_id
+        self.display_locale = display_locale
+        self.nonce = uuid.uuid4().hex
+        self.open_tag = f'<lilith_speech id="{self.nonce}" locale="ja">'
+        self.close_tag = '</lilith_speech>'
+        self.result = None
+        self.begin_response()
+
+    def instruction(self):
+        return (
+            "Host presentation contract for THIS turn only: write your answer in the "
+            "requested display language exactly as usual. In the SAME final text response, "
+            "after that complete answer append a faithful Japanese TTS rendition, enclosed "
+            f"exactly as: \n{self.open_tag}\nJapanese speech text\n{self.close_tag}\n"
+            "Do not explain or label this formatting. Do not wrap it in a code fence. "
+            "The display answer comes first; nothing follows the closing tag. The enclosed "
+            "script is not a second answer: preserve meaning, persona, names, tone and facts; "
+            "add no advice, claims or actions. Use natural Japanese sentences and kana readings "
+            "for Han-only names/headings; never leave Chinese clauses for a Japanese voice. "
+            "Omit unreadable markup, URLs and local file paths from speech. "
+            "Do not attach a speech script to tool calls or interim commentary. Continue using "
+            "real tools normally when needed, then attach the script only to the final answer. "
+            "This contract neither authorizes any action nor changes conversation language."
+        )
+
+    def begin_response(self):
+        self.pending = ""
+        self.hidden = False
+        self.result = None
+
+    def feed(self, delta):
+        """Hide the suffix even when the marker arrives one character at a time."""
+        if self.hidden or not isinstance(delta, str):
+            return ""
+        text = self.pending + delta
+        self.pending = ""
+        at = text.lower().find(_PREFIX)
+        if at >= 0:
+            self.hidden = True
+            return text[:at]
+        for length in range(min(len(_PREFIX) - 1, len(text)), 0, -1):
+            if text[-length:].lower() == _PREFIX[:length]:
+                self.pending = text[-length:]
+                return text[:-length]
+        return text
+
+    def display(self, text):
+        if not isinstance(text, str):
+            return text
+        at = text.lower().find(_PREFIX)
+        return text[:at].rstrip() if at >= 0 else text
+
+    def accept(self, text, *, has_tools=False, finish_reason="stop"):
+        from agent.speech_projection import _speech_language_issue
+        from agent.redact import redact_sensitive_text
+        self.result = None
+        display = self.display(text)
+        if (not isinstance(text, str) or not display or has_tools or finish_reason != "stop"
+                or len(display) > 32768 or text.count(self.open_tag) != 1
+                or text.count(self.close_tag) != 1):
+            return display
+        prefix, suffix = text.split(self.open_tag, 1)
+        speech, closing, tail = suffix.partition(self.close_tag)
+        speech = speech.strip()
+        # A malformed/foreign marker cannot bless a later legitimate-looking
+        # suffix. Speech text is never reparsed as a tool, JSON or permission.
+        if (not closing or prefix.rstrip() != display.rstrip() or tail.strip() or not speech or len(speech) > 32768
+                or _PREFIX in speech.lower() or '<' in speech or '>' in speech
+                or redact_sensitive_text(speech) != speech
+                or _speech_language_issue(display, speech, "ja") is not None):
+            return display
+        self.result = PairedSpeechResult(self.turn_id, self.display_locale, "ja", display.strip(), speech)
+        return display
+
+    def for_reply(self, text):
+        if self.result is not None and self.result.display_text == text.strip():
+            return self.result
+        return None
+
+
+def state_for(agent):
+    state = getattr(agent, _KEY, None)
+    if type(state) is PairedSpeech and getattr(agent, "_current_turn_id", None) == state.turn_id:
+        return state
+    return None
+
+
+def display_only(agent, text):
+    state = state_for(agent)
+    return state.display(text) if state is not None else text
+
+
+def begin_response(agent):
+    state = state_for(agent)
+    if state is not None:
+        state.begin_response()
+
+
+def accept_response(agent, message, finish_reason):
+    state = state_for(agent)
+    if state is not None:
+        # Match the existing display normalizer before pairing; inline thinking
+        # is neither the visible answer nor material to speak aloud.
+        strip_thinking = getattr(agent, "_strip_think_blocks", None)
+        if isinstance(message.content, str) and callable(strip_thinking):
+            message.content = strip_thinking(message.content).strip()
+        message.content = state.accept(message.content, has_tools=bool(message.tool_calls), finish_reason=finish_reason)
