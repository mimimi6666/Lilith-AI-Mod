+        # to pair acceptance. Observe actual prompt/persistence separation.
+        joined = '\n'.join(str(m.get('content', '')) for m in payload['messages'])
+        tag = re.search(r'<lilith_speech id="[a-f0-9]{32}" locale="ja">', joined)
+        assert tag, 'main completion omitted the pairing contract'
