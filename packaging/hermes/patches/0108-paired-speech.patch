+++ b/tests/test_paired_speech.py
@@ -0,0 +1,72 @@
+"""Pure hostile formatting cases, using actual language/identity validators."""
+import types
+import unittest
+from agent.paired_speech import PairedSpeech, accept_response, state_for
+
+
+class PairTests(unittest.TestCase):
+    def setUp(self):
+        self.pair = PairedSpeech("a" * 32, "zh-Hant")
+        self.answer = "早安，今天一起散步吧。"
+        self.speech = "おはよう。今日は一緒に散歩しましょう。"
+
+    def wire(self, speech=None):
+        return self.answer + "\n" + self.pair.open_tag + "\n" + (speech or self.speech) + "\n" + self.pair.close_tag
+
+    def test_one_pair_and_all_stream_splits(self):
+        wire = self.wire()
+        for cut in range(len(wire) + 1):
+            self.pair.begin_response()
+            visible = self.pair.feed(wire[:cut]) + self.pair.feed(wire[cut:])
+            self.assertEqual(visible.strip(), self.answer)
+        self.pair.begin_response()
+        self.assertEqual(''.join(self.pair.feed(c) for c in wire).strip(), self.answer)
+        self.assertEqual(self.pair.accept(wire), self.answer)
+        self.assertEqual(self.pair.for_reply(self.answer).speech_text, self.speech)
+        self.assertIsNone(self.pair.for_reply("別的回覆"))
+
+    def test_plain_text_survives_without_pair(self):
+        self.assertEqual(self.pair.accept(self.answer), self.answer)
+        self.assertIsNone(self.pair.result)
+        self.assertEqual(self.pair.feed(self.answer), self.answer)
+
+    def test_bad_suffix_never_turns_chat_into_failure(self):
+        for raw in (self.wire()[:-5], self.wire() + "extra", self.wire().replace(self.pair.nonce, "b"*32),
+                    self.wire("我還是中文。"), self.wire() + self.wire(),
+                    self.answer + self.pair.open_tag, self.answer + "<LILITH_SPEECH bad>日本語です。",
+                    self.pair.close_tag + self.answer + self.pair.open_tag + "日本語です。"):
+            self.pair.accept(raw)
+            self.assertIsNone(self.pair.result)
+            self.assertNotIn("日本語", self.pair.display(raw))
+
+    def test_interim_truncated_and_tool_results_never_pair(self):
+        for kwargs in ({"has_tools": True}, {"finish_reason": "length"}, {"finish_reason": "incomplete"}):
+            self.assertEqual(self.pair.accept(self.wire(), **kwargs), self.answer)
+            self.assertIsNone(self.pair.result)
+
+    def test_new_response_invalidates_old_candidate(self):
+        self.pair.accept(self.wire())
+        self.pair.begin_response()
+        self.assertIsNone(self.pair.result)
+        self.assertEqual(self.pair.feed("下一次的回答"), "下一次的回答")
+
+    def test_only_exact_agent_turn_is_parsed(self):
+        agent = types.SimpleNamespace(_lilith_paired_speech=self.pair, _current_turn_id="b"*32)
+        self.assertIsNone(state_for(agent))
+        msg = types.SimpleNamespace(content=self.answer, tool_calls=[])
+        accept_response(agent, msg, "stop")
+        self.assertEqual(msg.content, self.answer)
+        agent._current_turn_id = "a"*32
+        msg.content = self.wire()
+        accept_response(agent, msg, "stop")
+        self.assertEqual(msg.content, self.answer)
+        self.assertIsNotNone(self.pair.result)
+
+    def test_invalid_settings_rejected(self):
+        for turn, locale in (("bad", "zh-Hant"), ("a"*32, "ja"), ("a"*32, "untrusted")):
+            with self.assertRaises(ValueError):
+                PairedSpeech(turn, locale)
+
+
+if __name__ == "__main__":
+    unittest.main()
