+            rows = [dict(id="fixture", object="chat.completion.chunk", created=0, model="gpt-4o",
+                choices=[dict(index=0, delta=dict(content=c), finish_reason=None)]) for c in content]
+            rows.append(dict(id="fixture", object="chat.completion.chunk", created=0, model="gpt-4o",
+                choices=[dict(index=0, delta={}, finish_reason="stop")], usage=usage))
+            body = ''.join('data: ' + json.dumps(row) + '\n\n' for row in rows) + 'data: [DONE]\n\n'
+            return httpx.Response(200, headers={'content-type': 'text/event-stream'}, content=body.encode())
+        return httpx.Response(200, json=dict(id="fixture", object="chat.completion", created=0, model="gpt-4o",
+            choices=[dict(index=0, message=dict(role="assistant", content=content), finish_reason="stop")], usage=usage))
+
+    client = openai.OpenAI(api_key='synthetic-not-a-secret', base_url='https://api.openai.com/v1', max_retries=0,
+        http_client=httpx.Client(transport=httpx.MockTransport(fake_http), trust_env=False))
