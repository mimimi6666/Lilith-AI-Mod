new file mode 100644
--- /dev/null
+++ b/agent/lilith_tool_modes.py
@@ -0,0 +1,114 @@
+"""Native tool presets and schema presentation for the host-bound Lilith profile.
+
+Presets are catalog suggestions, never runtime grants. Only the existing native
+tools.set transaction changes selected toolsets. Disclosure changes how an
+already selected schema is presented; the registry and session scope still own
+availability, approval and dispatch. Nothing in this module reads player data.
+"""
+from __future__ import annotations
+
+import os
+
+
+_DAILY = (
+    "lilith_local_scene", "lilith_notes", "lilith_leave_note",
+    "memory", "session_search", "web", "clarify", "skills",
+)
+_WORK = _DAILY + (
+    "file", "terminal", "code_execution", "delegation", "todo",
+    "browser", "vision", "computer_use",
+)
+
+# Presentation priorities only: these names never add tools to a selection.
+# Skills remain eager because native background maintenance derives its exact
+# memory/skill execution whitelist from those schemas. Kanban lifecycle tools
+# likewise retain upstream eager behavior for dispatcher-owned workers.
+_EAGER = (
+    "lilith_local_scene", "lilith_notes", "lilith_leave_note",
+    "relationship_memory", "memory", "session_search",
+    "web_search", "web_extract", "clarify", "todo",
+    "skills_list", "skill_view", "skill_manage", "native_tool_setup",
+)
+
+
+def is_lilith_profile() -> bool:
+    """Match the host's bound home to the current native profile, not cwd/name."""
+    bound = os.environ.get("HERMES_LILITH_BOUND_HOME", "")
+    if not bound or not os.path.isabs(bound):
+        return False
+    try:
+        from hermes_constants import get_hermes_home
+
+        active = os.fspath(get_hermes_home())
+        return bool(active) and os.path.normcase(os.path.abspath(bound)) == os.path.normcase(os.path.abspath(active))
+    except (ImportError, OSError, TypeError, ValueError):
+        return False
+
+
+def disclosure_preference(name: str) -> bool | None:
+    """True defers a selected registered name; False pins it; None is upstream."""
+    if not is_lilith_profile():
+        return None
+    return name not in _EAGER and not name.startswith("kanban_")
+
+
+def schema_sort_key(definition: dict) -> tuple[int, str]:
+    name = str((definition.get("function") or {}).get("name", ""))
+    return (_EAGER.index(name) if name in _EAGER else len(_EAGER), name)
+
+
+def session_tool_names(agent):
+    """Use the native session snapshot for orchestration, never global config."""
+    selected = getattr(agent, "_native_selected_tool_names", None)
+    if is_lilith_profile() and isinstance(selected, frozenset):
+        return sorted(selected)
+    visible = getattr(agent, "valid_tool_names", None)
+    return sorted(visible) if visible else None
+
+
+def sandbox_tool_names(enabled_tools, allowed_tools):
+    """Intersect native sandbox support with the original selected capabilities."""
+    selected = frozenset(allowed_tools & set(enabled_tools or ()))
+    # Upstream treats an empty intersection as its all-tools legacy fallback.
+    # A bound Lilith session must never turn zero native grants into all grants.
+    return selected if selected or is_lilith_profile() else allowed_tools
+
+
+def catalog_presets(catalog_names) -> list[dict]:
+    """Pure current-catalog projection: no discovery, IO, settings or defaults."""
+    if not is_lilith_profile():
+        return []
+    available = frozenset(catalog_names)
+    managed = [name for name in _WORK if name in available]
+    return [
+        {"id": mode, "toolset_ids": [name for name in selected if name in available],
+         "managed_toolset_ids": list(managed)}
+        for mode, selected in (("daily", _DAILY), ("work", _WORK))
+    ]
+
+
+def prioritize_catalog(rows):
+    """Keep native catalog data/order, moving the three Lilith rows to the top."""
+    if not is_lilith_profile():
+        return rows
+    priorities = {name: rank for rank, name in enumerate(_DAILY[:3])}
+    return sorted(rows, key=lambda row: priorities.get(row[0], len(priorities)))
+
+
+def tool_discovery_enabled(config: dict) -> bool:
+    from tools.tool_search import ToolSearchConfig
+    section = config.get("tools")
+    raw = section.get("tool_search") if isinstance(section, dict) else None
+    return ToolSearchConfig.from_raw(raw).enabled != "off"
+
+
+def set_tool_discovery(config: dict, enabled: bool) -> None:
+    """Stage one explicitly requested native setting in the existing transaction."""
+    if type(enabled) is not bool:
+        raise ValueError("tool_discovery_enabled must be a boolean")
+    if not isinstance(config.get("tools"), dict):
+        config["tools"] = {}
+    old = config["tools"].get("tool_search")
+    settings = dict(old) if isinstance(old, dict) else {}
+    settings["enabled"] = "auto" if enabled else "off"
+    config["tools"]["tool_search"] = settings
