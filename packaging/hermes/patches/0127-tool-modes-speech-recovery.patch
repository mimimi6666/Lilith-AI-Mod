diff --git a/agent/usage_latest.py b/agent/usage_latest.py
new file mode 100644
--- /dev/null
+++ b/agent/usage_latest.py
@@ -0,0 +1,134 @@
+"""Ephemeral numeric-only projection of the latest admitted player turn.
+
+Not an economic or execution authority. No prompts, credentials, persisted
+history, rates, estimates, or new provider requests are read or written here.
+The native ledger remains the owner of normalized input/output and attempt IDs.
+"""
+from threading import RLock
+from weakref import WeakKeyDictionary
+
+_DETAILS = WeakKeyDictionary()
+_DETAILS_LOCK = RLock()
+
+
+def _get(value, name):
+    return value.get(name) if isinstance(value, dict) else getattr(value, name, None)
+
+
+def _number(value):
+    return value if type(value) is int and 0 <= value <= 2**63 - 1 else None
+
+
+def cache_counts(value, wire):
+    """Missing cache metadata stays unknown, including non-caching providers."""
+    raw = _get(value, "usage")
+    if wire == "gemini_generate_content":
+        raw = _get(value, "_lilith_gemini_usage") or _get(value, "usageMetadata")
+        return _number(_get(raw, "cachedContentTokenCount")), None
+    if wire in {"chat_completions", "chat_max_tokens", "chat_max_completion_tokens"}:
+        direct = _number(_get(raw, "prompt_cache_hit_tokens"))
+        nested = _number(_get(_get(raw, "prompt_tokens_details"), "cached_tokens"))
+        if direct is not None and nested is not None and direct != nested:
+            return None, None
+        return direct if direct is not None else nested, None
+    if wire == "responses":
+        raw = raw or _get(_get(value, "response"), "usage")
+        return _number(_get(_get(raw, "input_tokens_details"), "cached_tokens")), None
+    if wire == "anthropic_messages":
+        raw = raw or _get(_get(value, "message"), "usage")
+        return _number(_get(raw, "cache_read_input_tokens")), _number(_get(raw, "cache_creation_input_tokens"))
+    if wire == "bedrock_converse":
+        raw = raw or _get(_get(value, "metadata"), "usage")
+        return _number(_get(raw, "cacheReadInputTokens")), _number(_get(raw, "cacheWriteInputTokens"))
+    return None, None
+
+
+def record_cache_usage(ledger, attempt_id, value, wire):
+    """Best effort; never turn a display failure into a provider failure."""
+    try:
+        incoming = cache_counts(value, wire)
+        raw = _get(value, "usage")
+        direct = _number(_get(raw, "prompt_cache_hit_tokens"))
+        nested = _number(_get(_get(raw, "prompt_tokens_details"), "cached_tokens"))
+        incoming_conflicts = (
+            wire in {"chat_completions", "chat_max_tokens", "chat_max_completion_tokens"}
+            and direct is not None and nested is not None and direct != nested,
+            False,
+        )
+        if incoming == (None, None) and not any(incoming_conflicts):
+            return
+        with _DETAILS_LOCK:
+            rows = _DETAILS.setdefault(ledger, {})
+            old, conflicts = rows.get(attempt_id, ((None, None), (False, False)))
+            values, invalid = [], []
+            for previous, current, conflict, incoming_conflict in zip(old, incoming, conflicts, incoming_conflicts):
+                conflict = conflict or incoming_conflict or (previous is not None and current is not None and previous != current)
+                invalid.append(conflict)
+                values.append(None if conflict else previous if current is None else current)
+            rows[attempt_id] = (tuple(values), tuple(invalid))
+    except Exception:
+        pass
+
+
+class LatestUsage:
+    """One bounded latest-turn view, deliberately not a history collection."""
+    def __init__(self):
+        self._lock = RLock()
+        self._turn = None
+        self._ledger = None
+        self._complete = False
+        self._revision = 0
+        self._last = None
+
+    def accepted(self, turn_id):
+        with self._lock:
+            self._turn, self._ledger, self._complete = turn_id, None, False
+            self._revision += 1
+            self._last = None
+
+    def bound(self, turn_id, ledger):
+        with self._lock:
+            if self._turn == turn_id:
+                self._ledger = ledger
+
+    def completed(self, turn_id):
+        with self._lock:
+            if self._turn == turn_id:
+                self._complete = True
+
+    def snapshot(self):
+        with self._lock:
+            result = dict(schema_version=1, turn_id=self._turn,
+                          state="none" if self._turn is None else "pending", request_count=0,
+                          input_tokens=None, output_tokens=None,
+                          cache_read_tokens=None, cache_write_tokens=None)
+            if self._ledger is not None:
+                snapshot = self._ledger.snapshot()
+                rows = [(a.reservation.attempt_id, a.state, a.actual_input_tokens, a.actual_output_tokens)
+                        for a in snapshot.attempts if a.state not in {"reserved", "released"}]
+                rows += [(a.attempt_id, a.state, a.input_tokens, a.output_tokens) for a in snapshot.observations]
+                result["request_count"] = len(rows)
+                for name, index in (("input_tokens", 2), ("output_tokens", 3)):
+                    if rows and all(_number(row[index]) is not None for row in rows):
+                        total = sum(row[index] for row in rows)
+                        result[name] = _number(total)
+                with _DETAILS_LOCK:
+                    details = dict(_DETAILS.get(self._ledger, {}))
+                for name, index in (("cache_read_tokens", 0), ("cache_write_tokens", 1)):
+                    counts = [details.get(row[0], ((None, None), (False, False)))[0][index] for row in rows]
+                    if (rows and all(_number(count) is not None for count in counts)
+                            and all(row[2] is not None and count <= row[2] for row, count in zip(rows, counts))):
+                        result[name] = _number(sum(counts))
+                cached, written, incoming = (result["cache_read_tokens"], result["cache_write_tokens"], result["input_tokens"])
+                if cached is not None and written is not None and incoming is not None and cached + written > incoming:
+                    result["cache_read_tokens"] = result["cache_write_tokens"] = None
+                if self._complete or snapshot.stopped:
+                    known = (rows and result["input_tokens"] is not None and result["output_tokens"] is not None
+                             and all(row[1] in {"settled", "reconciled"} for row in rows))
+                    result["state"] = "completed" if known and not snapshot.stopped else "partial"
+            elif self._complete:
+                result["state"] = "partial"
+            if self._last != result:
+                self._revision += 1
+                self._last = dict(result)
+            return {**result, "revision": self._revision}
