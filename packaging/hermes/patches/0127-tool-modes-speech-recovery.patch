diff --git a/tests/test_latest_usage.py b/tests/test_latest_usage.py
new file mode 100644
--- /dev/null
+++ b/tests/test_latest_usage.py
@@ -0,0 +1,178 @@
+"""Pure numeric fixtures; no providers, profiles, history or network."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+from agent.usage_budget import TurnBudgetLedger, resolve_policy, NormalBudget, VerifiedModelLimits
+from agent.usage_latest import LatestUsage, cache_counts, record_cache_usage
+
+
+class LatestUsageTests(unittest.TestCase):
+    def setUp(self):
+        self.view = LatestUsage()
+        self.ledger = TurnBudgetLedger("turn-a", resolve_policy(5, NormalBudget(), VerifiedModelLimits()))
+        self.view.accepted("turn-a")
+        self.view.bound("turn-a", self.ledger)
+
+    def add(self, name="a", incoming=1000, outgoing=25, cached=800, category="main"):
+        self.ledger.observe_attempt(name, category=category, attempts_exact=True)
+        self.ledger.reconcile_observation(name, input_tokens=incoming, output_tokens=outgoing)
+        if cached is not None:
+            record_cache_usage(self.ledger, name, {"usage": {"prompt_cache_hit_tokens": cached}}, "chat_completions")
+
+    def test_empty_pending_then_exact(self):
+        self.assertEqual("none", LatestUsage().snapshot()["state"])
+        self.assertEqual("pending", self.view.snapshot()["state"])
+        self.add()
+        self.view.completed("turn-a")
+        value = self.view.snapshot()
+        self.assertEqual((1000, 25, 800, "completed"), tuple(value[k] for k in ("input_tokens", "output_tokens", "cache_read_tokens", "state")))
+        self.assertEqual(value, self.view.snapshot())
+
+    def test_tool_rounds_and_late_recovery_same_origin_are_summed(self):
+        self.add()
+        self.add("tool-round", incoming=1500, outgoing=45, cached=900)
+        self.view.completed("turn-a")
