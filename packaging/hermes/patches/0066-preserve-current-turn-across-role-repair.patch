     assert manager.calls[0]["assistant_response"] == "durable assistant"
 
 
+@pytest.mark.parametrize(
+    ("model", "provider"),
+    (
+        ("gemini/target", "gemini"),
+        ("deepseek/target", "deepseek"),
+        ("future/target", "future-provider"),
+    ),
+)
+def test_first_human_turn_after_any_model_switch_reaches_typed_memory_seam(
+    monkeypatch,
+    model,
+    provider,
+):
+    """The shared switch boundary must work for every target provider/model."""
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", lambda *_a, **_kw: [])
+    text = "我喜歡吃草莓蛋糕"
+    answer = "好，我記住了。"
+    agent = FakeAgent()
+    agent.platform = "lilith-game"
+    agent.model = model
+    agent.provider = provider
+    agent._current_turn_id = _TURN_ID
+    agent._persist_user_message_idx = 1
+    agent._persist_user_message_override = text
+    manager = RecordingMemoryManager()
+    agent._memory_manager = manager
+
+    marker = {
+        "role": "user",
+        "content": (
+            "[System: The active model for this chat has changed to "
+            f"{model} via provider {provider}.]"
+        ),
+        "display_kind": "model_switch",
+        "_db_persisted": True,
+        "_row_id": 40,
+    }
+    current_user = _trusted_persisted_turn(
+        user_text=text,
+        assistant_text=answer,
+        human_origin=PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME,
+    )[0]
+    messages = [marker, current_user]
+
+    assert repair_message_sequence(agent, messages) == 1
+    assert messages[0] is current_user
+    current_index = reanchor_current_turn_user_idx(messages, text)
+    assert current_index == 0
+    agent._persist_user_message_idx = current_index
+    messages.append({"role": "assistant", "content": answer})
+    stamp_turn_messages(
+        messages,
+        user_index=current_index,
+        turn_id=_TURN_ID,
+        user_message_id=_USER_MESSAGE_ID,
+        assistant_message_id=_ASSISTANT_MESSAGE_ID,
+    )
+    # The real turn-end flush stamps this after the exact SQLite append.
+    messages[-1]["_db_persisted"] = True
+
+    finalize_turn(
+        agent,
+        final_response=answer,
+        api_call_count=1,
+        interrupted=False,
+        failed=False,
+        messages=messages,
+        conversation_history=[],
+        effective_task_id="task",
+        turn_id=_TURN_ID,
+        user_message=text,
+        original_user_message=text,
+        _should_review_memory=False,
+        _turn_exit_reason="text_response(stop)",
+    )
+
+    assert len(manager.calls) == 1
+    call = manager.calls[0]
+    assert call["user_message"] == text
+    assert "[System:" not in call["user_message"]
+    assert call["model"] == model
+    assert call["input_origin"]["attestation"] == (
+        PROFILE_MEMORY_HUMAN_ORIGIN_LILITH_GAME
+    )
+    assert call["input_origin"]["subject_id"] == (
+        PROFILE_MEMORY_LOCAL_OWNER_SUBJECT_ID
+    )
+
+
