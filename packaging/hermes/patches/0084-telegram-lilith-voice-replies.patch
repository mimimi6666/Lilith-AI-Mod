+    worker = "import importlib.util,sys; s=importlib.util.spec_from_file_location('voice_store',sys.argv[1]); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); m.merge_modes(sys.argv[2],{sys.argv[3]:sys.argv[4]})"
