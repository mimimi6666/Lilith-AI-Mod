+@pytest.fixture
+def profile(tmp_path, monkeypatch):
+    reference = tmp_path / "reference.wav"
+    reference.write_bytes(wav_bytes())
+    data = dict(version=1, locale="zh", endpoint="http://127.0.0.1:9880/tts",
+                reference_path=str(reference), aux_reference_paths=[], prompt_text="合成測試。",
+                config_fingerprint="A" * 64)
+    set_snapshot(monkeypatch, data)
+    return data
+
+
+def set_snapshot(monkeypatch, data):
+    monkeypatch.setenv(voice.ENVIRONMENT, base64.b64encode(json.dumps(data).encode()).decode())
+
+
+def wav_bytes():
+    output = io.BytesIO()
+    with wave.open(output, "wb") as wav:
+        wav.setparams((1, 2, 32000, 0, "NONE", "not compressed"))
+        wav.writeframes(b"\x00\x00" * 3200)
+    return output.getvalue()
+
+
+def ogg_bytes():
+    def page(seq, flags, packet):
+        data = bytearray(b"OggS\x00" + bytes([flags]) + struct.pack("<QIII", seq * 960, 7, seq, 0)
+                         + bytes([1, len(packet)]) + packet)
+        crc = 0
+        for byte in data:
+            crc ^= byte << 24
+            for _ in range(8):
+                crc = ((crc << 1) ^ (0x04C11DB7 if crc & 0x80000000 else 0)) & 0xffffffff
+        struct.pack_into("<I", data, 22, crc)
+        return bytes(data)
+    return (page(0, 2, b"OpusHead\x01\x01" + struct.pack("<HIhB", 312, 48000, 0, 0))
+            + page(1, 0, b"OpusTags" + struct.pack("<II", 0, 0))
+            + page(2, 4, b"\xf8\xff\xfe"))
+
+
+def test_snapshot_roundtrip(profile):
+    assert voice.read_snapshot() == profile
+    assert voice.LilithGptSovitsProvider().is_available()
+
+
+@pytest.mark.parametrize("field,value", [
+    ("version", True), ("version", 2), ("locale", "en"),
+    ("endpoint", "https://127.0.0.1:9880/tts"), ("endpoint", "http://example.com:9880/tts"),
+    ("endpoint", "http://localhost:9880/tts"), ("endpoint", "http://127.0.0.1:9881/tts"),
+    ("endpoint", "http://127.0.0.1:9880/tts?redirect=evil"), ("endpoint", "http://user@127.0.0.1:9880/tts"),
+    ("endpoint", "http://127.0.0.1:9880/control"), ("reference_path", "relative.wav"),
+    ("endpoint", True), ("endpoint", 42), ("endpoint", None), ("endpoint", []),
+    ("aux_reference_paths", "file.wav"), ("aux_reference_paths", ["bad.wav"] * 9),
+    ("prompt_text", ""), ("config_fingerprint", "0" * 63), ("config_fingerprint", 123),
+])
+def test_snapshot_rejects(profile, monkeypatch, field, value):
+    profile[field] = value
+    set_snapshot(monkeypatch, profile)
+    with pytest.raises(ValueError, match="unavailable"):
+        voice.read_snapshot()
