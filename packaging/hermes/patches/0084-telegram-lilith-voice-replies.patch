index 0000000..7c13635
--- /dev/null
+++ b/gateway/lilith_voice_modes.py
@@ -0,0 +1,148 @@
+"""Shared native voice-mode store. Every writer merges under one process lock.
+
+The sibling lock is coordination only; gateway_voice_mode.json remains the
+single preference authority. No configuration, pairing or approval is written.
+"""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import tempfile
+import threading
+import time
+
+MODES = frozenset({"off", "voice_only", "all"})
+MAX_BYTES = 262144
+_LOCK = threading.RLock()
+
+
+class VoiceModeError(ValueError):
+    pass
+
+
+def _object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise VoiceModeError("Duplicate voice preference")
+        result[key] = value
+    return result
+
+
+def _regular(path):
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return None
+    if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)
+            or int(getattr(info, "st_file_attributes", 0)) & 0x400):
+        raise VoiceModeError("Unsafe voice preference file")
+    return info
+
+
+def read_modes(path):
+    path = Path(path)
+    before = _regular(path)
+    if before is None:
+        return {}
+    if before.st_size > MAX_BYTES:
+        raise VoiceModeError("Voice preference store exceeds limit")
+    with path.open("rb") as handle:
+        opened = os.fstat(handle.fileno())
+        if (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino):
+            raise VoiceModeError("Voice preference file changed")
+        raw = handle.read(MAX_BYTES + 1)
+    if len(raw) > MAX_BYTES:
+        raise VoiceModeError("Voice preference store exceeds limit")
+    try:
+        result = json.loads(raw.decode("utf-8"), object_pairs_hook=_object)
+    except (ValueError, UnicodeError):
+        raise VoiceModeError("Invalid voice preference store") from None
+    if type(result) is not dict or any(
+        type(key) is not str or not re.fullmatch(r"[^\s\x00-\x1f:]{1,64}:[^\s\x00-\x1f]{1,256}", key)
+        or type(mode) is not str or mode not in MODES
+        for key, mode in result.items()
+    ):
+        raise VoiceModeError("Invalid voice preference store")
+    return result
+
+
+def revision(modes):
+    raw = json.dumps(modes, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return hashlib.sha256(raw.encode("ascii")).hexdigest()
+
+
+@contextmanager
+def _locked(path):
+    lock_path = Path(str(path) + ".lock")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    # Refuse a redirected parent; the native profile root is supplied by host.
+    for parent in (path.parent, *path.parent.parents):
+        info = parent.lstat()
+        if stat.S_ISLNK(info.st_mode) or int(getattr(info, "st_file_attributes", 0)) & 0x400:
+            raise VoiceModeError("Unsafe voice preference directory")
+    with _LOCK:
+        _regular(lock_path)
+        with lock_path.open("a+b") as handle:
+            opened = os.fstat(handle.fileno())
+            current = _regular(lock_path)
+            if current is None or (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
+                raise VoiceModeError("Voice preference lock changed")
+            until = time.monotonic() + 5.0
+            while True:
+                try:
+                    if os.name == "nt":
+                        import msvcrt
+                        handle.seek(0)
+                        msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+                    else:
+                        import fcntl
+                        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    break
+                except OSError:
+                    if time.monotonic() >= until:
+                        raise VoiceModeError("Voice preference store is busy") from None
+                    time.sleep(0.02)
+            try:
+                yield
+            finally:
+                if os.name == "nt":
+                    handle.seek(0)
+                    msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+                else:
+                    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def merge_modes(path, changes, *, expected_revision=None, authorize=None):
+    path = Path(path)
+    if any(type(k) is not str or ":" not in k or v not in MODES for k, v in changes.items()):
+        raise VoiceModeError("Invalid voice preference update")
+    with _locked(path):
+        current = read_modes(path)
+        if expected_revision is not None and revision(current) != expected_revision:
+            raise VoiceModeError("Voice preferences changed; refresh and retry")
+        if authorize is not None and authorize() is not True:
+            raise VoiceModeError("Telegram user is not currently paired")
+        updated = {**current, **changes}
+        if updated == current:
+            return current
+        raw = json.dumps(updated, sort_keys=True, indent=2).encode("utf-8")
+        if len(raw) > MAX_BYTES:
+            raise VoiceModeError("Voice preference store exceeds limit")
+        fd, scratch = tempfile.mkstemp(prefix=".voice-", suffix=".tmp", dir=path.parent)
+        try:
+            with os.fdopen(fd, "wb") as handle:
+                handle.write(raw)
+                handle.flush()
+                os.fsync(handle.fileno())
+            _regular(path)
+            if authorize is not None and authorize() is not True:
+                raise VoiceModeError("Telegram user is not currently paired")
+            os.replace(scratch, path)
+        finally:
+            if os.path.exists(scratch):
+                os.unlink(scratch)
+        return updated
