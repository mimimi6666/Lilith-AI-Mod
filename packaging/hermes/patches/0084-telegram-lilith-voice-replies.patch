+def test_provider_uses_fixed_local_profile(profile, tmp_path, monkeypatch):
+    monkeypatch.setenv("HTTP_PROXY", "http://invalid.test:1234")
+    seen = fake_http(monkeypatch)
+    result = voice.LilithGptSovitsProvider().synthesize("這是測試。", str(tmp_path / "out.ogg"), voice="wrong", model="wrong")
+    assert Path(result).suffix == ".wav"
+    voice._wav(Path(result).read_bytes())
+    assert seen[0] == ("127.0.0.1", 9880, 120)
+    assert seen[1][0:2] == ("POST", "/tts")
+    assert seen[1][2]["ref_audio_path"] == profile["reference_path"]
+    assert seen[1][2]["prompt_text"] == profile["prompt_text"]
+    assert "voice" not in seen[1][2]
+    assert seen[-1] == "closed"
+    assert not list(tmp_path.glob(".lilith-voice-*"))
+
