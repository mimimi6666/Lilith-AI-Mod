@@ -0,0 +1,83 @@
+"""Lilith Telegram final-reply delivery policy, separate from permission policy."""
+import re
+
+from agent.identity_policy import identity_lock_required_by_host
+from gateway.config import Platform
+from gateway.lilith_voice_modes import read_modes
+
+
+def managed_source(runner, source):
+    try:
+        user = source.user_id
+        return (identity_lock_required_by_host() is True
+                and source.platform == Platform.TELEGRAM
+                and source.chat_type == "dm" and source.chat_id == user
+                and type(user) is str and re.fullmatch(r"[1-9][0-9]{0,18}", user) is not None
+                and int(user) <= 9223372036854775807
+                and runner._is_user_authorized(source) is True
+                and runner._pairing_store_for(source).is_approved("telegram", user) is True)
+    except Exception:
+        return False
+
+
+def managed_event(runner, event):
+    return (not bool(getattr(event, "internal", False))
+            and managed_source(runner, event.source))
+
+
+def strict_telegram(source):
+    return identity_lock_required_by_host() is True and source.platform == Platform.TELEGRAM
+
+
+_REQUESTS = (
+    r"(?:請|请|麻煩|麻烦)?(?:這次|这次|本次|這一則|这一则|這則|这则)?(?:請|请)?(?:用|以)(?:語音|语音|聲音|声音)(?:回覆|回復|回复|回答)(?:我)?(?:就好)?",
+    r"(?:請|请|麻煩|麻烦)?(?:語音|语音)(?:回覆|回復|回复|回答)(?:我)?",
+    r"(?:please\s+)?(?:reply|respond|answer)(?:\s+to\s+me)?\s+(?:with|in|using)\s+(?:a\s+)?(?:voice|audio)(?:\s+(?:message|reply))?(?:\s+(?:this\s+time|for\s+this\s+reply))?(?:\s+please)?",
+)
+
+
+def explicitly_requests_voice(text):
+    if type(text) is not str or not 0 < len(text) <= 16384:
+        return False
+    # Only a complete, unquoted directive sentence counts. Negated, reported,
+    # conditional and embedded instructions do not acquire delivery meaning.
+    if any(mark in text for mark in ('"', "'", "“", "”", "「", "」", "『", "』", "`", ">")):
+        return False
+    if re.search(r"(?:不要|不用|不需要|別|别|無需|无需).{0,12}(?:語音|语音|聲音|声音)|(?:do\s+not|no|never|without)\s+(?:.{0,20}\s)?(?:voice|audio)", text, re.IGNORECASE):
+        return False
+    sentences = re.split(r"[。！？!?\n]|(?<!\w)\.(?!\w)", text)
+    return any(any(re.fullmatch(pattern, sentence.strip(" \t,，.．"), re.IGNORECASE)
+                   for pattern in _REQUESTS) for sentence in sentences if sentence.strip())
+
+
+def reply_requested(runner, event):
+    try:
+        modes = read_modes(runner._VOICE_MODE_PATH)
+        mode = modes.get("telegram:" + event.source.user_id, "voice_only")
+    except Exception:
+        return False
+    if mode == "off":
+        return False
+    kind = str(getattr(event.message_type, "value", event.message_type)).lower()
+    return mode == "all" or kind == "voice" or explicitly_requests_voice(event.text)
+
+
+def scope_allowed(runner, ctx):
+    return bool(managed_source(runner, ctx.source)
+                and ctx._run_still_current() is True)
+
+
+def mode_allows_speech(runner, source):
+    try:
+        return (managed_source(runner, source)
+                and read_modes(runner._VOICE_MODE_PATH).get("telegram:" + source.user_id, "voice_only") != "off")
+    except Exception:
+        return False
+
+
+async def finish_voice_delivery(event, text_delivered):
+    callback = getattr(event, "_lilith_voice_delivery", None)
+    if callback is not None:
+        delattr(event, "_lilith_voice_delivery")
+    if callable(callback) and (text_delivered or getattr(event, "_lilith_voice_text_streamed", False)):
+        await callback()
