@@ -0,0 +1,328 @@
+"""Host-supplied Lilith voice snapshot and turn-local native TTS selection."""
+import base64
+import asyncio
+from contextlib import contextmanager
+from contextvars import ContextVar
+import http.client
+import io
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import struct
+import tempfile
+import threading
+import time
+from urllib.parse import urlsplit
+import wave
+
+from agent.tts_provider import TTSProvider
+
+PROVIDER = "lilith_gpt_sovits"
+ENVIRONMENT = "LILITH_TELEGRAM_VOICE_PROFILE"
+MAX_AUDIO = 25 * 1024 * 1024
+_ACTIVE = ContextVar("lilith_telegram_tts", default=False)
+_ALLOWED = ContextVar("lilith_telegram_tts_allowed", default=None)
+_FIELDS = frozenset({"version", "locale", "endpoint", "reference_path",
+                     "aux_reference_paths", "prompt_text", "config_fingerprint"})
+
+
+def _make_crc_table():
+    table = []
+    for byte in range(256):
+        crc = byte << 24
+        for _ in range(8):
+            crc = ((crc << 1) ^ (0x04C11DB7 if crc & 0x80000000 else 0)) & 0xffffffff
+        table.append(crc)
+    return tuple(table)
+
+
+_CRC_TABLE = _make_crc_table()
+
+
+def _object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("Invalid Lilith voice snapshot")
+        result[key] = value
+    return result
+
+
+def read_snapshot():
+    try:
+        raw = os.environ.get(ENVIRONMENT, "")
+        if not raw or len(raw) > 65536:
+            raise ValueError()
+        result = json.loads(base64.b64decode(raw, validate=True).decode("utf-8"),
+                            object_pairs_hook=_object)
+        if type(result) is not dict or frozenset(result) != _FIELDS:
+            raise ValueError()
+        if type(result["version"]) is not int or result["version"] != 1:
+            raise ValueError()
+        if result["locale"] not in ("zh", "ja"):
+            raise ValueError()
+        if type(result["endpoint"]) is not str or len(result["endpoint"]) > 128:
+            raise ValueError()
+        url = urlsplit(result["endpoint"])
+        if (url.scheme != "http" or url.hostname not in ("127.0.0.1", "::1")
+                or url.port != (9880 if result["locale"] == "zh" else 9881)
+                or url.username or url.password or url.query or url.fragment
+                or url.path not in ("", "/", "/tts")):
+            raise ValueError()
+        paths = result["aux_reference_paths"]
+        if type(paths) is not list or len(paths) > 8:
+            raise ValueError()
+        for path in [result["reference_path"], *paths]:
+            if (type(path) is not str or not path or len(path.encode("utf-8")) > 4096
+                    or "\x00" in path or not Path(path).is_absolute()
+                    or Path(path).suffix.lower() != ".wav" or ".." in Path(path).parts):
+                raise ValueError()
+        prompt = result["prompt_text"]
+        if type(prompt) is not str or not prompt.strip() or len(prompt.encode("utf-8")) > 16384 or "\x00" in prompt:
+            raise ValueError()
+        if not re.fullmatch(r"[0-9a-fA-F]{64}", result["config_fingerprint"]):
+            raise ValueError()
+        return result
+    except (ValueError, TypeError, KeyError, UnicodeError):
+        raise ValueError("Lilith voice profile is unavailable") from None
+
+
+def scoped():
+    return _ACTIVE.get() is True
+
+
+def scope_permits_speech():
+    try:
+        current = _ALLOWED.get()
+        return current is None or current() is True
+    except Exception:
+        return False
+
+
+@contextmanager
+def voice_scope(enabled=True, allowed=None):
+    token = _ACTIVE.set(enabled is True)
+    permission_token = _ALLOWED.set(allowed)
+    try:
+        yield
+    finally:
+        _ALLOWED.reset(permission_token)
+        _ACTIVE.reset(token)
+
+
+def _wav(data):
+    if len(data) < 44 or data[:4] != b"RIFF" or data[8:12] != b"WAVE":
+        raise ValueError("Lilith synthesis did not return WAV audio")
+    if struct.unpack_from("<I", data, 4)[0] != len(data) - 8:
+        raise ValueError("Lilith synthesis returned incomplete WAV audio")
+    try:
+        with wave.open(io.BytesIO(data), "rb") as wav:
+            channels, width, rate, count, compression, _ = wav.getparams()
+            if (channels not in (1, 2) or width not in (1, 2, 3, 4)
+                    or not 8000 <= rate <= 96000 or not 0 < count / rate <= 300
+                    or compression != "NONE"):
+                raise ValueError()
+            if len(wav.readframes(count)) != count * channels * width:
+                raise ValueError()
+    except (ValueError, wave.Error, EOFError):
+        raise ValueError("Lilith synthesis returned invalid WAV audio") from None
+
+
+def validate_opus(path):
+    """Validate the bounded Ogg page/container and actual Opus identification.
+
+The encoder remains Hermes' native ffmpeg. Validate every page checksum,
+sequence, stream id, end flag and packet framing before native voice delivery.
+"""
+    with Path(path).open("rb") as handle:
+        data = handle.read(MAX_AUDIO + 1)
+    if not 100 <= len(data) <= MAX_AUDIO:
+        raise ValueError("Invalid Lilith Opus output")
+    offset = 0
+    serial = None
+    sequence = 0
+    packets = []
+    pending = bytearray()
+    ended = False
+    while offset < len(data):
+        start = offset
+        if offset + 27 > len(data) or data[offset:offset + 5] != b"OggS\x00" or ended:
+            raise ValueError("Invalid Lilith Opus container")
+        flags = data[offset + 5]
+        current_serial, current_sequence, checksum = struct.unpack_from("<III", data, offset + 14)
+        if serial is None:
+            serial = current_serial
+            if not flags & 2:
+                raise ValueError("Invalid Lilith Opus start")
+        if current_serial != serial or current_sequence != sequence or bool(flags & 1) != bool(pending):
+            raise ValueError("Invalid Lilith Opus sequence")
+        sequence += 1
+        segments = data[offset + 26]
+        offset += 27
+        if offset + segments > len(data):
+            raise ValueError("Incomplete Lilith Opus output")
+        laces = data[offset:offset + segments]
+        offset += segments
+        end = offset + sum(laces)
+        if end > len(data):
+            raise ValueError("Incomplete Lilith Opus output")
+        page = bytearray(data[start:end])
+        page[22:26] = b"\x00" * 4
+        crc = 0
+        for byte in page:
+            crc = ((crc << 8) ^ _CRC_TABLE[((crc >> 24) & 255) ^ byte]) & 0xffffffff
+        if crc != checksum:
+            raise ValueError("Invalid Lilith Opus checksum")
+        for size in laces:
+            pending.extend(data[offset:offset + size])
+            offset += size
+            if size < 255:
+                packets.append(bytes(pending))
+                pending.clear()
+        ended = bool(flags & 4)
+    if (not ended or pending or len(packets) < 3
+            or len(packets[0]) < 19 or packets[0][:9] != b"OpusHead\x01"
+            or packets[0][9] not in (1, 2) or not packets[1].startswith(b"OpusTags")
+            or any(not packet for packet in packets[2:])):
+        raise ValueError("Invalid Lilith Opus packets")
+
+
+async def synthesize_cancellable(tool, **kwargs):
+    """A cancelled await never delivers or strands late worker audio files."""
+    lock = threading.Lock()
+    cancelled = False
+    completed = None
+    requested = Path(kwargs["output_path"]).resolve()
+    existing = {str(p.resolve()) for p in requested.parent.glob(requested.stem + "*")}
+
+    def cleanup(raw):
+        try:
+            result = json.loads(raw)
+            paths = result.get("file_paths") or [result.get("file_path")]
+        except (ValueError, TypeError, AttributeError):
+            paths = []
+        for raw_path in [str(requested), str(requested.with_suffix(".wav")), *paths[:64]]:
+            if not raw_path:
+                continue
+            try:
+                path = Path(raw_path).resolve()
+                if (path.parent == requested.parent and path.name.startswith(requested.stem)
+                        and str(path) not in existing):
+                    path.unlink(missing_ok=True)
+            except (OSError, TypeError, ValueError):
+                pass
+
+    def work():
+        nonlocal completed
+        raw = tool(**kwargs)
+        with lock:
+            completed = raw
+            if cancelled:
+                cleanup(raw)
+        return raw
+
+    try:
+        return await asyncio.to_thread(work)
+    except asyncio.CancelledError:
+        with lock:
+            cancelled = True
+            if completed is not None:
+                cleanup(completed)
+        raise
+
+
+class LilithGptSovitsProvider(TTSProvider):
+    name = PROVIDER
+    display_name = "Lilith GPT-SoVITS (local)"
+    voice_compatible = True
+
+    def is_available(self):
+        try:
+            read_snapshot()
+            return True
+        except ValueError:
+            return False
+
+    def get_setup_schema(self):
+        return {"name": self.display_name, "badge": "local", "tag": "Host-supplied Lilith voice", "env_vars": []}
+
+    def synthesize(self, text, output_path, **_options):
+        profile = read_snapshot()
+        if Path(output_path).exists():
+            raise ValueError("Lilith synthesis output already exists")
+        if type(text) is not str or not text.strip() or len(text) > 5000:
+            raise ValueError("Lilith speech text exceeds limit")
+        for reference in [profile["reference_path"], *profile["aux_reference_paths"]]:
+            try:
+                info = Path(reference).lstat()
+                if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)
+                        or int(getattr(info, "st_file_attributes", 0)) & 0x400):
+                    raise OSError()
+            except OSError:
+                raise ValueError("Lilith voice reference is unavailable") from None
+        url = urlsplit(profile["endpoint"])
+        payload = json.dumps({
+            "text": text, "text_lang": profile["locale"],
+            "ref_audio_path": profile["reference_path"],
+            "aux_ref_audio_paths": profile["aux_reference_paths"],
+            "prompt_text": profile["prompt_text"], "prompt_lang": profile["locale"],
+            "media_type": "wav", "streaming_mode": False,
+            "text_split_method": "cut0", "batch_size": 1, "seed": 42,
+        }, ensure_ascii=False).encode("utf-8")
+        connection = http.client.HTTPConnection(url.hostname, url.port, timeout=120)
+        # HTTPConnection connects directly to a numeric loopback address. It
+        # has no proxy/environment handling and never follows redirects.
+        try:
+            deadline = time.monotonic() + 120
+            connection.request("POST", "/tts", payload, {"Content-Type": "application/json"})
+            if connection.sock:
+                connection.sock.settimeout(max(0.1, deadline - time.monotonic()))
+            response = connection.getresponse()
+            if response.status != 200:
+                raise ValueError("Lilith synthesis service rejected the request")
+            length = response.getheader("Content-Length")
+            if length and (not length.isdecimal() or not 44 <= int(length) <= MAX_AUDIO):
+                raise ValueError("Lilith synthesis response exceeds limit")
+            chunks = []
+            total = 0
+            while True:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError()
+                if connection.sock:
+                    connection.sock.settimeout(remaining)
+                chunk = response.read1(min(65536, MAX_AUDIO + 1 - total))
+                if not chunk:
+                    break
+                total += len(chunk)
+                if total > MAX_AUDIO:
+                    raise ValueError("Lilith synthesis response exceeds limit")
+                chunks.append(chunk)
+            data = b"".join(chunks)
+            _wav(data)
+        except (OSError, http.client.HTTPException):
+            raise ValueError("Lilith synthesis service is unavailable") from None
+        finally:
+            connection.close()
+        destination = Path(output_path).with_suffix(".wav")
+        if destination.exists():
+            raise ValueError("Lilith synthesis output already exists")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        fd, scratch = tempfile.mkstemp(prefix=".lilith-voice-", suffix=".tmp", dir=destination.parent)
+        created = False
+        try:
+            with os.fdopen(fd, "wb") as handle:
+                handle.write(data)
+            # Exclusive output creation cannot replace a user-supplied file.
+            with destination.open("xb") as handle:
+                created = True
+                handle.write(Path(scratch).read_bytes())
+            return str(destination)
+        except Exception:
+            if created:
+                destination.unlink(missing_ok=True)
+            raise
+        finally:
+            Path(scratch).unlink(missing_ok=True)
