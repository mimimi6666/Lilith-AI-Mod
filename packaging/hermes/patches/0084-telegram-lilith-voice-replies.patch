+@pytest.mark.asyncio
+async def test_cancelled_worker_cleans_late_audio(tmp_path):
+    output = tmp_path / "cancel.ogg"
+    started = threading.Event()
+    release = threading.Event()
+    finished = threading.Event()
+    def slow_tool(**kwargs):
+        started.set()
+        assert release.wait(2)
+        output.write_bytes(ogg_bytes())
+        finished.set()
+        return json.dumps({"file_path": str(output)})
+    task = asyncio.create_task(voice.synthesize_cancellable(slow_tool, text="sample", output_path=str(output)))
+    try:
+        assert await asyncio.to_thread(started.wait, 2)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+    finally:
+        release.set()
+    assert await asyncio.to_thread(finished.wait, 2)
+    # Synchronize with the executor worker's cleanup, not a wall-clock guess.
+    await asyncio.get_running_loop().run_in_executor(None, lambda: None)
+    for _ in range(20):
+        if not output.exists():
+            break
+        await asyncio.sleep(0.01)
+    assert not output.exists()
