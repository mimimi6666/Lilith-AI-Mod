+def fake_http(monkeypatch, payload=None, status=200, error=None):
+    seen = []
+    data = wav_bytes() if payload is None else payload
+    class Connection:
+        sock = None
+        def __init__(self, host, port, timeout):
+            seen.append((host, port, timeout))
+        def request(self, method, target, body, headers):
+            seen.append((method, target, json.loads(body), headers))
+            if error:
+                raise error
+        def getresponse(self):
+            output = io.BytesIO(data)
+            return SimpleNamespace(status=status, getheader=lambda _: str(len(data)), read1=output.read)
+        def close(self):
+            seen.append("closed")
+    monkeypatch.setattr(voice.http.client, "HTTPConnection", Connection)
+    return seen
+
