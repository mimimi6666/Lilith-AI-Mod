+def test_store_cas_and_preservation(tmp_path):
+    path = tmp_path / "modes.json"
+    original = modes.merge_modes(path, {"discord:7": "all", "telegram:8": "off"})
+    first_revision = modes.revision(original)
+    updated = modes.merge_modes(path, {"telegram:9": "voice_only"}, expected_revision=first_revision)
+    assert updated["discord:7"] == "all" and updated["telegram:8"] == "off"
+    before = path.read_bytes()
+    with pytest.raises(modes.VoiceModeError, match="refresh"):
