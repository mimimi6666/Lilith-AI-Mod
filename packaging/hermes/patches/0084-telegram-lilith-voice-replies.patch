@@ -0,0 +1,60 @@
+"""Paired-user native voice preference management; no config mutation."""
+from pathlib import Path
+import re
+
+from agent.lilith_telegram_tts import read_snapshot
+from gateway.lilith_voice_modes import MODES, merge_modes, read_modes, revision, VoiceModeError
+from tui_gateway.telegram_messaging import TelegramMessagingRpcError
+
+
+def _user(value):
+    if (type(value) is not str or re.fullmatch(r"[1-9][0-9]{0,18}", value) is None
+            or int(value) > 9223372036854775807):
+        raise TelegramMessagingRpcError(-32602, "invalid params: user_id")
+    return value
+
+
+def _store():
+    from gateway.pairing import PairingStore
+    return PairingStore()
+
+
+def _path():
+    from hermes_constants import get_hermes_home
+    return Path(get_hermes_home()) / "gateway_voice_mode.json"
+
+
+def _receipt(user, modes):
+    try:
+        locale = read_snapshot()["locale"]
+    except ValueError:
+        locale = "unavailable"
