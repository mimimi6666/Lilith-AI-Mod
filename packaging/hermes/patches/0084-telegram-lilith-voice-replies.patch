+async def test_native_base_sends_text_before_slow_voice_and_keeps_original():
+    from gateway.config import PlatformConfig
+    from gateway.platforms.base import BasePlatformAdapter, SendResult
+    class Adapter(BasePlatformAdapter):
+        async def connect(self, **kwargs):
+            return True
+        async def disconnect(self):
+            pass
+        async def send(self, chat_id, content, **kwargs):
+            seen.append(("text", content))
+            return SendResult(success=True, message_id="123")
+        async def get_chat_info(self, chat_id):
+            return {"name": "test", "type": "dm"}
+    seen = []
+    release = asyncio.Event()
+    voice_started = asyncio.Event()
+    adapter = Adapter(PlatformConfig(), Platform.TELEGRAM)
+    adapter.config.extra["typing_indicator"] = False
+    event = MessageEvent(source=source(), message_type=MessageType.VOICE, text="hello")
+    event._lilith_voice_owner = True
+    original = "**原文完整保留。**"
+    async def voice_callback():
+        seen.append(("voice", None))
+        voice_started.set()
+        await release.wait()
+    async def handler(_):
+        event._lilith_voice_delivery = voice_callback
+        return original
+    adapter._message_handler = handler
+    task = asyncio.create_task(adapter._process_message_background(event, "test-session"))
+    try:
+        await asyncio.wait_for(voice_started.wait(), 2)
+        assert seen == [("text", original), ("voice", None)]
+        assert not task.done()
+        release.set()
+        await asyncio.wait_for(task, 2)
+        assert not hasattr(event, "_lilith_voice_delivery")
+    finally:
+        release.set()
+        if not task.done():
+            task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+
