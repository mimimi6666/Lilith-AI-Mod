         return False
 
 
+def check_video_requirements() -> bool:
+    """Check that the resolved auxiliary model explicitly accepts video.
+
+    A resolvable image client is not sufficient: many vision models accept
+    ``image_url`` but reject ``video_url``.  Keep video analysis out of the
+    model schema unless the cached models.dev metadata for the exact resolved
+    provider/model declares ``video`` as an input modality.
+    """
+    try:
+        from agent.auxiliary_client import (
+            _resolve_task_provider_model,
+            aux_probe_mode,
+            resolve_vision_provider_client,
+        )
+        from agent.models_dev import get_model_info
+    except ImportError:
+        return False
+
+    try:
+        with aux_probe_mode():
+            requested, model, base_url, api_key, _api_mode = (
+                _resolve_task_provider_model("video")
+            )
+            provider, client, resolved_model = resolve_vision_provider_client(
+                provider=requested,
+                model=model,
+                base_url=base_url,
+                api_key=api_key,
+            )
+        if client is None or not provider or not resolved_model:
+            return False
+        info = get_model_info(provider, resolved_model, allow_network=False)
+        return bool(
+            info is not None
+            and any(
+                str(modality).strip().lower() == "video"
+                for modality in info.input_modalities
+            )
+        )
+    except Exception:
+        return False
+
+
+# These probes resolve against ``auxiliary_runtime_main``, a per-session
+# ContextVar. Process/profile TTL caching would let one session's Gemini
+# capability verdict leak into another model's schema. They are deliberately
+# cheap probe-mode/cache-only checks, so evaluate them for each schema build.
+check_vision_requirements._hermes_check_fn_cache_bypass = True
+check_video_requirements._hermes_check_fn_cache_bypass = True
+
+
 
 if __name__ == "__main__":
