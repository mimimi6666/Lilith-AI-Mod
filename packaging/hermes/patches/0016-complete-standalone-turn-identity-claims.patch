diff --git a/tests/run_agent/test_run_agent.py b/tests/run_agent/test_run_agent.py
index a0b0ff1bf95d3fa1491518d9947be2edfe4f4ea2..b21b793ad88f69d6652f3788455914a9269818ca 100644
