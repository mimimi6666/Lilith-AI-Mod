@@ -2769,6 +2769,96 @@ class TestRunConversation:
         )
         coordinator.release_conversation.assert_called_once_with(relay_lease)
         assert agent._relay_pending_turn_id is None
+        assert agent._relay_pending_user_message_id is None
+        assert agent._relay_pending_assistant_message_id is None
+
+    def test_standalone_turn_claim_is_complete_distinct_and_cleared(self, agent):
+        """Non-gateway callers must create the same complete identity claim.
+
+        Background review, CLI, and other internal callers enter through this
+        wrapper without a transport-owned claim.  The wrapper must not publish
+        only a synthetic turn id because ``build_turn_context`` correctly
+        rejects every partial correlation claim.
+        """
+        relay_lease = SimpleNamespace(
+            parent_session_id="",
+            profile_key="/profile",
+            session_id=agent.session_id or "",
+        )
+        relay_turn = object()
+        coordinator = MagicMock()
+        coordinator.acquire_conversation.return_value = relay_lease
+        coordinator.begin_turn.return_value = relay_turn
+        observed = {}
+
+        def _capture_claim(*_args, **_kwargs):
+            observed["turn_id"] = agent._relay_pending_turn_id
+            observed["user_message_id"] = agent._relay_pending_user_message_id
+            observed["assistant_message_id"] = (
+                agent._relay_pending_assistant_message_id
+            )
+            return {"final_response": "ok", "completed": True}
+
+        with (
+            patch("agent.relay_runtime.SESSION_COORDINATOR", coordinator),
+            patch(
+                "agent.relay_runtime.current_profile_key",
+                return_value="/profile",
+            ),
+            patch(
+                "hermes_cli.observability.relay_shared_metrics.start_task_run"
+            ),
+            patch(
+                "hermes_cli.observability.relay_shared_metrics.finish_task_run"
+            ),
+            patch(
+                "agent.conversation_loop.run_conversation",
+                side_effect=_capture_claim,
+            ),
+        ):
+            result = agent.run_conversation("hello", task_id="task-identity")
+
+        assert result["completed"] is True
+        assert all(
+            isinstance(value, str)
+            and len(value) == 32
+            and value == value.lower()
+            for value in observed.values()
+        )
+        assert len(set(observed.values())) == 3
+        coordinator.begin_turn.assert_called_once_with(
+            relay_lease,
+            turn_id=observed["turn_id"],
+            task_id="task-identity",
+        )
+        assert agent._relay_pending_turn_id is None
+        assert agent._relay_pending_user_message_id is None
+        assert agent._relay_pending_assistant_message_id is None
+
+    @pytest.mark.parametrize(
+        "turn_id,user_message_id,assistant_message_id",
+        [
+            ("a" * 32, "", "b" * 32),
+            ("a" * 32, "a" * 32, "b" * 32),
+            ("gateway-owned-turn-id", "b" * 32, "c" * 32),
+        ],
+    )
+    def test_partial_or_noncanonical_external_turn_claim_is_rejected(
+        self,
+        agent,
+        turn_id,
+        user_message_id,
+        assistant_message_id,
+    ):
+        agent._relay_pending_turn_id = turn_id
+        agent._relay_pending_user_message_id = user_message_id
+        agent._relay_pending_assistant_message_id = assistant_message_id
+
+        with pytest.raises(
+            ValueError,
+            match="canonical turn claim requires three pairwise-distinct identities",
+        ):
+            agent.run_conversation("hello", task_id="task-invalid-identity")
 
