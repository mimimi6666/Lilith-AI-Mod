diff --git a/tools/native_tool_setup_tool.py b/tools/native_tool_setup_tool.py
new file mode 100644
index 0000000..7189111
--- /dev/null
+++ b/tools/native_tool_setup_tool.py
@@ -0,0 +1,268 @@
+"""Human-owned native setup, using Hermes metadata and pending-input callbacks.
+
+This is deliberately not a configuration writer or a shell-command runner.
+The model supplies only a native toolset name, never credentials or env names.
+Tool enablement, provider selection in config, packages and MCP remain with
+the existing native management transaction. Saved != loaded != API-verified.
+"""
+import json
+import os
+from pathlib import Path
+import re
+import threading
+
+_setup_lock = threading.Lock()
+_CANCEL = "取消設定"
+_CONFIRM = "繼續設定"
+
+
+def bound_setup_available():
+    from hermes_constants import get_hermes_home
+    bound = os.environ.get("HERMES_LILITH_BOUND_HOME", "")
+    return bool(bound and Path(bound).resolve() == get_hermes_home().resolve())
+
+
+def _metadata(name):
+    from hermes_cli import tools_config as tc
+    from hermes_cli.config import load_config
+    # The same platform gate and toolset catalog as native hermes tools.
+    if name not in {row[0] for row in tc._get_effective_configurable_toolsets()}:
+        return None
+    if not tc._toolset_allowed_for_platform(name, "cli"):
+        return None
+    config = load_config()
+    category = tc.TOOL_CATEGORIES.get(name, {})
+    import sys
+    if category.get("platform_gate") and sys.platform not in category["platform_gate"]:
+        return None
+    providers = tc._visible_providers(category, config) if category else []
+    return config, providers
+
+
+def _support(provider):
+    # Unknown provider hooks are NOT commands to execute. Only this bounded
+    # metadata shape can be satisfied without altering config/provider policy.
+    ordinary = {"name", "tag", "env_vars"}
+    if provider.get("post_setup") == "spotify" and not (set(provider) - ordinary - {"post_setup"}):
+        return "spotify_oauth"
+    if set(provider) - ordinary:
+        return "native_manager_required"
+    fields = provider.get("env_vars", [])
+    if any(not re.fullmatch(r"[A-Z][A-Z0-9_]{0,127}", str(f.get("key", ""))) for f in fields):
+        return "native_manager_required"
+    # Credential forms must not become process/profile/loader configuration.
+    reserved = {"PATH", "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "COMSPEC",
+                "HERMES_HOME", "HERMES_ENV", "HERMES_MANAGED", "BROWSER"}
+    if any(f["key"] in reserved or f["key"].startswith(("PYTHON", "HERMES_LILITH_", "HERMES_MANAGED_"))
+           for f in fields):
+        return "native_manager_required"
+    # Never rotate model-provider secrets outside their dedicated transaction.
+    from hermes_cli.credential_lifecycle import _providers_for_env_var
+    if any(_providers_for_env_var(f["key"]) for f in fields):
+        return "native_manager_required"
+    return "secure_fields" if fields else "no_setup_fields"
+
+
+def _snapshot(name, config, providers):
+    from hermes_cli import tools_config as tc
+    from hermes_cli.config import get_env_value
+    rows = []
+    for index, provider in enumerate(providers):
+        readiness = tc.provider_readiness_status(provider, config)
+        rows.append({"index": index, "name": provider["name"],
+                     "readiness": readiness, "setup_support": _support(provider),
+                     "missing_fields": [f["key"] for f in provider.get("env_vars", [])
+                                        if not get_env_value(f["key"])]})
+    return {"toolset": name, "enabled": name in tc._get_platform_tools(config, "cli", include_default_mcp_servers=False),
+            "providers": rows, "loaded_verified": False, "api_verified": False,
+            "next_step": "設定完成後回到原生工具設定確認啟用，並重新載入／實際測試；本回報不代表 API 已可用。"}
+
+
+def native_tool_setup_tool(toolset="", action="inspect", callback=None):
+    if not bound_setup_available():
+        return json.dumps({"status": "unavailable"})
+    if not isinstance(toolset, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,95}", toolset):
+        return json.dumps({"status": "invalid_toolset"})
+    if action not in ("inspect", "configure"):
+        return json.dumps({"status": "invalid_action"})
+    if callback is None:
+        return json.dumps({"status": "interactive_setup_unavailable"})
+    try:
+        return json.dumps(callback(toolset, action), ensure_ascii=False)
+    except Exception:
+        # Exceptions from a provider may embed secrets or OAuth URLs.
+        return json.dumps({"status": "setup_failed", "detail": "設定未完成，未驗證可用。"}, ensure_ascii=False)
+
+
+def run_native_setup(name, action, *, prompt, cancelled):
+    """Gateway-only callback. prompt is the existing session-bound _block."""
+    if not bound_setup_available():
+        return {"status": "unavailable"}
+    metadata = _metadata(name)
+    if metadata is None:
+        return {"status": "unknown_or_unsupported_toolset", "toolset": name}
+    config, providers = metadata
+    snapshot = _snapshot(name, config, providers)
+    if action == "inspect":
+        return {"status": "inspected", **snapshot}
+    if not _setup_lock.acquire(blocking=False):
+        return {"status": "setup_busy", "toolset": name}
+    saved = []
+    try:
+        if cancelled():
+            return {"status": "cancelled", "toolset": name}
+        if not providers:
+            return {"status": "native_manager_required", **snapshot}
+        index = 0
+        if len(providers) > 1:
+            choices = [f"{i + 1}. {p['name']}" for i, p in enumerate(providers)]
+            selection = prompt("clarify.request", {
+                "question": f"要協助設定 {name} 的哪個供應商？這不會改變工具開關或核准模式。",
+                "choices": choices + [_CANCEL]}, timeout=300)
+            if cancelled() or selection not in choices:
+                return {"status": "cancelled", "toolset": name}
+            index = choices.index(selection)
+        provider = providers[index]
+        support = _support(provider)
+        if support == "native_manager_required":
+            return {"status": support, **snapshot}
+        if support == "no_setup_fields":
+            return {"status": "no_setup_fields", **snapshot}
+        answer = prompt("clarify.request", {
+            "question": f"協助設定 {name} / {provider['name']}：必要資料請填在接下來的安全輸入卡；Spotify 登入會開啟官方網頁，由你完成。這不會更改工具開關或核准模式。",
+            "choices": [_CONFIRM, _CANCEL]}, timeout=300)
+        if cancelled() or answer != _CONFIRM:
+            return {"status": "cancelled", "toolset": name}
+        if support == "spotify_oauth":
+            result = _spotify_setup(prompt, cancelled)
+        else:
+            from hermes_cli.config import get_env_value, load_env, save_env_value
+            for field in provider.get("env_vars", []):
+                key = field["key"]
+                if get_env_value(key):
+                    continue  # No overwrite/rotation hidden inside setup.
+                question = str(field.get("prompt") or key)
+                if field.get("url"):
+                    question += "\n" + str(field["url"])
+                if field.get("default"):
+                    question += "\n預設建議值：" + str(field["default"])
+                value = prompt("secret.request", {"env_var": key, "prompt": question,
+                    "metadata": {"toolset": name, "provider": provider["name"]}}, timeout=300)
+                if cancelled() or not value:
+                    return {"status": "cancelled", "toolset": name, "saved_fields": saved}
+                if not isinstance(value, str) or not value.strip() or len(value) > 16384 or any(ord(c) < 32 for c in value):
+                    return {"status": "invalid_input", "toolset": name, "saved_fields": saved}
+                save_env_value(key, value)
+                if load_env().get(key) != value:
+                    return {"status": "persistence_failed", "toolset": name, "saved_fields": saved}
+                saved.append(key)
+            result = {"status": "settings_saved", "saved_fields": saved}
+        updated = _metadata(name)
+        if updated is None:
+            return {**result, "status": "state_changed", "toolset": name}
+        return {**_snapshot(name, *updated), **result}
+    except Exception:
+        return {"status": "setup_failed", "toolset": name,
+                "saved_fields": saved, "state_uncertain": True}
+    finally:
+        _setup_lock.release()
+
+
+def _spotify_setup(prompt, cancelled):
+    from hermes_cli import auth
+    import uuid
+    import webbrowser
+    existing = auth.get_provider_auth_state("spotify") or {}
+    if auth.get_spotify_auth_status().get("logged_in"):
+        return {"status": "already_authenticated"}
+    try:
+        client_id = auth._spotify_client_id(None, existing)
+    except auth.AuthError as exc:
+        if exc.code != "spotify_client_id_missing":
+            raise
+        if cancelled():
+            return {"status": "cancelled"}
+        # Match the native first-time wizard: app registration precedes OAuth.
+        # A dashboard is not a login-success receipt; the secure card remains.
+        try:
+            webbrowser.open("https://developer.spotify.com/dashboard")
+        except Exception:
+            pass  # The same fixed URL is present in the user's input card.
+        client_id = prompt("secret.request", {
+            "env_var": "HERMES_SPOTIFY_CLIENT_ID",
+            "prompt": "請到 https://developer.spotify.com/dashboard 建立／開啟自己的 App，加入回呼網址 "
+                      + auth.DEFAULT_SPOTIFY_REDIRECT_URI + "，然後在此輸入 Client ID（不是 Client Secret）。不要貼進聊天。",
+            "metadata": {"toolset": "spotify", "provider": "Spotify Web API"}}, timeout=300)
+    if cancelled() or not client_id:
+        return {"status": "cancelled"}
+    if not isinstance(client_id, str) or not re.fullmatch(r"[a-fA-F0-9]{32}", client_id.strip()):
+        return {"status": "invalid_client_id"}
+    client_id = client_id.strip()
+    # Use the native production endpoints; neither model args nor profile
+    # overrides can redirect this user-input flow to a credential collector.
+    redirect = auth.DEFAULT_SPOTIFY_REDIRECT_URI
+    accounts = "https://accounts.spotify.com"
+    api = "https://api.spotify.com/v1"
+    scope = auth._spotify_scope_string(None)
+    verifier = auth._spotify_code_verifier()
+    nonce = uuid.uuid4().hex
+    url = auth._spotify_build_authorize_url(client_id=client_id, redirect_uri=redirect,
+        scope=scope, state=nonce, code_challenge=auth._spotify_code_challenge(verifier),
+        accounts_base_url=accounts)
+
+    def open_login():
+        if cancelled():
+            raise auth.AuthError("Cancelled", provider="spotify", code="spotify_setup_cancelled")
+        if not webbrowser.open(url):
+            raise auth.AuthError("Browser unavailable", provider="spotify", code="spotify_browser_unavailable")
+
+    try:
+        # Bind/listen BEFORE opening a browser. Closing/interruption releases
+        # the listener, and no token is committed after cancellation.
+        callback = auth._spotify_wait_for_callback(redirect, timeout_seconds=180,
+                                                   on_listening=open_login, cancelled=cancelled)
+        if cancelled():
+            return {"status": "cancelled"}
+        if callback.get("error"):
+            return {"status": "authorization_denied"}
+        if callback.get("state") != nonce or not callback.get("code"):
+            return {"status": "oauth_state_mismatch"}
+        token = auth._spotify_exchange_code_for_tokens(client_id=client_id,
+            code=callback["code"], redirect_uri=redirect, code_verifier=verifier,
+            accounts_base_url=accounts, timeout_seconds=20)
+        state = auth._spotify_token_payload_to_state(token, client_id=client_id,
+            redirect_uri=redirect, requested_scope=scope, accounts_base_url=accounts,
+            api_base_url=api)
+        if cancelled():
+            return {"status": "cancelled"}
+        with auth._auth_store_lock():
+            store = auth._load_auth_store()
+            auth._store_provider_state(store, "spotify", state, set_active=False)
+            auth._save_auth_store(store)
+        persisted = auth.get_provider_auth_state("spotify") or {}
+        if (persisted.get("client_id") != client_id
+                or persisted.get("access_token") != state.get("access_token")
+                or not auth.get_spotify_auth_status().get("logged_in")):
+            return {"status": "persistence_failed"}
+        return {"status": "authenticated", "authorization_verified": True}
+    except auth.AuthError as exc:
+        known = {"spotify_callback_timeout": "authorization_timeout",
+                 "spotify_callback_bind_failed": "callback_unavailable",
+                 "spotify_browser_unavailable": "browser_unavailable",
+                 "spotify_setup_cancelled": "cancelled"}
+        return {"status": known.get(exc.code, "authorization_failed")}
+
