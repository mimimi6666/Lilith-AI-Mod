+def _native_tool_setup_callback(sid: str, name: str, action: str):
+    from tools.native_tool_setup_tool import run_native_setup
+    session = _sessions.get(sid)
+    if session and action == "configure" and session.get("source") != "lilith-runtime":
+        return {"status": "control_center_required",
+                "detail": "請從控制中心聊天室進行設定，才能顯示真人安全輸入／登入卡。"}
+    agent = session.get("agent") if session else None
+    origin_turn = getattr(agent, "_current_turn_id", None)
+
+    def cancelled():
+        current = _sessions.get(sid)
+        return (agent is None or current is not session
+                or current.get("agent") is not agent
+                or getattr(agent, "_current_turn_id", None) != origin_turn
+                or current.get("_finalized", False)
+                or bool(getattr(agent, "_interrupt_requested", False)))
+
+    def prompt(event, payload, timeout=300):
+        if cancelled():
+            return ""
+        return _block(event, sid, payload, timeout=timeout)
+
+    return run_native_setup(name, action,
+        prompt=prompt,
+        cancelled=cancelled)
+
+
