+"""Compact spatial clues, optional direct text, and temporal state without LLM calls."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+
+import numpy as np
+from PIL import Image
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'anchors'))
+from ocr_evidence import same_position
+from visual_text_policy import project_visual
+from perception.contracts import RULES, identity, parsed_time, redact_urls, inside, area
+from perception.layout import region_for
+
+
+ROLE_ORDER = {'main_text': 0, 'comments': 2, 'heading': 3, 'unclassified': 4,
+              'sidebar': 6, 'inline_other': 7, 'advertisement_candidate': 8}
+
+
+def choose_text(fusion, semantic, sources, budget=6000):
+    if type(budget) is not int or not 1000 <= budget <= 16000:
+        raise ValueError('Text budget must be 1000..16000 characters')
+    groups = [g for g in fusion['groups'] if g['score'] >= .80 and str(g['text']).strip()]
+    # Prefer complete lines over clipped fragments; score remains a display preference.
+    groups.sort(key=lambda g: (-len(g['normalized']), -g['score']))
+    candidates = []
+    for g in groups:
+        duplicate = next((c for c in candidates if same_position(c['box_px'], g['box_px'])), None)
+        if duplicate:
+            if ''.join(duplicate['text'].split()) != ''.join(g['text'].split()):
+                duplicate['alternative_refs'].append(g['id'])
+                duplicate['conflict'] = True
+            continue
+        region = region_for(g['box_px'], semantic)
+        candidates.append({'text': redact_urls(g['text']), 'box_px': g['box_px'], 'source': 'ocr',
+                           'source_ref': g['id'], 'ocr_score': g['score'], 'region': region['id'],
+                           'role': region['role'], 'alternative_refs': [], 'conflict': False})
+    if sources['ui']['status'] == 'available':
+        for node in sources['ui']['data']['nodes']:
+            if node['role'] not in ('text', 'paragraph', 'heading', 'link', 'button', 'tab') or not node['text'].strip():
+                continue
+            region = region_for(node['box_px'], semantic)
+            matching = next((c for c in candidates if same_position(c['box_px'], node['box_px'])
+                             and inside(c['box_px'], node['box_px']) >= .65
+                             and inside(node['box_px'], c['box_px']) >= .65), None)
+            if matching:
+                conflict = ''.join(matching['text'].split()) != ''.join(node['text'].split())
+                matching.update(source='ui', source_ref=node['id'], conflict=conflict,
+                                ocr_alternative=matching['text'] if conflict else None, text=node['text'])
+            else:
+                candidates.append({'text': node['text'], 'box_px': node['box_px'], 'source': 'ui',
+                                   'source_ref': node['id'], 'region': region['id'], 'role': region['role'],
+                                   'alternative_refs': [], 'conflict': False})
+    candidates.sort(key=lambda c: (ROLE_ORDER.get(c['role'], 4), c['box_px'][1], c['box_px'][0]))
+    chosen, omitted = [], []
+    consumed = 0
+    role_used = {}
+    limits = {'advertisement_candidate': 400, 'sidebar': 800, 'heading': 900, 'inline_other': 500}
+    for candidate in candidates:
+        count = len(candidate['text'])
+        role = candidate['role']
+        if consumed + count > budget or role_used.get(role, 0) + count > limits.get(role, budget):
+            omitted.append({'source_ref': candidate['source_ref'], 'role': role, 'reason': 'text_budget'})
+            continue
+        chosen.append(candidate)
+        consumed += count
+        role_used[role] = role_used.get(role, 0) + count
+    return chosen, {'text_characters': consumed, 'max_text_characters': budget,
+                    'selected_lines': len(chosen), 'omitted_lines': len(omitted), 'omitted': omitted,
+                    'rule': 'body first, then comments/header, bounded sidebar/ads; same-position variants do not consume full duplicate lines'}
+
+
+def temporal(image, frame, chosen, previous=None):
+    with Image.open(image) as source:
+        pixels = np.asarray(source.convert('L').resize((16, 16))).reshape(-1).tolist()
+    fingerprints = sorted({identity(''.join(c['text'].split())) for c in chosen if c['role'] not in
+                           ('advertisement_candidate', 'heading', 'sidebar', 'inline_other')})[:256]
+    state = {'window_key': frame.get('window_key'), 'captured_at': frame['captured_at'],
+             'image_sha256': frame['image_sha256'], 'luma_16x16': pixels, 'text_fingerprints': fingerprints}
+    change = {'status': 'no_previous', 'new_information': None, 'reason': 'no comparable earlier frame'}
+    if previous is None:
+        return state, change
+    old = previous.get('temporal_state', {}) if isinstance(previous, dict) else {}
+    if not isinstance(old, dict):
+        return state, {'status': 'invalid_previous', 'new_information': None}
+    if not frame.get('window_key') or old.get('window_key') != frame.get('window_key'):
+        return state, {'status': 'different_or_unknown_window', 'new_information': None}
+    try:
+        seconds = (parsed_time(frame['captured_at']) - parsed_time(old['captured_at'])).total_seconds()
+    except (KeyError, TypeError, ValueError):
+        return state, {'status': 'invalid_previous', 'new_information': None}
+    if not 0 < seconds <= 900:
+        return state, {'status': 'stale_or_out_of_order', 'new_information': None}
+    old_luma = old.get('luma_16x16')
+    old_text = old.get('text_fingerprints')
+    if (not isinstance(old_luma, list) or len(old_luma) != 256 or
+        any(type(x) is not int or not 0 <= x <= 255 for x in old_luma) or not isinstance(old_text, list)):
+        return state, {'status': 'invalid_previous', 'new_information': None}
+    ratio = float(np.mean(np.abs(np.asarray(pixels, dtype=float) - np.asarray(old_luma, dtype=float)) >= 16))
+    new_text = len(set(fingerprints) - set(x for x in old_text if isinstance(x, str)))
+    same = state['image_sha256'] == old.get('image_sha256')
+    return state, {'status': 'compared', 'elapsed_seconds': seconds, 'identical_image': same,
+                   'changed_sample_fraction': round(ratio, 4), 'new_text_line_count': new_text,
+                   'new_information': not same and (new_text > 0 or ratio >= .08),
+                   'interpretation': 'visual/text change only; not proof of scroll, reading, intent or interest'}
+
+
+def assemble(case, manifest, fusion, sources, frame, previous=None, budget=6000, replay=False):
+    selected, compaction = choose_text(fusion, manifest.get('semantic_regions', {}), sources, budget)
+    state, change = temporal(case['source_copy'], frame, selected, previous)
+    visuals = []
+    anchors = {a['id']: a for a in manifest.get('anchors', [])}
+    for answer in case['vision']:
+        projection = project_visual(answer['answer'])
+        # Replay keeps each actual model input's rectangle, never relabels an old crop as a new one.
+        bounds = answer.get('box_px') or anchors.get(answer['id'], {}).get('box_px')
+        visuals.append({'id': answer['id'], 'description': projection['description'],
+                        'box_px': bounds, 'source': 'small_visual_model', 'verified': False,
+                        'possible_text_only': projection['possible_text']})
+    packet = {'schema': 'lilith_perception_evidence_v1', 'mode': 'offline_replay' if replay else 'single_observation',
+              'frame': frame, 'source_status': {name: {k: v for k, v in source.items() if k != 'data'}
+                                               for name, source in sources.items()},
+              'sources': sources, 'layout_hypothesis': manifest['layout'],
+              'layout_decision': manifest['decision'], 'text_regions': manifest.get('semantic_regions', {}),
+              'screen_text': selected, 'visual_observations': visuals, 'compaction': compaction,
+              'temporal_state': state, 'change': change, 'rules': RULES,
+              'deployment': 'standalone_lab_only', 'main_model_called': False,
+              'permissions': 'evidence_only_no_action_or_memory_authority',
+              'freshness': 'archived output is not a live observation; runtime must check captured_at and current window before use'}
+    prompt = render_prompt(packet)
+    packet['prompt_characters'] = len(prompt)
+    packet['prompt_tokens'] = None
+    return packet, prompt
+
+
+def render_prompt(packet):
+    """Re-render stored evidence without pixels, model calls, or trusting saved rules."""
+    sources, frame = packet['sources'], packet['frame']
+    selected, change = packet['screen_text'], packet['change']
+    visuals, compaction = packet['visual_observations'], packet['compaction']
+    public_sources = {}
+    for key, source in sources.items():
+        if key == 'ui':
+            public_sources[key] = {'status': source['status'], 'selected_text_is_in_screen_text': True,
+                                   'focused_regions': [n['box_px'] for n in (source.get('data') or {}).get('nodes', []) if n['focused']][:4]}
+        else:
+            public_sources[key] = source
+    rendered = [RULES, '\n擷取時間：' + (frame['captured_at'] if frame.get('capture_time_known') else '未知（這是使用者提供的圖片）'),
+                '畫面類型（候選）：' + packet['layout_hypothesis'],
+                '資料來源狀態與內容（JSON 引用資料）：\n' + json.dumps(public_sources, ensure_ascii=False),
+                '前後差異（不是玩家意圖）：' + json.dumps(change, ensure_ascii=False),
+                '\n分區文字：每列為 JSON [來源,相對位置 x0/y0/x1/y1,文字,衝突旗標]。位置以目前截圖的寬高為 1。']
+    grouped = {}
+    for c in selected:
+        grouped.setdefault((c['region'], c['role']), []).append(c)
+    for (region_id, role), lines in grouped.items():
+        rendered.append('\n區域=' + region_id + '；類型候選=' + role)
+        for c in lines:
+            b = c['box_px']
+            rel = [round(b[0]/frame['width'], 3), round(b[1]/frame['height'], 3),
+                   round(b[2]/frame['width'], 3), round(b[3]/frame['height'], 3)]
+            rendered.append(json.dumps([c['source'], rel, c['text'], c['conflict']], ensure_ascii=False, separators=(',', ':')))
+    rendered.append('\n非文字視覺線索（可能錯誤，不作文字證據）：')
+    rendered.extend(json.dumps(v, ensure_ascii=False) for v in visuals if v['description'])
+    rendered.append('文字預算省略行數：' + str(compaction['omitted_lines']))
+    return '\n'.join(rendered)
