+"""Generic prose-column evidence, not host-name templates or semantic certainty."""
+from __future__ import annotations
+
+import math
+import re
+import statistics
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'anchors'))
+from layout_router import make_plan as legacy_plan, line_box, safe_horizontal_cut
+from perception.contracts import area, inside, intersect
+
+
+def normalized(text):
+    return ''.join(str(text).split())
+
+
+def prose(text):
+    text = str(text)
+    cjk = len(re.findall(r'[\u3400-\u9fff]', text))
+    # Long program statements, URLs and tab captions are not prose evidence.
+    if re.search(r'https?://|[{};]|\b(import|return|function|class|const)\b', text):
+        return False
+    return (cjk >= 12 and len(text) >= 24) or (len(text.split()) >= 8 and len(text) >= 45)
+
+
+def infer_regions(width, height, full_lines, sources=None):
+    lines = []
+    for line in full_lines:
+        b = line_box(line)
+        if line.get('score', 0) >= .80 and b[1] >= height * .10:
+            lines.append((line, b))
+    candidates = [(l, b) for l, b in lines if b[2] - b[0] >= width * .26
+                  and height * .006 <= b[3] - b[1] <= height * .055 and prose(l['text'])]
+    clusters = []
+    for line, b in sorted(candidates, key=lambda item: item[1][0]):
+        match = next((c for c in clusters if abs(statistics.median(x[1][0] for x in c) - b[0]) <= width * .022), None)
+        if match is None:
+            clusters.append([(line, b)])
+        else:
+            match.append((line, b))
+    eligible = [c for c in clusters if len(c) >= 5 and sum(len(l['text']) for l, _ in c) >= 160
+                and max(b[3] for _, b in c) - min(b[1] for _, b in c) >= height * .15]
+    if not eligible:
+        return {'status': 'unknown', 'regions': [], 'reason': 'no_supported_prose_column'}
+    chosen = max(eligible, key=lambda c: sum(len(l['text']) for l, _ in c))
+    # Wrapped final lines may be short. Extend only by adjacent, aligned, similarly
+    # sized lines; do not let their absence turn the end of a paragraph into an ad.
+    typical_height = statistics.median(b[3] - b[1] for _, b in chosen)
+    left_edge = statistics.median(b[0] for _, b in chosen)
+    nearby = [(l, b) for l, b in lines if abs(b[0] - left_edge) <= width * .010
+              and .6 * typical_height <= b[3] - b[1] <= 1.5 * typical_height
+              and b[2] - b[0] >= width * .035]
+    for _ in range(4):
+        added = [(l, b) for l, b in nearby if (l, b) not in chosen and
+                 any(0 <= max(b[1] - cb[3], cb[1] - b[3]) <= typical_height * .8 for _, cb in chosen)]
+        if not added:
+            break
+        chosen.extend(added)
+    x0 = min(b[0] for _, b in chosen)
+    rights = sorted(b[2] for _, b in chosen)
+    x1 = rights[math.ceil(len(rights) * .9) - 1]
+    column = [max(0, x0 - 8), max(0, min(b[1] for _, b in chosen) - 6),
+              min(width, x1 + 8), min(height, max(b[3] for _, b in chosen) + 6)]
+    support = 'aligned_long_prose_lines'
+    if sources and sources['ui']['status'] == 'available':
+        possible = [n for n in sources['ui']['data']['nodes'] if n['role'] in ('article', 'main')
+                    and .1 < area(n['box_px']) / (width * height) < .90
+                    and sum(inside(b, n['box_px']) >= .90 for _, b in chosen) >= 4]
+        if possible:
+            column = list(min(possible, key=lambda n: area(n['box_px']))['box_px'])
+            support = 'same_frame_ui_main_with_ocr_support'
+    relevant = [(l, b) for l, b in lines if inside(b, column) >= .85]
+    replies = [(l, b) for l, b in relevant if re.search(r'^(推|噓|→)\s*\w{2,30}\s*[:：]', l['text'])]
+    comments_top = min(b[1] for _, b in replies) - 3 if len(replies) >= 2 else None
+    regions = []
+    if comments_top and comments_top > column[1] + height * .06:
+        regions.append({'id': 'comments', 'role': 'comments',
+                        'box_px': [column[0], comments_top, column[2], height],
+                        'basis': 'multiple_explicit_reply_prefixes', 'certainty': 'candidate'})
+        column[3] = comments_top
+        chosen = [(l, b) for l, b in chosen if b[3] <= comments_top]
+    if not chosen:
+        return {'status': 'unknown', 'regions': [], 'reason': 'insufficient_main_body'}
+    # Gaps containing promotions become separate regions rather than consuming body quota.
+    chosen.sort(key=lambda pair: pair[1][1])
+    intervals = []
+    start = chosen[0][1][1] - 6
+    last = chosen[0][1][3]
+    gaps = []
+    for _, b in chosen[1:]:
+        if b[1] - last >= height * .075:
+            intervals.append([start, last + 5])
+            gaps.append([last + 5, b[1] - 5])
+            start = b[1] - 5
+        last = max(last, b[3])
+    intervals.append([start, min(column[3], last + 6)])
+    for index, (top, bottom) in enumerate(intervals):
+        regions.append({'id': f'main-{index + 1}', 'role': 'main_text',
+                        'box_px': [column[0], max(column[1], top), column[2], bottom],
+                        'basis': support, 'certainty': 'candidate'})
+    for index, (top, bottom) in enumerate(gaps):
+        b = [column[0], top, column[2], bottom]
+        sponsor = any(inside(lb, b) >= .8 and
+                      re.search(r'(^\s*(廣告|广告|advertisement)\s*$|[·・]\s*(贊助|赞助|sponsored)\s*$)', l['text'], re.I)
+                      for l, lb in lines)
+        regions.append({'id': f'inline-{index + 1}', 'role': 'advertisement_candidate' if sponsor else 'inline_other',
+                        'box_px': b, 'basis': 'explicit_sponsor_marker' if sponsor else 'gap_between_prose_blocks',
+                        'certainty': 'candidate'})
+    header_bottom = min(height * .22, min(r['box_px'][1] for r in regions))
+    if header_bottom > 0:
+        regions.append({'id': 'heading', 'role': 'heading', 'box_px': [0, 0, width, header_bottom],
+                        'basis': 'above_text_column', 'certainty': 'candidate'})
+    for name, b in [('left', [0, height * .12, max(1, column[0] - 2), height]),
+                    ('right', [min(width - 1, column[2] + 2), height * .12, width, height])]:
+        if b[2] - b[0] > width * .10 and any(inside(lb, b) >= .8 for _, lb in lines):
+            regions.append({'id': name + '-sidebar', 'role': 'sidebar', 'box_px': b,
+                            'basis': 'outside_supported_prose_column', 'certainty': 'candidate'})
+    return {'status': 'candidate', 'regions': regions, 'column_box_px': column,
+            'supporting_long_lines': len(chosen), 'reason': support}
+
+
+def build_plan(rgb, content, layout, metadata, full_lines, sources=None, max_crops=15):
+    base = legacy_plan(rgb, content, layout, metadata, full_lines, max_crops=max_crops)
+    height, width = rgb.shape[:2]
+    regions = infer_regions(width, height, full_lines, sources)
+    regions['fallback_regions'] = [{'id': a['id'], 'role': a['role'], 'box_px': a['box_px'],
+                                    'basis': 'actual_crop_layout_hypothesis', 'certainty': 'candidate'} for a in base['anchors']]
+    base['semantic_regions'] = regions
+    # Preserve genuine picture/card/chat routing. Correct a text-rich code hypothesis only
+    # when it also has natural-language evidence, never because of an application name.
+    if regions['status'] != 'candidate' or base['layout'] not in ('document', 'code_editor', 'row_list', 'generic'):
+        base['revision'] = 'perception-layout-v1-legacy-fallback'
+        return base
+    anchors = []
+    roles = {'main_text': 0, 'heading': 1, 'comments': 2, 'advertisement_candidate': 3, 'inline_other': 4, 'sidebar': 5}
+    for region in sorted(regions['regions'], key=lambda r: (roles[r['role']], r['box_px'][1])):
+        b = region['box_px']
+        pieces = min(3, max(1, math.ceil((b[3] - b[1]) / (height * .32)))) if region['role'] in ('main_text', 'comments') else 1
+        cuts = [b[1]] + [safe_horizontal_cut(b[1] + (b[3] - b[1]) * i / pieces,
+                                           b[0], b[2], b[1], b[3], full_lines) for i in range(1, pieces)] + [b[3]]
+        for index in range(pieces):
+            if len(anchors) >= max_crops:
+                break
+            bounds = [max(0, int(b[0])), max(0, int(cuts[index] - (4 if index else 0))),
+                      min(width, math.ceil(b[2])), min(height, math.ceil(cuts[index + 1] + (4 if index < pieces - 1 else 0)))]
+            if bounds[2] <= bounds[0] or bounds[3] <= bounds[1]:
+                continue
+            anchors.append({'id': f'{len(anchors)+1:02d}-{region["id"]}-{index+1}', 'parent': 'window',
+                            'role': region['role'], 'box_px': bounds,
+                            'bounds': [bounds[0]/width, bounds[1]/height, bounds[2]/width, bounds[3]/height],
+                            'visual': True, 'ocr': True, 'question_kind': 'interface', 'attached_to': None,
+                            'source': region['basis'], 'verified': False})
+    # Preserve already-detected illustrations in documents; a text column does not
+    # replace the image-specific look. They still receive their own OCR pass.
+    for original in base['anchors']:
+        if original['role'] != 'embedded_image' or len(anchors) >= max_crops:
+            continue
+        anchors.append({**original, 'id': f'{len(anchors)+1:02d}-illustration'})
+    base.update(revision='perception-layout-v1', layout='document', anchors=anchors,
+                visual_request_count=len(anchors)+2, ocr_request_count=len(anchors)+1,
+                distinct_views_including_overview=len(anchors)+1, unused_crop_slots=max_crops-len(anchors))
+    regions['fallback_regions'] = [{'id': a['id'], 'role': a['role'], 'box_px': a['box_px'],
+                                    'basis': 'actual_crop_layout_hypothesis', 'certainty': 'candidate'} for a in anchors]
+    base['decision'].update(original_selected=base['decision']['selected'], selected='document',
+                            reason='prose column segmentation; roles remain hypotheses',
+                            metadata_can_force_template=False)
+    return base
+
+
+def region_for(bounds, semantic, fallback='unclassified'):
+    matches = [r for r in semantic.get('regions', []) if inside(bounds, r['box_px']) >= .80]
+    if not matches:
+        matches = [r for r in semantic.get('fallback_regions', []) if inside(bounds, r['box_px']) >= .90]
+    return min(matches, key=lambda r: area(r['box_px'])) if matches else {
+        'id': fallback, 'role': fallback, 'basis': 'no_semantic_match', 'certainty': 'unknown'}
