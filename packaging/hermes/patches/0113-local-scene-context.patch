+"""Bounded local inference child. Wait for the parent's job assignment first.
+
+Input/output: one JSON object each. No recording gateway, history database,
+downloads, arbitrary URLs, LLM API, image upload, or persisted raw evidence.
+"""
+from __future__ import annotations
+
+import base64
+import contextlib
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import time
+import urllib.request
+
+ROOT = Path(__file__).resolve().parent
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def verify_assets(binding):
+    root = Path(binding["asset_root"])
+    if not root.is_absolute() or root.is_symlink():
+        raise ValueError("invalid_asset_root")
+    files = binding["files"]
+    if not isinstance(files, dict) or not 8 <= len(files) <= 100:
+        raise ValueError("invalid_asset_manifest")
+    required = {"runtime/vulkan/llama-server.exe", "models/LFM2.5-VL-450M/LFM2.5-VL-450M-F16.gguf",
+                "models/LFM2.5-VL-450M/mmproj-LFM2.5-VL-450m-F16.gguf",
+                "ocr/models/PP-OCRv6_medium_det/inference.onnx", "ocr/models/PP-OCRv6_medium_rec/inference.onnx"}
+    if not required.issubset(files):
+        raise ValueError("missing_asset")
+    for relative, digest in files.items():
+        parts = Path(relative).parts
+        if Path(relative).is_absolute() or ".." in parts or not relative.startswith(("runtime/vulkan/", "models/LFM2.5-VL-450M/", "ocr/models/")):
+            raise ValueError("unsafe_asset_path")
+        file = root / relative
+        for ancestor in (file, *file.parents):
+            if getattr(ancestor.lstat(), "st_file_attributes", 0) & 0x400:
+                raise ValueError("linked_asset")
+        if not file.is_file() or sha(file) != digest:
+            raise ValueError("asset_changed")
+    return root
+
+
+def local_network_only(port, private):
+    def audit(event, args):
+        if event == "socket.connect":
+            address = args[1]
+            if not isinstance(address, tuple) or address[:2] != ("127.0.0.1", port):
+                raise PermissionError("local_scene_network_denied")
+        if event == "socket.getaddrinfo" and args[0] != "127.0.0.1":
+            raise PermissionError("local_scene_dns_denied")
+        if event == "open" and not isinstance(args[0], int):
+            name, mode, flags = args
+            writing = (isinstance(mode, str) and any(c in mode for c in "wax+")) or (isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND))
+            if writing and os.fsdecode(name).lower() not in {"nul", "nul:"} and not Path(name).resolve().is_relative_to(private):
+                raise PermissionError("local_scene_write_outside_private")
+    sys.addaudithook(audit)
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise PermissionError("local_scene_redirect_denied")
+
+
+def initialize_ocr(root):
+    from paddleocr import PaddleOCR
+    return PaddleOCR(text_detection_model_name="PP-OCRv6_medium_det", text_recognition_model_name="PP-OCRv6_medium_rec",
+        text_detection_model_dir=str(root / "ocr/models/PP-OCRv6_medium_det"),
+        text_recognition_model_dir=str(root / "ocr/models/PP-OCRv6_medium_rec"),
+        engine="onnxruntime", device="cpu", engine_config={"intra_op_num_threads": 4, "inter_op_num_threads": 1},
+        use_doc_orientation_classify=False, use_doc_unwarping=False, use_textline_orientation=False,
+        text_recognition_batch_size=8, text_det_limit_side_len=1536, text_det_limit_type="max", text_rec_score_thresh=0.0)
+
+
+def ocr_lines(model, image, view, case):
+    import numpy as np
+    # Paddle expects BGR for in-memory images. PNGs in the lab were decoded this way.
+    results = list(model.predict(input=np.asarray(image)[:, :, ::-1].copy()))
+    if len(results) != 1:
+        raise ValueError("invalid_ocr_result_count")
+    raw = results[0].json["res"]
+    if not len(raw["rec_texts"]) == len(raw["rec_scores"]) == len(raw["rec_polys"]):
+        raise ValueError("invalid_ocr_arrays")
+    for index, (text, score, polygon) in enumerate(zip(raw["rec_texts"], raw["rec_scores"], raw["rec_polys"])):
+        case["ocr_lines"].append({"source_anchor": view["id"], "index": index, "text": str(text), "score": float(score),
+            "polygon_in_source": [[float(x) + view["box_px"][0], float(y) + view["box_px"][1]] for x, y in polygon],
+            "verified": False})
+
+
+def analyze(image_path, signals, model, visual, trigger):
+    import numpy as np
+    from PIL import Image
+    from perception.contracts import stamp, validate_sources, parsed_time
+    from perception.layout import build_plan
+    from perception.evidence import assemble
+    from perception.dialogue import Turn, prepare_dialogue
+    from layout_prompts import content_question, LAYOUT_QUESTION, region_question
+    from ocr_evidence import spatial_owner, fuse_lines
+    with Image.open(image_path) as opened:
+        rgb = opened.convert("RGB")
+    if rgb.width * rgb.height > 25_000_000:
+        raise ValueError("image_too_large")
+    frame = {**signals["frame"], "origin": "caller_bound_capture", "capture_time_known": True}
+    if sha(image_path) != frame["image_sha256"]:
+        raise ValueError("capture_changed")
+    sources = validate_sources(signals, frame["image_sha256"], rgb.width, rgb.height, frame["captured_at"])
+    metadata = {}
+    if sources["window"]["status"] == "available":
+        data = sources["window"]["data"]
+        metadata = {key: value for key, value in {"sourceUrl": data["url"], "windowTitle": data["title"],
+            "applicationName": data["application"]}.items() if value}
+    case = {"source_copy": str(image_path), "vision": [], "ocr_lines": []}
+    root = {"id": "window", "box_px": [0, 0, rgb.width, rgb.height]}
+    for name, question, cap in (("window-content", content_question(metadata), 100), ("window-layout", LAYOUT_QUESTION, 40)):
+        case["vision"].append({"id": name, "box_px": root["box_px"], "answer": visual(rgb, question, cap)})
+    ocr_lines(model, rgb, root, case)
+    manifest = build_plan(np.asarray(rgb), case["vision"][0]["answer"], case["vision"][1]["answer"],
+                          metadata, case["ocr_lines"], sources, 15)
+    if len(manifest["anchors"]) > 15:
+        raise ValueError("crop_budget_exceeded")
+    for anchor in manifest["anchors"]:
+        crop = rgb.crop(anchor["box_px"])
+        case["vision"].append({"id": anchor["id"], "box_px": anchor["box_px"],
+                               "answer": visual(crop, region_question(anchor["question_kind"]), 120)})
+        ocr_lines(model, crop, anchor, case)
+    for line in case["ocr_lines"]:
+        line["owner_anchor"] = spatial_owner(line["polygon_in_source"], line["source_anchor"], manifest["anchors"])
+    packet, _ = assemble(case, manifest, fuse_lines(case["ocr_lines"], manifest["anchors"]), sources, frame)
+    packet["deployment"] = "native_local_scene_v1"
+    prepared = prepare_dialogue(Turn(trigger=trigger, enabled=True, now=stamp(), screen_reference=trigger == "player_share",
+        current_window_key=frame["window_key"], current_image_sha256=frame["image_sha256"]), packet)
+    action = "ready" if prepared["plan"]["action"] == "prepare_text_turn" else ("silent" if trigger == "proactive" else "clarify")
+    return {"schema": "local_scene_result_v1", "action": action, "window_key": frame["window_key"],
+        "image_sha256": frame["image_sha256"], "captured_unix_ms": int(parsed_time(frame["captured_at"]).timestamp() * 1000),
+        "guidance": prepared.get("guidance", ""), "quoted_evidence": prepared.get("quoted_evidence", ""),
+        "max_crops": 15, "actual_crops": len(manifest["anchors"]), "visual_calls": len(case["vision"]),
+        "ocr_calls": 1 + len(manifest["anchors"]), "automatic_cloud_images": False,
+        "permission": "evidence_only_no_action_or_memory_authority", "continuous_observation": False}
+
+
+def run(request):
+    if set(request) != {"schema", "binding", "private", "window", "trigger"} or request["schema"] != 1:
+        raise ValueError("invalid_request")
+    if request["trigger"] not in {"proactive", "player_share"}:
+        raise ValueError("invalid_trigger")
+    private = Path(request["private"])
+    if private.resolve() != Path.cwd().resolve() or not private.name.startswith("lilith-local-scene-"):
+        raise ValueError("invalid_private_directory")
+    root = verify_assets(request["binding"])
+    # No requests are accepted by the child until its owning job exists.
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        port = probe.getsockname()[1]
+    local_network_only(port, private.resolve())
+    http = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
+    token = os.urandom(32).hex()
+    base = f"http://127.0.0.1:{port}"
+    command = [str(root / "runtime/vulkan/llama-server.exe"), "-m", str(root / "models/LFM2.5-VL-450M/LFM2.5-VL-450M-F16.gguf"),
+        "--mmproj", str(root / "models/LFM2.5-VL-450M/mmproj-LFM2.5-VL-450m-F16.gguf"),
+        "--offline", "-c", "4096", "-t", "4", "-tb", "4", "--temp", "0.1", "--min-p", "0.15",
+        "--repeat-penalty", "1.05", "--seed", "42", "-ngl", "99", "--device", "Vulkan0", "--mmproj-device", "Vulkan0",
+        "--host", "127.0.0.1", "--port", str(port), "--parallel", "1", "-n", "256", "--cache-ram", "0",
+        "--no-agent", "--no-ui-mcp-proxy", "--no-ui", "--api-key", token]
+    server = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=subprocess.CREATE_NO_WINDOW)
+    try:
+        model = initialize_ocr(root)
+        deadline = time.monotonic() + 35
+        while True:
+            if server.poll() is not None:
+                raise RuntimeError("local_model_exited")
+            try:
+                with http.open(urllib.request.Request(base + "/health", headers={"Authorization": "Bearer " + token}), timeout=1) as response:
+                    if json.loads(response.read(4096)).get("status") == "ok":
+                        break
+            except Exception:
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("local_model_start_timeout")
+                time.sleep(.1)
+        from host import foreground
+        if foreground() != request["window"]:
+            raise RuntimeError("foreground_changed_before_capture")
+        capture = private / "capture"
+        capture_program = request["binding"]["capture"]
+        for name, digest in capture_program["files"].items():
+            if sha(Path(capture_program["root"]) / name) != digest:
+                raise ValueError("capture_program_changed")
+        # Dedicated program component; no shell, scripts or policy changes.
+        done = subprocess.run([str(Path(capture_program["root"]) / "LilithLocalSceneCapture.exe"),
+            "--capture", "--expected-window", str(request["window"]["handle"]),
+            "--expected-key", request["window"]["key"], "--out", str(capture)],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12, creationflags=subprocess.CREATE_NO_WINDOW)
+        if done.returncode:
+            raise RuntimeError("capture_unavailable")
+        signals = json.loads((capture / "signals.json").read_text(encoding="utf-8-sig"))
+        if signals["frame"]["window_key"] != request["window"]["key"]:
+            raise ValueError("capture_identity_mismatch")
+        def visual(image, question, cap):
+            stream = io.BytesIO()
+            image.save(stream, format="PNG")
+            body = {"messages": [{"role": "user", "content": [{"type": "text", "text": question},
+                {"type": "image_url", "image_url": {"url": "data:image/png;base64," + base64.b64encode(stream.getvalue()).decode("ascii")}}]}],
+                "max_tokens": cap, "temperature": .1, "stream": False}
+            req = urllib.request.Request(base + "/v1/chat/completions", json.dumps(body).encode(),
+                headers={"Content-Type": "application/json", "Authorization": "Bearer " + token})
+            with http.open(req, timeout=15) as response:
+                result = json.loads(response.read(100_000))
+            answer = result["choices"][0]["message"]["content"]
+            if not isinstance(answer, str) or len(answer) > 4000:
+                raise ValueError("invalid_local_visual_response")
+            return answer
+        return analyze(capture / "window.png", signals, model, visual, request["trigger"])
+    finally:
+        if server.poll() is None:
+            server.terminate()  # Only our private model worker; parent Job covers descendants.
+        server.wait(timeout=5)
+
+
+def main():
+    # Kept above all third-party imports: parent assigns this process to its Job first.
+    request = json.loads(sys.stdin.buffer.read(65_537))
+    sys.path[:0] = [str(ROOT), str(ROOT / "anchors")]
+    try:
+        with open(os.devnull, "w", encoding="utf-8") as quiet, contextlib.redirect_stdout(quiet), contextlib.redirect_stderr(quiet):
+            result = run(request)
+        sys.stdout.buffer.write(json.dumps(result, ensure_ascii=False).encode("utf-8"))
+        return 0
+    except Exception:
+        # No raw error path/content is emitted to a provider or ordinary log.
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
