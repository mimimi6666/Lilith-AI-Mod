+"""Current pixels and structural observations choose templates, never site names.
+
+All rectangles are recomputed for the supplied screenshot. No per-domain cache,
+absolute monitor coordinates, title-to-template table, or model-generated code.
+"""
+import re
+
+import numpy as np
+from planner import area, clamp, image_blocks, wide_color_banner, workspace_bounds, embedded_blocks
+from layout_prompts import parse_layout, metadata_context
+
+
+def line_box(line):
+    points = line["polygon_in_source"]
+    return [min(p[0] for p in points), min(p[1] for p in points),
+            max(p[0] for p in points), max(p[1] for p in points)]
+
+
+def topic_hint(answer):
+    value = str(answer).lower()[:2000]
+    if re.search(r"\b(chat|conversation|messages|messaging)\b", value):
+        return "conversation"
+    if re.search(r"\b(code|programming|editor)\b", value):
+        return "code_editor"
+    return None
+
+
+def pixel_evidence(rgb):
+    h, w = rgb.shape[:2]
+    blocks = image_blocks(rgb)
+    dominant = [b for b in blocks if area(b) >= w*h*.24 and .75 < (b[2]-b[0])/(b[3]-b[1]) < 3.5]
+    cards = [b for b in blocks if .008 < area(b)/(w*h) < .22 and .65 < (b[2]-b[0])/(b[3]-b[1]) < 2.6]
+    # Darkness alone is not evidence of chat: code editors and video also are dark.
+    return blocks, dominant, cards
+
+
+def select_template(rgb, content_answer, layout_answer, metadata):
+    blocks, dominant, cards = pixel_evidence(rgb)
+    hint = parse_layout(layout_answer)
+    topic = topic_hint(content_answer)
+    geometry = "large_panel" if dominant else "card_grid" if len(cards) >= 4 else None
+    reason = "structural answer"
+    selected = hint
+    if hint == "unknown":
+        selected = geometry or topic or "generic"
+        reason = "unrecognized structural answer; pixel/content fallback"
+    elif hint in ("card_grid", "large_panel") and geometry and hint != geometry:
+        # A picture with a recommendation sidebar is not the same as a card grid.
+        selected = geometry
+        reason = "strong current image geometry disagrees with coarse structural answer"
+    elif hint == "row_list" and topic in ("conversation", "code_editor"):
+        selected = topic
+        reason = "list arrangement refined by independently observed content type"
+    # Metadata is available and saved, but never overrides current layout.
+    decision = {"layout_raw": layout_answer, "layout_hint": hint, "content_hint": topic,
+                "pixel_layout": geometry, "selected": selected, "reason": reason,
+                "known_context": metadata_context(metadata), "metadata_can_force_template": False,
+                "substantial_blocks": len(blocks), "card_candidates": len(cards),
+                "layout_disagrees": hint != "unknown" and hint != selected}
+    return selected, decision, blocks, dominant
+
+
+def safe_horizontal_cut(target, x0, x1, y0, y1, lines):
+    """Prefer a nearby text-free boundary. This does not claim semantic post boundaries."""
+    candidates = []
+    for line in lines:
+        b = line_box(line)
+        if b[2] > x0 and b[0] < x1 and y0 < b[1] < y1:
+            candidates.extend([b[1]-2, b[3]+2])
+    radius = (y1-y0)*.07
+    options = [target] + [v for v in candidates if abs(v-target) <= radius]
+    def cost(y):
+        crossings = sum(b[1] < y < b[3] for b in (line_box(line) for line in lines)
+                        if b[2] > x0 and b[0] < x1)
+        return crossings, abs(y-target)
+    return min(options, key=cost)
+
+
+def make_plan(rgb, content_answer, layout_answer, metadata, full_text=(), *, max_crops=8):
+    # Eight remains the API default so archived v1 runs can be reproduced.
+    # Test-Layout explicitly selects the new fifteen-crop research ceiling.
+    if type(max_crops) is not int or not 1 <= max_crops <= 15:
+        raise ValueError("Crop budget must be an integer from 1 to 15")
+    h, w = rgb.shape[:2]
+    if h < 1 or w < 1:
+        raise ValueError("Empty image")
+    selected, decision, blocks, dominant = select_template(rgb, content_answer, layout_answer, metadata)
+    anchors = []
+
+    def add(key, role, box, *, parent="window", question="interface", attached_to=None, origin="relative_template"):
+        if len(anchors) >= max_crops:
+            return False
+        box = clamp(box, w, h)
+        anchors.append({"id": key, "parent": parent, "role": role, "box_px": box,
+                        "bounds": [box[0]/w, box[1]/h, box[2]/w, box[3]/h],
+                        "visual": True, "ocr": True, "question_kind": question,
+                        "attached_to": attached_to, "source": origin, "verified": False})
+        return True
+
+    if selected == "large_panel":
+        # Not restricted to center-left: use the detected box wherever it is.
+        main = max(dominant, key=area) if dominant else [0, 0, w, h]
+        decision["main_box_source"] = "detected_pixels" if dominant else "full_view_fallback_not_detected"
+        x0, y0, x1, y1 = main
+        mw, mh = x1-x0, y1-y0
+        add("01-main", "main_visual", main, question="subject", origin=decision["main_box_source"])
+        add("02-left", "main_subject_detail", [x0, y0, x0+mw*.68, y1], parent="01-main", question="appearance")
+        add("03-right", "main_surroundings_detail", [x0+mw*.38, y0, x1, y1], parent="01-main", question="surroundings")
+        add("04-center", "main_subject_detail", [x0+mw*.10, y0+mh*.03, x0+mw*.86, y0+mh*.97], parent="01-main", question="posture")
+        # Inspect both available title bands, independent of hostname or URL path.
+        if y0 > h*.07:
+            add("05-above", "heading_candidate", [x0, max(0, y0-h*.085), x1, y0], attached_to="01-main")
+        if h-y1 > h*.06:
+            add("06-below", "heading_candidate", [x0, y1, x1, min(h, y1+h*.075)], attached_to="01-main")
+    elif selected == "card_grid":
+        banners = [b for b in blocks if b[2]-b[0] > w*.7 and (b[2]-b[0])/(b[3]-b[1]) > 3 and b[1] < h*.3]
+        banner = banners[0] if banners else wide_color_banner(rgb)
+        if banner:
+            add("01-banner", "banner", banner, question="banner", origin="detected_pixels")
+        cards = [b for b in blocks if b != banner and b[1] > (banner[3] if banner else h*.13)
+                 and .65 < (b[2]-b[0])/(b[3]-b[1]) < 2.6]
+        cards.sort(key=lambda b: (round(b[1]/max(1,h*.07)), b[0]))
+        ordered = []
+        if cards:
+            lead = max(cards, key=area)
+            sizes = sorted(area(b) for b in cards)
+            if area(lead) > sizes[len(sizes)//2]*1.8:
+                ordered.append(lead)
+            ordered.extend(b for b in cards if b not in ordered)
+        first = min((b[1] for b in cards), default=h*.22)
+        top = banner[3] if banner else h*.07
+        needs_nav = first-top > h*.025
+        card_limit = 5 if max_crops <= 8 else max_crops-len(anchors)-int(needs_nav)
+        for index, box in enumerate(ordered[:max(0,card_limit)], 2):
+            x0, y0, x1, y1 = box
+            below = [b[1] for b in cards if b[1] >= y1 and min(x1,b[2])-max(x0,b[0]) > (x1-x0)*.3]
+            bottom = max(y1, min(y1+h*.078, min(below)-5 if below else h))
+            add(f"{index:02d}-card", "content_card", [x0,y0,x1,bottom], question="card", origin="detected_pixels_with_caption_band")
+        if not ordered:
+            # Relative fallback only; not advertised as detected card boundaries.
+            columns = 1 if w/h < .75 else 2 if w/h < 1.3 else 3
+            for index in range(min(6, columns*2)):
+                col, row = index % columns, index // columns
+                add(f"{index+2:02d}-grid-region", "grid_region", [w*col/columns,h*(.22+row*.38),w*(col+1)/columns,h*(.62+row*.38)], question="interface")
+        if needs_nav and len(anchors) < max_crops:
+            add("08-navigation", "navigation", [w*.02, top, w*.98, first-3])
+        decision["uninspected_card_candidates"] = max(0,len(cards)-sum(a["role"]=="content_card" for a in anchors))
+    elif selected == "conversation":
+        pane = workspace_bounds(rgb)
+        add("01-pane", "message_pane", pane, question="interface", origin="panel_separator_heuristic")
+        embed_limit = 3 if max_crops <= 8 else max(0,max_crops-3)
+        for index, box in enumerate(embedded_blocks(rgb,pane)[:embed_limit],2):
+            add(f"{index:02d}-embedded", "embedded_image", box, parent="01-pane", question="embedded", origin="detected_bright_components")
+        # Main message pane already gets full OCR; headers and navigation are separate.
+        add("05-heading", "heading_candidate", [pane[0],h*.025,w*.98,h*.08], attached_to="01-pane")
+        add("06-navigation", "navigation", [0,h*.025,max(w*.08,pane[0]),h*.92])
+    elif selected in ("row_list", "document"):
+        x0,x1,y0,y1 = w*.035,w*.965,h*.12,h*.98
+        add("01-heading", "heading_candidate", [0,0,w,h*.16])
+        # Overlap adjacent text bands and snap near OCR gaps, instead of cutting a text line in half.
+        cuts=[y0]+[safe_horizontal_cut(y0+(y1-y0)*i/3,x0,x1,y0,y1,full_text) for i in (1,2)]+[y1]
+        for index in range(3):
+            add(f"{index+2:02d}-text-band", "list_band" if selected=="row_list" else "document_band",
+                [x0,max(y0,cuts[index]-h*.018),x1,min(y1,cuts[index+1]+h*.018)])
+        illustrations=[b for b in blocks if .015 < area(b)/(w*h) < .3 and b[1]>h*.15]
+        for index,box in enumerate(illustrations[:2],5):
+            add(f"{index:02d}-illustration", "embedded_image", box, question="embedded", origin="detected_pixels")
+    elif selected == "code_editor":
+        # Generic IDE panes, not an application-name preset. Positions are hypotheses.
+        for key,role,box in [
+            ("01-editor","editor",[w*.18,h*.08,w*.99,h*.76]),
+            ("02-terminal","terminal_candidate",[w*.18,h*.69,w*.99,h*.99]),
+            ("03-navigation","navigation",[0,h*.05,w*.24,h*.98]),
+            ("04-heading","heading_candidate",[0,0,w,h*.10])]:
+            add(key,role,box)
+    else:
+        for index,box in enumerate([[0,0,w,h*.24],[0,h*.18,w*.62,h*.68],
+                                   [w*.38,h*.18,w,h*.68],[0,h*.60,w,h]],1):
+            add(f"{index:02d}-generic","unknown_region",box)
+        # Supplemental local pictures only when actual pixel blocks exist.
+        # No requirement to fill all fifteen slots on an empty/uncertain page.
+        if max_crops > 8:
+            for index,box in enumerate(blocks,5):
+                if .008 < area(box)/(w*h) < .3 and box not in [a["box_px"] for a in anchors]:
+                    add(f"{index:02d}-local-detail","embedded_image",box,question="embedded",
+                        origin="detected_pixels_in_generic_fallback")
+
+    if len(anchors)>max_crops:
+        raise ValueError("Independent crop budget exceeded")
+    return {"revision":"structural-dual-v2", "layout":selected, "decision":decision,
+            "width":w,"height":h,"anchors":anchors,"detected_image_blocks":blocks,
+            "max_crops":max_crops,"visual_call_limit":2+max_crops,"ocr_call_limit":1+max_crops,
+            "unused_crop_slots":max_crops-len(anchors),
+            "overview_calls":2,"visual_request_count":2+len(anchors),
+            "distinct_views_including_overview":1+len(anchors),
+            "ocr_request_count":1+len(anchors),
+            "routing_scope":"recomputed_from_current_screenshot; no website-template binding"}
