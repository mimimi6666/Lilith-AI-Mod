+def _text_observation(value, marker):
+    """Inspect known text shapes only; never stringify arbitrary SDK objects."""
+    if type(value) is str:
+        return {"status": "text", "chars": len(value),
+                "marker": marker in value, "prefix": _PREFIX in value.lower(),
+                "marker_count": value.count(marker), "prefix_count": value.lower().count(_PREFIX)}
+    if value is None:
+        return {"status": "absent", "chars": 0, "marker": False, "prefix": False,
+                "marker_count": 0, "prefix_count": 0}
+    return {"status": "unavailable", "chars": None, "marker": None, "prefix": None,
+            "marker_count": None, "prefix_count": None}
+
+
+def _request_text_observation(value, marker, contract):
+    data = _text_observation(value, marker)
+    if type(value) is str:
+        data.update(reminder_header=_REMINDER_HEADER in value, contract_exact=contract in value)
+    elif value is None:
+        data.update(reminder_header=False, contract_exact=False)
+    else:
+        data.update(reminder_header=None, contract_exact=None)
+    return data
+
+
+def _content_observation(value, marker, contract):
+    if type(value) is not list:
+        return _request_text_observation(value, marker, contract)
+    rows = []
+    for part in value:
+        kind = part.get("type") if type(part) is dict else None
+        if type(kind) is str and kind == "text":
+            rows.append(_request_text_observation(part.get("text"), marker, contract))
+        elif type(kind) is str and kind in {"image_url", "input_audio", "file"}:
+            # Deliberately do not inspect URLs, bytes, file names or metadata.
+            continue
+        else:
+            return _request_text_observation(object(), marker, contract)
+    return _combined_observation(rows, "text_parts", request=True)
+
+
+def _combined_observation(rows, status, *, request=False):
+    if any(row["status"] == "unavailable" for row in rows):
+        data = {"status": "unavailable", "chars": None, "marker": None, "prefix": None,
+                "marker_count": None, "prefix_count": None}
+        if request:
+            data.update(reminder_header=None, contract_exact=None)
+        return data
+    data = {"status": status, "chars": sum(row["chars"] for row in rows),
+            "marker": any(row["marker"] for row in rows), "prefix": any(row["prefix"] for row in rows),
+            "marker_count": sum(row["marker_count"] for row in rows),
+            "prefix_count": sum(row["prefix_count"] for row in rows)}
+    if request:
+        data.update(reminder_header=any(row["reminder_header"] for row in rows),
+                    contract_exact=any(row["contract_exact"] for row in rows))
+    return data
+
+
+def _observation_envelope(state, stage):
+    # Independent diagnostic correlation only: never log the speech nonce,
+    # session/turn identity, provider name, endpoint, prompt or response text.
+    if not hasattr(state, "_wire_observation_id"):
+        state._wire_observation_id = uuid.uuid4().hex
+        state._wire_observation_attempt = 0
+    return {"stage": stage, "observation": state._wire_observation_id,
+            "attempt": state._wire_observation_attempt}
+
+
+def _emit_observation(data):
+    logger.info("paired_speech_wire %s", json.dumps(data, sort_keys=True, separators=(",", ":")))
+
+
+def observe_chat_sdk_request(agent, create, request):
+    """Observe the final native-dispatch callback, then invoke the SDK once.
+
+    This is the chat SDK boundary, NOT raw HTTP. A built-in provider adapter
+    may still convert the request below this point. Observations never grant
+    authority, change request data, consume an iterator, retry or wrap results.
+    """
+    try:
+        state = state_for(agent)
+        if state is not None:
+            data = _observation_envelope(state, "chat_sdk_request")
+            state._wire_observation_attempt += 1
+            data["attempt"] = state._wire_observation_attempt
+            messages = request.get("messages") if type(request) is dict else None
+            contract = state.instruction()
+            unavailable = _request_text_observation(object(), state.open_tag, contract)
+            all_rows = []
+            final_user = None
+            data.update(message_count=None, final_user_index=None, final_role="unavailable")
+            if type(messages) is list:
+                data["message_count"] = len(messages)
+                for index, row in enumerate(messages):
+                    if type(row) is not dict:
+                        all_rows.append(unavailable)
+                        data["final_role"] = "unavailable"
+                        continue
+                    stats = _content_observation(row.get("content"), state.open_tag, contract)
+                    all_rows.append(stats)
+                    role = row.get("role")
+                    data["final_role"] = role if type(role) is str and role in {
+                        "system", "developer", "user", "assistant", "tool", "function"} else "unavailable"
+                    if type(role) is str and role == "user":
+                        final_user = stats
+                        data["final_user_index"] = index
+                data["messages"] = _combined_observation(all_rows, "messages", request=True)
+                data["final_user"] = final_user if final_user is not None else {**unavailable, "status": "absent"}
+            else:
+                data["messages"] = unavailable
+                data["final_user"] = unavailable
+            data["stream"] = request.get("stream") if type(request) is dict and type(request.get("stream")) is bool else None
+            _emit_observation(data)
+    except Exception:
+        # Even a broken logger or hostile diagnostic field must not change the
+        # original SDK call/return/exception, and no exception text is logged.
+        pass
+    return create(**request)
+
+
+def _observe_normalized_response(state, message, finish_reason, *, after_strip=False):
+    try:
+        data = _observation_envelope(state, "normalized_poststrip" if after_strip else "normalized_prestrip")
+        data["content"] = _text_observation(message.content, state.open_tag)
+        if not after_strip:
+            data["reasoning_content"] = _text_observation(getattr(message, "reasoning_content", None), state.open_tag)
+            data["reasoning"] = _text_observation(getattr(message, "reasoning", None), state.open_tag)
+        data["finish"] = finish_reason if type(finish_reason) is str and finish_reason in {
+            "stop", "tool_calls", "length", "incomplete", "content_filter", "function_call"} else "other"
+        _emit_observation(data)
+    except Exception:
+        pass
+
+
 def accept_response(agent, message, finish_reason):
     state = state_for(agent)
     if state is not None:
+        _observe_normalized_response(state, message, finish_reason)
         # Match the existing display normalizer before pairing; inline thinking
         # is neither the visible answer nor material to speak aloud.
         strip_thinking = getattr(agent, "_strip_think_blocks", None)
         if isinstance(message.content, str) and callable(strip_thinking):
             message.content = strip_thinking(message.content).strip()
+        _observe_normalized_response(state, message, finish_reason, after_strip=True)
         message.content = state.accept(message.content, has_tools=bool(message.tool_calls), finish_reason=finish_reason)
         # Closed reasons and lengths only: no raw output, nonce, prompt, keys,
         # reasoning or endpoint details. Distinguish missing scripts from TTS.
