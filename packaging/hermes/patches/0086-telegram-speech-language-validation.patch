+"""Synthetic language regressions; no real account, speech service or send."""
+from contextvars import ContextVar
+import json
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent import speech_projection as projection, lilith_telegram_tts as voice
+from tests.gateway.test_lilith_telegram_voice import (
+    _speech_agent, _speech_response, profile, fake_http, _commit_language, runner, source,
+)
+
+
+@pytest.mark.parametrize("source,spoken,locale,valid", [
+    ("我愛你。", "愛してる。", "ja", True),
+    ("我愛你。", "我愛你。", "ja", False),
+    ("我愛你。", "我愛你だよ。", "ja", False),
+    ("我愛你。", "我愛你ー・゙。", "ja", False),
+    ("我愛你。明天見。", "愛してる。明天見。", "ja", False),
+    ("再見。", "さようなら。I will miss you.", "ja", False),
+    ("你好。", "你好。I will miss you.", "zh", False),
+    ("你好。", "你好。", "zh", True),
+    ("愛してる。", "我愛你。", "zh", True),
+    ("愛してる。", "愛してる。", "zh", False),
+    ("おはよう。", "おはよう。", "ja", True),
+    ("今天很開心。", "今日は楽しかった。", "ja", True),
+    ("莉莉絲喜歡 Spotify。", "リリスはSpotifyが好き。", "ja", True),
+    ("Spotifyが好き。", "我喜歡 Spotify。", "zh", True),
+    ("莉莉絲。", "莉莉絲。", "ja", False),
+    ("莉莉絲。", "ﾘﾘｽ。", "ja", True),
+    ("你好。", "hello", "ja", False),
+    ("你好。", "hello", "zh", False),
+    ("123", "１２３", "ja", True),
+    ("123", "123", "zh", True),
+    ("再見。", "♥ …", "ja", False),
+], ids=["translated-ja", "copied-zh", "token-suffix", "marks-not-kana", "mixed-sentence",
+        "english-after-ja", "english-after-zh", "same-zh", "translated-zh", "copied-ja", "same-ja",
+        "kanji-with-kana", "proper-name-ja", "proper-name-zh", "ambiguous-han", "halfwidth-kana",
+        "english-ja", "english-zh", "digits-ja", "digits-zh", "punctuation"])
+def test_conservative_language_guard(source, spoken, locale, valid):
+    assert (projection._speech_language_issue(source, spoken, locale) is None) is valid
+
+
+def _install(monkeypatch, outputs, on_call=None):
+    agent = _speech_agent(monkeypatch)
+    snapshot = projection.capture_speech_projection(agent)
+    calls = []
+    ambient = ContextVar("synthetic-approval-for-language-test", default=None)
+
+    def call(**kwargs):
+        assert ambient.get() is None
+        calls.append(kwargs)
+        if on_call:
+            on_call(len(calls), kwargs)
+        index = min(len(calls) - 1, len(outputs) - 1)
+        return _speech_response({"speech_text": outputs[index]})
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", call)
+    return agent, snapshot, calls, ambient
+
+
+def test_wrong_language_retries_once_on_same_route_from_original(monkeypatch):
+    source = "我愛你。今天和你聊天很開心。"
+    japanese = "愛してる。今日はあなたと話せてうれしかった。"
+    def mutate_agent(_count, kwargs):
+        assert kwargs["main_runtime"]["provider"] == "future-provider"
+        agent.provider, agent.model = "different-provider", "different-model"
+        kwargs["main_runtime"]["provider"] = "cannot-poison-next-call"
+    agent, snapshot, calls, ambient = _install(monkeypatch, [source, japanese], mutate_agent)
+    clock = [100.0]
+    monkeypatch.setattr(projection.time, "monotonic", lambda: clock[0])
+    # Install the clock tick without changing the captured route.
+    provider = __import__("agent.auxiliary_client", fromlist=["call_llm"])
+    first = provider.call_llm
+    def timed(**kwargs):
+        result = first(**kwargs)
+        clock[0] += 10.0
+        return result
+    monkeypatch.setattr(provider, "call_llm", timed)
+    token = ambient.set("must remain outside formatter")
+    try:
+        assert projection.project_speech(snapshot, source, speech_locale="ja") == japanese
+        assert ambient.get() == "must remain outside formatter"
+    finally:
+        ambient.reset(token)
+    assert len(calls) == 2
+    assert [call["timeout"] for call in calls] == [60.0, 50.0]
+    for call in calls:
+        assert call["main_runtime"]["model"] == "frozen-model"
+        assert call["main_runtime"]["session_id"] == "exact-native-session"
+        assert call["task"] is None and call["tools"] is None and call["stream"] is False
+        assert call["reasoning_config"] == {"enabled": False}
+        assert [m["role"] for m in call["messages"]] == ["system", "user"]
+        assert call["messages"][1]["content"][1]["text"] == source
+        assert "speech target is Japanese" in call["messages"][0]["content"]
+    assert "Previous translation failed" not in calls[0]["messages"][1]["content"][0]["text"]
+    assert "Previous translation failed" in calls[1]["messages"][1]["content"][0]["text"]
+
+
+@pytest.mark.parametrize("locale,source,translated", [
+    ("ja", "我愛你。", "愛してる。"), ("zh", "愛してる。", "我愛你。"),
+])
+def test_valid_translation_needs_no_retry(monkeypatch, locale, source, translated):
+    _, snapshot, calls, _ = _install(monkeypatch, [translated])
+    assert projection.project_speech(snapshot, source, speech_locale=locale) == translated
+    assert len(calls) == 1
+
+
+def test_wrong_language_twice_never_returns_original(monkeypatch):
+    _, snapshot, calls, _ = _install(monkeypatch, ["我愛你。"])
+    with pytest.raises(ValueError, match="requested language"):
+        projection.project_speech(snapshot, "我愛你。", speech_locale="ja")
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize("expire_after,second_output", [(1, "我愛你。"), (2, "愛してる。")])
+def test_shared_deadline_cannot_expand_for_retry(monkeypatch, expire_after, second_output):
+    clock = [0.0]
+    monkeypatch.setattr(projection.time, "monotonic", lambda: clock[0])
+    def expire(count, _kwargs):
+        clock[0] = 61.0 if count == expire_after else 10.0
+    _, snapshot, calls, _ = _install(monkeypatch, ["我愛你。", second_output], expire)
+    with pytest.raises(TimeoutError, match="deadline"):
+        projection.project_speech(snapshot, "我愛你。", speech_locale="ja")
+    assert len(calls) == expire_after
+
+
+@pytest.mark.parametrize("failure", [TimeoutError("synthetic-timeout"), ValueError("synthetic-provider-error")])
+def test_network_and_provider_failure_are_not_translation_retries(monkeypatch, failure):
+    def fail(_count, _kwargs):
+        raise failure
+    _, snapshot, calls, _ = _install(monkeypatch, ["我愛你。"], fail)
+    with pytest.raises(type(failure)):
+        projection.project_speech(snapshot, "我愛你。", speech_locale="ja")
+    assert len(calls) == 1
+
+
+@pytest.mark.parametrize("change", ["cancel", "scope", "profile", "identity"])
+def test_no_retry_after_cancellation_or_authority_change(profile, monkeypatch, change):
+    _commit_language("Japanese")
+    selected = voice.read_snapshot()
+    cancelled = threading.Event()
+    allowed = [True]
+    def invalidate(_count, _kwargs):
+        if change == "cancel": cancelled.set()
+        if change == "scope": allowed[0] = False
+        if change == "profile": _commit_language("TraditionalChinese")
+        if change == "identity":
+            monkeypatch.setattr("agent.identity_policy.bind_host_required_auxiliary_messages",
+                                lambda _: [{"role": "system", "content": "different"}])
+    _, snapshot, calls, _ = _install(monkeypatch, ["我愛你。"], invalidate)
+    cancel_token = voice._CANCELLED.set(cancelled)
+    try:
+        with voice.voice_scope(allowed=lambda: allowed[0], profile=selected):
+            current = voice.capture_speech_current(selected)
+            with pytest.raises(ValueError, match="changed"):
+                projection.project_speech(snapshot, "我愛你。", speech_locale="ja", is_current=current)
+    finally:
+        voice._CANCELLED.reset(cancel_token)
+    assert len(calls) == 1
+
+
+@pytest.mark.parametrize("repair", [True, False])
+def test_native_provider_receives_only_validated_translation(profile, tmp_path, monkeypatch, repair):
+    _commit_language("Japanese")
+    seen = fake_http(monkeypatch)
+    source, translated = "我愛你。", "愛してる。"
+    _, snapshot, calls, _ = _install(monkeypatch, [source, translated if repair else source])
+    @voice.project_speech_operation
+    def synthesize(text):
+        path = voice.LilithGptSovitsProvider().synthesize(text, str(tmp_path / "voice.wav"))
+        return json.dumps({"success": True, "file_path": path})
+    with voice.voice_scope(projector=lambda text, selected: projection.project_speech(
+        snapshot, text, speech_locale=selected["locale"], is_current=voice.capture_speech_current(selected)
+    )):
+        result = json.loads(synthesize(source))
+    assert len(calls) == 2
+    requests = [row[2] for row in seen if isinstance(row, tuple) and row[0] == "POST"]
+    if repair:
+        assert result["success"] is True and len(requests) == 1
+        assert requests[0]["text"] == translated
+        assert requests[0]["text_lang"] == requests[0]["prompt_lang"] == "ja"
+    else:
+        assert result == {"success": False, "error": "Lilith speech projection is unavailable"}
+        assert not requests
+
+
+def test_game_rpc_rejects_wrong_language_without_history_mutation(monkeypatch):
+    from tests.tui_gateway.test_speech_projection import _install_session, _attest_session
+    from tui_gateway import server
+    agent, _, calls, _ = _install(monkeypatch, ["我愛你。"])
+    session, before = _install_session(monkeypatch, agent)
+    _attest_session(monkeypatch, session)
+    result = server._methods["prompt.project_speech"]("wrong-language", {
+        "session_id": "exact-native-session", "text": "我愛你。",
+        "display_locale": "zh-Hant", "speech_locale": "ja",
+    })
+    assert "error" in result and "result" not in result
+    assert session["history"] == before and len(calls) == 2
+
+
+@pytest.mark.parametrize("entry", ["tool", "final"])
