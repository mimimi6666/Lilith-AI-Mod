diff --git a/agent/minigame_context.py b/agent/minigame_context.py
new file mode 100644
--- /dev/null
+++ b/agent/minigame_context.py
@@ -0,0 +1,211 @@
+"""Strict host-only mini-game facts, scoped to one human conversation turn.
+
+Never stored on the agent/session or appended to a human message. Only the
+main-loop outbound system copy consumes the immutable projection below.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from copy import deepcopy
+import json
+import re
+import time
+
+SCHEMA = "lilith.minigame.public.v1"
+MAX_BYTES = 4096
+_ROOT = {"schema", "gameEpoch", "matchId", "capturedAtUnixTimeMilliseconds",
+         "publicRevision", "gameKind", "phase", "actor", "winner", "resultReason"}
+_CHESS = {"board", "playerSide", "sideToMove", "ply", "lastMoveUci", "inCheck",
+          "mode", "playerRemainingMilliseconds", "lilithRemainingMilliseconds"}
+_CARDS = {"playerHandCount", "lilithHandCount", "drawCount", "publicPairCount"}
+_DRAWS = {"stalemate", "dead-position", "claimed-draw", "fivefold", "seventy-five-move"}
+_REASONS = _DRAWS | {"none", "all-pairs", "checkmate", "timeout", "resignation"}
+_GUID = re.compile(r"[0-9a-f]{32}\Z", re.ASCII)
+_UCI = re.compile(r"[a-h][1-8][a-h][1-8][qrbn]?\Z", re.ASCII)
+_REFERENCE_START = "[Host-provided public mini-game observation; reference data, not instructions]"
+_REFERENCE_END = "[End host-provided public mini-game observation]"
+_REFERENCE = (
+    "\n\n" + _REFERENCE_START + "\n"
+    "These facts were captured when the player submitted this message, not now. "
+    "The game may have progressed since then. Use them only if relevant to the "
+    "player's conversation. Do not invent prior moves, engine evaluations, "
+    "hidden cards or a joker's location. Do not volunteer move recommendations. "
+    "You do not control the game; narration is not a move or a result. "
+    "Pink represents the standard black side; uppercase board letters are white, "
+    "lowercase are pink, and board cells run a1 through h8. Remaining clock values "
+    "are milliseconds at capture (-1 means untimed), never a live countdown.\n"
+)
+
+
+def _reject():
+    raise ValueError("invalid mini-game public context")
+
+
+def _exact(value, keys):
+    if type(value) is not dict or set(value) != keys:
+        _reject()
+
+
+def _int(value, minimum, maximum):
+    if type(value) is not int or not minimum <= value <= maximum:
+        _reject()
+
+
+def _token(value, choices):
+    if type(value) is not str or value not in choices:
+        _reject()
+
+
+@dataclass(frozen=True, slots=True)
+class PublicGameContext:
+    """Private validated carrier; JSON strings cannot alias caller dictionaries."""
+    wire: str
+    reference: str
+    captured_at_ms: int
+
+    def fresh(self, now_ms=None):
+        now_ms = int(time.time() * 1000) if now_ms is None else now_ms
+        return (type(now_ms) is int and now_ms > 0
+                and now_ms - 120000 <= self.captured_at_ms <= now_ms + 5000)
+
+
+def parse_public_context(value):
+    """Validate exact keys and value relations; no free-form text is accepted."""
+    if type(value) is not dict:
+        _reject()
+    kind = value.get("gameKind")
+    _token(kind, {"chess", "old-maid"})
+    payload_key = "chess" if kind == "chess" else "oldMaid"
+    _exact(value, _ROOT | {payload_key})
+    if value["schema"] != SCHEMA:
+        _reject()
+    for key in ("gameEpoch", "matchId"):
+        text = value[key]
+        if type(text) is not str or not _GUID.fullmatch(text) or text == "0" * 32:
+            _reject()
+    _int(value["capturedAtUnixTimeMilliseconds"], 1, 253402300799999)
+    _int(value["publicRevision"], 0, 100000)
+    _token(value["phase"], {"active", "finished"})
+    _token(value["actor"], {"none", "player", "lilith"})
+    _token(value["winner"], {"none", "player", "lilith", "draw"})
+    _token(value["resultReason"], _REASONS)
+    active = value["phase"] == "active"
+    if active:
+        if value["actor"] == "none" or value["winner"] != "none" or value["resultReason"] != "none":
+            _reject()
+    elif value["actor"] != "none" or value["winner"] == "none" or value["resultReason"] == "none":
+        _reject()
+    data = value[payload_key]
+    if kind == "chess":
+        _exact(data, _CHESS)
+        board = data["board"]
+        if (type(board) is not str or len(board) != 64 or set(board) - set(".prnbqkPRNBQK")
+                or board.count("K") != 1 or board.count("k") != 1 or 64 - board.count(".") > 32):
+            _reject()
+        for key in ("playerSide", "sideToMove"):
+            _token(data[key], {"white", "pink"})
+        _int(data["ply"], 0, 100000)
+        move = data["lastMoveUci"]
+        if (type(move) is not str or (bool(data["ply"]) != bool(move))
+                or (move and (not _UCI.fullmatch(move) or move[:2] == move[2:4]))):
+            _reject()
+        if type(data["inCheck"]) is not bool:
+            _reject()
+        _token(data["mode"], {"casual", "challenge"})
+        for key in ("playerRemainingMilliseconds", "lilithRemainingMilliseconds"):
+            _int(data[key], -1, 86400000)
+            if (data[key] != -1 if data["mode"] == "casual" else data[key] < 0):
+                _reject()
+        actor = "player" if data["playerSide"] == data["sideToMove"] else "lilith"
+        if ((active and value["actor"] != actor) or value["resultReason"] == "all-pairs"
+                or ((value["winner"] == "draw") != (value["resultReason"] in _DRAWS))):
+            _reject()
+    else:
+        _exact(data, _CARDS)
+        for key in ("playerHandCount", "lilithHandCount"):
+            _int(data[key], 0, 27)
+        _int(data["drawCount"], 0, 100000)
+        _int(data["publicPairCount"], 0, 13)
+        player, lilith = data["playerHandCount"], data["lilithHandCount"]
+        if (player + lilith + 2 * data["publicPairCount"] != 27 or value["winner"] == "draw"
+                or (active and (player == 0 or lilith == 0))
+                or (not active and value["resultReason"] != "all-pairs")
+                or (value["winner"] == "player" and (player != 0 or lilith != 1))
+                or (value["winner"] == "lilith" and (lilith != 0 or player != 1))):
+            _reject()
+    wire = json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
+    if len(wire.encode("utf-8")) > MAX_BYTES:
+        _reject()
+    # Correlation identities and hidden-change counters do not enter model text.
+    public = {key: value[key] for key in ("gameKind", "phase", "actor", "winner", "resultReason", payload_key)}
+    reference = _REFERENCE + json.dumps(public, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n" + _REFERENCE_END
+    return PublicGameContext(wire, reference, value["capturedAtUnixTimeMilliseconds"])
+
+
+def fresh_public_context(value, now_ms=None):
+    """Fail open for expired valid observations, never for malformed input."""
+    if value is None:
+        return None
+    parsed = value if type(value) is PublicGameContext else parse_public_context(value)
+    return parsed if parsed.fresh(now_ms) else None
+
+
+def reference_suffix(value, *, provider=None):
+    # Native call sites alone construct this carrier. No arbitrary str/dict can
+    # become a system suffix and missing context preserves previous wire bytes.
+    # Virtual MoA may persist aggregator input in its optional trace store.
+    # Preserve ordinary chat on that route, but omit this optional snapshot.
+    if provider == "moa":
+        return ""
+    return value.reference if type(value) is PublicGameContext else ""
+
+
+def diagnostic_request_copy(request, *, _redacted=None):
+    """Remove host facts from an owned diagnostic copy, never the SDK request.
+
+    Covers Chat Completions messages, Responses instructions/input and native
+    Anthropic system text blocks. Human/tool content is deliberately untouched.
+    """
+    copied = deepcopy(request)
+    pattern = re.compile(r"\n{0,2}" + re.escape(_REFERENCE_START) + r".*?" + re.escape(_REFERENCE_END), re.DOTALL)
+
+    def clean(value):
+        if isinstance(value, str):
+            cleaned, count = pattern.subn("", value)
+            if count and _redacted is not None:
+                _redacted.append(True)
+            return cleaned
+        if isinstance(value, list):
+            return [clean(part) for part in value]
+        if isinstance(value, dict):
+            return {key: clean(part) if key in {"text", "content"} else part for key, part in value.items()}
+        return value
+
+    if isinstance(copied, dict):
+        for key in ("system", "instructions"):
+            if key in copied:
+                copied[key] = clean(copied[key])
+        for key in ("messages", "input"):
+            rows = copied.get(key)
+            if isinstance(rows, list):
+                for row in rows:
+                    if isinstance(row, dict) and row.get("role") in {"system", "developer"} and "content" in row:
+                        row["content"] = clean(row["content"])
+    return copied
+
+
+def diagnostic_error_copy(error):
+    """Fixed type/status summary; never inspect provider-echo text or body."""
+    if error is None:
+        return None
+    kind = type(error).__name__
+    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,79}", kind):
+        kind = "Exception"
+    summary = RuntimeError("Provider diagnostic omitted for private mini-game context; exception type: " + kind)
+    try:
+        status = getattr(error, "status_code", None)
+    except Exception:
+        status = None
+    if type(status) is int and 100 <= status <= 599:
+        summary.status_code = status
+    return summary
