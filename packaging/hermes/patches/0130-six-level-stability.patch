+class ContextStrategyTests(unittest.TestCase):
+    def setUp(self):
+        # The native summary-scope function is exercised; identity is a synthetic
+        # immutable fixture, not a real dedicated profile or attestation read.
+        identity = SimpleNamespace(policy_for_agent=lambda agent: SimpleNamespace(enabled=False, fingerprint="fixture"))
+        self.identity_patch = patch.dict(sys.modules, {"agent.identity_policy": identity})
+        self.identity_patch.start()
+        self.addCleanup(self.identity_patch.stop)
+
+    def test_fifth_level_uses_request_only_summary_and_keeps_recent_history(self):
+        rows, units = transcript(48)
+        before = deepcopy(rows)
+        compressor = Compressor()
+        agent = SimpleNamespace(session_id="chat", context_compressor=compressor)
+        result = project_context(agent, rows, units, strategy_for_level(5), origin(5))
+        self.assertEqual(rows, before)
+        self.assertEqual(result[0], before[0])
+        self.assertEqual(result[-73:], before[-73:])
+        self.assertLess(len(result), len(rows))
+        self.assertEqual(len(compressor.calls), 1)
+        self.assertEqual(compressor.calls[0][1], strategy_for_level(5).summary_target_tokens)
+        self.assertEqual(compressor._previous_summary, "Native compressor state stays unchanged.")
+        self.assertEqual(agent._usage_budget_context_status["uncovered_turns_retained"], 0)
+
+    def test_repeated_requests_do_not_spend_a_second_summary_in_the_same_origin(self):
+        rows, units = transcript(48)
+        agent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+        handle = origin(5)
+        for _ in range(5):
+            project_context(agent, rows, units, strategy_for_level(5), handle)
+        self.assertEqual(len(agent.context_compressor.calls), 1)
+
+    def test_summary_failure_retains_every_uncovered_original(self):
+        class Failed:
+            def _generate_summary(self, rows):
+                raise RuntimeError("synthetic failure")
+        rows, units = transcript(48)
+        before = deepcopy(rows)
+        agent = SimpleNamespace(session_id="chat", context_compressor=Failed())
+        result = project_context(agent, rows, units, strategy_for_level(5), origin(5))
+        self.assertEqual(result, before)
+        self.assertEqual(rows, before)
+        self.assertGreater(agent._usage_budget_context_status["uncovered_turns_retained"], 0)
+
+    def test_background_projection_reuses_a_summary_without_another_model_call(self):
+        from agent.background_context import attach_summary, freeze_summary, ensure_background_projection
+        for level in (5, 6):
+            with self.subTest(level=level):
+                rows, units = transcript(72)
+                handle = origin(level)
+                strategy = strategy_for_level(level)
+                parent = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+                expected = project_context(parent, rows, units, strategy, handle)
+                with captured(handle):
+                    snapshot = freeze_summary(parent)
+                    self.assertIsNotNone(snapshot)
+                    child = SimpleNamespace(session_id="chat", context_compressor=Compressor())
+                    self.assertTrue(attach_summary(child, snapshot))
+                    actual = project_context(child, rows, units, strategy, handle)
+                    ensure_background_projection(child, SimpleNamespace(units=()), strategy)
+                self.assertEqual(actual, expected)
+                self.assertEqual(child.context_compressor.calls, [])
+
+    def test_unbound_fallback_alone_keeps_native_context(self):
+        rows, units = transcript(72)
+        agent = SimpleNamespace(session_id="chat")
+        self.assertIs(project_context(agent, rows, units, neutral_strategy(), origin(6)), rows)
+        self.assertFalse(hasattr(agent, "_information_summary"))
+
+    def test_six_uses_finite_request_projection_without_losing_originals(self):
+        rows, units = transcript(72)
+        original = deepcopy(rows)
+        agent = SimpleNamespace(session_id="chat-six", context_compressor=Compressor())
+        handle = origin(6)
+        result = project_context(agent, rows, units, strategy_for_level(6), handle)
+        self.assertEqual(rows, original)
+        self.assertEqual(result[-85:], original[-85:])
+        self.assertLess(len(result), len(rows))
+        self.assertEqual(agent.context_compressor.calls[0][1], 4550)
+        self.assertIsNone(handle.ledger.policy.turn_token_limit)
+        self.assertIsNone(handle.ledger.policy.max_iterations)
+        for _ in range(3):
+            project_context(agent, rows, units, strategy_for_level(6), handle)
+        self.assertEqual(len(agent.context_compressor.calls), 1)
+
+    def test_six_summary_failure_retains_originals_and_does_not_bypass_stop(self):
+        class Failed:
+            def _generate_summary(self, rows):
+                raise RuntimeError("synthetic unavailable")
+        rows, units = transcript(72)
+        original = deepcopy(rows)
+        agent = SimpleNamespace(session_id="chat-six", context_compressor=Failed())
+        handle = origin(6)
+        self.assertEqual(project_context(agent, rows, units, strategy_for_level(6), handle), original)
+        self.assertEqual(rows, original)
+        handle.ledger.stop()
+        with self.assertRaises(BudgetError):
+            handle.ledger.observe_attempt("after-stop")
+
+    def test_checkpoint_soft_size_and_batch_rules_use_the_selected_strategy(self):
+        for level in range(1, 7):
+            spec = strategy_for_level(level)
+            with self.subTest(level=level):
+                self.assertEqual(history_limit(spec), spec.history_turns * spec.old_tool_chars)
+                threshold = max(spec.summary_every, spec.history_turns // 4)
+                state = {"covered": (), "pending_covered": tuple(range(threshold - 1)), "pending_summary": "summary"}
+                self.assertEqual(publication_reason(state, [100] * threshold, spec), "staged")
+                state["pending_covered"] = tuple(range(threshold))
+                self.assertEqual(publication_reason(state, [100] * threshold, spec), "batch")
+                state["pending_covered"] = (0,)
+                self.assertEqual(publication_reason(state, [history_limit(spec) + 1], spec), "history_size")
+
+    def test_tool_projection_preserves_linkage_errors_and_original_storage(self):
+        chars = strategy_for_level(5).old_tool_chars
+        rows = [{"role": "assistant", "content": None, "tool_calls": [
+            {"id": "one", "type": "function", "function": {"name": "terminal", "arguments": "{}"}}]},
+                {"role": "tool", "tool_call_id": "one", "content": "x" * (chars * 2) + "ERROR: permission denied"}]
+        before = deepcopy(rows)
+        result = compact_results(rows, chars)
+        self.assertEqual(rows, before)
+        self.assertEqual(result[0], rows[0])
+        self.assertEqual(result[1]["tool_call_id"], "one")
+        self.assertTrue(result[1]["content"].endswith("ERROR: permission denied"))
+        self.assertIn("full result in chat history", result[1]["content"])
+
+
+if __name__ == "__main__":
+    unittest.main()
