+
+def _force_safe_terminal_error_text(value: Any) -> str:
+    """Force-redact and bound provider-controlled terminal text."""
+    text = _sanitize_surrogates(str(value or "").strip())
+    try:
+        from agent.redact import redact_sensitive_text
+
+        text = redact_sensitive_text(
+            text,
+            force=True,
+            redact_url_credentials=True,
+        )
+    except Exception:
+        return "The model request failed before an assistant response was returned."
+    if not text:
+        text = "The model request failed before an assistant response was returned."
+    if len(text) > _TERMINAL_ERROR_TEXT_MAX_CHARS:
+        text = text[: _TERMINAL_ERROR_TEXT_MAX_CHARS - 3].rstrip() + "..."
+    return text
+
+
+def _close_terminal_error_turn(
+    agent,
+    messages: List[Dict[str, Any]],
+    conversation_history: List[Dict[str, Any]],
+    final_response: Any,
+    *,
+    persist: bool,
+) -> bool:
+    """Close a terminal provider failure with a canonical assistant row.
+
+    A non-retryable provider error can happen before the provider returns any
+    assistant message. Persisting that user row alone lets a later model-switch
+    marker and the next prompt merge with the failed request during role repair.
+    The caller supplies the same sanitized text returned to the user, so the
+    transcript is closed without storing a second raw-error representation.
+
+    ``persist=False`` preserves the large-context-overflow policy: the live
+    result is safe for continuation, but the oversized failed turn is not
+    written to durable storage.
+    """
+    text = _force_safe_terminal_error_text(final_response)
+
+    tail = messages[-1] if messages and isinstance(messages[-1], dict) else None
+    turn_id = str(getattr(agent, "_current_turn_id", "") or "")
+    reusable_tail = bool(
+        tail is not None
+        and tail.get("role") == "assistant"
+        and not tail.get("_db_persisted")
+        and not tail.get("tool_calls")
+        and not tail.get("tool_call_id")
+        and tail.get("finish_reason")
+        not in {
+            "tool_calls",
+            "incomplete",
+            "verification_required",
+            "verify_hook_continue",
+            "kanban_terminal_required",
+        }
+    )
+    closed = False
+    if reusable_tail:
+        current = tail.get("content")
+        current_text = current if isinstance(current, str) else ""
+        if not current_text.strip():
+            tail["content"] = text
+            tail.pop("_db_persisted", None)
+            agent._db_flush_scan_prefix = None
+        elif text not in current_text:
+            tail["content"] = current_text.rstrip() + "\n\n" + text
+            tail.pop("_db_persisted", None)
+            agent._db_flush_scan_prefix = None
+        tail["_terminal_error_closed"] = True
+        metadata = dict(tail.get("display_metadata") or {})
+        if turn_id:
+            metadata["terminal_error_turn_id"] = turn_id
+        if metadata:
+            tail["display_metadata"] = metadata
+        closed = bool(turn_id)
+    elif (
+        tail is not None
+        and tail.get("role") == "assistant"
+        and tail.get("_db_persisted")
+    ):
+        # SessionDB is append-only. Mutating a durable assistant and flushing
+        # would append a second assistant row rather than update the old one.
+        # The existing assistant already separates this failed user from the
+        # next turn, so retain the error out-of-band instead of corrupting role
+        # alternation with another assistant row.
+        closed = False
+    else:
+        metadata = {"terminal_error_turn_id": turn_id} if turn_id else None
+        messages.append(
+            {
+                "role": "assistant",
+                "content": text,
+                "_terminal_error_closed": True,
+                **({"display_metadata": metadata} if metadata else {}),
+            }
+        )
+        closed = bool(turn_id)
+
+    if persist:
+        agent._persist_session(messages, conversation_history)
+    else:
+        agent._session_messages = messages
+    return closed
 
 
