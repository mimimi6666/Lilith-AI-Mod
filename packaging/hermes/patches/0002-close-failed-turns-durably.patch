+def _safe_turn_error(agent: Any, error: Any) -> str:
+    """Return one force-redacted, bounded gateway error string.
+
+    Provider exceptions can contain HTML, authorization headers, signed URLs,
+    or echoed request bodies. Every immediate event and retained resume record
+    crosses this funnel; protected local diagnostics may still record the full
+    traceback through the normal logging boundary.
+    """
+    raw = ""
+    if isinstance(error, BaseException):
+        summarize = getattr(agent, "_summarize_api_error", None)
+        if callable(summarize):
+            try:
+                raw = str(summarize(error) or "")
+            except Exception:
+                raw = ""
+        if not raw:
+            raw = str(error) or type(error).__name__
+    else:
+        raw = str(error or "")
+    if "<!doctype html" in raw.lower() or "<html" in raw.lower():
+        summarize = getattr(agent, "_summarize_api_error", None)
+        if callable(summarize):
