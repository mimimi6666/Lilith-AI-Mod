+def test_session_interrupt_emits_authoritative_info_after_stale_running_repair(
+    server, monkeypatch
+):
+    interrupted = []
+
+    class _Agent:
+        def interrupt(self):
+            interrupted.append(True)
+
+    session = {
+        "agent": _Agent(),
+        "history_lock": threading.Lock(),
+        "running": True,
+        "queued_prompt": "later",
+        "session_key": "session-key",
+        "inflight_turn": {"turn_id": "stale-turn"},
+        "_run_thread": None,
+    }
+    emitted = []
+    monkeypatch.setattr(server, "_tts_stream_stop", lambda: None)
+    monkeypatch.setattr(server, "_thinking_sound_stop", lambda: None)
+    monkeypatch.setattr(server, "_sess_nowait", lambda _params, _rid: (session, None))
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda _session: False)
+    monkeypatch.setattr(server, "_clear_pending", lambda _sid: None)
+    monkeypatch.setattr(
+        server,
+        "_session_info",
+        lambda agent, current: {
+            "running": current["running"],
+            "stored_session_id": current["session_key"],
+            "agent_matches": agent is current["agent"],
+        },
+    )
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload: emitted.append((event, sid, payload)),
+    )
+
+    response = server._methods["session.interrupt"](
+        "stop-stale", {"session_id": "ui-session"}
+    )
+
+    assert response["result"]["status"] == "interrupted"
+    assert interrupted == [True]
+    assert session["running"] is False
+    assert session["inflight_turn"] is None
+    assert emitted == [
+        (
+            "session.info",
+            "ui-session",
+            {
+                "running": False,
+                "stored_session_id": "session-key",
+                "agent_matches": True,
+            },
+        )
+    ]
+
+
+def test_session_interrupt_does_not_emit_idle_info_for_live_run_thread(
+    server, monkeypatch
+):
+    interrupted = []
+
+    class _Agent:
+        def interrupt(self):
+            interrupted.append(True)
+
+    class _LiveThread:
+        @staticmethod
+        def is_alive():
+            return True
+
+    inflight_turn = {"turn_id": "active-turn"}
+    session = {
+        "agent": _Agent(),
+        "history_lock": threading.Lock(),
+        "running": True,
+        "queued_prompt": None,
+        "session_key": "session-key",
+        "inflight_turn": inflight_turn,
+        "_run_thread": _LiveThread(),
+    }
+    monkeypatch.setattr(server, "_tts_stream_stop", lambda: None)
+    monkeypatch.setattr(server, "_thinking_sound_stop", lambda: None)
+    monkeypatch.setattr(server, "_sess_nowait", lambda _params, _rid: (session, None))
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda _session: False)
+    monkeypatch.setattr(server, "_clear_pending", lambda _sid: None)
+    monkeypatch.setattr(
+        server,
+        "_session_info",
+        lambda *_args: (_ for _ in ()).throw(
+            AssertionError("live interrupt projected idle session.info")
+        ),
+    )
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda *_args: (_ for _ in ()).throw(
+            AssertionError("live interrupt emitted terminal session.info")
+        ),
+    )
+
+    response = server._methods["session.interrupt"](
+        "stop-live", {"session_id": "ui-session"}
+    )
+
+    assert response["result"]["status"] == "interrupted"
+    assert interrupted == [True]
+    assert session["running"] is True
+    assert session["inflight_turn"] is inflight_turn
+
+
