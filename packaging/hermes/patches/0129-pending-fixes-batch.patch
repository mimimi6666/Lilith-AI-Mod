+
+    def test_ambiguous_duplicate_visual_fields_never_suppress_pixels(self):
+        for raw in (
+            '{"description":"A sufficiently long description.","sufficient":false,"sufficient":true}',
+            '{"description":"A sufficiently long description.","description":"Another interpretation.","sufficient":true}',
+            '{"description":"A sufficiently long description.","sufficient":true,"sufficient":true}',
+        ):
