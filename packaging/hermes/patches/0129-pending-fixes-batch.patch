@@ -0,0 +1,170 @@
+"""One authorized inbound attachment; no desktop selection, capture or consent changes."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import subprocess
+import tempfile
+import threading
+import time
+
+from .attachment_contract import MAX_BYTES, MAX_QUESTION, failure, validate_result
+
+
+def _plain(path):
+    path = Path(os.path.abspath(path))
+    for item in (path, *path.parents):
+        info = item.lstat()
+        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+            raise ValueError("linked_attachment")
+    return path
+
+
+def bound_home():
+    from hermes_constants import get_hermes_home
+    raw = os.environ.get("HERMES_LILITH_BOUND_HOME", "")
+    if not raw or not Path(raw).is_absolute():
+        raise ValueError("not_managed")
+    home = _plain(raw)
+    if os.path.normcase(str(home)) != os.path.normcase(os.path.abspath(get_hermes_home())):
+        raise ValueError("not_managed")
+    return home
+
+
+def snapshot_attachment(path, home):
+    """Read only one exact cache child, never an URL, arbitrary path or hardlink.
+
+    Match the opened file identity on both sides of the read before accepting
+    bytes. The worker receives an immutable private copy, never this path.
+    """
+    if not isinstance(path, str) or not Path(path).is_absolute() or "\x00" in path:
+        raise ValueError("invalid_attachment")
+    file = _plain(path)
+    home = _plain(home)
+    if (file.parent not in {home / "cache/images", home / "image_cache"}
+            or not re.fullmatch(r"img_[a-f0-9]{12}\.(?:jpg|jpeg|png|webp)", file.name)):
+        raise ValueError("invalid_attachment")
+
+    def identity(info):
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or not 0 < info.st_size <= MAX_BYTES:
+            raise ValueError("invalid_attachment")
+        return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns
+
+    before = identity(file.stat())
+    with file.open("rb") as stream:
+        if identity(os.fstat(stream.fileno())) != before:
+            raise ValueError("attachment_changed")
+        data = stream.read(MAX_BYTES + 1)
+        if identity(os.fstat(stream.fileno())) != before:
+            raise ValueError("attachment_changed")
+    if identity(_plain(file).stat()) != before or len(data) != before[2]:
+        raise ValueError("attachment_changed")
+    return data, hashlib.sha256(data).hexdigest()
+
+
+def analyze_attachment(path, question="", *, cancelled=lambda: False, timeout=80):
+    """Internal gateway seam; user attachment sharing does not enable the screen tool."""
+    if cancelled():
+        return failure("cancelled")
+    # Never decide that an image is sufficient for a silently truncated query.
+    if not isinstance(question, str) or len(question) > MAX_QUESTION or "\x00" in question:
+        return failure("insufficient")
+    try:
+        home = bound_home()
+    except Exception:
+        return failure("not_managed")
+    try:
+        data, image_sha256 = snapshot_attachment(path, home)
+    except Exception:
+        return failure("invalid_attachment")
+    from . import host
+    # Share the existing local-screen worker lane, not a second GPU queue.
+    if not host._busy.acquire(blocking=False):
+        return failure("busy")
+    process = job = None
+    stage = "dependency_unavailable"
+    try:
+        binding, python = host.configuration()
+        if cancelled():
+            return failure("cancelled")
+        with tempfile.TemporaryDirectory(prefix="lilith-local-attachment-") as scratch:
+            private = _plain(scratch)
+            image = private / "attachment.bin"
+            with image.open("xb") as stream:
+                stream.write(data)
+            del data
+            try:
+                stage = "worker_failed"
+                job = host.OwnedJob()
+                environment = dict(os.environ)
+                for name in tuple(environment):
+                    upper = name.upper()
+                    if upper.startswith(("LLAMA_", "MTMD_", "HF_", "PYTHON")) or any(
+                            word in upper for word in ("API_KEY", "TOKEN", "SECRET", "PASSWORD", "CREDENTIAL")):
+                        environment.pop(name, None)
+                environment.update(HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1",
+                    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK="True", TEMP=str(private), TMP=str(private),
+                    PADDLE_PDX_CACHE_HOME=str(private / "paddlex"), HF_HOME=str(private / "huggingface"),
+                    MPLCONFIGDIR=str(private / "matplotlib"), XDG_CACHE_HOME=str(private / "cache"))
+                process = subprocess.Popen([python, "-I", "-B", str(Path(__file__).with_name("attachment_worker.py"))],
+                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                    creationflags=subprocess.CREATE_NO_WINDOW, env=environment, cwd=private)
+                job.assign(process)
+                request = {"schema": 1, "binding": binding, "private": str(private),
+                           "image_sha256": image_sha256, "question": question}
+                process.stdin.write(json.dumps(request).encode("utf-8"))
+                process.stdin.close()
+                chunks, overflow = [], threading.Event()
+
+                def drain():
+                    total = 0
+                    while True:
+                        part = process.stdout.read(4096)
+                        if not part:
+                            break
+                        total += len(part)
+                        if total > 48_000:
+                            overflow.set()
+                            break
+                        chunks.append(part)
+
+                reader = threading.Thread(target=drain, daemon=True)
+                reader.start()
+                deadline = time.monotonic() + min(80, max(.1, timeout))
+                while process.poll() is None:
+                    if cancelled():
+                        return failure("cancelled")
+                    if overflow.is_set():
+                        return failure("worker_output_invalid")
+                    if time.monotonic() >= deadline:
+                        return failure("worker_timeout")
+                    time.sleep(.05)
+                reader.join(timeout=2)
+                if cancelled():
+                    return failure("cancelled")
+                if reader.is_alive() or overflow.is_set():
+                    return failure("worker_output_invalid")
+                stage = "worker_output_invalid"
+                value = json.loads(b"".join(chunks))
+                if process.returncode:
+                    return failure(value.get("code", "worker_failed") if isinstance(value, dict) else "worker_failed")
+                return validate_result(value, image_sha256)
+            finally:
+                # Close only this owned Job/process before deleting its private copy.
+                if job:
+                    job.close()
+                if process:
+                    if process.poll() is None:
+                        process.kill()
+                    process.wait(timeout=5)
+                    for stream in (process.stdin, process.stdout):
+                        if stream and not stream.closed:
+                            stream.close()
+    except Exception:
+        return failure(stage)
+    finally:
+        host._busy.release()
