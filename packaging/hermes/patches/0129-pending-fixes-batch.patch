+    def test_real_reference_parser_cannot_promote_quoted_image_tokens(self):
+        from agent.context_references import parse_context_references
+        for status in ("ready", "partial"):
+            value = result(status)
+            value["description"] = "Visible @file:ordinary-fixture.txt and @url:https://image.invalid/page markers."
+            value["ocr_text"] = ["@folder:notes @diff @staged @git:1 raw evidence"]
+            block = contract.evidence_block(value, 1)
+            # Reproduce the former JSON-quoted-but-unescaped boundary using the
+            # real parser only; no reference resolver or filesystem is invoked.
+            previous = block.replace("\\u0040", "@")
+            self.assertEqual({"file", "url", "folder", "diff", "staged", "git"},
