@@ -0,0 +1,73 @@
+"""Telegram request-only local-first evidence; the existing fallback remains caller-owned."""
+from __future__ import annotations
+
+import asyncio
+import logging
+import threading
+import time
+
+from tools.lilith_scene.attachment_contract import MAX_IMAGES, evidence_block, failure
+
+logger = logging.getLogger(__name__)
+
+
+async def preprocess_telegram_images(message_text, image_paths, source, *, cancelled=lambda: False):
+    """Called after native event authorization, never registered as a model tool.
+
+    Return (text, remaining_paths, metadata). Neither event media nor stored
+    history is mutated. Cache presence is never reported as local inference.
+    """
+    paths = list(image_paths)
+    if getattr(getattr(source, "platform", None), "value", getattr(source, "platform", None)) != "telegram":
+        return message_text, paths, {"route": "unchanged", "local": 0, "fallback": len(paths)}
+    from tools.lilith_scene.attachment_host import analyze_attachment, bound_home
+    try:
+        bound_home()
+    except Exception:
+        return message_text, paths, {"route": "unchanged", "code": "not_managed", "local": 0, "fallback": len(paths)}
+    stopped = threading.Event()
+    deadline = time.monotonic() + 90
+
+    def is_cancelled():
+        return stopped.is_set() or cancelled()
+
+    remaining, blocks, local, partial, codes = [], [], 0, 0, []
+    # The same path twice must not run another local model. Evidence is bound
+    # to this call only, never reused across users, turns or changed contents.
+    outcomes = {}
+    try:
+        for ordinal, path in enumerate(paths, 1):
+            if is_cancelled():
+                raise asyncio.CancelledError()
+            if path in outcomes:
+                value = outcomes[path]
+            elif len(outcomes) < MAX_IMAGES and time.monotonic() < deadline:
+                try:
+                    value = await asyncio.to_thread(analyze_attachment, path, message_text,
+                        cancelled=is_cancelled, timeout=min(80, deadline - time.monotonic()))
+                except Exception:
+                    value = failure("worker_failed")
+                outcomes[path] = value
+            else:
+                value = failure("busy")
+            if is_cancelled() or value.get("code") == "cancelled":
+                raise asyncio.CancelledError()
+            status = value.get("status")
+            code = value.get("code", "worker_failed")
+            codes.append(code)
+            if status in {"ready", "partial"}:
+                blocks.append(evidence_block(value, ordinal))
+            if status == "ready":
+                local += 1
+            else:
+                remaining.append(path)
+                partial += int(status == "partial")
+        route = "local_text" if not remaining else ("local_mixed_fallback" if local or partial else "existing_fallback")
+        metadata = {"route": route, "local": local, "partial": partial, "fallback": len(remaining), "codes": codes}
+        # Closed values/counts only: no path, caption, OCR, source account or pixel data.
+        logger.info("Image routing: local-first route=%s local=%d partial=%d fallback=%d codes=%s",
+                    route, local, partial, len(remaining), ",".join(codes))
+        return ("\n\n".join(blocks + [message_text]) if blocks else message_text), remaining, metadata
+    finally:
+        # asyncio task cancellation must also terminate the owned worker's loop.
+        stopped.set()
