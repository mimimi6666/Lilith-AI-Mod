+def _list_denial_families(text):
+    """An explicit finite game-field list and its immediately linked denial.
+
+    A bare 'these items are missing' is not authority to delete anything. The
+    complete list, link and denial must match together; an unrelated item,
+    assertion, quotation or modifier makes the entire construct ineligible.
+    """
+    who = r"(?:我|你|妳|誰|谁)"
+    by_family = {
+        "turn": r"(?:輪到誰|轮到谁)(?:抽牌|走棋|下棋|走)?|(?:誰|谁)的回合",
+        "hand-counts": r"各剩(?:幾|几)張(?:牌)?|各剩几张(?:牌)?",
+        "self-hand": r"我的手牌",
+        "pieces": r"棋子位置",
+        "last-move": r"上一手(?:是誰|是谁)?(?:(?:用)?哪(?:個|个)棋子(?:從|从)哪(?:一)?格(?:走)?到哪(?:一)?格)?",
+        "check": who + r"(?:有沒有|有没有|是否)?被(?:將軍|将军)",
+    }
+    field = "|".join(by_family.values())
+    fields = r"(?:" + field + r")(?:\s*[,，、]\s*(?:" + field + r")){0,8}"
+    link = r"(?:這幾項|这几项|這些項目|这些项目|上述項目|上述项目|以上幾項|以上几项|這些|这些)?"
+    denial = r"(?:我)?(?:全部|全都|都)?(?:沒有|没有|沒收到|没收到|未收到)(?:資料|资料|資訊|信息|數據|数据)"
+    # The inherited shorthand ('...——全部都沒有') has the same scope
+    # obligation as the explicit-data form; it is not a family-guard bypass.
+    short_denial = r"(?:全部|全都|都)(?:都)?(?:沒有|没有)"
+    match = re.fullmatch("(" + fields + r")\s*(?:[,，：:]|——|—)\s*(?:" + link + denial + "|" + short_denial + ")", text.strip())
+    if not match:
+        return None
+    return {family for part in re.split(r"[,，、]", match.group(1))
+        for family, pattern in by_family.items() if re.fullmatch(pattern, part.strip())}
+
+
+def _pure_list_denial(text):
+    return _list_denial_families(text) is not None
+
+
+def _foreign_game_denial(plan, text):
+    """Foreign-only availability statements are not contradicted by this game.
+
+    This is a deletion exclusion, not a claim that the foreign facts exist or
+    are absent. Ambiguous/unverified prose remains original on refusal.
+    """
+    card = re.search(r"抽鬼牌|牌局|手牌|\b(?:card|cards|hand)\b|手札|カード", text, re.I)
+    chess = re.search(r"西洋棋|棋局|棋盤|棋盘|棋子|\b(?:chess|board)\b|盤面|駒", text, re.I)
+    kind = json.loads(plan.context.wire)["gameKind"]
+    return bool(card and not chess) if kind == "chess" else bool(chess and not card)
+
