+def test_non_owner_review_close_preserves_captured_target_until_owner_close(
+    monkeypatch,
+):
+    """A review fork sharing session_id must not evict the live CUA backend."""
+    from run_agent import AIAgent
+    from tools.computer_use import tool as cu_tool
+    from tools.computer_use.backend import ActionResult, CaptureResult
+
+    class TargetBackend:
+        def __init__(self):
+            self.active = False
+            self.stop_count = 0
+
+        def start(self):
+            pass
+
+        def stop(self):
+            self.stop_count += 1
+
+        def capture(self, **_kwargs):
+            self.active = True
+            return CaptureResult(
+                mode="ax",
+                width=1,
+                height=1,
+                png_b64=None,
+                elements=[],
+                app="Hermes Workbench",
+                window_title="Hermes Workbench",
+            )
+
+        def set_value(self, value, element=None):
+            if not self.active:
+                return ActionResult(
+                    ok=False,
+                    action="set_value",
+                    message="No active window",
+                )
+            return ActionResult(ok=True, action="set_value")
+
+    def bare_agent(*, owns_resources):
+        agent = object.__new__(AIAgent)
+        agent.session_id = "shared-live-session"
+        agent._owns_session_tool_resources = owns_resources
+        agent._active_children = []
+        agent._active_children_lock = threading.Lock()
+        agent.client = None
+        agent._session_db = None
+        agent._end_session_on_close = False
+        return agent
+
+    monkeypatch.setattr(
+        "tools.approval.request_tool_approval",
+        lambda *_args, **_kwargs: {"approved": True, "message": None},
+    )
+    monkeypatch.setattr(
+        "tools.process_registry.process_registry.kill_all",
+        lambda **_kwargs: None,
+    )
+    monkeypatch.setattr("run_agent.cleanup_vm", lambda _task_id: None)
+    monkeypatch.setattr("run_agent.cleanup_browser", lambda _task_id: None)
+
+    cu_tool.reset_backend_for_tests()
+    backend = TargetBackend()
+    session_id = "shared-live-session"
+    with cu_tool._backend_lock:
+        cu_tool._backends[session_id] = backend
+        cu_tool._backend_call_locks[session_id] = threading.RLock()
+        cu_tool._backend_permission_modes[session_id] = "standard"
+
+    capture = cu_tool.handle_computer_use(
+        {"action": "capture", "mode": "ax", "pid": 1, "window_id": 2},
+        session_id=session_id,
+    )
+    assert backend.active is True
+    assert json.loads(capture)["mode"] == "ax"
+
+    bare_agent(owns_resources=False).close()
+    with cu_tool._backend_lock:
+        assert cu_tool._backends[session_id] is backend
+    assert backend.stop_count == 0
+
+    result = json.loads(
+        cu_tool.handle_computer_use(
+            {"action": "set_value", "element": 20, "value": "ok"},
+            session_id=session_id,
+        )
+    )
+    assert result["ok"] is True
+
+    bare_agent(owns_resources=True).close()
+    with cu_tool._backend_lock:
+        assert session_id not in cu_tool._backends
+    assert backend.stop_count == 1

