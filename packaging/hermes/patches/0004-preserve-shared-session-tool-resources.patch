+++ b/agent/agent_init.py
@@ -1663,6 +1663,13 @@ def init_agent(
     # background skill/memory review fork so its harness turn can't leak into
     # the user's real session and hijack the next live turn. Default False.
     agent._persist_disabled = False
+    # Whether this agent owns session-scoped execution resources keyed by
+    # session_id (processes, terminal/browser sessions, and computer-use
+    # target/ref state). The primary agent owns them by default. Auxiliary
+    # agents that deliberately alias an existing live session_id must opt out
+    # before they run, otherwise their close() would tear down the primary
+    # agent's still-live execution state.
+    agent._owns_session_tool_resources = True
