new file mode 100644
--- /dev/null
+++ b/tui_gateway/native_mcp_setup.py
@@ -0,0 +1,140 @@
+"""Bounded, non-secret projection of Hermes' bundled MCP catalog.
+
+This module never installs, connects, authenticates, reloads, or saves. The
+player-owned tools.set transaction alone persists its pure config mutation.
+"""
+from copy import deepcopy
+from dataclasses import asdict
+import hashlib
+import json
+import re
+
+
+def validate_mcp_setup_shape(selection):
+    if not isinstance(selection, dict) or set(selection) != {
+        "catalog_entry", "catalog_sha256", "enabled",
+    }:
+        raise ValueError("mcp_setup requires catalog_entry, catalog_sha256 and enabled")
+    name, digest = selection["catalog_entry"], selection["catalog_sha256"]
+    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", name):
+        raise ValueError("invalid MCP catalog entry")
+    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
+        raise ValueError("invalid MCP catalog digest")
+    if type(selection["enabled"]) is not bool:
+        raise ValueError("MCP enabled must be a boolean")
+    return dict(selection)
+
+
+def _catalog():
+    from hermes_cli.mcp_catalog import list_catalog
+
+    entries = list_catalog()
+    names = [entry.name for entry in entries]
+    if len(entries) > 64 or len(set(names)) != len(names):
+        raise ValueError("native MCP catalog is unbounded or ambiguous")
+    return entries
+
+
+def _digest(entry):
+    # Bind every native parsed manifest field (including defaults and install
+    # recipe), not a machine-local path or any profile credential/state.
+    definition = asdict(entry)
+    definition.pop("manifest_path", None)
+    canonical = json.dumps(definition, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def _registration_supported(entry):
+    return (
+        entry.transport.type == "http" and entry.install is None
+        and entry.auth.type in {"none", "oauth"} and not entry.auth.env
+        and not entry.auth.provider and not entry.auth.scopes and not entry.auth.env_var
+    )
+
+
+def _core_config(entry):
+    from hermes_cli.mcp_catalog import _build_server_config
+    from hermes_cli.mcp_security import validate_mcp_server_entry
+
+    if not _registration_supported(entry):
+        raise ValueError("MCP entry requires an external installation or setup flow")
+    config = _build_server_config(entry, None)
+    if validate_mcp_server_entry(entry.name, config):
+        raise ValueError("native MCP security validation rejected the catalog entry")
+    return config
+
+
+def _matches(entry, registered):
+    if not isinstance(registered, dict) or not _registration_supported(entry):
+        return False
+    # Preserve user tool filters, but never overwrite a custom URL, auth,
+    # headers, process, timeout, or other target-affecting configuration.
+    core = {key: value for key, value in registered.items() if key not in {"enabled", "tools"}}
+    return core == _core_config(entry)
+
+
+def mcp_catalog(config):
+    servers = config.get("mcp_servers") or {}
+    if not isinstance(servers, dict):
+        raise ValueError("native mcp_servers must be a mapping")
+    rows = []
+    for entry in _catalog():
+        registered = servers.get(entry.name)
+        enabled = registered.get("enabled", True) if isinstance(registered, dict) else False
+        # Match the native catalog's legacy boolish read semantics; mutation
+        # accepts a real bool and writes a canonical bool only for this entry.
+        if isinstance(enabled, str):
+            enabled = enabled.lower() in {"true", "1", "yes"}
+        rows.append({
+            "name": entry.name, "description": entry.description,
+            "transport": entry.transport.type, "url": entry.transport.url or "",
+            "auth": entry.auth.type,
+            "required_fields": [field.name for field in entry.auth.env if field.required],
+            "catalog_sha256": _digest(entry),
+            "setup_support": "catalog_registration" if _registration_supported(entry)
+                else "external_install_required",
+            "registered": entry.name in servers, "enabled": bool(enabled),
+            "config_matches_catalog": _matches(entry, registered),
+        })
+    return rows
+
+
+def _resolve(selection):
+    selection = validate_mcp_setup_shape(selection)
+    matches = [entry for entry in _catalog() if entry.name == selection["catalog_entry"]]
+    if len(matches) != 1 or _digest(matches[0]) != selection["catalog_sha256"]:
+        raise ValueError("MCP catalog changed or the exact entry is unavailable")
+    entry = matches[0]
+    _core_config(entry)
+    return selection, entry
+
+
+def apply_mcp_setup(selection, config):
+    selection, entry = _resolve(selection)
+    servers = config.get("mcp_servers", {})
+    if not isinstance(servers, dict):
+        raise ValueError("native mcp_servers must be a mapping")
+    candidate = deepcopy(servers)
+    if entry.name in candidate:
+        if not _matches(entry, candidate[entry.name]):
+            raise ValueError("existing MCP configuration differs from this catalog entry; nothing changed")
+        server = candidate[entry.name]
+    else:
+        server = _core_config(entry)
+        defaults = entry.tools.default_enabled
+        if defaults is not None:
+            server["tools"] = {"include": list(defaults)}
+        candidate[entry.name] = server
+    server["enabled"] = selection["enabled"]
+    config["mcp_servers"] = candidate
+    return deepcopy(candidate)
+
+
+def verify_mcp_setup(selection, config, expected_servers=None):
+    selection, entry = _resolve(selection)
+    servers = config.get("mcp_servers")
+    server = servers.get(entry.name) if isinstance(servers, dict) else None
+    if not _matches(entry, server) or server.get("enabled") is not selection["enabled"]:
+        raise RuntimeError("MCP config readback did not reproduce the selected catalog registration")
+    if expected_servers is not None and servers != expected_servers:
+        raise RuntimeError("MCP config readback changed a peer entry or tool filter")
