@@ -0,0 +1,242 @@
+"""MCP catalog registration is one native idle config transaction, not install."""
+from copy import deepcopy
+from dataclasses import replace
+import hashlib
+import json
+import os
+import threading
+
+import pytest
+import yaml
+
+import tui_gateway.server as server
+from tui_gateway import native_mcp_setup as setup
+from tests.tui_gateway.test_tools_policy_rpc import (
+    _attest_strict_host, _clean_gateway_sessions, _home,
+    _logged_out_features, _strict_config, _write_config,
+)
+
+
+@pytest.fixture(autouse=True)
+def metadata_and_no_side_effects(monkeypatch):
+    from hermes_cli import mcp_catalog, mcp_config, tools_config as tc
+    from tools import mcp_tool
+
+    monkeypatch.setattr(tc, "get_nous_subscription_features", lambda *a, **k: _logged_out_features())
+    for builder in ("_plugin_browser_providers", "_plugin_web_search_providers",
+                    "_plugin_image_gen_providers", "_plugin_video_gen_providers", "_plugin_tts_providers"):
+        monkeypatch.setattr(tc, builder, lambda: [])
+    def forbidden(*args, **kwargs):
+        pytest.fail("catalog registration must never install, probe, authenticate, or reload")
+    for name in ("install_entry", "_probe_tools", "_do_git_install", "_run_bootstrap"):
+        monkeypatch.setattr(mcp_catalog, name, forbidden)
+    for name in ("_save_mcp_server", "cmd_mcp_add", "cmd_mcp_login", "_probe_single_server"):
+        monkeypatch.setattr(mcp_config, name, forbidden)
+    monkeypatch.setattr(mcp_tool, "discover_mcp_tools", forbidden)
+
+
+def _config():
+    return {
+        "platform_toolsets": {"cli": ["memory", "no_mcp"], "telegram": ["memory"]},
+        "approvals": {"mode": "manual", "timeout": 123},
+        "mcp_servers": {"preserved": {"command": "example", "enabled": False,
+                                       "tools": {"exclude": ["sensitive"]}}},
+    }
+
+
+def _params(name="linear", enabled=False):
+    from hermes_cli.config import load_config
+    from hermes_cli import tools_config as tc
+
+    config = load_config()
+    valid = {name for name, _, _ in tc._get_effective_configurable_toolsets()
+             if name not in tc._CONFIG_ONLY_TOOLSETS and tc._toolset_allowed_for_platform(name, "cli")}
+    enabled_tools = tc._get_platform_tools(config, "cli", include_default_mcp_servers=False) & valid
+    row = next(row for row in setup.mcp_catalog(config) if row["name"] == name)
+    return {"enabled_toolsets": sorted(enabled_tools), "approval_mode": "manual",
+            "mcp_setup": {"catalog_entry": name, "catalog_sha256": row["catalog_sha256"],
+                          "enabled": enabled}}
+
+
+def _set(params=None):
+    return server._methods["tools.set"]("mcp-setup", _params() if params is None else params)
+
+
+def test_catalog_reports_four_http_registrations_without_claiming_connection():
+    _write_config(_config())
+    response = server._methods["tools.catalog"]("catalog", {})
+    assert "error" not in response, response
+    rows = response["result"]["mcp_catalog"]
+    assert len(rows) == 5
+    supported = {row["name"] for row in rows if row["setup_support"] == "catalog_registration"}
+    assert supported == {"linear", "figma", "comfy-cloud", "unreal-engine"}
+    for row in rows:
+        assert set(row) == {"name", "description", "transport", "url", "auth", "required_fields",
+                            "catalog_sha256", "setup_support", "registered", "enabled", "config_matches_catalog"}
+        assert not row["registered"] and not row["enabled"] and not row["config_matches_catalog"]
+        assert len(row["catalog_sha256"]) == 64 and row["catalog_sha256"].islower()
+    n8n = next(row for row in rows if row["name"] == "n8n")
+    assert n8n["auth"] == "api_key" and n8n["transport"] == "stdio"
+    assert n8n["required_fields"] == ["N8N_BASE_URL", "N8N_API_KEY"]
+    assert n8n["setup_support"] == "external_install_required"
+
+
+@pytest.mark.parametrize("name", ["linear", "figma", "comfy-cloud", "unreal-engine"])
+@pytest.mark.parametrize("enabled", [False, True])
+def test_http_registration_is_one_save_exact_readback_and_preserves_policy(monkeypatch, name, enabled):
+    from hermes_cli import tools_config as tc
+    from hermes_cli.mcp_catalog import get_entry
+
+    config = _config()
+    _write_config(config)
+    saves = []
+    original = tc.save_config
+    monkeypatch.setattr(tc, "save_config", lambda cfg: (saves.append(deepcopy(cfg)), original(cfg))[1])
+    params = _params(name, enabled)
+    response = _set(params)
+    assert "error" not in response, response
+    result = response["result"]
+    assert result["mcp_setup"] == params["mcp_setup"]
+    assert "setup_selection" not in result
+    assert result["enabled_toolsets"] == params["enabled_toolsets"]
+    assert result["approval_mode"] == "manual" and result["new_session_required"] is True
+    raw = (_home() / "config.yaml").read_bytes()
+    assert result["config_sha256"] == hashlib.sha256(raw).hexdigest()
+    saved = yaml.safe_load(raw)
+    assert len(saves) == 1
+    assert saved["platform_toolsets"] == config["platform_toolsets"]
+    assert saved["approvals"] == config["approvals"]
+    assert saved["mcp_servers"]["preserved"] == config["mcp_servers"]["preserved"]
+    registered = saved["mcp_servers"][name]
+    assert registered["enabled"] is enabled
+    assert registered["url"] == get_entry(name).transport.url
+    defaults = get_entry(name).tools.default_enabled
+    if defaults is not None:
+        assert registered["tools"] == {"include": defaults}
+    else:
+        assert "tools" not in registered
+    row = next(row for row in setup.mcp_catalog(saved) if row["name"] == name)
+    assert row["registered"] and row["config_matches_catalog"] and row["enabled"] is enabled
+
+
+def test_existing_catalog_registration_preserves_all_user_filters():
+    config = _config()
+    filters = {"include": ["custom"], "exclude": ["private"], "prompts": False, "resources": False}
+    config["mcp_servers"]["linear"] = {"url": "https://mcp.linear.app/mcp", "auth": "oauth",
+                                        "enabled": False, "tools": filters}
+    _write_config(config)
+    assert "error" not in _set(_params(enabled=True))
+    saved = yaml.safe_load((_home() / "config.yaml").read_bytes())
+    assert saved["mcp_servers"]["linear"]["tools"] == filters
+    assert "error" not in _set(_params(enabled=False))
+    assert yaml.safe_load((_home() / "config.yaml").read_bytes())["mcp_servers"]["linear"]["tools"] == filters
+
+
+@pytest.mark.parametrize("change", [
+    {"approval_mode": "off"}, {"enabled_toolsets": []},
+    {"setup_selection": {"toolset": "browser", "provider": "Camofox"}},
+    {"mcp_setup": None},
+    {"mcp_setup": {"catalog_entry": "linear", "catalog_sha256": "a" * 64, "enabled": False}},
+    {"mcp_setup": {"catalog_entry": "../linear", "catalog_sha256": "a" * 64, "enabled": False}},
+    {"mcp_setup": {"catalog_entry": "linear", "catalog_sha256": "A" * 64, "enabled": False}},
+    {"mcp_setup": {"catalog_entry": "linear", "catalog_sha256": "a" * 64, "enabled": "true"}},
+    {"mcp_setup": {"catalog_entry": "linear", "catalog_sha256": "a" * 64, "enabled": True, "url": "https://example.invalid"}},
+])
+def test_invalid_stale_or_mixed_request_never_writes(change):
+    before = _write_config(_config())
+    response = _set({**_params(), **change})
+    assert response["error"]["code"] == -32602, response
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+@pytest.mark.parametrize("core", [
+    {"url": "https://example.invalid"}, {"auth": "none"}, {"headers": {"Authorization": "do-not-expose"}},
+    {"command": "injected"}, {"timeout": 500},
+])
+def test_existing_custom_server_conflict_is_preserved_without_secret_projection(core):
+    config = _config()
+    config["mcp_servers"]["linear"] = {"url": "https://mcp.linear.app/mcp", "auth": "oauth", **core}
+    before = _write_config(config)
+    rows = setup.mcp_catalog(config)
+    row = next(row for row in rows if row["name"] == "linear")
+    assert row["registered"] and not row["config_matches_catalog"]
+    assert "do-not-expose" not in json.dumps(rows)
+    response = _set()
+    assert response["error"]["code"] == -32602
+    assert "do-not-expose" not in json.dumps(response)
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_stdio_install_is_not_started():
+    before = _write_config(_config())
+    assert _set(_params("n8n"))["error"]["code"] == -32602
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_active_turn_rejects_before_config_write():
+    before = _write_config(_config())
+    server._sessions["busy"] = {"history_lock": threading.RLock(), "running": True}
+    assert _set()["error"]["code"] == 4090
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_readback_failure_restores_exact_bytes(monkeypatch):
+    before = _write_config(_config())
+    def bad_readback(*args, **kwargs):
+        raise RuntimeError("bad readback")
+    monkeypatch.setattr(setup, "verify_mcp_setup", bad_readback)
+    assert "error" in _set()
+    assert (_home() / "config.yaml").read_bytes() == before
+
+
+def test_peer_or_filter_readback_corruption_rejects():
+    config = _config()
+    _write_config(config)
+    params = _params()["mcp_setup"]
+    expected = setup.apply_mcp_setup(params, config)
+    config["mcp_servers"]["preserved"]["enabled"] = True
+    with pytest.raises(RuntimeError, match="peer entry or tool filter"):
+        setup.verify_mcp_setup(params, config, expected)
+
+
+def test_registration_rotates_strict_digest_but_never_reuses_approval_only_session(monkeypatch):
+    import agent.identity_policy as identity
+
+    soul, personality = "Lilith soul.\n", "You are Lilith.\n"
+    config = _strict_config(personality)
+    config.update(_config())
+    before = _write_config(config)
+    (_home() / "SOUL.md").write_text(soul, encoding="utf-8", newline="\n")
+    _attest_strict_host(monkeypatch, before, soul, personality)
+    session = {"history_lock": threading.RLock(), "running": False,
+               "_native_approval_resume_digest": {"previous": "a" * 64, "current": "b" * 64}}
+    server._sessions["idle"] = session
+    result = _set()
+    assert "error" not in result, result
+    digest = result["result"]["config_sha256"]
+    assert os.environ["HERMES_IDENTITY_EXPECTED_CONFIG_SHA256"] == digest
+    assert identity.preflight_aia_agent_identity(request_overrides={}).config_sha256 == digest
+    assert "_native_approval_resume_digest" not in session
+
+
+def test_catalog_digest_binds_semantic_manifest_not_path(monkeypatch):
+    from hermes_cli.mcp_catalog import get_entry
+
+    entry = get_entry("linear")
+    assert setup._digest(entry) == setup._digest(replace(entry, manifest_path=entry.manifest_path.parent))
+    assert setup._digest(entry) != setup._digest(replace(entry, description="Changed"))
+    config = _config()
+    _write_config(config)
+    params = _params()
+    monkeypatch.setattr(setup, "_catalog", lambda: [replace(entry, description="Changed")])
+    assert _set(params)["error"]["code"] == -32602
+
+
+def test_native_security_guard_rejection_remains_enforced(monkeypatch):
+    from hermes_cli import mcp_security
+
+    before = _write_config(_config())
+    params = _params()
+    monkeypatch.setattr(mcp_security, "validate_mcp_server_entry", lambda *a: ["blocked"])
