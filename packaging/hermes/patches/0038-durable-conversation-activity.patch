diff --git a/tests/test_session_conversation_activity.py b/tests/test_session_conversation_activity.py
new file mode 100644
index 00000000..2ce432b6
--- /dev/null
+++ b/tests/test_session_conversation_activity.py
@@ -0,0 +1,267 @@
+"""True conversation recency stays independent from operational activity."""
+
+import sqlite3
+
+import pytest
+
+from agent.context_compressor import (
+    HISTORICAL_TASK_HEADING,
+    SUMMARY_PREFIX,
+    _SUMMARY_END_MARKER,
+)
+from hermes_state import SessionDB
+
+
+HANDOFF = (
+    f"{SUMMARY_PREFIX}\n{HISTORICAL_TASK_HEADING}\n"
+    f"User asked: 'historical task'\n\n{_SUMMARY_END_MARKER}"
+)
+
+
+def _listed(db: SessionDB, session_id: str) -> dict:
+    rows = db.list_sessions_rich(
+        limit=20,
+        order_by_last_conversation=True,
+        compact_rows=True,
+    )
+    return next(
+        row
+        for row in rows
+        if row["id"] == session_id or row.get("_lineage_root_id") == session_id
+    )
+
+
+def test_in_place_compression_and_heartbeat_do_not_advance_conversation(tmp_path):
+    path = tmp_path / "state.db"
+    db = SessionDB(path)
+    db.create_session("chat", source="cli", model="m")
+    db.append_message("chat", "user", "real request", timestamp=10.0)
+    db.append_message("chat", "assistant", "answer", timestamp=11.0)
+
+    before = _listed(db, "chat")
+    assert before["last_conversation_at"] == 10.0
+
+    # A successful in-place compression persists a synthetic role=user
+    # handoff at a newer timestamp.  It is durable, but not human-authored.
+    db.archive_and_compact(
+        "chat",
+        [{"role": "user", "content": HANDOFF, "timestamp": 50.0}],
+    )
+    db.touch_session_activity("chat", 60.0, description="compressing")
+    after = _listed(db, "chat")
+    assert after["last_active"] == 60.0
+    assert after["last_conversation_at"] == 10.0
+
+    # Reload/restart reads the durable watermark; it does not reconstruct it
+    # from the now-newer compressed handoff or heartbeat.
+    db.close()
+    reopened = SessionDB(path)
+    try:
+        reloaded = _listed(reopened, "chat")
+        assert reloaded["last_active"] == 60.0
+        assert reloaded["last_conversation_at"] == 10.0
+    finally:
+        reopened.close()
+
+
+def test_rotated_compression_lineage_uses_latest_real_user_turn(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("root", source="cli", model="m")
+        db.append_message("root", "user", "root request", timestamp=20.0)
+        db.publish_compression_child(
+            parent_session_id="root",
+            child_session_id="tip",
+            source="cli",
+            messages=[{"role": "user", "content": HANDOFF, "timestamp": 40.0}],
+            require_compression_lease=False,
+        )
+        db.touch_session_activity("tip", 50.0, description="heartbeat")
+
+        compressed = _listed(db, "root")
+        assert compressed["id"] == "tip"
+        assert compressed["last_active"] == 50.0
+        assert compressed["last_conversation_at"] == 20.0
+
+        db.append_message("tip", "user", "new request", timestamp=70.0)
+        db.append_message(
+            "tip",
+            "user",
+            "internal timeline marker",
+            timestamp=90.0,
+            display_kind="internal",
+        )
+        advanced = _listed(db, "root")
+        assert advanced["last_active"] == 90.0
+        assert advanced["last_conversation_at"] == 70.0
+    finally:
+        db.close()
+
+
+def test_empty_session_falls_back_to_original_start_time(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("empty", source="cli", model="m")
+        row = _listed(db, "empty")
+        assert row["last_conversation_at"] == row["started_at"]
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("compression_outcome", ["noop", "aborted"])
+def test_nonmutating_compression_outcomes_and_heartbeat_do_not_advance(
+    tmp_path,
+    compression_outcome,
+):
+    db = SessionDB(tmp_path / f"{compression_outcome}.db")
+    try:
+        db.create_session("chat", source="cli", model="m")
+        db.append_message("chat", "user", "real request", timestamp=10.0)
+
+        # No-op and aborted compression persist no replacement transcript.
+        # Their only durable side effect may be operational status/heartbeat.
+        db.touch_session_activity(
+            "chat",
+            80.0,
+            description=f"compression-{compression_outcome}",
+        )
+
+        row = _listed(db, "chat")
+        assert row["last_active"] == 80.0
+        assert row["last_conversation_at"] == 10.0
+    finally:
+        db.close()
+
+
+def test_nonconversation_durable_rows_and_metadata_never_advance(tmp_path):
+    path = tmp_path / "state.db"
+    db = SessionDB(path)
+    db.create_session("chat", source="cli", model="m")
+    db.append_message("chat", "user", "real request", timestamp=10.0)
+    db.append_message(
+        "chat",
+        "assistant",
+        "internal reasoning",
+        reasoning_content="reasoning sidecar",
+        timestamp=20.0,
+    )
+    db.append_message(
+        "chat",
+        "tool",
+        "tool output",
+        tool_name="terminal",
+        timestamp=30.0,
+    )
+    db.append_message("chat", "user", HANDOFF, timestamp=40.0)
+    db.append_message(
+        "chat",
+        "user",
+        "display-only status",
+        display_kind="internal",
+        timestamp=50.0,
+    )
+    db.set_session_title("chat", "renamed")
+    db.touch_session_activity("chat", 60.0, description="resume-open-heartbeat")
+
+    assert _listed(db, "chat")["last_conversation_at"] == 10.0
+    db.close()
+
+    reopened = SessionDB(path)
+    try:
+        assert _listed(reopened, "chat")["last_conversation_at"] == 10.0
+    finally:
+        reopened.close()
+
+
+def test_v25_upgrade_backfills_from_real_durable_user_turns(tmp_path):
+    path = tmp_path / "legacy.db"
+    db = SessionDB(path)
+    db.create_session("legacy", source="cli", model="m")
+    db.append_message("legacy", "user", "real request", timestamp=10.0)
+    db.append_message("legacy", "user", HANDOFF, timestamp=90.0)
+    db.append_message(
+        "legacy",
+        "user",
+        "display-only status",
+        display_kind="internal",
+        timestamp=95.0,
+    )
+    db.touch_session_activity("legacy", 100.0, description="heartbeat")
+    db.close()
+
+    # Simulate a real pre-v26 database after its column has been reconciled:
+    # it has operational activity but no authored-turn watermark.
+    with sqlite3.connect(path) as conn:
+        conn.execute("UPDATE sessions SET last_conversation_at = NULL")
+        conn.execute("UPDATE schema_version SET version = 25")
+
+    upgraded = SessionDB(path)
+    try:
+        row = _listed(upgraded, "legacy")
+        assert row["last_active"] == 100.0
+        assert row["last_conversation_at"] == 10.0
+        version = upgraded._conn.execute(
+            "SELECT version FROM schema_version LIMIT 1"
+        ).fetchone()[0]
+        assert version == 26
+    finally:
+        upgraded.close()
+
+
+def test_bounded_page_is_selected_by_conversation_not_heartbeat(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        for session_id, authored_at in (
+            ("newest", 300.0),
+            ("middle", 200.0),
+            ("old-heartbeat", 100.0),
+        ):
+            db.create_session(session_id, source="cli", model="m")
+            db.append_message(
+                session_id,
+                "user",
+                f"request from {session_id}",
+                timestamp=authored_at,
+            )
+        db.touch_session_activity(
+            "old-heartbeat",
+            1_000.0,
+            description="compression-heartbeat",
+        )
+
+        rows = db.list_sessions_rich(
+            limit=2,
+            order_by_last_conversation=True,
+            compact_rows=True,
+        )
+
+        assert [row["id"] for row in rows] == ["newest", "middle"]
+        assert all(row["last_conversation_at"] >= 200.0 for row in rows)
+    finally:
+        db.close()
+
+
+def test_v25_backfill_failure_never_marks_schema_upgraded(tmp_path, monkeypatch):
+    path = tmp_path / "retryable-upgrade.db"
+    db = SessionDB(path)
+    db.create_session("legacy", source="cli", model="m")
+    db.append_message("legacy", "user", "real request", timestamp=10.0)
+    db.close()
+    with sqlite3.connect(path) as conn:
+        conn.execute("UPDATE sessions SET last_conversation_at = NULL")
+        conn.execute("UPDATE schema_version SET version = 25")
+
+    monkeypatch.setattr(
+        "agent.context_compressor.is_user_originated_turn",
+        lambda _message: (_ for _ in ()).throw(RuntimeError("predicate failed")),
+    )
+    with pytest.raises(RuntimeError, match="predicate failed"):
+        SessionDB(path)
+
+    with sqlite3.connect(path) as conn:
+        assert conn.execute(
+            "SELECT version FROM schema_version LIMIT 1"
+        ).fetchone()[0] == 25
+        assert conn.execute(
+            "SELECT last_conversation_at FROM sessions WHERE id = 'legacy'"
+        ).fetchone()[0] is None
