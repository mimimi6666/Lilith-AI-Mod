+    # Background memory/skill review runs a full tool-capable agent fork. Keep
+    # that fork useful for durable learning while bounding the number of model
+    # turns it can consume. The runtime also validates this value at the point
+    # of use so tests and embedders that construct a partial agent cannot bypass
+    # the ceiling accidentally.
+    try:
+        _raw_review_iterations = _agent_section.get(
+            "background_review_max_iterations", 6
+        )
+        if isinstance(_raw_review_iterations, bool):
+            raise TypeError("boolean is not an iteration count")
+        _review_iterations = int(_raw_review_iterations)
+    except (TypeError, ValueError):
+        _review_iterations = 6
+    agent._background_review_max_iterations = max(
+        1, min(_review_iterations, 8)
+    )
