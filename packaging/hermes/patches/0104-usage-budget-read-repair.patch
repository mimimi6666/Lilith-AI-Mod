diff --git a/tests/test_lilith_usage_budget_preview.py b/tests/test_lilith_usage_budget_preview.py
new file mode 100644
--- /dev/null
+++ b/tests/test_lilith_usage_budget_preview.py
@@ -0,0 +1,156 @@
+from copy import deepcopy
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+from agent.usage_budget import BudgetError, NormalBudget, VerifiedModelLimits
+from agent.usage_budget_dispatch import WireRoute
+from agent.usage_budget_host_policy import HostPolicySnapshot, DEFAULT_ECONOMY_REFERENCES
+from agent.usage_budget_preferences import UsagePreference
+from agent.usage_budget_preview import build_budget_preview, MAX_SAFE_INTEGER
+
+
+FIELDS = {"level", "request_input_tokens", "request_output_tokens", "request_thinking_tokens",
+          "logical_iterations", "turn_token_allowance", "turn_actual_call_allowance"}
+
+
+class PreviewTests(unittest.TestCase):
+    def test_exact_reference_shape_and_six_ordered_rows(self):
+        result = build_budget_preview()
+        self.assertEqual({"schema_version", "scope", "reference_version", "input_count_mode",
+                          "memory_policy", "levels"}, set(result))
+        self.assertEqual(1, result["schema_version"])
+        self.assertEqual("reference_preview", result["scope"])
+        self.assertEqual("lilith-economy-20260926-v2", result["reference_version"])
+        self.assertEqual("estimated", result["input_count_mode"])
+        self.assertEqual("unchanged_no_per_level_count", result["memory_policy"])
+        self.assertEqual(list(range(1, 7)), [row["level"] for row in result["levels"]])
+        for row in result["levels"]:
+            self.assertEqual(FIELDS, set(row))
+
+    def test_reference_numbers_include_engineering_input_reserve(self):
+        rows = build_budget_preview()["levels"][:4]
+        self.assertEqual([45056, 57344, 81920, 106496], [r["request_input_tokens"] for r in rows])
+        self.assertEqual([2048, 4096, 8192, 12288], [r["request_output_tokens"] for r in rows])
+        self.assertEqual([262144, 524288, 1048576, 1572864], [r["turn_token_allowance"] for r in rows])
+        self.assertEqual([8, 16, 32, 48], [r["turn_actual_call_allowance"] for r in rows])
+        self.assertTrue(all(r["logical_iterations"] is None for r in rows))
+
+    def test_configured_preview_uses_native_resolved_iterations_not_fixed_32(self):
+        config = {"model": {"default": "synthetic"}, "agent": {"max_turns": 32}}
+        rows = build_budget_preview(config, max_iterations=500)["levels"]
+        self.assertEqual([62, 125, 250, 375, 500, None], [r["logical_iterations"] for r in rows])
+
+    def test_native_32_if_actually_supplied(self):
+        rows = build_budget_preview({"model": {}}, max_iterations=32)["levels"]
+        self.assertEqual([4, 8, 16, 24, 32, None], [r["logical_iterations"] for r in rows])
+
+    def test_smaller_custom_settings_preserved_and_scaled_by_same_resolver(self):
+        config = {"model": {"context_length": "65536", "max_tokens": "8000"}}
+        result = build_budget_preview(config, max_iterations="20", reasoning_config={"max_tokens": "4096"})
+        expected = HostPolicySnapshot(
+            WireRoute("synthetic", "model", "adapter"), NormalBudget(65536, 8000, 4096, 20),
+            DEFAULT_ECONOMY_REFERENCES, VerifiedModelLimits(), input_count_is_exact=False)
+        self.assertEqual("configured_preview", result["scope"])
+        for row in result["levels"]:
+            described = expected.describe(UsagePreference(revision=91, level=row["level"]))
+            self.assertEqual(row, {key: described[key] for key in FIELDS})
+
+    def test_model_window_not_claimed_and_low_input_unchanged_by_reserve(self):
+        rows = build_budget_preview({"model": {"context_length": 16000}})["levels"]
+        self.assertEqual([16000] * 5 + [None], [r["request_input_tokens"] for r in rows])
+        self.assertNotIn("model_context_tokens", rows[0])
+
+    def test_larger_custom_normal_restores_after_economy(self):
+        rows = build_budget_preview({"model": {"context_length": 1000000, "max_tokens": 64000}})["levels"]
+        self.assertEqual(45056, rows[0]["request_input_tokens"])
+        self.assertEqual(2048, rows[0]["request_output_tokens"])
+        self.assertEqual(1000000, rows[4]["request_input_tokens"])
+        self.assertEqual(64000, rows[4]["request_output_tokens"])
+        self.assertTrue(all(rows[5][name] is None for name in FIELDS - {"level"}))
+
+    def test_normal_unset_and_unbounded_do_not_adopt_references(self):
+        for row in build_budget_preview()["levels"][4:]:
+            self.assertTrue(all(row[key] is None for key in FIELDS - {"level"}))
+
+    def test_empty_or_missing_config_does_not_advertise_host_defaults(self):
+        self.assertEqual(build_budget_preview(), build_budget_preview({}, max_iterations=500))
+
+    def test_invalid_numeric_fields_are_unknown_not_zero_or_false(self):
+        for value in (True, False, 0, -1, 1.5, float("inf"), [], {}, "bad"):
+            with self.subTest(value=value):
+                rows = build_budget_preview({"model": {"context_length": value, "max_tokens": value}},
+                                            max_iterations=value, reasoning_config={"max_tokens": value})["levels"]
+                self.assertTrue(all(rows[4][key] is None for key in FIELDS - {"level"}))
+                self.assertIsNone(rows[0]["request_thinking_tokens"])
+                self.assertIsNone(rows[0]["logical_iterations"])
+
+    def test_known_oversized_positive_settings_reject_not_mislabel_as_unset(self):
+        for value in (MAX_SAFE_INTEGER + 1, str(MAX_SAFE_INTEGER + 1)):
+            for kwargs in (
+                {"config": {"model": {"context_length": value}}},
+                {"config": {"model": {"max_tokens": value}}},
+                {"config": {"model": {}}, "max_iterations": value},
+                {"config": {"model": {}}, "reasoning_config": {"max_tokens": value}},
+            ):
+                with self.subTest(value=value, kwargs=kwargs):
+                    with self.assertRaisesRegex(BudgetError, "invalid_preview_limit"):
+                        build_budget_preview(**kwargs)
+
+    def test_safe_integer_boundary(self):
+        result = build_budget_preview({"model": {"context_length": MAX_SAFE_INTEGER,
+                                                    "max_tokens": MAX_SAFE_INTEGER}},
+                                      max_iterations=MAX_SAFE_INTEGER)
+        for row in result["levels"]:
+            for key in FIELDS - {"level"}:
+                self.assertTrue(row[key] is None or type(row[key]) is int and 0 < row[key] <= MAX_SAFE_INTEGER)
+        self.assertEqual(MAX_SAFE_INTEGER, result["levels"][4]["logical_iterations"])
+
+    def test_unknown_subsections_do_not_call_custom_getters(self):
+        class Probe:
+            def get(self, *_args):
+                raise AssertionError("probe")
+            @property
+            def context_length(self):
+                raise AssertionError("network-capable property")
+        rows = build_budget_preview({"model": Probe(), "compressor": Probe()},
+                                    max_iterations=Probe(), reasoning_config=Probe())["levels"]
+        self.assertIsNone(rows[4]["request_input_tokens"])
+
+    def test_reject_custom_top_level_mapping_without_invoking_it(self):
+        class Custom(dict):
+            def __bool__(self):
+                raise AssertionError("custom mapping executed")
+        with self.assertRaisesRegex(BudgetError, "invalid_preview_config"):
+            build_budget_preview(Custom())
+
+    def test_does_not_mutate_input_or_expose_private_fields(self):
+        config = {"model": {"default": "PRIVATE_MODEL", "provider": "PRIVATE_PROVIDER",
+                            "base_url": "https://PRIVATE_ENDPOINT?key=PRIVATE_KEY", "max_tokens": 7000},
+                  "api_key": "PRIVATE_KEY", "memory": ["PRIVATE_MEMORY"]}
+        reasoning = {"max_tokens": 2000, "private": "PRIVATE_THOUGHT"}
+        before, before_reasoning = deepcopy(config), deepcopy(reasoning)
+        result = build_budget_preview(config, max_iterations=32, reasoning_config=reasoning)
+        self.assertEqual(before, config)
+        self.assertEqual(before_reasoning, reasoning)
+        self.assertNotIn("PRIVATE_", json.dumps(result))
+        self.assertNotIn("revision", json.dumps(result))
+
+    def test_no_store_ledger_agent_or_provider_imports(self):
+        import builtins
+        real_import = builtins.__import__
+        def guarded(name, *args, **kwargs):
+            if any(word in name for word in ("store", "runtime", "run_agent", "openai", "anthropic", "httpx")):
+                raise AssertionError("forbidden import: " + name)
+            return real_import(name, *args, **kwargs)
+        with patch.object(builtins, "__import__", guarded):
+            self.assertEqual(6, len(build_budget_preview({"model": {}}, max_iterations=32)["levels"]))
+
+    def test_reference_resource_exactly_matches_same_native_resolver(self):
+        resource = Path(__file__).resolve().parents[2] / "reference-preview.json"
+        self.assertEqual(build_budget_preview(), json.loads(resource.read_text(encoding="utf-8")))
+
+
+if __name__ == "__main__":
+    unittest.main()
