@@ -0,0 +1,90 @@
+"""Content-free, read-only counterfactuals of the native six-level policy.
+
+The caller supplies an already parsed, launch-profile configuration and native
+resolved iteration/reasoning settings. This module never loads configuration,
+constructs an agent/client, resolves a provider, counts prompts, or accesses a
+preference/ledger. A configured preview is NOT an effective session or turn.
+Model context capacity, memory contents and credentials are not projected.
+"""
+from __future__ import annotations
+
+from agent.usage_budget import BudgetError, NormalBudget, VerifiedModelLimits
+from agent.usage_budget_dispatch import WireRoute
+from agent.usage_budget_host_policy import (
+    DEFAULT_ECONOMY_REFERENCES, ECONOMY_REFERENCE_VERSION, HostPolicySnapshot,
+    _native_optional_positive,
+)
+from agent.usage_budget_preferences import UsagePreference
+
+
+SCHEMA_VERSION = 1
+MAX_SAFE_INTEGER = 9_007_199_254_740_991
+_LIMIT_FIELDS = (
+    "request_input_tokens", "request_output_tokens", "request_thinking_tokens",
+    "logical_iterations", "turn_token_allowance", "turn_actual_call_allowance",
+)
+
+
+def _preview_number(value):
+    # Match native numeric/unset parsing, then apply the cross-language wire
+    # bound. A known positive value outside that bound cannot become "unset";
+    # reject this configured preview so the UI can retain labelled references.
+    parsed = _native_optional_positive(value)
+    if parsed is not None and parsed > MAX_SAFE_INTEGER:
+        raise BudgetError("invalid_preview_limit")
+    return parsed
+
+
+def build_budget_preview(config=None, *, max_iterations=None, reasoning_config=None):
+    """Return the closed ``budget.preview`` v1 result, with six ordered rows.
+
+    ``None`` or empty config produces a reference-only preview; it must not
+    claim an unverified normal iteration default. For a nonempty plain dict,
+    only model.context_length/model.max_tokens and the caller's native-resolved
+    iteration/reasoning values are read. Do not pass a live agent or property
+    wrapper. The selected route is deliberately not discovered or certified.
+
+    Null is contextual: modes 1--4 have an unknown/unset native field; mode 5
+    keeps the native/serving default; mode 6 adds no human usage ceiling. Native
+    context/compression settings and mandatory API parameters still apply.
+    """
+    if config is not None and type(config) is not dict:
+        raise BudgetError("invalid_preview_config")
+    configured = bool(config)
+    normal = NormalBudget()
+    if configured:
+        model = config.get("model")
+        model = model if type(model) is dict else {}
+        reasoning = reasoning_config if type(reasoning_config) is dict else {}
+        normal = NormalBudget(
+            input_tokens=_preview_number(model.get("context_length")),
+            output_tokens=_preview_number(model.get("max_tokens")),
+            thinking_tokens=_preview_number(reasoning.get("max_tokens")),
+            max_iterations=_preview_number(max_iterations),
+        )
+    snapshot = HostPolicySnapshot(
+        # This pure policy key is never registered as an outbound capability.
+        route=WireRoute("preview-only", "configured-values", "no-dispatch"),
+        normal=normal, reference=DEFAULT_ECONOMY_REFERENCES,
+        limits=VerifiedModelLimits(), input_count_is_exact=False,
+    )
+    levels = []
+    for level in range(1, 7):
+        # The resolver accepts versioned preferences. Version 1 is only a
+        # counterfactual input here: never returned, saved, admitted or applied.
+        described = snapshot.describe(UsagePreference(revision=1, level=level))
+        row = {"level": level}
+        for name in _LIMIT_FIELDS:
+            value = described[name]
+            if value is not None and (type(value) is not int or not 0 < value <= MAX_SAFE_INTEGER):
+                raise BudgetError("invalid_preview_limit")
+            row[name] = value
+        levels.append(row)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "scope": "configured_preview" if configured else "reference_preview",
+        "reference_version": ECONOMY_REFERENCE_VERSION,
+        "input_count_mode": "estimated",
+        "memory_policy": "unchanged_no_per_level_count",
+        "levels": levels,
+    }
