+def _trace(stage, status, checks=None, reason="none"):
+    # Fixed enums and counts only. Never include question, answer, evidence,
+    # card facts, match IDs, provider identity, exception text or request data.
+    if stage not in {"local", "audit", "repair", "final"} or status not in {"checked", "attempted", "accepted", "unresolved", "failed", "skipped", "completed"}:
+        return
+    if reason not in {"none", "complete", "ineligible", "already-used", "invalid-answer", "invalid-response", "unavailable", "cancelled", "deadline", "remaining-uncertain", "correction", "supplement"}:
+        reason = "unavailable"
+    values = list((checks or {}).values())
+    try:
+        _LOG.info("minigame_answer_judge stage=%s status=%s reason=%s covered=%d missing=%d wrong=%d uncertain=%d",
+            stage, status, reason, values.count("covered"), values.count("missing"), values.count("wrong"), values.count("uncertain"))
+    except Exception:
+        pass
