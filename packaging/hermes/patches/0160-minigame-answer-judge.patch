+        elif key == "self-hand.order":
+            single = replace(plan, ids=("self-hand",))
+            lines.extend(_render(single, {"self-hand": value}, kind).split("\n")[1:])
+        elif key.startswith("self-hand.card."):
+            suits = {"hearts": "ハート" if ja else "hearts " if en else "紅心", "spades": "スペード" if ja else "spades " if en else "黑桃", "none": ""}
+            card = ("ジョーカー" if ja else "Joker" if en else "鬼牌") if value["rank"] == "JOKER" else suits[value["suit"]]+value["rank"]
+            lines.append(("私の手札に：" if ja else "In my hand: " if en else "我的手牌中有：") + card + "。")
+        elif key.startswith("pieces."):
+            lines.append(("駒（大文字=白、小文字=ピンク）：" if ja else "Piece (uppercase=white, lowercase=pink): " if en else "棋子（大寫白方、小寫粉方）：") + key.split(".")[1] + ":" + value + "。")
+        elif key == "awareness.capture-targets":
+            who = ("私" if value["actor"] == "lilith" else "あなた") if ja else ("I" if value["actor"] == "lilith" else "you") if en else ("我" if value["actor"] == "lilith" else "你")
+            targets = ", ".join(value["squares"]) or ("なし" if ja else "none" if en else "無")
+            lines.append(f"手番側（{who}）の合法な捕獲対象：{targets}。" if ja else f"Side to move ({who}), legal capture targets: {targets}." if en else f"當前行棋方（{who}）可合法吃子的目標格：{targets}。")
+        elif key == "awareness.checking-move":
+            yes = ("あり" if value["available"] else "なし") if ja else ("yes" if value["available"] else "no") if en else ("有" if value["available"] else "沒有")
+            lines.append(f"手番側の王手できる合法手：{yes}。詰みの保証ではありません。" if ja else f"Side to move, a legal checking move exists: {yes}. This does not guarantee mate." if en else f"當前行棋方可將軍的合法走法：{yes}；這不保證將死。")
+    header = _render(replace(plan, ids=()), {}, kind)
+    text = header + "\n" + "\n".join(lines)
+    if hans:
+        for old, new in (("張", "张"), ("紅", "红"), ("寫", "写"), ("當", "当"), ("將", "将"), ("軍", "军"), ("標", "标"), ("無", "无"), ("這", "这"), ("證", "证")):
+            text = text.replace(old, new)
+    return text
