+def _evidence_assertions(text, evidence):
+    """Expand evidence to its assertion; a judge cannot crop away a negation."""
+    if not evidence:
+        return []
+    scopes, seen = [], set()
+    boundaries = [match.end() for match in re.finditer(r"[。.!！?？;；\n]", text)]
+    start, occurrences = 0, 0
+    while True:
+        at = text.find(evidence, start)
+        if at < 0:
+            break
+        occurrences += 1
+        if occurrences > 32:
+            return []  # Ambiguous repeated evidence is not coverage authority.
+        left_index = bisect_right(boundaries, at)
+        left = boundaries[left_index-1] if left_index else 0
+        right_index = bisect_left(boundaries, at+len(evidence))
+        right = boundaries[right_index] if right_index < len(boundaries) else len(text)
+        if (left, right) not in seen:
+            seen.add((left, right))
+            scope = _assertions(text[left:right])
+            if evidence in scope:
+                scopes.append(scope)
+        start = at + max(1, len(evidence))
+    return scopes
+
+
+def assess_audit(response, items, checks, text):
+    result = _response_object(response)
+    uncertain = {key for key, status in checks.items() if status == "uncertain"}
+    if (type(result) is not dict or set(result) != {"verdicts"}
+            or type(result["verdicts"]) is not list or len(result["verdicts"]) != len(uncertain)):
+        _fail()
+    merged, seen = dict(checks), set()
+    for verdict in result["verdicts"]:
+        if type(verdict) is not dict or set(verdict) != {"id", "status", "evidence"}:
+            _fail()
+        key, status, evidence = verdict["id"], verdict["status"], verdict["evidence"]
+        if (type(key) is not str or key not in uncertain or key in seen
+                or type(status) is not str or status not in {"covered", "missing", "wrong", "uncertain"}
+                or type(evidence) is not str or len(evidence) > 2000
+                or evidence and evidence not in text
+                or status in {"covered", "wrong"} and not evidence.strip()):
+            _fail()
+        seen.add(key)
+        # A judge cannot rubber-stamp a keyword or quoted denial as complete.
+        # Where finite checks cannot ground its coverage claim, keep unknown.
+        scopes = _evidence_assertions(text, evidence)
+        if status == "covered":
+            merged[key] = "covered" if scopes and all(_item_status(key, items[key], scope) == "covered" for scope in scopes) else "uncertain"
+        elif status == "wrong":
+            proved = scopes and all(_item_status(key, items[key], scope) == "wrong"
+                or _EXPLICIT_ABSENCE.search(scope) is not None for scope in scopes)
+            merged[key] = "wrong" if proved else "uncertain"
+        else:
+            merged[key] = status
+    if seen != uncertain:
+        _fail()
+    return merged
+
