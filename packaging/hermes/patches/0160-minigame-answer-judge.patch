+    # claim. Only requested, host-visible items can become corrections.
+    if denial:
+        return {key: status if status in {"covered", "wrong"} else "wrong" for key, status in statuses.items()}
+    if assertions.strip().rstrip(".!。！～~") in _EMPTY_ANSWERS:
+        return {key: "missing" for key in items}
+    if "covered" in statuses.values():
+        # Complete affirmative fragments can prove a requested item was simply
+        # omitted. Ambiguous language mentioning that item still goes to audit.
+        for key, status in list(statuses.items()):
+            if status != "uncertain":
+                continue
+            base = key.split(".")[0]
+            if base == "hand-counts":
+                actor = key.rsplit(".", 1)[1]
+                cue = (r"(?:我|私|\bI\b|my).{0,14}(?:牌|張|张|枚|hand|cards?)" if actor == "lilith" else
+                       r"(?:你|妳|あなた|you|your).{0,14}(?:牌|張|张|枚|hand|cards?)")
+            else:
+                cue = _QUERIES.get(base, r"(?!)")
+            if not re.search(cue, assertions, re.I):
+                statuses[key] = "missing"
