 def is_seen(config: Mapping[str, Any], flag: str) -> bool:
     """Return True if the user has already been shown this first-touch hint."""
-    return bool(_get_seen_dict(config).get(flag))
+    if bool(_get_seen_dict(config).get(flag)):
+        return True
+    try:
+        path = _managed_hint_state_path(flag)
+        return path is not None and _hint_state_seen(path)
+    except Exception:
+        return False  # hints are not configuration or execution authority
+
+
+def _check_hint_state_path(path: Path) -> None:
+    """Best-effort hint persistence must not follow a link to player data."""
+    for item in (path, *path.parents):
+        try:
+            info = item.lstat()
+        except FileNotFoundError:
+            continue
+        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+            raise ValueError("onboarding state cannot use symlinks or reparse points")
+
+
+def _managed_hint_state_path(flag: str, config_path: Optional[Path] = None) -> Optional[Path]:
+    from hermes_cli.config import is_managed
+    from agent.identity_policy import identity_lock_required_by_host
+    from hermes_constants import get_hermes_home
+
+    if not (is_managed() or identity_lock_required_by_host()):
+        return None
+    if flag not in (BUSY_INPUT_FLAG, TOOL_PROGRESS_FLAG, OPENCLAW_RESIDUE_FLAG, PROFILE_BUILD_FLAG):
+        raise ValueError("unknown onboarding flag")
+    home = get_hermes_home().absolute()
+    if config_path is not None and Path(config_path).absolute() != home / "config.yaml":
+        raise ValueError("onboarding config does not belong to the active profile")
+    path = home / "state" / "onboarding-v1" / (flag + ".json")
+    _check_hint_state_path(path)
+    return path
+
+
+def _hint_state_seen(path: Path) -> bool:
+    if not path.exists():
+        return False
+    if not path.is_file() or path.stat().st_size > 256:
+        return False
+    with path.open("rb") as stream:
+        raw = stream.read(257)
+    if len(raw) > 256:
+        return False
+    state = json.loads(raw.decode("utf-8"))
+    return (isinstance(state, dict) and set(state) == {"schema_version", "seen"}
+            and type(state["schema_version"]) is int and state["schema_version"] == 1
+            and state["seen"] is True)
 
 
 def mark_seen(config_path: Path, flag: str) -> bool:
-    """Persist ``onboarding.seen.<flag> = True`` to ``config_path``.
+    """Persist a seen hint; managed profiles use state, never ``config_path``.
 
     Uses the atomic YAML writer so a concurrent process can't observe a
     partially-written file.  Returns True on success, False on any error
     (including the config file being absent — onboarding is best-effort).
     """
+    # A first-touch hint can fire while a model/tool turn is running. On managed
+    # profiles it must NEVER mutate config.yaml (a pinned identity authority).
+    # One small file per fixed flag avoids cross-process read/modify/write loss;
+    # a failed hint write is harmless and must not fall back to the config writer.
+    try:
+        state_path = _managed_hint_state_path(flag, config_path)
+        if state_path is not None:
+            if _hint_state_seen(state_path):
+                return True
+            from utils import atomic_json_write
+            state_path.parent.mkdir(parents=True, exist_ok=True)
+            _check_hint_state_path(state_path)
+            atomic_json_write(state_path, {"schema_version": 1, "seen": True})
+            return _hint_state_seen(state_path)
+    except Exception as e:
+        logger.debug("onboarding: failed to persist managed hint %s: %s", flag, type(e).__name__)
+        return False
+
     try:
         import yaml
         from hermes_cli.config import atomic_config_write
