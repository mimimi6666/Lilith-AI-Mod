+def test_capture_accepts_lilith_runtime_formal_session(monkeypatch):
+    from tools.cronjob_tools import _local_workbench_origin_from_env
+
+    monkeypatch.setenv("HERMES_CRON_TICKER", "1")
+    env = {
+        "HERMES_SESSION_SOURCE": "lilith-runtime",
+        "HERMES_SESSION_KEY": "durable-formal-a",
+        "HERMES_SESSION_ID": "durable-formal-a",
+        "HERMES_UI_SESSION_ID": "formal-tab-a",
+    }
+
+    with _session_env(env):
+        captured = _local_workbench_origin_from_env(None)
+
+    assert captured == {
+        "kind": "local_workbench",
+        "source": "lilith-runtime",
+        "session_key": "durable-formal-a",
+        "session_id": "durable-formal-a",
+        "ui_session_id": "formal-tab-a",
+    }
+
+
+@pytest.mark.parametrize("updated_deliver", ["local", "all"])
+def test_delivery_update_preserves_lilith_runtime_return_address(
+    isolated_cron_home,
+    monkeypatch,
+    updated_deliver,
+):
+    from cron.jobs import create_job, update_job
+    from tools.cronjob_tools import _local_workbench_origin_from_env
+
+    monkeypatch.setenv("HERMES_CRON_TICKER", "1")
+    env = {
+        "HERMES_SESSION_SOURCE": "lilith-runtime",
+        "HERMES_SESSION_KEY": "durable-formal-a",
+        "HERMES_SESSION_ID": "durable-formal-a",
+        "HERMES_UI_SESSION_ID": "formal-tab-a",
+    }
+    with _session_env(env):
+        local_origin = _local_workbench_origin_from_env(None)
+
+    job = create_job(
+        prompt="say the timer is done",
+        schedule="1m",
+        local_workbench_origin=local_origin,
+    )
+    updated = update_job(job["id"], {"deliver": updated_deliver})
+
+    assert updated is not None
+    assert updated["deliver"] == updated_deliver
+    assert updated["local_workbench_origin"] == {
+        "kind": "local_workbench",
+        "source": "lilith-runtime",
+        "session_key": "durable-formal-a",
+        "session_id": "durable-formal-a",
+        "ui_session_id": "formal-tab-a",
+    }
+
