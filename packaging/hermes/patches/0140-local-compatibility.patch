+++ b/tests/test_local_compatibility_preferences.py
@@ -0,0 +1,77 @@
+"""No provider calls or real profile writes: strict, isolated compatibility preference."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from agent.local_compatibility_preferences import (
+    LocalCompatibilityPreference, PreferenceError, PreferenceUpdate,
+    decode_packet, parse_preference, parse_update, parse_receipt,
+)
+from agent.local_compatibility_store import LocalCompatibilityStore, STATE_NAME
+
+
+class LocalCompatibilityPreferencesTests(unittest.TestCase):
+    def test_default_is_off_and_read_does_not_create_store(self):
+        with tempfile.TemporaryDirectory() as root:
+            self.assertEqual(LocalCompatibilityPreference(), LocalCompatibilityStore(root).get())
+            self.assertEqual([], list(Path(root).iterdir()))
+
+    def test_only_exact_boolean_and_initial_off_are_accepted(self):
+        for bad in (1, 0, "true", None, [], {}):
+            with self.assertRaises(PreferenceError):
+                parse_preference({"schema_version": 1, "revision": 1, "enabled": bad})
+        with self.assertRaises(PreferenceError):
+            LocalCompatibilityPreference(0, True)
+        with self.assertRaises(PreferenceError):
+            decode_packet(b'{"enabled":false,"enabled":true}')
+        with self.assertRaises(PreferenceError):
+            parse_update({"schema_version": 1, "operation_id": "a", "expected_revision": 0,
+                          "enabled": True, "profile": "untrusted"})
+
+    def test_cas_restart_and_receipt_replay_do_not_roll_back(self):
+        with tempfile.TemporaryDirectory() as root:
+            store = LocalCompatibilityStore(root)
+            first = store.set(PreferenceUpdate("on", 0, True))
+            self.assertEqual(LocalCompatibilityPreference(1, True), first.current)
+            self.assertEqual(first.receipt, parse_receipt(first.receipt.to_wire()))
+            second = LocalCompatibilityStore(root).set(PreferenceUpdate("off", 1, False))
+            replay = store.set(PreferenceUpdate("on", 0, True))
+            self.assertTrue(replay.replay)
+            self.assertEqual(second.current, replay.current)
+            with self.assertRaisesRegex(PreferenceError, "revision_conflict"):
+                store.set(PreferenceUpdate("stale", 0, True))
+            with self.assertRaisesRegex(PreferenceError, "operation_conflict"):
+                store.set(PreferenceUpdate("on", 0, False))
+            self.assertFalse(Path(root, ".lilith-usage-budget.sqlite3").exists())
+            self.assertFalse(Path(root, "config.yaml").exists())
+
+    def test_precommit_failure_rolls_back_and_postcommit_failure_retains_receipt(self):
+        with tempfile.TemporaryDirectory() as root:
+            store = LocalCompatibilityStore(root)
+            store.set(PreferenceUpdate("initial", 0, True))
+            with patch.object(LocalCompatibilityStore, "_commit", side_effect=OSError("synthetic")):
+                with self.assertRaises(PreferenceError):
+                    store.set(PreferenceUpdate("off", 1, False))
+            self.assertEqual(LocalCompatibilityPreference(1, True), store.get())
+            def committed_then_failed(connection):
+                connection.execute("COMMIT")
+                raise OSError("synthetic uncertain result")
+            with patch.object(LocalCompatibilityStore, "_commit", side_effect=committed_then_failed):
+                with self.assertRaises(PreferenceError):
+                    store.set(PreferenceUpdate("off", 1, False))
+            self.assertEqual(LocalCompatibilityPreference(2, False), store.get())
+            self.assertTrue(store.set(PreferenceUpdate("off", 1, False)).replay)
+
+    def test_malformed_store_is_not_reset(self):
+        with tempfile.TemporaryDirectory() as root:
+            path = Path(root, STATE_NAME)
+            path.write_bytes(b"synthetic-corruption")
+            with self.assertRaises(PreferenceError):
+                LocalCompatibilityStore(root).get()
+            self.assertEqual(b"synthetic-corruption", path.read_bytes())
+
+
+if __name__ == "__main__":
+    unittest.main()
