diff --git a/agent/local_compatibility.py b/agent/local_compatibility.py
new file mode 100644
--- /dev/null
+++ b/agent/local_compatibility.py
@@ -0,0 +1,214 @@
+"""Opt-in local request compatibility, never routing or permission authority.
+
+The host freezes the preference and resolved capacity at a human-turn boundary.
+Nothing is inferred from a model name, private-IP heuristic, or caller boolean.
+Counts remain explicitly estimates, not a promise about an unknown tokenizer.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+from hashlib import sha256
+from urllib.parse import urlsplit
+
+from agent.usage_budget import BudgetError
+
+
+class LocalCompatibilityError(BudgetError):
+    pass
+
+
+@dataclass(frozen=True)
+class LocalCompatibilityPolicy:
+    context_tokens: int
+    input_budget: int
+    output_reserve: int
+    route_digest: str = field(repr=False)
+    requested_provider: str = field(default="", repr=False)
+    provider: str = field(default="", repr=False)
+    enabled: bool = field(default=True, init=False)
+
+
+_CURRENT = ContextVar("lilith_local_compatibility", default=None)
+_NATIVE_LOCAL = frozenset(("local", "ollama", "lmstudio", "lm-studio", "llamacpp", "llama.cpp", "vllm"))
+
+
+def _endpoint(value):
+    if not isinstance(value, str):
+        return None
+    try:
+        parsed = urlsplit(value)
+        if (parsed.scheme not in ("http", "https") or parsed.username is not None
+                or parsed.password is not None or parsed.query or parsed.fragment
+                or parsed.hostname not in ("localhost", "127.0.0.1", "::1")):
+            return None
+        port = parsed.port or (443 if parsed.scheme == "https" else 80)
+        return (parsed.scheme, parsed.hostname, port, parsed.path.rstrip("/"))
+    except (ValueError, TypeError):
+        return None
+
+
+def _digest(provider, model, endpoint, api_mode):
+    return sha256(repr((provider, model, endpoint, api_mode or "chat_completions")).encode("utf-8")).hexdigest()
+
+
+def _declared_local(runtime):
+    endpoint = _endpoint(runtime.get("base_url"))
+    if endpoint is None or runtime.get("api_mode", "chat_completions") not in ("", "chat_completions"):
+        return False
+    provider = str(runtime.get("provider") or "").lower()
+    requested = str(runtime.get("requested_provider") or "").lower()
+    if provider in _NATIVE_LOCAL or (provider == "custom" and requested in _NATIVE_LOCAL):
+        return True
+    # Validate the exact saved entry and marker. Never load its credential.
+    try:
+        from hermes_cli.provider_setup import _raw_config, owned_entry
+        entry = owned_entry(_raw_config(), provider)
+        return (entry["lilith_setup"]["kind"] == "local"
+                and _endpoint(entry["base_url"]) == endpoint
+                )
+    except Exception:
+        return False
+
+
+def freeze_for_agent(agent):
+    """Called only at the owned turn prologue; Off/cloud do no metadata probe."""
+    runtime = {name: getattr(agent, name, "") for name in
+               ("provider", "requested_provider", "model", "base_url", "api_mode")}
+    if _endpoint(runtime["base_url"]) is None:
+        return None
+    try:
+        from hermes_cli.config import get_hermes_home
+        from agent.local_compatibility_store import get_preference
+        if get_preference(get_hermes_home()).enabled is not True or not _declared_local(runtime):
+            return None
+        from agent.local_compatibility_capacity import loaded_capacity
+        capacity = loaded_capacity(runtime, getattr(agent, "api_key", ""))
+        if type(capacity) is not int or capacity < 64000:
+            raise LocalCompatibilityError("local_compatibility_context_unavailable")
+        reserve = 4096
+        # Leave explicit headroom in addition to the actual output reservation.
+        input_budget = capacity - reserve - max(2048, capacity // 10)
+        return LocalCompatibilityPolicy(capacity, input_budget, reserve,
+            _digest(runtime["provider"], runtime["model"], _endpoint(runtime["base_url"]), runtime["api_mode"]),
+            runtime["requested_provider"], runtime["provider"])
+    except LocalCompatibilityError:
+        raise
+    except Exception:
+        # An unreadable switch is never interpreted as enabled.
+        return None
+
+
+def for_agent(agent):
+    policy = getattr(agent, "_local_compatibility_policy", None)
+    if policy is None:
+        return None
+    if not matches(policy, provider=getattr(agent, "provider", ""), model=getattr(agent, "model", ""),
+        base_url=getattr(agent, "base_url", ""), api_mode=getattr(agent, "api_mode", ""),
+        requested_provider=getattr(agent, "requested_provider", "")):
+        raise LocalCompatibilityError("local_compatibility_route_changed")
+    return policy
+
+
+def matches(policy, *, provider, model, base_url, api_mode="chat_completions", requested_provider=None):
+    return (type(policy) is LocalCompatibilityPolicy and _endpoint(base_url) is not None
+            and policy.route_digest == _digest(provider, model, _endpoint(base_url), api_mode)
+            and (requested_provider is None or requested_provider == policy.requested_provider))
+
+
+def current_policy():
+    return _CURRENT.get()
+
+
+def compressor_policy(compressor):
+    agent = getattr(compressor, "_strict_identity_agent", None)
+    policy = getattr(agent, "_local_compatibility_policy", None)
+    if policy is None:
+        return None
+    # Model-switch initialization may inspect the old compressor between
+    # turns. It cannot borrow the old policy; actual dispatch rejects drift.
+    try:
+        return for_agent(agent)
+    except LocalCompatibilityError:
+        return None
+
+
+@contextmanager
+def bind_policy(policy):
+    if policy is not None and type(policy) is not LocalCompatibilityPolicy:
+        raise TypeError("expected host local compatibility policy")
+    token = _CURRENT.set(policy)
+    try:
+        yield
+    finally:
+        _CURRENT.reset(token)
+
+
+def prepare_request(policy, request, *, provider, model, base_url, api_mode="chat_completions"):
+    """Final send-copy guard. Never truncate authority, tools or current input."""
+    if policy is None:
+        return request
+    if not matches(policy, provider=provider, model=model, base_url=base_url, api_mode=api_mode):
+        raise LocalCompatibilityError("local_compatibility_route_changed")
+    extra = request.get("extra_body")
+    if extra is not None and type(extra) is not dict:
+        raise BudgetError("invalid_extra_body")
+    if extra and any(key in extra for key in ("stream", "stream_options", "timeout",
+            "extra_headers", "extra_query", "extra_body")):
+        raise BudgetError("late_wire_override")
+    body = {key: value for key, value in request.items() if key != "extra_body"}
+    if extra:
+        body.update(extra)
+    if "model" in body and body["model"] != model:
+        raise LocalCompatibilityError("local_compatibility_route_changed")
+    from agent.usage_budget_official_routes import estimate_final_input
+    measured = estimate_final_input(request)
+    if measured.tokens > policy.input_budget:
+        raise LocalCompatibilityError("local_compatibility_input_too_large")
+    result = body
+    fields = [key for key in ("max_tokens", "max_completion_tokens") if key in result]
+    for key in fields:
+        if type(result[key]) is not int or result[key] <= 0:
+            raise LocalCompatibilityError("local_compatibility_output_cap_invalid")
+    if len(fields) > 1 and result[fields[0]] != result[fields[1]]:
+        raise LocalCompatibilityError("local_compatibility_output_cap_conflict")
+    # Preserve a smaller explicit caller cap even if SDK extra_body would
+    # otherwise overwrite that same key. Never mutate either caller container.
+    prior_caps = [container[key] for container in (request, extra or {})
+                  for key in ("max_tokens", "max_completion_tokens") if key in container]
+    if any(type(value) is not int or value <= 0 for value in prior_caps):
+        raise LocalCompatibilityError("local_compatibility_output_cap_invalid")
+    cap = min([policy.output_reserve] + prior_caps)
+    result[fields[0] if fields else "max_tokens"] = cap
+    if len(fields) > 1:
+        result[fields[1]] = cap
+    if extra is not None:
+        original_keys = set(request) - {"extra_body"}
+        output_keys = {"max_tokens", "max_completion_tokens"}
+        restored = {key: value for key, value in result.items() if key in original_keys or key in output_keys}
+        remaining = {key: value for key, value in result.items() if key not in restored}
+        if remaining:
+            restored["extra_body"] = remaining
+        return restored
+    return result
+
+
+def prepare_final_sdk_request(client, request, wire_format):
+    """Last physical leaf after native quota shaping; local capacity wins."""
+    policy = current_policy()
+    if policy is None:
+        return request
+    import sys
+    sdk = sys.modules.get("openai")
+    if (sdk is None or type(client) not in (getattr(sdk, "OpenAI", None), getattr(sdk, "AsyncOpenAI", None))
+            or wire_format not in ("chat_completions", "chat_max_tokens", "chat_max_completion_tokens")):
+        raise LocalCompatibilityError("local_compatibility_route_changed")
+    extra = request.get("extra_body")
+    model = extra.get("model", request.get("model")) if isinstance(extra, dict) else request.get("model")
+    return prepare_request(policy, request, provider=policy.provider, model=model,
+        base_url=str(getattr(client, "base_url", "")), api_mode="chat_completions")
+
+
+def prepare_agent_request(agent, request):
+    policy = for_agent(agent)
+    return prepare_request(policy, request, provider=getattr(agent, "provider", ""), model=getattr(agent, "model", ""),
+        base_url=getattr(agent, "base_url", ""), api_mode=getattr(agent, "api_mode", ""))
