+++ b/tests/test_local_compatibility_rpc.py
@@ -0,0 +1,54 @@
+"""Human management only; fixed temporary launch profile, no provider calls."""
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from tui_gateway import methods_local_compatibility as rpc
+
+
+class LocalCompatibilityRpcTests(unittest.TestCase):
+    def host(self, root, transport=None):
+        return types.SimpleNamespace(
+            _hermes_home=Path(root), _stdio_transport=object(), _LONG_HANDLERS=frozenset(),
+            _methods={}, current_transport=lambda: transport,
+            _native_authority_quarantine_rpc_error=lambda rid: None,
+            _ok=lambda rid, body: body)
+
+    def test_attested_runtime_roundtrip_and_fixed_launch_profile(self):
+        with tempfile.TemporaryDirectory() as root, patch.object(rpc, "_strict_host_required", return_value=True):
+            server = self.host(root, types.SimpleNamespace(lilith_runtime_attested=True, _closed=False))
+            rpc.register(server)
+            self.assertEqual({"local_compatibility.get", "local_compatibility.set"}, set(server._methods))
+            first = server._methods["local_compatibility.get"](1, {})
+            self.assertFalse(first["enabled"])
+            committed = server._methods["local_compatibility.set"](2, {
+                "schema_version": 1, "operation_id": "on", "expected_revision": 0, "enabled": True})
+            self.assertTrue(committed["preference"]["enabled"])
+            self.assertEqual("next_origin_turn", committed["receipt"]["applies_from"])
+            rejected = server._methods["local_compatibility.set"](3, {
+                "schema_version": 1, "operation_id": "other", "expected_revision": 1,
+                "enabled": False, "profile_root": "untrusted"})
+            self.assertEqual("local_compatibility.invalid_request", rejected["code"])
+            self.assertTrue(server._methods["local_compatibility.get"](4, {})["enabled"])
+
+    def test_generic_transport_closed_transport_or_unpinned_host_cannot_read_or_write(self):
+        for transport, strict in ((object(), True),
+                (types.SimpleNamespace(lilith_runtime_attested=True, _closed=True), True), (None, False)):
+            with tempfile.TemporaryDirectory() as root, patch.object(rpc, "_strict_host_required", return_value=strict):
+                server = self.host(root, transport); rpc.register(server)
+                self.assertEqual("local_compatibility.host_required", server._methods["local_compatibility.get"](1, {})["code"])
+                self.assertEqual([], list(Path(root).iterdir()))
+
+    def test_authority_quarantine_is_not_bypassed(self):
+        with tempfile.TemporaryDirectory() as root, patch.object(rpc, "_strict_host_required", return_value=True):
+            server = self.host(root); blocked = object()
+            server._native_authority_quarantine_rpc_error = lambda rid: blocked
+            rpc.register(server)
+            self.assertIs(blocked, server._methods["local_compatibility.get"](1, {}))
+            self.assertEqual([], list(Path(root).iterdir()))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tui_gateway/methods_local_compatibility.py b/tui_gateway/methods_local_compatibility.py
new file mode 100644
--- /dev/null
+++ b/tui_gateway/methods_local_compatibility.py
@@ -0,0 +1,69 @@
+"""Human Runtime control-plane handlers, not agent tools or config setters.
+
+Registration freezes the trusted gateway launch profile. Neither a session's
+ambient home override nor any client-supplied path can redirect this store.
+The authenticated Runtime enforces Workbench ownership; native additionally
+rejects generic WebSockets and hosts without the pinned identity contract.
+The existing server-attested Runtime WebSocket is the production ingress.
+"""
+from agent.local_compatibility_preferences import PreferenceError, parse_update
+from agent.local_compatibility_store import get_preference, set_preference
+
+
+def _strict_host_required():
+    from agent.identity_policy import identity_lock_required_by_host
+    return identity_lock_required_by_host() is True
+
+
+def register(server):
+    profile_root = server._hermes_home
+    stdio = server._stdio_transport
+
+    def failure(rid, code):
+        return server._ok(rid, {"schema_version": 1, "code": "local_compatibility." + code})
+
+    def invoke(rid, params, *, method):
+        mutation = method == "local_compatibility.set"
+        try:
+            transport = server.current_transport()
+            trusted_transport = (transport is None or transport is stdio
+                                 or getattr(transport, "lilith_runtime_attested", False) is True)
+            if (not trusted_transport or getattr(transport, "_closed", False)
+                    or not _strict_host_required()):
+                return failure(rid, "host_required")
+        except Exception:
+            return failure(rid, "host_required")
+        quarantined = server._native_authority_quarantine_rpc_error(rid)
+        if quarantined is not None:
+            return quarantined
+        # Validate before touching storage. There are no hidden passthrough
+        # knobs for permission, maximum tokens, session identity or profile.
+        try:
+            if mutation:
+                update = parse_update(params)
+            elif type(params) is not dict or params:
+                raise PreferenceError("invalid_fields")
+        except PreferenceError:
+            return failure(rid, "invalid_request")
+        try:
+            if mutation:
+                return server._ok(rid, set_preference(profile_root, update).to_wire())
+            return server._ok(rid, get_preference(profile_root).to_wire())
+        except PreferenceError as error:
+            # Never echo exception text, private paths or rejected data.
+            code = str(error)
+            if code not in {
+                "revision_conflict", "operation_conflict", "revision_exhausted",
+                "store_capacity_reached", "store_busy", "store_unavailable",
+                "store_malformed", "unsafe_store_path",
+            }:
+                code = "operation_failed"
+            return failure(rid, code)
+        except Exception:
+            # Persistence may have committed before an IO failure; the caller
+            # must use the same operation ID/readback, not presume rollback.
+            return failure(rid, "operation_failed")
+
+    server._methods["local_compatibility.get"] = lambda rid, params: invoke(rid, params, method="local_compatibility.get")
+    server._methods["local_compatibility.set"] = lambda rid, params: invoke(rid, params, method="local_compatibility.set")
+    server._LONG_HANDLERS = server._LONG_HANDLERS | frozenset({"local_compatibility.get", "local_compatibility.set"})
