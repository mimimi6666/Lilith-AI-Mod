+++ b/agent/local_compatibility_preferences.py
@@ -0,0 +1,209 @@
+"""Closed, default-off local compatibility preference; not model or permission authority.
+
+Hermes binds the profile and commits this independent preference plus receipt atomically.
+The flag is captured only for the next origin turn and cannot alter cloud routes.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import re
+from typing import Any
+
+
+SCHEMA_VERSION = 1
+MAX_REVISION = 2**63 - 1
+MAX_PACKET_BYTES = 2048
+APPLIES_FROM = "next_origin_turn"
+_OPERATION_ID = re.compile(r"[A-Za-z0-9_-]{1,96}\Z", re.ASCII)
+
+
+class PreferenceError(ValueError):
+    """Fixed, content-free protocol diagnostic; never echo rejected payloads."""
+
+
+def _integer(value: Any, minimum: int, maximum: int, field: str) -> int:
+    if type(value) is not int or not minimum <= value <= maximum:
+        raise PreferenceError("invalid_" + field)
+    return value
+
+
+def _boolean(value: Any) -> None:
+    if type(value) is not bool:
+        raise PreferenceError("invalid_enabled")
+
+
+def _shape(value: Any, keys: set[str]) -> dict:
+    if type(value) is not dict or set(value) != keys:
+        raise PreferenceError("invalid_fields")
+    return value
+
+
+def _schema(value: Any) -> None:
+    if type(value) is not int or value != SCHEMA_VERSION:
+        raise PreferenceError("unsupported_schema")
+
+
+def _operation(value: Any) -> str:
+    if type(value) is not str or _OPERATION_ID.fullmatch(value) is None:
+        raise PreferenceError("invalid_operation_id")
+    return value
+
+
+def _unique_object(pairs: list[tuple[str, Any]]) -> dict:
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise PreferenceError("duplicate_field")
+        result[key] = value
+    return result
+
+
+def _invalid_constant(_value: str) -> None:
+    raise PreferenceError("invalid_json")
+
+
+def decode_packet(payload: bytes) -> dict:
+    """Strict bounded JSON; duplicate keys cannot acquire last-write-wins meaning."""
+    if type(payload) is not bytes or not 0 < len(payload) <= MAX_PACKET_BYTES:
+        raise PreferenceError("invalid_packet_size")
+    try:
+        value = json.loads(payload.decode("utf-8", errors="strict"),
+                           object_pairs_hook=_unique_object,
+                           parse_constant=_invalid_constant)
+    except PreferenceError:
+        raise
+    except (UnicodeError, ValueError, RecursionError):
+        raise PreferenceError("invalid_json") from None
+    if type(value) is not dict:
+        raise PreferenceError("invalid_fields")
+    return value
+
+
+@dataclass(frozen=True)
+class LocalCompatibilityPreference:
+    revision: int = 0
+    enabled: bool = False
+
+    def __post_init__(self) -> None:
+        _integer(self.revision, 0, MAX_REVISION, "revision")
+        _boolean(self.enabled)
+        if self.revision == 0 and self.enabled is not False:
+            raise PreferenceError("invalid_initial_policy")
+
+    def to_wire(self) -> dict:
+        return {"schema_version": SCHEMA_VERSION,
+                "revision": self.revision, "enabled": self.enabled}
+
+    @property
+    def digest(self) -> str:
+        canonical = json.dumps(self.to_wire(), sort_keys=True,
+                               separators=(",", ":")).encode("ascii")
+        return hashlib.sha256(canonical).hexdigest()
+
+
+def parse_preference(value: Any) -> LocalCompatibilityPreference:
+    doc = _shape(value, {"schema_version", "revision", "enabled"})
+    _schema(doc["schema_version"])
+    return LocalCompatibilityPreference(doc["revision"], doc["enabled"])
+
+
+@dataclass(frozen=True)
+class PreferenceUpdate:
+    operation_id: str
+    expected_revision: int
+    enabled: bool
+
+    def __post_init__(self) -> None:
+        _operation(self.operation_id)
+        _integer(self.expected_revision, 0, MAX_REVISION, "expected_revision")
+        _boolean(self.enabled)
+
+
+def parse_update(value: Any) -> PreferenceUpdate:
+    doc = _shape(value, {"schema_version", "operation_id", "expected_revision", "enabled"})
+    _schema(doc["schema_version"])
+    return PreferenceUpdate(doc["operation_id"], doc["expected_revision"], doc["enabled"])
+
+
+@dataclass(frozen=True)
+class PreferenceReceipt:
+    operation_id: str
+    expected_revision: int
+    committed: LocalCompatibilityPreference
+
+    def __post_init__(self) -> None:
+        _operation(self.operation_id)
+        _integer(self.expected_revision, 0, MAX_REVISION - 1, "expected_revision")
+        if type(self.committed) is not LocalCompatibilityPreference:
+            raise PreferenceError("invalid_committed_policy")
+        if self.committed.revision != self.expected_revision + 1:
+            raise PreferenceError("invalid_revision_transition")
+
+    def to_wire(self) -> dict:
+        return {"schema_version": SCHEMA_VERSION,
+                "operation_id": self.operation_id,
+                "expected_revision": self.expected_revision,
+                "revision": self.committed.revision,
+                "enabled": self.committed.enabled,
+                "preference_digest": self.committed.digest,
+                "applies_from": APPLIES_FROM}
+
+
+def parse_receipt(value: Any) -> PreferenceReceipt:
+    doc = _shape(value, {"schema_version", "operation_id", "expected_revision",
+                        "revision", "enabled", "preference_digest", "applies_from"})
+    _schema(doc["schema_version"])
+    if doc["applies_from"] != APPLIES_FROM:
+        raise PreferenceError("invalid_application_boundary")
+    committed = LocalCompatibilityPreference(doc["revision"], doc["enabled"])
+    if type(doc["preference_digest"]) is not str or doc["preference_digest"] != committed.digest:
+        raise PreferenceError("invalid_preference_digest")
+    return PreferenceReceipt(doc["operation_id"], doc["expected_revision"], committed)
+
+
+@dataclass(frozen=True)
+class PreferenceTransition:
+    """A plan, not evidence of a successful write or running-turn application."""
+    current: LocalCompatibilityPreference
+    proposed: LocalCompatibilityPreference
+    receipt: PreferenceReceipt
+    replay: bool
+
+
+def plan_update(current: LocalCompatibilityPreference, update: PreferenceUpdate,
+                prior_receipt: PreferenceReceipt | None = None) -> PreferenceTransition:
+    """Called inside a future host transaction after profile/authentication checks.
+
+    A replay returns the old immutable receipt but retains today's snapshot.
+    Old receipts must never roll the profile back after another valid update.
+    No in-flight turn or ledger is supplied or mutated by this function.
+    """
+    if type(current) is not LocalCompatibilityPreference or type(update) is not PreferenceUpdate:
+        raise PreferenceError("invalid_typed_transaction")
+    if prior_receipt is not None:
+        if type(prior_receipt) is not PreferenceReceipt:
+            raise PreferenceError("invalid_prior_receipt")
+        if (prior_receipt.operation_id != update.operation_id
+                or prior_receipt.expected_revision != update.expected_revision
+                or prior_receipt.committed.enabled != update.enabled):
+            raise PreferenceError("operation_conflict")
+        if (current.revision < prior_receipt.committed.revision
+                or (current.revision == prior_receipt.committed.revision
+                    and current != prior_receipt.committed)):
+            raise PreferenceError("receipt_state_conflict")
+        return PreferenceTransition(current, current, prior_receipt, True)
+    if update.expected_revision != current.revision:
+        raise PreferenceError("revision_conflict")
+    if current.revision == MAX_REVISION:
+        raise PreferenceError("revision_exhausted")
+    proposed = LocalCompatibilityPreference(current.revision + 1, update.enabled)
+    receipt = PreferenceReceipt(update.operation_id, current.revision, proposed)
+    return PreferenceTransition(current, proposed, receipt, False)
+
+
+def matches_readback(receipt: PreferenceReceipt, snapshot: LocalCompatibilityPreference) -> bool:
+    """Exact saved-state acknowledgement, never 'all running turns effective'."""
+    return (type(receipt) is PreferenceReceipt and type(snapshot) is LocalCompatibilityPreference
+            and receipt.committed == snapshot)
