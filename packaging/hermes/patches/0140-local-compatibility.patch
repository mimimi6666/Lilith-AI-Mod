+"""Hermes-owned local compatibility preference, separate from economic policy and config.
+
+No model, credential, permission, session or player memory data enters this store.
+The path-pinning and atomic SQLite recipe deliberately mirror the audited usage store,
+with distinct constants and no mutation of shared module globals.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+import hashlib
+import os
+from pathlib import Path
+import stat
+import sqlite3
+import time
+import uuid
+
+from agent.local_compatibility_preferences import (
+    PreferenceError, PreferenceReceipt, PreferenceUpdate, LocalCompatibilityPreference,
+    plan_update,
+)
+
+
+STATE_NAME = ".lilith-local-compatibility.sqlite3"
+LEGACY_STATE_NAME = ".lilith-local-compatibility.json"
+JOURNAL_NAME = STATE_NAME + "-journal"
+LOCK_NAME = ".lilith-local-compatibility.lock"
+_APPLICATION_ID = 0x4C434D50
+_SCHEMA = (
+    "CREATE TABLE preference (singleton INTEGER PRIMARY KEY CHECK(singleton=1), revision INTEGER NOT NULL, enabled INTEGER NOT NULL)",
+    "CREATE TABLE receipts (operation_id TEXT PRIMARY KEY, expected_revision INTEGER NOT NULL UNIQUE, revision INTEGER NOT NULL UNIQUE, enabled INTEGER NOT NULL)",
+)
+_REPARSE_POINT = 0x400
+
+
+def _stored_enabled(value):
+    if type(value) is not int or value not in (0, 1):
+        raise LocalCompatibilityStoreError("store_malformed")
+    return bool(value)
+
+
+class LocalCompatibilityStoreError(PreferenceError):
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
+@dataclass(frozen=True)
+class StoreCommit:
+    current: LocalCompatibilityPreference
+    receipt: PreferenceReceipt
+    replay: bool
+
+    def to_wire(self) -> dict:
+        return {"preference": self.current.to_wire(),
+                "receipt": self.receipt.to_wire(), "replay": self.replay}
+
+
+
+
+def _safe_stat(info, *, directory=False) -> None:
+    if (getattr(info, "st_file_attributes", 0) & _REPARSE_POINT
+            or stat.S_ISLNK(info.st_mode)
+            or (not stat.S_ISDIR(info.st_mode) if directory else not stat.S_ISREG(info.st_mode))
+            or (not directory and info.st_nlink != 1)):
+        raise LocalCompatibilityStoreError("unsafe_store_path")
+
+
+def _windows():
+    # Loaded only on Windows, not as a third-party runtime dependency.
+    import ctypes
+    from ctypes import wintypes
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
+                                  wintypes.LPVOID, wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+    kernel.CreateFileW.restype = wintypes.HANDLE
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    kernel.CloseHandle.restype = wintypes.BOOL
+    kernel.MoveFileExW.argtypes = [wintypes.LPCWSTR, wintypes.LPCWSTR, wintypes.DWORD]
+    kernel.MoveFileExW.restype = wintypes.BOOL
+    return ctypes, kernel
+
+
+def _win_open(path: Path, *, directory=False, create=False, exclusive=False,
+              writable=False, allow_delete=False) -> int:
+    import msvcrt
+    ctypes, kernel = _windows()
+    access = 0x80 if directory else (0xC0000000 if writable else 0x80000000)
+    share = 3 | (4 if allow_delete else 0)
+    creation = 1 if exclusive else (4 if create else 3)
+    flags = 0x00200000 | (0x02000000 if directory else 0x80)
+    handle = kernel.CreateFileW(str(path), access, share, None, creation, flags, None)
+    if handle == ctypes.c_void_p(-1).value:
+        code = ctypes.get_last_error()
+        if code in (2, 3):
+            raise FileNotFoundError()
+        raise OSError(code, "local_compatibility_file_open_failed")
+    if directory:
+        return handle
+    try:
+        return msvcrt.open_osfhandle(handle, os.O_BINARY | (os.O_RDWR if writable else os.O_RDONLY))
+    except BaseException:
+        kernel.CloseHandle(handle)
+        raise
+
+
+class _Directory:
+    """Pin the complete parent chain against rename/reparse substitution."""
+    def __init__(self, path: Path):
+        self.path = path
+        self.handles = []
+        self.fd = None
+
+    def __enter__(self):
+        try:
+            if os.name == "nt":
+                # Deny FILE_SHARE_DELETE on every ancestor: a checked component
+                # cannot be renamed/replaced while relative child work proceeds.
+                for path in (*reversed(self.path.parents), self.path):
+                    handle = _win_open(path, directory=True)
+                    self.handles.append(handle)
+                    _safe_stat(os.stat(path, follow_symlinks=False), directory=True)
+            else:
+                flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+                self.fd = os.open(self.path.anchor, flags)
+                self.handles.append(self.fd)
+                for part in self.path.parts[1:]:
+                    self.fd = os.open(part, flags, dir_fd=self.fd)
+                    self.handles.append(self.fd)
+                    _safe_stat(os.fstat(self.fd), directory=True)
+            return self
+        except BaseException:
+            self.__exit__(None, None, None)
+            raise
+
+    def __exit__(self, *_):
+        for handle in reversed(self.handles):
+            if os.name == "nt":
+                _windows()[1].CloseHandle(handle)
+            else:
+                os.close(handle)
+        self.handles.clear()
+
+    def open(self, name, *, writable=False, create=False, exclusive=False, allow_delete=False):
+        if os.name == "nt":
+            descriptor = _win_open(self.path / name, writable=writable, create=create,
+                                   exclusive=exclusive, allow_delete=allow_delete)
+        else:
+            flags = os.O_RDWR if writable else os.O_RDONLY
+            flags |= os.O_NOFOLLOW
+            if create:
+                flags |= os.O_CREAT
+            if exclusive:
+                flags |= os.O_EXCL
+            descriptor = os.open(name, flags, 0o600, dir_fd=self.fd)
+        try:
+            _safe_stat(os.fstat(descriptor))
+        except BaseException:
+            os.close(descriptor)
+            raise
+        return descriptor
+
+    def remove(self, name):
+        if os.name == "nt":
+            os.unlink(self.path / name)
+        else:
+            os.unlink(name, dir_fd=self.fd)
+
+    def replace(self, name):
+        if os.name == "nt":
+            ctypes, kernel = _windows()
+            # One same-directory atomic replacement; flush written bytes first,
+            # then request write-through. No delete/copy fallback is allowed.
+            if not kernel.MoveFileExW(str(self.path / name), str(self.path / STATE_NAME), 1 | 8):
+                raise OSError(ctypes.get_last_error(), "local_compatibility_replace_failed")
+        else:
+            os.replace(name, STATE_NAME, src_dir_fd=self.fd, dst_dir_fd=self.fd)
+            os.fsync(self.fd)
+
+
+@contextmanager
+def _writer_lock(directory: _Directory, timeout: float):
+    descriptor = directory.open(LOCK_NAME, writable=True, create=True)
+    locked = False
+    try:
+        deadline = time.monotonic() + timeout
+        while True:
+            try:
+                if os.name == "nt":
+                    import msvcrt
+                    os.lseek(descriptor, 0, os.SEEK_SET)
+                    msvcrt.locking(descriptor, msvcrt.LK_NBLCK, 1)
+                else:
+                    import fcntl
+                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                locked = True
+                break
+            except OSError:
+                if time.monotonic() >= deadline:
+                    raise LocalCompatibilityStoreError("store_busy") from None
+                time.sleep(min(0.01, max(0, deadline - time.monotonic())))
+        yield
+    finally:
+        if locked:
+            if os.name == "nt":
+                import msvcrt
+                os.lseek(descriptor, 0, os.SEEK_SET)
+                msvcrt.locking(descriptor, msvcrt.LK_UNLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(descriptor, fcntl.LOCK_UN)
+        os.close(descriptor)
+
+
+class LocalCompatibilityStore:
+    def __init__(self, profile_root, *, lock_timeout: float = 3.0):
+        path = Path(profile_root)
+        if (not path.is_absolute() or ".." in path.parts or path == Path(path.anchor)
+                or str(path).startswith(("\\\\", "//"))):
+            raise LocalCompatibilityStoreError("unsafe_store_path")
+        if type(lock_timeout) not in (int, float) or not 0 <= lock_timeout <= 10:
+            raise LocalCompatibilityStoreError("invalid_lock_timeout")
+        self.profile_root = path
+        self.lock_timeout = lock_timeout
+
+    @staticmethod
+    def _exists(directory, name):
+        try:
+            descriptor = directory.open(name)
+        except FileNotFoundError:
+            return False
+        else:
+            os.close(descriptor)
+            return True
+
+    @staticmethod
+    def _connect(path, *, initialize=False):
+        connection = sqlite3.connect(path.as_uri() + "?mode=rw", uri=True, timeout=0,
+                                     isolation_level=None)
+        try:
+            connection.row_factory = sqlite3.Row
+            connection.execute("PRAGMA trusted_schema=OFF")
+            if not initialize:
+                LocalCompatibilityStore._validate(connection)
+            connection.execute("PRAGMA foreign_keys=ON")
+            connection.execute("PRAGMA synchronous=FULL")
+            # Keep the checked journal handle alive. PERSIST invalidates its header
+            # after commit instead of deleting and recreating an unchecked path.
+            mode = connection.execute("PRAGMA journal_mode=PERSIST").fetchone()[0]
+            if mode.lower() != "persist":
+                connection.close()
+                raise LocalCompatibilityStoreError("store_journal_unavailable")
+            connection.execute("PRAGMA journal_size_limit=131072")
+            return connection
+        except BaseException:
+            connection.close()
+            raise
+
+    @staticmethod
+    def _current(connection):
+        rows = connection.execute("SELECT singleton,revision,enabled FROM preference").fetchall()
+        if len(rows) != 1 or rows[0]["singleton"] != 1:
+            raise LocalCompatibilityStoreError("store_malformed")
+        return LocalCompatibilityPreference(rows[0]["revision"], _stored_enabled(rows[0]["enabled"]))
+
+    @staticmethod
+    def _validate(connection):
+        if (connection.execute("PRAGMA application_id").fetchone()[0] != _APPLICATION_ID
+                or connection.execute("PRAGMA user_version").fetchone()[0] != 1):
+            raise LocalCompatibilityStoreError("store_malformed")
+        schema = {row["sql"] for row in connection.execute(
+            "SELECT sql FROM sqlite_master WHERE sql IS NOT NULL")}
+        if schema != set(_SCHEMA):
+            raise LocalCompatibilityStoreError("store_malformed")
+        current = LocalCompatibilityStore._current(connection)
+        latest = connection.execute(
+            "SELECT operation_id,expected_revision,revision,enabled FROM receipts ORDER BY revision DESC LIMIT 1"
+        ).fetchone()
+        if current.revision == 0:
+            if latest is not None:
+                raise LocalCompatibilityStoreError("store_malformed")
+        elif latest is None or LocalCompatibilityStore._receipt(latest).committed != current:
+            raise LocalCompatibilityStoreError("store_malformed")
+        return current
+
+    @staticmethod
+    def _receipt(row):
+        return PreferenceReceipt(row["operation_id"], row["expected_revision"],
+                                 LocalCompatibilityPreference(row["revision"], _stored_enabled(row["enabled"])))
+
+    @staticmethod
+    def _commit(connection):
+        # Dedicated seam for interrupted-commit tests. A failure may have
+        # committed; the caller must retry the same ID, never mint a new one.
+        connection.execute("COMMIT")
+
+    def _initialize(self, directory):
+        temporary = ".lilith-local-compatibility-" + uuid.uuid4().hex + ".tmp"
+        descriptors = []
+        connection = None
+        try:
+            descriptors.append(directory.open(temporary, writable=True, create=True, exclusive=True))
+            descriptors.append(directory.open(temporary + "-journal", writable=True, create=True, exclusive=True))
+            connection = self._connect(directory.path / temporary, initialize=True)
+            connection.execute("BEGIN IMMEDIATE")
+            for statement in _SCHEMA:
+                connection.execute(statement)
+            connection.execute("INSERT INTO preference VALUES(1,0,0)")
+            connection.execute(f"PRAGMA application_id={_APPLICATION_ID}")
+            connection.execute("PRAGMA user_version=1")
+            self._commit(connection)
+            self._validate(connection)
+            connection.close()
+            connection = None
+            while descriptors:
+                descriptor = descriptors.pop()
+                try:
+                    os.fsync(descriptor)
+                finally:
+                    os.close(descriptor)
+            directory.replace(temporary)
+        finally:
+            if connection is not None:
+                connection.close()
+            for descriptor in descriptors:
+                os.close(descriptor)
+            for name in (temporary, temporary + "-journal"):
+                try:
+                    directory.remove(name)
+                except FileNotFoundError:
+                    pass
+
+    @contextmanager
+    def _connection(self, *, create=False):
+        with _Directory(self.profile_root) as directory:
+            if self._exists(directory, LEGACY_STATE_NAME):
+                # The old JSON was never released. Do not silently choose one
+                # authority or manufacture a player-data migration.
+                raise LocalCompatibilityStoreError("legacy_candidate_store_present")
+            exists = self._exists(directory, STATE_NAME)
+            if not exists and not create:
+                yield None
+                return
+            with _writer_lock(directory, self.lock_timeout):
+                if not self._exists(directory, STATE_NAME):
+                    self._initialize(directory)
+                pins = []
+                connection = None
+                try:
+                    pins.append(directory.open(STATE_NAME, writable=True))
+                    header = os.read(pins[0], 72)
+                    if (len(header) != 72 or header[:16] != b"SQLite format 3\x00"
+                            or int.from_bytes(header[68:72], "big") != _APPLICATION_ID):
+                        raise LocalCompatibilityStoreError("store_malformed")
+                    pins.append(directory.open(JOURNAL_NAME, writable=True, create=True))
+                    # Reject unexpected WAL/shared-memory state; this store
+                    # never selects WAL or treats it as recovery authority.
+                    if any(self._exists(directory, name)
+                           for name in (STATE_NAME + "-wal", STATE_NAME + "-shm")):
+                        raise LocalCompatibilityStoreError("store_journal_unavailable")
+                    connection = self._connect(self.profile_root / STATE_NAME)
+                    self._validate(connection)
+                    yield connection
+                finally:
+                    if connection is not None:
+                        connection.close()
+                    for descriptor in pins:
+                        os.close(descriptor)
+
+    def get(self) -> LocalCompatibilityPreference:
+        try:
+            with self._connection() as connection:
+                return LocalCompatibilityPreference() if connection is None else self._current(connection)
+        except PreferenceError:
+            raise
+        except (OSError, sqlite3.Error):
+            raise LocalCompatibilityStoreError("store_unavailable") from None
+
+    def set(self, update: PreferenceUpdate) -> StoreCommit:
+        if type(update) is not PreferenceUpdate:
+            raise LocalCompatibilityStoreError("invalid_typed_transaction")
+        try:
+            with self._connection(create=True) as connection:
+                connection.execute("BEGIN IMMEDIATE")
+                try:
+                    current = self._current(connection)
+                    row = connection.execute(
+                        "SELECT operation_id,expected_revision,revision,enabled FROM receipts WHERE operation_id=?",
+                        (update.operation_id,)).fetchone()
+                    transition = plan_update(current, update, None if row is None else self._receipt(row))
+                    if not transition.replay:
+                        receipt = transition.receipt
+                        connection.execute("INSERT INTO receipts VALUES(?,?,?,?)", (
+                            receipt.operation_id, receipt.expected_revision,
+                            receipt.committed.revision, receipt.committed.enabled))
+                        connection.execute("UPDATE preference SET revision=?,enabled=? WHERE singleton=1",
+                                           (receipt.committed.revision, receipt.committed.enabled))
+                    self._commit(connection)
+                    return StoreCommit(self._current(connection), transition.receipt, transition.replay)
+                except BaseException:
+                    if connection.in_transaction:
+                        connection.execute("ROLLBACK")
+                    raise
+        except PreferenceError:
+            raise
+        except (OSError, sqlite3.Error):
+            raise LocalCompatibilityStoreError("store_commit_uncertain") from None
+
+
+def get_preference(profile_root) -> LocalCompatibilityPreference:
+    return LocalCompatibilityStore(profile_root).get()
+
+
+def set_preference(profile_root, update: PreferenceUpdate) -> StoreCommit:
+    return LocalCompatibilityStore(profile_root).set(update)
