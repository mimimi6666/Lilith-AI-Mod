new file mode 100644
--- /dev/null
+++ b/agent/local_compatibility_capacity.py
@@ -0,0 +1,96 @@
+"""Read-only loaded-capacity observations, not advertised model maxima.
+
+Only exact configured loopback endpoints are visited, with redirects/proxies
+disabled, bounded response sizes and a shared three-second observation budget.
+Unknown servers fail explicitly instead of guessing from a model family name.
+"""
+import json
+import time
+from urllib.parse import urlsplit, urlunsplit
+from urllib.request import Request, build_opener, ProxyHandler, HTTPRedirectHandler
+
+from agent.local_compatibility import _endpoint
+
+
+class _NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        return None
+
+
+def capacity_from_payload(payload, model, kind):
+    if not isinstance(payload, dict):
+        return None
+    rows = payload.get("models" if kind in ("lmstudio", "ollama") else "data")
+    if not isinstance(rows, list):
+        return None
+    found = []
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+        identifiers = [row.get(key) for key in ("id", "key", "name", "model")]
+        instances = row.get("loaded_instances", [])
+        if not isinstance(instances, list):
+            instances = []
+        identifiers.extend(item.get("id") for item in instances if isinstance(item, dict))
+        if model not in identifiers:
+            continue
+        if kind == "lmstudio":
+            values = [item.get("config", {}).get("context_length") for item in instances
+                      if isinstance(item, dict) and isinstance(item.get("config"), dict)]
+        elif kind == "lmstudio-v0":
+            values = [row.get("loaded_context_length")] if row.get("state") == "loaded" else []
+        elif kind == "ollama":
+            # /api/ps contains running models, not /api/show training maxima.
+            values = [row.get("context_length")]
+        else:
+            # vLLM's served-model max_model_len, not max_context_length.
+            values = [row.get("max_model_len")]
+        found.extend(value for value in values if type(value) is int and 64000 <= value <= 2097152)
+    return min(found) if found else None
+
+
+def loaded_capacity(runtime, api_key=""):
+    endpoint = _endpoint(runtime.get("base_url"))
+    model = runtime.get("model")
+    if endpoint is None or not isinstance(model, str) or not model:
+        return None
+    parsed = urlsplit(runtime["base_url"])
+    root = urlunsplit((parsed.scheme, parsed.netloc, "", "", ""))
+    base = runtime["base_url"].rstrip("/")
+    opener = build_opener(ProxyHandler({}), _NoRedirect())
+    headers = {"Accept": "application/json"}
+    if isinstance(api_key, str) and api_key:
+        headers["Authorization"] = "Bearer " + api_key
+    deadline = time.monotonic() + 3.0
+    observations = ((root + "/api/v1/models", "lmstudio"),
+                    (root + "/api/v0/models", "lmstudio-v0"),
+                    (root + "/api/ps", "ollama"),
+                    (base + "/models", "served"))
+    for url, kind in observations:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            break
+        try:
+            with opener.open(Request(url, headers=headers), timeout=min(0.75, remaining)) as response:
+                parts, size = [], 0
+                while size <= 262144:
+                    if time.monotonic() >= deadline:
+                        return None
+                    # read1 performs at most one socket read, so a trickling
+                    # response cannot hold one read-until-size call forever.
+                    part = response.read1(min(16384, 262145 - size))
+                    if not part:
+                        break
+                    parts.append(part)
+                    size += len(part)
+                raw = b"".join(parts)
+                if time.monotonic() >= deadline:
+                    return None
+                if len(raw) > 262144:
+                    continue
+                capacity = capacity_from_payload(json.loads(raw), model, kind)
+                if capacity is not None:
+                    return capacity
+        except Exception:
+            continue
+    return None
