+    try:
+        db.create_session("expression-parent", source="telegram")
+        db.publish_compression_child(parent_session_id="expression-parent",
+            child_session_id="expression-child", source="telegram", model="fixture",
+            model_config=row["model_config"], system_prompt=row["system_prompt"],
+            require_compression_lease=False,
+            messages=[{"role": "user", "content": "Retained history.", "timestamp": 1700000000.0}])
+        current = agent_with(value("new manual save", 2))
+        current.session_id = "expression-parent"
+        current.context_compressor = Mock()
+        expression.capture_turn_expression(current)
+        recovered = _adopt_live_compression_child(current, db, "expression-parent")
+        assert recovered and recovered[0]["content"] == "Retained history."
+        assert current.session_id == "expression-child"
+        assert current._cached_system_prompt is None
+        assert current._expression_turn_snapshot.revision == 2
+        assert not hasattr(current, "_identity_legacy_history_v1")
+        assert scoped_identity_session_snapshot_matches(current, db.get_session("expression-child"))
+    finally:
+        db.close()
