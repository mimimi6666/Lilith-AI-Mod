+@pytest.mark.parametrize("in_place", [False, True])
+def test_real_compression_preserves_frozen_revision_and_durable_binding(tmp_path, monkeypatch, in_place):
+    from hermes_state import SessionDB
+    from tests.agent.test_compression_rotation_state import _build_agent_with_db, _msgs
+    # Construct the ordinary native harness before binding its synthetic strict
+    # identity; no external provider/model is contacted by this compression fake.
+    monkeypatch.delenv("HERMES_IDENTITY_REQUIRED")
+    db = SessionDB(db_path=tmp_path / "expression-compression.db")
+    try:
+        db.create_session("expression-parent", source="telegram")
+        agent = _build_agent_with_db(db, "expression-parent")
+        monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+        strict = _strict_agent()
+        for name, item in vars(strict).items():
+            setattr(agent, name, item)
+        agent._memory_manager = SimpleNamespace(providers=[SimpleNamespace(expression_context_snapshot=Mock(return_value=value("frozen", 9)))])
+        expression.capture_turn_expression(agent)
+        prompt = prompt_for(agent)
+        agent._cached_system_prompt = prompt
+        expression.mark_expression_prompt(agent, prompt)
+        agent._build_system_prompt = Mock(return_value=prompt)
+        db.update_system_prompt(agent.session_id, prompt, model_config_patch=row_for(agent)["model_config"])
+        agent.compression_in_place = in_place
+        for index, message in enumerate(agent.context_compressor.compress.return_value):
+            message["timestamp"] = 1700000000.0 + index
+        hook = agent._memory_manager.providers[0].expression_context_snapshot
+        hook.return_value = value("saved during turn", 10)
+        messages = _msgs()
+        for index, message in enumerate(messages):
+            message["timestamp"] = 1700000010.0 + index
+        _, resulting_prompt = agent._compress_context(messages, prompt, approx_tokens=120_000)
+        assert resulting_prompt == prompt
+        row = db.get_session(agent.session_id)
+        assert expression.stored_expression_matches(agent, row)
+        assert scoped_identity_session_snapshot_matches(agent, row)
+        assert not hasattr(agent, "_identity_legacy_history_v1")
+        hook.assert_called_once()
+        assert (agent.session_id == "expression-parent") == in_place
+    finally:
+        db.close()
+
