index 0000000..e3e8f10
--- /dev/null
+++ b/tests/agent/test_expression_context.py
@@ -0,0 +1,355 @@
+"""Manual expression admission: no model, player data, or management writes."""
+import copy
+from dataclasses import FrozenInstanceError
+import hashlib
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import pytest
+
+from agent import expression_context as expression
+from agent.identity_policy import (
+    enforce_scoped_child_identity, scoped_identity_metadata,
+    scoped_identity_session_snapshot_matches,
+)
+from tests.agent.test_identity_policy import _strict_agent, _attest, SOUL, PERSONALITY
+
+
+@pytest.fixture(autouse=True)
+def trusted_host(monkeypatch):
+    monkeypatch.setenv("HERMES_IDENTITY_REQUIRED", "1")
+
+
+def value(content="A gentle question.", revision=1):
+    return {"schema_version": 1, "revision": revision, "content": content,
+            "content_sha256": hashlib.sha256(content.encode("utf-8")).hexdigest(),
+            "base_identity_fingerprint": "A" * 64}
+
+
+def agent_with(payload=None):
+    agent = _strict_agent()
+    agent._memory_manager = SimpleNamespace(providers=[])
+    if payload is not None:
+        agent._memory_manager.providers.append(SimpleNamespace(expression_context_snapshot=Mock(return_value=payload)))
+    return agent
+
+
+def prompt_for(agent):
+    prefix = SOUL.strip() + "\n\n" + PERSONALITY.strip()
+    block = expression.frozen_expression_block(agent)
+    return prefix + ("\n\n" + block if block else "") + "\n\nTOOLS"
+
+
+def row_for(agent):
+    prompt = prompt_for(agent)
+    return {"system_prompt": prompt, "model_config": {
+        **scoped_identity_metadata(agent),
+        **expression.expression_persistence_metadata(agent, prompt),
+    }}
+
+
+@pytest.mark.parametrize("mutate", [
+    lambda v: v.update(schema_version=True), lambda v: v.update(schema_version=2),
+    lambda v: v.update(revision=True), lambda v: v.update(revision=-1),
+    lambda v: v.update(revision=257), lambda v: v.update(revision=0),
+    lambda v: v.update(content_sha256="0" * 64),
+    lambda v: v.update(content_sha256=v["content_sha256"].upper()),
+    lambda v: v.update(base_identity_fingerprint="a" * 64),
+    lambda v: v.update(base_identity_fingerprint="B" * 64),
+    lambda v: v.update(unexpected="field"), lambda v: v.pop("content"),
+    lambda v: v.update(content=None),
+])
+def test_hostile_snapshot_is_never_adopted(mutate, caplog):
+    payload = value("PRIVATE TEST TEXT")
+    mutate(payload)
+    agent = agent_with(payload)
+    expression.capture_turn_expression(agent)
+    assert agent._expression_turn_snapshot is None
+    assert agent._expression_diagnostic == "unavailable_empty"
+    assert "PRIVATE TEST TEXT" not in caplog.text
+
+
+@pytest.mark.parametrize("content", ["x\x00", "x\x1b", "x\u202e", "x\ufeff", "x\ud800", "界" * 10923], ids=["nul", "escape", "bidi", "bom", "surrogate", "oversize"])
+def test_utf8_controls_and_byte_boundaries(content):
+    payload = value()
+    payload["content"] = content
+    payload["content_sha256"] = hashlib.sha256(content.encode("utf-8", errors="surrogatepass")).hexdigest()
+    with pytest.raises((ValueError, UnicodeError)):
+        expression.validate_snapshot(payload, "A" * 64)
+
+
+def test_exact_whitespace_and_max_bytes_are_retained():
+    content = "\t\r\n" + "x" * (32768 - 3)
+    snapshot = expression.validate_snapshot(value(content), "A" * 64)
+    assert snapshot.content == content
+    with pytest.raises(FrozenInstanceError):
+        snapshot.content = "changed"
+
+
+def test_no_hook_and_virtual_empty_leave_prompt_bytes_unchanged():
+    agent = agent_with()
+    agent._cached_system_prompt = prompt_for(agent)
+    original = agent._cached_system_prompt
+    expression.capture_turn_expression(agent)
+    assert agent._cached_system_prompt == original
+    assert expression.expression_persistence_metadata(agent) == {}
+    empty = agent_with(value("", 0))
+    expression.capture_turn_expression(empty)
+    assert prompt_for(empty) == original
+
+
+def test_once_per_turn_frozen_for_builds_and_next_turn_invalidates_only_expression():
+    agent = agent_with(value())
+    core = copy.deepcopy(agent._session_init_model_config)
+    hook = agent._memory_manager.providers[0].expression_context_snapshot
+    expression.capture_turn_expression(agent)
+    first = prompt_for(agent)
+    expression.mark_expression_prompt(agent, first)
+    agent._cached_system_prompt = first
+    hook.return_value = value("A new expression.", 2)
+    for _ in range(4):
+        assert prompt_for(agent) == first
+    hook.assert_called_once()
+    expression.capture_turn_expression(agent)
+    assert agent._cached_system_prompt is None
+    assert prompt_for(agent) != first
+    assert scoped_identity_metadata(agent) == core
+    assert not hasattr(agent, "_identity_legacy_history_v1")
+
+
+def test_same_revision_keeps_cache_and_failure_keeps_last_verified(caplog):
+    agent = agent_with(value())
+    expression.capture_turn_expression(agent)
+    prompt = prompt_for(agent)
+    expression.mark_expression_prompt(agent, prompt)
+    agent._cached_system_prompt = prompt
+    expression.capture_turn_expression(agent)
+    assert agent._cached_system_prompt == prompt
+    agent._memory_manager.providers[0].expression_context_snapshot.side_effect = RuntimeError("PRIVATE PATH AND PROMPT")
+    expression.capture_turn_expression(agent)
+    assert agent._cached_system_prompt == prompt
+    assert agent._expression_diagnostic == "unavailable_last_verified"
+    assert "PRIVATE PATH AND PROMPT" not in caplog.text
+
+
+@pytest.mark.parametrize("payload", [value("older", 1), value("conflict", 2)])
