+def legacy_turn_message_id(message: Any) -> str:
+    """Project one old turn-only DB row to a stable message identity.
+
+    Builds before durable message identities persisted a canonical turn id but
+    no per-message id.  A positive SQLite row id is the only stable row-local
+    discriminator available for those records.  UUIDv5 keeps the projection
+    reproducible without mutating history or guessing from text/adjacency.
+
+    Rows that declare any newer message identity or message-kind field are not
+    legacy turn-only rows.  Malformed new correlation therefore remains
+    visible to the strict Runtime boundary instead of being repaired here.
+    """
+
+    if not isinstance(message, dict):
+        return ""
+    metadata = message.get("display_metadata")
+    if not isinstance(metadata, dict):
+        return ""
+    turn_id = canonical_id(metadata.get(TURN_ID_METADATA_KEY))
+    if not turn_id or any(
+        key in metadata
+        for key in (
+            MESSAGE_ID_METADATA_KEY,
+            USER_MESSAGE_ID_METADATA_KEY,
+            MESSAGE_KIND_METADATA_KEY,
+        )
+    ):
+        return ""
+    row_id = message.get("_row_id")
+    if isinstance(row_id, bool) or not isinstance(row_id, int) or row_id <= 0:
+        return ""
+    role = message.get("role")
+    if role not in {"user", "assistant", "tool", "system"}:
+        return ""
+
+    material = f"{turn_id}:{row_id}:{role}"
+    candidate = uuid.uuid5(_LEGACY_TURN_MESSAGE_NAMESPACE, material).hex
+    # A UUIDv5 collision with the independently generated turn UUID is
+    # cryptographically negligible, but distinct identities are a protocol
+    # invariant rather than a probability claim.  Keep the fallback stable.
+    if candidate == turn_id:
+        candidate = uuid.uuid5(
+            _LEGACY_TURN_MESSAGE_NAMESPACE,
+            material + ":distinct",
+        ).hex
+    return candidate if candidate != turn_id else ""
+
+
