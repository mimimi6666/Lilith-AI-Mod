+def test_legacy_turn_only_row_gets_one_reproducible_message_identity():
+    row = {
+        "role": "user",
+        "content": "persisted before message ids",
+        "_row_id": 17,
+        "display_metadata": {"hermes_turn_id": TURN_1},
+    }
+
+    expected = "5db984635d9553e7a4efd417fa764e77"
+    assert legacy_turn_message_id(row) == expected
+    assert legacy_turn_message_id(dict(row)) == expected
+    assert canonical_id(expected) == expected
+    assert expected != TURN_1
+
+    first = server._history_to_messages([row])[0]
+    second = server._history_to_messages([dict(row)])[0]
+    assert first["turn_id"] == TURN_1
+    assert first["message_id"] == expected
+    assert first["row_id"] == 17
+    assert second["message_id"] == expected
+
+    different_row = dict(row, _row_id=18)
+    different_role = dict(row, role="assistant")
+    assert legacy_turn_message_id(different_row) != expected
+    assert legacy_turn_message_id(different_role) != expected
+
