+def test_persisted_legacy_turn_only_row_keeps_identity_after_db_reopen(tmp_path):
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    db.create_session("session", "tui")
+    try:
+        row_id = db.append_message(
+            "session",
+            "user",
+            "legacy turn",
+            display_metadata={"hermes_turn_id": TURN_1},
+        )
+        first_history = db.get_messages_as_conversation(
+            "session",
+            include_row_ids=True,
+        )
+    finally:
+        db.close()
+
+    reopened = SessionDB(db_path=db_path)
+    try:
+        second_history = reopened.get_messages_as_conversation(
+            "session",
+            include_row_ids=True,
+        )
+    finally:
+        reopened.close()
+
+    first = server._history_to_messages(first_history)[0]
+    second = server._history_to_messages(second_history)[0]
+    assert first["row_id"] == row_id
+    assert first["turn_id"] == TURN_1
+    assert canonical_id(first["message_id"]) == first["message_id"]
+    assert first["message_id"] != TURN_1
+    assert second["message_id"] == first["message_id"]
+
