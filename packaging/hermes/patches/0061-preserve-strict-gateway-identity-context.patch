+    def test_strict_identity_preserves_locked_prompt_bytes_and_relocates_context(self):
+        from gateway.run import _compose_gateway_ephemeral_prompt
+
+        locked = "LOCKED LILITH PERSONALITY\n"
+        prompt, sidecar_parts = _compose_gateway_ephemeral_prompt(
+            context_prompt="## Current Session Context\nSource: Telegram",
+            event_channel_prompt="Keep replies concise.",
+            configured_channel_prompt=locked,
+            locked_profile_prompt=locked,
+            strict_identity=True,
+        )
+
+        assert prompt == locked
+        assert prompt.endswith("\n")
+        assert sidecar_parts == (
+            "## Current Session Context\nSource: Telegram",
+            "Keep replies concise.",
+        )
+
+    def test_generic_identity_retains_historical_prompt_composition(self):
+        from gateway.run import _compose_gateway_ephemeral_prompt
+
+        prompt, sidecar_parts = _compose_gateway_ephemeral_prompt(
+            context_prompt="session context",
+            event_channel_prompt="legacy channel prompt",
+            configured_channel_prompt="global prompt",
+            locked_profile_prompt="ignored",
+            strict_identity=False,
+        )
+
+        assert prompt == (
+            "session context\n\nlegacy channel prompt\n\nglobal prompt"
+        )
+        assert sidecar_parts == ()
+
