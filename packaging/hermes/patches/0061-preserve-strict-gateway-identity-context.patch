+def _compose_gateway_ephemeral_prompt(
+    *,
+    context_prompt: str,
+    event_channel_prompt: str,
+    configured_channel_prompt: str,
+    locked_profile_prompt: str,
+    strict_identity: bool,
+) -> tuple[str, tuple[str, ...]]:
+    """Resolve gateway prompt authority without composing over a strict identity.
+
+    Generic Hermes profiles retain the historical ephemeral-system composition.
+    A host-attested profile may pass only the exact locked personality bytes to
+    ``AIAgent``; mutable session/channel context is returned separately so the
+    caller can deliver it through the existing current-user ``api_content``
+    sidecar instead of creating a second system authority.
+    """
+
+    event_prompt = str(event_channel_prompt or "").strip()
+    configured_prompt = str(configured_channel_prompt or "")
+    if strict_identity:
+        context_parts = []
+        if str(context_prompt or "").strip():
+            context_parts.append(str(context_prompt))
+        if event_prompt:
+            context_parts.append(event_prompt)
+        # The global profile prompt is the already-attested identity and must
+        # not be duplicated as subordinate context.  A real channel override
+        # remains usable, but only as lower-authority turn context.
+        if configured_prompt and configured_prompt != str(locked_profile_prompt or ""):
+            context_parts.append(configured_prompt.strip())
+        return str(locked_profile_prompt or ""), tuple(
+            part for part in context_parts if part
+        )
+
+    combined = str(context_prompt or "")
+    if event_prompt:
+        combined = (combined + "\n\n" + event_prompt).strip()
+    if configured_prompt:
+        combined = (combined + "\n\n" + configured_prompt).strip()
+    return combined, ()
+
+
 def _public_actor_name(default: str = "Hermes") -> str:
     identity = strict_public_identity_by_host()
     return identity.ascii_name if identity is not None else default
