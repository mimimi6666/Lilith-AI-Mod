diff --git a/tests/tools/test_coordinate_contract.py b/tests/tools/test_coordinate_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_coordinate_contract.py
@@ -0,0 +1,215 @@
+"""Synthetic geometry only: no installed apps, real capture or OS input."""
+import base64
+import io
+import json
+from unittest.mock import patch
+
+import pytest
+from tools.computer_use.backend import CaptureResult, UIElement
+from tools.computer_use.cua_backend import CuaDriverBackend, _CuaDriverSession
+from tools.computer_use import tool as cu
+from tools.computer_use.schema import COMPUTER_USE_SCHEMA
+
+
+def pixel(width=800, height=600):
+    return base64.b64encode(b"\x89PNG\r\n\x1a\n" + b"\0" * 8
+                           + width.to_bytes(4, "big") + height.to_bytes(4, "big")).decode()
+
+
+def backend(width=800, height=600, scroll=True, origin=(-1920, 400), dpi=1.0):
+    session = _CuaDriverSession.__new__(_CuaDriverSession)
+    names = ("get_window_state", "click", "double_click", "drag", "scroll", "hotkey")
+    session._capabilities = {name: set() for name in names}
+    session._tool_schemas = {name: {"properties": {"delivery_mode": {}}} for name in names}
+    if scroll:
+        session._tool_schemas["scroll"]["properties"].update(x={}, y={})
+    calls = []
+    def driver(name, args):
+        calls.append((name, dict(args)))
+        sc = ({"snapshot_id": "fresh", "screenshot_png_b64": pixel(width, height),
+               "elements": [{"element_index": 7, "element_token": "fresh:7", "role": "button",
+                             "frame": {"x": origin[0] + int(80 * dpi),
+                                       "y": origin[1] + int(180 * dpi),
+                                       "w": int(30 * dpi), "h": int(20 * dpi)}}]}
+              if name == "get_window_state" else {"status": "accepted"})
+        return {"isError": False, "data": "ok", "images": [], "structuredContent": sc}
+    session.call_tool = driver
+    instance = CuaDriverBackend.__new__(CuaDriverBackend)
+    instance._session, instance._session_id = session, "synthetic"
+    instance._last_app = None
+    instance.capture(mode="som", app="Fixture", pid=12, window_id=34)
+    calls.clear()
+    return instance, calls
+
+
+@pytest.mark.parametrize("size", [(800, 600), (1366, 768), (1920, 1080), (1455, 791),
+                                 (2560, 1440), (3440, 1440), (3840, 2160),
+                                 (5120, 1440), (1080, 1920)])
+@pytest.mark.parametrize("dpi", [1.0, 1.25, 1.5, 2.0])
+@pytest.mark.parametrize("origin", [(0, 0), (346, 80), (-3840, 0), (6000, -2160)])
+def test_click_passes_screenshot_pixels_once_without_offset_or_dpi(size, dpi, origin):
+    # Model the contract boundary, not a real display driver. DPI and desktop
+    # origin alter AX geometry; neither may alter the supplied PNG-local point.
+    instance, calls = backend(*size, dpi=dpi, origin=origin)
+    for point in ((0, 0), (215, 132), (size[0] - 1, size[1] - 1)):
+        calls.clear()
+        assert instance.click(x=point[0], y=point[1]).ok
+        assert len(calls) == 1
+        assert (calls[0][1]["x"], calls[0][1]["y"]) == point
+        assert (calls[0][1]["pid"], calls[0][1]["window_id"]) == (12, 34)
+
+
+@pytest.mark.parametrize("kind", ["click", "double_click", "right_click", "drag", "scroll"])
+@pytest.mark.parametrize("point", [(-1, 20), (800, 20), (20, 600), (20, -1),
+                                    (True, 20), (20.5, 20), ("20", 20), (None, 20)])
+def test_invalid_points_never_dispatch_or_retry(kind, point):
+    instance, calls = backend()
+    if kind == "drag":
+        result = instance.drag(from_xy=(1, 1), to_xy=point)
+    elif kind == "scroll":
+        result = instance.scroll(direction="down", x=point[0], y=point[1])
+    else:
+        result = instance.click(x=point[0], y=point[1],
+                                button="right" if kind == "right_click" else "left",
+                                click_count=2 if kind == "double_click" else 1)
+    assert not result.ok and not calls
+
+
+@pytest.mark.parametrize("kind", ["click", "drag", "scroll"])
+def test_missing_or_other_target_capture_cannot_authorize_pixel_actions(kind):
+    instance, calls = backend()
+    for frame in (None, (99, 34, 800, 600), (12, 99, 800, 600)):
+        instance._coordinate_capture = frame
+        if kind == "click": result = instance.click(x=20, y=30)
+        elif kind == "drag": result = instance.drag(from_xy=(1, 2), to_xy=(3, 4))
+        else: result = instance.scroll(direction="down", x=20, y=30)
+        assert result.code == "fresh_coordinate_capture_required" and not calls
+
+
+def test_drag_and_scroll_keep_axis_values_without_silent_whole_window_fallback():
+    instance, calls = backend()
+    assert instance.drag(from_xy=(12, 23), to_xy=(799, 599)).ok
+    assert {k: calls[-1][1][k] for k in ("from_x", "from_y", "to_x", "to_y")} == {
+        "from_x": 12, "from_y": 23, "to_x": 799, "to_y": 599}
+    assert instance.scroll(direction="down", x=77, y=88).ok
+    assert (calls[-1][1]["x"], calls[-1][1]["y"]) == (77, 88)
+    instance, calls = backend(scroll=False)
+    assert instance.scroll(direction="down", x=77, y=88).code == "coordinate_scroll_unsupported"
+    assert not calls
+    assert instance.scroll(direction="down").ok  # explicit window-wide intent remains available
+
+
+def test_focus_failure_recapture_and_resize_disarm_old_pixel_geometry():
+    instance, calls = backend()
+    instance._load_windows = lambda: [{"pid": 56, "window_id": 78, "app_name": "Other"}]
+    instance._match_windows_for_app = lambda windows, app: windows
+    instance.focus_app("Other")
+    assert instance.click(x=20, y=20).code == "fresh_coordinate_capture_required"
+    assert not calls
+    instance._failed_capture("som")
+    assert instance._coordinate_capture is None
+    instance.capture(mode="vision", app="Fixture", pid=12, window_id=34)
+    assert instance._coordinate_capture == (12, 34, 800, 600)
+    calls.clear()
+    instance._session.call_tool = lambda *args: (_ for _ in ()).throw(RuntimeError("synthetic failure"))
+    with pytest.raises(RuntimeError): instance.capture(mode="som", pid=12, window_id=34)
+    assert instance._coordinate_capture is None
+
+
+def test_element_tokens_do_not_need_pixel_conversion():
+    instance, calls = backend()
+    instance._coordinate_capture = None
+    instance._session._tool_schemas["click"]["properties"]["element_token"] = {}
+    assert instance.click(element=7).ok
+    assert calls[0][1]["element_token"] == "fresh:7"
+    assert "x" not in calls[0][1] and "y" not in calls[0][1]
+
+
+def test_new_capture_replaces_dimensions_instead_of_reusing_previous_monitor():
+    instance, calls = backend(3840, 2160)
+    previous = instance._session.call_tool
+    def smaller(name, args):
+        result = previous(name, args)
+        if name == "get_window_state":
+            result["structuredContent"]["screenshot_png_b64"] = pixel(800, 600)
+        return result
+    instance._session.call_tool = smaller
+    instance.capture(mode="som", pid=12, window_id=34)
+    calls.clear()
+    assert instance.click(x=3000, y=1800).code == "invalid_screenshot_coordinate"
+    assert not calls
+    assert instance.click(x=799, y=599).ok
+    assert (calls[-1][1]["x"], calls[-1][1]["y"]) == (799, 599)
+
+
+@pytest.mark.parametrize("size", [(1920, 1080), (3440, 1440), (3840, 2160), (1080, 1920)])
+def test_aux_success_and_spill_keep_original_png_dimensions(size, tmp_path):
+    from PIL import Image
+    raw = io.BytesIO()
+    Image.new("RGB", size).save(raw, format="PNG")
+    cap = CaptureResult("som", 99, 99, png_b64=base64.b64encode(raw.getvalue()).decode(),
+                        elements=[UIElement(7, "button", "x" * 800,
+                                            bounds=(-2600, 1800, 80, 40))])
+    seen = {}
+    def fake_vision(path, prompt):
+        with Image.open(path) as image:
+            seen["size"] = image.size
+        seen["prompt"] = prompt
+        return json.dumps({"success": True, "analysis": "Synthetic description"})
+    with patch.object(cu, "_should_route_through_aux_vision", return_value=True), \
+         patch("hermes_constants.get_hermes_dir", return_value=tmp_path), \
+         patch("model_tools._run_async", side_effect=lambda value: value), \
+         patch("tools.vision_tools.vision_analyze_tool", new=fake_vision):
+        payload = json.loads(cu._capture_response(cap))
+    assert payload["vision_analysis"] == "Synthetic description"
+    assert (payload["coordinate_width"], payload["coordinate_height"]) == size
+    assert (payload["width"], payload["height"]) == size
+    assert max(seen["size"]) <= 1456
+    assert f"x_seen * {size[0]}/{seen['size'][0]}" in seen["prompt"]
+    assert f"y_seen * {size[1]}/{seen['size'][1]}" in seen["prompt"]
+    assert "exactly once" in seen["prompt"]
+    from pathlib import Path
+    spilled = json.loads(Path(payload["elements_file"]).read_text())
+    assert (spilled["coordinate_width"], spilled["coordinate_height"]) == size
+    assert not list(tmp_path.glob("computer_use_*.png"))
+
+
+@pytest.mark.parametrize("origin", [(0, 0), (346, 80), (-1920, 400), (6000, -1400)])
+def test_translation_is_not_scale_and_all_text_outputs_label_spaces(origin, tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    elements = [UIElement(index=7, role="button", label="x" * 800,
+                         bounds=(*origin, 45, 25))]
+    cap = CaptureResult("som", 800, 600, elements=elements)
+    payload = json.loads(cu._capture_response(cap))
+    assert payload["coordinate_space"] == "window_screenshot"
+    assert payload["element_bounds_space"] == "screen_absolute"
+    assert payload["elements"][0]["bounds_space"] == "screen_absolute"
+    assert "bounds_scale" not in payload and cu._bounds_scale(elements, 800, 600) is None
+    assert "Pass screenshot pixels unchanged" in payload["summary"]
+    from pathlib import Path
+    spilled = json.loads(Path(payload["elements_file"]).read_text())
+    assert spilled["coordinate_space"] == "window_screenshot"
+    assert spilled["elements"][0]["bounds_space"] == "screen_absolute"
+
+
+def test_multimodal_and_aux_failure_disclose_identical_coordinate_contract():
+    cap = CaptureResult("som", 800, 600, png_b64=pixel(),
+                        elements=[UIElement(7, "button", bounds=(3000, -400, 50, 30))])
+    with patch.object(cu, "_should_route_through_aux_vision", return_value=False):
+        payload = cu._capture_response(cap)
+    assert payload["meta"]["coordinate_space"] == "window_screenshot"
+    assert "Do not copy a bounds center" in payload["text_summary"]
+    with patch.object(cu, "_should_route_through_aux_vision", return_value=True), \
+         patch.object(cu, "_route_capture_through_aux_vision", return_value=None):
+        failed = json.loads(cu._capture_response(cap))
+    assert failed["vision_unavailable"] and failed["coordinate_space"] == "window_screenshot"
+    assert "bounds_scale" not in failed
+
+
+def test_schema_requires_window_png_not_accessibility_bounds():
+    properties = COMPUTER_USE_SCHEMA["parameters"]["properties"]
+    assert "screenshot" in properties["coordinate"]["description"]
+    assert "screen-absolute" in properties["coordinate"]["description"]
+    for key in ("from_coordinate", "to_coordinate"):
+        assert "screenshot" in properties[key]["description"]
+    assert "separate viewport" in properties["coordinate"]["description"]
