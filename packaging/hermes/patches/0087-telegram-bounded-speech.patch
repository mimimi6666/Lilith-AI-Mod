@@ -0,0 +1,320 @@
+"""Bounded synthetic scripts/PCM only; no real synthesis, messages or accounts."""
+import io
+import json
+from pathlib import Path
+import struct
+import threading
+from types import SimpleNamespace
+import wave
+
+import pytest
+
+from agent import lilith_telegram_tts as voice
+from tools import tts_text_normalize as normalize
+
+
+def pcm(value=1, *, rate=16000, width=2, channels=1, count=1600):
+    output = io.BytesIO()
+    with wave.open(output, "wb") as wav:
+        wav.setparams((channels, width, rate, 0, "NONE", "not compressed"))
+        wav.writeframes(value.to_bytes(width, "little") * channels * count)
+    return output.getvalue()
+
+
+@pytest.fixture
+def profile(tmp_path, monkeypatch):
+    reference = tmp_path / "reference.wav"
+    reference.write_bytes(pcm())
+    profile = dict(version=1, locale="ja", endpoint="http://127.0.0.1:9881/tts",
+                   reference_path=str(reference), aux_reference_paths=[], prompt_text="これは試験です。",
+                   config_fingerprint="A" * 64)
+    monkeypatch.setattr(voice, "read_snapshot", lambda: dict(profile))
+    return profile
+
+
+def http(monkeypatch, *, effect=None, payload=None):
+    requests, connections = [], []
+    class Connection:
+        sock = None
+        def __init__(self, host, port, timeout):
+            self.index, self.timeout, self.closed = len(connections), timeout, False
+            connections.append(self)
+        def request(self, method, target, body, headers):
+            assert method == "POST" and target == "/tts"
+            requests.append(json.loads(body))
+            if effect:
+                effect(self.index)
+        def getresponse(self):
+            data = payload(self.index) if payload else pcm(self.index + 1)
+            stream = io.BytesIO(data)
+            return SimpleNamespace(status=200, getheader=lambda _: str(len(data)), read1=stream.read)
+        def close(self):
+            self.closed = True
+    monkeypatch.setattr(voice.http.client, "HTTPConnection", Connection)
+    return requests, connections
+
+
+def script():
+    return " ".join(f"これは第{index}段の試験です。音声の順番と内容が保たれることを確認します。" for index in range(1, 9)) + " 最後まで届いたよ。"
+
+
+def test_provider_splits_long_script_and_keeps_tail(profile, tmp_path, monkeypatch):
+    requests, connections = http(monkeypatch)
+    text = script()
+    path = voice.LilithGptSovitsProvider().synthesize(text, str(tmp_path / "out.ogg"))
+    assert len(requests) > 1
+    assert all(0 < len(row["text"]) <= 120 for row in requests)
+    assert "".join(row["text"] for row in requests) == text
+    assert requests[-1]["text"].endswith("最後まで届いたよ。")
+    assert sum(row["text"].count("第3段") for row in requests) == 1
+    assert all(row["text_lang"] == row["prompt_lang"] == "ja" for row in requests)
+    assert all(row["ref_audio_path"] == profile["reference_path"] for row in requests)
+    assert all(row["text_split_method"] == "cut0" for row in requests)
+    assert all(row.closed and 0 < row.timeout <= 120 for row in connections)
+    with wave.open(path, "rb") as wav:
+        frames = wav.readframes(wav.getnframes())
+        expected = b"\x00\x00" * 1920
+        expected = expected.join((index + 1).to_bytes(2, "little") * 1600 for index in range(len(requests)))
+        assert frames == expected
+    assert list(tmp_path.glob("out*")) == [Path(path)]
+    assert not list(tmp_path.glob(".lilith-voice-*"))
+
+
+@pytest.mark.parametrize("raw,expected", [
+    ("受け取ったよ。\n\n私も愛してる。", "受け取ったよ。 私も愛してる。"),
+    ("你好。\n\n我也愛你。", "你好。 我也愛你。"),
+    ("好了！\n可以嗎？", "好了！ 可以嗎？"),
+    ("收到。．\n聽到了。.", "收到。 聽到了。"),
+    ("今日は18°Cです。\n降水確率は1%です。", "今日は18°Cです。 降水確率は1%です。"),
+    ("**測試**\n- 下一句\n最後一句", "測試。 下一句。 最後一句。"),
+    ("「おやすみ。」\n『また明日！』", "「おやすみ。」 『また明日！』"),
+    ("第一段——這裡停頓——繼續。", "第一段、這裡停頓、繼續。"),
+    ("數值3.14。\n省略...", "數值3.14。 省略..."),
+])
+def test_cjk_normalization_preserves_language(raw, expected):
+    assert normalize.prepare_spoken_text(raw, max_chars=None, cjk=True) == expected
+
+
+def test_default_normalizer_keeps_existing_english_behavior():
+    assert normalize.prepare_spoken_text("Hello\nWorld") == "Hello. World."
+    assert "degrees Celsius" in normalize.prepare_spoken_text("18°C")
+
+
+@pytest.mark.parametrize("text", [
+    script(), "あ" * 300, "はい。" * 90, "他說：「測試，還有下一句。」" * 30,
+    ("Cafe\u0301 3.14% 18°C. 次の文です。 " * 20),
+    ("は\u3099" * 170), "你好！怎麼了？我在這裡。" * 30,
+    "這是長句，先看第一部分，再接第二部分，最後應該完整結束。" * 20,
+    "測試" * 51 + " A_B/C-D:3.14% " + "繼續" * 130,
+    " ".join(f"token{index}" for index in range(250)),
+])
+def test_segmenter_exact_coverage_and_unicode(text):
+    from agent.lilith_speech_segments import split_speech_text, MAX_SEGMENT_CHARS
+    segments = split_speech_text(text)
+    assert "".join(segments) == text
+    assert all(0 < len(part) <= MAX_SEGMENT_CHARS and any(c.isalnum() for c in part) for part in segments)
+    assert all(not part.startswith(("\u0301", "\u3099", "\ufe0f", "\u200d")) for part in segments)
+    if "3.14%" in text:
+        assert sum(part.count("3.14%") for part in segments) == text.count("3.14%")
+
+
+def test_segmenter_prefers_sentence_boundaries_and_retains_quotes():
+    from agent.lilith_speech_segments import split_speech_text
+    text = "最初の説明です。" * 9 + "「最後の説明です。」" * 9
+    parts = split_speech_text(text)
+    assert all(part.endswith(("。", "」")) for part in parts)
+    assert all(not part.startswith("」") for part in parts)
+
+
+@pytest.mark.parametrize("text", ["", "   ", "。！？", "測試" * 2501, "A" * 121, "あ" + "\u3099" * 130, "bad\ud800text"])
+def test_invalid_plan_has_zero_requests(profile, tmp_path, monkeypatch, text):
+    requests, _ = http(monkeypatch)
+    with pytest.raises(ValueError):
+        voice.LilithGptSovitsProvider().synthesize(text, str(tmp_path / "out.ogg"))
+    assert requests == []
+    assert not list(tmp_path.glob("out*"))
+
+
+@pytest.mark.parametrize("reason", ["cancel", "off", "locale", "timeout", "http"])
+def test_midway_failure_never_creates_partial_output(profile, tmp_path, monkeypatch, reason):
+    current, allowed, timer = dict(profile), [True], [0.0]
+    cancellation = threading.Event()
+    monkeypatch.setattr(voice, "read_snapshot", lambda: dict(current))
+    monkeypatch.setattr(voice.time, "monotonic", lambda: timer[0])
+    token = voice._CANCELLED.set(cancellation)
+    def effect(index):
+        if index != 1:
+            return
+        if reason == "cancel": cancellation.set()
+        elif reason == "off": allowed[0] = False
+        elif reason == "locale": current["locale"] = "zh"
+        elif reason == "timeout": timer[0] = 121
+        else: raise TimeoutError()
+    requests, connections = http(monkeypatch, effect=effect)
+    try:
+        with voice.voice_scope(profile=profile, allowed=lambda: allowed[0]):
+            with pytest.raises(ValueError):
+                voice.LilithGptSovitsProvider().synthesize(script(), str(tmp_path / "out.ogg"))
+    finally:
+        voice._CANCELLED.reset(token)
+    assert len(requests) == 2 and all(row.closed for row in connections)
+    assert not list(tmp_path.glob("out*"))
+    assert not list(tmp_path.glob(".lilith-voice-*"))
+
+
+def test_deadline_is_shared_between_segments(profile, tmp_path, monkeypatch):
+    timer = [0.0]
+    monkeypatch.setattr(voice.time, "monotonic", lambda: timer[0])
+    def effect(index): timer[0] += 30
+    requests, connections = http(monkeypatch, effect=effect)
+    with pytest.raises(ValueError, match="deadline"):
+        voice.LilithGptSovitsProvider().synthesize(script(), str(tmp_path / "out.ogg"))
+    assert [row.timeout for row in connections] == [120, 90, 60, 30]
+    assert not (tmp_path / "out.wav").exists()
+
+
+@pytest.mark.parametrize("fault", ["format", "corrupt", "truncated"])
+def test_bad_later_wav_discards_earlier_segments(profile, tmp_path, monkeypatch, fault):
+    def payload(index):
+        if index == 0: return pcm()
+        return {"format": pcm(rate=22050), "corrupt": b"bad", "truncated": pcm()[:-3]}[fault]
+    requests, connections = http(monkeypatch, payload=payload)
+    with pytest.raises(ValueError):
+        voice.LilithGptSovitsProvider().synthesize(script(), str(tmp_path / "out.ogg"))
+    assert len(requests) == 2 and all(row.closed for row in connections)
+    assert not (tmp_path / "out.wav").exists()
+
+
+@pytest.mark.parametrize("width,channels", [(1, 1), (1, 2), (2, 1), (2, 2), (3, 1), (4, 2)])
+def test_pcm_joins_all_frames_and_correct_silence(width, channels):
+    assembly = voice._PcmAssembly()
+    assembly.add(pcm(1, width=width, channels=channels))
+    assembly.add(pcm(2, width=width, channels=channels))
+    with wave.open(io.BytesIO(assembly.finish()), "rb") as wav:
+        expected = (1).to_bytes(width, "little") * channels * 1600
+        expected += (b"\x80" if width == 1 else b"\0" * width) * channels * 1920
+        expected += (2).to_bytes(width, "little") * channels * 1600
+        assert wav.readframes(wav.getnframes()) == expected
+
