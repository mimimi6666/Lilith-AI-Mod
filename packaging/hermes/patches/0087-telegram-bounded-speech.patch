+"""Pure bounded sentence-first planning; no model, I/O or speech authority."""
+import unicodedata
+
+MAX_TEXT = 5000
+MAX_SEGMENTS = 64
+TARGET_CHARS = 80
+MAX_SEGMENT_CHARS = 120
+_CLOSERS = '\"\'\u300d\u300f\u3011\uff09)]\u201d\u2019'
+_SENTENCE = "\u3002\uff01\uff1f!?;\uff1b\n"
+_CLAUSE = ",\u3001\uff0c:\uff1a"
+
+
+def _attached(char):
+    return (unicodedata.category(char) in ("Mn", "Mc", "Me")
+            or char == "\u200d" or 0xfe00 <= ord(char) <= 0xfe0f
+            or 0xe0100 <= ord(char) <= 0xe01ef)
+
+
+def _safe_cut(text, index):
+    if index == len(text):
+        return True
+    left, right = text[index - 1], text[index]
+    if _attached(right) or left == "\u200d" or right in _CLOSERS:
+        return False
+    # Preserve ASCII words/identifiers and decimal/rate tokens. A token longer
+    # than the hard cap is rejected rather than sent oversized or dropped.
+    token = lambda c: c.isascii() and (c.isalnum() or c in "._/-:%+")
+    return not (token(left) and token(right))
+
+
+def split_speech_text(text):
+    """Retain all input characters, preferring sentences, then clauses/spaces.
+
+    The cap counts Unicode code points conservatively. Combining marks,
+    variation selectors and ZWJ sequences stay attached; no UTF-16 slicing.
+    All planning finishes before the first synthesis request.
+    """
+    if type(text) is not str or not text.strip() or len(text) > MAX_TEXT:
+        raise ValueError("Lilith speech text exceeds limit")
+    if any(unicodedata.category(char) == "Cs" for char in text):
+        raise ValueError("Lilith speech text contains invalid Unicode")
+    spoken_positions = [index for index, char in enumerate(text) if char.isalnum()]
+    if not spoken_positions:
+        raise ValueError("Lilith speech text has no spoken content")
+    segments = []
+    start = 0
+    while start < len(text):
+        if len(segments) >= MAX_SEGMENTS:
+            raise ValueError("Lilith speech segment count exceeds limit")
+        end = min(start + MAX_SEGMENT_CHARS, len(text))
+        if len(text) - start <= TARGET_CHARS:
+            segments.append(text[start:])
+            break
+        first_spoken = next(index for index in spoken_positions if index >= start)
+        safe, sentences, clauses, spaces = [], [], [], []
+        for index in range(start + 1, end + 1):
+            if not _safe_cut(text, index):
+                continue
+            # Never leave a punctuation-only or whitespace-only piece.
+            if first_spoken >= index:
+                continue
+            if index < len(text) and spoken_positions[-1] < index:
+                continue
+            safe.append(index)
+            tail = text[start:index].rstrip(_CLOSERS + " \t\r")
+            last = tail[-1] if tail else ""
+            if last in _SENTENCE or (last == "." and (index == len(text) or text[index].isspace())):
+                sentences.append(index)
+            elif last in _CLAUSE and not (index < len(text) and text[index].isdigit()):
+                clauses.append(index)
+            elif text[index - 1].isspace():
+                spaces.append(index)
+        choices = sentences or clauses or spaces or safe
+        if not choices:
+            raise ValueError("Lilith speech token exceeds segment limit")
+        early = [index for index in choices if index - start <= TARGET_CHARS]
+        cut = early[-1] if early else choices[0]
+        segments.append(text[start:cut])
+        start = cut
+    if "".join(segments) != text or any(len(part) > MAX_SEGMENT_CHARS for part in segments):
+        raise ValueError("Lilith speech segmentation is incomplete")
+    return segments
