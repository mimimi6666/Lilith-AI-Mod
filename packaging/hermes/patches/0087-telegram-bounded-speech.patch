+class _PcmAssembly:
+    """One in-memory, size/duration-bounded output; no partial files."""
+    def __init__(self):
+        self.format = None
+        self.frames = 0
+        self.parts = []
+        self.first = None
+
+    def add(self, data):
+        format_, count, frames = _wav(data)
+        if self.format is not None and format_ != self.format:
+            raise ValueError("Lilith speech segments have different audio formats")
+        channels, width, rate = format_
+        gap = rate * SEGMENT_PAUSE_MS // 1000 if self.parts else 0
+        total = self.frames + gap + count
+        if total > rate * MAX_DURATION_SECONDS or total * channels * width + 44 > MAX_AUDIO:
+            raise ValueError("Lilith combined speech exceeds audio limit")
+        if not self.parts:
+            self.format, self.first = format_, data
+        if gap:
+            # 8-bit PCM is unsigned; larger PCM widths use signed zero.
+            silence = (b"\x80" if width == 1 else b"\x00" * width) * channels * gap
+            self.parts.append(silence)
+        self.parts.append(frames)
+        self.frames = total
+
+    def finish(self):
+        if not self.parts:
+            raise ValueError("Lilith speech has no audio")
+        if len(self.parts) == 1:
+            return self.first
+        output = io.BytesIO()
+        channels, width, rate = self.format
+        with wave.open(output, "wb") as wav:
+            wav.setparams((channels, width, rate, self.frames, "NONE", "not compressed"))
+            for frames in self.parts:
+                wav.writeframesraw(frames)
+        data = output.getvalue()
+        _wav(data)
+        return data
+
