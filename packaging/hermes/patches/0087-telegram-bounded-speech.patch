+def _prepare_cjk_spoken_text(text: str) -> str:
+    """Preserve the already translated script for the host-selected CJK voice.
+
+    Do not expand units into English or add ASCII periods after CJK punctuation.
+    This opt-in path does not change normalization for other native providers.
+    """
+    text = _VARIATION_SELECTOR_RE.sub("", text)
+    text = _EMOJI_RE.sub("", text)
+    text = re.sub(r"[\u00a0\u2007\u202f]", " ", text)
+    # Recognize artifacts produced by the previous newline smoother. Preserve
+    # decimals and genuine ellipses; only remove one redundant terminal dot.
+    text = re.sub(r"([\u3002\uff01\uff1f])[ \t]*[.\uff0e](?=\s|$)", r"\1", text)
+    text = re.sub(r"[\u2014\u2013]{2,}", "\u3001", text)
+    lines = []
+    for raw in text.splitlines():
+        heading = raw.rstrip().endswith(_HEAD)
+        line = re.sub(r"[ \t]+", " ", raw.replace(_HEAD, "")).strip()
+        if not line:
+            continue
+        tail = line.rstrip('\"\'\u300d\u300f\u3011\uff09)]\u201d\u2019')
+        if tail and tail[-1] not in ".!?;:,\u3002\uff01\uff1f\uff1b\uff1a\u3001\uff0c\u2026":
+            line += "\u3001" if heading else "\u3002"
+        lines.append(line)
+    return " ".join(lines)
+
