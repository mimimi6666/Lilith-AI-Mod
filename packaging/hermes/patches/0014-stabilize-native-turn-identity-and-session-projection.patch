+                },
+                {
+                    "role": "assistant",
+                    "content": "",
+                    "tool_calls": [
+                        {
+                            "id": "call-1",
+                            "type": "function",
+                            "function": {
+                                "name": "terminal",
+                                "arguments": '{"command":"pwd"}',
+                            },
+                        }
+                    ],
+                    "reasoning": "checking",
+                    "display_metadata": _metadata(
+                        TURN_1, ASSISTANT_TOOL_MESSAGE, kind="tool_call"
+                    ),
+                },
+                {
+                    "role": "tool",
+                    "content": "result omitted from display",
+                    "tool_name": "terminal",
