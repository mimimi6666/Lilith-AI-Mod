+def test_isolated_child_private_handoff_precedes_parent_start_and_mirrors_watch(
+    tmp_path,
+    monkeypatch,
+):
+    parent_sid = "parent-sid"
+    parent_turn_id = "9" * 32
+    parent_request_id = "parent-request"
+    child_turn_id = "4" * 32
+    child_user_message_id = "5" * 32
+    child_assistant_message_id = "6" * 32
+    child_key = "child-key"
+    host_frames = []
+    host_transport = compute_host._HostTransport(
+        host_frames.append,
+        host_boot_id="boot-1",
+    )
+    server._sessions[parent_sid] = {
+        "agent": None,
+        "session_key": "parent-key",
+        "transport": host_transport,
+    }
+    monkeypatch.setattr(server, "_inside_compute_host_child", lambda: True)
+    monkeypatch.setattr(server, "_tool_progress_enabled", lambda _sid: True)
+
+    common = {
+        "child_session_id": child_key,
+        "child_turn_id": child_turn_id,
+        "child_user_message_id": child_user_message_id,
+        "child_assistant_message_id": child_assistant_message_id,
+        "child_user_text": "research X",
+        "goal": "research X",
+        "task_count": 1,
+        "task_index": 0,
+    }
+
+    def relay(event_type, name=None, preview=None, args=None, **extra):
+        server._on_tool_progress(
+            parent_sid,
+            event_type,
+            name,
+            preview,
+            args,
+            **common,
+            **extra,
+        )
+
+    origin_token = compute_host._rpc_origin.set(
+        (parent_turn_id, parent_request_id, parent_sid)
+    )
+    try:
+        with server._turn_event_scope(parent_turn_id):
+            relay("subagent.start", preview="starting")
+            # Delegate callbacks may run on a child thread without inheriting
+            # the compute request ContextVar. The frozen turn scope remains the
+            # authority; request id is optional once the unique committed turn
+            # and parent sid match.
+            cross_thread_origin = compute_host._rpc_origin.set(("", "", ""))
+            try:
+                relay("subagent.text", preview="working")
+            finally:
+                compute_host._rpc_origin.reset(cross_thread_origin)
+            relay(
+                "subagent.tool.start",
+                name="terminal",
+                args={"command": "pwd"},
+                child_tool_id="call-1",
+            )
+            relay(
+                "subagent.tool.complete",
+                name="terminal",
+                args={"command": "pwd"},
+                child_tool_id="call-1",
+                child_tool_result="/workspace",
+            )
+            relay(
+                "subagent.complete",
+                child_final_text="done",
+                status="completed",
+            )
+    finally:
+        compute_host._rpc_origin.reset(origin_token)
+
+    private_types = [
+        frame["event_type"]
+        for frame in host_frames
+        if frame.get("type") == "child.mirror"
+    ]
+    assert private_types == [
+        "subagent.start",
+        "subagent.text",
+        "subagent.tool.start",
+        "subagent.tool.complete",
+        "subagent.complete",
+    ]
+    assert [frame["type"] for frame in host_frames[:2]] == [
+        "child.mirror",
+        "rpc",
+    ]
+    private_text = next(
+        frame
+        for frame in host_frames
+        if frame.get("type") == "child.mirror"
+        and frame.get("event_type") == "subagent.text"
+    )
+    assert private_text["origin_turn_id"] == parent_turn_id
+    assert private_text["origin_request_id"] == ""
+
+    class CaptureTransport:
+        def __init__(self):
+            self.frames = []
+
+        def write(self, frame):
+            self.frames.append(frame)
+            return True
+
+    child_transport = CaptureTransport()
+    parent_wire = []
+    monkeypatch.setattr(server, "_inside_compute_host_child", lambda: False)
+    supervisor = HostSupervisor(
+        registry_path=tmp_path / "host.json",
+        rpc_sink=parent_wire.append,
+        child_mirror_sink=lambda event_type, payload: server._mirror_subagent_to_child(
+            event_type,
+            payload,
+        ),
+        autostart=False,
+    )
+    supervisor._hello = {"boot_id": "boot-1"}
+
+    # Private activity is not authority by itself; pre-commit host frames drop.
+    supervisor._handle_host_frame(host_frames[0])
+    assert child_key not in server._active_child_runs
+    supervisor._committed_turn_owners[parent_turn_id] = (
+        parent_request_id,
+        parent_sid,
+        "boot-1",
+    )
+
+    # The dedicated private route does not relax the ordinary RPC's foreign-sid
+    # rule. A child-targeted copy of the public parent event remains zero-wire.
+    foreign_rpc = json.loads(json.dumps(host_frames[1]))
+    foreign_rpc["message"]["params"]["session_id"] = child_key
+    supervisor._handle_host_frame(foreign_rpc)
+    assert parent_wire == []
+
+    try:
+        # The private start is serialized first and establishes the parent-side
+        # active registry before the clickable parent event can reach the UI.
+        supervisor._handle_host_frame(host_frames[0])
+        assert server._active_child_runs[child_key][0] == child_turn_id
+        supervisor._handle_host_frame(host_frames[1])
+        assert parent_wire[0]["params"]["type"] == "subagent.start"
+
+        # Simulate lazy resume only after the parent start became visible.
+        server._sessions["child-live"] = {
+            "agent": None,
+            "session_key": child_key,
+            "transport": child_transport,
+        }
+        for frame in host_frames[2:]:
+            supervisor._handle_host_frame(frame)
+    finally:
+        server._sessions.pop(parent_sid, None)
+        server._sessions.pop("child-live", None)
+        server._child_mirrors.clear()
+        server._active_child_runs.clear()
+        server._completed_child_turns.clear()
+        server._completed_child_tools.clear()
+
+    child_events = [
+        frame["params"]
+        for frame in child_transport.frames
+        if frame.get("method") == "event"
+    ]
+    assert [item["type"] for item in child_events] == [
+        "message.user",
+        "message.start",
+        "message.delta",
+        "tool.start",
+        "tool.complete",
+        "message.complete",
+    ]
+    assert all(item["turn_id"] == child_turn_id for item in child_events)
+    assert child_events[0]["payload"] == {
+        "message_id": child_user_message_id,
+        "text": "research X",
+    }
+    assert child_events[1]["payload"]["message_id"] == child_assistant_message_id
+    assert child_events[3]["payload"]["tool_id"] == "call-1"
+    assert child_events[4]["payload"] == {
+        "tool_id": "call-1",
+        "name": "terminal",
+        "args": {"command": "pwd"},
+        "result": "/workspace",
+    }
+    assert child_events[-1]["payload"] == {
+        "message_id": child_assistant_message_id,
+        "text": "done",
+    }
+
