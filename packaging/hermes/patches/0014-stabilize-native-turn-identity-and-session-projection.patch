diff --git a/agent/turn_identity.py b/agent/turn_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c2dc4634338a5e9e29adb4a8c53d4532038a775
--- /dev/null
+++ b/agent/turn_identity.py
@@ -0,0 +1,228 @@
+"""Canonical immutable identities for a persisted agent turn.
+
+The UI gateway accepts a prompt before the agent has produced (or even built)
+its provider-facing message list.  Turn and message identities therefore have
+to be claimed independently of SQLite row ids and then carried into the rows
+when they are persisted.  This module owns that small contract so receipt,
+live-event, and history paths cannot silently choose different ids.
+"""
+
+from __future__ import annotations
+
+import re
+import uuid
+from typing import Any, Iterable
+
+
+TURN_ID_METADATA_KEY = "hermes_turn_id"
+MESSAGE_ID_METADATA_KEY = "hermes_message_id"
+MESSAGE_KIND_METADATA_KEY = "hermes_message_kind"
+USER_MESSAGE_ID_METADATA_KEY = "hermes_user_message_id"
+
+MESSAGE_KINDS = frozenset({"interim", "primary", "tool", "tool_call", "user"})
+
+_CANONICAL_ID_RE = re.compile(r"^[0-9a-f]{32}$")
+
+
+def canonical_id(value: Any) -> str:
+    """Return *value* only when it is an exact lowercase UUID hex id."""
+
+    return value if isinstance(value, str) and _CANONICAL_ID_RE.fullmatch(value) else ""
+
+
+def require_canonical_id(value: Any, field: str) -> str:
+    """Validate a protocol identity at a trust boundary."""
+
+    normalized = canonical_id(value)
+    if not normalized:
+        raise ValueError(f"{field} must be exactly 32 lowercase hex characters")
+    return normalized
+
+
+def new_message_id(*, excluding: Iterable[str] = ()) -> str:
+    """Generate a canonical id distinct from every supplied identity."""
+
+    blocked = {value for value in excluding if value}
+    while True:
+        value = uuid.uuid4().hex
+        if value not in blocked:
+            return value
+
+
+def new_turn_claim() -> tuple[str, str]:
+    """Atomically create distinct turn and initiating-user-message ids."""
+
+    turn_id = uuid.uuid4().hex
+    user_message_id = new_message_id(excluding=(turn_id,))
+    return turn_id, user_message_id
+
+
+def message_turn_id(message: Any) -> str:
+    if not isinstance(message, dict):
+        return ""
+    metadata = message.get("display_metadata")
+    if not isinstance(metadata, dict):
+        return ""
+    return canonical_id(metadata.get(TURN_ID_METADATA_KEY))
+
+
+def durable_message_id(message: Any) -> str:
+    """Read an explicitly persisted message id; never derive from row/text."""
+
+    if not isinstance(message, dict):
+        return ""
+    metadata = message.get("display_metadata")
+    if not isinstance(metadata, dict):
+        return ""
+    if message.get("role") == "user":
+        user_id = canonical_id(metadata.get(USER_MESSAGE_ID_METADATA_KEY))
+        if user_id:
+            return user_id
+    return canonical_id(metadata.get(MESSAGE_ID_METADATA_KEY))
+
+
+def stamp_turn_messages(
+    messages: list[Any],
+    *,
+    user_index: int | None,
+    turn_id: Any,
+    user_message_id: Any,
+    assistant_message_id: Any = None,
+) -> None:
+    """Stamp unpersisted current-turn rows with stable durable identities.
+
+    Only rows at/after the exact current user index are candidates.  A row
+    carrying a different valid turn id is left untouched, which keeps repaired
+    or concurrently adopted history from being reassigned to the current turn.
+    Existing valid message ids are preserved across repeated persistence calls.
+    """
+
+    canonical_turn = canonical_id(turn_id)
+    initiating_message = canonical_id(user_message_id)
+    primary_assistant = canonical_id(assistant_message_id)
+    if (
+        not canonical_turn
+        or not initiating_message
+        or initiating_message == canonical_turn
+        or not isinstance(user_index, int)
+        or user_index < 0
+        or user_index >= len(messages)
+    ):
+        return
+
+    if primary_assistant in {canonical_turn, initiating_message}:
+        primary_assistant = ""
+
+    # The accepted turn reserves one identity for its primary streaming/final
+    # assistant segment. Tool-call assistant rows are separate transcript
+    # records and keep their own ids. Prefer an already-stamped primary row on
+    # repeated persistence; otherwise claim the last visible non-tool-call
+    # assistant row produced by this turn. This selection uses durable row
+    # semantics, never text equality or adjacency to reconstruct an identity.
+    primary_assistant_index: int | None = None
+    assistant_candidates: list[int] = []
+    if primary_assistant:
+        explicit_primary_indices: list[int] = []
+        claimed_primary_indices: list[int] = []
+        for index in range(user_index, len(messages)):
+            message = messages[index]
+            if not isinstance(message, dict) or message.get("role") != "assistant":
+                continue
+            metadata = message.get("display_metadata")
+            metadata = metadata if isinstance(metadata, dict) else {}
+            existing_turn = canonical_id(metadata.get(TURN_ID_METADATA_KEY))
+            if existing_turn and existing_turn != canonical_turn:
+                continue
+            message_kind = metadata.get(MESSAGE_KIND_METADATA_KEY)
+            if message_kind == "primary":
+                explicit_primary_indices.append(index)
+            if (
+                canonical_id(metadata.get(MESSAGE_ID_METADATA_KEY))
+                == primary_assistant
+            ):
+                claimed_primary_indices.append(index)
+            if message.get("tool_calls") or message_kind in {
+                "interim",
+                "tool_call",
+            }:
+                continue
+            if message.get("content") or any(
+                message.get(key)
+                for key in (
+                    "reasoning",
+                    "reasoning_content",
+                    "reasoning_details",
+                    "codex_reasoning_items",
+                )
+            ):
+                assistant_candidates.append(index)
+        if len(explicit_primary_indices) > 1 or len(claimed_primary_indices) > 1:
+            raise ValueError("turn contains duplicate primary assistant identity")
+        if explicit_primary_indices:
+            primary_assistant_index = explicit_primary_indices[0]
+            metadata = messages[primary_assistant_index].get("display_metadata") or {}
+            if canonical_id(metadata.get(MESSAGE_ID_METADATA_KEY)) != primary_assistant:
+                raise ValueError("primary assistant identity conflicts with accepted claim")
+        elif claimed_primary_indices:
+            primary_assistant_index = claimed_primary_indices[0]
+        elif assistant_candidates:
+            primary_assistant_index = assistant_candidates[-1]
+
+    reserved = {canonical_turn, initiating_message}
+    if primary_assistant:
+        reserved.add(primary_assistant)
+    for index in range(user_index, len(messages)):
+        message = messages[index]
+        if not isinstance(message, dict) or message.get("role") not in {
+            "user",
+            "assistant",
+            "tool",
+        }:
+            continue
+
+        metadata = message.get("display_metadata")
+        metadata = dict(metadata) if isinstance(metadata, dict) else {}
+        existing_turn = canonical_id(metadata.get(TURN_ID_METADATA_KEY))
+        if existing_turn and existing_turn != canonical_turn:
+            continue
+        metadata[TURN_ID_METADATA_KEY] = canonical_turn
+
+        is_initiating_user = index == user_index and message.get("role") == "user"
+        if is_initiating_user:
+            message_id = initiating_message
+            metadata[USER_MESSAGE_ID_METADATA_KEY] = message_id
+            metadata[MESSAGE_KIND_METADATA_KEY] = "user"
+        elif index == primary_assistant_index:
+            message_id = primary_assistant
+            metadata[MESSAGE_KIND_METADATA_KEY] = "primary"
+        else:
+            message_id = canonical_id(metadata.get(MESSAGE_ID_METADATA_KEY))
+            if not message_id or message_id in reserved:
+                message_id = new_message_id(excluding=reserved)
+            if primary_assistant and message.get("role") == "assistant":
+                metadata.setdefault(
+                    MESSAGE_KIND_METADATA_KEY,
+                    "tool_call" if message.get("tool_calls") else "interim",
+                )
+            elif primary_assistant and message.get("role") == "tool":
+                metadata.setdefault(MESSAGE_KIND_METADATA_KEY, "tool")
+
+        metadata[MESSAGE_ID_METADATA_KEY] = message_id
+        message["display_metadata"] = metadata
+        reserved.add(message_id)
+
+
+__all__ = [
+    "MESSAGE_ID_METADATA_KEY",
+    "MESSAGE_KIND_METADATA_KEY",
+    "MESSAGE_KINDS",
+    "TURN_ID_METADATA_KEY",
+    "USER_MESSAGE_ID_METADATA_KEY",
+    "canonical_id",
+    "durable_message_id",
+    "message_turn_id",
+    "new_message_id",
+    "new_turn_claim",
+    "require_canonical_id",
+    "stamp_turn_messages",
+]
