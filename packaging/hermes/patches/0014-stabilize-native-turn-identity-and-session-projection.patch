+    terminal = {
+        **_turn_frame(),
+        "type": "turn.end",
+        "history": [],
+    }
+    started = time.monotonic()
+    supervisor._handle_host_frame(terminal)
+    elapsed = time.monotonic() - started
+
+    assert callback_started.wait(timeout=0.2)
+    assert elapsed < 0.1
+    release_callback.set()
