+    monkeypatch.setattr(server, "_ensure_session_db_row", lambda _session: None)
+    monkeypatch.setattr(server, "_persist_branch_seed", lambda _session: None)
+    monkeypatch.setattr(
+        server,
+        "_emit_accepted_user_message",
+        lambda _sid, current: (
+            order.append("message.user"),
