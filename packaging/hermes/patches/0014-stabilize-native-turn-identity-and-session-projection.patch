+                "turn_id": TURN_ID,
+                "user_message_id": USER_MESSAGE_ID,
+                "assistant_message_id": ASSISTANT_MESSAGE_ID,
+                # A multimodal durable row may carry parts here. The commit
+                # barrier proves metadata/marker identity, not display-text
+                # equality against provider content.
+                "user_text": [{"type": "text", "text": accepted_text}],
+            }
+        )
+        # Provider/model work is downstream of the durable commit callback.
+        model_inputs.append(text)
