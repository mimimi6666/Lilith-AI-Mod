+    monkeypatch.setattr(server, "_run_prompt_submit", run_prompt)
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, _sid, _payload=None: order.append(event),
+    )
+    monkeypatch.setattr(server, "_session_info", lambda *_args: {})
+
+    try:
+        host._run_real_turn(frame)
+    finally:
+        server._sessions.pop("sid-1", None)
+        host.shutdown(reason="test", wait=0.1)
+
+    frames = _json_lines(output)
+    assert accepted == [accepted_text]
+    assert model_inputs == [model_text]
+    assert order[:4] == [
+        "turn.started",
+        "turn.committed",
+        "message.user",
+        "message.start",
+    ]
+    assert [item["type"] for item in frames if item["type"].startswith("turn.")] == [
+        "turn.started",
+        "turn.committed",
+        "turn.end",
