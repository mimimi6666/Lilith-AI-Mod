+def test_terminal_callback_never_blocks_the_stdout_reader(tmp_path, monkeypatch):
+    supervisor = HostSupervisor(
+        registry_path=tmp_path / "host.json",
+        autostart=False,
+    )
+    monkeypatch.setattr(supervisor, "start", lambda: None)
+    callback_started = threading.Event()
+    release_callback = threading.Event()
+
+    def on_complete(_frame):
+        callback_started.set()
+        release_callback.wait(timeout=1.0)
+
+    def send(payload):
+        if payload["type"] == "turn.start":
+            supervisor._handle_host_frame({**payload, "type": "turn.started"})
