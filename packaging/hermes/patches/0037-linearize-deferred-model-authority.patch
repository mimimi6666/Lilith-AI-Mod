+def _runtime_authority_lock(session: dict) -> threading.Lock:
+    """Short-held lock protecting desired runtime identity and publication."""
+    return session.setdefault("agent_build_lock", threading.Lock())
+
+
+def _runtime_setter_lock(session: dict) -> threading.Lock:
+    """Serialize slow setter resolution without holding the authority lock."""
+    return session.setdefault("agent_runtime_setter_lock", threading.Lock())
+
+
+def _runtime_revision_locked(session: dict) -> int:
+    return int(session.get("agent_runtime_revision", 0) or 0)
+
+
+def _runtime_ready_for_revision(session: dict, revision: int | None = None) -> bool:
+    """True only when the published live agent embodies the exact revision."""
+    lock = _runtime_authority_lock(session)
+    with lock:
+        expected = (
+            _runtime_revision_locked(session)
+            if revision is None
+            else int(revision)
+        )
+        return bool(
+            session.get("agent") is not None
+            and not session.get("agent_error")
+            and _runtime_revision_locked(session) == expected
+            and int(session.get("agent_build_runtime_revision", -1) or 0)
+            == expected
+        )
+
+
+def _publish_live_runtime_revision(session: dict, agent, revision: int) -> bool:
+    """Publish a completed in-place mutation against its desired revision."""
+    lock = _runtime_authority_lock(session)
+    with lock:
+        if (
+            session.get("agent") is not agent
+            or _runtime_revision_locked(session) != int(revision)
+        ):
+            return False
+        # The historical name is retained for compatibility; after a live
+        # setter it means "last fully applied runtime revision", whether the
+        # agent was rebuilt or mutated in place.
+        session["agent_build_runtime_revision"] = int(revision)
+        session["agent_error"] = None
+        session["agent_error_revision"] = None
+        return True
+
+
+def _runtime_build_snapshot_locked(session: dict) -> tuple[int, dict]:
+    """Capture one immutable desired-runtime revision for agent construction."""
+    revision = _runtime_revision_locked(session)
+    resume_runtime_overrides = session.get("resume_runtime_overrides")
+    overrides = (
+        copy.deepcopy(resume_runtime_overrides)
+        if isinstance(resume_runtime_overrides, dict)
+        else {}
+    )
+    model_override = session.get("model_override")
+    if isinstance(model_override, dict) and model_override:
+        overrides["model_override"] = copy.deepcopy(model_override)
+        provider = str(model_override.get("provider") or "").strip()
+        if provider:
+            overrides["provider_override"] = provider
+        else:
+            overrides.pop("provider_override", None)
