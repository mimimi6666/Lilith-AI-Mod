+def test_concurrent_model_setters_publish_only_latest_complete_revision(monkeypatch):
+    build_entered = threading.Event()
+    release_build = threading.Event()
+    b_resolution_entered = threading.Event()
+    release_b_resolution = threading.Event()
+    built = []
+
+    def make_agent(*_args, **kwargs):
+        built.append(_Agent(kwargs))
+        if len(built) == 1:
+            build_entered.set()
+            assert release_build.wait(3)
+        return built[-1]
+
+    def switch_model(**kwargs):
+        model = kwargs["raw_input"].split()[0]
+        if model == "model-b":
+            b_resolution_entered.set()
+            assert release_b_resolution.wait(3)
+        return _switch_result(model, kwargs["explicit_provider"])
+
+    _install_build_stubs(monkeypatch, make_agent, switch_model)
+    sid = "concurrent-b-c"
+    session = _session()
+    server._sessions[sid] = session
+    responses = {}
+    try:
+        server._start_agent_build(sid, session)
+        assert build_entered.wait(2)
+        b = threading.Thread(
+            target=lambda: responses.setdefault(
+                "b", _set_model(sid, "model-b", "provider-b")
+            )
+        )
+        c = threading.Thread(
+            target=lambda: responses.setdefault(
+                "c", _set_model(sid, "model-c", "provider-c")
+            )
+        )
+        b.start()
+        assert b_resolution_entered.wait(2)
+        c.start()
+        release_b_resolution.set()
+        _wait_revision(session, 2)
+        release_build.set()
+        b.join(3)
+        c.join(3)
+
+        assert responses["c"]["result"]["runtime_revision"] == 2
+        assert responses["c"]["result"]["runtime_ready"] is True
+        assert responses["b"]["error"]["code"] == 5032
+        assert session["agent"].model == "model-c"
+        assert session["agent"].provider == "provider-c"
+        assert session["agent_build_runtime_revision"] == 2
+        assert all(agent is session["agent"] or agent.closed for agent in built)
+    finally:
+        release_b_resolution.set()
+        release_build.set()
+        server._sessions.pop(sid, None)
+
