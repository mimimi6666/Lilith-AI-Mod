+def test_live_model_reasoning_and_tier_setters_publish_one_serial_order(monkeypatch):
+    switch_entered = threading.Event()
+    release_switch = threading.Event()
+
+    class ResettingAgent(_Agent):
+        def switch_model(self, **kwargs):
+            switch_entered.set()
+            assert release_switch.wait(3)
+            super().switch_model(**kwargs)
+            # Hostile provider rebuild: simulate a client factory that resets
+            # every orthogonal runtime knob while switching model identity.
+            self.reasoning_config = {"effort": "low"}
+            self.service_tier = None
+            self.request_overrides = {}
+
+    _install_build_stubs(monkeypatch, lambda *_args, **kwargs: _Agent(kwargs))
+    monkeypatch.setattr(
+        "hermes_cli.models.resolve_fast_mode_overrides",
+        lambda _model: {"speed": "fast"},
+    )
+    sid = "live-runtime-linearization"
+    session = _session()
+    agent = ResettingAgent(
+        {"model_override": {"model": "model-a", "provider": "provider-a"}}
+    )
+    agent.reasoning_config = {"effort": "medium"}
+    session.update(
+        {
+            "agent": agent,
+            "agent_runtime_revision": 0,
+            "agent_build_runtime_revision": 0,
+        }
+    )
+    session["agent_ready"].set()
+    server._sessions[sid] = session
+    responses = {}
+    try:
+        model_thread = threading.Thread(
+            target=lambda: responses.setdefault(
+                "model", _set_model(sid, "model-b", "provider-b")
+            )
+        )
+        reasoning_thread = threading.Thread(
+            target=lambda: responses.setdefault(
+                "reasoning",
+                server.handle_request(
+                    {
+                        "id": "live-reasoning",
+                        "method": "config.set",
+                        "params": {
+                            "session_id": sid,
+                            "key": "reasoning",
+                            "value": "high",
+                        },
+                    }
+                ),
+            )
+        )
+        fast_thread = threading.Thread(
+            target=lambda: responses.setdefault(
+                "fast",
+                server.handle_request(
+                    {
+                        "id": "live-fast",
+                        "method": "config.set",
+                        "params": {
+                            "session_id": sid,
+                            "key": "fast",
+                            "value": "fast",
+                        },
+                    }
+                ),
+            )
+        )
+
+        model_thread.start()
+        assert switch_entered.wait(2)
+        reasoning_thread.start()
+        fast_thread.start()
+        time.sleep(0.05)
+        assert session["agent_runtime_revision"] == 1
+        assert session["agent_build_runtime_revision"] == 0
+        assert server._runtime_ready_for_revision(session, 1) is False
+        release_switch.set()
+        model_thread.join(3)
+        reasoning_thread.join(3)
+        fast_thread.join(3)
+
+        assert responses["model"]["result"]["runtime_revision"] == 1
+        assert responses["model"]["result"]["runtime_ready"] is True
+        later_revisions = {
+            responses["reasoning"]["result"]["runtime_revision"],
+            responses["fast"]["result"]["runtime_revision"],
+        }
+        assert later_revisions == {2, 3}
+        assert responses["reasoning"]["result"]["runtime_ready"] is True
+        assert responses["fast"]["result"]["runtime_ready"] is True
+        assert agent.model == "model-b"
+        assert agent.provider == "provider-b"
+        assert agent.reasoning_config["effort"] == "high"
+        assert agent.service_tier == "priority"
+        assert agent.request_overrides["speed"] == "fast"
+        assert session["agent_runtime_revision"] == 3
+        assert session["agent_build_runtime_revision"] == 3
+        assert server._runtime_ready_for_revision(session, 3) is True
+    finally:
+        release_switch.set()
+        server._sessions.pop(sid, None)
