+def test_tail_initialization_failure_cannot_publish_stale_candidate(monkeypatch):
+    tail_entered = threading.Event()
+    release_tail = threading.Event()
+    agents = []
+    wire_calls = 0
+
+    def make_agent(*_args, **kwargs):
+        agent = _Agent(kwargs)
+        agents.append(agent)
+        return agent
+
+    _install_build_stubs(monkeypatch, make_agent)
+
+    def wire(_sid):
+        nonlocal wire_calls
+        wire_calls += 1
+        if wire_calls == 1:
+            tail_entered.set()
+            assert release_tail.wait(3)
+            raise RuntimeError("tail initialization failed")
+
+    monkeypatch.setattr(server, "_wire_callbacks", wire)
+    sid = "tail-failure-stale"
+    session = _session()
+    server._sessions[sid] = session
+    response = {}
+    try:
+        server._start_agent_build(sid, session)
+        assert tail_entered.wait(2)
+        setter = threading.Thread(
+            target=lambda: response.setdefault(
+                "value", _set_model(sid, "model-b", "provider-b")
+            )
+        )
+        setter.start()
+        _wait_revision(session, 1)
+        assert session["agent"] is None
+        release_tail.set()
+        setter.join(3)
+
+        assert response["value"]["result"]["runtime_ready"] is True
+        assert [agent.model for agent in agents] == ["model-a", "model-b"]
+        assert agents[0].closed is True
+        assert session["agent"] is agents[1]
+        assert session["agent_error"] is None
+    finally:
+        release_tail.set()
+        server._sessions.pop(sid, None)
+
