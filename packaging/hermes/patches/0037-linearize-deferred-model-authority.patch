+def _set_fast_runtime(rid: str, key: str, value: Any, params: dict, session) -> dict:
+    """Apply service tier as one serialized desired+live runtime transaction."""
+    transaction = (
+        _runtime_setter_lock(session)
+        if session is not None
+        else contextlib.nullcontext()
+    )
+    with transaction:
+        raw = str(value or "").strip().lower()
+        agent = session.get("agent") if session else None
+        if agent is not None:
+            current_fast = getattr(agent, "service_tier", None) == "priority"
+        elif (
+            session is not None
+            and session.get("create_service_tier_override") is not None
+        ):
+            current_fast = session["create_service_tier_override"] == "priority"
+        else:
+            current_fast = _load_service_tier() == "priority"
+
+        if raw == "status":
+            return _ok(
+                rid,
+                {"key": key, "value": "fast" if current_fast else "normal"},
+            )
+        if raw in {"", "toggle"}:
+            nv = "normal" if current_fast else "fast"
+        elif raw in {"fast", "on"}:
+            nv = "fast"
+        elif raw in {"normal", "off"}:
+            nv = "normal"
+        else:
+            return _err(rid, 4002, f"unknown fast mode: {value}")
+
+        overrides = None
+        if nv == "fast":
+            from hermes_cli.models import resolve_fast_mode_overrides
+
+            if agent is not None:
+                target_model = getattr(agent, "model", None)
+            else:
+                session_override = (session or {}).get("model_override") or {}
+                target_model = (
+                    session_override.get("model")
+                    if isinstance(session_override, dict)
+                    else None
+                ) or _resolve_model()
+            if not target_model:
+                return _err(
+                    rid,
+                    4002,
+                    "fast mode is not available without a selected model",
+                )
+            overrides = resolve_fast_mode_overrides(target_model)
+            if overrides is None:
+                return _err(
+                    rid,
+                    4002,
+                    "fast mode is not available for this model",
+                )
+
+        runtime_revision = 0
+        runtime_ready = session is None
+        if session is not None:
+            runtime_revision = _commit_runtime_desire(
+                session,
+                service_tier_override=("priority" if nv == "fast" else ""),
+            )
+            # A deferred builder may have published while fast-mode support was
+            # being resolved. Re-read after the commit and either mutate that
+            # exact live agent or let the stale candidate rebuild from the new
+            # desired snapshot.
+            agent = session.get("agent")
+        else:
+            _write_config_key("agent.service_tier", nv)
+
+        if agent is not None:
+            agent.service_tier = "priority" if nv == "fast" else None
+            current_overrides = dict(getattr(agent, "request_overrides", {}) or {})
+            current_overrides.pop("service_tier", None)
+            current_overrides.pop("speed", None)
+            if nv == "fast":
+                current_overrides.update(overrides)
+            agent.request_overrides = current_overrides
+            if not _publish_live_runtime_revision(
+                session, agent, runtime_revision
+            ):
+                return _err(rid, 5032, "service-tier runtime was superseded")
+            runtime_ready = True
+            _persist_live_session_runtime(session)
+            _emit(
+                "session.info",
+                params.get("session_id", ""),
+                _session_info(agent, session),
+            )
+        return _ok(
+            rid,
+            {
+                "key": key,
+                "value": nv,
+                "runtime_revision": runtime_revision,
+                "runtime_ready": runtime_ready,
+            },
+        )
