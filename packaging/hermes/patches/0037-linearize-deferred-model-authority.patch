+def test_config_set_model_linearizes_after_inflight_deferred_build(monkeypatch):
+    """Forced interleave: an older build cannot overwrite a successful pick."""
+    build_entered = threading.Event()
+    release_build = threading.Event()
+    request_done = threading.Event()
+    response_box = {}
+    build_kwargs = []
+    built_agents = []
+    emitted = []
+
+    class _Agent:
+        def __init__(self, model, provider):
+            self.model = model
+            self.provider = provider
+            self.api_key = "old-key"
+            self.base_url = "https://old.invalid/v1"
+            self.api_mode = "chat_completions"
+            self.closed = False
+
+        def close(self):
+            self.closed = True
+
+        def switch_model(self, *, new_model, new_provider, api_key, base_url, api_mode):
+            self.model = new_model
+            self.provider = new_provider
+            self.api_key = api_key
+            self.base_url = base_url
+            self.api_mode = api_mode
+
+    def _blocked_make_agent(*_args, **kwargs):
+        build_kwargs.append(copy.deepcopy(kwargs))
+        build_entered.set()
+        assert release_build.wait(timeout=3), "test did not release deferred build"
+        override = kwargs["model_override"]
+        agent = _Agent(override["model"], override["provider"])
+        built_agents.append(agent)
+        return agent
+
+    result = types.SimpleNamespace(
+        success=True,
+        new_model="new-model",
+        target_provider="new-provider",
+        api_key="new-key",
+        base_url="https://new.invalid/v1",
+        api_mode="chat_completions",
+        warning_message="",
+        model_info=None,
+    )
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", lambda **_kwargs: result)
+    monkeypatch.setattr(server, "_set_session_context", lambda _key: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", _blocked_make_agent)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda _sid: None)
+    monkeypatch.setattr(server, "_emit", lambda *args, **_kwargs: emitted.append(args))
+    monkeypatch.setattr(server, "_session_info", lambda *_args, **_kwargs: {})
+    monkeypatch.setattr(server, "_start_notification_poller", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_notify_session_boundary", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_probe_config_health", lambda *_args: None)
+    monkeypatch.setattr(server, "_restart_slash_worker", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_persist_live_session_runtime", lambda *_args: None)
+    monkeypatch.setattr(server, "_persist_live_session_system_prompt", lambda *_args: None)
+    monkeypatch.setattr(server, "_append_model_switch_marker", lambda *_args, **_kwargs: None)
+
+    sid = "forced-model-interleave"
+    session = {
+        "agent": None,
+        "agent_ready": threading.Event(),
+        "session_key": "resume-key",
+        "history": [],
+        "profile_home": None,
+        "running": False,
+        "model_override": {"model": "old-model", "provider": "old-provider"},
+        "resume_runtime_overrides": {
+            "model_override": {"model": "old-model", "provider": "old-provider"},
+            "provider_override": "old-provider",
+        },
+    }
+    server._sessions[sid] = session
+    try:
+        server._start_agent_build(sid, session)
+        assert build_entered.wait(timeout=2), "deferred build did not start"
+
+        def _set_model():
+            response_box["response"] = server.handle_request(
+                {
+                    "id": "set-during-build",
+                    "method": "config.set",
+                    "params": {
+                        "session_id": sid,
+                        "key": "model",
+                        "value": "new-model --provider new-provider",
+                        "confirm_expensive_model": True,
+                    },
+                }
+            )
+            request_done.set()
+
+        setter = threading.Thread(target=_set_model)
+        setter.start()
+        assert not request_done.wait(timeout=0.1), "setter returned before old build settled"
+        release_build.set()
+        setter.join(timeout=3)
+        assert not setter.is_alive(), "linearized setter did not complete"
+
+        assert [kw["model_override"]["model"] for kw in build_kwargs] == [
+            "old-model",
+            "new-model",
+        ]
+        assert built_agents[0].closed is True
+        assert built_agents[1].closed is False
+        assert response_box["response"]["result"]["value"] == "new-model"
+        assert response_box["response"]["result"]["runtime_ready"] is True
+        assert response_box["response"]["result"]["runtime_revision"] == 1
+        assert session["agent"].model == "new-model"
+        assert session["agent"].provider == "new-provider"
+        assert session["model_override"]["model"] == "new-model"
+        assert session["model_override_revision"] == 1
+        assert session["agent_build_runtime_revision"] == 1
+        assert any(
+            event == "session.info"
+            and payload.get("runtime_revision") == 1
+            and payload.get("runtime_ready") is True
+            for event, _sid, payload in emitted
+        )
+    finally:
+        release_build.set()
+        server._sessions.pop(sid, None)
