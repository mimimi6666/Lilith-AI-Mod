@@ -0,0 +1,526 @@
+"""Forced interleavings for deferred-session runtime authority."""
+
+from __future__ import annotations
+
+import threading
+import time
+import types
+
+from agent.secret_scope import current_secret_scope
+from hermes_constants import get_hermes_home
+from tui_gateway import server
+
+
+class _Agent:
+    def __init__(self, kwargs):
+        override = kwargs.get("model_override") or {}
+        self.model = override.get("model", "")
+        self.provider = override.get("provider", "")
+        self.base_url = override.get("base_url", "")
+        self.api_key = override.get("api_key", "")
+        self.api_mode = override.get("api_mode", "")
+        self.reasoning_config = kwargs.get("reasoning_config_override")
+        self.service_tier = kwargs.get("service_tier_override") or None
+        self.request_overrides = {}
+        self.closed = False
+
+    def close(self):
+        self.closed = True
+
+    def switch_model(self, *, new_model, new_provider, api_key, base_url, api_mode):
+        self.model = new_model
+        self.provider = new_provider
+        self.api_key = api_key
+        self.base_url = base_url
+        self.api_mode = api_mode
+
+
+def _switch_result(model: str, provider: str):
+    return types.SimpleNamespace(
+        success=True,
+        new_model=model,
+        target_provider=provider,
+        api_key=f"{provider}-key",
+        base_url=f"https://{provider}.invalid/v1",
+        api_mode="responses" if provider.endswith("b") else "chat_completions",
+        warning_message="",
+        model_info=None,
+    )
+
+
+def _session(*, profile_home=None):
+    return {
+        "agent": None,
+        "agent_ready": threading.Event(),
+        "session_key": "resume-key",
+        "history": [],
+        "profile_home": str(profile_home) if profile_home else None,
+        "running": False,
+        "model_override": {"model": "model-a", "provider": "provider-a"},
+        "resume_runtime_overrides": {
+            "model_override": {"model": "model-a", "provider": "provider-a"},
+            "provider_override": "provider-a",
+        },
+    }
+
+
+def _install_build_stubs(monkeypatch, make_agent, switch_model=None):
+    events = []
+    monkeypatch.setattr(server, "_set_session_context", lambda _key: [])
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+    monkeypatch.setattr(server, "_make_agent", make_agent)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda _sid: None)
+    monkeypatch.setattr(
+        server, "_emit", lambda event, sid, payload: events.append((event, sid, payload))
+    )
+    monkeypatch.setattr(server, "_session_info", lambda *_args, **_kwargs: {})
+    monkeypatch.setattr(
+        server, "_start_notification_poller", lambda *_args, **_kwargs: threading.Event()
+    )
+    monkeypatch.setattr(server, "_notify_session_boundary", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_probe_config_health", lambda *_args: None)
+    monkeypatch.setattr(server, "_schedule_mcp_late_refresh", lambda *_args: None)
+    monkeypatch.setattr(server, "_restart_slash_worker", lambda *_args, **_kwargs: None)
+    monkeypatch.setattr(server, "_persist_live_session_runtime", lambda *_args: None)
+    monkeypatch.setattr(server, "_persist_live_session_system_prompt", lambda *_args: None)
+    monkeypatch.setattr(server, "_append_model_switch_marker", lambda *_args, **_kwargs: None)
+    if switch_model is None:
+        switch_model = lambda **kwargs: _switch_result(
+            kwargs["raw_input"].split()[0], kwargs["explicit_provider"]
+        )
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", switch_model)
+    return events
+
+
+def _wait_revision(session, revision: int):
+    deadline = time.monotonic() + 3
+    while time.monotonic() < deadline:
+        if int(session.get("agent_runtime_revision", 0) or 0) >= revision:
+            return
+        time.sleep(0.005)
+    raise AssertionError(f"runtime revision {revision} was not committed")
+
+
+def _set_model(sid: str, model: str, provider: str):
+    return server.handle_request(
+        {
+            "id": f"set-{model}",
+            "method": "config.set",
+            "params": {
+                "session_id": sid,
+                "key": "model",
+                "value": f"{model} --provider {provider}",
+                "confirm_expensive_model": True,
+            },
+        }
+    )
+
+
+def test_old_build_failure_is_stale_and_valid_new_provider_becomes_ready(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+    attempts = []
+
+    def make_agent(*_args, **kwargs):
+        attempts.append(kwargs["model_override"]["model"])
+        if len(attempts) == 1:
+            entered.set()
+            assert release.wait(3)
+            raise RuntimeError("old provider credentials unavailable")
+        return _Agent(kwargs)
+
+    events = _install_build_stubs(monkeypatch, make_agent)
+    sid = "stale-failure-new-provider"
+    session = _session()
+    server._sessions[sid] = session
+    response = {}
+    try:
+        server._start_agent_build(sid, session)
+        assert entered.wait(2)
+        setter = threading.Thread(
+            target=lambda: response.setdefault(
+                "value", _set_model(sid, "model-b", "provider-b")
+            )
+        )
+        setter.start()
+        _wait_revision(session, 1)
+        release.set()
+        setter.join(3)
+
+        assert response["value"]["result"]["runtime_ready"] is True
+        assert attempts == ["model-a", "model-b"]
+        assert session["agent"].model == "model-b"
+        assert session["agent_error"] is None
+        assert not any(
+            event == "error" and "old provider" in payload.get("message", "")
+            for event, _sid, payload in events
+        )
+    finally:
+        release.set()
+        server._sessions.pop(sid, None)
+
+
+def test_selected_provider_failure_is_typed_then_later_revision_recovers(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+
+    def make_agent(*_args, **kwargs):
+        model = kwargs["model_override"]["model"]
+        if model == "model-a":
+            entered.set()
+            assert release.wait(3)
+            raise RuntimeError("stale A auth failure")
+        if model == "model-b":
+            raise RuntimeError("selected B auth failure")
+        return _Agent(kwargs)
+
+    _install_build_stubs(monkeypatch, make_agent)
+    sid = "selected-failure-recovers"
+    session = _session()
+    server._sessions[sid] = session
+    first = {}
+    try:
+        server._start_agent_build(sid, session)
+        assert entered.wait(2)
+        setter = threading.Thread(
+            target=lambda: first.setdefault(
+                "value", _set_model(sid, "model-b", "provider-b")
+            )
+        )
+        setter.start()
+        _wait_revision(session, 1)
+        release.set()
+        setter.join(3)
+
+        assert first["value"]["error"]["code"] == 5032
+        assert "selected B auth failure" in first["value"]["error"]["message"]
+        assert "stale A" not in first["value"]["error"]["message"]
+        assert session["agent_error_revision"] == 1
+
+        recovered = _set_model(sid, "model-c", "provider-c")
+        assert recovered["result"]["runtime_revision"] == 2
+        assert recovered["result"]["runtime_ready"] is True
+        assert session["agent"].model == "model-c"
+        assert session["agent_error"] is None
+    finally:
+        release.set()
+        server._sessions.pop(sid, None)
+
