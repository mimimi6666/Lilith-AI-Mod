+@contextlib.contextmanager
+def _session_profile_runtime_scope(session: dict | None):
+    """Bind config and credentials to the session's owning profile.
+
+    Model selection is allowed before an agent exists.  In app-global remote
+    mode that means there is no agent from which to infer the profile, so a
+    pre-build switch must explicitly enter the saved profile's HERMES_HOME and
+    secret scope.  The scope is context-local and safe to use around the
+    network/config work performed outside the runtime-authority lock.
+    """
+    profile_home = str((session or {}).get("profile_home") or "").strip()
+    if not profile_home:
+        yield
+        return
+    home = Path(profile_home)
+    home_token = set_hermes_home_override(home)
+    secret_token = None
+    try:
+        secret_token = set_secret_scope(build_profile_secret_scope(home))
+        yield
+    finally:
+        if secret_token is not None:
+            reset_secret_scope(secret_token)
+        reset_hermes_home_override(home_token)
+
