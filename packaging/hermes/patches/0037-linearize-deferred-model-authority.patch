+def _apply_runtime_availability(
+    rows: list[dict],
+    *,
+    force_fresh_nous_tier: bool = False,
+) -> dict[str, dict]:
+    """Attach account-authoritative model availability to provider rows.
+
+    Availability is a runtime contract, not presentation metadata.  Keep the
+    network-bearing sources shared with the picker, though: both the Nous
+    entitlement check and model catalog are already TTL/process cached in
+    ``hermes_cli.models``.  Returning the raw catalog lets ``_apply_pricing``
+    reuse the same fetch in its formatting pass.
+
+    Unknown/error states deliberately fail open, matching the established
+    picker behaviour; a positively identified free account, however, may only
+    dispatch zero-cost models from the live catalog.
+    """
+    from hermes_cli.models import (
+        check_nous_free_tier,
+        get_pricing_for_provider,
+        partition_nous_models_by_tier,
+    )
+
+    pricing_by_provider: dict[str, dict] = {}
+    for row in rows:
+        slug = str(row.get("slug", "")).lower()
+        models = list(row.get("models") or [])
+        if slug != "nous" or not models:
+            continue
+        try:
+            raw_pricing = get_pricing_for_provider(slug) or {}
+        except Exception:
+            raw_pricing = {}
+        pricing_by_provider[slug] = raw_pricing
+        try:
+            free_tier = check_nous_free_tier(
+                force_fresh=force_fresh_nous_tier
+            )
+            row["free_tier"] = bool(free_tier)
+            if free_tier:
+                _selectable, unavailable = partition_nous_models_by_tier(
+                    models, raw_pricing, free_tier=True
+                )
+                row["unavailable_models"] = unavailable
+            else:
+                row["unavailable_models"] = []
+        except Exception:
+            row["free_tier"] = False
+            row["unavailable_models"] = []
+    return pricing_by_provider
+
+
