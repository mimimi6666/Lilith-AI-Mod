+def _prepend_windows_git_bash_start_shim(command: str) -> str:
+    """Make Git Bash ``start`` execute reliably with path conversion off.
+
+    Git for Windows ships ``/usr/bin/start`` with ``cmd.exe //c start``.  The
+    double slash normally survives MSYS path conversion as ``/c``.  Hermes
+    deliberately disables that conversion so native Windows flags are not
+    mangled, which leaves ``//c`` literal: cmd.exe starts interactively,
+    consumes EOF, prints its banner, and exits zero without running ``start``.
+
+    When ``start`` still resolves to Git's executable shim, install a
+    per-command bash function that calls COMSPEC with native ``/d /s /c``
+    switches instead.  A user-defined alias or function from the session
+    snapshot wins unchanged.  This is a shell-level compatibility shim, not an
+    application catalogue: every target is forwarded under cmd.exe's native
+    title/target contract and the real cmd/start exit status remains the
+    command's exit status.
+    """
+    if not _IS_WINDOWS:
+        return command
+    return f"{_WINDOWS_GIT_BASH_START_SHIM}\n{command}"
