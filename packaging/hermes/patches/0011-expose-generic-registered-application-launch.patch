+        def list_apps(self):
+            self.list_apps_calls += 1
+            if self.list_apps_calls == 1:
+                return self.catalog
+            index = min(self.list_apps_calls - 2, max(0, len(self.post_apps) - 1))
+            return self.post_apps[index] if self.post_apps else []
