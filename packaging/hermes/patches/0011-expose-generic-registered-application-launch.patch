+_WINDOWS_GIT_BASH_START_SHIM = r'''if [ "$(type -t start 2>/dev/null)" = "file" ]; then
+function start {
+    local __hermes_start_arg
+    local -a __hermes_start_args=()
+
+    # Git Bash only quotes native argv values when quoting is needed.  Protect
+    # an unquoted ampersand from cmd.exe's command parser, while leaving an
+    # already-quoted value (one containing whitespace) untouched so the
+    # launched process receives the original value rather than a literal ^.
+    for __hermes_start_arg in "$@"; do
+        case "$__hermes_start_arg" in
+            *[[:space:]]*)
+                __hermes_start_args+=("$__hermes_start_arg")
+                ;;
+            *)
+                __hermes_start_args+=("${__hermes_start_arg//&/^&}")
+                ;;
+        esac
+    done
+
+    # Preserve cmd.exe's native title/target contract byte-for-byte.  Callers
+    # launching a quoted path supply the conventional empty title explicitly;
+    # a non-empty first quoted operand remains a real window title.
+    "$COMSPEC" /d /s /c start "${__hermes_start_args[@]}"
