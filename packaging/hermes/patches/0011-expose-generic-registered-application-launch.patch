+        with patch.object(
+            LocalEnvironment, "init_session", autospec=True, return_value=None
+        ):
+            env = LocalEnvironment(cwd=str(tmp_path), timeout=15)
+
+        # Avoid user login profiles in this focused integration check.  The
+        # command wrapper still exercises the exact non-login Git Bash path
+        # used when the session snapshot is unavailable.
+        env._snapshot_ready = False
+        env._prefer_nonlogin = True
+        target = shlex.quote(sys.executable.replace("\\", "/"))
+        program = shlex.quote(
+            'import sys; print("HERMES_START_ARG=" + sys.argv[1])'
+        )
+        argument = shlex.quote("alpha&beta")
+
+        try:
+            result = env.execute(
+                f"start /b /wait {target} -c {program} {argument}",
+                timeout=15,
+                rewrite_compound_background=False,
+            )
+        finally:
+            env.cleanup()
+
+        assert result["returncode"] == 0
+        assert "HERMES_START_ARG=alpha&beta" in result["output"]
+        assert "Microsoft Windows" not in result["output"]
